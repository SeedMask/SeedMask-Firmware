      && (g_screen == UIScreen::MENU || g_screen == UIScreen::CRYPTO_HOME || g_screen == UIScreen::CRYPTO_SETTINGS
          || g_screen == UIScreen::CRYPTO_TOOLS_MENU)) {
    return RGB565_KASPA_TEAL;
  }
  return RGB565_BITCOIN_ORANGE;
}

static void drawSwitchToggle(const Rect& r, const char* leftLab, const char* rightLab, float knobT) {
  if (r.w <= 0 || r.h <= 0) return;
  if (knobT < 0.f) knobT = 0.f;
  if (knobT > 1.f) knobT = 1.f;

  bool knobOnRight = (knobT >= 0.5f);
  const int rad = r.h / 2;
  const int halfW = r.w / 2;
  // SeedMask (off) = green; crypto side = Bitcoin orange or Kaspa teal.
  const uint16_t offColor = UI_SUCCESS;
  const uint16_t onColor = cryptoToggleOnColor();
  const uint16_t modeColor = blendRGB565(offColor, onColor, knobT);

  const uint16_t trackBg = modeColor;
  const uint16_t trackBorder = UI_BORDER;
  const uint16_t knobColor = RGB565_WHITE;
  const uint16_t activeColor = blendRGB565(modeColor, UI_CARD, 0.20f);

  // Base track
  gfx->fillRoundRect(r.x, r.y, r.w, r.h, rad, trackBg);
  gfx->drawRoundRect(r.x, r.y, r.w, r.h, rad, trackBorder);

  // Knob
  // Active fill transitions with knob (fill from left to knob).
  const int innerW = r.w - 2;
  int activeW = (int)((float)innerW * knobT + 0.5f);
  if (activeW < 0) activeW = 0;
  if (activeW > innerW) activeW = innerW;
  if (activeW >= 2) {
    gfx->fillRoundRect(r.x + 1, r.y + 1, activeW, r.h - 2, rad - 1, activeColor);
  }

  // Make the knob slightly smaller so a tiny sliver of the active color can show
  // on the sides at the extreme positions (requested visual behavior).
  const int knobR = max(2, rad - 3);
  const int knobTravel = r.w - 2 * rad;
  const int knobCx = r.x + rad + (int)((float)knobTravel * knobT + 0.5f);
  const int knobCy = r.y + rad;
  gfx->fillCircle(knobCx, knobCy, knobR, knobColor);

  // Black outline around the white knob (no inner dark "ball").
  gfx->drawCircle(knobCx, knobCy, knobR, UI_BORDER);

  // Labels (very small): center each half.
  gfx->setTextSize(1);
  gfx->setTextColor(knobOnRight ? UI_BORDER : UI_ACCENT);
  if (leftLab && leftLab[0]) {
    int lw = (int)strlen(leftLab) * 6;
    int lx = r.x + halfW / 2 - lw / 2;
    int ly = r.y + (r.h - 8) / 2;
    gfx->setCursor(lx, ly);
    gfx->print(leftLab);
  }

  gfx->setTextColor(knobOnRight ? UI_ACCENT : UI_BORDER);
  if (rightLab && rightLab[0]) {
    int rw = (int)strlen(rightLab) * 6;
    int rx = r.x + halfW + halfW / 2 - rw / 2;
    int ry = r.y + (r.h - 8) / 2;
    gfx->setCursor(rx, ry);
    gfx->print(rightLab);
  }
}

static float cryptoModeToggleKnobT() {
  if (!g_cryptoModeToggleAnimActive) {
    const bool bitcoinSide = (g_screen == UIScreen::CRYPTO_HOME || g_screen == UIScreen::CRYPTO_SETTINGS);
    return bitcoinSide ? 1.0f : 0.0f;
  }

  uint32_t now = millis();
  uint32_t elapsed = now - g_cryptoModeToggleAnimStartMs;
  float u = (g_cryptoModeToggleAnimDurMs > 0) ? ((float)elapsed / (float)g_cryptoModeToggleAnimDurMs) : 1.0f;
  if (u < 0.f) u = 0.f;
  if (u > 1.f) u = 1.f;

  // Ease-in-out (quadratic).
  float e;
  if (u < 0.5f) e = 2.f * u * u;
  else e = -1.f + (4.f - 2.f * u) * u;

  float startT = g_cryptoModeToggleAnimStartOnRight ? 1.0f : 0.0f;
  float targetT = g_cryptoModeToggleAnimTargetOnRight ? 1.0f : 0.0f;
  return startT + (targetT - startT) * e;
}

static void startCryptoModeToggleAnim(UIScreen targetScreen, bool targetOnRight) {
  if (g_cryptoModeToggleAnimActive) return;
  g_cryptoModeToggleAnimActive = true;
  g_cryptoModeToggleAnimStartMs = millis();
  g_cryptoModeToggleAnimLastDrawMs = g_cryptoModeToggleAnimStartMs;
  g_cryptoModeToggleAnimStartOnRight = (g_screen == UIScreen::CRYPTO_HOME || g_screen == UIScreen::CRYPTO_SETTINGS);
  g_cryptoModeToggleAnimTargetOnRight = targetOnRight;
  g_cryptoModeToggleTargetScreen = targetScreen;
  g_touchIgnoreUntil = millis() + g_cryptoModeToggleAnimDurMs + 80;
  draw();
}

static void startDeviceNameSavedFlash() {
  g_deviceNameFlashActive = true;
  g_deviceNameFlashOn = true;
  g_deviceNameFlashTogglesLeft = 8;  // 4 flashes (on/off pairs)
  g_deviceNameFlashLastMs = millis();
}

/** Word-wrap for MENU toast card (~50 chars/line at text size 1). */
static int menu_wrap_msg_to_lines(char lines[][64], int maxLines, const char* msg, int maxCharsPerLine) {
  int nLines = 0;
  const char* p = msg;
  while (*p && nLines < maxLines) {
    while (*p == ' ') p++;
    if (!*p) break;
    size_t remain = strlen(p);
    size_t chunk = (remain > (size_t)maxCharsPerLine) ? (size_t)maxCharsPerLine : remain;
    if (chunk < remain) {
      size_t br = chunk;
      while (br > 12 && p[br - 1] != ' ') br--;
      if (br <= 12) br = chunk;
      chunk = br;
    }
    if (chunk >= 64u) chunk = 63;
    memcpy(lines[nLines], p, chunk);
    lines[nLines][chunk] = 0;
    size_t tl = strlen(lines[nLines]);
    while (tl > 0 && lines[nLines][tl - 1] == ' ') lines[nLines][tl - 1] = 0, tl--;
    p += chunk;
    if (lines[nLines][0]) nLines++;
  }
  return nLines;
}

/** MENU: status toasts in a centered card — never in the strip under the Seed/Bitcoin knob. */
static void menu_draw_message_card_overlay(void) {
  if (!g_msg[0]) return;
  const int ts = 1;
  const int cw = 6 * ts;
  const int lh = 9 * ts + 2;
  const int cardPad = 16;
  const int cardW = LCD_W - 24;
  const int cardX = 12;
  int mcc = (cardW - 2 * cardPad) / cw;
  if (mcc < 16) mcc = 16;
  char lines[8][64];
  int nLines = menu_wrap_msg_to_lines(lines, 8, g_msg, mcc);
  if (nLines <= 0) return;
  int cardH = 2 * cardPad + nLines * lh;
  int cardY = (LCD_H - cardH) / 2;
  if (cardY < 46) cardY = 46;

  gfx->fillRoundRect(cardX, cardY, cardW, cardH, 14, UI_CARD);
  gfx->drawRoundRect(cardX, cardY, cardW, cardH, 14, UI_ACCENT);

  uint16_t msgCol = UI_SUCCESS;
  if (strstr(g_msg, "Failed") || strstr(g_msg, "Wrong") || strstr(g_msg, "error") || strstr(g_msg, "Error")
      || strstr(g_msg, "microSD") || strstr(g_msg, "Insert") || strstr(g_msg, "SD save"))
    msgCol = UI_WARN;
  gfx->setTextColor(msgCol);
  gfx->setTextSize(ts);
  int ty = cardY + cardPad;
  for (int i = 0; i < nLines; i++) {
    int lw = (int)strlen(lines[i]) * cw;
    int lx = cardX + (cardW - lw) / 2;
    if (lx < cardX + 4) lx = cardX + 4;
    gfx->setCursor((int16_t)lx, ty);
    gfx->print(lines[i]);
    ty += lh;
  }
}

/** Bounding rect of the four main menu cards (Passwords / Notes / Backup / 2FA). */
static Rect menu_vault_restored_tile_bounds_rect(void) {
  const int x = (int)BTN_MENU_PASSWORDS.x;
  const int y = (int)BTN_MENU_PASSWORDS.y;
  const int x2 = (int)(BTN_MENU_NOTES.x + BTN_MENU_NOTES.w);
  const int y2 = (int)(BTN_MENU_TFA.y + BTN_MENU_TFA.h);
  return { (int16_t)x, (int16_t)y, (int16_t)(x2 - x), (int16_t)(y2 - y) };
}

/** White rounded rectangle (same aspect as the four menu tiles), inset inside the tile grid for margin. */
static Rect menu_vault_restored_panel_rect(void) {
  Rect tb = menu_vault_restored_tile_bounds_rect();
  const int inset = 2;
  int nw = (int)tb.w - 2 * inset;
  int nh = (int)tb.h - 2 * inset;
  if (nw < 100) nw = (int)tb.w;
  if (nh < 100) nh = (int)tb.h;
  return { (int16_t)(tb.x + inset), (int16_t)(tb.y + inset), (int16_t)nw, (int16_t)nh };
}

static const int kVaultRestoredCardRadius = 14;

static Rect menu_vault_restored_ok_button_rect(void) {
  Rect pr = menu_vault_restored_panel_rect();
  const int bw = 112;
  const int bh = 28;
  int bx = pr.x + (pr.w - bw) / 2;
  int by = pr.y + pr.h - bh - 8;
  return { (int16_t)bx, (int16_t)by, (int16_t)bw, (int16_t)bh };
}

static void menu_draw_vault_restored_panel(void) {
  if (!g_menuVaultRestoredPanel) return;
  Rect pr = menu_vault_restored_panel_rect();
  gfx->fillRoundRect(pr.x, pr.y, pr.w, pr.h, kVaultRestoredCardRadius, RGB565_WHITE);
  gfx->drawRoundRect(pr.x, pr.y, pr.w, pr.h, kVaultRestoredCardRadius, UI_ACCENT);

  const int cx = pr.x + pr.w / 2;
  gfx->setTextColor(RGB565_BLACK);

  gfx->setTextSize(2);
  {
    const char* t = "Vault";
    int tw = (int)strlen(t) * 6 * 2;
    gfx->setCursor((int16_t)(cx - tw / 2), pr.y + 12);
    gfx->print(t);
  }
  {
    const char* t = "Restored";
    int tw = (int)strlen(t) * 6 * 2;
    gfx->setCursor((int16_t)(cx - tw / 2), pr.y + 34);
    gfx->print(t);
  }

  char fnDisp[48];
  {
    const char* src = (g_menuVaultRestoredFile[0] ? g_menuVaultRestoredFile : "vault.bin");
    size_t n = strlen(src);
    if (n < sizeof(fnDisp)) {
      strncpy(fnDisp, src, sizeof(fnDisp) - 1);
      fnDisp[sizeof(fnDisp) - 1] = 0;
    } else {
      snprintf(fnDisp, sizeof(fnDisp), "%.16s...%s", src, src + n - min((size_t)12, n));
    }
  }
  gfx->setTextSize(1);
  {
    int maxPx = pr.w - 16;
    int maxCh = maxPx / 6;
    if (maxCh < 4) maxCh = 4;
    if ((int)strlen(fnDisp) > maxCh) {
      char tmp[48];
      strncpy(tmp, fnDisp, sizeof(tmp) - 1);
      tmp[sizeof(tmp) - 1] = 0;
      int keep = maxCh > 3 ? maxCh - 3 : 1;
      snprintf(fnDisp, sizeof(fnDisp), "%.*s...", keep, tmp);
    }
    int tw = (int)strlen(fnDisp) * 6;
    gfx->setTextColor(blendRGB565(RGB565_BLUE, RGB565_WHITE, 0.22f));
    gfx->setCursor((int16_t)(cx - tw / 2), pr.y + 54);
    gfx->print(fnDisp);
    gfx->setTextColor(RGB565_BLACK);
  }

  const char* explain =
    "From now on, all vault data is saved to this file. "
    "If you rename or delete it on the SD card, you will be asked to choose a new save location.";
  gfx->setTextSize(2);
  const int innerPad = 8;
  int bodyMcc = (pr.w - 2 * innerPad) / 12;
  if (bodyMcc < 8) bodyMcc = 8;
  char blines[8][64];
  int nBl = menu_wrap_msg_to_lines(blines, 8, explain, bodyMcc);
  int ty = pr.y + 68;
  const int blh = 15;
  Rect okR = menu_vault_restored_ok_button_rect();
  const int sz2Box = 17;
  for (int bi = 0; bi < nBl; bi++) {
    if (ty + sz2Box > (int)okR.y - 8) break;
    int lw = (int)strlen(blines[bi]) * 12;
    int lx = cx - lw / 2;
    if (lx < pr.x + innerPad) lx = pr.x + innerPad;
    gfx->setCursor((int16_t)lx, (int16_t)ty);
    gfx->print(blines[bi]);
    ty += blh;
  }

  drawGradientSilverButton(okR, "OK", 2);
}

// ===== Bottom nav bar (home indicator), status panel, app switcher =====

static int nav_bar_zone_bottom() {
  return LCD_H;
}

/** Taller gesture strip on screens where bottom chrome used to steal home taps. */
static int nav_bar_zone_h() {
  if (g_editMode == EditMode::EDIT_PW_VALUE && !g_pwEditKeyboardVisible)
    return 56;
#if SEEDMASK_NOTE_SEND_UI
  if (g_screen == UIScreen::SECURITY_SENDING
