// Histogram contrast stretch: maps [min..max] to [0..255] so quirc gets a crisp black/white image
static void contrast_stretch(uint8_t* img, size_t len) {
  // Build histogram from sampled pixels for percentile-based stretch (ignores outlier noise)
  uint16_t hist[256] = { 0 };
  size_t sampleCount = 0;
  for (size_t i = 0; i < len; i += 32) {
    hist[img[i]]++;
    sampleCount++;
  }
  if (sampleCount < 100) return;
  // Find 2nd and 98th percentile to ignore noise/hot pixels
  size_t cutLo = sampleCount / 50;
  size_t cutHi = sampleCount - cutLo;
  uint8_t lo = 0, hi = 255;
  size_t acc = 0;
  for (int i = 0; i < 256; i++) {
    acc += hist[i];
    if (acc >= cutLo) {
      lo = (uint8_t)i;
      break;
    }
  }
  acc = 0;
  for (int i = 255; i >= 0; i--) {
    acc += hist[i];
    if (acc >= cutLo) {
      hi = (uint8_t)i;
      break;
    }
  }
  if (hi <= lo + 20) return;
  uint16_t range = hi - lo;
  for (size_t i = 0; i < len; i++) {
    int v = ((int)(img[i] - lo) * 255) / range;
    img[i] = (uint8_t)(v < 0 ? 0 : (v > 255 ? 255 : v));
  }
}

// PSBT: tighter black/white percentiles than generic contrast_stretch — helps Quirc see dark modules.
static void contrast_stretch_psbt_qr(uint8_t* img, size_t len) {
  if (!img || len == 0) return;
  uint16_t hist[256] = { 0 };
  size_t sampleCount = 0;
  for (size_t i = 0; i < len; i += 32) {
    hist[img[i]]++;
    sampleCount++;
  }
  if (sampleCount < 100) return;
  size_t cutTail = sampleCount / 59;
  if (cutTail < 1) cutTail = 1;  // tighter tails → harder black/white split for Quirc (PSBT-only helper)
  uint8_t lo = 0, hi = 255;
  size_t acc = 0;
  for (int i = 0; i < 256; i++) {
    acc += hist[i];
    if (acc >= cutTail) {
      lo = (uint8_t)i;
      break;
    }
  }
  acc = 0;
  for (int i = 255; i >= 0; i--) {
    acc += hist[i];
    if (acc >= cutTail) {
      hi = (uint8_t)i;
      break;
    }
  }
  if (hi <= lo + 16) return;
  uint16_t range = hi - lo;
  for (size_t i = 0; i < len; i++) {
    int v = ((int)(img[i] - lo) * 255) / range;
    img[i] = (uint8_t)(v < 0 ? 0 : (v > 255 ? 255 : v));
  }
}

// Vault dense SPE1 (large chunks): stronger tail clipping than PSBT — crisp module edges for Quirc on SVGA.
static void contrast_stretch_vault_dense_qr(uint8_t* img, size_t len) {
  if (!img || len == 0) return;
  uint16_t hist[256] = { 0 };
  size_t sampleCount = 0;
  for (size_t i = 0; i < len; i += 24) {
    hist[img[i]]++;
    sampleCount++;
  }
  if (sampleCount < 100) return;
  size_t cutTail = sampleCount / 38;
  if (cutTail < 2) cutTail = 2;
  uint8_t lo = 0, hi = 255;
  size_t acc = 0;
  for (int i = 0; i < 256; i++) {
    acc += hist[i];
    if (acc >= cutTail) {
      lo = (uint8_t)i;
      break;
    }
  }
  acc = 0;
  for (int i = 255; i >= 0; i--) {
    acc += hist[i];
    if (acc >= cutTail) {
      hi = (uint8_t)i;
      break;
    }
  }
  if (hi <= lo + 12) return;
  uint16_t range = hi - lo;
  for (size_t i = 0; i < len; i++) {
    int v = ((int)(img[i] - lo) * 255) / range;
    img[i] = (uint8_t)(v < 0 ? 0 : (v > 255 ? 255 : v));
  }
}

// Otsu thresholding: improves decode when QR is blurry/washed by turning image into crisp B/W.
// Returns threshold used; bias allows trying slightly darker/lighter variants.
static uint8_t otsu_binarize(uint8_t* img, size_t len, int bias = 0) {
  uint32_t hist[256] = { 0 };
  // Speed: sample histogram for large frames (SVGA), full image for smaller frames.
  size_t hstep = (len > 350000) ? 4 : ((len > 180000) ? 2 : 1);
  size_t sampleLen = 0;
  for (size_t i = 0; i < len; i += hstep) {
    hist[img[i]]++;
    sampleLen++;
  }
  uint64_t sum = 0;
  for (int t = 0; t < 256; t++) sum += (uint64_t)t * (uint64_t)hist[t];
  uint64_t sumB = 0;
  uint32_t wB = 0;
  uint32_t wF = 0;
  double maxVar = -1.0;
  uint8_t bestT = 127;
  for (int t = 0; t < 256; t++) {
    wB += hist[t];
    if (wB == 0) continue;
    wF = (uint32_t)sampleLen - wB;
    if (wF == 0) break;
    sumB += (uint64_t)t * (uint64_t)hist[t];
    double mB = (double)sumB / (double)wB;
    double mF = (double)(sum - sumB) / (double)wF;
    double d = mB - mF;
    double varBetween = (double)wB * (double)wF * d * d;
    if (varBetween > maxVar) {
      maxVar = varBetween;
      bestT = (uint8_t)t;
    }
  }
  int t = (int)bestT + bias;
  if (t < 0) t = 0;
  if (t > 255) t = 255;
  bestT = (uint8_t)t;
  for (size_t i = 0; i < len; i++) img[i] = (img[i] >= bestT) ? 255 : 0;
  return bestT;
}

// Center-crop then nearest-neighbor upscale to full frame — "digital zoom" for PSBT UR QR
// shown on a monitor (Sparrow etc.): makes modules occupy more pixels for Quirc.
static void psbt_crop_zoom_resize(const uint8_t* src, int sw, int sh,
                                  uint8_t* dst, int dw, int dh, float cropFrac,
                                  float minCropFrac = 0.35f) {
  if (!src || !dst || sw <= 8 || sh <= 8 || dw <= 8 || dh <= 8) return;
  if (cropFrac < minCropFrac) cropFrac = minCropFrac;
  if (cropFrac > 1.0f) cropFrac = 1.0f;
  int cw = (int)(sw * cropFrac);
  int ch = (int)(sh * cropFrac);
  if (cw < 16 || ch < 16) return;
  int ox = (sw - cw) / 2;
  int oy = (sh - ch) / 2;
  // Fixed-point 16.16 NN scaling: replaces per-pixel multiply+divide with add
  const uint32_t xStep = ((uint32_t)cw << 16) / (uint32_t)dw;
  const uint32_t yStep = ((uint32_t)ch << 16) / (uint32_t)dh;
  uint32_t yAcc = (uint32_t)oy << 16;
  for (int y = 0; y < dh; y++) {
    int sy = (int)(yAcc >> 16);
    if (sy >= sh) sy = sh - 1;
    const uint8_t* row = src + sy * sw;
    uint8_t* drow = dst + y * dw;
    uint32_t xAcc = (uint32_t)ox << 16;
    for (int x = 0; x < dw; x++) {
      drow[x] = row[xAcc >> 16];
      xAcc += xStep;
    }
    yAcc += yStep;
  }
}

/**
 * Hunting: full-frame finder + optional zoomed views (small phone QRs).
 * deepZoom=false → one Quirc pass only (draw runs before this in poll order).
 * deepZoom=true  → add crop-zoom passes (costly; poll_qr_scan_result enables this every Nth hunt via HUNT_DEEP_ZOOM_EVERY).
 */
static int vault_hunt_finder_probe(const uint8_t* raw, size_t imgSize, bool deepZoom) {
  int best = vault_quirc_finder_count_only(raw, imgSize);
  if (best > 0 || !deepZoom || !raw || !g_gray || !g_q || imgSize != (size_t)g_qr_w * (size_t)g_qr_h)
    return best;
  static const uint8_t kHuntZoomIdx[] = { 5, 4 };
  const int nfrac = (int)(sizeof(kVaultZoomFrac) / sizeof(kVaultZoomFrac[0]));
  for (size_t k = 0; k < sizeof(kHuntZoomIdx); k++) {
    int zi = (int)kHuntZoomIdx[k];
    if (zi < 0 || zi >= nfrac) continue;
    psbt_crop_zoom_resize(raw, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h,
                          kVaultZoomFrac[zi], kVaultZoomMinCrop);
    int n = vault_quirc_finder_count_only(g_gray, imgSize);
    if (n > best) best = n;
    if (best > 0) break;
  }
  return best;
}

/** One of three overlapping zoom slices. strong = tight crop (phone), wide = full-ish (monitor/PC). */
static void vault_zoom_ring_slice(int nfrac, int span, uint8_t* phaseField, bool wideFirstRing, int* outZb, int* outZe) {
  if (!phaseField || !outZb || !outZe || nfrac <= 0) return;
  if (span < 1) span = 1;
  if (span > nfrac) span = nfrac;
  const unsigned p = (unsigned)(*phaseField)++ % 3u;
  unsigned order;
  if (wideFirstRing) {
    const unsigned map[3] = { 1u, 0u, 2u };  // wide → strong → mid (big QR fast, then phone)
    order = map[p];
  } else {
    order = p;  // strong → wide → mid (phone first when finders read 0 on full frame)
  }
  int zb = 0, ze = nfrac;
  if (order == 0u) {
    zb = max(0, nfrac - span);
    ze = nfrac;
  } else if (order == 1u) {
    zb = 0;
    ze = min(span, nfrac);
  } else {
    zb = max(0, nfrac / 2 - span / 2);
    ze = min(zb + span, nfrac);
  }
  if (ze <= zb) ze = min(zb + 1, nfrac);
  *outZb = zb;
  *outZe = ze;
}

/** Crop-zoom decode for dense vault QRs; zBeg/zEnd slice kVaultZoomFrac (smaller frac = more zoom).
 *  Always yields once per zoom step — skipping yields caused RTOS/touch/watchdog starvation when QR was locked on. */
static bool vault_try_zoom_decode(const uint8_t* raw, size_t imgSize, char* outText, size_t outLen,
                                  int* ioCount, camera_fb_t* fb, int zBeg, int zEnd,
                                  uint32_t pollStartUs, uint32_t pollBudgetUs) {
  if (!raw || !g_gray || !ioCount || imgSize != (size_t)g_qr_w * (size_t)g_qr_h) return false;
  const int nfrac = (int)(sizeof(kVaultZoomFrac) / sizeof(kVaultZoomFrac[0]));
  if (zBeg < 0) zBeg = 0;
  if (zEnd > nfrac) zEnd = nfrac;
  for (int zi = zBeg; zi < zEnd; zi++) {
    if (pollBudgetUs != 0u && (uint32_t)(micros() - pollStartUs) >= pollBudgetUs)
      return false;
    float zf = kVaultZoomFrac[zi];
    psbt_crop_zoom_resize(raw, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf, kVaultZoomMinCrop);
    // Grayscale zoom before hard binarization — phone OLED / blur often survives better in Quirc’s internal adaptive path.
    if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "vzg", ioCount)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    contrast_stretch_psbt_qr(g_gray, imgSize);
    otsu_binarize(g_gray, imgSize, -6);
    if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "vz", ioCount)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    psbt_crop_zoom_resize(raw, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf, kVaultZoomMinCrop);
    contrast_stretch_psbt_qr(g_gray, imgSize);
    mean_binarize(g_gray, imgSize, -5);
    if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "vzm", ioCount)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    psbt_crop_zoom_resize(raw, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf, kVaultZoomMinCrop);
    contrast_stretch_psbt_qr(g_gray, imgSize);
    otsu_binarize(g_gray, imgSize, +14);
    if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "vz+", ioCount)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    psbt_crop_zoom_resize(raw, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf, kVaultZoomMinCrop);
    contrast_stretch_vault_dense_qr(g_gray, imgSize);
    otsu_binarize(g_gray, imgSize, -8);
    if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "vzd", ioCount)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    psbt_crop_zoom_resize(raw, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf, kVaultZoomMinCrop);
    contrast_stretch_vault_dense_qr(g_gray, imgSize);
    otsu_binarize(g_gray, imgSize, +12);
    if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "vzd+", ioCount)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    psbt_crop_zoom_resize(raw, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf, kVaultZoomMinCrop);
    contrast_stretch_vault_dense_qr(g_gray, imgSize);
    otsu_binarize(g_gray, imgSize, 0);
    for (size_t ii = 0; ii < imgSize; ii++) g_gray[ii] = (uint8_t)(255 - g_gray[ii]);
    if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "vzi", ioCount)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    yield();
  }
  return false;
}

/** Phone OLED / inverted exports: try bit-inverted binary after Otsu. */
static bool vault_try_inverted_otsu(const uint8_t* raw, size_t imgSize, char* outText, size_t outLen,
                                    camera_fb_t* fb) {
  if (!raw || !g_gray || imgSize != (size_t)g_qr_w * (size_t)g_qr_h) return false;
  memcpy(g_gray, raw, imgSize);
  contrast_stretch_vault_dense_qr(g_gray, imgSize);
  otsu_binarize(g_gray, imgSize, 0);
  for (size_t i = 0; i < imgSize; i++) g_gray[i] = (uint8_t)(255 - g_gray[i]);
  if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "inv")) {
    if (fb) esp_camera_fb_return(fb);
    return true;
  }
  return false;
}

/** SPE1-M progress: numbered squares 1..N — bright when chunk stored in `g_restoreChunkGot`, faded otherwise. */
static void drawVaultMultipartPartIndicators(int rowTop) {
  const uint8_t n = g_restoreChunkTotal;
  if (n == 0) return;
  const int gap = 4;
  const int maxSq = 36;
  const int minSq = 22;
  int sqSize = (LCD_W - 16 - (int)(n - 1) * gap) / (int)n;
  if (sqSize > maxSq) sqSize = maxSq;
  if (sqSize < minSq) sqSize = minSq;
  int rowW = (int)n * sqSize + (int)(n - 1) * gap;
  if (rowW > LCD_W - 8) {
    sqSize = (LCD_W - 8 - (int)(n - 1) * gap) / (int)n;
    if (sqSize < 18) sqSize = 18;
    rowW = (int)n * sqSize + (int)(n - 1) * gap;
  }
  const int x0 = (LCD_W - rowW) / 2;
  gfx->setTextWrap(false);
  for (int i = 0; i < (int)n; i++) {
    const int x = x0 + i * (sqSize + gap);
    const bool done = g_restoreChunkGot[i] != 0;
    const uint16_t fill =
      done ? blendRGB565(UI_ACCENT, RGB565_WHITE, 0.36f)
           : blendRGB565(RGB565_DARKGREY, RGB565_BLACK, 0.55f);
    const uint16_t border = done ? RGB565_CYAN : RGB565_DARKGREY;
    const uint16_t txt = done ? RGB565_WHITE : RGB565(100, 100, 104);
    const int rad = min(6, sqSize / 5);
    gfx->fillRoundRect(x, rowTop, sqSize, sqSize, rad, fill);
    gfx->drawRoundRect(x, rowTop, sqSize, sqSize, rad, border);
    gfx->setTextSize(sqSize >= 30 ? 2 : 1);
    gfx->setTextColor(txt);
    char buf[8];
    snprintf(buf, sizeof(buf), "%d", i + 1);
    const int fs = sqSize >= 30 ? 2 : 1;
    const int tw = (int)strlen(buf) * 6 * fs;
    const int th = 8 * fs;
    gfx->setCursor(x + (sqSize - tw) / 2, rowTop + (sqSize - th) / 2);
    gfx->print(buf);
  }
  gfx->setTextSize(1);
}

/** Encrypted vault RESTORE scan HUD — shared by hunt path (immediate paint) and decode-first fallback after failed ECC. */
static void vault_paint_restore_scan_ui(const uint8_t* raw, int vaultPvStep, bool preEngaged) {
  if (!raw) return;
  const bool mpHud = (g_restoreChunkTotal > 0);
  const int previewTop = mpHud ? 96 : 60;
  const int mpSquareTop = 54;
  drawCameraPreviewGray(raw, vaultPvStep, previewTop);
  if (preEngaged && s_qr_last_count > 0) drawQRDetectOverlay(g_q, s_qr_last_count);
  {
    const int outH = min((g_qr_h * 2) / vaultPvStep, PREVIEW_H);
    const int endY = previewTop + outH;
    if (endY < LCD_H) gfx->fillRect(0, endY, LCD_W, LCD_H - endY, RGB565_BLACK);
  }
  gfx->fillRect(0, 40, LCD_W, mpHud ? 54 : 20, RGB565_BLACK);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);
  gfx->setCursor(10, 44);
  if (g_restoreChunkTotal > 0) {
    int nr = 0;
    for (int i = 0; i < g_restoreChunkTotal; i++) nr += g_restoreChunkGot[i];
    gfx->printf("%d of %d parts", nr, g_restoreChunkTotal);
    drawVaultMultipartPartIndicators(mpSquareTop);
  } else if (s_qr_last_count > 0) {
    if (s_dense_lock_frames > 0)
      gfx->print("QR seen - dense lock-on decode...");
    else if (g_qr_decode_fail_streak >= 15)
      gfx->print("QR seen, decode retrying. Hold still/closer");
    else
      gfx->print("QR seen - decoding...");
  } else {
    s_qr_spinner = (s_qr_spinner + 1) % 4;
    gfx->print("Scanning");
    for (int d = 0; d < s_qr_spinner; d++) gfx->print(".");
    for (int d = s_qr_spinner; d < 3; d++) gfx->print(" ");
  }
  drawGradientSilverButton(BTN_SCAN_BACK, "BACK", 1);
  ui_flush();
}

