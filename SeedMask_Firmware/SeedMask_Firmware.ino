// Horizontal scroll for Name / User / Website / Notes — must match draw() math for each layout.
static void pwMetaFieldScrollViewToCursor() {
  size_t lenA = strlen(g_editBuf);
  if (g_editCursor > lenA) g_editCursor = (uint16_t)lenA;

  uint16_t* view = nullptr;
  int maxChars = 0;
  if (pwEditIsMetaFocusField(g_pwEditFocusField)) {
    maxChars = (PW_EDIT_DETAIL_W - 16) / 12;
    view = (g_pwEditFocusField == PW_FOCUS_NAME)   ? &g_addPwViewName
           : (g_pwEditFocusField == PW_FOCUS_USER) ? &g_addPwViewUser
           : (g_pwEditFocusField == PW_FOCUS_SITE) ? &g_addPwViewSite
                                                   : &g_addPwViewNotes;
  } else if (g_editMode == EditMode::ADD_PW_TITLE || g_editMode == EditMode::ADD_PW_USER || g_editMode == EditMode::ADD_PW_SITE || g_editMode == EditMode::ADD_PW_NOTES) {
    const int addFieldW = 288;  // matches Rect f1..f4 .w in add-password meta UI
    maxChars = (addFieldW - 16) / 12;
    view = (g_editMode == EditMode::ADD_PW_TITLE)  ? &g_addPwViewName
           : (g_editMode == EditMode::ADD_PW_USER) ? &g_addPwViewUser
           : (g_editMode == EditMode::ADD_PW_SITE) ? &g_addPwViewSite
                                                   : &g_addPwViewNotes;
  }
  if (!view || maxChars <= 0) return;

  if (*view > (uint16_t)lenA) *view = (uint16_t)lenA;
  if (g_editCursor < *view) *view = g_editCursor;
  else if (g_editCursor > (uint16_t)(*view + maxChars)) *view = (uint16_t)(g_editCursor - maxChars);
  // After delete at end, keep the visible tail aligned to the string end (same idea as password field).
  if ((size_t)g_editCursor == lenA && lenA >= (size_t)maxChars)
    *view = (uint16_t)(lenA - (size_t)maxChars);
  else if ((size_t)g_editCursor == lenA && lenA < (size_t)maxChars)
    *view = 0;
}

static void edit_add_char(char c) {
  size_t n = strlen(g_editBuf);
  if (n >= g_editMaxLen) return;
  if (g_editCursor > n) g_editCursor = (uint16_t)n;
  memmove(&g_editBuf[g_editCursor + 1], &g_editBuf[g_editCursor], n - g_editCursor + 1);
  g_editBuf[g_editCursor] = c;
  g_editCursor++;
  g_lastEditInputMs = millis();
  if (g_editMode == EditMode::ADD_PW_VALUE || g_editMode == EditMode::EDIT_PW_VALUE) {
    g_pwValueWasGenerated = false;
    g_dicewareManualDoneAlready = false;
    g_dicewareManualDoneAtMs = 0;
  }
  noteVisualCursorSync();
  pwMetaFieldScrollViewToCursor();
}
static void edit_bs() {
  size_t n = strlen(g_editBuf);
  if (!n || g_editCursor == 0) return;
  if (g_editCursor > n) g_editCursor = (uint16_t)n;
  memmove(&g_editBuf[g_editCursor - 1], &g_editBuf[g_editCursor], n - g_editCursor + 1);
  g_editCursor--;
  g_lastEditInputMs = millis();
  if (g_editMode == EditMode::ADD_PW_VALUE || g_editMode == EditMode::EDIT_PW_VALUE) {
    g_pwValueWasGenerated = false;
    g_dicewareManualDoneAlready = false;
    g_dicewareManualDoneAtMs = 0;
  }
  // Password value box only — never adjust g_editViewOffset while editing metadata fields (would corrupt scroll).
  if (g_editMode == EditMode::ADD_PW_VALUE || (g_editMode == EditMode::EDIT_PW_VALUE && pwEditIsPasswordFocusField(g_pwEditFocusField))) {
    size_t len2 = strlen(g_editBuf);
    const int pwMaxChars = (272 - 12 * 2) / 12;  // match draw password box
    if ((size_t)g_editCursor == len2) {
      g_editViewOffset = ((uint16_t)len2 >= (uint16_t)pwMaxChars) ? (uint16_t)((uint16_t)len2 - pwMaxChars) : 0;
      g_editViewOffsetPx = 0;
    }
    if (g_editCursor < g_editViewOffset) {
      g_editViewOffset = g_editCursor;
      g_editViewOffsetPx = 0;
    }
    if (g_editViewOffset > (uint16_t)len2)
      g_editViewOffset = ((uint16_t)len2 >= (uint16_t)pwMaxChars) ? (uint16_t)((uint16_t)len2 - pwMaxChars) : 0;
  }
  noteVisualCursorSync();
  pwMetaFieldScrollViewToCursor();
}

