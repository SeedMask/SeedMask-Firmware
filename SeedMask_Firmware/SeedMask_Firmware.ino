    gfx->setCursor(pad, (int16_t)(hintY + 14));
    gfx->print("suggested default name. Saving");
    gfx->setCursor(pad, (int16_t)(hintY + 28));
    gfx->print("will create this file on card.");
    gfx->setTextColor(UI_TEXT);
  }
  const Rect rBack = { 10, (int16_t)(LCD_H - 44), 110, 36 };
  gfx->fillRoundRect(rBack.x, rBack.y, rBack.w, rBack.h, 8, UI_BORDER);
  gfx->setTextColor(UI_TEXT);
  gfx->setCursor((int16_t)(rBack.x + 32), (int16_t)(rBack.y + 12));
  gfx->print("Back");
  if (g_sdSavePathPickStep == 1) {
    const Rect rCont = { 130, (int16_t)(LCD_H - 44), 180, 36 };
    bool canCont = (g_sdSavePickVaultRowSel >= 0 && g_sdSavePickVaultRowSel < sd_pick_vault_rows());
    if (canCont)
      drawOrangeBlackButton(rCont, "Continue", 1);
    else {
      gfx->fillRoundRect(rCont.x, rCont.y, rCont.w, rCont.h, 8, UI_BORDER);
      gfx->drawRoundRect(rCont.x, rCont.y, rCont.w, rCont.h, 8, RGB565_DARKGREY);
      gfx->setTextColor(RGB565_DARKGREY);
      gfx->setTextSize(1);
      gfx->setCursor((int16_t)(rCont.x + 58), (int16_t)(rCont.y + 12));
      gfx->print("Continue");
    }
    gfx->setTextColor(UI_TEXT);
  }
}

static void handleSdSavePathPickerTap(uint16_t x, uint16_t y) {
  const int pad = 10;
  if (g_sdSavePathPickStep == 0) {
    const Rect rDef = { 10, (int16_t)(LCD_H - 110), 140, 44 };
    const Rect rPick = { 170, (int16_t)(LCD_H - 110), 140, 44 };
    const Rect rCancel = { 10, (int16_t)(LCD_H - 52), 100, 36 };
    if (hit(rDef, (int16_t)x, (int16_t)y)) {
      sd_pick_use_defaults_and_retry();
      return;
    }
    if (hit(rPick, (int16_t)x, (int16_t)y)) {
      g_sdSavePathPickStep = 1;
      g_sdSavePickScroll = 0;
      g_sdSavePickVaultRowSel = -1;
      draw();
      return;
    }
    if (hit(rCancel, (int16_t)x, (int16_t)y)) {
      g_sdSavePathPickOpen = false;
      g_sdSavePathPickStep = 0;
      g_sdSavePickVaultRowSel = -1;
      setMsg("");
      draw();
      return;
    }
    return;
  }

  const int listTop = 56;
  const int listH = 200;
  const int rowH = 34;
  const int vis = 5;
  const int listW = LCD_W - 2 * pad - 52;
  int sx = LCD_W - pad - 44;
  const Rect rUp = { (int16_t)sx, (int16_t)listTop, 40, 40 };
  const Rect rDown = { (int16_t)sx, (int16_t)(listTop + listH - 40), 40, 40 };
  const Rect rBack = { 10, (int16_t)(LCD_H - 44), 110, 36 };
  const Rect rContinue = { 130, (int16_t)(LCD_H - 44), 180, 36 };
  int nrows = (g_sdSavePathPickStep == 1) ? sd_pick_vault_rows() : sd_pick_backup_rows();

  if (hit(rBack, (int16_t)x, (int16_t)y)) {
    if (g_sdSavePathPickStep == 2) {
      g_sdSavePathPickStep = 1;
      g_sdSavePickScroll = 0;
      sd_pick_sync_vault_row_sel_from_sel_vault_path();
    } else {
      g_sdSavePathPickStep = 0;
      g_sdSavePickScroll = 0;
      g_sdSavePickVaultRowSel = -1;
    }
    draw();
    return;
  }
  if (g_sdSavePathPickStep == 1 && hit(rContinue, (int16_t)x, (int16_t)y)) {
    int ri = g_sdSavePickVaultRowSel;
    if (ri < 0 || ri >= nrows) {
      draw();
      return;
    }
    if (ri == 0)
      strncpy(g_sdSavePickSelVault, g_sdSavePickCanonVault, sizeof(g_sdSavePickSelVault) - 1);
    else
      strncpy(g_sdSavePickSelVault, g_sdSavePickVaultPaths[ri - 1], sizeof(g_sdSavePickSelVault) - 1);
    g_sdSavePickSelVault[sizeof(g_sdSavePickSelVault) - 1] = 0;
    g_sdSavePickBkN = sd_list_wallet_backup_bins(g_sdSavePickFolder, g_sdSavePickBkPaths, 8, g_masterPw, g_sdSavePickSelVault);
    g_sdSavePathPickStep = 2;
    g_sdSavePickScroll = 0;
    draw();
    return;
  }
  if (hit(rUp, (int16_t)x, (int16_t)y)) {
    if (g_sdSavePickScroll > 0) {
      g_sdSavePickScroll--;
      draw();
    }
    return;
  }
  if (hit(rDown, (int16_t)x, (int16_t)y)) {
    if (g_sdSavePickScroll + vis < nrows) {
      g_sdSavePickScroll++;
      draw();
    }
    return;
  }

  if (x >= (uint16_t)(pad + 4) && x < (uint16_t)(pad + 4 + listW - 8)
      && y >= (uint16_t)(listTop + 4) && y < (uint16_t)(listTop + 4 + vis * rowH)) {
    int slot = ((int)y - (listTop + 4)) / rowH;
    if (slot < 0 || slot >= vis) return;
    int ri = g_sdSavePickScroll + slot;
    if (ri < 0 || ri >= nrows) return;
    if (g_sdSavePathPickStep == 1) {
      g_sdSavePickVaultRowSel = ri;
      draw();
      return;
    }
    const char* bk = (ri == 0) ? g_sdSavePickCanonBackup : g_sdSavePickBkPaths[ri - 1];
    sd_pick_apply_prefs_and_retry_vault_save(g_sdSavePickSelVault, bk);
  }
}

static bool backup_code_save_to_sd(const char* backupCode, const char* password, const char seedWords[][16], uint8_t wc) {
  Serial.println("backup_code_save_to_sd: Starting backup code save...");
  if (!backupCode || !password || strlen(password) < BACKUP_PASSWORD_MIN_LEN) {
    Serial.println("backup_code_save_to_sd: Invalid inputs");
    return false;
  }
  if (!sd_ready()) {
    Serial.println("backup_code_save_to_sd: SD not ready");
    return false;
  }
  Serial.println("backup_code_save_to_sd: SD ready, preparing to save...");

  if (!seedmask_prepare_sd_backup_paths_for_words(seedWords, wc)) {
    Serial.println("backup_code_save_to_sd: Failed to prepare BACKUP <fp> paths");
    return false;
  }

  char prefBk[192];
  if (sd_prefs_get_backup_path(prefBk, sizeof(prefBk))) {
    struct stat st;
    if (stat(prefBk, &st) == 0 && S_ISREG(st.st_mode)) {
      strncpy(BC_FILE, prefBk, sizeof(BC_FILE) - 1);
      BC_FILE[sizeof(BC_FILE) - 1] = 0;
    }
  }

  // Create encrypted blob with AES-GCM
  size_t codeLen = strlen(backupCode);
  size_t encrypted_blob_len = 8 + 12 + 16 + codeLen;  // salt(4) + len(4) + iv(12) + tag(16) + data
  uint8_t* encrypted_blob = (uint8_t*)ps_malloc(encrypted_blob_len);
  if (!encrypted_blob) {
    Serial.println("backup_code_save_to_sd: Memory allocation failed");
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_save_to_sd: Allocated blob size: ");
  Serial.println(encrypted_blob_len);
#endif

  // Add salt
  uint8_t salt[4];
  esp_fill_random(salt, sizeof(salt));
  memcpy(encrypted_blob, salt, 4);

  // Calculate encrypted length first
  size_t actual_encrypted_len = 12 + 16 + codeLen;  // iv(12) + tag(16) + data
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_save_to_sd: Expected encrypted length: ");
  Serial.println(actual_encrypted_len);
  Serial.print("backup_code_save_to_sd: Calculation: 12 + 16 + ");
  Serial.print(codeLen);
  Serial.print(" = ");
  Serial.println(actual_encrypted_len);
#endif

  // Add length
  uint32_t len = (uint32_t)actual_encrypted_len;  // Use encrypted length, not code length
  memcpy(encrypted_blob + 4, &len, 4);

  // Encrypt the backup code
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_save_to_sd: Backup code length: ");
  Serial.println(codeLen);
  Serial.print("backup_code_save_to_sd: Encrypting ");
  Serial.print(codeLen);
  Serial.println(" bytes of backup code...");
#endif

  bool encrypt_result = aes_gcm_encrypt(password, salt, (const uint8_t*)backupCode, codeLen, encrypted_blob + 8, &actual_encrypted_len);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_save_to_sd: AES-GCM encrypt result: ");
  Serial.println(encrypt_result ? "SUCCESS" : "FAILED");
#endif

  if (!encrypt_result) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("backup_code_save_to_sd: Encryption failed - checking parameters...");
    Serial.print("backup_code_save_to_sd: backupCode ptr: ");
    Serial.println((uintptr_t)backupCode, HEX);
    Serial.print("backup_code_save_to_sd: encrypted_blob+8 ptr: ");
    Serial.println((uintptr_t)(encrypted_blob + 8), HEX);
    Serial.print("backup_code_save_to_sd: actual_encrypted_len ptr: ");
    Serial.println((uintptr_t)&actual_encrypted_len, HEX);
#endif
    secure_memzero(encrypted_blob, encrypted_blob_len);
    free(encrypted_blob);
    Serial.println("backup_code_save_to_sd: Encryption failed");
    return false;
  }

  Serial.print("backup_code_save_to_sd: Encryption successful, actual encrypted length: ");
  Serial.println(actual_encrypted_len);

  // Remove old file
  Serial.print("backup_code_save_to_sd: Removing file: ");
  Serial.println(BC_FILE);
  remove(BC_FILE);

  // Save to SD
  FILE* f = fopen(BC_FILE, "wb");
  if (!f) {
    Serial.print("backup_code_save_to_sd: Failed to open file: ");
    Serial.println(BC_FILE);
    Serial.print("backup_code_save_to_sd: Error: ");
    Serial.println(strerror(errno));
    secure_memzero(encrypted_blob, encrypted_blob_len);
    free(encrypted_blob);
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_save_to_sd: Writing ");
  Serial.print(8 + actual_encrypted_len);
  Serial.println(" bytes to file...");

  Serial.print("backup_code_save_to_sd: Length field being written: ");
  Serial.println(len);
  Serial.print("backup_code_save_to_sd: Raw length bytes: ");
  uint8_t* len_bytes = (uint8_t*)&len;
  for (int i = 0; i < 4; i++) {
    Serial.print(len_bytes[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
#endif

  size_t written = fwrite(encrypted_blob, 1, 8 + actual_encrypted_len, f);
  Serial.print("backup_code_save_to_sd: Actually wrote ");
  Serial.print(written);
  Serial.println(" bytes");

  if (fflush(f) != 0) {
    Serial.println("backup_code_save_to_sd: Failed to flush file");
    Serial.print("backup_code_save_to_sd: Error: ");
    Serial.println(strerror(errno));
  }

  int fclose_result = fclose(f);
  if (fclose_result != 0) {
    Serial.print("backup_code_save_to_sd: Failed to close file, error: ");
    Serial.println(strerror(errno));
  }

#if SEEDMASK_CRYPTO_DEBUG
  // Debug: Show what we actually wrote (never enable in production)
  Serial.println("backup_code_save_to_sd: File contents written:");
  Serial.print("backup_code_save_to_sd: Salt: ");
  for (int i = 0; i < 4; i++) {
    Serial.print(encrypted_blob[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
  Serial.print("backup_code_save_to_sd: Length: ");
  uint32_t stored_len = *((uint32_t*)(encrypted_blob + 4));
  Serial.println(stored_len);

  Serial.println("backup_code_save_to_sd: Analyzing encrypted data structure:");
  if (actual_encrypted_len >= 12) {
    Serial.print("backup_code_save_to_sd: IV (12 bytes): ");
    for (int i = 0; i < 12; i++) {
      Serial.print(encrypted_blob[8 + i], HEX);
      Serial.print(" ");
    }
    Serial.println();
  }
  if (actual_encrypted_len >= 28) {
    Serial.print("backup_code_save_to_sd: Tag (16 bytes): ");
    for (int i = 12; i < 28 && i < actual_encrypted_len; i++) {
      Serial.print(encrypted_blob[8 + i], HEX);
      Serial.print(" ");
    }
    Serial.println();
  }
  if (actual_encrypted_len > 28) {
    Serial.print("backup_code_save_to_sd: Encrypted data (first 10 bytes): ");
    for (int i = 28; i < 38 && i < actual_encrypted_len; i++) {
      Serial.print(encrypted_blob[8 + i], HEX);
      Serial.print(" ");
    }
    Serial.println();
  }

  Serial.print("backup_code_save_to_sd: Encrypted data (first 20 bytes): ");
  for (int i = 0; i < 20 && i < actual_encrypted_len; i++) {
    Serial.print(encrypted_blob[8 + i], HEX);
    Serial.print(" ");
  }
  Serial.println();
#endif

  secure_memzero(encrypted_blob, encrypted_blob_len);
  free(encrypted_blob);

  Serial.print("backup_code_save_to_sd: Expected to write ");
  Serial.print(8 + actual_encrypted_len);
  Serial.print(" bytes, actually wrote ");
  Serial.print(written);
  Serial.println(" bytes");

  bool success = (written == (8 + actual_encrypted_len));
  Serial.print("backup_code_save_to_sd: Save ");
  Serial.println(success ? "SUCCESSFUL" : "FAILED");

  if (success) {
    char successMsg[128];
    snprintf(successMsg, sizeof(successMsg), "Backup saved as: %s", backup_code_sd_basename());
    setMsg(successMsg);
    Serial.print("backup_code_save_to_sd: Success message: ");
    Serial.println(successMsg);
  }

  return success;
}

static bool backup_code_load_from_sd(const char* password, char* outCode, size_t outCodeLen, const char* filePathOverride = nullptr) {
  Serial.println("backup_code_load_from_sd: Starting backup code load...");
  if (!password || strlen(password) < BACKUP_PASSWORD_MIN_LEN || !outCode) {
    Serial.println("backup_code_load_from_sd: Invalid inputs");
    return false;
  }
  if (!sd_ready()) {
    Serial.println("backup_code_load_from_sd: SD not ready");
    return false;
  }
  Serial.println("backup_code_load_from_sd: SD ready, preparing to load...");

  const char* path = (filePathOverride && filePathOverride[0]) ? filePathOverride : BC_FILE;
  FILE* f = fopen(path, "rb");
  if (!f) {
    Serial.print("backup_code_load_from_sd: Failed to open file: ");
    Serial.println(path);
    Serial.print("backup_code_load_from_sd: Error: ");
    Serial.println(strerror(errno));
    return false;
  }

  // Read salt and length
  uint8_t salt[4];
  uint32_t len = 0;

  if (fread(salt, 1, 4, f) != 4) {
    Serial.println("backup_code_load_from_sd: Failed to read salt");
    fclose(f);
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_load_from_sd: Read salt: ");
  for (int i = 0; i < 4; i++) {
    Serial.print(salt[i], HEX);
    Serial.print(" ");
  }
#endif
  // Read length and encrypted data
  if (fread(&len, 1, 4, f) != 4) {
    Serial.println("backup_code_load_from_sd: Failed to read length");
    fclose(f);
    return false;
  }
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_load_from_sd: Encrypted data length from file: ");
  Serial.println(len);

  Serial.print("backup_code_load_from_sd: Raw length bytes: ");
  fseek(f, 4, SEEK_SET);  // Go back to length field
  uint8_t len_bytes[4];
  fread(len_bytes, 1, 4, f);
  for (int i = 0; i < 4; i++) {
    Serial.print(len_bytes[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
  Serial.print("backup_code_load_from_sd: Length as uint32: ");
  Serial.println(len);
#endif

  if (len > 1000) {  // Sanity check
    Serial.println("backup_code_load_from_sd: Encrypted data length too large");
    fclose(f);
    return false;
  }

  // Read the full encrypted blob (IV + encrypted data + tag)
  uint8_t* encrypted_blob = (uint8_t*)ps_malloc(len);
  if (!encrypted_blob) {
    Serial.println("backup_code_load_from_sd: Memory allocation failed");
    fclose(f);
    return false;
  }

  size_t read = fread(encrypted_blob, 1, len, f);
  fclose(f);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_load_from_sd: Read ");
  Serial.print(read);
  Serial.print(" bytes from file, expected ");
  Serial.print(len);
  Serial.println(" bytes");
#endif

  if (read != len) {
    Serial.println("backup_code_load_from_sd: Failed to read encrypted data");
    secure_memzero(encrypted_blob, len);
    free(encrypted_blob);
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_load_from_sd: Read ");
  Serial.print(len);
  Serial.println(" bytes of encrypted blob");

  Serial.println("backup_code_load_from_sd: File contents read:");
  Serial.print("backup_code_load_from_sd: Encrypted blob (first 20 bytes): ");
  for (int i = 0; i < 20 && i < len; i++) {
    Serial.print(encrypted_blob[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  Serial.println("backup_code_load_from_sd: Analyzing encrypted blob structure:");
  Serial.print("backup_code_load_from_sd: Total encrypted blob length: ");
  Serial.println(len);

  if (len >= 12) {
    Serial.print("backup_code_load_from_sd: IV (12 bytes): ");
    for (int i = 0; i < 12; i++) {
      Serial.print(encrypted_blob[i], HEX);
      Serial.print(" ");
    }
    Serial.println();
  }
#endif

  // The encrypted_blob should contain: [IV:12] + [Encrypted data] + [Tag:16]
  // So the actual encrypted data length is: len - 12 - 16
  size_t encrypted_data_len = len - 12 - 16;
  const uint8_t* encrypted_data = encrypted_blob + 12;
  const uint8_t* tag = encrypted_blob + 12 + encrypted_data_len;

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_load_from_sd: Calculated encrypted data length: ");
  Serial.println(encrypted_data_len);
  Serial.print("backup_code_load_from_sd: Tag (16 bytes): ");
  for (int i = 0; i < 16; i++) {
    Serial.print(tag[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
  Serial.print("backup_code_load_from_sd: Encrypted data (first 10 bytes): ");
  for (int i = 0; i < 10 && i < encrypted_data_len; i++) {
    Serial.print(encrypted_data[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
#endif

  // Verify the format is correct
  if (len < 28) {  // 12 + 16 minimum
    Serial.println("backup_code_load_from_sd: Encrypted blob too small - invalid format");
    secure_memzero(encrypted_blob, len);
    free(encrypted_blob);
    return false;
  }

  // Decrypt with AES-GCM - the encrypted_blob should already be in correct format
  size_t ptLen = encrypted_data_len;  // We know the exact encrypted data length
  uint8_t* pt = (uint8_t*)ps_malloc(encrypted_data_len);
  if (!pt) {
    Serial.println("backup_code_load_from_sd: Memory allocation failed for plaintext");
    secure_memzero(encrypted_blob, len);
    free(encrypted_blob);
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_load_from_sd: Password length: ");
  Serial.println(strlen(password));
  Serial.print("backup_code_load_from_sd: Encrypted blob length: ");
  Serial.println(len);
  Serial.println("backup_code_load_from_sd: Starting AES-GCM decryption...");
#endif

  // The encrypted_blob should already be in the correct format: [IV:12] + [Encrypted] + [Tag:16]
  bool decrypt_result = aes_gcm_decrypt(password, salt, encrypted_blob, len, pt, &ptLen);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_load_from_sd: AES-GCM decrypt result: ");
  Serial.println(decrypt_result ? "SUCCESS" : "FAILED");
#endif

  if (!decrypt_result) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("backup_code_load_from_sd: Decryption failed - checking parameters...");
    Serial.print("backup_code_load_from_sd: encrypted_blob ptr: ");
    Serial.println((uintptr_t)encrypted_blob, HEX);
    Serial.print("backup_code_load_from_sd: pt ptr: ");
    Serial.println((uintptr_t)pt, HEX);
    Serial.print("backup_code_load_from_sd: ptLen ptr: ");
    Serial.println((uintptr_t)&ptLen, HEX);
    Serial.println("backup_code_load_from_sd: This is likely an authentication failure:");
    Serial.println("backup_code_load_from_sd: 1. Wrong password?");
    Serial.println("backup_code_load_from_sd: 2. Data corruption?");
    Serial.println("backup_code_load_from_sd: 3. Format mismatch?");
#endif
    secure_memzero(encrypted_blob, len);
    free(encrypted_blob);
    secure_memzero(pt, encrypted_data_len);
    free(pt);
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("backup_code_load_from_sd: Decryption successful, plaintext length: ");
  Serial.println(ptLen);
#endif

  // Copy to output
  if (ptLen >= outCodeLen) {
    Serial.println("backup_code_load_from_sd: Output buffer too small");
    secure_memzero(encrypted_blob, len);
    free(encrypted_blob);
    secure_memzero(pt, encrypted_data_len);
    free(pt);
    return false;
  }

  memcpy(outCode, pt, ptLen);
  outCode[ptLen] = 0;
  secure_memzero(encrypted_blob, len);
  free(encrypted_blob);
  secure_memzero(pt, encrypted_data_len);
  free(pt);

  Serial.println("backup_code_load_from_sd: Load completed successfully");
  return true;
}

// E2E test (run on device): Unlock vault -> PASSWORDS -> ADD -> add one or more passwords ->
// save to SD (pw_v1.bin created) -> reboot -> unlock -> PASSWORDS -> ADD -> confirm "Restored N password(s)"
// and list rendered. Failure cases: wrong vault password / different seed -> ERROR_SCREEN with clear message.

/** Stateful: write master seed vault_blob to NVS (Backup_*.bin restore does this via SPB1; PW_*.bin did not). */
static bool persist_session_seed_vault_to_nvs(const char* password) {
  if (g_stateless || g_duressSession) return true;
  if (!password || strlen(password) < 4) return false;
  if (!g_loggedIn || !(g_wc == 12 || g_wc == 24)) return false;

  uint16_t idx[24];
  for (int i = 0; i < g_wc; i++) {
    int16_t fi = bip39_find_index(g_seed[i]);
    if (fi < 0) return false;
    idx[i] = (uint16_t)fi;
  }
  size_t seedBytesLen = packed_len_for_words(g_wc);
  uint8_t seedPacked[33];
  if (!pack_seed_indices(idx, g_wc, seedPacked, sizeof(seedPacked))) return false;

  uint8_t salt[4];
  esp_fill_random(salt, sizeof(salt));
  uint8_t ct[65];
  size_t ctLen = sizeof(ct);
  if (!aes_gcm_encrypt(password, salt, seedPacked, seedBytesLen, ct, &ctLen)) {
    secure_memzero(seedPacked, sizeof(seedPacked));
    return false;
  }
  secure_memzero(seedPacked, sizeof(seedPacked));

  uint8_t hdr[2 + 4 + 65 + 2];
  size_t p = 0;
  hdr[p++] = 1;
  hdr[p++] = g_wc;
  memcpy(hdr + p, salt, 4);
  p += 4;
  memcpy(hdr + p, ct, ctLen);
  p += ctLen;
  uint16_t crc = crc16_ccitt(hdr, p);
  hdr[p++] = (uint16_t)((crc >> 8) & 0xFF);
  hdr[p++] = (uint16_t)(crc & 0xFF);

  if (!nvs_save_vault(hdr, p)) return false;
  g_hasVault = true;
  return true;
}

static void pw_vault_sd_spua_free(uint8_t*& blob, size_t& len) {
  if (blob) {
    secure_memzero(blob, len);
    free(blob);
    blob = nullptr;
    len = 0;
  }
}

static bool pw_vault_load_from_sd(const char* masterPw) {
  Serial.println("pw_vault_load_from_sd: Starting load...");
  uint8_t* sd_spua_blob = nullptr;
  size_t sd_spua_len = 0;
  // HOME restore can be logged-out with stale wc/seed fields; treat not-logged-in as no active session.
  const bool hadNoSession = (!g_loggedIn || g_wc == 0);
  char deferredRestoreWords[24][16] = { { 0 } };
  uint8_t deferredRestoreWc = 0;
  if (!masterPw || strlen(masterPw) < 4) {
    setMsg("Password too short");
    return false;
  }
  if (!sd_ready()) {
    Serial.println("pw_vault_load_from_sd: SD not ready");
    setMsg("SD card not ready");
    return false;
  }
  Serial.println("pw_vault_load_from_sd: SD ready, preparing to load...");

  FILE* f = fopen(PW_FILE, "rb");
  if (!f) {
    // File may be in /sdcard/ root if scan listed it from there
    const char* base = strrchr(PW_FILE, '/');
    if (base && strncmp(PW_FILE, "/sdcard/seedmask/", 17) == 0) {
      char alt[192];
      snprintf(alt, sizeof(alt), "/sdcard/%s", base + 1);
      f = fopen(alt, "rb");
      if (f) {
        strncpy(PW_FILE, alt, sizeof(PW_FILE) - 1);
        PW_FILE[sizeof(PW_FILE) - 1] = 0;
        Serial.print("pw_vault_load_from_sd: Opened from root: ");
        Serial.println(PW_FILE);
      }
    }
  }
  if (!f) {
    Serial.print("pw_vault_load_from_sd: Failed to open file: ");
    Serial.println(PW_FILE);
    setMsg("No backup file on SD");
    return false;
  }

  uint8_t hdr[4];
  uint32_t n = 0;

  // File layout: SPV1 = SPV1(4)|seed_salt(4)|encrypted_seed(53). SPV2 = SPV2(4)|seed_salt(4)|n(2)|encrypted_seed(n) with n=53 or 77.
  if (fread(hdr, 1, 4, f) != 4) {
    fclose(f);
    setMsg("Invalid file");
    return false;
  }
  bool spv2 = (memcmp(hdr, "SPV2", 4) == 0);
  if (!spv2 && memcmp(hdr, "SPV1", 4) != 0) {
    fclose(f);
    setMsg("Invalid file");
    return false;
  }
  uint8_t seed_salt[4];
  if (fread(seed_salt, 1, 4, f) != 4) {
    fclose(f);
    setMsg("File read error");
    return false;
  }

  uint8_t encrypted_seed_data[12 + (1 + 24 * 2) + 16];  // max 77
  size_t encrypted_seed_len;
  if (spv2) {
    uint16_t n;
    if (fread(&n, 1, 2, f) != 2) {
      fclose(f);
      setMsg("File read error");
      return false;
    }
    if (n != 53 && n != 77) {
      fclose(f);
      setMsg("Invalid file");
      return false;
    }
    encrypted_seed_len = fread(encrypted_seed_data, 1, n, f);
    if (encrypted_seed_len != n) {
      fclose(f);
      setMsg("File read error");
      return false;
    }
  } else {
    encrypted_seed_len = fread(encrypted_seed_data, 1, 53, f);
    if (encrypted_seed_len != 53) {
      fclose(f);
      setMsg("File read error");
      return false;
    }
  }

  // Decrypt seed data with vault password (same masterPw and seed_salt as at save)
  uint8_t stored_seed_data[1 + 24 * 2];
  size_t decrypted_seed_len = sizeof(stored_seed_data);
  if (!aes_gcm_decrypt(masterPw, seed_salt, encrypted_seed_data, encrypted_seed_len, stored_seed_data, &decrypted_seed_len)) {
    Serial.println("pw_vault_load_from_sd: Failed to decrypt seed data - wrong vault password");
    secure_memzero(encrypted_seed_data, sizeof(encrypted_seed_data));
    fclose(f);
    setMsg("Wrong password");
    return false;
  }
  secure_memzero(encrypted_seed_data, sizeof(encrypted_seed_data));

  uint8_t stored_wc = stored_seed_data[0];

  // Save writes ct directly (no separate n): ct = salt(4)+len(4)+iv(12)+tag(16)+data; read 8 bytes then len bytes
  uint8_t ct_header[8];
  if (fread(ct_header, 1, 8, f) != 8) {
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    fclose(f);
    setMsg("File read error");
    return false;
  }
  uint32_t ct_len;
  memcpy(&ct_len, ct_header + 4, 4);
  if (ct_len < 28 || ct_len > 16384) {
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    fclose(f);
    setMsg("File corrupted");
    return false;
  }  // allow long notes (iv+tag+plain)
  n = 8 + ct_len;
  uint8_t* ct = (uint8_t*)ps_malloc(n);
  if (!ct) {
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    fclose(f);
    setMsg("Out of memory");
    return false;
  }
  memcpy(ct, ct_header, 8);
  if (fread(ct + 8, 1, ct_len, f) != ct_len) {
    secure_memzero(ct, n);
    free(ct);
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    fclose(f);
    setMsg("File read error");
    return false;
  }
  {
    uint8_t tag[4];
    if (fread(tag, 1, 4, f) == 4 && memcmp(tag, "SPUA", 4) == 0) {
      uint32_t uL = 0;
      if (fread(&uL, 4, 1, f) == 1 && uL >= 12u && uL <= 6200u) {
        sd_spua_blob = (uint8_t*)ps_malloc((size_t)uL);
        if (sd_spua_blob) {
          if (fread(sd_spua_blob, 1, (size_t)uL, f) != (size_t)uL) {
            pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
          } else {
            sd_spua_len = (size_t)uL;
          }
        }
      }
    }
  }
  fclose(f);

  const uint8_t* json_salt = ct;
  const uint8_t* json_ct = ct + 8;
  size_t json_ct_len = ct_len;

  // Create seed-based decryption key using decrypted stored seed data
  uint16_t stored_idx[24];
  for (int i = 0; i < stored_wc; i++) {
    stored_idx[i] = (stored_seed_data[1 + i * 2] << 8) | stored_seed_data[1 + i * 2 + 1];
  }

  uint8_t stored_seedPacked[33];
  if (!pack_seed_indices(stored_idx, stored_wc, stored_seedPacked, sizeof(stored_seedPacked))) {
    Serial.println("pw_vault_load_from_sd: Failed to pack stored seed");
    secure_memzero(ct, n);
    free(ct);
    pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    setMsg("Data corrupted");
    return false;
  }

  // Verify current session seed matches stored seed (or restore session from file when none)
  size_t cmpLen = packed_len_for_words(stored_wc);
  bool seed_ok = false;
  if (hadNoSession) {
    // No session yet (e.g. user went Restore -> Restore from SD -> vault file only):
    // stage seed words and apply login only after full vault decode succeeds.
    for (int i = 0; i < stored_wc; i++) {
      bip39_get_word(stored_idx[i], deferredRestoreWords[i], sizeof(deferredRestoreWords[0]));
      deferredRestoreWords[i][15] = 0;
    }
    deferredRestoreWc = stored_wc;
    seed_ok = true;
    Serial.println("pw_vault_load_from_sd: No active session; staged seed from vault file");
  } else {
    uint8_t current_seedPacked[33];
    uint16_t current_idx[24];
    for (int i = 0; i < g_wc; i++) {
      int16_t fi = bip39_find_index(g_seed[i]);
      if (fi < 0) {
        secure_memzero(ct, n);
        free(ct);
        pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
        secure_memzero(stored_seed_data, sizeof(stored_seed_data));
        setMsg("Session seed invalid");
        return false;
      }
      current_idx[i] = (uint16_t)fi;
    }
    if (!pack_seed_indices(current_idx, g_wc, current_seedPacked, sizeof(current_seedPacked))) {
      secure_memzero(ct, n);
      free(ct);
      pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
      secure_memzero(stored_seed_data, sizeof(stored_seed_data));
      setMsg("Data corrupted");
      return false;
    }
    if (stored_wc == g_wc && cmpLen <= 33 && memcmp(stored_seedPacked, current_seedPacked, cmpLen) == 0)
      seed_ok = true;
  }
  if (!seed_ok) {
    Serial.println("pw_vault_load_from_sd: Seed mismatch - vault was created with different seed");
    secure_memzero(ct, n);
    free(ct);
    pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    setMsg("Backup from different seed");
    return false;
  }
  secure_memzero(stored_seed_data, sizeof(stored_seed_data));

  // Create seed-specific vault password by hashing vault password with stored seed
  uint8_t seed_hash[32];
  mbedtls_sha256_context sha_ctx;
  mbedtls_sha256_init(&sha_ctx);
  mbedtls_sha256_starts(&sha_ctx, 0);  // 0 for SHA256
  mbedtls_sha256_update(&sha_ctx, (const uint8_t*)masterPw, strlen(masterPw));
  mbedtls_sha256_update(&sha_ctx, stored_seedPacked, cmpLen);
  mbedtls_sha256_finish(&sha_ctx, seed_hash);

  // Convert hash to hex string for password
  char seed_specific_pw[65];
  for (int i = 0; i < 32; i++) {
    sprintf(seed_specific_pw + i * 2, "%02x", seed_hash[i]);
  }
  seed_specific_pw[64] = 0;  // null terminate

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("pw_vault_load_from_sd: Seed hash (first 8 bytes): ");
  for (int i = 0; i < 8; i++) {
    Serial.print(seed_hash[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
  Serial.print("pw_vault_load_from_sd: Seed-specific password: ");
  Serial.println(seed_specific_pw);
#endif

  // Decrypt JSON with AES-GCM using seed-specific password
  const size_t ptBufCap = json_ct_len;
  size_t ptLen = json_ct_len;
  uint8_t* pt = (uint8_t*)ps_malloc(ptBufCap);
  if (!pt) {
    secure_memzero(ct, n);
    free(ct);
    pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
    secure_memzero(seed_hash, sizeof(seed_hash));
    secure_memzero(seed_specific_pw, sizeof(seed_specific_pw));
    setMsg("Out of memory");
    return false;
  }

  if (!aes_gcm_decrypt(seed_specific_pw, json_salt, json_ct, json_ct_len, pt, &ptLen)) {
    // Legacy: old saves used 16 bytes of seed in KDF (bug); try that for 12-word vaults
    if (stored_wc == 12 && cmpLen >= 16) {
      Serial.println("pw_vault_load_from_sd: Retrying with legacy 16-byte seed KDF...");
      mbedtls_sha256_init(&sha_ctx);
      mbedtls_sha256_starts(&sha_ctx, 0);
      mbedtls_sha256_update(&sha_ctx, (const uint8_t*)masterPw, strlen(masterPw));
      mbedtls_sha256_update(&sha_ctx, stored_seedPacked, 16);
      mbedtls_sha256_finish(&sha_ctx, seed_hash);
      for (int i = 0; i < 32; i++) sprintf(seed_specific_pw + i * 2, "%02x", seed_hash[i]);
      seed_specific_pw[64] = 0;
      ptLen = json_ct_len;
      if (aes_gcm_decrypt(seed_specific_pw, json_salt, json_ct, json_ct_len, pt, &ptLen)) {
        // success with legacy KDF
      } else {
        secure_memzero(ct, n);
        free(ct);
        pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
        secure_memzero(pt, ptBufCap);
        free(pt);
        secure_memzero(seed_hash, sizeof(seed_hash));
        secure_memzero(seed_specific_pw, sizeof(seed_specific_pw));
        setMsg("Wrong password or data corrupted");
        return false;
      }
    } else {
      Serial.println("pw_vault_load_from_sd: Decryption failed - wrong seed or password");
      secure_memzero(ct, n);
      free(ct);
      pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
      secure_memzero(pt, ptBufCap);
      free(pt);
      secure_memzero(seed_hash, sizeof(seed_hash));
      secure_memzero(seed_specific_pw, sizeof(seed_specific_pw));
      setMsg("Wrong password or data corrupted");
      return false;
    }
  }

  secure_memzero(seed_hash, sizeof(seed_hash));
  secure_memzero(seed_specific_pw, sizeof(seed_specific_pw));
  secure_memzero(ct, n);
  free(ct);

  // Null-terminate decrypted payload
  const size_t plainAlloc = ptLen + 1;
  char* plainStr = (char*)ps_malloc(plainAlloc);
  if (!plainStr) {
    secure_memzero(pt, ptBufCap);
    free(pt);
    pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
    setMsg("Out of memory");
    return false;
  }
  memcpy(plainStr, pt, ptLen);
  plainStr[ptLen] = 0;
  secure_memzero(pt, ptBufCap);
  free(pt);

  // PasswordService + vault_import require vault unlocked; cold SD restore has no session yet.
  if (hadNoSession && deferredRestoreWc) {
    session_login_from_seed((const char(*)[16])deferredRestoreWords, deferredRestoreWc, "");
    Serial.println("pw_vault_load_from_sd: Session established before importing vault plaintext");
  }

  // New format: plain text with "\n---N---\n" (passwords + notes) and optional "\n---T---\n" (2FA).
  const char* sepN = "\n---N---\n";
  const char* sepT = "\n---T---\n";
  const char* notesPart = strstr(plainStr, sepN);
  if (notesPart) {
    size_t pwLen = (size_t)(notesPart - plainStr);
    vault_import_passwords_plaintext(plainStr, pwLen);
    const char* afterNotes = notesPart + strlen(sepN);
    const char* totpPart = strstr(afterNotes, sepT);
    if (totpPart && totpPart >= afterNotes) {
      notes_deserialize_plain(afterNotes, (size_t)(totpPart - afterNotes));
      totp_deserialize_plain(totpPart + strlen(sepT), ptLen - (size_t)(totpPart - plainStr) - strlen(sepT));
    } else {
      notes_deserialize_plain(afterNotes, ptLen - pwLen - strlen(sepN));
    }
    Serial.print("pw_vault_load_from_sd: Loaded plain format: ");
    Serial.print(pwSvc_getCount());
    Serial.print(" pw, ");
    Serial.print(g_noteCount);
    Serial.print(" notes, ");
    Serial.print(g_totpCount);
    Serial.println(" 2FA");
    if (sd_spua_blob && sd_spua_len) {
      (void)addr_status_apply_blob(sd_spua_blob, sd_spua_len, true);
    }
    pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
    secure_memzero(plainStr, plainAlloc);
    free(plainStr);
    if (!persist_session_seed_vault_to_nvs(masterPw)) {
      setMsg("Failed to save seed to device");
      return false;
    }
    return true;
  }

  // Legacy: JSON format (passwords only)
  pwSvc_clearAll();
  g_noteCount = 0;
  char* jsonStr = plainStr;

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("pw_vault_load_from_sd: Plaintext length: ");
  Serial.print(ptLen);
  Serial.print(", JSON length: ");
  Serial.print(strlen(jsonStr));
  Serial.println(", JSON content: ");
  Serial.println(jsonStr);

  Serial.print("pw_vault_load_from_sd: Parsing JSON: ");
  Serial.println(jsonStr);
#endif

  // Simple JSON parser for our specific format
  char* ptr = jsonStr;
  bool parseError = false;

  // Skip opening brace
  if (*ptr != '{') {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("pw_vault_load_from_sd: Invalid format - not plain and not JSON");
#endif
    secure_memzero(plainStr, plainAlloc);
    free(plainStr);
    pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
    setMsg("Data corrupted");
    return false;
  }
  ptr++;

  while (*ptr && *ptr != '}' && pwSvc_getCount() < PW_MAX_ITEMS) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("pw_vault_load_from_sd: Loop iteration ");
    Serial.print(pwSvc_getCount());
    Serial.print(", ptr points to: '");
    Serial.print(*ptr);
    Serial.println("'");
#endif

    // Skip whitespace
    while (*ptr && (*ptr == ' ' || *ptr == '\n' || *ptr == '\r' || *ptr == '\t')) ptr++;
    if (!*ptr || *ptr == '}') break;

    // Expect opening quote for title
    if (*ptr != '"') {
#if SEEDMASK_CRYPTO_DEBUG
      Serial.print("pw_vault_load_from_sd: Invalid JSON format - expected opening quote, got: ");
      Serial.println(*ptr, HEX);
#endif
      parseError = true;
      setMsg("Data corrupted");
      break;
    }
    ptr++;

    // Extract title
    char* titleStart = ptr;
    while (*ptr && *ptr != '"') ptr++;
    if (!*ptr) {
      parseError = true;
      setMsg("Data corrupted");
      break;
    }

    size_t titleLen = (size_t)(ptr - titleStart);
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("pw_vault_load_from_sd: Title length: ");
    Serial.println(titleLen);
#endif

    char titleBuf[sizeof(PwItem::title)];
    if (titleLen >= sizeof(titleBuf)) titleLen = sizeof(titleBuf) - 1;
    memcpy(titleBuf, titleStart, titleLen);
    titleBuf[titleLen] = 0;
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("pw_vault_load_from_sd: Copied title: ");
    Serial.println(titleBuf);
#endif
    ptr++;  // Skip closing quote

    // Skip whitespace
    while (*ptr && (*ptr == ' ' || *ptr == '\n' || *ptr == '\r' || *ptr == '\t')) ptr++;
    if (!*ptr || *ptr == '}') break;

    // Expect colon
    if (*ptr != ':') {
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("pw_vault_load_from_sd: Invalid JSON format - expected colon");
#endif
      parseError = true;
      setMsg("Data corrupted");
      break;
    }
    ptr++;

    // Skip whitespace
    while (*ptr && (*ptr == ' ' || *ptr == '\n' || *ptr == '\r' || *ptr == '\t')) ptr++;
    if (!*ptr || *ptr == '}') break;

    // Expect opening quote for value
    if (*ptr != '"') {
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("pw_vault_load_from_sd: Invalid JSON format - expected opening quote for value");
#endif
      parseError = true;
      setMsg("Data corrupted");
      break;
    }
    ptr++;

    // Extract value
    char* valueStart = ptr;
    while (*ptr && *ptr != '"') ptr++;
    if (!*ptr) {
      parseError = true;
      setMsg("Data corrupted");
      break;
    }

    size_t valueLen = (size_t)(ptr - valueStart);
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("pw_vault_load_from_sd: Value length: ");
    Serial.println(valueLen);
#endif

    char valueBuf[sizeof(PwItem::value)];
    if (valueLen >= sizeof(valueBuf)) valueLen = sizeof(valueBuf) - 1;
    memcpy(valueBuf, valueStart, valueLen);
    valueBuf[valueLen] = 0;
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("pw_vault_load_from_sd: Copied value: ");
    Serial.println(valueBuf);
#endif
    ptr++;  // Skip closing quote

    // One full entry (title + value) parsed; append via PasswordService
    if (!pwSvc_append(titleBuf, valueBuf)) {
      parseError = true;
      setMsg("PW list full");
      break;
    }
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("pw_vault_load_from_sd: Incremented password count to ");
    Serial.println(pwSvc_getCount());
    Serial.print("pw_vault_load_from_sd: Loaded password ");
    Serial.print(pwSvc_getCount() - 1);
    Serial.print(": ");
    Serial.print(pwSvc_getTitleCStr(pwSvc_getCount() - 1));
    Serial.print(" -> ");
    Serial.println(pwSvc_getValueCStr(pwSvc_getCount() - 1));
#endif

    // Skip whitespace
    while (*ptr && (*ptr == ' ' || *ptr == '\n' || *ptr == '\r' || *ptr == '\t')) ptr++;
    if (!*ptr || *ptr == '}') break;

    // Expect comma or closing brace
    if (*ptr == ',') {
      ptr++;  // Skip comma and continue
    } else if (*ptr == '}') {
      break;  // End of JSON
    } else {
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("pw_vault_load_from_sd: Invalid JSON format - expected comma or closing brace");
#endif
      parseError = true;
      setMsg("Data corrupted");
      break;
    }
  }

  if (parseError) {
    secure_memzero(plainStr, plainAlloc);
    free(plainStr);
    pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
    return false;
  }

  secure_memzero(plainStr, plainAlloc);
  free(plainStr);
  if (sd_spua_blob && sd_spua_len) {
    (void)addr_status_apply_blob(sd_spua_blob, sd_spua_len, true);
  }
  pw_vault_sd_spua_free(sd_spua_blob, sd_spua_len);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("pw_vault_load_from_sd: Loaded legacy JSON: ");
  Serial.print(pwSvc_getCount());
  Serial.println(" password(s)");
#endif
  if (!persist_session_seed_vault_to_nvs(masterPw)) {
    setMsg("Failed to save seed to device");
    return false;
  }
  return true;
}

