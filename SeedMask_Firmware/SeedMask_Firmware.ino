static void handleCryptoTempSeedTap(uint16_t x, uint16_t y) {
  if (g_tempSeedAlreadyInUsePopup) {
    if (hitPad(g_btnTempAlreadyOkHit, x, y, 10)) {
      g_tempSeedAlreadyInUsePopup = false;
      g_tempSeedImportMode = TempSeedImportMode::NONE;
      setMsg("");
      draw();
    }
    return;
  }
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_optionsHomeScreen = UIScreen::CRYPTO_SETTINGS;
    show(UIScreen::BURGER_MENU);
    return;
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    const int16_t padHit = 4;
    const Rect rTempSeedInfo = {
      (int16_t)(infoCx - infoHalf - padHit), (int16_t)(infoCy - infoHalf - padHit),
      (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHit), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHit)
    };
    if (hit(rTempSeedInfo, x, y)) {
      flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
      delay(85);
      show(UIScreen::CRYPTO_TEMP_SEED_INFO);
      return;
    }
  }
  if (g_tempSeedActive) {
    if (hit(BTN_TEMP_CLEAR, x, y)) {
      temp_seed_clear();
      setMsg("Temporary seed cleared");
      draw();
    }
    return;
  }
  if (hit(BTN_TEMP_USE_BIP85, x, y)) {
    g_tempSeedBip85Flow = true;
    g_bip85IndexBuf[0] = 0;
    setMsg("");
    show(UIScreen::CRYPTO_BIP85_WORDLEN);
    return;
  }
  if (hit(BTN_TEMP_MANUAL, x, y)) {
    g_tempSeedImportMode = TempSeedImportMode::MANUAL_WORDS;
    g_restoreSeedFlowActive = false;
    g_restoreSeedEntryMode = false;
    g_restoreSeedQrOnlyScan = false;
    g_restoreCodeEntryMode = false;
    restorePayload_clear();
    setMsg("");
    show(UIScreen::BACKUP_CHOOSE_WORDS);
    return;
  }
  if (hit(BTN_TEMP_SCAN_SEEDQR, x, y)) {
    g_tempSeedImportMode = TempSeedImportMode::SEED_QR;
    g_restoreSeedFlowActive = false;
    g_restoreSeedEntryMode = false;
    g_restoreCodeEntryMode = false;
    restorePayload_clear();
    g_qrScanTarget = QrScanTarget::RESTORE;
    g_restoreSeedQrOnlyScan = true;
    prepareQrScanDefaults();
    g_restoreChunkTotal = 0;
    memset(g_restoreChunkGot, 0, sizeof(g_restoreChunkGot));
    if (!start_qr_scan()) {
      setMsg("Camera init failed");
      draw();
      return;
    }
    g_qrScanning = true;
    setMsg("Scan SeedQR");
    show(UIScreen::RESTORE_SCAN_QR);
    return;
  }
  if (hit(BTN_TEMP_SCAN_ENCRYPTED_QR, x, y)) {
    g_tempSeedImportMode = TempSeedImportMode::BACKUP_CODE;
    g_cryptoTempSeedBackupRestoreFlow = true;
    g_restoreSeedFlowActive = false;
    g_restoreSeedEntryMode = false;
    g_restoreCodeEntryMode = false;
    restorePayload_clear();
    g_qrScanTarget = QrScanTarget::RESTORE;
    g_restoreSeedQrOnlyScan = false;
    prepareQrScanDefaults();
    g_restoreChunkTotal = 0;
    memset(g_restoreChunkGot, 0, sizeof(g_restoreChunkGot));
    if (!start_qr_scan()) {
      setMsg("Camera init failed");
      draw();
      return;
    }
    g_qrScanning = true;
    setMsg("");
    show(UIScreen::RESTORE_SCAN_QR);
    return;
  }
  if (hit(BTN_TEMP_IMPORT_BACKUP, x, y)) {
    g_tempSeedImportMode = TempSeedImportMode::BACKUP_CODE;
    g_cryptoTempSeedBackupRestoreFlow = true;
    g_restoreSeedFlowActive = false;
    g_restoreSeedEntryMode = false;
    g_restoreSeedQrOnlyScan = false;
    g_restoreCodeEntryMode = true;
    restorePayload_clear();
    setMsg("");
    show(UIScreen::RESTORE_CODE);
    return;
  }
}

