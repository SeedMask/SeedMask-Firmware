static void handleCryptoMultisigWalletTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_multisigWalletShowDeleteConfirm = false;
    g_optionsHomeScreen = UIScreen::CRYPTO_MULTISIG_WALLET;
    show(UIScreen::BURGER_MENU);
    return;
  }
  if (!vault_is_unlocked() || !g_loggedIn) {
    setMsgTr("Unlock first", "Prvo otkljucajte");
    show(UIScreen::LOCKED);
    return;
  }
  {
    uint32_t cur = MULTISIG_CTX_TAG_UNKNOWN;
    if (g_multisigSelectedIdx >= g_multisigWalletCount || !current_master_xfp_u32(&cur)
        || g_multisigWalletContextTag[g_multisigSelectedIdx] != cur) {
      g_multisigWalletShowDeleteConfirm = false;
      show(UIScreen::CRYPTO_MULTISIG_SETTINGS);
      return;
    }
  }
  if (g_multisigWalletShowDeleteConfirm) {
    const int popupW = 260, popupH = 120;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    Rect rYes = { (int16_t)(popupX + 20), (int16_t)(popupY + 72), 100, 40 };
    Rect rCancel = { (int16_t)(popupX + 140), (int16_t)(popupY + 72), 100, 40 };
    if (hit(rYes, x, y)) {
      g_multisigWalletShowDeleteConfirm = false;
      multisig_delete_wallet(g_multisigSelectedIdx);
      if (g_multisigWalletCount > 0 && g_multisigSelectedIdx >= g_multisigWalletCount) {
        g_multisigSelectedIdx = (uint8_t)(g_multisigWalletCount - 1);
      }
      setMsg("Wallet deleted");
      show(UIScreen::CRYPTO_MULTISIG_SETTINGS);
      return;
    }
    if (hit(rCancel, x, y)) {
      g_multisigWalletShowDeleteConfirm = false;
      draw();
      return;
    }
    return;
  }
  if (hit(BTN_MULTISIG_WALLET_VIEW, x, y)) {
    memcpy(g_multisigPolicyPayload, g_multisigWalletPayloads[g_multisigSelectedIdx], MULTISIG_WALLET_PAYLOAD_BYTES);
    g_multisigPolicyPayload[MULTISIG_WALLET_PAYLOAD_BYTES - 1] = 0;
    if (multisig_prepare_review_from_payload(g_multisigPolicyPayload, false)) {
      g_multisigReviewReturnScreen = UIScreen::CRYPTO_MULTISIG_WALLET;
      show(UIScreen::CRYPTO_MULTISIG_IMPORT_REVIEW);
    } else {
      if (!g_msg[0]) setMsg("No details available");
      draw();
    }
    return;
  }
  if (hit(BTN_MULTISIG_WALLET_EXPORT_QR, x, y)) {
    snprintf(g_viewQrCustomPayload, VIEW_QR_CUSTOM_PAYLOAD_MAX, "%s", g_multisigWalletPayloads[g_multisigSelectedIdx]);
    snprintf(g_viewQrCustomTitle, sizeof(g_viewQrCustomTitle), "Multisig policy");
    g_viewQrCustomBackScreen = UIScreen::CRYPTO_MULTISIG_WALLET;
    g_viewQrCustomDoneScreen = UIScreen::CRYPTO_MULTISIG_WALLET;
    g_viewQrCustomActive = true;
    show(UIScreen::VIEW_QR);
    return;
  }
  if (hit(BTN_MULTISIG_WALLET_EXPORT_SD, x, y)) {
    char outPath[160] = { 0 };
    if (!multisig_export_selected_wallet_to_sd(outPath, sizeof(outPath))) {
      draw();
      return;
    }
    const char* fn = strrchr(outPath, '/');
    setMsg(fn ? fn + 1 : "Multisig saved to SD");
    draw();
    return;
  }
  if (hit(BTN_MULTISIG_WALLET_RENAME, x, y)) {
    g_multisigRenameActive = true;
    g_accountNameEditIsRename = false;
    snprintf(g_newAccountNameBuf, sizeof(g_newAccountNameBuf), "%s", g_multisigWalletNames[g_multisigSelectedIdx]);
    show(UIScreen::CRYPTO_NEW_ACCOUNT_NAME);
    return;
  }
  if (hit(BTN_MULTISIG_WALLET_DELETE, x, y)) {
    g_multisigWalletShowDeleteConfirm = true;
    draw();
    return;
  }
}

