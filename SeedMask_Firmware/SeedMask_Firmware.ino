static void handleSecurityLockPwSetupTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_secLockPwSetupPhase = 0;
    g_screenLockPwFirst[0] = 0;
    g_secLockPwReauthPending = false;
    g_secLockPwSetupMoreOpen = false;
    g_secLockSwitchToPin = false;
    clearPassword(g_password1);
    setMsg("");
    show(g_onboardLockFlow ? UIScreen::CREATE_LOCK_TYPE : UIScreen::SECURITY_LOCK_TYPE);
    return;
  }
  if (hit(RECT_TOP_TITLE, x, y)) {
    g_secLockPwSetupPhase = 0;
    g_screenLockPwFirst[0] = 0;
    g_secLockPwReauthPending = false;
    g_secLockPwSetupMoreOpen = false;
    g_secLockSwitchToPin = false;
    clearPassword(g_password1);
    setMsg("");
    show(g_onboardLockFlow ? UIScreen::CREATE_LOCK_TYPE : UIScreen::SECURITY_LOCK_TYPE);
    return;
  }
  if (hit(BTN_BACK_PW, x, y)) {
    flashKeyRect(BTN_BACK_PW);
    g_secLockPwSetupPhase = 0;
    g_screenLockPwFirst[0] = 0;
    g_secLockPwReauthPending = false;
    g_secLockPwSetupMoreOpen = false;
    g_secLockSwitchToPin = false;
    clearPassword(g_password1);
    setMsg("");
    show(g_onboardLockFlow ? UIScreen::CREATE_LOCK_TYPE : UIScreen::SECURITY_LOCK_TYPE);
    return;
  }
  if (g_password1[0] && hit(BTN_PW_SHOWHIDE, x, y)) {
    g_pwMasked = !g_pwMasked;
    draw();
    return;
  }
  if (hitOkKey(x, y)) {
    flashKeyRectTranslucent(keyRectRow4[2]);
    if (g_secLockPwReauthPending && g_secLockPwSetupPhase == 0) {
      char mpwTest[128];
      if (strlen(g_password1) < 1) {
        draw();
        return;
      }
      bool currentOk = false;
      if (g_screenLockSeparatePw) {
        currentOk = screen_lock_separate_pw_unwrap(g_password1, mpwTest, sizeof(mpwTest));
        secure_memzero(mpwTest, sizeof(mpwTest));
      } else {
        // Legacy vault-as-lock: current unlock secret is the vault password.
        currentOk = (strcmp(g_password1, g_masterPw) == 0);
      }
      if (!currentOk) {
        setMsg("Wrong password");
        clearPassword(g_password1);
        draw();
        return;
      }
      clearPassword(g_password1);
      if (g_secLockSwitchToPin) {
        g_secLockSwitchToPin = false;
        g_secLockPwReauthPending = false;
        g_secLockPwSetupPhase = 0;
        g_screenLockPwFirst[0] = 0;
        g_pinSetupIsChanging = false;
        g_pinSetupSwitchToPassword = false;
        g_pinSetupPhase = 0;
        g_pinFirstEntry[0] = 0;
        setMsg("");
        show(UIScreen::SECURITY_PIN_SETUP);
        return;
      }
      g_secLockPwSetupPhase = 1;
      setMsg("Enter new password (8+)");
      draw();
      return;
    }
    const bool atNewEntry = (!g_secLockPwReauthPending && g_secLockPwSetupPhase == 0)
                            || (g_secLockPwReauthPending && g_secLockPwSetupPhase == 1);
    if (atNewEntry) {
      if (strlen(g_password1) < (size_t)SCREEN_LOCK_SEP_PW_MIN_LEN) {
        setMsg("Use at least 8 characters");
        draw();
        return;
      }
      strncpy(g_screenLockPwFirst, g_password1, sizeof(g_screenLockPwFirst) - 1);
      g_screenLockPwFirst[sizeof(g_screenLockPwFirst) - 1] = 0;
      clearPassword(g_password1);
      g_secLockPwSetupPhase = g_secLockPwReauthPending ? 2 : 1;
      setMsg("Enter same password again");
      draw();
      return;
    }
    if (strcmp(g_password1, g_screenLockPwFirst) != 0) {
      setMsg("No match. Enter 8+ chars again.");
      g_secLockPwSetupPhase = g_secLockPwReauthPending ? 1 : 0;
      g_screenLockPwFirst[0] = 0;
      clearPassword(g_password1);
      draw();
      return;
    }
    if (g_onboardLockFlow) {
      strncpy(g_onboardLockCred, g_screenLockPwFirst, sizeof(g_onboardLockCred) - 1);
      g_onboardLockCred[sizeof(g_onboardLockCred) - 1] = 0;
      g_onboardLockIsPin = false;
      if (g_onboardLockAfterCreate) {
        setMsg("Saving...");
        draw();
        if (!onboard_ensure_create_vault_from_seedgen()) {
          if (!g_msg[0] || strcmp(g_msg, "Saving...") == 0) setMsg("Vault save failed");
          show(UIScreen::CREATE_LOCK_TYPE);
          return;
        }
      } else if (!g_masterPw[0]) {
        // Typed mnemonic / SeedQR restore: need an internal vault master before wrapping lock.
        setMsg("Saving...");
        draw();
        if (!onboard_ensure_restore_vault_from_session_seed()) {
          if (!g_msg[0] || strcmp(g_msg, "Saving...") == 0) setMsg("Vault save failed");
          show(UIScreen::CREATE_LOCK_TYPE);
          return;
        }
      }
      if (!screen_lock_separate_pw_wrap_and_save(g_onboardLockCred)) {
        setMsg("Could not save");
        draw();
        return;
      }
      duress_clear_incompatible_with_screen_lock();
      onboard_finish_lock_setup_success();
      return;
    }
    if (!screen_lock_separate_pw_wrap_and_save(g_screenLockPwFirst)) {
      setMsg("Could not save");
      draw();
      return;
    }
    duress_clear_incompatible_with_screen_lock();
    g_secLockPwReauthPending = false;
    g_secLockPwSetupPhase = 0;
    g_screenLockPwFirst[0] = 0;
    clearPassword(g_password1);
    setMsg("Screen lock: Password");
    show(UIScreen::SECURITY_LOCK_TYPE);
    return;
  }
  passwordInputTap(x, y, g_password1, sizeof(g_password1));
}

