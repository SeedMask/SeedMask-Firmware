static void kb_layout_init(int y0) {
  int usableW = LCD_W;
  int y1 = y0 + KB_KEYS_Y_SHIFT;
  int y2 = y1 + KEY_H_MAIN + KEY_VERT_GAP;
  int y3 = y2 + KEY_H_MAIN + KEY_VERT_GAP;
  int y4 = y3 + KEY_H_MAIN + KEY_VERT_GAP;

  int rem1 = (usableW - (ROW1_N - 1) * KEY_GAP_ROW1) % ROW1_N;
  int keyW1base = (usableW - (ROW1_N - 1) * KEY_GAP_ROW1) / ROW1_N;
  int x1 = 0;
  for (int i = 0; i < ROW1_N; i++) {
    int w = keyW1base + (i < rem1 ? 1 : 0);
    keyRectRow1[i] = { (int16_t)x1, (int16_t)y1, (int16_t)w, (int16_t)KEY_H_MAIN };
    x1 += w + KEY_GAP_ROW1;
  }

  int rem2 = (usableW - (ROW2_N - 1) * KEY_GAP_MAIN) % ROW2_N;
  int keyW2base = (usableW - (ROW2_N - 1) * KEY_GAP_MAIN) / ROW2_N;
  int x2 = (usableW - (ROW2_N * keyW2base + (rem2 ? rem2 : 0) + (ROW2_N - 1) * KEY_GAP_MAIN)) / 2;
  if (x2 < 0) x2 = 0;
  for (int i = 0; i < ROW2_N; i++) {
    int w = keyW2base + (i < rem2 ? 1 : 0);
    keyRectRow2[i] = { (int16_t)x2, (int16_t)y2, (int16_t)w, (int16_t)KEY_H_MAIN };
    x2 += w + KEY_GAP_MAIN;
  }

  int rem3 = (usableW - 8 * KEY_GAP_MAIN) % 9;
  int w3base = (usableW - 8 * KEY_GAP_MAIN) / 9;
  int x3 = 0;
  for (int i = 0; i < ROW3_N; i++) {
    int w = w3base + (i < rem3 ? 1 : 0);
    keyRectRow3[i] = { (int16_t)x3, (int16_t)y3, (int16_t)w, (int16_t)KEY_H_MAIN };
    x3 += w + KEY_GAP_MAIN;
  }

  int w4_ok = 64;
  int w4_sym = 76;
  int w4_space = usableW - w4_sym - w4_ok - 2 * GAP;
  if (w4_space < 80) {
    w4_sym = 70;
    w4_ok = 60;
    w4_space = usableW - w4_sym - w4_ok - 2 * GAP;
  }
  keyRectRow4[0] = { (int16_t)0, (int16_t)y4, (int16_t)w4_sym, (int16_t)KEY_H };
  keyRectRow4[1] = { (int16_t)(w4_sym + GAP), (int16_t)y4, (int16_t)w4_space, (int16_t)KEY_H };
  keyRectRow4[2] = { (int16_t)(w4_sym + GAP + w4_space + GAP), (int16_t)y4, (int16_t)w4_ok, (int16_t)KEY_H };
}

