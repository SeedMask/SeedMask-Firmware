    for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
      int rx = c * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
      int ry = SETTIME_NUMPAD_Y0 + r * (SETTIME_KEY_H + SETTIME_NUMPAD_GAP);
      Rect rect = { (int16_t)rx, (int16_t)ry, (int16_t)SETTIME_KEY_W, (int16_t)SETTIME_KEY_H };
      if (r == 3 && c == 0) {
        drawBtn(rect, "Del", RGB565_DARKGREY, 2);
      } else if (r == 3 && c == 2) {
        drawBtn(rect, "OK", okColor, 2);
      } else if (r == 3 && c == 1) {
        drawKeyRect(rect, "0");
      } else {
        char lab[4] = { (char)('1' + r * 3 + c), 0 };
        drawKeyRect(rect, lab);
      }
    }
  }
  if (g_msg[0]) {
    gfx->setTextColor(RGB565_CYAN);
    gfx->setTextSize(1);
    gfx->setCursor(10, 400);
    gfx->print(g_msg);
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    drawWipeInfoBitmapAt(infoCx, infoCy, true);
  }
  ui_flush();
}

static void drawCryptoBip85Show() {
  const uint16_t accent = cryptoSettingsDetailAccent();
