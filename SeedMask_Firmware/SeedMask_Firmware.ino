static bool kaspa_extract_unsigned_payload(char* buf, size_t* inoutLen, size_t cap) {
  if (!buf || !inoutLen || *inoutLen == 0 || *inoutLen >= cap) return false;
  buf[*inoutLen] = 0;
  if (*inoutLen >= 3 && (uint8_t)buf[0] == 0xEF && (uint8_t)buf[1] == 0xBB && (uint8_t)buf[2] == 0xBF) {
    size_t rem = *inoutLen - 3;
    memmove(buf, buf + 3, rem);
    buf[rem] = 0;
    *inoutLen = rem;
  }
  char* p = buf;
  while (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t') p++;
  if (p != buf) {
    size_t rem = strlen(p);
    memmove(buf, p, rem + 1);
    *inoutLen = rem;
  }
  /*
   * Coordinator "Save transaction" writes seedmask_pskt_draft_v1 envelopes:
   *   { "format": "...", "unsigned": { "version": 2, ... }, "pskt": { "redeemScript": null, ... } }
   * A naive version scan finds nested "version":2 and skips unwrap — then "redeemScript":null
   * falsely trips the multisig-policy gate. Always unwrap "unsigned" when present.
   */
  if (strstr(buf, "\"unsigned\"")) {
    if (!kaspa_json_extract_object_after_key_inplace(buf, inoutLen, cap, "unsigned")) {
      return false;
    }
  }
  if (!seedmask_kaspa_unsigned_is_v2(buf, *inoutLen)) {
    return false;
  }
  return kaspa_pskt_qr_payload_looks_valid(buf, *inoutLen);
}

static void kaspa_clear_loaded_unsigned(void) {
  g_kaspaPsktScanLen = 0;
  if (g_kaspaPsktScanBuf) g_kaspaPsktScanBuf[0] = 0;
  g_kaspaHasSigned = false;
  g_kaspaSignedJson[0] = 0;
  g_kaspaExpectedAddr[0] = 0;
  g_kaspaKpubStatus = -1;
  crypto_invalidate_kaspa_review();
}

/** Reject txs that must not enter Review/Sign for this wallet/policy. Sets g_msg on failure. */
static bool kaspa_accept_loaded_unsigned_for_wallet(void) {
  if (!g_kaspaPsktScanLen || !g_kaspaPsktScanBuf || !g_kaspaPsktScanBuf[0]) {
    setMsg("No Kaspa tx loaded");
    return false;
  }
  kaspa_review_refresh_kpub_status();
  const bool isMs = seedmask_kaspa_unsigned_has_multisig_redeem(g_kaspaPsktScanBuf, g_kaspaPsktScanLen);
  if (isMs && g_kaspaMultisigPolicyMode != KaspaMultisigPolicyMode::SKIP_VERIFICATION
      && !kaspa_has_imported_multisig_policy_for_current_account()) {
    setMsg(g_kaspaMultisigPolicyMode == KaspaMultisigPolicyMode::REQUIRE_EXISTING
               ? "Policy required - import first"
               : "Import multisig policy first");
    return false;
  }
  if (g_kaspaKpubStatus == 2) {
    setMsg(isMs ? "Wrong wallet - not a cosigner" : "Wrong wallet (kpub mismatch)");
    return false;
  }
  return true;
}

static bool crypto_load_kaspa_unsigned_from_sd_path(const char* path) {
  FILE* f = fopen(path, "rb");
  if (!f) {
    setMsg("Cannot open file");
    return false;
  }
  size_t n = fread(g_kaspaPsktScanBuf, 1, KASPA_PSKT_SCAN_MAX - 1, f);
  fclose(f);
  g_kaspaPsktScanBuf[n] = 0;
  g_kaspaPsktScanLen = n;
  if (!kaspa_extract_unsigned_payload(g_kaspaPsktScanBuf, &g_kaspaPsktScanLen, KASPA_PSKT_SCAN_MAX)) {
    kaspa_clear_loaded_unsigned();
    setMsg("Not a valid Kaspa unsigned JSON");
    return false;
  }
  g_kaspaHasSigned = false;
  g_kaspaSignedJson[0] = 0;
  g_kaspaExpectedAddr[0] = 0;
  if (!kaspa_accept_loaded_unsigned_for_wallet()) {
    const bool askImport = seedmask_kaspa_unsigned_has_multisig_redeem(g_kaspaPsktScanBuf, g_kaspaPsktScanLen)
                           && g_kaspaMultisigPolicyMode == KaspaMultisigPolicyMode::ASK_TO_IMPORT
                           && !kaspa_has_imported_multisig_policy_for_current_account();
    char errKeep[96];
    strncpy(errKeep, g_msg, sizeof(errKeep) - 1);
    errKeep[sizeof(errKeep) - 1] = 0;
    kaspa_clear_loaded_unsigned();
    if (askImport) {
      show(UIScreen::CRYPTO_MULTISIG_IMPORT);
      setMsg(errKeep[0] ? errKeep : "Import multisig policy first");
    } else {
      setMsg(errKeep);
    }
    return false;
  }
  setMsg("Kaspa tx loaded from microSD");
  show(UIScreen::CRYPTO_REVIEW_KASPA_TX);
  return true;
}

static bool crypto_load_psbt_unsigned_from_sd_path(const char* path) {
  const size_t kCap = 65536;
  uint8_t* raw = (uint8_t*)malloc(kCap);
  if (!raw) {
    setMsg("Out of memory");
    return false;
  }
  FILE* f = fopen(path, "rb");
  if (!f) {
    free(raw);
    setMsg("Cannot open file");
    return false;
  }
  size_t n = fread(raw, 1, kCap - 1, f);
  fclose(f);
  if (n < 4) {
    free(raw);
    setMsg("File too small");
    return false;
  }
  uint8_t* decoded = nullptr;
  size_t decLen = 0;
  char err[128] = { 0 };
  if (n >= 5 && raw[0] == 'p' && raw[1] == 's' && raw[2] == 'b' && raw[3] == 't' && raw[4] == 0xff) {
    decoded = (uint8_t*)malloc(n);
    if (!decoded) {
      secure_memzero(raw, kCap);
      free(raw);
      setMsg("Out of memory");
      return false;
    }
    memcpy(decoded, raw, n);
    decLen = n;
  } else {
    raw[n] = 0;
    char* text = (char*)raw;
    while (*text == ' ' || *text == '\n' || *text == '\r' || *text == '\t') text++;
    if (strncasecmp(text, "ur:", 3) == 0) {
      decoded = (uint8_t*)malloc(kCap);
      if (!decoded) {
        secure_memzero(raw, kCap);
        free(raw);
        setMsg("Out of memory");
        return false;
      }
      if (!seedmask_ur_decode_psbt_payload(text, decoded, kCap, &decLen, err, sizeof(err))) {
        secure_memzero(decoded, kCap);
        free(decoded);
        secure_memzero(raw, kCap);
        free(raw);
        setMsg(err[0] ? err : "UR decode failed");
        return false;
      }
    } else {
      decoded = (uint8_t*)malloc(kCap);
      if (!decoded) {
        secure_memzero(raw, kCap);
        free(raw);
        setMsg("Out of memory");
        return false;
      }
      decLen = base64_decode(text, decoded, kCap);
      if (decLen < 5) {
        secure_memzero(decoded, kCap);
        free(decoded);
        secure_memzero(raw, kCap);
        free(raw);
        setMsg("Not PSBT / UR / base64");
        return false;
      }
    }
  }
  secure_memzero(raw, kCap);
  free(raw);
  if (!seedmask_psbt_validate_decoded(decoded, decLen, err, sizeof(err))) {
    secure_memzero(decoded, decLen);
    free(decoded);
    setMsg(err[0] ? err : "Invalid PSBT");
    return false;
  }
  crypto_release_psbt_decoded_buf();
  g_cryptoPsbtDecodedBuf = decoded;
  g_cryptoPsbtDecodedLen = decLen;
  g_cryptoHasUnsigned = true;
  g_cryptoHasSigned = false;
  g_cryptoPsbtSignedUr[0] = 0;
  g_cryptoBcUrFountain = false;
  seedmask_bc_ur_reset();
  crypto_invalidate_psbt_review();
  setMsg("PSBT loaded from microSD");
  show(UIScreen::CRYPTO_REVIEW_PSBT);
  return true;
}

static bool crypto_load_unsigned_from_sd_path(const char* path) {
  if (g_cryptoTxSdKaspa) return crypto_load_kaspa_unsigned_from_sd_path(path);
  return crypto_load_psbt_unsigned_from_sd_path(path);
}

static bool crypto_save_signed_kaspa_to_sd() {
  if (!g_kaspaHasSigned || !g_kaspaSignedJson[0]) {
    setMsg("Nothing signed to save");
    return false;
  }
  if (!crypto_ensure_seedmask_sd_dir()) return false;
  char path[192];
  snprintf(path, sizeof(path), "/sdcard/seedmask/kaspa_signed_%lu.json", (unsigned long)millis());
  FILE* f = fopen(path, "wb");
  if (!f) {
    setMsg("Cannot write file");
    return false;
  }
  size_t len = strlen(g_kaspaSignedJson);
  size_t wr = fwrite(g_kaspaSignedJson, 1, len, f);
  fclose(f);
  if (wr != len) {
    setMsg("Write failed");
    return false;
  }
  strncpy(g_cryptoTxSdLastSavePath, path, sizeof(g_cryptoTxSdLastSavePath) - 1);
  g_cryptoTxSdLastSavePath[sizeof(g_cryptoTxSdLastSavePath) - 1] = 0;
  crypto_tx_save_feedback_set(sd_pick_basename_cstr(path));
  setMsg("");  // feedback uses dedicated full-screen, not g_msg toast
  return true;
}

static bool crypto_save_signed_psbt_to_sd() {
  if (!g_cryptoHasSigned) {
    setMsg("Nothing signed to save");
    return false;
  }
  if (!crypto_ensure_seedmask_sd_dir()) return false;
  char path[192];
  if (g_cryptoPsbtSignedBin && g_cryptoPsbtSignedLen > 0) {
    snprintf(path, sizeof(path), "/sdcard/seedmask/btc_signed_%lu.psbt", (unsigned long)millis());
    FILE* f = fopen(path, "wb");
    if (!f) {
      setMsg("Cannot write file");
      return false;
    }
    size_t wr = fwrite(g_cryptoPsbtSignedBin, 1, g_cryptoPsbtSignedLen, f);
    fclose(f);
    if (wr != g_cryptoPsbtSignedLen) {
      setMsg("Write failed");
      return false;
    }
  } else if (g_cryptoPsbtSignedUr[0]) {
    snprintf(path, sizeof(path), "/sdcard/seedmask/btc_signed_%lu.txt", (unsigned long)millis());
    FILE* f = fopen(path, "wb");
    if (!f) {
      setMsg("Cannot write file");
      return false;
    }
    size_t len = strlen(g_cryptoPsbtSignedUr);
    size_t wr = fwrite(g_cryptoPsbtSignedUr, 1, len, f);
    fclose(f);
    if (wr != len) {
      setMsg("Write failed");
      return false;
    }
  } else {
    setMsg("Nothing signed to save");
    return false;
  }
  strncpy(g_cryptoTxSdLastSavePath, path, sizeof(g_cryptoTxSdLastSavePath) - 1);
  g_cryptoTxSdLastSavePath[sizeof(g_cryptoTxSdLastSavePath) - 1] = 0;
  crypto_tx_save_feedback_set(sd_pick_basename_cstr(path));
  setMsg("");
  return true;
}

