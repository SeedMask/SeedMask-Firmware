static void drawPasswords() {
  // Avoid Serial/CDC traffic here: USB CDC + HID composite stalls if we spam Serial
  // right before Keyboard.write (breaks "Send via USB" typing on macOS).

  // Passwords are only loaded when user explicitly restores (QR decrypt, or ADD → SD → pw_v1.bin).
  // We do NOT auto-load from SD when opening PASSWORDS.
  if (pwSvc_getCount() == 0) {
    // empty list — no CDC spam (see comment above)
  }


  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Passwords", true);

  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);

  if (g_pwListDetailedView) {
    int maxStart = (int)pwSvc_getCount() - PW_DETAIL_VISIBLE_ROWS;
    if (maxStart < 0) maxStart = 0;
    if ((int)g_pwListScroll > maxStart) g_pwListScroll = (uint8_t)maxStart;
  } else {
    g_pwListScroll = gridAlignStart(g_pwListScroll, PW_GRID_COLS);
    if (g_pwListScroll > 0 && pwSvc_getCount() <= (uint8_t)PW_GRID_ITEMS_PER_PAGE) g_pwListScroll = 0;
    if (pwSvc_getCount() > (uint8_t)PW_GRID_ITEMS_PER_PAGE) {
      int maxStart = gridMaxStartIndex((int)pwSvc_getCount(), PW_GRID_COLS, PW_GRID_VISIBLE_ROWS);
      if ((int)g_pwListScroll > maxStart) g_pwListScroll = (uint8_t)maxStart;
    }
  }

  const int slotsToDraw = g_pwListDetailedView ? PW_DETAIL_VISIBLE_ROWS : PW_GRID_ITEMS_PER_PAGE;
  for (int slot = 0; slot < slotsToDraw; slot++) {
    uint8_t i = (uint8_t)((int)g_pwListScroll + slot);
    if (i >= pwSvc_getCount()) break;
    Rect tile, cap;
    int detailAvatarX = 0, detailAvatarY = 0, detailAvatarSize = 0;
    if (g_pwListDetailedView) {
      Rect row;
      pwDetailedRowRectForSlot(slot, row);
      detailAvatarSize = PW_DETAIL_AVATAR_SIZE;
      const int rowPadL = 6;
      const int cardGap = 10;
      detailAvatarX = row.x + rowPadL;
      detailAvatarY = row.y + (row.h - detailAvatarSize) / 2;
      const int cardX = detailAvatarX + detailAvatarSize + cardGap;
      tile = Rect{ (int16_t)cardX, row.y, (int16_t)(row.w - (cardX - row.x)), row.h };
      cap = tile;
      cap.x = (int16_t)(tile.x + 8);
      cap.y = (int16_t)(tile.y + 4);
      cap.w = (int16_t)(tile.w - 16);
      cap.h = (int16_t)(tile.h - 8);
      const bool flashed = g_listFlashActive && g_listFlashVisible && g_screen == UIScreen::PASSWORDS && g_listFlashIndex == i && !g_showSendPopup;
      gfx->fillRoundRect(tile.x, tile.y, tile.w, tile.h, 10, flashed ? RGB565_KEYFLASH : UI_CARD);
      gfx->drawRoundRect(tile.x, tile.y, tile.w, tile.h, 10, UI_BORDER);
    } else {
