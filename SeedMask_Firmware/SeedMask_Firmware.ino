  }

  gfx->fillRoundRect(cx, idxY, cw, idxH, 10, UI_CARD);
  gfx->drawRoundRect(cx, idxY, cw, idxH, 10, accent);
  gfx->setTextSize(1);
  gfx->setTextColor(RGB565_LIGHTGREY);
  gfx->setCursor(cx + 10, idxY + 6);
  gfx->print("Index");
  gfx->setTextSize(2);
  gfx->setTextColor(UI_TEXT);
  gfx->setCursor(cx + 10, idxY + 18);
  gfx->printf("%lu", (unsigned long)g_bip85LastIndex);

  char xfp[9] = { 0 };
  if (!bip39_mnemonic_words_fingerprint(g_bip85DerivedWords, g_bip85WordCount, xfp)) {
    strncpy(xfp, "--------", sizeof(xfp));
    xfp[sizeof(xfp) - 1] = 0;
  }
  const uint16_t fpFill = blendRGB565(RGB565_CYAN, RGB565_BLACK, 0.55f);
  gfx->fillRoundRect(cx, fpY, cw, fpH, 10, fpFill);
