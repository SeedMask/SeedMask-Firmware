// Script / output type shown above the xpub QR (multisig uses WSH labels; singlesig uses PKH-style).
static const char* xpub_export_script_type_label(AddrType t, bool multisigExport) {
  if (multisigExport) {
    switch (t) {
      case AddrType::P2WPKH: return "P2WSH";
      case AddrType::P2SH_P2WPKH: return "P2SH-P2WSH";
      case AddrType::P2PKH: return "P2SH";
      default: return "?";
    }
  }
  switch (t) {
    case AddrType::P2PKH: return "P2PKH";
    case AddrType::P2SH_P2WPKH: return "P2SH-P2WPKH";
    case AddrType::P2WPKH: return "P2WPKH";
    case AddrType::P2TR: return "P2TR";
    default: return "?";
  }
}

