static void handle_duress_type_menu_pick(DuressBehavior target) {
  if (!duress_cred_kind_usable()) {
    setMsgTr("Choose Duress pin/password first", "Prvo podesite Duress pin/lozinku");
    draw();
    return;
  }
  if (target == DuressBehavior::DECOY_VAULT) {
    const bool vaultSeedReady = g_loggedIn && g_masterPw[0] && (g_wc == 12 || g_wc == 24);
    if (!vaultSeedReady) {
      setMsgTr("Unlock vault with seed first", "Prvo otkljucajte novcanik sa seedom");
      draw();
      return;
    }
  }
  DuressTypeSlot* slot = duress_slot_for(target);
  if (slot && slot->active) {
    g_duressDecoyIndexWarnPending = false;
    duress_type_clear_nvs(target);
    setMsg("");
    draw();
    return;
  }
  duress_begin_type_setup(target);
}

static void handleSecurityDuressTypeMenuTap(uint16_t x, uint16_t y) {
  if (g_duressDecoyIndexWarnPending) {
    if (hit(duress_decoy_index_notice_ok_rect(), x, y)) {
      flashKeyRectTranslucent(duress_decoy_index_notice_ok_rect());
      delay(85);
      duress_decoy_index_notice_dismiss();
      draw();
    }
    return;
  }
  if (hit(BTN_TOP_BURGER, x, y)) {
    show(UIScreen::SECURITY_DURESS_MENU);
    return;
  }
  if (hit(RECT_TOP_TITLE, x, y)) {
    show(UIScreen::SECURITY_DURESS_MENU);
    return;
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    const int16_t padHit = 4;
    const Rect rDuressTypeInfo = {
      (int16_t)(infoCx - infoHalf - padHit), (int16_t)(infoCy - infoHalf - padHit),
      (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHit), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHit)
    };
    if (hit(rDuressTypeInfo, x, y)) {
      g_duressTypeInfoReturnScreen = UIScreen::SECURITY_DURESS_TYPE_MENU;
      flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
      delay(85);
      show(UIScreen::SECURITY_DURESS_TYPE_INFO);
      return;
    }
  }
  {
    if (hit(BTN_DURESS_BEH_EMPTY, x, y)) {
      handle_duress_type_menu_pick(DuressBehavior::EMPTY_VAULT);
      return;
    }
    if (hit(BTN_DURESS_BEH_GAMES, x, y)) {
      handle_duress_type_menu_pick(DuressBehavior::GAMES);
      return;
    }
    if (hit(BTN_DURESS_BEH_DECOY, x, y)) {
      handle_duress_type_menu_pick(DuressBehavior::DECOY_VAULT);
      return;
    }
  }
}

static void handleDuressGamesTap(uint16_t x, uint16_t y) {
  int docY = (int)y - (int)DURESS_GAMES_CONTENT_TOP + (int)g_duressGamesScrollPx;
  for (int i = 0; i < 4; i++) {
    int docTop = i * ((int)DURESS_GAMES_TILE_H + (int)DURESS_GAMES_TILE_GAP);
    if ((int)x >= (int)DURESS_GAMES_TILE_X
        && (int)x < (int)DURESS_GAMES_TILE_X + (int)DURESS_GAMES_TILE_W
