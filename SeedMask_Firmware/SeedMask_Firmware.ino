static void handleSecurityLockTypeTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y) || hit(RECT_TOP_TITLE, x, y)) {
    g_secLockPwPopupOpen = false;
    g_pinSetupSwitchToPassword = false;
    g_secLockSwitchToPin = false;
    show(UIScreen::SECURITY_MENU);
    return;
  }
  if (hit(BTN_SEC_MODE_PW, x, y)) {
    if (!g_loggedIn || !g_masterPw[0]) {
      setMsg("Unlock first");
      draw();
      return;
    }
    g_secLockPwPopupOpen = false;
    g_secLockPwSetupMoreOpen = false;
    g_secLockSwitchToPin = false;
    g_pinSetupSwitchToPassword = false;
    g_pinSetupIsChanging = false;
    if (g_screenLockUsesPin) {
      // PIN → Password: verify current PIN first, then set password.
      g_pinSetupSwitchToPassword = true;
      g_pinSetupPhase = 0;
      g_pinFirstEntry[0] = 0;
      clearPassword(g_password1);
      setMsg("");
      show(UIScreen::SECURITY_PIN_SETUP);
      return;
    }
    // Already password lock (separate or vault-as-lock): Change Password.
    g_secLockPwReauthPending = true;
    g_secLockPwSetupPhase = 0;
    g_screenLockPwFirst[0] = 0;
    clearPassword(g_password1);
    g_pwMasked = true;
    show(UIScreen::SECURITY_LOCK_PW_SETUP);
    return;
  }
  if (hit(BTN_SEC_MODE_PIN, x, y)) {
    if (!g_loggedIn || !g_masterPw[0]) {
      setMsg("Unlock first");
      draw();
      return;
    }
    g_secLockPwPopupOpen = false;
    g_pinSetupSwitchToPassword = false;
    // Already on PIN → Change screen PIN only (never ask for a password).
    if (g_screenLockUsesPin) {
      g_secLockSwitchToPin = false;
      g_secLockPwReauthPending = false;
      g_pinSetupIsChanging = true;
      g_pinSetupPhase = 0;
      g_pinFirstEntry[0] = 0;
      clearPassword(g_password1);
      setMsg("");
      show(UIScreen::SECURITY_PIN_SETUP);
      return;
    }
    // Password (or legacy vault-as-lock) → PIN: verify current unlock secret first.
    g_secLockSwitchToPin = true;
    g_secLockPwReauthPending = true;
    g_secLockPwSetupMoreOpen = false;
    g_secLockPwSetupPhase = 0;
    g_screenLockPwFirst[0] = 0;
    clearPassword(g_password1);
    g_pwMasked = true;
    show(UIScreen::SECURITY_LOCK_PW_SETUP);
    return;
  }
}

