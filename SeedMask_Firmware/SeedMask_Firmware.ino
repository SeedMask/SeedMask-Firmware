static bool autoShutdownIdleShouldArm() {
  if (g_autoShutdownIdleSeconds == 0) return false;
  if (!g_loggedIn) return false;
  if (g_lcdBacklightSuspended) return false;
  if (g_busy) return false;
  switch (g_screen) {
    case UIScreen::LOCKED:
    case UIScreen::UNLOCK_PASSWORD:
    case UIScreen::RESTORE_SCAN_QR:
    case UIScreen::CRYPTO_SCAN_PSBT:
    case UIScreen::CRYPTO_SCAN_KASPA_PSKT:
    case UIScreen::CRYPTO_SCAN_TOOLS:
    case UIScreen::DEVICE_RENAME_FEEDBACK:
    case UIScreen::EDITOR:
      return false;
    default:
      return true;
  }
}

static void autoShutdownExecute() {
  session_lock_to_home();
  lcdBacklightSuspendForSleep();
}

// =======================
// Helpers

static uint32_t rng32() {
#if defined(ESP32)
  return (uint32_t)esp_random();  // ESP32 hardware RNG
#else
  // fallback (not great) - better to use a real RNG source for security
  return (uint32_t)random(0x7fffffff);
#endif
}

static const char* diceware_selected_separator() {
  switch (g_dwSeparator) {
    case DwSeparator::HYPHEN: return "-";
    case DwSeparator::SPACE: return " ";
    case DwSeparator::UNDERSCORE: return "_";
    case DwSeparator::COMMA: return ",";
    case DwSeparator::PERIOD: return ".";
    default: return "-";
  }
}

static void diceware_append_selected_separator(char* out, size_t outLen) {
  strlcat(out, diceware_selected_separator(), outLen);
}

static void diceware_capitalize_word_inplace(char* w) {
  if (!g_dwCapitalize || !w || !w[0]) return;
  if (w[0] >= 'a' && w[0] <= 'z') w[0] = (char)(w[0] - 'a' + 'A');
}

static void diceware_generate(char* out, size_t outLen, uint8_t words) {
  if (!out || outLen == 0) return;
  out[0] = 0;
  static char dwBuf[16];  // max diceware word length ~8

  for (uint8_t placed = 0; placed < words;) {
    uint32_t idx = rng32() % DICEWARE_WORD_COUNT;
    const char* p = (const char*)pgm_read_ptr(&DICEWARE_WORDS[idx]);
    strncpy_P(dwBuf, p, sizeof(dwBuf) - 1);
    dwBuf[sizeof(dwBuf) - 1] = 0;
    // Word list includes lone "-"; joining with '-' would make empty segments / invalid passphrase.
    if (dwBuf[0] == '-' && dwBuf[1] == '\0') continue;

    diceware_capitalize_word_inplace(dwBuf);
    if (placed > 0) diceware_append_selected_separator(out, outLen);
    strlcat(out, dwBuf, outLen);
    placed++;
  }
}

// Deterministic diceware from 32-byte seed (rejection-skip lone "-" as in diceware_generate).
static void diceware_generate_deterministic(char* out, size_t outLen, uint8_t nWords, const uint8_t seed32[32]) {
  if (!out || outLen == 0) return;
  out[0] = 0;
  static char dwBuf[16];
  uint8_t stream[32];
  memcpy(stream, seed32, 32);
  uint8_t pos = 0;
  for (uint8_t placed = 0; placed < nWords;) {
    if (pos + 4 > sizeof(stream)) {
      sha256_once(stream, sizeof(stream), stream);
      pos = 0;
    }
    uint32_t idx = (uint32_t)stream[pos] | ((uint32_t)stream[pos + 1] << 8) | ((uint32_t)stream[pos + 2] << 16) | ((uint32_t)stream[pos + 3] << 24);
    pos += 4;
    idx %= DICEWARE_WORD_COUNT;
    const char* p = (const char*)pgm_read_ptr(&DICEWARE_WORDS[idx]);
    strncpy_P(dwBuf, p, sizeof(dwBuf) - 1);
    dwBuf[sizeof(dwBuf) - 1] = 0;
    if (dwBuf[0] == '-' && dwBuf[1] == '\0') continue;
    diceware_capitalize_word_inplace(dwBuf);
    if (placed > 0) diceware_append_selected_separator(out, outLen);
    strlcat(out, dwBuf, outLen);
    placed++;
  }
}

static void waitTouchRelease(uint32_t timeoutMs = 250) {
  uint32_t t0 = millis();
  uint16_t sx, sy;
  while (millis() - t0 < timeoutMs) {
    if (!readTouchScreen(sx, sy)) return;  // released
    delay(5);
    yield();
  }
}

static void random_chars_generate(char* out, size_t outLen, uint8_t len) {
  if (!out || outLen == 0) return;
  out[0] = 0;

  char csBuf[96];
  size_t csN = random_pw_charset_build(csBuf, sizeof(csBuf));
  if (csN == 0) return;
  if (len >= outLen) len = outLen - 1;

  for (uint8_t i = 0; i < len; i++) {
    out[i] = csBuf[rng32() % csN];
  }
  out[len] = 0;
}

// BIP85 password field: SeedMask uses BIP-85 BIP39-path HMAC as entropy input, then maps to
// Advanced output formats (not BIP-85 PWD BASE64 — that application is separate in the BIP).
#ifndef BIP85_PW_SIMPLE_LEN
#define BIP85_PW_SIMPLE_LEN 26
#endif
#ifndef BIP85_PW_STRONG_LEN
#define BIP85_PW_STRONG_LEN 23
#endif
#ifndef BIP85_PW_COMPLEX_LEN
#define BIP85_PW_COMPLEX_LEN 20
#endif

static size_t bip85_pw_charset_build(char* out, size_t cap) {
  if (!out || cap < 2) return 0;
  out[0] = 0;
  strlcat(out, kRandPwSubsetUpper, cap);
  strlcat(out, kRandPwSubsetLower, cap);
  strlcat(out, kRandPwSubsetDigits, cap);
  return strlen(out);
}

static size_t bip85_simple_charset_build(char* out, size_t cap) {
  if (!out || cap < 2) return 0;
  out[0] = 0;
  strlcat(out, kRandPwSubsetLower, cap);
  strlcat(out, kRandPwSubsetDigits, cap);
  return strlen(out);
}

static size_t bip85_complex_charset_build(char* out, size_t cap) {
  if (!out || cap < 2) return 0;
  out[0] = 0;
  strlcat(out, kRandPwSubsetUpper, cap);
  strlcat(out, kRandPwSubsetLower, cap);
  strlcat(out, kRandPwSubsetDigits, cap);
  strlcat(out, kRandPwSubsetSymbols, cap);
  return strlen(out);
}

static bool bip85_mix_derived_secret(const uint8_t hmac64[64], const char* passphrase, uint8_t out32[32]) {
  static const char kTag[] = "SeedMask|BIP85-PW|v1";
  uint8_t buf[sizeof(kTag) - 1 + 64 + BIP39_PASSPHRASE_MAX_BYTES];
  size_t off = 0;
  memcpy(buf + off, kTag, sizeof(kTag) - 1);
  off += sizeof(kTag) - 1;
  memcpy(buf + off, hmac64, 64);
  off += 64;
  size_t plen = passphrase ? strnlen(passphrase, BIP39_PASSPHRASE_MAX_BYTES) : 0;
  if (plen) {
    memcpy(buf + off, passphrase, plen);
    off += plen;
  }
  sha256_once(buf, off, out32);
  secure_memzero(buf, sizeof(buf));
  return true;
}

// Same master xfp as Crypto → Passphrase: BIP39 PBKDF2(mnemonic, "mnemonic"‖passphrase) → BIP32 master → HASH160(pub)[:4].
// Uses the typed preview string (may differ from g_bip39Passphrase), but derivation matches Bitcoin/BIP39 everywhere.
static void bip85_refresh_passphrase_fingerprint(void) {
  g_pwBip85LocalPassphraseFp[0] = 0;
  size_t passLen = strnlen(g_pwBip85LocalPassphrase, sizeof(g_pwBip85LocalPassphrase));

  char mnemonic[256];
  const char(*seedWords)[16] = g_seed;
  uint8_t seedWc = g_wc;
  if (g_tempSeedActive) {
    seedWords = g_tempSeedWords;
    seedWc = g_tempSeedWordCount;
  }
  if (!build_mnemonic_string(seedWords, seedWc, mnemonic, sizeof(mnemonic))) return;

  uint8_t salt[8 + BIP39_PASSPHRASE_MAX_BYTES];
  memcpy(salt, "mnemonic", 8);
  if (passLen > BIP39_PASSPHRASE_MAX_BYTES) passLen = BIP39_PASSPHRASE_MAX_BYTES;
  if (passLen) memcpy(salt + 8, g_pwBip85LocalPassphrase, passLen);

  uint8_t seed64[64];
  if (!pbkdf2_sha512((const uint8_t*)mnemonic, strlen(mnemonic), salt, 8 + passLen, 2048, seed64, sizeof(seed64))) {
    secure_memzero(mnemonic, sizeof(mnemonic));
    secure_memzero(salt, sizeof(salt));
    return;
  }
  secure_memzero(mnemonic, sizeof(mnemonic));
  secure_memzero(salt, sizeof(salt));

  Bip32Node m;
  memset(&m, 0, sizeof(m));
  if (!bip32_master_from_seed(seed64, &m)) {
    secure_memzero(seed64, sizeof(seed64));
    return;
  }
  secure_memzero(seed64, sizeof(seed64));
  uint8_t pub[33];
  if (!secp_pubkey_compressed(m.k, pub)) {
    secure_memzero(&m, sizeof(m));
    return;
  }
  secure_memzero(&m, sizeof(m));
  uint8_t h160[20];
  if (!hash160(pub, sizeof(pub), h160)) {
    secure_memzero(pub, sizeof(pub));
    return;
  }
  secure_memzero(pub, sizeof(pub));
  hex4_to_upper(h160, g_pwBip85LocalPassphraseFp);
  secure_memzero(h160, sizeof(h160));
}

static bool bip85_password_generate(char* out, size_t outLen, uint32_t index, uint8_t wc) {
  if (!out || outLen == 0) return false;
  out[0] = 0;
  if (!(wc == 12 || wc == 24)) {
    setMsg("BIP85 path must be 12 or 24");
    return false;
  }
  uint8_t hmacOut[64];
  char err[32] = { 0 };
  if (!bip85_derive_hmac(index, wc, hmacOut, err, sizeof(err))) {
    setMsg(err[0] ? err : "BIP85 derivation failed");
    secure_memzero(hmacOut, sizeof(hmacOut));
    return false;
  }
  uint8_t mixed[32];
  bip85_mix_derived_secret(hmacOut, g_pwBip85LocalPassphrase, mixed);
  secure_memzero(hmacOut, sizeof(hmacOut));

  switch (g_pwBip85OutType) {
    case Bip85PwOutType::PW_HEX:
      {
        if (outLen < 65) {
          setMsg("buffer too small");
          secure_memzero(mixed, sizeof(mixed));
          return false;
        }
        static const char hexd[] = "0123456789abcdef";
        for (int i = 0; i < 32; i++) {
          out[i * 2] = hexd[mixed[i] >> 4];
          out[i * 2 + 1] = hexd[mixed[i] & 0x0F];
        }
        out[64] = 0;
        secure_memzero(mixed, sizeof(mixed));
        return true;
      }
    case Bip85PwOutType::DICEWARE:
      {
        diceware_generate_deterministic(out, outLen, g_pwBip85DwWords, mixed);
        secure_memzero(mixed, sizeof(mixed));
        return strlen(out) > 0;
      }
    case Bip85PwOutType::RANDOM:
    default:
      {
        char csBuf[96];
        size_t csN = 0;
        uint8_t nlen = BIP85_PW_STRONG_LEN;
        if (g_pwBip85RandTier == Bip85PwRandTier::SIMPLE) {
          csN = bip85_simple_charset_build(csBuf, sizeof(csBuf));
          nlen = BIP85_PW_SIMPLE_LEN;
        } else if (g_pwBip85RandTier == Bip85PwRandTier::COMPLEX) {
          csN = bip85_complex_charset_build(csBuf, sizeof(csBuf));
          nlen = BIP85_PW_COMPLEX_LEN;
        } else {
          csN = bip85_pw_charset_build(csBuf, sizeof(csBuf));
          nlen = BIP85_PW_STRONG_LEN;
        }
        if (csN == 0 || nlen >= outLen) {
          setMsg("charset");
          secure_memzero(mixed, sizeof(mixed));
          return false;
        }
        uint8_t pool[32];
        memcpy(pool, mixed, 32);
        secure_memzero(mixed, sizeof(mixed));
        uint8_t pos = 0;
        for (uint8_t i = 0; i < nlen; i++) {
          if (pos >= sizeof(pool)) {
            sha256_once(pool, sizeof(pool), pool);
            pos = 0;
          }
          out[i] = csBuf[pool[pos++] % csN];
        }
        out[nlen] = 0;
        secure_memzero(pool, sizeof(pool));
        return true;
      }
  }
}

