// RESTORE_VAULT_CHOICE: seed stays in RAM until screen lock is set (then persisted).
// Persisting earlier left the device unlockable with the backup password after reboot.
static bool ensure_stateful_restore_seed_persisted() {
  // In stateless mode, restores are intentionally session-only.
  if (g_stateless) return true;
  if (g_hasVault) return true;
  if (!g_backupCode[0] || !g_masterPw[0]) return false;
  char tmpSeed[24][16] = { 0 };
  uint8_t tmpWc = 0;
  if (!restore_seed_from_backup_code(g_backupCode, g_masterPw, tmpSeed, tmpWc, true)) return false;
  return flush_deferred_vault_nvs_save();
}

static void handleRestoreVaultChoiceTap(uint16_t x, uint16_t y) {
  if (hit(BTN_LIST_BACK, x, y)) {
    setMsg("");
    show_menu_or_onboard_lock_after_restore();
    return;
  }
  if (hit(BTN_RESTORE_LOAD_VAULT, x, y)) {
    flashKeyRectTranslucent(BTN_RESTORE_LOAD_VAULT);
    delay(85);
    // Do not persist seed yet — lock must be set first. Listing uses the RAM session.
    restore_vault_pick_fill_list();
    show(UIScreen::RESTORE_VAULT_PICK);
    return;
  }
  if (hit(BTN_RESTORE_SEED_ONLY, x, y)) {
    flashKeyRectTranslucent(BTN_RESTORE_SEED_ONLY);
    delay(85);
    setMenuToast("Seed only (vault not loaded)", 4800u);
    show_menu_or_onboard_lock_after_restore();
    return;
  }
}

// Override the weak function in the ESP32 core to give loopTask a 32KB stack (default 16KB is too small for this sketch)
size_t getArduinoLoopTaskStackSize(void) {
  return 32768;
}

static void pollBootButtonLock() {
  static bool s_pinInited = false;
  static uint32_t s_ignoreUntilMs = 0;
  static bool s_wasPressed = false;
  static uint32_t s_lastLockMs = 0;

  if (!s_pinInited) {
    s_pinInited = true;
    pinMode(PIN_BOOT_LOCK, INPUT_PULLUP);
    s_ignoreUntilMs = millis() + 600;
  }

  uint32_t now = millis();
  if ((int32_t)(now - s_ignoreUntilMs) < 0) return;

  bool pressed = (digitalRead(PIN_BOOT_LOCK) == LOW);
  if (pressed && !s_wasPressed) {
    s_wasPressed = true;
    if (now - s_lastLockMs >= 400) {
      s_lastLockMs = now;
      if (g_loggedIn && vault_is_unlocked()
          && g_screen != UIScreen::LOCKED
          && g_screen != UIScreen::UNLOCK_PASSWORD) {
        if (g_bip39HasPassphrase) {
          show(UIScreen::CONFIRM_PASSPHRASE_CLEAR);
        } else {
          session_lock_to_home();
        }
      }
    }
  } else if (!pressed) {
    s_wasPressed = false;
  }
}

#if SEEDMASK_PSBT_SELFTEST_ON_BOOT
/** Log to both USB CDC Serial and stdout (SD driver uses stdout — some hosts only show one). */
static void boot_log_line(const char* msg) {
  if (!msg) return;
  printf("%s\n", msg);
  fflush(stdout);
  Serial.println(msg);
  Serial.flush();
}

static void boot_log_fail(const char* label, const char* detail) {
  char buf[128];
  if (detail && detail[0])
    snprintf(buf, sizeof(buf), "%s: FAIL: %s", label, detail);
  else
    snprintf(buf, sizeof(buf), "%s: FAIL", label);
  boot_log_line(buf);
}

/** Let IDLE run on this core — long PBKDF2/PSBT self-tests otherwise trip task_wdt (~5s). */
static void boot_selftest_yield(void) {
  vTaskDelay(pdMS_TO_TICKS(2));
  taskYIELD();
}

static void run_kaspa_boot_selftests(void) {
#if SEEDMASK_KASPA_SELFTEST_ON_BOOT
  g_kaspaSighashSelftestOk = seedmask_kaspa_sighash_selftest(g_kaspaSighashSelftestErr, sizeof(g_kaspaSighashSelftestErr));
  g_kaspaSighashSelftestRan = true;
  boot_selftest_yield();
  if (g_kaspaSighashSelftestOk)
    boot_log_line("Kaspa self-test (sighash): PASS");
  else
    boot_log_fail("Kaspa self-test (sighash)", g_kaspaSighashSelftestErr);
  g_kaspaBip340SelftestOk = seedmask_kaspa_bip340_selftest(g_kaspaBip340SelftestErr, sizeof(g_kaspaBip340SelftestErr));
  g_kaspaBip340SelftestRan = true;
  boot_selftest_yield();
  if (g_kaspaBip340SelftestOk)
    boot_log_line("Kaspa self-test (Schnorr): PASS");
  else
    boot_log_fail("Kaspa self-test (Schnorr)", g_kaspaBip340SelftestErr);
  {
    char urErr[96] = { 0 };
    if (seedmask_kaspa_ur_fountain_selftest(urErr, sizeof(urErr)))
      boot_log_line("Kaspa self-test (UR fountain): PASS");
    else
      boot_log_fail("Kaspa self-test (UR fountain)", urErr);
  }
#endif
}

// Core 0 + low priority: loopTask/UI stays on core 1 (Arduino default).
static void psbt_boot_selftest_task(void* arg) {
  (void)arg;
  boot_log_line("SeedMask: crypto self-tests starting...");
  boot_selftest_yield();
  run_kaspa_boot_selftests();
  boot_selftest_yield();
  {
    char bip85Err[48] = { 0 };
    if (seedmask_bip85_selftest(bip85Err, sizeof(bip85Err)))
      boot_log_line("BIP-85 self-test: PASS");
    else
      boot_log_fail("BIP-85 self-test", bip85Err);
  }
  boot_selftest_yield();
  g_psbtParserSelftestOk = seedmask_psbt_parser_selftest(g_psbtParserSelftestErr, sizeof(g_psbtParserSelftestErr));
  g_psbtParserSelftestRan = true;
  boot_selftest_yield();
  if (g_psbtParserSelftestOk)
    boot_log_line("PSBT self-test (parser): PASS");
  else
    boot_log_fail("PSBT self-test (parser)", g_psbtParserSelftestErr);
  boot_selftest_yield();
  g_psbtSigningSelftestOk = seedmask_psbt_signing_selftest(g_psbtSigningSelftestErr, sizeof(g_psbtSigningSelftestErr));
  g_psbtSigningSelftestRan = true;
  boot_selftest_yield();
  if (g_psbtSigningSelftestOk)
    boot_log_line("PSBT self-test (signer multisig): PASS");
  else
    boot_log_fail("PSBT self-test (signer multisig)", g_psbtSigningSelftestErr);
  boot_log_line("SeedMask: crypto self-tests finished");
  vTaskDelete(NULL);
}
#endif

