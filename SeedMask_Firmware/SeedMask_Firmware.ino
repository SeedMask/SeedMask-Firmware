static bool nav_recent_trackable(UIScreen s) {
  // Main hubs (like iOS/Android home screens) are not separate recents entries.
  if (s == UIScreen::MENU || s == UIScreen::CRYPTO_HOME) return false;
  if (s == UIScreen::EDITOR) return true;
  if (isCryptoModeScreen(s)) return true;
  switch (s) {
    case UIScreen::PASSWORDS:
    case UIScreen::NOTES:
    case UIScreen::TFA_LIST:
    case UIScreen::TFA_SHOW_CODE:
    case UIScreen::BACKUP_CHOOSE_WORDS:
    case UIScreen::BACKUP_FROM_SEED:
    case UIScreen::BACKUP_SHOW_CODE:
    case UIScreen::SEED_SETTINGS:
    case UIScreen::DEVICE_SETTINGS:
    case UIScreen::DEVICE_BRIGHTNESS:
    case UIScreen::DEVICE_RENAME:
    case UIScreen::SECURITY_MENU:
    case UIScreen::VIEW_SEED:
    case UIScreen::VIEW_SEED_QR:
    case UIScreen::VIEW_CODE:
    case UIScreen::BURGER_MENU:
      return true;
    default:
      return false;
  }
}

static UIScreen nav_recent_snapshot_key(UIScreen s) {
  if (s == UIScreen::EDITOR) {
    if (g_prevScreen == UIScreen::NOTES) return UIScreen::NOTES;
    return UIScreen::PASSWORDS;
  }
  return s;
}

static int nav_recent_find_index(UIScreen key) {
  for (uint8_t i = 0; i < g_navRecentCount; i++) {
    if (g_navRecent[i].screen == key) return (int)i;
  }
  return -1;
}

static uint16_t* nav_recent_thumb_row(uint8_t idx) {
  if (!g_navRecentThumbs || idx >= NAV_RECENT_MAX) return nullptr;
  return g_navRecentThumbs + (size_t)idx * (size_t)NAV_THUMB_PIXELS;
}

static void nav_recent_swap_thumb_rows(int a, int b) {
  uint16_t* ra = nav_recent_thumb_row((uint8_t)a);
  uint16_t* rb = nav_recent_thumb_row((uint8_t)b);
  if (!ra || !rb || a == b) return;
  for (size_t i = 0; i < (size_t)NAV_THUMB_PIXELS; i++) {
    uint16_t t = ra[i];
    ra[i] = rb[i];
    rb[i] = t;
  }
}

static void nav_recent_shift_thumb_rows_down(int count) {
  if (!g_navRecentThumbs || count <= 1) return;
  const size_t rowBytes = (size_t)NAV_THUMB_PIXELS * sizeof(uint16_t);
  for (int i = count - 1; i > 0; i--)
    memmove(nav_recent_thumb_row((uint8_t)i), nav_recent_thumb_row((uint8_t)(i - 1)), rowBytes);
}

static void nav_recent_thumb_from_framebuffer(uint8_t recentIdx, int srcH) {
  if (recentIdx >= g_navRecentCount) return;
  NavRecentEntry& e = g_navRecent[recentIdx];
  uint16_t* dst = nav_recent_thumb_row(recentIdx);
  uint16_t* fb = gfx->getFramebuffer();
  if (!fb || !dst || srcH < 8) return;
  if (srcH > NAV_THUMB_H) srcH = NAV_THUMB_H;
  if (srcH > LCD_H) srcH = LCD_H;
  for (int y = 0; y < srcH; y++)
    memcpy(dst + (size_t)y * (size_t)NAV_THUMB_W, fb + (size_t)y * (size_t)LCD_W, (size_t)NAV_THUMB_W * sizeof(uint16_t));
  e.hasThumb = true;
}

static void nav_recent_capture_snapshot() {
  if (!g_loggedIn || g_navOverlay != NavOverlay::NONE) return;
  UIScreen key = nav_recent_snapshot_key(g_screen);
  if (!nav_recent_trackable(key)) return;
  int idx = nav_recent_find_index(key);
  if (idx < 0) return;
  int srcH = nav_bar_visible() ? nav_bar_zone_top() : LCD_H;
  nav_recent_thumb_from_framebuffer((uint8_t)idx, srcH);
}

static void nav_recent_clear() {
  g_navRecentCount = 0;
  g_navOverlay = NavOverlay::NONE;
  g_navGestureTracking = false;
  g_navWakeTracking = false;
  g_navWakeArmed = false;
  g_navSleepWakeOnSpace = false;
  g_navSpacebarNavSession = false;
  g_navWakeDownMs = 0;
  g_navBarAwake = false;
  g_navSwitcherCardHitValid = false;
  g_navSwitcherScrollPx = 0;
  nav_switcher_reset_touch();
}

static void nav_recent_push(UIScreen s) {
  UIScreen key = nav_recent_snapshot_key(s);
  if (!nav_recent_trackable(key)) return;
  int existIdx = nav_recent_find_index(key);
  if (existIdx >= 0) {
    NavRecentEntry entry = g_navRecent[existIdx];
    for (int i = existIdx; i < (int)g_navRecentCount - 1; i++)
      g_navRecent[i] = g_navRecent[i + 1];
    g_navRecent[g_navRecentCount - 1] = entry;
    for (int i = existIdx; i < (int)g_navRecentCount - 1; i++)
      nav_recent_swap_thumb_rows(i, i + 1);
    return;
  }
  if (g_navRecentCount >= NAV_RECENT_MAX) {
    for (int i = 0; i < NAV_RECENT_MAX - 1; i++)
      g_navRecent[i] = g_navRecent[i + 1];
    if (g_navRecentThumbs) {
      const size_t rowBytes = (size_t)NAV_THUMB_PIXELS * sizeof(uint16_t);
      memmove(nav_recent_thumb_row(0), nav_recent_thumb_row(1), rowBytes * (size_t)(NAV_RECENT_MAX - 1));
    }
  } else {
    g_navRecentCount++;
  }
  g_navRecent[g_navRecentCount - 1].screen = key;
  g_navRecent[g_navRecentCount - 1].hasThumb = false;
}

static void nav_recent_remove_at(uint8_t idx) {
  if (idx >= g_navRecentCount) return;
  for (uint8_t i = idx; i + 1 < g_navRecentCount; i++)
    g_navRecent[i] = g_navRecent[i + 1];
  if (g_navRecentThumbs && g_navRecentCount > 1 && idx < g_navRecentCount - 1) {
    const size_t rowBytes = (size_t)NAV_THUMB_PIXELS * sizeof(uint16_t);
    memmove(nav_recent_thumb_row(idx), nav_recent_thumb_row((uint8_t)(idx + 1)),
            rowBytes * (size_t)(g_navRecentCount - 1 - idx));
  }
  if (g_navRecentCount > 0) g_navRecentCount--;
}

static void nav_recent_bump_current() {
  if (!g_loggedIn) return;
  UIScreen key = nav_recent_snapshot_key(g_screen);
  if (!nav_recent_trackable(key)) return;
  nav_recent_push(key);
}

static void nav_recent_on_show(UIScreen s) {
  if (!g_loggedIn) return;
  nav_recent_push(s);
}

