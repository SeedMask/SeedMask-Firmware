#if SEEDMASK_PSBT_TELEMETRY
struct PsbtPerfStats {
  uint32_t polls = 0;
  uint32_t sumCaptureUs = 0, maxCaptureUs = 0;
  uint32_t sumDecodeUs = 0, maxDecodeUs = 0;
  uint32_t sumRenderUs = 0, maxRenderUs = 0;
  uint32_t sumTotalUs = 0, maxTotalUs = 0;
  uint32_t sumProgressDeltaMs = 0;
  uint32_t progressEvents = 0;
  uint32_t lastProgressMs = 0;
};
static PsbtPerfStats s_psbtPerf;
static void psbt_perf_log_tick(uint32_t captureUs, uint32_t decodeUs, uint32_t renderUs, uint32_t totalUs,
                               bool progressChanged, uint32_t nowMs) {
  PsbtPerfStats& p = s_psbtPerf;
  p.polls++;
  p.sumCaptureUs += captureUs;
  if (captureUs > p.maxCaptureUs) p.maxCaptureUs = captureUs;
  p.sumDecodeUs += decodeUs;
  if (decodeUs > p.maxDecodeUs) p.maxDecodeUs = decodeUs;
  p.sumRenderUs += renderUs;
  if (renderUs > p.maxRenderUs) p.maxRenderUs = renderUs;
  p.sumTotalUs += totalUs;
  if (totalUs > p.maxTotalUs) p.maxTotalUs = totalUs;
  if (progressChanged) {
    if (p.lastProgressMs != 0) p.sumProgressDeltaMs += (uint32_t)(nowMs - p.lastProgressMs);
    p.lastProgressMs = nowMs;
    p.progressEvents++;
  }
  if ((p.polls % 120u) == 0u) {
    const uint32_t n = p.polls;
    const uint32_t avgCap = n ? (p.sumCaptureUs / n) : 0;
    const uint32_t avgDec = n ? (p.sumDecodeUs / n) : 0;
    const uint32_t avgRdr = n ? (p.sumRenderUs / n) : 0;
    const uint32_t avgTot = n ? (p.sumTotalUs / n) : 0;
    const uint32_t avgProg = (p.progressEvents > 1) ? (p.sumProgressDeltaMs / (p.progressEvents - 1)) : 0;
    const char* perfTag =
      (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT) ? "PSKT"
      : (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT) ? "PSBT"
                                                        : "QR";
    Serial.printf("%s PERF avg(us) cap=%lu dec=%lu rdr=%lu tot=%lu | max(us) cap=%lu dec=%lu rdr=%lu tot=%lu | progΔ(ms)=%lu\n",
                  perfTag,
                  (unsigned long)avgCap, (unsigned long)avgDec, (unsigned long)avgRdr, (unsigned long)avgTot,
                  (unsigned long)p.maxCaptureUs, (unsigned long)p.maxDecodeUs, (unsigned long)p.maxRenderUs, (unsigned long)p.maxTotalUs,
                  (unsigned long)avgProg);
  }
}
#endif
