  if (hit(BTN_TOP_BURGER, x, y)) {
    g_optionsHomeScreen = UIScreen::MENU;
    show(UIScreen::BURGER_MENU);
    return;
  }

  if (sd_presence_for_ui() && hit(BTN_TOPBAR_SD, x, y)) {
    show(UIScreen::SD_BROWSER);
    return;
  }

  if (!duressHideCryptoMenuToggle() && hit(BTN_MENU_TO_CRYPTO_TOGGLE, x, y)) {
    // Duress: same as normal session — empty crypto home, no message that reveals decoy mode.
