}

static void handleCryptoReviewKaspaTxTap(uint16_t x, uint16_t y) {
  if (nav_bar_home_tap_hit((int16_t)x, (int16_t)y)) return;
  if (g_kaspaReviewSummaryValid && g_kaspaReviewSummary.ok && hitPad(BTN_KASPA_UNIT, (int16_t)x, (int16_t)y, 18)) {
    g_kaspaReviewUnitSompi = !g_kaspaReviewUnitSompi;
    draw();
    return;
  }
  if (hitPad(BTN_KASPA_REVIEW_CONTINUE, (int16_t)x, (int16_t)y, 22)
      && !nav_bar_home_tap_hit((int16_t)x, (int16_t)y)) {
    if (!g_kaspaPsktScanLen || !g_kaspaPsktScanBuf[0]) {
      setMsg("No Kaspa tx scanned");
      draw();
    } else if (!kaspa_accept_loaded_unsigned_for_wallet()) {
      draw();
    } else {
      show(UIScreen::CRYPTO_KASPA_FEE);
    }
    return;
  }
  if (hit(BTN_TOP_BURGER, x, y)) {
    show(UIScreen::CRYPTO_HOME);
    return;
  }
  // Arm scroll only when content overflows (measured on last draw).
  if (crypto_tx_review_can_scroll() && y >= 48 && y < BTN_KASPA_REVIEW_CONTINUE.y) {
    g_cryptoTxReviewTouchPending = true;
    g_cryptoTxReviewScrolling = false;
    g_cryptoTxReviewDidDrag = false;
    g_cryptoTxReviewDownX = (int16_t)x;
    g_cryptoTxReviewDownY = (int16_t)y;
    g_cryptoTxReviewDragLastY = -1;
  }
}

static void handleCryptoKaspaFeeTap(uint16_t x, uint16_t y) {
  if (g_psbtSignConfirmActive) {
    if (g_psbtVisualizeActive) {
      if (hitPad(BTN_PSBT_VIZ_CLOSE, (int16_t)x, (int16_t)y, 18) || hit(BTN_TOP_BURGER, x, y)) {
        g_psbtVisualizeActive = false;
        g_psbtVizScrolling = false;
        draw();
      }
      return;
    }
    if (g_psbtSignCancelConfirmPopup) {
      Rect rYes, rNo;
      psbt_sign_cancel_popup_btn_rects(&rYes, &rNo);
      if (hit(rYes, x, y)) {
        psbt_slide_reset();
        g_psbtSignCancelConfirmPopup = false;
        g_psbtVisualizeActive = false;
        setMsg("");
        show(UIScreen::CRYPTO_HOME);
        return;
      }
      if (hit(rNo, x, y)) {
        g_psbtSignCancelConfirmPopup = false;
        draw();
        return;
      }
      return;
    }
    if (hit(BTN_PSBT_SIGN_CONF_VISUALIZE, x, y)) {
      crypto_refresh_kaspa_review();
      g_psbtVisualizeActive = true;
      g_psbtVizScrollY = 0;
      g_psbtVizScrolling = false;
      g_psbtVizLastAnimMs = millis();
      draw();
      return;
    }
    if (hit(BTN_PSBT_SIGN_CONF_CANCEL, x, y)) {
      g_psbtSignCancelConfirmPopup = true;
      draw();
      return;
    }
    return;
  }
  if (hitPad(BTN_CRYPTO_REVIEW_SIGN, (int16_t)x, (int16_t)y, 22)) {
    if (!g_kaspaPsktScanLen || !g_kaspaPsktScanBuf[0]) {
      setMsg("No Kaspa tx scanned");
      draw();
    } else {
      crypto_prepare_kaspa_sign_confirm_text();
      psbt_slide_reset();
      g_psbtSignCancelConfirmPopup = false;
      g_psbtVisualizeActive = false;
      g_psbtSignConfirmActive = true;
      draw();
    }
    return;
  }
  if (hit(BTN_TOP_BURGER, x, y)) {
    show(UIScreen::CRYPTO_HOME);
    return;
  }
}

