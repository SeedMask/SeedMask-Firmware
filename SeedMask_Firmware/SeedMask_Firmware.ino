static void draw_multisig_imported_wallet_row(const Rect& row, uint8_t ordinal1Based, const char* name) {
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(2);
  int16_t ty = row.y + (row.h - 16) / 2;
  int16_t bx, by;
  uint16_t numW, numH;
  char numPrefix[8];
  snprintf(numPrefix, sizeof(numPrefix), "%u.", (unsigned)ordinal1Based);
  gfx->getTextBounds(numPrefix, row.x, ty, &bx, &by, &numW, &numH);
  gfx->setCursor(row.x, ty);
  gfx->print(numPrefix);
  const int16_t gapAfterNum = 4;
  const int16_t ox = row.x + (int16_t)numW + gapAfterNum;
  const int16_t vMargin = 4;
  const int16_t ow = (row.x + row.w) - ox;
  const int16_t oh = row.h - 2 * vMargin;
  const int16_t oy = row.y + vMargin;
  Rect r = { ox, oy, ow, oh };
  const int rad = (oh <= 30) ? 8 : 10;
  uint16_t top = blendRGB565(RGB565_BITCOIN_ORANGE, RGB565_WHITE, 0.16f);
  uint16_t bottom = blendRGB565(RGB565_BITCOIN_ORANGE, RGB565_BLACK, 0.22f);
  fillRoundRectGradientV(r, rad, top, bottom);
  gfx->drawRoundRect(r.x, r.y, r.w, r.h, rad, RGB565_BLACK);
  gfx->drawRoundRect(r.x + 1, r.y + 1, r.w - 2, r.h - 2, (int16_t)(rad - 1), RGB565_BLACK);
  gfx->setTextColor(RGB565_BLACK);
  gfx->setTextSize(2);
  const char* disp = (name && name[0]) ? name : "Imported multisig";
  char line[96];
  snprintf(line, sizeof(line), "%s", disp);
  const int padX = 10;
  int maxChars = (int)((r.w - 2 * padX) / 12);
  if (maxChars < 12) maxChars = 12;
  if (maxChars > 40) maxChars = 40;
  size_t len = strlen(line);
  if (len <= (size_t)maxChars) {
    gfx->setCursor(r.x + padX, r.y + (r.h - 16) / 2);
    gfx->print(line);
  } else {
    char a[24];
    memcpy(a, line, (size_t)maxChars);
    a[maxChars] = 0;
    gfx->setCursor(r.x + padX, r.y + 4);
    gfx->print(a);
    const char* rest = line + maxChars;
    char b[24];
    if (strlen(rest) > (size_t)maxChars) {
      snprintf(b, sizeof(b), "%.15s...", rest);
      gfx->setCursor(r.x + padX, r.y + 4 + 16);
      gfx->print(b);
    } else {
      gfx->setCursor(r.x + padX, r.y + 4 + 16);
      gfx->print(rest);
    }
  }
}

