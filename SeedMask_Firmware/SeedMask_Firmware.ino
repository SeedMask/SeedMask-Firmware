static void kaspa_review_refresh_kpub_status() {
  g_kaspaKpubStatus = -1;
  if (!g_kaspaPsktScanLen || !g_kaspaPsktScanBuf[0]) return;
  size_t wlen = g_kaspaPsktScanLen;
  if (wlen >= KASPA_PSKT_SCAN_MAX) wlen = KASPA_PSKT_SCAN_MAX - 1;
  memcpy(g_kaspaPsktWorkBuf, g_kaspaPsktScanBuf, wlen);
  g_kaspaPsktWorkBuf[wlen] = 0;
  if (!kaspa_extract_unsigned_payload(g_kaspaPsktWorkBuf, &wlen, KASPA_PSKT_SCAN_MAX)) return;
  if (!seedmask_kaspa_unsigned_is_v2(g_kaspaPsktWorkBuf, wlen)) return;
  g_kaspaKpubStatus = (int8_t)seedmask_kaspa_unsigned_kpub_status(g_kaspaPsktWorkBuf, wlen, g_addrAccount);
}

static void format_sompi_kas_line(uint64_t sompi, char* buf, size_t cap) {
  uint64_t whole = sompi / 100000000ULL;
  uint64_t frac = sompi % 100000000ULL;
  char frac8[9];
  snprintf(frac8, sizeof(frac8), "%08llu", (unsigned long long)frac);
  int end = 7;
  while (end > 0 && frac8[end] == '0') end--;
  frac8[end + 1] = 0;
  if (frac8[0] == 0)
    snprintf(buf, cap, "%llu KAS", (unsigned long long)whole);
  else
    snprintf(buf, cap, "%llu.%s KAS", (unsigned long long)whole, frac8);
}

static void format_sompi_grouped_line(uint64_t sompi, char* buf, size_t cap) {
  char tmp[28];
  snprintf(tmp, sizeof(tmp), "%llu", (unsigned long long)sompi);
  int n = (int)strlen(tmp);
  int lead = n % 3;
  if (lead == 0) lead = 3;
  char mid[40];
  size_t p = 0;
  for (int i = 0; i < n;) {
    if (i > 0 && p + 1 < sizeof(mid)) mid[p++] = ' ';
    int take = (i == 0) ? lead : 3;
    while (take-- && i < n && p + 1 < sizeof(mid)) mid[p++] = tmp[i++];
  }
  mid[p] = 0;
  snprintf(buf, cap, "%s sompi", mid);
}

static void kaspa_review_format_amount_line(uint64_t sompi, char* out, size_t outCap) {
  if (g_kaspaReviewUnitSompi)
    format_sompi_grouped_line(sompi, out, outCap);
  else
    format_sompi_kas_line(sompi, out, outCap);
}

static void crypto_invalidate_kaspa_review(void) {
  g_kaspaReviewSummaryValid = false;
  memset(&g_kaspaReviewSummary, 0, sizeof(g_kaspaReviewSummary));
  g_kaspaReviewAmt[0] = g_kaspaReviewDest[0] = g_kaspaReviewChg[0] = g_kaspaReviewFee[0] = 0;
}

static void crypto_refresh_kaspa_review(void) {
  crypto_invalidate_kaspa_review();
  if (!g_kaspaPsktScanLen || !g_kaspaPsktScanBuf[0]) return;
  size_t wlen = g_kaspaPsktScanLen;
  if (wlen >= KASPA_PSKT_SCAN_MAX) wlen = KASPA_PSKT_SCAN_MAX - 1;
  memcpy(g_kaspaPsktWorkBuf, g_kaspaPsktScanBuf, wlen);
  g_kaspaPsktWorkBuf[wlen] = 0;
  if (!kaspa_extract_unsigned_payload(g_kaspaPsktWorkBuf, &wlen, KASPA_PSKT_SCAN_MAX)) {
    snprintf(g_kaspaReviewDest, sizeof(g_kaspaReviewDest), "Parse error");
    return;
  }
  if (!seedmask_kaspa_review_summarize(g_kaspaPsktWorkBuf, wlen, &g_kaspaReviewSummary)
      || !g_kaspaReviewSummary.ok) {
    snprintf(g_kaspaReviewAmt, sizeof(g_kaspaReviewAmt), "-");
    snprintf(g_kaspaReviewDest, sizeof(g_kaspaReviewDest),
             "%s", g_kaspaReviewSummary.err[0] ? g_kaspaReviewSummary.err : "Parse error");
    snprintf(g_kaspaReviewFee, sizeof(g_kaspaReviewFee), "-");
    return;
  }
  kaspa_review_format_amount_line(g_kaspaReviewSummary.send_sompi, g_kaspaReviewAmt, sizeof(g_kaspaReviewAmt));
  if (g_kaspaReviewSummary.change_sompi == 0)
    snprintf(g_kaspaReviewChg, sizeof(g_kaspaReviewChg), "No change");
  else
    kaspa_review_format_amount_line(g_kaspaReviewSummary.change_sompi, g_kaspaReviewChg, sizeof(g_kaspaReviewChg));
  kaspa_review_format_amount_line(g_kaspaReviewSummary.fee_sompi, g_kaspaReviewFee, sizeof(g_kaspaReviewFee));
  strncpy(g_kaspaReviewDest, g_kaspaReviewSummary.dest_addr, sizeof(g_kaspaReviewDest) - 1);
  g_kaspaReviewDest[sizeof(g_kaspaReviewDest) - 1] = 0;
  g_kaspaReviewSummaryValid = true;
}

