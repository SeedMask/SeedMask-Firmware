// Blockchain Commons bc-ur fountain fragment size (bytes of UR CBOR message); same encoder as Passport/Sparrow.
#ifndef SP_BC_UR_MAX_FRAGMENT_LEN
#define SP_BC_UR_MAX_FRAGMENT_LEN 200u
#endif
// qrcodegen is capped at MAX_VERSION=16; ECC-Q byte capacity ~335 — UR must fit or Sparrow won't read the QR.
// Signed PSBT export QR uses ECC_LOW (larger modules → easier for Sparrow webcam); v16 ~586 bytes payload.
#ifndef SP_BC_UR_QR_MAX_URI_CHARS
// Kaspa static single-part UR from coordinator (dense QR); multipart parts are smaller per frame.
#define SP_BC_UR_QR_MAX_URI_CHARS 2800u
#endif

