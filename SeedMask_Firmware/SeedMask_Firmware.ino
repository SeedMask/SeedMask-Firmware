// Swipe-back: return true if current screen supports going back via swipe
static bool canSwipeBack() {
  if (g_editMode != EditMode::NONE) return true;  // editor always has back
  if (g_tempSeedAlreadyInUsePopup && g_screen == UIScreen::CRYPTO_TEMP_SEED) return false;
  switch (g_screen) {
    case UIScreen::HOME:
    case UIScreen::LOCKED:
    case UIScreen::UNLOCK_PASSWORD:
      return false;
    case UIScreen::DURESS_GAMES:
      return false;  // no swipe to empty-vault menu — user is in “games only” duress session
    case UIScreen::CREATE_PICK:
    case UIScreen::CREATE_ENTROPY_METHOD:
    case UIScreen::CREATE_ENTROPY_HW_WARN:
    case UIScreen::CREATE_DICE_WORDS:
    case UIScreen::CREATE_DICE_ROLL:
    case UIScreen::CREATE_GEN:
    case UIScreen::CREATE_VERIFY_CHOICE:
    case UIScreen::CREATE_CONFIRM:
      return true;
    case UIScreen::CREATE_LOCK_TYPE:
      // After restore: lock is mandatory — never swipe-escape to menu.
      if (g_onboardLockFlow && !g_onboardLockAfterCreate) return false;
      return true;
