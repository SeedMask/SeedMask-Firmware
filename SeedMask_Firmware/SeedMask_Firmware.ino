static void syncGenSeedToDisplay() {
  memset(g_seed, 0, sizeof(g_seed));
  for (int i = 0; i < g_wc; i++) {
    strncpy(g_seed[i], g_seedGen[i], 15);
    g_seed[i][15] = 0;
  }
}

static void passwordInputTap(uint16_t x, uint16_t y, char* pw, size_t cap) {
  // OK is not a character key; flash it here so screens that don't explicitly
  // handle OK still give tactile feedback. Same row-4 resolution as keyboardHit.
  if (hitOkKeyResolved((int16_t)x, (int16_t)y)) {
    flashKeyRectTranslucent(keyRectRow4[2]);  // includes flush; no draw() on this path
    return;
  }
  char c = keyboardHit(x, y);
  if (!c) return;
  if (g_kbMode == KBMode::LETTERS && g_shift && c >= 'a' && c <= 'z') {
    c = (char)(c - 'a' + 'A');
    if (g_shift == 1) g_shift = 0;  // one-shot: only first letter uppercase
  }
  if (c == '\b') backspaceStr(pw, cap);
  else appendChar(pw, cap, c);
  if (g_screen == UIScreen::LOCKED || g_screen == UIScreen::UNLOCK_PASSWORD) setMsg("");
  if (g_screen == UIScreen::LOCKED) g_lockedNeedsRedraw = true;
  draw();
}

// Fast-repeat delete when holding the Del key on typing screens (not SET_TIME / PIN numpads).
static void handleDeleteHold() {
  if (g_editMode != EditMode::NONE) {
    edit_bs();
    draw();
    return;
  }

  switch (g_screen) {
    case UIScreen::BACKUP_FROM_SEED:
      backspaceWordBuf();
      draw();
      break;

    case UIScreen::CREATE_PASSWORD:
    case UIScreen::BACKUP_PASSWORD1:
    case UIScreen::RESTORE_PASSWORD:
    case UIScreen::UNLOCK_PASSWORD:
    case UIScreen::LOCKED:
      if (g_screenLockUsesPin) break;
      // fall through
    case UIScreen::CONFIRM_MASTER_SHOW:
    case UIScreen::CONFIRM_MASTER_SEND:
    case UIScreen::SECURITY_LOCK_PW_CONFIRM_VAULT:
    case UIScreen::SECURITY_LOCK_PW_SETUP:
    case UIScreen::SECURITY_DURESS_PW_SETUP:
      backspaceStr(g_password1, sizeof(g_password1));
      if (g_screen == UIScreen::LOCKED) g_lockedNeedsRedraw = true;
      draw();
      break;

    case UIScreen::SECURITY_PIN_SETUP:
    case UIScreen::SECURITY_DURESS_PIN_SETUP:
      backspaceStr(g_password1, sizeof(g_password1));
      draw();
      break;

    case UIScreen::PASSWORDS:
      if (g_showMasterPwShowPopup) {
        backspaceStr(g_password1, sizeof(g_password1));
        draw();
      }
      break;

    case UIScreen::TFA_ADD:
      {
        char* curBuf = (g_tfaAddFocus == 0) ? g_tfaAddLabel : (g_tfaAddFocus == 1) ? g_tfaAddAccount
                                                                                   : g_tfaAddSecret;
        uint16_t& curPos = (g_tfaAddFocus == 0) ? g_tfaAddCursorLabel : (g_tfaAddFocus == 1) ? g_tfaAddCursorAccount
                                                                                             : g_tfaAddCursorSecret;
        size_t n = strlen(curBuf);
        if (curPos > n) curPos = (uint16_t)n;
        if (n > 0 && curPos > 0) {
          memmove(&curBuf[curPos - 1], &curBuf[curPos], n - (size_t)curPos + 1);
          curPos--;
          g_lastEditInputMs = millis();
          draw();
        }
        break;
      }

    case UIScreen::CREATE_PASSWORD2:
    case UIScreen::BACKUP_PASSWORD2:
      backspaceStr(g_password2, sizeof(g_password2));
      draw();
      break;

    case UIScreen::RESTORE_CODE:
      restorePayload_bs();
      setMsg("");
      draw();
      break;

    case UIScreen::SET_TIME:
      backspaceStr(g_setTimeBuf, sizeof(g_setTimeBuf));
      draw();
      break;

    case UIScreen::CRYPTO_NEW_ACCOUNT:
      backspaceStr(g_newAccountBuf, sizeof(g_newAccountBuf));
      draw();
      break;
    case UIScreen::CRYPTO_NEW_ACCOUNT_NAME:
      backspaceStr(g_newAccountNameBuf, sizeof(g_newAccountNameBuf));
      draw();
      break;
    case UIScreen::DEVICE_RENAME:
      backspaceStr(g_deviceRenameBuf, sizeof(g_deviceRenameBuf));
      draw();
      break;
    case UIScreen::SD_FILE_RENAME:
      backspaceStr(g_sdRenameBuf, sizeof(g_sdRenameBuf));
      draw();
      break;

    case UIScreen::CRYPTO_PASSPHRASE_INPUT:
      backspaceStr(g_bip39PassphraseInput, sizeof(g_bip39PassphraseInput));
      draw();
      break;

    default:
      break;
  }
}

static void preparePasswordPromptKeyboard() {
  // Enter password prompts in a clean keyboard state and clear any stale
  // touch edge left over from the previous screen (especially SD file lists).
  g_kbMode = KBMode::LETTERS;
  g_shift = 0;
  g_touchReleasedSinceTap = true;
  g_syncTouchAfterQrScan = true;
  g_lastTapMs = 0;
}

