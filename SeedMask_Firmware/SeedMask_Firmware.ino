static void drawCryptoHomeCard(int x, int y, int w, int h, char iconId, const char* title, uint16_t borderColor, bool largeLabel = false) {
  // Same blue-grey gradient + soft borders as main-menu Passwords / Notes / 2FA tiles.
  const int sq = (w < h) ? w : h;
  const int tx = x + (w - sq) / 2;
  const int ty = y + (h - sq) / 2;
  const int rad = max(14, sq / 5);
  const uint16_t cardBg = mainMenuDarkCardTile565();
  fillMainMenuStyleGradientTile(tx, ty, sq, rad);

  int cx = tx + sq / 2;
  int cy = ty + ((iconId == 'E' || iconId == 'S' || iconId == 'N' || iconId == 'R' || iconId == 'Y' || iconId == 'B' || iconId == 'P' || iconId == 'A' || iconId == 'C' || (iconId == 'T' && largeLabel) || (iconId == 'X' && largeLabel)) ? (sq / 2 - 2) : 24);
  const uint16_t iconColor = (iconId == 'E') ? UI_ACCENT : UI_TEXT;
  drawCardIcon(cx, cy, iconId, iconColor, cardBg, largeLabel);

  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(largeLabel ? 2 : 1);
  if (title && title[0]) {
    const char* sp = strchr(title, ' ');
    const bool twoWords = (largeLabel && sp && strchr(sp + 1, ' ') == nullptr);
    int charW = largeLabel ? 12 : 6;
    if (twoWords) {
      char w1[24] = { 0 }, w2[24] = { 0 };
      size_t l1 = (size_t)(sp - title);
      if (l1 > sizeof(w1) - 1) l1 = sizeof(w1) - 1;
      memcpy(w1, title, l1);
      strncpy(w2, sp + 1, sizeof(w2) - 1);
      int w1x = tx + (sq - (int)strlen(w1) * charW) / 2;
      int w2x = tx + (sq - (int)strlen(w2) * charW) / 2;
      if (w1x < tx + 2) w1x = tx + 2;
      if (w2x < tx + 2) w2x = tx + 2;
      int y1 = ty + sq - 34;
      int y2 = ty + sq - 20;
      gfx->setCursor(w1x, y1);
      gfx->print(w1);
      gfx->setCursor(w2x, y2);
      gfx->print(w2);
    } else {
      int titleLen = (int)strlen(title);
      int titleX = tx + (sq - titleLen * charW) / 2;
      if (titleX < tx + 2) titleX = tx + 2;
      int titleY = ty + sq - (largeLabel ? 20 : 12);
      gfx->setCursor(titleX, titleY);
      gfx->print(title);
    }
  }
}

static void centerText(const char* s, int y, int size = 2) {
  gfx->setTextSize(size);
  gfx->setTextColor(UI_TEXT);
  int16_t w = strlen(s) * (size * 6);
  int16_t x = (LCD_W - w) / 2;
  if (x < 0) x = 0;
  gfx->setCursor(x, y);
  gfx->print(s);
}

