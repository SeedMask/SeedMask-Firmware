static bool ms_sd_row_is_selectable_file(int idx) {
  if (idx < 0 || idx >= g_msSdCount) return false;
  if (g_msSdIsDir[idx]) return false;
  if (strcmp(g_msSdNames[idx], "..") == 0) return false;
  return true;
}

static bool ms_sd_row_is_openable_entry(int idx) {
  if (idx < 0 || idx >= g_msSdCount) return false;
  if (strcmp(g_msSdNames[idx], "..") == 0) return false;
  return true;
}

static bool ms_sd_row_is_deletable(int idx) {
  return ms_sd_row_is_openable_entry(idx);
}

static void drawCryptoMultisigSdBrowse() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("microSD", true);
  gfx->setTextColor(RGB565_LIGHTGREY);
  gfx->setTextSize(2);
  gfx->setCursor(10, 48);
  {
    char showPath[64];
    const char* cwd = g_msSdCwd;
    if (strlen(cwd) > 28) {
      snprintf(showPath, sizeof(showPath), "...%s", cwd + strlen(cwd) - 24);
    } else {
      snprintf(showPath, sizeof(showPath), "%s", cwd);
    }
    gfx->print(showPath);
  }
  int startIdx = g_msSdScrollOffset;
  int endIdx = min(startIdx + SD_FILES_PER_PAGE, g_msSdCount);
  int y = SD_LIST_TOP;
  for (int i = startIdx; i < endIdx; i++) {
    if (i == g_msSdSelectedFile) {
      gfx->fillRect(SD_LIST_LEFT, y - 2, SD_LIST_RIGHT - SD_LIST_LEFT, MULTISIG_SD_LIST_ROW_H, UI_ACCENT);
      gfx->setTextColor(RGB565_BLACK);
    } else {
      gfx->setTextColor(UI_TEXT);
    }
    if (g_msSdIsDir[i]) {
      draw_multisig_sd_folder_icon(SD_LIST_LEFT, (int16_t)(y + 6), UI_ACCENT);
      gfx->setTextSize(2);
      gfx->setCursor(SD_LIST_LEFT + 30, y + 10);
      gfx->printf("%d) %s", i + 1, g_msSdNames[i]);
    } else {
      gfx->setTextSize(1);
      gfx->setCursor(SD_LIST_LEFT + 4, y + 6);
      if (sd_entry_is_backup_bin(g_msSdNames[i])) gfx->print("B ");
      else if (sd_entry_is_pw_vault(g_msSdNames[i])) gfx->print("P ");
      else if (sd_entry_has_bin_ext(g_msSdNames[i])) gfx->print("? ");
      else gfx->print("  ");
      gfx->setTextSize(2);
      gfx->setCursor(SD_LIST_LEFT + 28, y + 10);
      gfx->printf("%d) %s", i + 1, g_msSdNames[i]);
    }
    y += MULTISIG_SD_LIST_ROW_H;
  }
  if (g_msSdCount == 0) {
    gfx->setTextColor(RGB565_LIGHTGREY);
    gfx->setTextSize(2);
    gfx->setCursor(10, SD_LIST_TOP);
    gfx->print("Empty folder");
  }
  if (g_msSdCount > SD_FILES_PER_PAGE) {
    int listH = SD_FILES_PER_PAGE * MULTISIG_SD_LIST_ROW_H;
    int sbX = 268, sbW = 8, sbY = SD_LIST_TOP, sbH = listH;
    gfx->fillRoundRect(sbX, sbY, sbW, sbH, 4, UI_CARD);
    gfx->drawRoundRect(sbX, sbY, sbW, sbH, 4, UI_BORDER);
    int maxOff = g_msSdCount - SD_FILES_PER_PAGE;
    int thumbH = max(12, (SD_FILES_PER_PAGE * sbH) / g_msSdCount);
    int thumbY = sbY + (maxOff > 0 ? (g_msSdScrollOffset * (sbH - thumbH)) / maxOff : 0);
    gfx->fillRoundRect(sbX + 1, thumbY, sbW - 2, thumbH, 3, UI_ACCENT);
    drawGradientSilverButton(BTN_SCROLL_UP, "^^", 1);
    drawGradientSilverButton(BTN_SCROLL_DOWN, "vv", 1);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(1);
    gfx->setCursor(268, listH + SD_LIST_TOP + 6);
    gfx->printf("%d-%d/%d", startIdx + 1, endIdx, g_msSdCount);
  }

  if (g_msSdCount > 0 && g_msSdSelectedFile >= 0 && g_msSdSelectedFile < g_msSdCount) {
    if (ms_sd_row_is_deletable(g_msSdSelectedFile)) {
      drawBtn(BTN_LIST_DELETE, "DELETE", RGB565_RED, 2);
    }
    if (ms_sd_row_is_openable_entry(g_msSdSelectedFile)) {
      const char* okLbl = g_msSdIsDir[g_msSdSelectedFile] ? "OPEN" : "LOAD";
      drawGradientSilverButton(BTN_LIST_OK, okLbl, 2);
    }
    if (ms_sd_row_is_selectable_file(g_msSdSelectedFile)) {
      drawGradientSilverButton(BTN_LIST_RENAME, "RENAME", 2);
    }
  }
  drawGradientSilverButton(BTN_LIST_BACK, "BACK", 2);

  if (g_msSdShowDeleteConfirm) {
    const int popupW = 260, popupH = 120, popupR = 12;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    uint16_t* fb = gfx->getFramebuffer();
    if (fb) {
      for (int py = popupY; py < popupY + popupH; py++) {
        for (int px = popupX; px < popupX + popupW; px++) {
          size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
          uint16_t bg = fb[idx];
          fb[idx] = (uint16_t)(((bg & 0xF7DE) >> 1) + ((UI_CARD & 0xF7DE) >> 1));
        }
      }
    } else {
      gfx->fillRoundRect(popupX, popupY, popupW, popupH, popupR, UI_CARD);
    }
    gfx->drawRoundRect(popupX, popupY, popupW, popupH, popupR, UI_ACCENT);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(1);
    gfx->setCursor(popupX + 12, popupY + 22);
    if (g_msSdSelectedFile >= 0 && g_msSdSelectedFile < g_msSdCount && g_msSdIsDir[g_msSdSelectedFile]
        && strcmp(g_msSdNames[g_msSdSelectedFile], "..") != 0) {
      gfx->print("Delete this folder and");
      gfx->setCursor(popupX + 12, popupY + 34);
      gfx->print("everything inside?");
    } else {
      gfx->setCursor(popupX + 12, popupY + 28);
      gfx->print("Delete this file?");
    }
    drawBtn(Rect{ popupX + 20, popupY + 62, 100, 44 }, "Yes", RGB565_RED, 2);
    drawBtn(Rect{ popupX + 140, popupY + 62, 100, 44 }, "Cancel", RGB565_DARKGREY, 2);
  }

  if (g_msg[0]) {
    gfx->setTextColor(RGB565_CYAN);
    gfx->setTextSize(1);
    gfx->setCursor(10, 392);
    gfx->print(g_msg);
  }
  draw_multisig_duplicate_notice_overlay();
  ui_flush();
}

static void handleCryptoMultisigSdBrowseTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    multisig_duplicate_notice_dismiss();
    g_optionsHomeScreen = UIScreen::CRYPTO_MULTISIG_SD_BROWSE;
    show(UIScreen::BURGER_MENU);
    return;
  }
  if (!vault_is_unlocked() || !g_loggedIn) {
    setMsgTr("Unlock first", "Prvo otkljucajte");
    show(UIScreen::LOCKED);
    return;
  }
  if (g_multisigDuplicateNoticeActive) {
    if (hit(multisig_duplicate_notice_ok_rect(), x, y)) {
      multisig_duplicate_notice_dismiss();
      draw();
      return;
    }
    if (hit(BTN_LIST_BACK, x, y)) {
      multisig_duplicate_notice_dismiss();
      g_msSdShowDeleteConfirm = false;
      show(UIScreen::CRYPTO_MULTISIG_IMPORT);
      return;
    }
    return;
  }
  if (hit(BTN_LIST_BACK, x, y)) {
    g_msSdShowDeleteConfirm = false;
    show(UIScreen::CRYPTO_MULTISIG_IMPORT);
    return;
  }

  if (g_msSdShowDeleteConfirm) {
    const int popupW = 260, popupH = 120;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    Rect rYes = { (int16_t)(popupX + 20), (int16_t)(popupY + 62), 100, 44 };
    Rect rCancel = { (int16_t)(popupX + 140), (int16_t)(popupY + 62), 100, 44 };
    if (hit(rYes, x, y)) {
      g_msSdShowDeleteConfirm = false;
      int wasIdx = g_msSdSelectedFile;
      if (wasIdx >= 0 && wasIdx < g_msSdCount && ms_sdDeleteEntryAt(wasIdx)) {
        multisig_sd_scan_dir();
        g_msSdScrollOffset = 0;
        g_msSdSelectedFile = (wasIdx >= g_msSdCount) ? (g_msSdCount - 1) : wasIdx;
        if (g_msSdSelectedFile < 0) g_msSdSelectedFile = -1;
        setMsg("Deleted");
      } else {
        setMsg("Delete failed");
      }
      drawCryptoMultisigSdBrowse();
      return;
    }
    if (hit(rCancel, x, y)) {
      g_msSdShowDeleteConfirm = false;
      drawCryptoMultisigSdBrowse();
      return;
    }
    return;
  }

  if (g_msSdCount > SD_FILES_PER_PAGE) {
    if (hit(BTN_SCROLL_UP, x, y) && g_msSdScrollOffset > 0) {
      g_msSdScrollOffset = max(0, g_msSdScrollOffset - SD_FILES_PER_PAGE);
      drawCryptoMultisigSdBrowse();
      return;
    }
    if (hit(BTN_SCROLL_DOWN, x, y) && g_msSdScrollOffset + SD_FILES_PER_PAGE < g_msSdCount) {
      g_msSdScrollOffset = min(g_msSdCount - SD_FILES_PER_PAGE, g_msSdScrollOffset + SD_FILES_PER_PAGE);
      drawCryptoMultisigSdBrowse();
      return;
    }
  }

  if (ms_sd_row_is_deletable(g_msSdSelectedFile) && hit(BTN_LIST_DELETE, x, y)) {
    g_msSdShowDeleteConfirm = true;
    drawCryptoMultisigSdBrowse();
    return;
  }

  if (ms_sd_row_is_selectable_file(g_msSdSelectedFile) && hit(BTN_LIST_RENAME, x, y)) {
    int sel = g_msSdSelectedFile;
    if (sel < 0 || sel >= g_msSdCount || g_msSdIsDir[sel]) return;
    char filepath[192];
    snprintf(filepath, sizeof(filepath), "%s/%s", g_msSdCwd, g_msSdNames[sel]);
    sd_rename_begin_from_basename(filepath, g_msSdNames[sel]);
    g_sdRenameReturnScreen = UIScreen::CRYPTO_MULTISIG_SD_BROWSE;
    show(UIScreen::SD_FILE_RENAME);
    return;
  }

  if (ms_sd_row_is_openable_entry(g_msSdSelectedFile) && hit(BTN_LIST_OK, x, y)) {
    int sel = g_msSdSelectedFile;
    if (sel < 0 || sel >= g_msSdCount) return;
    if (g_msSdIsDir[sel]) {
      char full[192];
      snprintf(full, sizeof(full), "%s/%s", g_msSdCwd, g_msSdNames[sel]);
      if (strlen(full) >= sizeof(g_msSdCwd)) {
        setMsg("Path too long");
        drawCryptoMultisigSdBrowse();
        return;
      }
      strncpy(g_msSdCwd, full, sizeof(g_msSdCwd) - 1);
      g_msSdCwd[sizeof(g_msSdCwd) - 1] = 0;
      multisig_sd_scan_dir();
      g_msSdScrollOffset = 0;
      setMsg("");
      g_touchIgnoreUntil = millis() + 320;
      sdScrollLastY = -1;
      sdScrollAccum = 0.f;
      drawCryptoMultisigSdBrowse();
      return;
    }
    char full[192];
    snprintf(full, sizeof(full), "%s/%s", g_msSdCwd, g_msSdNames[sel]);
    (void)multisig_import_policy_from_path(full);
    if (g_screen == UIScreen::CRYPTO_MULTISIG_SD_BROWSE) drawCryptoMultisigSdBrowse();
    return;
  }

  int startIdx = g_msSdScrollOffset;
  int endIdx = min(startIdx + SD_FILES_PER_PAGE, g_msSdCount);
  int yPos = SD_LIST_TOP;
  for (int i = startIdx; i < endIdx; i++) {
    if (x >= SD_LIST_LEFT && x <= SD_LIST_RIGHT && y >= yPos - 2 && y <= yPos + MULTISIG_SD_LIST_ROW_H) {
      const char* nm = g_msSdNames[i];
      if (strcmp(nm, "..") == 0) {
        g_msSdShowDeleteConfirm = false;
        if (multisig_sd_go_parent()) {
          multisig_sd_scan_dir();
          g_msSdScrollOffset = 0;
          setMsg("");
          g_touchIgnoreUntil = millis() + 320;
          sdScrollLastY = -1;
          sdScrollAccum = 0.f;
        }
        drawCryptoMultisigSdBrowse();
        return;
      }
      g_msSdSelectedFile = i;
      drawCryptoMultisigSdBrowse();
      return;
    }
    yPos += MULTISIG_SD_LIST_ROW_H;
  }
}

