// Draw one glassy stadium (pill) for a suggestion; r = h/2 for full rounded ends
static void drawGlassyStadium(int x, int y, int w, int h) {
  const int r = h / 2;
  const uint16_t glassColor = (uint16_t)0x3186;
  uint16_t* fb = gfx->getFramebuffer();
  int cy = y + h / 2;
  int leftCx = x + r, rightCx = x + w - r;
  if (fb) {
    for (int py = y; py < y + h; py++) {
      for (int px = x; px < x + w; px++) {
        bool inside = false;
        if (px < leftCx) {
          int dx = px - leftCx, dy = py - cy;
          inside = (dx * dx + dy * dy <= r * r);
        } else if (px >= rightCx) {
          int dx = px - rightCx, dy = py - cy;
          inside = (dx * dx + dy * dy <= r * r);
        } else {
          inside = true;
        }
        if (inside) {
          size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
          uint16_t bg = fb[idx];
          fb[idx] = (uint16_t)(((bg & 0xF7DE) >> 1) + ((glassColor & 0xF7DE) >> 1));
        }
      }
    }
  } else {
    gfx->fillRoundRect(x, y, w, h, r, glassColor);
  }
  gfx->drawRoundRect(x, y, w, h, r, UI_ACCENT);
}

