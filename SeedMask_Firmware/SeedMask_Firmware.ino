static bool rgb565_is_crypto_home_orange(uint16_t c) {
  if (c == 0x0000 || c == 0xF81F) return false;
  if (c == RGB565_BITCOIN_ORANGE || c == RGB565_ORANGE || c == RGB565_AMBER || c == RGB565_GOLD) return true;
  switch (c) {
    case 0xFCA0:
    case 0xF480:
    case 0xFD00:
    case 0xFD20:
    case 0xFD40:
    case 0xFD60:
    case 0xFD80:
    case 0xFDA0:
    case 0xF4A0:
    case 0xF4C0:
    case 0xF4E0:
    case 0xFCE0:
    case 0xECA0:
    case 0xEC60:
    case 0xE440:
    case 0xE420:
    case 0xE460:
    case 0xE480:
    case 0xDC00:
    case 0xDC20:
    case 0xDC40:
    case 0xDC60:
    case 0xD3E0:
    case 0xAB40:
    case 0xB360:
    case 0xBB60:
    case 0xCBC0:
    case 0xB340:
      return true;
    default:
      break;
  }
  const uint8_t r = (uint8_t)((c >> 11) & 0x1F);
  const uint8_t g = (uint8_t)((c >> 5) & 0x3F);
  const uint8_t b = (uint8_t)(c & 0x1F);
  if (b > 8) return false;
  if (r < 20 || g < 12) return false;
  if (r < 26 && (int)abs((int)r - (int)g) <= 6) return false;
  return (uint8_t)(r + g) >= 38;
}

static uint16_t cryptoHomeRemapIconPixel(uint16_t c) {
