static bool kaspa_pskt_qr_payload_looks_valid(const char* p, size_t len) {
  if (!p) return false;
  while (len > 0 && (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')) {
    p++;
    len--;
  }
  if (len < 8) return false;
  if (*p == '{') return true;
  for (size_t i = 0; i + 4 <= len; i++) {
    if (strncasecmp(p + i, "pskt", 4) == 0) return true;
  }
  for (size_t i = 0; i + 11 <= len; i++) {
    if (strncasecmp(p + i, "transaction", 11) == 0) return true;
  }
  return false;
}

