  const int R = 34;
  const int n = 12;
  const float twoPi = 6.2831853f;
  const float halfPi = 1.5707963f;
  uint32_t step = millis() / 42;
  int head = (int)(step % n);
  uint16_t track = blendRGB565(RGB565_DARKGREY, RGB565_WHITE, 0.5f);
  gfx->drawCircle(cx, cy, R, track);
  gfx->drawCircle(cx, cy, R - 1, track);
  for (int i = 0; i < n; i++) {
    float ang = (float)i * twoPi / (float)n - halfPi;
    int px = (int)(cx + (float)R * cosf(ang) + 0.5f);
    int py = (int)(cy + (float)R * sinf(ang) + 0.5f);
    int d = (i - head + n * 8) % n;
    int rad = 5;
    uint16_t col;
    if (d == 0) {
      col = UI_ACCENT;
      rad = 8;
    } else if (d == 1 || d == n - 1) {
      col = blendRGB565(UI_ACCENT, RGB565_WHITE, 0.2f);
      rad = 7;
    } else if (d == 2 || d == n - 2) {
      col = blendRGB565(UI_ACCENT, RGB565_WHITE, 0.45f);
    } else {
      col = blendRGB565(RGB565_DARKGREY, RGB565_WHITE, 0.55f);
    }
    gfx->fillCircle(px, py, rad, col);
  }

  gfx->setTextColor(RGB565_BLACK);
  gfx->setTextSize(1);
  const char* t1 = "Rename in progress";
  int tw = (int)strlen(t1) * 6;
  gfx->setCursor((LCD_W - tw) / 2, labelY);
  gfx->print(t1);
}

// Thick line (parallel offsets) for a crisp vector stroke.
static void drawThickLineSeg(int x0, int y0, int x1, int y1, uint16_t col, int halfW) {
  int dx = x1 - x0, dy = y1 - y0;
  float lenf = sqrtf((float)(dx * dx + dy * dy));
  if (lenf < 0.5f) return;
  for (int w = -halfW; w <= halfW; w++) {
    int ox = (int)(((-dy) * (float)w) / lenf + ((w >= 0) ? 0.5f : -0.5f));
    int oy = (int)(((dx) * (float)w) / lenf + ((w >= 0) ? 0.5f : -0.5f));
    gfx->drawLine(x0 + ox, y0 + oy, x1 + ox, y1 + oy, col);
  }
}

static void drawThickLineSegPartial(int x0, int y0, int x1, int y1, uint16_t col, int halfW, float p01) {
  if (p01 <= 0.f) return;
  if (p01 >= 1.f) {
    drawThickLineSeg(x0, y0, x1, y1, col, halfW);
    return;
  }
  int x1p = x0 + (int)((x1 - x0) * p01 + ((x1 >= x0) ? 0.5f : -0.5f));
  int y1p = y0 + (int)((y1 - y0) * p01 + ((y1 >= y0) ? 0.5f : -0.5f));
  drawThickLineSeg(x0, y0, x1p, y1p, col, halfW);
}

// Success: snappier pop-in, specular glint, impact ring, thicker check stroke, shadowed title + growing accent bar.
static void drawDeviceRenameSuccessAnimated(int cx, int cy, int titleY) {
  uint32_t age = millis() - g_deviceRenameFeedbackPhaseStartMs;
  float t = min(1.f, age / 450.f);
  float tDisk = easeOutBackRename(min(1.f, t / 0.5f));
  const uint16_t disk = UI_SUCCESS;
  const uint16_t rim = blendRGB565(UI_SUCCESS, RGB565_BLACK, 0.28f);
  const uint16_t rimHi = blendRGB565(RGB565_WHITE, UI_SUCCESS, 0.42f);
  const int Rmax = 44;
  int R = (int)((float)Rmax * tDisk + 0.5f);
  if (R > 2) {
    gfx->fillCircle(cx, cy, R, disk);
    gfx->drawCircle(cx, cy, R, rim);
    if (R > 4) gfx->drawCircle(cx, cy, R - 1, rim);
    if (R >= Rmax - 2) {
      float glintPhase = (float)age * 0.0085f;
      for (int k = 0; k < 6; k++) {
        float ang = -1.35f + 0.11f * (float)k + 0.04f * sinf(glintPhase);
        int gx = cx + (int)(cosf(ang) * (float)(R - 11));
        int gy = cy + (int)(sinf(ang) * (float)(R - 11));
        gfx->fillCircle(gx, gy, 2, blendRGB565(RGB565_WHITE, disk, 0.15f + 0.12f * (float)k));
      }
      float ping = sinf((float)age * 0.031f);
      if (ping > 0.86f) {
        gfx->drawCircle(cx, cy, R + 2, rimHi);
        gfx->drawCircle(cx, cy, R + 3, blendRGB565(rimHi, RGB565_WHITE, 0.5f));
      }
    }
  }

  float rip = ((float)age - 470.f) / 200.f;
  if (rip > 0.f && rip < 1.f) {
    int rr = Rmax + 5 + (int)(20.f * rip + 0.5f);
    uint16_t rc = blendRGB565(UI_SUCCESS, RGB565_WHITE, 1.f - rip);
    gfx->drawCircle(cx, cy, rr, rc);
    gfx->drawCircle(cx, cy, rr - 1, blendRGB565(rc, RGB565_WHITE, 0.35f));
  }

  const uint16_t chk = RGB565_WHITE;
  const uint16_t chkEdge = blendRGB565(UI_SUCCESS, RGB565_BLACK, 0.55f);
  int ax = cx - 26, ay = cy + 8;
  int bx = cx - 9, by = cy + 26;
  int cx2 = cx + 28, cy2 = cy - 18;

  float tCheck = (age < 120) ? 0.f : min(1.f, (age - 120) / 340.f);
  const int chkHalf = 6;
  if (tCheck > 0.f && R >= Rmax - 3) {
    float leg1 = min(1.f, tCheck / 0.4f);
    float leg2 = max(0.f, min(1.f, (tCheck - 0.4f) / 0.6f));
    drawThickLineSegPartial(ax, ay, bx, by, chkEdge, chkHalf + 1, leg1);
    drawThickLineSegPartial(ax, ay, bx, by, chk, chkHalf, leg1);
    if (leg2 > 0.f) {
      drawThickLineSegPartial(bx, by, cx2, cy2, chkEdge, chkHalf + 1, leg2);
      drawThickLineSegPartial(bx, by, cx2, cy2, chk, chkHalf, leg2);
    }
    if (tCheck > 0.93f) gfx->fillCircle(bx, by, 6, chk);
  }

  float tTitle = max(0.f, min(1.f, (age - 170) / 240.f));
  int rise = (int)((1.f - tTitle) * 12.f);
  const char* t2 = "All set!";
  int tw2 = (int)strlen(t2) * 6 * 2;
  int tx = (LCD_W - tw2) / 2;
  int ty = titleY + rise;
  gfx->setTextSize(2);
  gfx->setTextColor(blendRGB565(RGB565_BLACK, RGB565_WHITE, 0.72f));
  gfx->setCursor(tx + 1, ty + 1);
  gfx->print(t2);
  gfx->setTextColor(RGB565_BLACK);
  gfx->setCursor(tx, ty);
  gfx->print(t2);

  if (tTitle > 0.35f) {
    int uw = (int)((float)tw2 * min(1.f, (tTitle - 0.35f) / 0.55f) + 0.5f);
    int uy = ty + 18;
    gfx->fillRect(tx, uy, uw, 3, UI_ACCENT);
    gfx->drawLine(tx, uy + 2, tx + uw, uy + 2, blendRGB565(UI_ACCENT, RGB565_WHITE, 0.35f));
  }

  if (age > 300 && ui_device_display_name()[0]) {
    float subA = max(0.f, min(1.f, (age - 300) / 160.f));
    gfx->setTextSize(1);
    uint16_t subCol = blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.38f + 0.52f * subA);
    char show[40];
    strncpy(show, ui_device_display_name(), sizeof(show) - 1);
    show[sizeof(show) - 1] = 0;
    size_t sl = strlen(show);
    if (sl > 32) {
      show[29] = '.';
      show[30] = '.';
      show[31] = '.';
      show[32] = 0;
    }
    int sw = (int)strlen(show) * 6;
    gfx->setTextColor(subCol);
    gfx->setCursor((LCD_W - sw) / 2, titleY + 32);
    gfx->print(show);
  }
}

