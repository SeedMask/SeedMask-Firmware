    gfx->setTextSize(1);
    gfx->setTextColor(RGB565_LIGHTGREY);
    gfx->setCursor(pad, 34);
    gfx->print("Several valid vault .bin files");
    gfx->setCursor(pad, 48);
    gfx->print("are in the backup folder. Pick");
    gfx->setCursor(pad, 62);
    gfx->print("which to use for saves, or use");
    gfx->setCursor(pad, 76);
