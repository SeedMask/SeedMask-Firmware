// Encode full Passport JSON for Sparrow as BC-UR `bytes` (same path as PSBT: retry fragment size for QR cap).
static bool crypto_build_connect_sparrow_ur_from_json(const char* jsonUtf8) {
  if (!jsonUtf8 || !jsonUtf8[0]) return false;
  size_t jlen = strlen(jsonUtf8);
  const size_t kBuf = CRYPTO_CONNECT_SPARROW_UR_BYTES;
  const size_t kMaxUri = (size_t)SP_BC_UR_QR_MAX_URI_CHARS;
  size_t frag = (size_t)SP_BC_UR_MAX_FRAGMENT_LEN;
  if (frag < 40) frag = 40;
  while (frag >= 40) {
    seedmask_bc_ur_reset();
    if (!seedmask_bc_ur_begin_psbt_ex((const uint8_t*)jsonUtf8, jlen, frag, "bytes")) {
      seedmask_bc_ur_reset();
      return false;
    }
    if (!seedmask_bc_ur_next_part(g_cryptoConnectSparrowUr, kBuf)) {
      seedmask_bc_ur_reset();
      return false;
    }
    size_t slen = strlen(g_cryptoConnectSparrowUr);
    if (slen <= kMaxUri) {
      g_cryptoConnectSparrowUrFountain = !seedmask_bc_ur_is_single_part();
      g_cryptoConnectSparrowQrAnimPaused = false;
      g_cryptoConnectSparrowQrLastAnimMs = millis();
      return true;
    }
    if (frag <= 40) break;
    frag = (frag * 3) / 4;
    if (frag < 40) frag = 40;
  }
  seedmask_bc_ur_reset();
  g_cryptoConnectSparrowUr[0] = 0;
  g_cryptoConnectSparrowUrFountain = false;
  return false;
}

