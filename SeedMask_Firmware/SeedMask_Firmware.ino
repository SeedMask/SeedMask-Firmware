    if (hit(rBip85Info, x, y)) {
      g_bip85InfoReturnScreen = UIScreen::CRYPTO_BIP85_INDEX;
      flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
      delay(85);
      show(UIScreen::CRYPTO_BIP85_INFO);
      return;
    }
  }
  if (!vault_is_unlocked() || !g_loggedIn) {
    setMsgTr("Unlock first", "Prvo otkljucajte");
    show(UIScreen::LOCKED);
    return;
  }
  for (int r = 0; r < SETTIME_NUMPAD_ROWS; r++) {
    for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
      int rx = c * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
      int ry = SETTIME_NUMPAD_Y0 + r * (SETTIME_KEY_H + SETTIME_NUMPAD_GAP);
      Rect rect = { (int16_t)rx, (int16_t)ry, (int16_t)SETTIME_KEY_W, (int16_t)SETTIME_KEY_H };
      if (!hit(rect, x, y)) continue;
      if (r == 3 && c == 0) {
        backspaceStr(g_bip85IndexBuf, sizeof(g_bip85IndexBuf));
        draw();
        return;
      }
      if (r == 3 && c == 2) {
        unsigned long val = strtoul(g_bip85IndexBuf, nullptr, 10);
        if (strlen(g_bip85IndexBuf) == 0) val = 0;
        if (val > 999999UL) {
          setMsg("Index 0-999999");
          draw();
          return;
        }
        char err[80];
        bip85_wipe_derived_words();
        if (!bip85_derive_mnemonic((uint32_t)val, g_bip85WordCount, g_bip85DerivedWords, err, sizeof(err))) {
          setMsg(err);
          draw();
          return;
        }
        g_bip85LastIndex = (uint32_t)val;
        if (g_tempSeedBip85Flow) {
          g_tempSeedBip85Flow = false;
          if (!temp_seed_stage_pending((const char(*)[16])g_bip85DerivedWords, g_bip85WordCount, (uint8_t)TempSeedPendingSource::BIP85)) {
            if (strcmp(g_msg, "Already in use") == 0) {
              g_tempSeedAlreadyInUsePopup = true;
              setMsg("");
              show(UIScreen::CRYPTO_TEMP_SEED);
              return;
            }
            if (g_msg[0] == 0) setMsg("Could not stage temporary seed");
            draw();
            return;
          }
          setMsg("");
          show(UIScreen::CRYPTO_TEMP_SEED_CONFIRM);
          return;
        }
        setMsg("");
        show(UIScreen::CRYPTO_BIP85_SHOW);
        return;
      }
      if (r == 3 && c == 1) {
        if (strlen(g_bip85IndexBuf) < (size_t)(sizeof(g_bip85IndexBuf) - 1))
          appendChar(g_bip85IndexBuf, sizeof(g_bip85IndexBuf), '0');
        draw();
        return;
      }
      char digit = (char)('1' + r * 3 + c);
      if (strlen(g_bip85IndexBuf) < (size_t)(sizeof(g_bip85IndexBuf) - 1))
        appendChar(g_bip85IndexBuf, sizeof(g_bip85IndexBuf), digit);
      draw();
      return;
    }
  }
}

