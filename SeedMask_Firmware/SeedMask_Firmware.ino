/** True when try_decode already assembled full PSKT JSON in outText. */
static bool kaspa_decode_finished(char* outText) {
  return outText && outText[0] && kaspa_pskt_qr_payload_looks_valid(outText, strlen(outText));
}

/** Quirc + UR feed only — never blit camera (hot path for multipart / animated). */
