static void drawViewCode() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar(g_tempSeedActive ? "Backup code (temp)" : "Backup code", true);

  // backup_code_save_to_sd sets "Backup saved as: <filename>" — show centered, two lines, large type.
  static const char kSavedPrefix[] = "Backup saved as:";
  const size_t kSavedPrefixLen = sizeof(kSavedPrefix) - 1;
  const char* sdSavedFilename = nullptr;
  if (g_msg[0] && strncmp(g_msg, kSavedPrefix, kSavedPrefixLen) == 0) {
    const char* p = g_msg + kSavedPrefixLen;
    while (*p == ' ' || *p == ':') p++;
    if (*p) sdSavedFilename = p;
  }

  const int16_t codeTop = 56;
  const int gapAfterCode = 10;
  const int gapAfterIcon = 12;
  const int iconW = 128;
  const int iconH = 72;
  int codeDispH = 0;
  char viewCompact[BACKUP_SPB1_COMPACT_MAX];
  backup_spb1_compact_chars(g_viewBackupCode, viewCompact, sizeof(viewCompact));
  const bool spb1Boxes = backup_spb1_compact_ok(viewCompact);
  if (spb1Boxes) {
    codeDispH = drawBackupSpb1Boxes(viewCompact, codeTop);
  } else if (g_viewBackupCode[0]) {
    const int codeMaxH = 200;
    int fullH = showCodeMeasureWrappedHeight(g_viewBackupCode);
    codeDispH = (fullH > codeMaxH) ? codeMaxH : fullH;
    int16_t cy = 0;
    showCodeDrawWrappedInViewport(g_viewBackupCode, 10, codeTop, (int16_t)(codeTop + codeDispH), 0, &cy, RGB565_WHITE);
  }

  int iconY = codeTop + codeDispH + gapAfterCode;
  int iconX = (LCD_W - iconW) / 2;
  int saveY = iconY + iconH + gapAfterIcon;
  const int saveH = 38;
  const int saveW = 152;
  if (saveY + saveH > LCD_H - 8) {
    saveY = LCD_H - 8 - saveH;
    iconY = saveY - gapAfterIcon - iconH;
    if (iconY < codeTop + codeDispH + gapAfterCode)
      iconY = codeTop + codeDispH + gapAfterCode;
  }
  g_viewCodeQrBtnRect = { (int16_t)iconX, (int16_t)iconY, (int16_t)iconW, (int16_t)iconH };
  g_viewCodeSdBtnRect = { (int16_t)((LCD_W - saveW) / 2), (int16_t)saveY, (int16_t)saveW, (int16_t)saveH };

  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);

  if (sdSavedFilename) {
    const uint8_t msgTs = 2;
    const int charW = 6 * (int)msgTs;
    const int lineH = 8 * (int)msgTs;
    const int gap = 10;
    gfx->setTextSize(msgTs);
    gfx->setTextColor(UI_SUCCESS);
    const char* line1 = "Backup saved as:";
    int w1 = (int)strlen(line1) * charW;
    int w2 = (int)strlen(sdSavedFilename) * charW;
    int totalH = lineH + gap + lineH;
    int y1 = (LCD_H - totalH) / 2;
    int y2 = y1 + lineH + gap;
    gfx->setCursor((LCD_W - w1) / 2, y1);
    gfx->print(line1);
    gfx->setCursor((LCD_W - w2) / 2, y2);
    gfx->print(sdSavedFilename);
  } else if (g_msg[0]) {
    gfx->setTextSize(2);
    if (strstr(g_msg, "Failed") || strstr(g_msg, "No backup"))
      gfx->setTextColor(UI_WARN);
    else
      gfx->setTextColor(RGB565_AMBER);
    const int cw = 12;
    gfx->setCursor((LCD_W - (int)strlen(g_msg) * cw) / 2, LCD_H / 2 - 8);
    gfx->print(g_msg);
  }

  drawViewCodeQRIcon(iconX, iconY, iconW, iconH);

  if (sd_ready()) {
    drawBtn(g_viewCodeSdBtnRect, "Save to SD", uiSaveButtonFill565(), 2);
  }

  ui_flush();
}

