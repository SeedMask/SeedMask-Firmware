      draw();
      return;
    }
  }
  uint8_t start = g_toolsVerifyMsListScroll;
  uint8_t end = min((uint16_t)(start + MULTISIG_RECEIVE_VISIBLE_ROWS), (uint16_t)n);
  for (uint8_t i = start; i < end; i++) {
    Rect r = { 10, (int16_t)(MULTISIG_RECEIVE_LIST_TOP + (int16_t)(i - start) * MULTISIG_SETTINGS_ROW_H), 300,
               MULTISIG_SETTINGS_ROW_H };
    if (hit(r, x, y)) {
      tools_verify_begin_multisig_scan(g_toolsVerifyMsCands[i]);
      return;
    }
  }
}

