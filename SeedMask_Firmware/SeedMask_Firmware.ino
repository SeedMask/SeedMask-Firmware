// Call only while prefs namespace "seedmask" is already open (e.g. setup()).
// Returns true if legacy keys were migrated — caller should multisig_save_all_prefs() after prefs.end().
static bool multisig_load_from_prefs_boot() {
  uint8_t n = prefs.getUChar("msig_cnt", 255);
  bool migratedLegacy = false;
  if (n == 255) {
    if (prefs.getBool("msig_ok", false)) {
      String msn = prefs.getString("msig_name", "");
      String msp = prefs.getString("msig_payload", "");
      strncpy(g_multisigWalletNames[0], msn.c_str(), sizeof(g_multisigWalletNames[0]) - 1);
      g_multisigWalletNames[0][sizeof(g_multisigWalletNames[0]) - 1] = 0;
      strncpy(g_multisigWalletPayloads[0], msp.c_str(), sizeof(g_multisigWalletPayloads[0]) - 1);
      g_multisigWalletPayloads[0][sizeof(g_multisigWalletPayloads[0]) - 1] = 0;
      g_multisigWalletContextTag[0] = MULTISIG_CTX_TAG_UNKNOWN;
      g_multisigWalletBtcAccount[0] = MULTISIG_ACCOUNT_LEGACY_ANY;
      g_multisigWalletCount = 1;
      prefs.remove("msig_ok");
      prefs.remove("msig_name");
      prefs.remove("msig_payload");
      migratedLegacy = true;
    } else {
      g_multisigWalletCount = 0;
    }
  } else {
    g_multisigWalletCount = n;
    if (g_multisigWalletCount > MULTISIG_MAX_STORED_WALLETS) g_multisigWalletCount = MULTISIG_MAX_STORED_WALLETS;
    for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
      char knm[16], kpl[16];
      snprintf(knm, sizeof(knm), "msig_%u_nm", (unsigned)i);
      snprintf(kpl, sizeof(kpl), "msig_%u_pl", (unsigned)i);
      String msn = prefs.getString(knm, "");
      String msp = prefs.getString(kpl, "");
      strncpy(g_multisigWalletNames[i], msn.c_str(), sizeof(g_multisigWalletNames[i]) - 1);
      g_multisigWalletNames[i][sizeof(g_multisigWalletNames[i]) - 1] = 0;
      strncpy(g_multisigWalletPayloads[i], msp.c_str(), sizeof(g_multisigWalletPayloads[i]) - 1);
      g_multisigWalletPayloads[i][sizeof(g_multisigWalletPayloads[i]) - 1] = 0;
      {
        char kctx[20], kac[20];
        snprintf(kctx, sizeof(kctx), "msig_%u_ctx", (unsigned)i);
        snprintf(kac, sizeof(kac), "msig_%u_ac", (unsigned)i);
        g_multisigWalletContextTag[i] = prefs.getULong(kctx, MULTISIG_CTX_TAG_UNKNOWN);
        g_multisigWalletBtcAccount[i] = prefs.getULong(kac, MULTISIG_ACCOUNT_LEGACY_ANY);
      }
    }
  }
  g_multisigPolicyPayload[0] = 0;
  multisig_invalidate_visible_list();
  return migratedLegacy;
}
static void multisig_delete_wallet(uint8_t idx) {
  if (idx >= g_multisigWalletCount) return;
  multisig_invalidate_visible_list();
  for (uint8_t i = idx; i + 1 < g_multisigWalletCount; i++) {
    memcpy(g_multisigWalletNames[i], g_multisigWalletNames[i + 1], sizeof(g_multisigWalletNames[0]));
    memcpy(g_multisigWalletPayloads[i], g_multisigWalletPayloads[i + 1], sizeof(g_multisigWalletPayloads[0]));
    g_multisigWalletContextTag[i] = g_multisigWalletContextTag[i + 1];
    g_multisigWalletBtcAccount[i] = g_multisigWalletBtcAccount[i + 1];
  }
  g_multisigWalletCount--;
  memset(g_multisigWalletNames[g_multisigWalletCount], 0, sizeof(g_multisigWalletNames[0]));
  memset(g_multisigWalletPayloads[g_multisigWalletCount], 0, sizeof(g_multisigWalletPayloads[0]));
  multisig_clamp_settings_scroll();
  multisig_save_all_prefs();
}

static void multisig_capture_state_for_temp_session() {
  g_multisigWalletCountSnapshotForTemp = g_multisigWalletCount;
  for (uint8_t i = 0; i < MULTISIG_MAX_STORED_WALLETS; i++) {
    memcpy(g_multisigWalletNamesSnapshotForTemp[i], g_multisigWalletNames[i], sizeof(g_multisigWalletNames[0]));
    memcpy(g_multisigWalletPayloadsSnapshotForTemp[i], g_multisigWalletPayloads[i], sizeof(g_multisigWalletPayloads[0]));
    g_multisigWalletContextTagSnapshotForTemp[i] = g_multisigWalletContextTag[i];
    g_multisigWalletBtcAccountSnapshotForTemp[i] = g_multisigWalletBtcAccount[i];
  }
  g_multisigSnapshotForTempValid = true;
}
static void multisig_restore_state_after_temp_session() {
  if (!g_multisigSnapshotForTempValid) return;
  multisig_invalidate_visible_list();
  g_multisigWalletCount = g_multisigWalletCountSnapshotForTemp;
  for (uint8_t i = 0; i < MULTISIG_MAX_STORED_WALLETS; i++) {
    memcpy(g_multisigWalletNames[i], g_multisigWalletNamesSnapshotForTemp[i], sizeof(g_multisigWalletNames[0]));
    memcpy(g_multisigWalletPayloads[i], g_multisigWalletPayloadsSnapshotForTemp[i], sizeof(g_multisigWalletPayloads[0]));
    g_multisigWalletContextTag[i] = g_multisigWalletContextTagSnapshotForTemp[i];
    g_multisigWalletBtcAccount[i] = g_multisigWalletBtcAccountSnapshotForTemp[i];
  }
  if (g_multisigWalletCount == 0) {
    g_multisigSelectedIdx = 0;
  } else if (g_multisigSelectedIdx >= g_multisigWalletCount) {
    g_multisigSelectedIdx = (uint8_t)(g_multisigWalletCount - 1);
  }
  multisig_clamp_settings_scroll();
  multisig_save_all_prefs();
  g_multisigSnapshotForTempValid = false;
}

static bool multisig_export_selected_wallet_to_sd(char* outPath, size_t outPathCap) {
  if (g_multisigSelectedIdx >= g_multisigWalletCount) return false;
  {
    uint32_t cur = MULTISIG_CTX_TAG_UNKNOWN;
    if (!current_master_xfp_u32(&cur)) return false;
    if (g_multisigWalletContextTag[g_multisigSelectedIdx] != cur) return false;
  }
  if (!sd_ready()) {
    setMsg("Insert microSD");
    return false;
  }
  if (mkdir("/sdcard/seedmask", 0777) != 0) {
    struct stat st;
    if (stat("/sdcard/seedmask", &st) != 0 || !S_ISDIR(st.st_mode)) {
      setMsg("Cannot create data folder");
      return false;
    }
  }
  char safe[40];
  size_t sn = 0;
  const char* src = g_multisigWalletNames[g_multisigSelectedIdx];
  for (size_t i = 0; src && src[i] && sn + 1 < sizeof(safe); i++) {
    char c = src[i];
    bool ok = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '-';
    safe[sn++] = ok ? c : '_';
  }
  safe[sn] = 0;
  if (!safe[0]) snprintf(safe, sizeof(safe), "wallet");
  char path[160];
  snprintf(path, sizeof(path), "/sdcard/seedmask/msig_%u_%s.txt", (unsigned)(g_multisigSelectedIdx + 1), safe);
  FILE* f = fopen(path, "wb");
  if (!f) {
    setMsg("Cannot write file");
    return false;
  }
  const char* payload = g_multisigWalletPayloads[g_multisigSelectedIdx];
  size_t len = strlen(payload);
  size_t wr = fwrite(payload, 1, len, f);
  fclose(f);
  if (wr != len) {
    setMsg("Write failed");
    return false;
  }
  if (outPath && outPathCap > 0) {
    snprintf(outPath, outPathCap, "%s", path);
  }
  return true;
}
