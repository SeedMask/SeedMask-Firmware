  }
  if (hit(RECT_TOP_TITLE, x, y)) {
    g_pinSetupPhase = 0;
    g_pinFirstEntry[0] = 0;
    g_pinSetupIsChanging = false;
    g_pinSetupSwitchToPassword = false;
    clearPassword(g_password1);
    setMsg("");
    show(g_onboardLockFlow ? UIScreen::CREATE_LOCK_TYPE : UIScreen::SECURITY_LOCK_TYPE);
    return;
  }

  const int nh = pin_entry_numpad_hit(x, y, PIN_ENTRY_NUMPAD_Y0, PIN_ENTRY_KEY_H);
  if (nh < 0) return;
  pin_entry_numpad_rect_for_index(nh, PIN_ENTRY_NUMPAD_Y0, PIN_ENTRY_KEY_H, &g_pinNumpadFlashRect);
  g_pinNumpadFlashUntilMs = millis() + 160;

  if (nh == 11) {
    if (strlen(g_password1) != 6) {
      setMsg("Enter 6 digits");
      draw();
      return;
    }
    for (int i = 0; i < 6; i++) {
      if (g_password1[i] < '0' || g_password1[i] > '9') {
        setMsg("Digits only");
        draw();
        return;
      }
    }
    if (g_pinSetupSwitchToPassword) {
      char mpwTest[128];
      if (!screen_lock_pin_unwrap(g_password1, mpwTest, sizeof(mpwTest))) {
        secure_memzero(mpwTest, sizeof(mpwTest));
        setMsg("Wrong PIN");
        clearPassword(g_password1);
        draw();
        return;
      }
      secure_memzero(mpwTest, sizeof(mpwTest));
      clearPassword(g_password1);
      g_pinSetupSwitchToPassword = false;
      g_pinSetupPhase = 0;
      g_pinFirstEntry[0] = 0;
      g_secLockPwReauthPending = false;
      g_secLockPwSetupMoreOpen = false;
      g_secLockPwSetupPhase = 0;
      g_screenLockPwFirst[0] = 0;
      g_pwMasked = true;
      setMsg("8+ characters");
      show(UIScreen::SECURITY_LOCK_PW_SETUP);
      return;
    }
    if (g_pinSetupIsChanging) {
      if (g_pinSetupPhase == 0) {
        char mpwTest[128];
        if (!screen_lock_pin_unwrap(g_password1, mpwTest, sizeof(mpwTest))) {
          secure_memzero(mpwTest, sizeof(mpwTest));
          setMsg("Wrong PIN");
          clearPassword(g_password1);
          draw();
          return;
        }
        secure_memzero(mpwTest, sizeof(mpwTest));
        clearPassword(g_password1);
        setMsg("");
        g_pinSetupPhase = 1;
        draw();
        return;
      }
      if (g_pinSetupPhase == 1) {
        strncpy(g_pinFirstEntry, g_password1, sizeof(g_pinFirstEntry) - 1);
        g_pinFirstEntry[sizeof(g_pinFirstEntry) - 1] = 0;
        clearPassword(g_password1);
        setMsg("");
        g_pinSetupPhase = 2;
        draw();
        return;
      }
      if (strcmp(g_password1, g_pinFirstEntry) != 0) {
        setMsg("PINs do not match");
        g_pinSetupPhase = 1;
        g_pinFirstEntry[0] = 0;
        clearPassword(g_password1);
        draw();
        return;
      }
      if (!screen_lock_pin_wrap_and_save(g_pinFirstEntry)) {
        setMsg("Could not save PIN");
        draw();
        return;
      }
      duress_clear_incompatible_with_screen_lock();
      g_pinSetupIsChanging = false;
      g_pinSetupPhase = 0;
      g_pinFirstEntry[0] = 0;
      clearPassword(g_password1);
      setMsg("Screen lock: PIN");
      show(UIScreen::SECURITY_LOCK_TYPE);
      return;
    }
    if (g_pinSetupPhase == 0) {
      strncpy(g_pinFirstEntry, g_password1, sizeof(g_pinFirstEntry) - 1);
      g_pinFirstEntry[sizeof(g_pinFirstEntry) - 1] = 0;
      clearPassword(g_password1);
      setMsg("");
      g_pinSetupPhase = 1;
      draw();
      return;
    }
    if (strcmp(g_password1, g_pinFirstEntry) != 0) {
      setMsg("PINs do not match");
      g_pinSetupPhase = 0;
      g_pinFirstEntry[0] = 0;
      clearPassword(g_password1);
      draw();
      return;
    }
    if (g_onboardLockFlow) {
      strncpy(g_onboardLockCred, g_pinFirstEntry, sizeof(g_onboardLockCred) - 1);
      g_onboardLockCred[sizeof(g_onboardLockCred) - 1] = 0;
      g_onboardLockIsPin = true;
      if (g_onboardLockAfterCreate) {
        setMsg("Saving...");
        draw();
        if (!onboard_ensure_create_vault_from_seedgen()) {
          if (!g_msg[0] || strcmp(g_msg, "Saving...") == 0) setMsg("Vault save failed");
          show(UIScreen::CREATE_LOCK_TYPE);
          return;
        }
      } else if (!g_masterPw[0]) {
        setMsg("Saving...");
        draw();
        if (!onboard_ensure_restore_vault_from_session_seed()) {
          if (!g_msg[0] || strcmp(g_msg, "Saving...") == 0) setMsg("Vault save failed");
          show(UIScreen::CREATE_LOCK_TYPE);
          return;
        }
      }
      if (!screen_lock_pin_wrap_and_save(g_onboardLockCred)) {
        setMsg("Could not save PIN");
        draw();
        return;
      }
      duress_clear_incompatible_with_screen_lock();
      onboard_finish_lock_setup_success();
      return;
    }
    if (!screen_lock_pin_wrap_and_save(g_pinFirstEntry)) {
      setMsg("Could not save PIN");
      draw();
      return;
    }
    duress_clear_incompatible_with_screen_lock();
    g_pinSetupPhase = 0;
    g_pinFirstEntry[0] = 0;
    clearPassword(g_password1);
    setMsg("Screen lock: PIN");
    show(UIScreen::SECURITY_LOCK_TYPE);
    return;
  }
  if (nh == 10) {
    setMsg("");
    backspaceStr(g_password1, sizeof(g_password1));
    draw();
    return;
  }
  if (nh >= 0 && nh <= 8 && strlen(g_password1) < 6) {
    setMsg("");
    appendChar(g_password1, sizeof(g_password1), (char)('1' + nh));
    draw();
    return;
  }
  if (nh == 9 && strlen(g_password1) < 6) {
    setMsg("");
    appendChar(g_password1, sizeof(g_password1), '0');
    draw();
  }
}

static void handlePwNotesTap(uint16_t x, uint16_t y) {
  // Handle ADD button when no passwords exist
  if (nav_bar_home_tap_hit((int16_t)x, (int16_t)y)) return;

  if (g_sdSavePathPickOpen) {
    handleSdSavePathPickerTap(x, y);
    return;
  }

  if (g_editMode != EditMode::NONE) {
    handleEditorTap(x, y);
    return;
  }

  if (hit(BTN_TOP_BURGER, x, y)) {
    show(UIScreen::MENU);
    return;
  }

  // Master password Show popup (PASSWORDS): keyboard OK = verify and unmask or "Wrong password"; Cancel = close; else = keyboard
  if (g_screen == UIScreen::PASSWORDS && g_showMasterPwShowPopup) {
    const int popupW = 260;
    const int popupX = (LCD_W - popupW) / 2, popupY = 80;
    Rect rCancel = { (int16_t)(popupX + 80), (int16_t)(popupY + 100), 100, 44 };
    if (hitOkKey(x, y)) {
      if (strlen(g_password1) < 1) {
        draw();
        return;
      }
      if (strcmp(g_password1, g_masterPw) == 0) {
        clearPassword(g_password1);
        setMsg("");
        g_showMasterPwShowPopup = false;
        if (g_pwOpenAfterMaster && g_pwOpenAfterMasterIndex < pwSvc_getCount()) {
          // Open password editor, but keep the list masked.
          uint8_t i = g_pwOpenAfterMasterIndex;
          g_pwOpenAfterMaster = false;
          g_prevScreen = UIScreen::PASSWORDS;
          g_editingTitle = false;
          g_editMaxLen = EDIT_BUF_MAX - 1;
          g_viewPwIndex = i;
          splitPasswordTitleMeta(pwSvc_getTitleCStr(i), g_tmpTitle, sizeof(g_tmpTitle), g_tmpUser, sizeof(g_tmpUser),
                                 g_tmpWebsite, sizeof(g_tmpWebsite), g_tmpPwNotes, sizeof(g_tmpPwNotes));
          g_addPwCursorName = (uint16_t)strlen(g_tmpTitle);
          g_addPwCursorUser = (uint16_t)strlen(g_tmpUser);
          g_addPwCursorSite = (uint16_t)strlen(g_tmpWebsite);
          g_addPwCursorNotes = (uint16_t)strlen(g_tmpPwNotes);
          g_addPwViewName = (g_addPwCursorName > 20) ? (uint16_t)(g_addPwCursorName - 20) : 0;
          g_addPwViewUser = (g_addPwCursorUser > 20) ? (uint16_t)(g_addPwCursorUser - 20) : 0;
          g_addPwViewSite = (g_addPwCursorSite > 20) ? (uint16_t)(g_addPwCursorSite - 20) : 0;
          g_addPwViewNotes = (g_addPwCursorNotes > 20) ? (uint16_t)(g_addPwCursorNotes - 20) : 0;
          edit_set(pwSvc_getValueCStr(i));
          pwEditInitTmpValueFromVault();
          g_editMode = EditMode::EDIT_PW_VALUE;
          {
            uint8_t pmRaw = (uint8_t)PwGenMode::DICEWARE;
            uint32_t bi = 0;
            uint8_t bw = 12;
            uint8_t bot = (uint8_t)Bip85PwOutType::RANDOM;
            uint8_t brt = (uint8_t)Bip85PwRandTier::STRONG;
            uint8_t bdw = 4;
            if (pw_gen_meta_get_for_title(pwSvc_getTitleCStr(i), &pmRaw, &bi, &bw, &bot, &brt, &bdw)) {
              g_pwGenMode = (PwGenMode)pmRaw;
              if (g_pwGenMode == PwGenMode::BIP85) {
                g_pwBip85Index = bi;
                g_pwBip85WordCount = (bw == 24) ? 24 : 12;
                snprintf(g_pwBip85IndexBuf, sizeof(g_pwBip85IndexBuf), "%lu", (unsigned long)g_pwBip85Index);
                if (bot <= (uint8_t)Bip85PwOutType::PW_HEX) g_pwBip85OutType = (Bip85PwOutType)bot;
                if (brt <= (uint8_t)Bip85PwRandTier::COMPLEX) g_pwBip85RandTier = (Bip85PwRandTier)brt;
                if (bdw >= 4 && bdw <= 10) g_pwBip85DwWords = bdw;
              } else {
                g_pwBip85Index = 0;
                g_pwBip85WordCount = 12;
                g_pwBip85IndexBuf[0] = 0;
              }
            } else {
              g_pwGenMode = PwGenMode::DICEWARE;
              g_pwBip85Index = 0;
              g_pwBip85WordCount = 12;
              g_pwBip85IndexBuf[0] = 0;
            }
            g_pwBip85IndexEditing = false;
          }
          pwEditCaptureOriginalSnapshot();
          g_pwEditKeyboardVisible = false;
          g_pwEditUnlocked = false;
          g_pwEditFocusField = 0;
          g_pwGenerateConfirmShownThisSession = false;
          setMsg("");
          show(UIScreen::EDITOR);
        } else {
          g_pwListMasked = false;
          draw();
        }
      } else {
        setMsg("Wrong password");
        clearPassword(g_password1);
        draw();
      }
      return;
    }
    if (hit(rCancel, x, y) || hit(BTN_LIST_BACK, x, y)) {
      clearPassword(g_password1);
      setMsg("");
      g_showMasterPwShowPopup = false;
      g_pwOpenAfterMaster = false;
      draw();
      return;
    }
    passwordInputTap(x, y, g_password1, sizeof(g_password1));
    return;
  }

  // Delete confirmation overlay: Yes -> delete selected and exit edit; Cancel -> close dialog
  if (g_showDeleteConfirm) {
    if (hit(BTN_DELETE_YES, x, y)) {
      if (g_deleteConfirmForPw) {
        pwSvc_removeSelectedEntries();
      } else {
        uint8_t n = 0;
        for (uint8_t i = 0; i < g_noteCount; i++) {
          if (!g_noteSelected[i]) {
            if (n != i) { memcpy(&g_noteItems[n], &g_noteItems[i], sizeof(NoteItem)); }
            n++;
          }
        }
        g_noteCount = n;
      }
      g_vaultQrDirty = true;
      if (sd_ready() && g_masterPw[0]) pw_vault_save_to_sd(g_masterPw);
      save_passwords_notes_to_nvs();
      g_showDeleteConfirm = false;
      g_pwListEditMode = false;
      g_noteListEditMode = false;
      pwSvc_clearSelection();
      memset(g_noteSelected, 0, sizeof(g_noteSelected));
      draw();
      return;
    }
    if (hit(BTN_DELETE_CANCEL, x, y)) {
      g_showDeleteConfirm = false;
      draw();
      return;
    }
    return;
  }

  if (g_screen == UIScreen::PASSWORDS && g_showPwListViewPopup) {
    const int popupW = 230, popupH = 122;
    const int popupX = (LCD_W - popupW) / 2, popupY = 112;
    Rect rGrid = { (int16_t)(popupX + 10), (int16_t)(popupY + 36), (int16_t)(popupW - 20), 32 };
    Rect rDetailed = { (int16_t)(popupX + 10), (int16_t)(popupY + 74), (int16_t)(popupW - 20), 32 };
    Rect popupR = { (int16_t)popupX, (int16_t)popupY, (int16_t)popupW, (int16_t)popupH };
    if (hit(rGrid, x, y)) {
      g_pwListDetailedView = false;
      g_showSendPopup = false;
      g_pwListScroll = gridAlignStart(g_pwListScroll, PW_GRID_COLS);
      g_showPwListViewPopup = false;
      draw();
      return;
    }
    if (hit(rDetailed, x, y)) {
      g_pwListDetailedView = true;
      g_showSendPopup = false;
      int maxStart = (int)pwSvc_getCount() - PW_DETAIL_VISIBLE_ROWS;
      if (maxStart < 0) maxStart = 0;
      if ((int)g_pwListScroll > maxStart) g_pwListScroll = (uint8_t)maxStart;
      g_showPwListViewPopup = false;
      draw();
      return;
    }
    if (!hit(popupR, x, y)) {
      g_showPwListViewPopup = false;
      draw();
      return;
    }
    return;
  }

  // Long-press Send: tap "Send" → confirm; any other tap closes
  if (g_screen == UIScreen::PASSWORDS && g_showSendPopup && g_sendPopupPwIndex < pwSvc_getCount()) {
    if (pwSendButtonHit((int16_t)x, (int16_t)y)) {
      g_showSendPopup = false;
      g_sendConfirmPwIndex = g_sendPopupPwIndex;
      if (g_pwListMasked) {
        clearPassword(g_password1);
        setMsg("Enter master password to send");
        show(UIScreen::CONFIRM_MASTER_SEND);
      } else {
        g_showSendConfirm = true;
        draw();
      }
      return;
    }
    g_showSendPopup = false;
    draw();
    return;
  }

  // Send password confirm popup (PASSWORDS screen): Yes = send, Cancel = close
  // Exact logic from Arduino2/Send works SeedMask Firmware.ino
  if (g_screen == UIScreen::PASSWORDS && g_showSendConfirm && g_sendConfirmPwIndex < pwSvc_getCount()) {
    const int popupW = 260, popupH = 140;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    Rect rYes = { (int16_t)(popupX + 20), (int16_t)(popupY + 82), 100, 44 };
    Rect rCancel = { (int16_t)(popupX + 140), (int16_t)(popupY + 82), 100, 44 };
    if (hit(rYes, x, y)) {
      g_showSendConfirm = false;
#if SEEDMASK_NOTE_SEND_UI
      if (pwSendDisabled()) {
        setMsgTr("Sending is disabled", "Slanje je iskljuceno");
        draw();
        return;
      }
      const bool dongleOnly = pwSendPreferDongleOnly();
#else
      const bool dongleOnly = false;
#endif
      bool sentAcc = false;
#if SEEDMASK_ACCESSORY_LINK_AVAILABLE
      if (dongleOnly) {
        PwItem sendItem;
        sendItem.value[0] = 0;
        if (pwSvc_getAt(g_sendConfirmPwIndex, &sendItem) && sendItem.value[0]) {
          sentAcc = seedmaskAccessorySend(SP_LINK_PASSWORD, (const uint8_t*)sendItem.value, strlen(sendItem.value));
        }
      }
#endif
      bool sentHid = false;
#if SEEDMASK_USB_HID_KEYBOARD
      // USB Sending mode: type to host. Do NOT draw() before typing — CDC+HID stall on ESP32-S3.
      if (!dongleOnly && hidHostTypingEnabled()) {
        PwItem sendItem;
        sendItem.value[0] = 0;
        if (pwSvc_getAt(g_sendConfirmPwIndex, &sendItem) && sendItem.value[0]) {
          sentHid = hidTypeAsciiString(sendItem.value) > 0;
        }
      }
#endif
      if (sentAcc && sentHid) {
        setMsgTr("Sent (dongle + USB)", "Poslato (dongle + USB)");
      } else if (sentAcc && dongleOnly) {
        setMsgTr("Sent to dongle", "Poslato na dongle");
      } else if (sentAcc) {
        setMsgTr("Sent to LCD", "Poslato na LCD");
      } else if (sentHid) {
        setMsgTr("Sent", "Poslato");
      } else {
#if SEEDMASK_USB_HID_KEYBOARD
        if (dongleOnly) {
          setMsgTr("Nothing sent", "Nista nije poslato");
        } else if (!hidHostTypingEnabled()) {
          setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
        } else
#endif
        {
#if SEEDMASK_ACCESSORY_LINK_AVAILABLE
          setMsgTr("Nothing sent", "Nista nije poslato");
#else
          setMsgTr("USB HID send unavailable on this board", "USB HID nedostupan");
#endif
        }
      }
      draw();
      return;
    }
    if (hit(rCancel, x, y)) {
      g_showSendConfirm = false;
      draw();
      return;
    }
    // No BACK button here; tap outside popup or use swipe/menu navigation
    g_showSendConfirm = false;
    draw();
    return;
  }

#if SEEDMASK_NOTE_SEND_UI
  // Long-press Note Send: tap "Send" to show confirm; any other tap closes it (full row height hit area)
  if (g_screen == UIScreen::NOTES && g_showNoteSendPopup && g_noteSendPopupIndex < g_noteCount) {
    if (noteSendButtonHitForIndex(g_noteSendPopupIndex, (int16_t)x, (int16_t)y)) {
      g_showNoteSendPopup = false;
      g_showNoteSendConfirm = true;
      g_noteSendConfirmIndex = g_noteSendPopupIndex;
      draw();
      return;
    }
    g_showNoteSendPopup = false;
    draw();
    return;
  }
#endif

  // Password title popup: tap anywhere to close
  if (g_screen == UIScreen::PASSWORDS && g_showPwTitlePopup) {
    g_showPwTitlePopup = false;
    draw();
    return;
  }
  // Note title popup: tap anywhere to close
  if (g_screen == UIScreen::NOTES && g_showNoteTitlePopup) {
    g_showNoteTitlePopup = false;
    draw();
    return;
  }

#if SEEDMASK_NOTE_SEND_UI
  // Send note confirm popup (NOTES screen): Yes = type body to keyboard / LCD, Cancel = close
  if (g_screen == UIScreen::NOTES && g_showNoteSendConfirm && g_noteSendConfirmIndex < g_noteCount) {
    const int popupW = 260, popupH = 140;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    Rect rYes = { (int16_t)(popupX + 20), (int16_t)(popupY + 82), 100, 44 };
    Rect rCancel = { (int16_t)(popupX + 140), (int16_t)(popupY + 82), 100, 44 };
    if (hit(rYes, x, y)) {
      g_showNoteSendConfirm = false;
#if SEEDMASK_NOTE_SEND_UI
      if (pwSendDisabled()) {
        setMsgTr("Sending is disabled", "Slanje je iskljuceno");
        draw();
        return;
      }
      const bool dongleOnly = pwSendPreferDongleOnly();
#else
      const bool dongleOnly = false;
#endif
      const char* body = g_noteItems[g_noteSendConfirmIndex].body;
      size_t bodyLen = strlen(body);
      bool sentAcc = false;
#if SEEDMASK_ACCESSORY_LINK_AVAILABLE
      if (dongleOnly) {
        size_t sendLen = bodyLen > SP_LINK_MAX_PAYLOAD ? SP_LINK_MAX_PAYLOAD : bodyLen;
        sentAcc = sendLen > 0 && seedmaskAccessorySend(SP_LINK_NOTE, (const uint8_t*)body, sendLen);
      }
#endif
      bool sentHid = false;
#if SEEDMASK_USB_HID_KEYBOARD
      if (!dongleOnly && hidHostTypingEnabled()) {
        sentHid = hidTypeAsciiString(body) > 0;
      }
#endif
      if (sentAcc && sentHid) {
        setMsgTr("Sent (LCD + USB)", "Poslato (LCD + USB)");
      } else if (sentAcc) {
        setMsgTr("Sent to LCD", "Poslato na LCD");
      } else if (sentHid) {
        setMsgTr("Sent", "Poslato");
      } else {
#if SEEDMASK_USB_HID_KEYBOARD
        if (dongleOnly) {
          setMsgTr("Nothing sent", "Nista nije poslato");
        } else if (!hidHostTypingEnabled()) {
          setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
        } else
#endif
        {
#if SEEDMASK_ACCESSORY_LINK_AVAILABLE
          setMsgTr("Nothing sent", "Nista nije poslato");
#else
          setMsgTr("USB HID typing unavailable", "USB tipkanje nedostupno");
#endif
        }
      }
      draw();
      return;
    }
    if (hit(rCancel, x, y)) {
      g_showNoteSendConfirm = false;
      draw();
      return;
    }
    g_showNoteSendConfirm = false;
    draw();
    return;
  }
#endif

  // Check SD icon click first (only when not in edit mode)
  if (!g_pwListEditMode && !g_noteListEditMode && sd_presence_for_ui()
      && hit(BTN_TOPBAR_SD, x, y)) {
    show(UIScreen::SD_BROWSER);
    return;
  }

  // Passwords list: edit mode -> toggle selection or Delete/Done (grid cards)
  if (g_screen == UIScreen::PASSWORDS && g_pwListEditMode) {
    uint8_t idx = 0xFF;
    if (pwIndexFromTap((int16_t)x, (int16_t)y, idx) && idx < pwSvc_getCount()) {
      pwSvc_toggleSelected(idx);
      draw();
      return;
    }
    if (hit(BTN_LIST_DELETE_SEL, x, y)) {
      g_showDeleteConfirm = true;
      g_deleteConfirmForPw = true;
      draw();
      return;
    }
    if (hit(BTN_LIST_DONE_SEL, x, y)) {
      g_pwListEditMode = false;
      pwSvc_clearSelection();
      draw();
      return;
    }
    return;
  }

  // Notes list: edit mode -> toggle selection or Delete/Done
  if (g_screen == UIScreen::NOTES && g_noteListEditMode) {
    const int rowContentW = 268;
    const int cbW = 20, cbH = 20;
    const int cbX = 10 + rowContentW - (cbW + 12);
    for (int vi = 0; vi < LIST_MAX_VISIBLE; vi++) {
      uint8_t i = g_noteListScroll + (uint8_t)vi;
      if (i >= g_noteCount) break;
      int rowY = LIST_AREA_TOP + vi * LIST_ROW_H;
      Rect noteRow = { 10, (int16_t)rowY, rowContentW, (int16_t)LIST_ROW_H };
      Rect cb = { (int16_t)cbX, (int16_t)(rowY + 10), (int16_t)cbW, (int16_t)cbH };
      if (hit(cb, x, y) || hit(noteRow, x, y)) {
        g_noteSelected[i] = !g_noteSelected[i];
        draw();
        return;
      }
    }
    if (hit(BTN_LIST_DELETE_SEL, x, y)) {
      g_showDeleteConfirm = true;
      g_deleteConfirmForPw = false;
      draw();
      return;
    }
    if (hit(BTN_LIST_DONE_SEL, x, y)) {
      g_noteListEditMode = false;
      memset(g_noteSelected, 0, sizeof(g_noteSelected));
      draw();
      return;
    }
    return;
  }

  // Enter edit mode: Edit button (only when list not empty)
  if (g_screen == UIScreen::PASSWORDS && pwSvc_getCount() > 0 && hit(BTN_PW_LIST_EDIT, x, y)) {
    g_pwListEditMode = true;
    g_showPwListViewPopup = false;
    pwSvc_clearSelection();
    draw();
    return;
  }
  if (g_screen == UIScreen::PASSWORDS && !g_pwListEditMode && !g_showSendPopup && pwSvc_getCount() > 0 && hit(BTN_PW_LIST_VIEW, x, y)) {
    g_showPwListViewPopup = !g_showPwListViewPopup;
    draw();
    return;
  }
  if (g_screen == UIScreen::NOTES && g_noteCount > 0 && hit(BTN_LIST_EDIT, x, y)) {
    g_noteListEditMode = true;
    memset(g_noteSelected, 0, sizeof(g_noteSelected));
    draw();
    return;
  }

  // Passwords list: tap card to edit (normal mode); Send is via long-press popup
  if (g_screen == UIScreen::PASSWORDS && !g_pwListEditMode && pwSvc_getCount() > 0) {
    uint8_t i = 0xFF;
    if (pwIndexFromTap((int16_t)x, (int16_t)y, i) && i < pwSvc_getCount()) {
      g_prevScreen = UIScreen::PASSWORDS;
      g_editingTitle = false;
      g_editMaxLen = EDIT_BUF_MAX - 1;
      g_viewPwIndex = i;
      splitPasswordTitleMeta(pwSvc_getTitleCStr(i), g_tmpTitle, sizeof(g_tmpTitle), g_tmpUser, sizeof(g_tmpUser),
                             g_tmpWebsite, sizeof(g_tmpWebsite), g_tmpPwNotes, sizeof(g_tmpPwNotes));
      g_addPwCursorName = (uint16_t)strlen(g_tmpTitle);
      g_addPwCursorUser = (uint16_t)strlen(g_tmpUser);
      g_addPwCursorSite = (uint16_t)strlen(g_tmpWebsite);
      g_addPwCursorNotes = (uint16_t)strlen(g_tmpPwNotes);
      g_addPwViewName = (g_addPwCursorName > 20) ? (uint16_t)(g_addPwCursorName - 20) : 0;
      g_addPwViewUser = (g_addPwCursorUser > 20) ? (uint16_t)(g_addPwCursorUser - 20) : 0;
      g_addPwViewSite = (g_addPwCursorSite > 20) ? (uint16_t)(g_addPwCursorSite - 20) : 0;
      g_addPwViewNotes = (g_addPwCursorNotes > 20) ? (uint16_t)(g_addPwCursorNotes - 20) : 0;
      edit_set(pwSvc_getValueCStr(i));
      pwEditInitTmpValueFromVault();
      g_editMode = EditMode::EDIT_PW_VALUE;
      {
        uint8_t pmRaw = (uint8_t)PwGenMode::DICEWARE;
        uint32_t bi = 0;
        uint8_t bw = 12;
        uint8_t bot = (uint8_t)Bip85PwOutType::RANDOM;
        uint8_t brt = (uint8_t)Bip85PwRandTier::STRONG;
        uint8_t bdw = 4;
        if (pw_gen_meta_get_for_title(pwSvc_getTitleCStr(i), &pmRaw, &bi, &bw, &bot, &brt, &bdw)) {
          g_pwGenMode = (PwGenMode)pmRaw;
          if (g_pwGenMode == PwGenMode::BIP85) {
            g_pwBip85Index = bi;
            g_pwBip85WordCount = (bw == 24) ? 24 : 12;
            snprintf(g_pwBip85IndexBuf, sizeof(g_pwBip85IndexBuf), "%lu", (unsigned long)g_pwBip85Index);
            if (bot <= (uint8_t)Bip85PwOutType::PW_HEX) g_pwBip85OutType = (Bip85PwOutType)bot;
            if (brt <= (uint8_t)Bip85PwRandTier::COMPLEX) g_pwBip85RandTier = (Bip85PwRandTier)brt;
            if (bdw >= 4 && bdw <= 10) g_pwBip85DwWords = bdw;
          } else {
            g_pwBip85Index = 0;
            g_pwBip85WordCount = 12;
            g_pwBip85IndexBuf[0] = 0;
          }
        } else {
          g_pwGenMode = PwGenMode::DICEWARE;
          g_pwBip85Index = 0;
          g_pwBip85WordCount = 12;
          g_pwBip85IndexBuf[0] = 0;
        }
        g_pwBip85IndexEditing = false;
      }
      pwEditCaptureOriginalSnapshot();
      g_pwEditKeyboardVisible = false;
      g_pwEditUnlocked = false;
      g_pwEditFocusField = 0;
      g_pwGenerateConfirmShownThisSession = false;
      setMsg("");
      show(UIScreen::EDITOR);
      return;
    }
  }

  // Notes list: tap on a note row to open for view/edit
  if (g_screen == UIScreen::NOTES && g_noteCount > 0) {
    uint8_t i = 0;
    if (noteIndexFromTap((int16_t)x, (int16_t)y, i)) {
      // Ensure swipe-back from editor returns to Notes (not whatever screen was previously shown).
      g_prevScreen = UIScreen::NOTES;
      g_editingTitle = false;
      g_editMaxLen = EDIT_BUF_MAX - 1;
      g_viewNoteIndex = i;
      memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
      strncpy(g_tmpTitle, g_noteItems[i].title, sizeof(g_tmpTitle) - 1);
      g_tmpTitle[sizeof(g_tmpTitle) - 1] = 0;
      edit_set(g_noteItems[i].body);
      g_editMode = EditMode::EDIT_NOTE_BODY;
      g_noteBodyEnteredAt = millis();
      g_noteScrollLine = 0;
      g_noteViewOffsetPx = 0;
      g_noteVisualCursorLine = 0;
      g_noteVisualCursorCol = 0;
      draw();
      return;
    }
  }

  if (hitBottomListAction(BTN_LIST_ADD, x, y) && !nav_bar_home_tap_hit((int16_t)x, (int16_t)y)) {
    if (pw_notes_tfa_prompt_vault_password_if_needed(g_screen)) return;

    // Passwords are only loaded when restoring from a backup (backup code, QR vault, or SD backup/vault).
    // We do NOT auto-load pw_v1.bin here — that would mix "whatever is on SD" with current seed and break deterministic restore.

    g_prevScreen = g_screen;

    edit_clear();
    clearPassword(g_password1);
    memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
    memset(g_tmpUser, 0, sizeof(g_tmpUser));
    memset(g_tmpWebsite, 0, sizeof(g_tmpWebsite));
    memset(g_tmpPwNotes, 0, sizeof(g_tmpPwNotes));
    g_addPwCursorName = g_addPwCursorUser = g_addPwCursorSite = g_addPwCursorNotes = 0;
    g_addPwViewName = g_addPwViewUser = g_addPwViewSite = g_addPwViewNotes = 0;

    g_kbMode = KBMode::LETTERS;
    g_shift = 0;

    if (g_screen == UIScreen::PASSWORDS)
      g_editMode = EditMode::ADD_PW_TITLE;
    else if (g_screen == UIScreen::NOTES)
      g_editMode = EditMode::ADD_NOTE_TITLE;

    // Field label is drawn in drawEditor() via hint= — do not use setMsg (shows on MENU toast).
    setMsg("");
    show(UIScreen::EDITOR);
    g_touchReleasedSinceTap = false;
    waitTouchRelease(250);  // consume ADD tap so it doesn't leak into editor controls/keyboard
    return;
  }

  // Check backup button (passwords screen, not in edit mode)
  if (g_screen == UIScreen::PASSWORDS && g_masterPw[0] && hitBottomListAction(BTN_LIST_BACKUP, x, y)
      && !nav_bar_home_tap_hit((int16_t)x, (int16_t)y)) {
    if (g_pwScreenSpf1BackupCode) {
      free(g_pwScreenSpf1BackupCode);
      g_pwScreenSpf1BackupCode = nullptr;
    }
    size_t spfLen = 0;
    if (!full_vault_spf1_backup_to_heap_string(&g_pwScreenSpf1BackupCode, &spfLen)) {
      (void)refresh_g_backup_code_from_nvs_vault_blob();
      setMsg("Full text backup too large; use QR or SD");
    } else {
      (void)refresh_g_backup_code_from_nvs_vault_blob();
      setMsg("");
    }
    show(UIScreen::CREATE_SHOW_CODE);
    return;
  }

  // No BACK button here; use swipe or MENU/HOME navigation
}

/** True if (x,y) is on Save to SD. Padding helps fat-finger taps; QR icon row below must never match here. */
static bool viewCodeHitSaveToSd(uint16_t x, uint16_t y) {
  if (hit(g_viewCodeQrBtnRect, x, y)) return false;
  const Rect& r = g_viewCodeSdBtnRect;
  const int16_t px = (int16_t)x, py = (int16_t)y;
  const int16_t padX = 28, padUp = 12, padDn = 24;
  return (px >= r.x - padX && px < r.x + r.w + padX && py >= r.y - padUp && py < r.y + r.h + padDn);
}

/** VIEW_CODE: true if (x,y) is on Save to SD and save was attempted. */
static bool viewCodeTrySaveToSdTap(uint16_t x, uint16_t y) {
  if (g_screen != UIScreen::VIEW_CODE || g_editMode != EditMode::NONE || !sd_ready()) return false;
  if (!viewCodeHitSaveToSd(x, y)) return false;
  if (!g_viewBackupCode[0]) {
    g_viewCodeSaveSuccessHideAtMs = 0;
    setMsg("No backup code yet");
    draw();
    return true;
  }
  uint8_t wc = 0;
  const char(*seedWords)[16] = active_crypto_seed_words(&wc);
  if (!backup_code_save_to_sd(g_viewBackupCode, g_masterPw, seedWords, wc)) {
    g_viewCodeSaveSuccessHideAtMs = 0;
    // Failure: backup_code_save_to_sd may leave g_msg empty — set a generic error.
    if (!g_msg[0]) setMsg("Failed to save to SD");
  } else {
    // Success: backup_code_save_to_sd already setMsg("Backup saved as: …"); show again on each save
    g_viewCodeSaveSuccessHideAtMs = millis() + 2000u;
  }
  draw();
  return true;
}

static void handleViewTap(uint16_t x, uint16_t y) {
  if (g_screen == UIScreen::VIEW_SEED) {
    if (g_viewSeedExportSheetOpen) {
      if (hit(BTN_VIEWSEED_EXPORT_COMPACT, x, y)) {
        flashViewSeedExportChoice(BTN_VIEWSEED_EXPORT_COMPACT, "Compact SeedQR");
        g_viewSeedQrKind = ViewSeedQrKind::COMPACT;
        show(UIScreen::VIEW_SEED_QR);
        return;
      }
      if (hit(BTN_VIEWSEED_EXPORT_STANDARD, x, y)) {
        flashViewSeedExportChoice(BTN_VIEWSEED_EXPORT_STANDARD, "SeedQR");
        g_viewSeedQrKind = ViewSeedQrKind::STANDARD;
        show(UIScreen::VIEW_SEED_QR);
        return;
      }
      if (hitViewSeedExportPlainText((int16_t)x, (int16_t)y)) {
        flashViewSeedExportChoice(BTN_VIEWSEED_EXPORT_PLAINTEXT, "Plain text");
        g_viewSeedQrKind = ViewSeedQrKind::PLAINTEXT;
        show(UIScreen::VIEW_SEED_QR);
        return;
      }
      if (hit(BTN_VIEWSEED_QR, x, y)) {
        g_viewSeedExportSheetOpen = false;
        draw();
        return;
      }
      if (hit(VIEWSEED_EXPORT_SHEET_PANEL, x, y)) return;
      g_viewSeedExportSheetOpen = false;
      draw();
      return;
    }
    if (hit(BTN_VIEWSEED_QR, x, y)) {
      g_viewSeedExportSheetOpen = true;
      draw();
      return;
    }
    return;
  }
  if (g_screen == UIScreen::VIEW_QR) {
    if (g_viewQrCustomActive) {
      if (hit(BTN_VIEWQR_BACK, x, y)) {
        UIScreen dst = g_viewQrCustomBackScreen;
        g_viewQrCustomActive = false;
        g_viewQrCustomPayload[0] = 0;
        show(dst);
        return;
      }
      if (hit(BTN_VIEWQR_DONE, x, y)) {
        UIScreen dst = g_viewQrCustomDoneScreen;
        g_viewQrCustomActive = false;
        g_viewQrCustomPayload[0] = 0;
        show(dst);
        return;
      }
    } else {
      if (hit(BTN_VIEWQR_BACK, x, y)) {
        show(UIScreen::VIEW_CODE);
        return;
      }
      if (hit(BTN_VIEWQR_DONE, x, y)) {
        show(UIScreen::SEED_SETTINGS);
        return;
      }
    }
    return;
  }
  if (g_screen == UIScreen::VIEW_SEED_QR) return;
  if (g_screen != UIScreen::VIEW_CODE) return;
  if (hit(g_viewCodeQrBtnRect, x, y)) {
    if (!g_viewBackupCode[0]) {
      setMsg("No backup code yet");
      draw();
      return;
    }
    g_viewQrCustomActive = false;
    show(UIScreen::VIEW_QR);
    return;
  }
  if (viewCodeTrySaveToSdTap(x, y)) return;
  return;
}

// =======================
// SD Browser Functions
// =======================
// basename may be Backup_<xfp>.bin / PW_<xfp>.bin or legacy backup_*.bin / pw_v*.bin
static bool sd_entry_is_backup_bin(const char* pathOrName) {
  if (!pathOrName) return false;
  const char* slash = strrchr(pathOrName, '/');
  const char* base = slash ? slash + 1 : pathOrName;
  return strncasecmp(base, "backup_", 7) == 0;
}

static bool sd_entry_is_pw_vault(const char* pathOrName) {
  if (!pathOrName) return false;
  const char* slash = strrchr(pathOrName, '/');
  const char* base = slash ? slash + 1 : pathOrName;
  return strncasecmp(base, "pw_", 3) == 0;
}

static bool sd_entry_has_bin_ext(const char* pathOrName) {
  if (!pathOrName) return false;
  const char* slash = strrchr(pathOrName, '/');
  const char* base = slash ? slash + 1 : pathOrName;
  size_t n = strlen(base);
  if (n < 5) return false;
  return strncasecmp(base + n - 4, ".bin", 4) == 0;
}

/** SPV1/SPV2 header => password vault file; otherwise assume encrypted backup-code blob. */
static bool sd_bin_file_header_is_pw_vault(const char* fullpath) {
  FILE* f = fopen(fullpath, "rb");
  if (!f) return false;
  uint8_t h[4];
  size_t nr = fread(h, 1, 4, f);
  fclose(f);
  if (nr != 4) return false;
  return memcmp(h, "SPV1", 4) == 0 || memcmp(h, "SPV2", 4) == 0;
}

/** True if RESTORE_PASSWORD opened for this selection. */
static bool restore_try_open_sd_selection(const char* filepath, const char* basename) {
  if (sd_entry_is_backup_bin(basename)) {
    strncpy(g_restoreFull, filepath, RESTORE_FULL_MAX_BYTES - 1);
    g_restoreFull[RESTORE_FULL_MAX_BYTES - 1] = 0;
    clearPassword(g_password1);
    preparePasswordPromptKeyboard();
    setMsg("Enter password to decrypt backup code");
    show(UIScreen::RESTORE_PASSWORD);
    return true;
  }
  if (sd_entry_is_pw_vault(basename)) {
    strncpy(PW_FILE, filepath, sizeof(PW_FILE) - 1);
    PW_FILE[sizeof(PW_FILE) - 1] = 0;
    strncpy(g_restoreFull, filepath, RESTORE_FULL_MAX_BYTES - 1);
    g_restoreFull[RESTORE_FULL_MAX_BYTES - 1] = 0;
    clearPassword(g_password1);
    preparePasswordPromptKeyboard();
    setMsg("Enter password to decrypt backup");
    show(UIScreen::RESTORE_PASSWORD);
    return true;
  }
  if (sd_entry_has_bin_ext(basename)) {
    if (sd_bin_file_header_is_pw_vault(filepath)) {
      strncpy(PW_FILE, filepath, sizeof(PW_FILE) - 1);
      PW_FILE[sizeof(PW_FILE) - 1] = 0;
      strncpy(g_restoreFull, filepath, RESTORE_FULL_MAX_BYTES - 1);
      g_restoreFull[RESTORE_FULL_MAX_BYTES - 1] = 0;
      clearPassword(g_password1);
      preparePasswordPromptKeyboard();
      setMsg("Enter password to decrypt backup");
      show(UIScreen::RESTORE_PASSWORD);
      return true;
    }
    strncpy(g_restoreFull, filepath, RESTORE_FULL_MAX_BYTES - 1);
    g_restoreFull[RESTORE_FULL_MAX_BYTES - 1] = 0;
    clearPassword(g_password1);
    preparePasswordPromptKeyboard();
    setMsg("Enter password to decrypt backup code");
    show(UIScreen::RESTORE_PASSWORD);
    return true;
  }
  return false;
}

static void sd_select_file_by_basename(const char* basename) {
  g_sdSelectedFile = -1;
  if (!basename || !basename[0]) return;
  for (int i = 0; i < g_sdFileCount; i++) {
    if (g_sdIsDir[i]) continue;
    if (strcmp(g_sdFiles[i], basename) == 0) {
      g_sdSelectedFile = i;
      return;
    }
  }
}

static bool sd_rename_final_name_ok(char* out, size_t outCap, const char* raw) {
  const char* s = raw;
  while (*s == ' ') s++;
  strncpy(out, s, outCap - 1);
  out[outCap - 1] = 0;
  size_t L = strlen(out);
  while (L > 0 && out[L - 1] == ' ') {
    out[L - 1] = 0;
    L--;
  }
  if (L == 0) return false;
  if (strcmp(out, ".") == 0 || strcmp(out, "..") == 0) return false;
  for (size_t i = 0; i < L; i++) {
    char c = out[i];
    if ((unsigned char)c < 0x20) return false;
    if (c == '/' || c == '\\' || c == ':' || c == '*' || c == '?' || c == '"' || c == '<' || c == '>' || c == '|')
      return false;
  }
  return true;
}

/** Stem for *.bin renames: same rules as full name, but no ".bin" substring (avoids foo.bin → foo.bin.bin). */
static bool sd_rename_stem_ok(char* out, size_t outCap, const char* raw) {
  if (!sd_rename_final_name_ok(out, outCap, raw)) return false;
  for (const char* p = out; *p; p++) {
    if (strncasecmp(p, ".bin", 4) == 0) return false;
  }
  return true;
}

static void sd_rename_begin_from_basename(const char* filepath, const char* basename) {
  strncpy(g_sdRenameOldPath, filepath, sizeof(g_sdRenameOldPath) - 1);
  g_sdRenameOldPath[sizeof(g_sdRenameOldPath) - 1] = 0;
  size_t bl = strlen(basename);
  if (bl >= 5 && strncasecmp(basename + bl - 4, ".bin", 4) == 0) {
    g_sdRenameStemOnly = true;
    size_t stemLen = bl - 4;
    if (stemLen >= sizeof(g_sdRenameBuf)) stemLen = sizeof(g_sdRenameBuf) - 1;
    memcpy(g_sdRenameBuf, basename, stemLen);
    g_sdRenameBuf[stemLen] = 0;
  } else {
    g_sdRenameStemOnly = false;
    strncpy(g_sdRenameBuf, basename, sizeof(g_sdRenameBuf) - 1);
    g_sdRenameBuf[sizeof(g_sdRenameBuf) - 1] = 0;
  }
}

static void drawSdFileRename() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Rename file", true);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);
  gfx->setCursor(10, 52);
  gfx->print("Same folder only. OK to apply.");
  gfx->setTextColor(RGB565_CYAN);
  gfx->setCursor(10, 68);
  if (g_sdRenameStemOnly)
    gfx->print(".bin extension cannot be changed");
  else
    gfx->print("No \\ / : * ? \" < > |");

  const int boxX = 20, boxY = 112, boxW = 280, boxH = 48;
  gfx->fillRoundRect(boxX, boxY, boxW, boxH, 12, UI_CARD);
  gfx->drawRoundRect(boxX, boxY, boxW, boxH, 12, UI_ACCENT);
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  const int charW = 12, pad = 10;
  if (g_sdRenameStemOnly) {
    const int suffixPx = 4 * charW;
    int stemMaxPx = boxW - 2 * pad - suffixPx - 6;
    int maxChars = stemMaxPx / charW;
    if (maxChars < 1) maxChars = 1;
    size_t len = strlen(g_sdRenameBuf);
    const char* shown = g_sdRenameBuf;
    if (len > (size_t)maxChars) shown = g_sdRenameBuf + (len - (size_t)maxChars);
    gfx->setCursor(boxX + pad, boxY + (boxH - 16) / 2);
    gfx->print(shown);
    gfx->setTextColor(RGB565_LIGHTGREY);
    int sfxX = boxX + boxW - pad - suffixPx;
    gfx->setCursor(sfxX, boxY + (boxH - 16) / 2);
    gfx->print(".bin");
  } else {
    int maxChars = (boxW - 2 * pad) / charW;
    size_t len = strlen(g_sdRenameBuf);
    const char* shown = g_sdRenameBuf;
    if (len > (size_t)maxChars) shown = g_sdRenameBuf + (len - (size_t)maxChars);
    gfx->setCursor(boxX + pad, boxY + (boxH - 16) / 2);
    gfx->print(shown);
  }

  drawKeyboard();
  drawSwipeBackHintOverlay();
  ui_flush();
}

static void handleSdFileRenameTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    show(g_sdRenameReturnScreen);
    return;
  }
  if (hit(RECT_TOP_TITLE, x, y)) {
    show(g_sdRenameReturnScreen);
    return;
  }
  if (hitOkKey((int16_t)x, (int16_t)y)) {
    char newName[SD_ENTRY_NAME_BYTES];
    if (g_sdRenameStemOnly) {
      char stem[SD_ENTRY_NAME_BYTES];
      if (!sd_rename_stem_ok(stem, sizeof(stem), g_sdRenameBuf)) {
        setMsg("Invalid name");
        draw();
        return;
      }
      if (strlen(stem) + 4 >= sizeof(newName)) {
        setMsg("Name too long");
        draw();
        return;
      }
      snprintf(newName, sizeof(newName), "%s.bin", stem);
    } else {
      if (!sd_rename_final_name_ok(newName, sizeof(newName), g_sdRenameBuf)) {
        setMsg("Invalid name");
        draw();
        return;
      }
    }
    char newPath[192];
    const char* slash = strrchr(g_sdRenameOldPath, '/');
    if (!slash) {
      setMsg("Bad path");
      draw();
      return;
    }
    size_t dirLen = (size_t)(slash - g_sdRenameOldPath);
    if (dirLen + 1 + strlen(newName) >= sizeof(newPath)) {
      setMsg("Path too long");
      draw();
      return;
    }
    memcpy(newPath, g_sdRenameOldPath, dirLen);
    newPath[dirLen] = '/';
    strncpy(newPath + dirLen + 1, newName, sizeof(newPath) - dirLen - 2);
    newPath[sizeof(newPath) - 1] = 0;
    if (strcmp(g_sdRenameOldPath, newPath) == 0) {
      show(g_sdRenameReturnScreen);
      return;
    }
    struct stat st;
    if (stat(newPath, &st) == 0) {
      setMsg("File exists");
      draw();
      return;
    }
    if (rename(g_sdRenameOldPath, newPath) != 0) {
      setMsg("Rename failed");
      draw();
      return;
    }
    if (g_sdRenameReturnScreen == UIScreen::CRYPTO_MULTISIG_SD_BROWSE) {
      multisig_sd_scan_dir();
      ms_sd_select_file_by_basename(newName);
    } else {
      scanSdFiles();
      sd_select_file_by_basename(newName);
    }
    setMsg("Renamed");
    show(g_sdRenameReturnScreen);
    return;
  }
  passwordInputTap(x, y, g_sdRenameBuf, sizeof(g_sdRenameBuf));
}

static bool sd_row_is_selectable_file(int idx) {
  if (idx < 0 || idx >= g_sdFileCount) return false;
  if (g_sdIsDir[idx]) return false;
  if (strcmp(g_sdFiles[idx], "..") == 0) return false;
  return true;
}

/** File or subfolder in the current listing (not "..") — OPEN/LOAD or DELETE. */
static bool sd_row_is_openable_entry(int idx) {
  if (idx < 0 || idx >= g_sdFileCount) return false;
  if (strcmp(g_sdFiles[idx], "..") == 0) return false;
  return true;
}

static bool sd_row_is_deletable(int idx) {
  return sd_row_is_openable_entry(idx);
}

#define SD_DELETE_MAX_DEPTH 32

static bool sd_remove_recursive(const char* path, int depth) {
  if (!path || !path[0]) return false;
  if (depth > SD_DELETE_MAX_DEPTH) return false;
  struct stat st;
  if (stat(path, &st) != 0) return false;
  if (S_ISDIR(st.st_mode)) {
    DIR* d = opendir(path);
    if (!d) return false;
    struct dirent* e;
    bool ok = true;
    while ((e = readdir(d)) != NULL && ok) {
      if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
      char child[256];
      if (snprintf(child, sizeof(child), "%s/%s", path, e->d_name) >= (int)sizeof(child)) {
        ok = false;
        break;
      }
      if (!sd_remove_recursive(child, depth + 1)) ok = false;
    }
    closedir(d);
    return ok && (rmdir(path) == 0);
  }
  return unlink(path) == 0;
}

static bool sd_browser_go_parent() {
  if (strcmp(g_sdCwd, "/sdcard") == 0) return false;
  char* slash = strrchr(g_sdCwd + 1, '/');
  if (!slash) return false;
  *slash = 0;
  if (strlen(g_sdCwd) < strlen("/sdcard")) strncpy(g_sdCwd, "/sdcard", sizeof(g_sdCwd));
  g_sdCwd[sizeof(g_sdCwd) - 1] = 0;
  return true;
}

// Full microSD browse from /sdcard (same idea as multisig_sd_browse_begin): user opens seedmask → BACKUP <xfp> → files.
static void sd_browser_begin() {
  strncpy(g_sdCwd, "/sdcard", sizeof(g_sdCwd));
  g_sdCwd[sizeof(g_sdCwd) - 1] = 0;
  g_sdScrollOffset = 0;
  g_sdSelectedFile = -1;
  scanSdFiles();
}

static void scanSdFiles() {
  Serial.println("scanSdFiles: listing ");
  Serial.println(g_sdCwd);

  g_sdFileCount = 0;
  g_sdSelectedFile = -1;
  memset(g_sdFiles, 0, (size_t)SD_MAX_FILES * SD_ENTRY_NAME_BYTES);
  memset(g_sdIsDir, 0, sizeof(g_sdIsDir));

  DIR* dir = opendir(g_sdCwd);
  if (!dir) {
    Serial.println("scanSdFiles: opendir failed");
    return;
  }
  if (strcmp(g_sdCwd, "/sdcard") != 0) {
    strncpy(g_sdFiles[g_sdFileCount], "..", SD_ENTRY_NAME_BYTES - 1);
    g_sdFiles[g_sdFileCount][SD_ENTRY_NAME_BYTES - 1] = 0;
    g_sdIsDir[g_sdFileCount] = 1;
    g_sdFileCount++;
  }
  struct dirent* entry;
  while ((entry = readdir(dir)) != NULL && g_sdFileCount < SD_MAX_FILES) {
    if (entry->d_name[0] == '.') continue;
    char full[192];
    snprintf(full, sizeof(full), "%s/%s", g_sdCwd, entry->d_name);
    struct stat st;
    if (stat(full, &st) != 0) continue;
    strncpy(g_sdFiles[g_sdFileCount], entry->d_name, SD_ENTRY_NAME_BYTES - 1);
    g_sdFiles[g_sdFileCount][SD_ENTRY_NAME_BYTES - 1] = 0;
    g_sdIsDir[g_sdFileCount] = S_ISDIR(st.st_mode) ? 1 : 0;
    g_sdFileCount++;
  }
  closedir(dir);

  Serial.print("scanSdFiles: entries ");
  Serial.println(g_sdFileCount);
}

// Delete file or recursively delete folder in current directory (not "..").
static bool sdDeleteEntryAt(int idx) {
  if (idx < 0 || idx >= g_sdFileCount) return false;
  if (strcmp(g_sdFiles[idx], "..") == 0) return false;
  char path[256];
  snprintf(path, sizeof(path), "%s/%s", g_sdCwd, g_sdFiles[idx]);
  if (g_sdIsDir[idx]) return sd_remove_recursive(path, 0);
  return unlink(path) == 0;
}

static bool ms_sdDeleteEntryAt(int idx) {
  if (idx < 0 || idx >= g_msSdCount) return false;
  if (strcmp(g_msSdNames[idx], "..") == 0) return false;
  char path[256];
  snprintf(path, sizeof(path), "%s/%s", g_msSdCwd, g_msSdNames[idx]);
  if (g_msSdIsDir[idx]) return sd_remove_recursive(path, 0);
  return unlink(path) == 0;
}

static void drawSdBrowser() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Select Password File", false);

  gfx->setTextColor(RGB565_LIGHTGREY);
  gfx->setTextSize(2);
  gfx->setCursor(10, 48);
  {
    char showPath[64];
    const char* cwd = g_sdCwd;
    if (strlen(cwd) > 28) {
      snprintf(showPath, sizeof(showPath), "...%s", cwd + strlen(cwd) - 24);
    } else {
      snprintf(showPath, sizeof(showPath), "%s", cwd);
    }
    gfx->print(showPath);
  }

  int startIdx = g_sdScrollOffset;
  int endIdx = min(startIdx + SD_FILES_PER_PAGE, g_sdFileCount);
  int y = SD_LIST_TOP;
  for (int i = startIdx; i < endIdx; i++) {
    if (i == g_sdSelectedFile) {
      gfx->fillRect(SD_LIST_LEFT, y - 2, SD_LIST_RIGHT - SD_LIST_LEFT, MULTISIG_SD_LIST_ROW_H, UI_ACCENT);
      gfx->setTextColor(RGB565_BLACK);
    } else {
      gfx->setTextColor(UI_TEXT);
    }
    if (g_sdIsDir[i]) {
      draw_multisig_sd_folder_icon(SD_LIST_LEFT, (int16_t)(y + 6), UI_ACCENT);
      gfx->setTextSize(2);
      gfx->setCursor(SD_LIST_LEFT + 30, y + 10);
      gfx->printf("%d) %s", i + 1, g_sdFiles[i]);
    } else {
      gfx->setTextSize(1);
      gfx->setCursor(SD_LIST_LEFT + 4, y + 6);
      if (sd_entry_is_backup_bin(g_sdFiles[i])) gfx->print("B ");
      else if (sd_entry_is_pw_vault(g_sdFiles[i])) gfx->print("P ");
      else if (sd_entry_has_bin_ext(g_sdFiles[i])) gfx->print("? ");
      else gfx->print("  ");
      gfx->setTextSize(2);
      gfx->setCursor(SD_LIST_LEFT + 28, y + 10);
      gfx->printf("%d) %s", i + 1, g_sdFiles[i]);
    }
    y += MULTISIG_SD_LIST_ROW_H;
  }

  if (g_sdFileCount == 0) {
    gfx->setTextColor(RGB565_LIGHTGREY);
    gfx->setTextSize(2);
    gfx->setCursor(10, SD_LIST_TOP);
    gfx->print("Empty folder");
  }

  if (g_sdFileCount > SD_FILES_PER_PAGE) {
    int listH = SD_FILES_PER_PAGE * MULTISIG_SD_LIST_ROW_H;
    int sbX = 268, sbW = 8, sbY = SD_LIST_TOP, sbH = listH;
    gfx->fillRoundRect(sbX, sbY, sbW, sbH, 4, UI_CARD);
    gfx->drawRoundRect(sbX, sbY, sbW, sbH, 4, UI_BORDER);
    int maxOff = g_sdFileCount - SD_FILES_PER_PAGE;
    int thumbH = max(12, (SD_FILES_PER_PAGE * sbH) / g_sdFileCount);
    int thumbY = sbY + (maxOff > 0 ? (g_sdScrollOffset * (sbH - thumbH)) / maxOff : 0);
    gfx->fillRoundRect(sbX + 1, thumbY, sbW - 2, thumbH, 3, UI_ACCENT);
    drawBtn(BTN_SCROLL_UP, "^^", UI_CARD, 1);
    drawBtn(BTN_SCROLL_DOWN, "vv", UI_CARD, 1);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(1);
    gfx->setCursor(268, listH + SD_LIST_TOP + 6);
    gfx->printf("%d-%d/%d", startIdx + 1, endIdx, g_sdFileCount);
  }

  if (g_sdFileCount > 0 && g_sdSelectedFile >= 0 && g_sdSelectedFile < g_sdFileCount) {
    if (sd_row_is_deletable(g_sdSelectedFile)) {
      drawBtn(BTN_LIST_DELETE, "DELETE", RGB565_RED, 2);
    }
    if (sd_row_is_openable_entry(g_sdSelectedFile)) {
      const char* okLbl = g_sdIsDir[g_sdSelectedFile] ? "OPEN" : "LOAD";
      drawBtn(BTN_LIST_OK, okLbl, UI_SUCCESS, 2);
    }
    if (sd_row_is_selectable_file(g_sdSelectedFile)) {
      drawBtn(BTN_LIST_RENAME, "RENAME", UI_ACCENT, 2);
    }
  }

  drawBtn(BTN_LIST_BACK, "BACK", RGB565_DARKGREY, 2);

  // Semi-transparent "Delete?" popup (same style as generate confirm)
  if (g_showSdDeleteConfirm) {
    const int popupW = 260, popupH = 120, popupR = 12;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    uint16_t* fb = gfx->getFramebuffer();
    if (fb) {
      for (int py = popupY; py < popupY + popupH; py++) {
        for (int px = popupX; px < popupX + popupW; px++) {
          size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
          uint16_t bg = fb[idx];
          fb[idx] = (uint16_t)(((bg & 0xF7DE) >> 1) + ((UI_CARD & 0xF7DE) >> 1));
        }
      }
    } else {
      gfx->fillRoundRect(popupX, popupY, popupW, popupH, popupR, UI_CARD);
    }
    gfx->drawRoundRect(popupX, popupY, popupW, popupH, popupR, UI_ACCENT);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(1);
    gfx->setCursor(popupX + 12, popupY + 22);
    if (g_sdSelectedFile >= 0 && g_sdSelectedFile < g_sdFileCount && g_sdIsDir[g_sdSelectedFile]
        && strcmp(g_sdFiles[g_sdSelectedFile], "..") != 0) {
      gfx->print("Delete this folder and");
      gfx->setCursor(popupX + 12, popupY + 34);
      gfx->print("everything inside?");
    } else {
      gfx->setCursor(popupX + 12, popupY + 28);
      gfx->print("Delete this file?");
    }
    drawBtn(Rect{ popupX + 20, popupY + 62, 100, 44 }, "Yes", RGB565_RED, 2);
    drawBtn(Rect{ popupX + 140, popupY + 62, 100, 44 }, "Cancel", RGB565_DARKGREY, 2);
  }

  ui_flush();
}

static void handleSdBrowserTap(uint16_t x, uint16_t y) {
  if (hit(BTN_LIST_BACK, x, y)) {
    g_showSdDeleteConfirm = false;
    show(UIScreen::MENU);
    return;
  }

  // Delete file confirm popup
  if (g_showSdDeleteConfirm) {
    const int popupW = 260, popupH = 120;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    Rect rYes = { (int16_t)(popupX + 20), (int16_t)(popupY + 62), 100, 44 };
    Rect rCancel = { (int16_t)(popupX + 140), (int16_t)(popupY + 62), 100, 44 };
    if (hit(rYes, x, y)) {
      g_showSdDeleteConfirm = false;
      if (g_sdSelectedFile >= 0 && g_sdSelectedFile < g_sdFileCount && sdDeleteEntryAt(g_sdSelectedFile)) {
        int wasIdx = g_sdSelectedFile;
        scanSdFiles();
        g_sdScrollOffset = 0;
        g_sdSelectedFile = (wasIdx >= g_sdFileCount) ? (g_sdFileCount - 1) : wasIdx;
        if (g_sdSelectedFile < 0) g_sdSelectedFile = -1;
        setMsg("Deleted");
      } else {
        setMsg("Delete failed");
      }
      drawSdBrowser();
      return;
    }
    if (hit(rCancel, x, y)) {
      g_showSdDeleteConfirm = false;
      drawSdBrowser();
      return;
    }
    return;
  }

  if (sd_presence_for_ui() && hit(BTN_TOPBAR_SD, x, y)) {
    sd_browser_begin();
    drawSdBrowser();
    return;
  }

  if (g_sdFileCount > SD_FILES_PER_PAGE) {
    if (hit(BTN_SCROLL_UP, x, y) && g_sdScrollOffset > 0) {
      g_sdScrollOffset = max(0, g_sdScrollOffset - SD_FILES_PER_PAGE);
      drawSdBrowser();
      return;
    }
    if (hit(BTN_SCROLL_DOWN, x, y) && g_sdScrollOffset + SD_FILES_PER_PAGE < g_sdFileCount) {
      g_sdScrollOffset = min(g_sdFileCount - SD_FILES_PER_PAGE, g_sdScrollOffset + SD_FILES_PER_PAGE);
      drawSdBrowser();
      return;
    }
  }

  if (sd_row_is_deletable(g_sdSelectedFile) && hit(BTN_LIST_DELETE, x, y)) {
    g_showSdDeleteConfirm = true;
    drawSdBrowser();
    return;
  }

  if (sd_row_is_selectable_file(g_sdSelectedFile) && hit(BTN_LIST_RENAME, x, y)) {
    int sel = g_sdSelectedFile;
    if (sel < 0 || sel >= g_sdFileCount || g_sdIsDir[sel]) return;
    char filepath[192];
    snprintf(filepath, sizeof(filepath), "%s/%s", g_sdCwd, g_sdFiles[sel]);
    sd_rename_begin_from_basename(filepath, g_sdFiles[sel]);
    g_sdRenameReturnScreen = UIScreen::SD_BROWSER;
    show(UIScreen::SD_FILE_RENAME);
    return;
  }

  if (sd_row_is_openable_entry(g_sdSelectedFile) && hit(BTN_LIST_OK, x, y)) {
    int sel = g_sdSelectedFile;
    if (sel < 0 || sel >= g_sdFileCount) return;
    if (g_sdIsDir[sel]) {
      char full[192];
      snprintf(full, sizeof(full), "%s/%s", g_sdCwd, g_sdFiles[sel]);
      if (strlen(full) >= sizeof(g_sdCwd)) {
        setMsg("Path too long");
        drawSdBrowser();
        return;
      }
      strncpy(g_sdCwd, full, sizeof(g_sdCwd) - 1);
      g_sdCwd[sizeof(g_sdCwd) - 1] = 0;
      scanSdFiles();
      g_sdScrollOffset = 0;
      g_touchIgnoreUntil = millis() + 320;
      sdScrollLastY = -1;
      sdScrollAccum = 0.f;
      drawSdBrowser();
      return;
    }
    char filepath[192];
    snprintf(filepath, sizeof(filepath), "%s/%s", g_sdCwd, g_sdFiles[sel]);
    if (!restore_try_open_sd_selection(filepath, g_sdFiles[sel])) {
      setMsg("Unknown file type");
      drawSdBrowser();
    }
    return;
  }

  int startIdx = g_sdScrollOffset;
  int endIdx = min(startIdx + SD_FILES_PER_PAGE, g_sdFileCount);
  int yPos = SD_LIST_TOP;
  for (int i = startIdx; i < endIdx; i++) {
    if (x >= SD_LIST_LEFT && x <= SD_LIST_RIGHT && y >= yPos - 2 && y <= yPos + MULTISIG_SD_LIST_ROW_H) {
      const char* nm = g_sdFiles[i];
      if (strcmp(nm, "..") == 0) {
        if (sd_browser_go_parent()) {
          scanSdFiles();
          g_sdScrollOffset = 0;
          g_sdSelectedFile = -1;
          g_touchIgnoreUntil = millis() + 320;
          sdScrollLastY = -1;
          sdScrollAccum = 0.f;
        }
        drawSdBrowser();
        return;
      }
      g_sdSelectedFile = i;
      drawSdBrowser();
      return;
    }
    yPos += MULTISIG_SD_LIST_ROW_H;
  }
}

