static bool password_hf_english_dict_contains(const char* word) {
  if (!word || !word[0]) return false;
  int lo = 0;
  int hi = (int)(sizeof(kPasswordHighFrequencyEnglish) / sizeof(kPasswordHighFrequencyEnglish[0])) - 1;
  while (lo <= hi) {
    int mid = lo + ((hi - lo) / 2);
    int c = strcasecmp(word, kPasswordHighFrequencyEnglish[mid]);
    if (c == 0) return true;
    if (c < 0) hi = mid - 1;
    else lo = mid + 1;
  }
  return false;
}

// Count alphabetic tokens (runs of A–Z) and how many are ultra-common English.
static void password_alpha_token_stats(const char* pw, int* outToks, int* outHighFreq) {
  *outToks = 0;
  *outHighFreq = 0;
  if (!pw) return;
  for (size_t i = 0; pw[i];) {
    if (!isalpha((unsigned char)pw[i])) {
      i++;
      continue;
    }
    size_t j = i;
    while (pw[j] && isalpha((unsigned char)pw[j])) j++;
    (*outToks)++;
    char t[48];
    size_t tl = j - i;
    if (tl < sizeof(t)) {
      memcpy(t, pw + i, tl);
      t[tl] = 0;
      for (size_t k = 0; t[k]; k++) t[k] = (char)tolower((unsigned char)t[k]);
      if (password_hf_english_dict_contains(t)) (*outHighFreq)++;
    }
    i = j;
  }
}

static bool password_has_whole_word_weak_match(const char* pw) {
  if (!pw) return false;
  for (size_t nx = 0; nx < sizeof(kPasswordWeakWholeWord) / sizeof(kPasswordWeakWholeWord[0]); nx++) {
    const char* needle = kPasswordWeakWholeWord[nx];
    size_t n = strlen(needle);
    if (n == 0) continue;
    for (size_t i = 0; pw[i];) {
      if (!isalpha((unsigned char)pw[i])) {
        i++;
        continue;
      }
      size_t j = i;
      while (pw[j] && isalpha((unsigned char)pw[j])) j++;
      if (j - i == n && strncasecmp(pw + i, needle, n) == 0) return true;
      i = j;
    }
  }
  return false;
}

static char password_leet_fold_char(char c) {
  switch (c) {
    case '0': return 'o';
    case '1': return 'l';
    case '!': return 'i';
    case '2': return 'z';
    case '3': return 'e';
    case '4': return 'a';
    case '@': return 'a';
    case '5': return 's';
    case '$': return 's';
    case '6': return 'g';
    case '7': return 't';
    case '+': return 't';
    case '8': return 'b';
    case '9': return 'g';
    default: return (char)tolower((unsigned char)c);
  }
}

static void password_to_leet_folded_ascii(const char* src, char* dst, size_t dstLen) {
  if (!dst || dstLen == 0) return;
  dst[0] = 0;
  if (!src) return;
  size_t o = 0;
  for (size_t i = 0; src[i] && o + 1 < dstLen; i++) {
    unsigned char c = (unsigned char)src[i];
    if (isspace(c) || c == '_' || c == '-' || c == '.') {
      dst[o++] = ' ';
      continue;
    }
    dst[o++] = password_leet_fold_char((char)c);
  }
  dst[o] = 0;
}

static size_t password_longest_same_char_run(const char* pw) {
  if (!pw || !pw[0]) return 0;
  size_t best = 1, cur = 1;
  for (size_t i = 1; pw[i]; ++i) {
    if (pw[i] == pw[i - 1]) {
      cur++;
      if (cur > best) best = cur;
    } else {
      cur = 1;
    }
  }
  return best;
}

static bool password_is_repeated_block(const char* pw, size_t len) {
  if (!pw || len < 4) return false;
  for (size_t block = 1; block <= 4; block++) {
    if (len < block * 2) continue;
    if ((len % block) != 0) continue;
    bool allSame = true;
    for (size_t i = block; i < len; i++) {
      if (pw[i] != pw[i % block]) {
        allSame = false;
        break;
      }
    }
    if (allSame) return true;
  }
  return false;
}

static bool password_is_mirrored_halves(const char* pw, size_t len) {
  if (!pw || len < 6 || (len % 2) != 0) return false;
  size_t h = len / 2;
  bool same = true;
  bool reverseSame = true;
  for (size_t i = 0; i < h; i++) {
    if (pw[i] != pw[h + i]) same = false;
    if (pw[i] != pw[len - 1 - i]) reverseSame = false;
    if (!same && !reverseSame) return false;
  }
  return same || reverseSame;
}

static size_t password_longest_digit_run(const char* pw) {
  if (!pw || !pw[0]) return 0;
  size_t best = 0, cur = 0;
  for (size_t i = 0; pw[i]; i++) {
    if (isdigit((unsigned char)pw[i])) {
      cur++;
      if (cur > best) best = cur;
    } else {
      cur = 0;
    }
  }
  return best;
}

// Letters/spaces/separators only (no digits, no symbols) — per common strength guides, short ones are weak.
static bool password_is_letters_and_seps_only(const char* pw) {
  if (!pw || !pw[0]) return false;
  for (size_t i = 0; pw[i]; i++) {
    unsigned char c = (unsigned char)pw[i];
    if (isalpha(c)) continue;
    if (c == ' ' || c == '-' || c == '_' || c == '\t') continue;
    return false;
  }
  return true;
}

static bool password_is_digits_only(const char* pw) {
  if (!pw || !pw[0]) return false;
  for (size_t i = 0; pw[i]; i++) {
    if (!isdigit((unsigned char)pw[i])) return false;
  }
  return true;
}

// Obvious run like "12345" or "abcde" (length >= 5), case-insensitive for letters.
static bool password_has_obvious_sequence_run(const char* pw) {
  if (!pw) return false;
  size_t n = strlen(pw);
  if (n < 5) return false;
  for (size_t i = 0; i + 5 <= n; i++) {
    bool num = true, let = true;
    for (size_t k = 0; k < 5; k++) {
      unsigned char c = (unsigned char)pw[i + k];
      if (!isdigit(c)) num = false;
      if (!isalpha(c)) let = false;
    }
    if (num) {
      bool asc = true, desc = true;
      for (size_t k = 1; k < 5; k++) {
        if (pw[i + k] != pw[i + k - 1] + 1) asc = false;
        if (pw[i + k] != pw[i + k - 1] - 1) desc = false;
      }
      if (asc || desc) return true;
    }
    if (let) {
      bool asc = true, desc = true;
      for (size_t k = 1; k < 5; k++) {
        int a = tolower((unsigned char)pw[i + k]);
        int b = tolower((unsigned char)pw[i + k - 1]);
        if (a != b + 1) asc = false;
        if (a != b - 1) desc = false;
      }
      if (asc || desc) return true;
    }
  }
  return false;
}

// Letters/separators only and most tokens are ultra-common English → greeting-like, not cryptographic strength.
static bool password_is_predictable_english_phrase(const char* pw) {
  if (!pw || !password_is_letters_and_seps_only(pw)) return false;
  int nTok = 0, nHf = 0;
  password_alpha_token_stats(pw, &nTok, &nHf);
  return nTok >= 4 && nHf * 4 >= nTok * 3;
}

// More robust phrase detector: tolerate mixed case/digits/symbol substitutions and separators.
// Used to avoid rating human sentences as STRONG due naive charset entropy.
static bool password_is_predictable_english_like_phrase(const char* pw) {
  if (!pw || !pw[0]) return false;
  char folded[EDIT_BUF_MAX];
  password_to_leet_folded_ascii(pw, folded, sizeof(folded));
  int nTok = 0, nHf = 0;
  password_alpha_token_stats(folded, &nTok, &nHf);
  return nTok >= 4 && nHf * 4 >= nTok * 3;
}

// Human sentence-like input detector (robust to minor symbol/digit injections).
// This keeps "hello there how are you" style strings weak even if user adds a few symbols.
static bool password_is_sentence_like_human_phrase(const char* pw) {
  if (!pw || !pw[0]) return false;
  size_t len = strlen(pw);
  if (len < 12) return false;
  char folded[EDIT_BUF_MAX];
  password_to_leet_folded_ascii(pw, folded, sizeof(folded));
  int nTok = 0, nHf = 0;
  password_alpha_token_stats(folded, &nTok, &nHf);
  if (nTok < 4) return false;

  int alphaCount = 0;
  int sepCount = 0;
  for (size_t i = 0; folded[i]; i++) {
    unsigned char c = (unsigned char)folded[i];
    if (isalpha(c)) alphaCount++;
    else if (c == ' ') sepCount++;
  }
  // Predominantly word tokens separated by delimiters, with mostly high-frequency words.
  if (sepCount < 3) return false;
  if (alphaCount * 10 < (int)len * 6) return false;  // require >=60% letters
  return (nHf * 4 >= nTok * 3);
}

// Short human phrase detector ("ilove cats 1990", "who is there 123", etc).
// Prevents short multi-token human phrases from being rated high.
static bool password_is_short_human_phrase(const char* pw) {
  if (!pw || !pw[0]) return false;
  if (!password_has_word_delim(pw)) return false;
  char folded[EDIT_BUF_MAX];
  password_to_leet_folded_ascii(pw, folded, sizeof(folded));
  int nTok = 0, nHf = 0;
  password_alpha_token_stats(folded, &nTok, &nHf);
  if (nTok < 2 || nTok > 3) return false;
  if (nHf >= 1) return true;
  if (password_has_common_substring_signal(folded) || password_has_whole_word_weak_match(folded)) return true;
  return false;
}

static bool password_has_common_substring_signal(const char* pw) {
  if (!pw || !pw[0]) return false;
  for (size_t i = 0; i < sizeof(kPasswordWeakSubstringAnywhere) / sizeof(kPasswordWeakSubstringAnywhere[0]); i++) {
    if (password_substr_ci(pw, kPasswordWeakSubstringAnywhere[i])) return true;
  }
  return false;
}

static bool password_is_common_derived_weak(const char* pw);

static bool password_common_signal_forces_weak(const char* pw) {
  if (!pw || !pw[0]) return false;
  size_t len = strlen(pw);
  if (password_is_top_common_password(pw)) return true;
  if (password_is_common_derived_weak(pw)) return true;
  // Substring/whole-word common signals are hard-fail only for shorter passwords.
  if (len < 20 && (password_has_common_substring_signal(pw) || password_has_whole_word_weak_match(pw)))
    return true;
  return false;
}

static void password_to_folded_compact_alnum(const char* src, char* dst, size_t dstLen) {
  if (!dst || dstLen == 0) return;
  dst[0] = 0;
  if (!src) return;
  char folded[EDIT_BUF_MAX];
  password_to_leet_folded_ascii(src, folded, sizeof(folded));
  size_t o = 0;
  for (size_t i = 0; folded[i] && o + 1 < dstLen; i++) {
    unsigned char c = (unsigned char)folded[i];
    if (isalnum(c)) dst[o++] = (char)tolower(c);
  }
  dst[o] = 0;
}

// Exhaustive common-derived weak detector:
// - common base + short numeric/symbol-ish tail
// - concatenation of two common-password bases
static bool password_is_common_derived_weak(const char* pw) {
  if (!pw || !pw[0]) return false;
  char compact[EDIT_BUF_MAX];
  password_to_folded_compact_alnum(pw, compact, sizeof(compact));
  size_t n = strlen(compact);
  if (n < 4) return false;

  // Case 1: common base + short tail (up to 8 chars).
  const size_t maxTail = 8;
  const size_t minBase = 4;
  for (size_t cut = (n > minBase ? n - 1 : 0); cut >= minBase && cut < n; cut--) {
    size_t tailLen = n - cut;
    if (tailLen == 0 || tailLen > maxTail) continue;
    char base[EDIT_BUF_MAX];
    memcpy(base, compact, cut);
    base[cut] = 0;
    if (!password_is_common_hash(password_fnv1a32_ci(base))) continue;
    int digits = 0, letters = 0;
    for (size_t i = cut; i < n; i++) {
      unsigned char c = (unsigned char)compact[i];
      if (isdigit(c)) digits++;
      else if (isalpha(c)) letters++;
    }
    if ((tailLen <= 6 && digits >= 1 && letters <= 2) || tailLen <= 4) return true;
  }

  // Case 2: two concatenated common-password bases.
  for (size_t cut = 4; cut + 4 <= n; cut++) {
    char a[EDIT_BUF_MAX], b[EDIT_BUF_MAX];
    memcpy(a, compact, cut);
    a[cut] = 0;
    memcpy(b, compact + cut, n - cut);
    b[n - cut] = 0;
    if (password_is_common_hash(password_fnv1a32_ci(a)) && password_is_common_hash(password_fnv1a32_ci(b))) {
      return true;
    }
  }

  return false;
}

// Common chunks we always treat as "a dumped password" (min 5). Includes mycat.
static const char* const kBackupPasswordClicheRuns[] = {
  "1234567890",
  "123456789",
  "password12",
  "password1",
  "1q2w3e4r",
  "zaq1zaq1",
  "iloveyou",
  "admin123",
  "trustno1",
  "passwort",
  "passw0rd",
  "password",
  "qwertyui",
  "asdfghjk",
  "zxcvbnm",
  "12345678",
  "letmein",
  "qwerty",
  "qwertz",
  "asdfgh",
  "zxcvbn",
  "qazwsx",
  "abc123",
  "123456",
  "111111",
  "000000",
  "654321",
  "123123",
  "welcome",
  "12345",
  "mycat",
};

static bool backup_char_is_symbol(unsigned char c) {
  return !isalnum(c) && !isspace(c);
}

static uint32_t backup_fnv1a32_n(const char* s, size_t n) {
  uint32_t h = 0x811C9DC5u;
  for (size_t i = 0; i < n; i++) {
    h ^= (uint32_t)(unsigned char)s[i];
    h *= 0x01000193u;
  }
  return h;
}

static bool backup_alnum_is_common_chunk(const char* s, size_t len) {
  if (len < 5 || len > 20 || !s) return false;
  for (size_t i = 0; i < sizeof(kBackupPasswordClicheRuns) / sizeof(kBackupPasswordClicheRuns[0]); i++) {
    if (strlen(kBackupPasswordClicheRuns[i]) == len && memcmp(s, kBackupPasswordClicheRuns[i], len) == 0) return true;
  }
  if (len < 6) return false;
  return password_is_common_hash(backup_fnv1a32_n(s, len));
}

static bool backup_find_longest_common_chunk(const char* s, size_t* outPos, size_t* outLen) {
  if (!s || !s[0]) return false;
  size_t n = strlen(s);
  size_t bestPos = 0, bestLen = 0;
  for (size_t i = 0; i < n; i++) {
    size_t maxL = n - i;
    if (maxL > 20) maxL = 20;
    for (size_t L = maxL; L >= 5; L--) {
      if (L <= bestLen) break;
      if (backup_alnum_is_common_chunk(s + i, L)) {
        bestLen = L;
        bestPos = i;
        break;
      }
    }
  }
  if (bestLen < 5) return false;
  if (outPos) *outPos = bestPos;
  if (outLen) *outLen = bestLen;
  return true;
}

// After removing a common password, peel this/is/my/from/the… Only leftover real words count.
static size_t backup_unique_phrase_letters(const char* rem) {
  if (!rem) return 0;
  size_t extra = 0;
  size_t uniq = 0;
  bool seen[26] = {};
  size_t i = 0;
  while (rem[i]) {
    if (!isalpha((unsigned char)rem[i])) {
      i++;
      continue;
    }
    size_t j = i;
    while (rem[j] && isalpha((unsigned char)rem[j])) j++;
    size_t a = i;
    while (a < j) {
      size_t maxL = j - a;
      if (maxL > 12) maxL = 12;
      size_t peel = 0;
      char w[16];
      for (size_t L = maxL; L >= 2; L--) {
        memcpy(w, rem + a, L);
        w[L] = 0;
        if (password_hf_english_dict_contains(w)) {
          peel = L;
          break;
        }
      }
      if (peel) {
        a += peel;
        continue;
      }
      extra += (j - a);
      for (size_t k = a; k < j; k++) {
        int idx = (int)(rem[k] - 'a');
        if (idx >= 0 && idx < 26 && !seen[idx]) {
          seen[idx] = true;
          uniq++;
        }
      }
      break;
    }
    i = j;
  }
  if (uniq <= 2) return 0;
  return extra;
}

// True = too common (sticker on a dump, or two dumps glued).
static bool backup_password_is_dressed_common(const char* password) {
  if (!password || !password[0]) return false;
  char compact[128];
  password_to_folded_compact_alnum(password, compact, sizeof(compact));
  if (!compact[0]) return false;

  int hits = 0;
  for (int guard = 0; guard < 8; guard++) {
    size_t pos = 0, len = 0;
    if (!backup_find_longest_common_chunk(compact, &pos, &len)) break;
    hits++;
    if (hits >= 2) return true;
    memmove(compact + pos, compact + pos + len, strlen(compact + pos + len) + 1);
  }
  if (hits == 0) return false;
  return backup_unique_phrase_letters(compact) < 6;
}

static bool backup_password_ok_for_create(const char* password) {
  if (!password) {
    setMsg("Use at least 12 characters.");
    return false;
  }
  size_t n = strlen(password);
  if (n < BACKUP_PASSWORD_MIN_LEN) {
    setMsg("Use at least 12 characters.");
    return false;
  }
  bool haveUpper = false, haveDigit = false, haveSymbol = false;
  for (size_t i = 0; i < n; i++) {
    unsigned char c = (unsigned char)password[i];
    if (isupper(c)) haveUpper = true;
    else if (isdigit(c)) haveDigit = true;
    else if (backup_char_is_symbol(c)) haveSymbol = true;
  }
  if (!haveUpper) {
    setMsg("Need an uppercase letter.");
    return false;
  }
  if (!haveDigit) {
    setMsg("Need a digit.");
    return false;
  }
  if (!haveSymbol) {
    setMsg("Need a symbol.");
    return false;
  }
  if (password_is_top_common_password(password) || password_is_common_derived_weak(password)
      || backup_password_is_dressed_common(password)) {
    setMsg("Too common. Pick another.");
    return false;
  }
  return true;
}

// Catch user-style "common phrase + simple suffix" passwords:
// examples: ilovemycat123, ilovemycat1990.
// Intentionally does NOT fire for longer mixed strings with substantial extra words/content.
static bool password_is_common_phrase_with_simple_suffix(const char* pw) {
  if (!pw || !pw[0]) return false;
  char folded[EDIT_BUF_MAX];
  password_to_leet_folded_ascii(pw, folded, sizeof(folded));

  char compact[EDIT_BUF_MAX];
  size_t o = 0;
  for (size_t i = 0; folded[i] && o + 1 < sizeof(compact); i++) {
    unsigned char c = (unsigned char)folded[i];
    if (isalnum(c)) compact[o++] = (char)tolower(c);
  }
  compact[o] = 0;
  if (o < 8) return false;

  static const char* const roots[] = {
    "ilovemy", "ilove", "mypassword", "password", "letmein", "welcome", "qwerty"
  };
  const char* hitRoot = nullptr;
  size_t rootLen = 0;
  for (size_t i = 0; i < sizeof(roots) / sizeof(roots[0]); i++) {
    size_t rl = strlen(roots[i]);
    if (o > rl && strncmp(compact, roots[i], rl) == 0) {
      hitRoot = roots[i];
      rootLen = rl;
      break;
    }
  }
  if (!hitRoot) return false;

  size_t alphaTail = 0, digitTail = 0;
  for (size_t i = rootLen; compact[i]; i++) {
    unsigned char c = (unsigned char)compact[i];
    if (isdigit(c)) digitTail++;
    else if (isalpha(c)) alphaTail++;
  }
  size_t tailLen = alphaTail + digitTail;
  if (tailLen == 0) return false;

  // Simple/common continuation only; larger mixed continuations are not forced weak.
  if (o <= 20 && alphaTail <= 8 && digitTail <= 6) return true;
  return false;
}

static size_t password_unique_char_count(const char* pw) {
  if (!pw) return 0;
  bool seen[256] = {};
  size_t n = 0;
  for (size_t i = 0; pw[i]; i++) {
    unsigned char c = (unsigned char)pw[i];
    if (!seen[c]) {
      seen[c] = true;
      n++;
    }
  }
  return n;
}

// Strength model: entropy + pattern penalties + 20k common list (see password_entropy_estimate_bits).
// Differs from textbook "length×log2(charset)" by blending diversity caps — avoids false STRONG on human passwords.
// Diceware word bonuses apply in password_strength_score_diceware only, not for arbitrary spaced phrases.
// Conservative strength estimate: naive charset entropy is wildly optimistic for human passwords,
// so we blend with diversity bounds, pattern caps, and minimum length for top tiers.
static double password_entropy_estimate_bits(const char* pw) {
  if (!pw || !pw[0]) return 0;
  size_t len = strlen(pw);
  if (len == 0) return 0;
  if (password_is_top_common_password(pw)) return 14.0;

  bool hasLower = false, hasUpper = false, hasDigit = false;
  bool seenChar[256] = {};
  size_t unique = 0;
  size_t symUnique = 0;
  size_t sepCount = 0;
  size_t alnumCount = 0;

  for (size_t i = 0; pw[i]; ++i) {
    unsigned char c = (unsigned char)pw[i];
    if (c == ' ' || c == '-' || c == '\t') {
      sepCount++;
      continue;
    }
    if (c >= 'a' && c <= 'z') {
      hasLower = true;
      alnumCount++;
    } else if (c >= 'A' && c <= 'Z') {
      hasUpper = true;
      alnumCount++;
    } else if (c >= '0' && c <= '9') {
      hasDigit = true;
      alnumCount++;
    }

    if (!seenChar[c]) {
      seenChar[c] = true;
      unique++;
      if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')))
        symUnique++;
    }
  }

  int pool = 0;
  if (hasLower) pool += 26;
  if (hasUpper) pool += 26;
  if (hasDigit) pool += 10;
  if (symUnique > 0) {
    int symPool = (int)symUnique;
    if (symPool < 10) symPool = 10;
    if (symPool > 64) symPool = 64;
    pool += symPool;
  }
  if (pool < 2) pool = 2;

  // Naive upper bound (assumes i.i.d. over full union — too high for real passwords).
  double naive = (double)len * (log((double)pool) / log(2.0));
  double u = (double)unique;
  if (u < 2.0) u = 2.0;
  // Upper bound if positions only drew from the observed multiset of characters.
  double diversityCap = (double)len * (log(u) / log(2.0));
  // Human-chosen passwords rarely reach full naive entropy; keep conservative but not overly punitive.
  double bits = fmin(diversityCap * 1.05, naive * 0.52);
  bits = fmin(bits, diversityCap + (double)len * 0.35);

  double div = (len > 0) ? (double)unique / (double)len : 0;
  if (div < 0.55) bits *= (0.22 + 0.78 * (div / 0.55));

  int classes = (hasLower ? 1 : 0) + (hasUpper ? 1 : 0) + (hasDigit ? 1 : 0) + (symUnique > 0 ? 1 : 0);
  if (classes < 2 && len < 16) bits *= 0.88;
  if (classes == 1 && len < 14) bits *= 0.80;

  size_t maxSeq = 1, curSeq = 1;
  for (size_t i = 1; pw[i]; ++i) {
    int d = (int)(unsigned char)pw[i] - (int)(unsigned char)pw[i - 1];
    if (d == 1 || d == -1) {
      curSeq++;
      if (curSeq > maxSeq) maxSeq = curSeq;
    } else {
      curSeq = 1;
    }
  }
  if (maxSeq >= 4) bits -= (double)(maxSeq - 3) * 4.5;
  size_t sameRun = password_longest_same_char_run(pw);
  if (sameRun >= 3) bits -= (double)(sameRun - 2) * 5.0;
  size_t digitRun = password_longest_digit_run(pw);
  if (digitRun >= 4) bits -= (double)(digitRun - 3) * 4.0;
  if (password_is_repeated_block(pw, len)) bits = fmin(bits * 0.55, 24.0);
  if (password_is_mirrored_halves(pw, len)) bits = fmin(bits * 0.62, 30.0);

  if (alnumCount > 0 && alnumCount == len - sepCount) {
    bool onlyDigits = hasDigit && !hasLower && !hasUpper && symUnique == 0;
    if (onlyDigits && len <= 14) bits = fmin(bits, 26.0);
    if (!onlyDigits && !hasDigit && len < 16) bits = fmin(bits, 38.0);
  }
  if (len <= 9) bits = fmin(bits, 40.0);

  double capFromPatterns = 120.0;
  for (size_t i = 0; i < sizeof(kPasswordWeakSubstringAnywhere) / sizeof(kPasswordWeakSubstringAnywhere[0]); i++) {
    if (password_substr_ci(pw, kPasswordWeakSubstringAnywhere[i])) {
      capFromPatterns = fmin(capFromPatterns, 22.0);
      break;
    }
  }
  char folded[EDIT_BUF_MAX];
  password_to_leet_folded_ascii(pw, folded, sizeof(folded));
  for (size_t i = 0; i < sizeof(kPasswordWeakSubstringAnywhere) / sizeof(kPasswordWeakSubstringAnywhere[0]); i++) {
    if (password_substr_ci(folded, kPasswordWeakSubstringAnywhere[i])) {
      capFromPatterns = fmin(capFromPatterns, 24.0);
      break;
    }
  }
  if (password_has_whole_word_weak_match(pw)) capFromPatterns = fmin(capFromPatterns, 34.0);
  if (password_has_whole_word_weak_match(folded)) capFromPatterns = fmin(capFromPatterns, 34.0);
  for (size_t i = 0; i < sizeof(kPasswordKeyboardWalks) / sizeof(kPasswordKeyboardWalks[0]); i++) {
    if (password_substr_ci(pw, kPasswordKeyboardWalks[i])) capFromPatterns = fmin(capFromPatterns, 30.0);
    if (password_substr_ci(folded, kPasswordKeyboardWalks[i])) capFromPatterns = fmin(capFromPatterns, 30.0);
  }
  bits = fmin(bits, capFromPatterns);

  if (len < 8) bits = fmin(bits, 18.0);

  if (bits < 0) bits = 0;
  return bits;
}

// Length + entropy gates: short passwords cannot be STRONG even if naive math says so.
static uint8_t password_strength_from_bits(double bits, size_t len) {
  if (len < 8 || bits < 34.0) return 0;
  if (len < 10 || bits < 48.0) return 1;
  if (len < 12 || bits < 60.0) return 1;
  return 2;
}

// Diceware word-count can mark STRONG before entropy catches up; never exceed tier allowed for length.
static uint8_t password_strength_cap_tier_for_length(size_t len) {
  if (len < 8) return 0;
  if (len < 14) return 1;
  return 2;
}

// Additional gate: user-entered passwords should not reach STRONG/VERY STRONG unless:
// 1) full class mix (upper+lower+digit+symbol) at >=14 chars, OR
// 2) long random-looking string.
static bool password_allows_high_tier(const char* pw) {
  if (!pw || !pw[0]) return false;
  size_t len = strlen(pw);
  bool hasLower = false, hasUpper = false, hasDigit = false, hasSym = false;
  size_t unique = password_unique_char_count(pw);
  for (size_t i = 0; pw[i]; i++) {
    unsigned char c = (unsigned char)pw[i];
    if (c >= 'a' && c <= 'z') hasLower = true;
    else if (c >= 'A' && c <= 'Z') hasUpper = true;
    else if (c >= '0' && c <= '9') hasDigit = true;
    else if (!isspace(c)) hasSym = true;
  }
  const bool fullMix14 = (len >= 14 && hasLower && hasUpper && hasDigit && hasSym && unique >= (len / 2));
  const bool longRandomLike =
    (len >= 20
     && !password_has_word_delim(pw)
     && !password_is_predictable_english_like_phrase(pw)
     && !password_is_sentence_like_human_phrase(pw)
     && !password_is_repeated_block(pw, len)
     && !password_is_mirrored_halves(pw, len)
     && password_longest_same_char_run(pw) < 4
     && unique * 10 >= len * 6);  // >=60% unique-char ratio
  return fullMix14 || longRandomLike;
}

static uint8_t password_strength_score(const char* pw) {
  if (!pw || !pw[0]) return 0;
  size_t len = strlen(pw);
  // Immediate weak (aligns with common password-manager heuristics; list + structure before entropy).
  if (len < 8) return 0;
  if (password_common_signal_forces_weak(pw)) return 0;
  if (password_is_common_phrase_with_simple_suffix(pw)) return 0;
  // Generic natural-language phrases are predictable regardless of case mixing.
  if (password_is_predictable_english_like_phrase(pw)) return 0;
  if (password_is_sentence_like_human_phrase(pw)) return 0;
  if (password_is_short_human_phrase(pw)) return 0;
  if (password_is_letters_and_seps_only(pw) && len < 12) return 0;
  if (password_is_digits_only(pw) && len < 12) return 0;
  if (password_has_obvious_sequence_run(pw) && len < 14) return 0;
  if (password_longest_same_char_run(pw) >= 6) return 0;

  double bits = password_entropy_estimate_bits(pw);
  uint8_t tier = password_strength_from_bits(bits, len);

  bool hasLower = false, hasUpper = false, hasDigit = false, hasSym = false;
  bool hasSep = false;
  for (size_t i = 0; pw[i]; i++) {
    unsigned char c = (unsigned char)pw[i];
    if (c >= 'a' && c <= 'z') hasLower = true;
    else if (c >= 'A' && c <= 'Z') hasUpper = true;
    else if (c >= '0' && c <= '9') hasDigit = true;
    else if (c == ' ' || c == '-' || c == '_') hasSep = true;
    else if (!isspace(c)) hasSym = true;
  }
  int classes = (hasLower ? 1 : 0) + (hasUpper ? 1 : 0) + (hasDigit ? 1 : 0) + (hasSym ? 1 : 0);

  // Smart downgrades: strong-looking but predictable structures.
  if (password_is_repeated_block(pw, len) || password_is_mirrored_halves(pw, len)) {
    if (tier > 0) tier--;
  }
  if (password_longest_same_char_run(pw) >= 4 || password_longest_digit_run(pw) >= 5) {
    if (tier > 0) tier--;
  }
  if (classes <= 1 && len < 16) tier = 0;
  if (classes <= 2 && len < 12 && tier > 0) tier--;
  // For compact single-token passwords, don't allow STRONG without symbols unless very long.
  if (!hasSep && !hasSym && len < 18 && tier == 2) tier = 1;
  if (!hasSep && len < 16 && classes < 4 && tier == 2) tier = 1;
  // For passphrases with separators, require more diversity (or more length) before STRONG.
  if (hasSep && classes < 3 && len < 24 && tier == 2) tier = 1;

  // UX floors (prompt-style): long passwords deserve at least GOOD / STRONG if not structurally broken.
  if (tier == 0 && len >= 16 && !password_is_repeated_block(pw, len) && !password_is_mirrored_halves(pw, len) && password_longest_same_char_run(pw) < 4 && !password_has_obvious_sequence_run(pw) && bits >= 32.0) {
    tier = 1;
  }
  if (tier < 2 && len >= 20 && classes >= 2 && !password_is_predictable_english_like_phrase(pw) && !password_is_repeated_block(pw, len) && !password_is_mirrored_halves(pw, len) && password_longest_same_char_run(pw) < 4 && bits >= 48.0) {
    tier = 2;
  }

  // Smart upgrades for genuinely long mixed passwords.
  if (tier < 2 && len >= 18 && classes >= 3 && bits >= 56.0 && !password_is_predictable_english_like_phrase(pw)) tier = 2;
  if (tier == 0 && len >= 14 && classes >= 2 && bits >= 42.0) tier = 1;

  // One long concatenated word (no spaces): do not treat like a spaced passphrase; bump out of WEAK if sane.
  if (password_is_letters_and_seps_only(pw)) {
    int nTok = 0, nHf = 0;
    password_alpha_token_stats(pw, &nTok, &nHf);
    if (nTok == 1 && len >= 18 && !password_is_top_common_password(pw) && password_longest_same_char_run(pw) < 4 && !password_has_obvious_sequence_run(pw) && tier == 0 && bits >= 22.0) {
      tier = 1;
    }
    if (password_is_predictable_english_like_phrase(pw) && tier > 1) tier = 1;
  }
  // Additional cap requested: only allow STRONG+ for full-mix(14+) or long random-looking inputs.
  if (tier > 1 && !password_allows_high_tier(pw)) tier = 1;
  return tier;
}

// RANDOM CHARS: disjoint subsets (build active charset from Advanced toggles).
static const char kRandPwSubsetUpper[] = "ABCDEFGHJKLMNPQRSTUVWXYZ";
static const char kRandPwSubsetLower[] = "abcdefghijkmnpqrstuvwxyz";
static const char kRandPwSubsetDigits[] = "23456789";
// Generic printable symbols (all common punctuation).
static const char kRandPwSubsetSymbols[] = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~";

static size_t random_pw_charset_build(char* out, size_t cap) {
  if (!out || cap < 2) return 0;
  out[0] = 0;
  if (g_randClassUpper) strlcat(out, kRandPwSubsetUpper, cap);
  if (g_randClassLower) strlcat(out, kRandPwSubsetLower, cap);
  if (g_randClassDigit) strlcat(out, kRandPwSubsetDigits, cap);
  if (g_randClassSym) strlcat(out, kRandPwSubsetSymbols, cap);
  size_t n = strlen(out);
  if (n == 0) {
    // If user disables all classes, use a deterministic safe fallback (lowercase only),
    // instead of silently re-enabling all classes.
    strlcpy(out, kRandPwSubsetLower, cap);
    n = strlen(out);
  }
  return n;
}

static bool password_chars_only_from_random_generator(const char* pw) {
  if (!pw) return false;
  char csBuf[96];
  random_pw_charset_build(csBuf, sizeof(csBuf));
  for (; *pw; pw++) {
    if (!strchr(csBuf, *pw)) return false;
  }
  return true;
}

static double random_password_entropy_bits(size_t len, size_t charsetSize) {
  if (len == 0 || charsetSize < 2) return 0.0;
  return (double)len * (log((double)charsetSize) / log(2.0));
}

static size_t random_password_charset_size_from_text(const char* pw) {
  if (!pw || !pw[0]) return 0;
  bool hasUpper = false, hasLower = false, hasDigit = false, hasSym = false;
  for (size_t i = 0; pw[i]; i++) {
    unsigned char c = (unsigned char)pw[i];
    if (c >= 'A' && c <= 'Z') hasUpper = true;
    else if (c >= 'a' && c <= 'z') hasLower = true;
    else if (c >= '0' && c <= '9') hasDigit = true;
    else if (!isspace(c)) hasSym = true;
  }
  size_t n = 0;
  if (hasUpper) n += strlen(kRandPwSubsetUpper);
  if (hasLower) n += strlen(kRandPwSubsetLower);
  if (hasDigit) n += strlen(kRandPwSubsetDigits);
  if (hasSym) n += strlen(kRandPwSubsetSymbols);
  return n;
}

static uint8_t password_strength_score_random(const char* pw) {
  if (!pw || !pw[0]) return 0;
  if (password_common_signal_forces_weak(pw)) return 0;
  if (password_is_common_phrase_with_simple_suffix(pw)) return 0;
  if (password_has_whole_word_weak_match(pw)) return 0;
  if (password_is_predictable_english_like_phrase(pw)) return 0;
  if (password_is_sentence_like_human_phrase(pw)) return 0;
  if (password_is_short_human_phrase(pw)) return 0;
  size_t csN = random_password_charset_size_from_text(pw);
  if (csN < 2) return 0;
  size_t len = strlen(pw);
  double bits = random_password_entropy_bits(len, csN);

  // RANDOM CHARS tiers by raw entropy bits.
  uint8_t tier = 0;
  if (bits >= 85.0) tier = 3;       // VERY STRONG
  else if (bits >= 70.0) tier = 2;  // STRONG
  else if (bits >= 53.0) tier = 1;  // GOOD

  // Global anti-pattern penalties (apply in all modes that use this scorer).
  if (password_is_repeated_block(pw, len) || password_is_mirrored_halves(pw, len))
    return 0;
  size_t sameRun = password_longest_same_char_run(pw);
  if (sameRun >= 6) return 0;
  if (sameRun >= 4 && tier > 0) tier--;

  if (password_has_word_delim(pw)) {
    int words = 0, unique = 0, maxFreq = 0;
    diceware_phrase_repeat_stats(pw, &words, &unique, &maxFreq);
    if (words >= 4) {
      if (unique <= 1 || maxFreq >= words - 1) return 0;
      if ((maxFreq * 2) >= words && tier > 1) tier = 1;
      if (unique <= 2 && words >= 5 && tier > 0) tier = (tier > 1) ? 1 : 0;
    }
  }
  size_t unique = password_unique_char_count(pw);
  if (unique * 3 < len) return 0;              // <33% unique chars: always weak
  if (tier > 1 && unique * 2 < len) tier = 1;  // <50% unique chars cannot be strong+
  // Additional cap requested: only allow STRONG+ for full-mix(14+) or long random-looking inputs.
  if (tier > 1 && !password_allows_high_tier(pw)) tier = 1;
  return tier;
}

// Characters allowed inside a passphrase word (EFF list + typical edits). Separators are space/tab/newline or '-'.
static bool diceware_passphrase_char_in_word(char c) {
  if (c >= 'a' && c <= 'z') return true;
  if (c >= 'A' && c <= 'Z') return true;
  if (c >= '0' && c <= '9') return true;
  switch (c) {
    case '!':
    case '#':
    case '$':
    case '%':
    case '&':
    case '\'':
    case '(':
    case ')':
    case '*':
    case '+':
    case '.':
    case ':':
    case ';':
    case '=':
    case '?':
    case '@':
      return true;
    default:
      return false;
  }
}

static bool diceware_passphrase_is_word_delim(char c) {
  if (c == '\0') return false;
  if (c == '-' || c == '_' || c == ',' || c == '.') return true;
  return isspace((unsigned char)c) != 0;
}

static bool password_has_word_delim(const char* pw) {
  if (!pw) return false;
  for (size_t i = 0; pw[i]; i++) {
    unsigned char c = (unsigned char)pw[i];
    if (isspace(c) || c == '-' || c == '_') return true;
  }
  return false;
}

static bool diceware_word_in_list_ci(const char* word) {
  if (!word || !word[0]) return false;
  int lo = 0, hi = DICEWARE_WORD_COUNT - 1;
  char dw[24];
  while (lo <= hi) {
    int mid = lo + ((hi - lo) / 2);
    strncpy_P(dw, (PGM_P)pgm_read_ptr(&DICEWARE_WORDS[mid]), sizeof(dw) - 1);
    dw[sizeof(dw) - 1] = 0;
    int c = strcasecmp(word, dw);
    if (c == 0) return true;
    if (c < 0) hi = mid - 1;
    else lo = mid + 1;
  }
  return false;
}

static int diceware_wordlist_phrase_word_count(const char* pw) {
  if (!pw || !pw[0]) return -1;
  bool sawDelim = false;
  int words = 0;
  size_t i = 0;
  while (pw[i]) {
    while (pw[i] && diceware_passphrase_is_word_delim(pw[i])) {
      sawDelim = true;
      i++;
    }
    if (!pw[i]) break;
    char tok[24];
    size_t o = 0;
    while (pw[i] && !diceware_passphrase_is_word_delim(pw[i])) {
      if (o + 1 >= sizeof(tok)) return -1;
      tok[o++] = pw[i++];
    }
    tok[o] = 0;
    if (!diceware_word_in_list_ci(tok)) return -1;
    words++;
  }
  if (!sawDelim || words <= 0) return -1;
  return words;
}

static void diceware_phrase_repeat_stats(const char* pw, int* outWords, int* outUnique, int* outMaxFreq) {
  if (outWords) *outWords = 0;
  if (outUnique) *outUnique = 0;
  if (outMaxFreq) *outMaxFreq = 0;
  if (!pw || !pw[0]) return;

  const int kMaxToks = 12;
  char toks[kMaxToks][24];
  int counts[kMaxToks];
  int tokN = 0;
  int words = 0;
  size_t i = 0;
  while (pw[i]) {
    while (pw[i] && diceware_passphrase_is_word_delim(pw[i])) i++;
    if (!pw[i]) break;
    char tok[24];
    size_t o = 0;
    while (pw[i] && !diceware_passphrase_is_word_delim(pw[i])) {
      if (o + 1 < sizeof(tok)) tok[o++] = pw[i];
      i++;
    }
    tok[o] = 0;
    if (!tok[0]) continue;
    words++;

    int hit = -1;
    for (int k = 0; k < tokN; k++) {
      if (strcasecmp(tok, toks[k]) == 0) {
        hit = k;
        break;
      }
    }
    if (hit >= 0) {
      counts[hit]++;
    } else if (tokN < kMaxToks) {
      strncpy(toks[tokN], tok, sizeof(toks[tokN]) - 1);
      toks[tokN][sizeof(toks[tokN]) - 1] = 0;
      counts[tokN] = 1;
      tokN++;
    }
  }

  int maxFreq = 0;
  for (int k = 0; k < tokN; k++)
    if (counts[k] > maxFreq) maxFreq = counts[k];
  if (outWords) *outWords = words;
  if (outUnique) *outUnique = tokN;
  if (outMaxFreq) *outMaxFreq = maxFreq;
}

// Count words split on '-' or whitespace (same as typing "w1 w2 w3 w4" or "w1-w2-w3-w4"). -1 = empty/invalid char.
static int diceware_passphrase_word_count(const char* pw) {
  if (!pw || !pw[0]) return -1;
  size_t i = 0;
  while (pw[i] && diceware_passphrase_is_word_delim(pw[i])) i++;
  if (!pw[i]) return -1;

  int words = 0;
  while (pw[i]) {
    words++;
    while (pw[i] && !diceware_passphrase_is_word_delim(pw[i])) {
      if (!diceware_passphrase_char_in_word(pw[i])) return -1;
      i++;
    }
    if (!pw[i]) break;
    while (pw[i] && diceware_passphrase_is_word_delim(pw[i])) i++;
  }
  return words;
}

// Strict detector used for Diceware strength tiers only.
// Treat as diceware-style passphrase only when it is truly multi-word:
// - words are alphabetic tokens
// - separators are diceware delimiters
// - at least one separator is present (single token falls back to RANDOM model)
static int diceware_strength_word_count_strict(const char* pw) {
  if (!pw || !pw[0]) return -1;
  bool sawDelim = false;
  int words = 0;
  size_t i = 0;
  while (pw[i]) {
    while (pw[i] && diceware_passphrase_is_word_delim(pw[i])) {
      sawDelim = true;
      i++;
    }
    if (!pw[i]) break;
    if (!isalpha((unsigned char)pw[i])) return -1;
    words++;
    while (pw[i] && !diceware_passphrase_is_word_delim(pw[i])) {
      if (!isalpha((unsigned char)pw[i])) return -1;
      i++;
    }
  }
  if (words <= 0 || !sawDelim) return -1;
  return words;
}

static bool diceware_manual_prompt_eligible(const char* pw) {
  if (!pw || !pw[0] || g_pwValueWasGenerated || g_pwValueStartedFromGenerate) return false;
  return diceware_wordlist_phrase_word_count(pw) >= 4;
}

static bool diceware_manual_done_active() {
  if (!g_dicewareManualDoneAtMs) return false;
  // Keep checked UI visible for 2s, then hide message + checkbox row.
  if ((uint32_t)(millis() - g_dicewareManualDoneAtMs) >= 2000u) return false;
  return true;
}

static bool diceware_manual_done_applied() {
  return g_dicewareManualDoneAlready;
}

static Rect diceware_manual_done_checkbox_rect(int barY) {
  // "Done already" row is 5px lower than before.
  return Rect{ 232, (int16_t)(barY + 14), 12, 12 };
}

static double diceware_entropy_bits_from_words(int words) {
  if (words <= 0) return 0.0;
  // EFF diceware list size is 7776 words.
  return (double)words * (log(7776.0) / log(2.0));
}

// Diceware mode: use the same entropy-bit tiers as RANDOM for valid diceware passphrases.
// If content is not a valid diceware-style passphrase, fall back to RANDOM entropy scoring.
static uint8_t password_strength_score_diceware(const char* pw) {
  if (!pw || !pw[0]) return 0;
  bool useGeneratedRules = g_pwValueWasGenerated || (diceware_manual_done_applied() && diceware_manual_prompt_eligible(pw));
  int dw = useGeneratedRules ? diceware_passphrase_word_count(pw)
                             : diceware_strength_word_count_strict(pw);
  if (dw < 0) return password_strength_score_random(pw);
  double bits = diceware_entropy_bits_from_words(dw);
  uint8_t tier = 0;
  if (bits >= 85.0) tier = 3;       // VERY STRONG
  else if (bits >= 70.0) tier = 2;  // STRONG
  else if (bits >= 53.0) tier = 1;  // GOOD

  int words = 0, unique = 0, maxFreq = 0;
  diceware_phrase_repeat_stats(pw, &words, &unique, &maxFreq);
  if (words >= 4) {
    if (unique <= 1 || maxFreq >= words - 1) return 0;
    if ((maxFreq * 2) >= words && tier > 1) tier = 1;
    if (unique <= 2 && words >= 5 && tier > 0) tier = (tier > 1) ? 1 : 0;
  }
  return tier;
}

// Explain WHY a password is weak (entropy-based).
static const char* password_strength_reason(const char* pw) {
  static char buf[48];
  buf[0] = 0;
  if (!pw || !pw[0]) {
    strncpy(buf, "Empty password", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  if (password_is_top_common_password(pw)) {
    strncpy(buf, "Very common password", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  double b = password_entropy_estimate_bits(pw);
  size_t len = strlen(pw);
  if (len < 8) {
    strncpy(buf, "Too short", sizeof(buf) - 1);
  } else if (password_longest_same_char_run(pw) >= 3 || password_longest_digit_run(pw) >= 4) {
    strncpy(buf, "Too many repeated characters", sizeof(buf) - 1);
  } else if (b < 34.0) {
    strncpy(buf, "Too simple or predictable", sizeof(buf) - 1);
  } else {
    strncpy(buf, "Add length or more randomness", sizeof(buf) - 1);
  }
  buf[sizeof(buf) - 1] = 0;
  return buf;
}

static const char* password_strength_reason_random(const char* pw) {
  static char buf[64];
  buf[0] = 0;
  if (!pw || !pw[0]) {
    strncpy(buf, "Empty password", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  if (password_common_signal_forces_weak(pw) || password_is_common_phrase_with_simple_suffix(pw)) {
    strncpy(buf, "Common password", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  size_t csN = random_password_charset_size_from_text(pw);
  if (csN < 2) return password_strength_reason(pw);
  if (diceware_manual_prompt_eligible(pw) && !diceware_manual_done_applied()) {
    strncpy(buf, "generate randomly instead", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  size_t len = strlen(pw);
  if (password_is_repeated_block(pw, len) || password_is_mirrored_halves(pw, len)) {
    strncpy(buf, "Repeating pattern detected", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  if (password_longest_same_char_run(pw) >= 4) {
    strncpy(buf, "Too many repeated characters", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  if (password_has_word_delim(pw)) {
    int repWords = 0, unique = 0, maxFreq = 0;
    diceware_phrase_repeat_stats(pw, &repWords, &unique, &maxFreq);
    if (repWords >= 4 && (unique <= 1 || maxFreq >= repWords - 1 || unique <= 2)) {
      strncpy(buf, "Too many repeated words", sizeof(buf) - 1);
      buf[sizeof(buf) - 1] = 0;
      return buf;
    }
  }
  double bits = random_password_entropy_bits(strlen(pw), csN);
  if (bits < 53.0) {
    strncpy(buf, "Increase length or enable more classes", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  if (bits < 70.0) {
    strncpy(buf, "Good - add entropy for strong", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  if (bits < 85.0) {
    strncpy(buf, "Strong - add entropy for very strong", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  return "";
}

// Explain WHY a diceware passphrase is weak (for DICEWARE mode).
static const char* password_strength_reason_diceware(const char* pw) {
  static char buf[48];
  buf[0] = 0;
  if (!pw || !pw[0]) {
    strncpy(buf, "Empty password", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }

  bool useGeneratedRules = g_pwValueWasGenerated || (diceware_manual_done_applied() && diceware_manual_prompt_eligible(pw));
  int words = useGeneratedRules ? diceware_passphrase_word_count(pw)
                                : diceware_strength_word_count_strict(pw);
  if (words < 0) {
    return password_strength_reason_random(pw);
  }
  // Show this guidance only for manually typed diceware-style phrases,
  // never for phrases produced by the Generate action.
  if (diceware_manual_prompt_eligible(pw) && !diceware_manual_done_applied()) {
    strncpy(buf, "generate randomly instead", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  int repWords = 0, unique = 0, maxFreq = 0;
  diceware_phrase_repeat_stats(pw, &repWords, &unique, &maxFreq);
  if (repWords >= 4 && (unique <= 1 || maxFreq >= repWords - 1 || unique <= 2)) {
    strncpy(buf, "Too many repeated words", sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    return buf;
  }
  buf[0] = 0;
  return buf;
}

// Draw strength meter bar under password field input line
static void drawPasswordStrengthBar(int x, int y, int w, uint8_t score) {
  const int h = 12;  // taller bar for visibility
  // Background track
  gfx->fillRoundRect(x, y, w, h, 4, UI_CARD);
  gfx->drawRoundRect(x, y, w, h, 4, UI_BORDER);

  const uint16_t colWeak = RGB565_RED;
  const uint16_t colGood = UI_WARN;       // amber
  const uint16_t colStrong = UI_SUCCESS;  // green
  const uint16_t colVeryStrong = RGB565_CYAN;

  const char* label = "";
  uint16_t col = colWeak;
  int fillW = w / 4;

  if (score == 0) {
    label = "WEAK";
    col = colWeak;
    fillW = w / 4;
  } else if (score == 1) {
    label = "GOOD";
    col = colGood;
    fillW = w / 2;
  } else if (score == 2) {
    label = "STRONG";
    col = colStrong;
    fillW = (w * 3) / 4;
  } else {
    label = "VERY STRONG";
    col = colVeryStrong;
    fillW = w;
  }

  gfx->fillRoundRect(x, y, fillW, h, 4, col);

  // Label centered above bar
  gfx->setTextColor(col);
  gfx->setTextSize(1);
  int16_t lw = (int16_t)strlen(label) * 6;
  int16_t lx = x + (w - lw) / 2;
  if (lx < x) lx = x;
  gfx->setCursor(lx, y - 10);
  gfx->print(label);
}

static void drawPasswordCreateHintCard(const char* hint) {
  if (!hint || !hint[0]) return;
  const int ts = 1;
  const int cw = 6 * ts;
  const int lh = 12;
  const int padX = 16;
  const int padY = 12;
  const int stripeW = 3;
  const int stripeGap = 10;
  const int cardX = 12;
  const int cardW = LCD_W - 24;
  const int cardY = 52;
  int maxChars = (cardW - padX - padX - stripeW - stripeGap) / cw;
  if (maxChars < 16) maxChars = 16;
  if (maxChars > 55) maxChars = 55;

  char lines[5][56];
  int nLines = 0;
  const char* p = hint;
  while (*p && nLines < 5) {
    while (*p == ' ') p++;
    if (!*p) break;
    size_t remain = strlen(p);
    size_t chunk = remain > (size_t)maxChars ? (size_t)maxChars : remain;
    if (chunk < remain) {
      size_t br = chunk;
      while (br > 8 && p[br - 1] != ' ') br--;
      if (br <= 8) br = chunk;
      chunk = br;
    }
    if (chunk >= sizeof(lines[0])) chunk = sizeof(lines[0]) - 1;
    memcpy(lines[nLines], p, chunk);
    lines[nLines][chunk] = 0;
    size_t tl = strlen(lines[nLines]);
    while (tl > 0 && lines[nLines][tl - 1] == ' ') lines[nLines][--tl] = 0;
    p += chunk;
    if (lines[nLines][0]) nLines++;
  }
  if (nLines <= 0) return;

  const int cardH = 2 * padY + nLines * lh;
  Rect r = { (int16_t)cardX, (int16_t)cardY, (int16_t)cardW, (int16_t)cardH };
  fillRoundRectGradientV(r, 12,
                         blendRGB565(UI_CARD, UI_ACCENT, 0.38f),
                         blendRGB565(UI_CARD, UI_ACCENT, 0.10f));
  gfx->drawRoundRect(cardX, cardY, cardW, cardH, 12, UI_ACCENT);
  gfx->drawRoundRect(cardX + 1, cardY + 1, cardW - 2, cardH - 2, 11,
                     blendRGB565(UI_ACCENT, RGB565_WHITE, 0.32f));
  gfx->fillRoundRect(cardX + 8, cardY + padY, stripeW, nLines * lh, 2, UI_ACCENT2);

  gfx->setTextSize(ts);
  gfx->setTextColor(UI_TEXT);
  const int textLeft = cardX + 8 + stripeW + stripeGap;
  const int textRight = cardX + cardW - padX;
  const int textW = textRight - textLeft;
  int ty = cardY + padY + 2;
  for (int i = 0; i < nLines; i++) {
    int lw = (int)strlen(lines[i]) * cw;
    int lx = textLeft + (textW - lw) / 2;
    if (lx < textLeft) lx = textLeft;
    gfx->setCursor((int16_t)lx, (int16_t)ty);
    gfx->print(lines[i]);
    ty += lh;
  }
}

