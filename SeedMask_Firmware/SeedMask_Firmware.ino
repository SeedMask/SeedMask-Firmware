// =======================
// CRC16-CCITT (0x1021), init 0xFFFF
// =======================
static uint16_t crc16_ccitt(const uint8_t* data, size_t len) {
  uint16_t crc = 0xFFFF;
  for (size_t i = 0; i < len; i++) {
    crc ^= (uint16_t)data[i] << 8;
    for (int b = 0; b < 8; b++) {
      crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
    }
  }
  return crc;
}

// =======================
// Base32 (RFC4648, no padding)
// =======================
static const char* B32_ALPH = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
static int b32_val(char c) {
  if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
  if (c >= 'A' && c <= 'Z') return c - 'A';
  if (c >= '2' && c <= '7') return 26 + (c - '2');
  return -1;
}

static String base32_encode(const uint8_t* data, size_t len) {
  String out;
  out.reserve(((len * 8) + 4) / 5);
  uint32_t buffer = 0;
  int bitsLeft = 0;
  for (size_t i = 0; i < len; i++) {
    buffer = (buffer << 8) | data[i];
    bitsLeft += 8;
    while (bitsLeft >= 5) {
      int idx = (buffer >> (bitsLeft - 5)) & 0x1F;
      bitsLeft -= 5;
      out += B32_ALPH[idx];
    }
  }
  if (bitsLeft > 0) {
    int idx = (buffer << (5 - bitsLeft)) & 0x1F;
    out += B32_ALPH[idx];
  }
  return out;
}

static bool base32_decode(const char* s, uint8_t* out, size_t outMax, size_t& outLen) {
  outLen = 0;
  if (!s) return false;
  uint32_t buffer = 0;
  int bitsLeft = 0;

  for (size_t i = 0; s[i]; i++) {
    char c = s[i];
    if (c == '-' || c == ' ' || c == '\n' || c == '\r' || c == '\t' || c == '=') continue;
    int v = b32_val(c);
    if (v < 0) return false;
    buffer = (buffer << 5) | (uint32_t)v;
    bitsLeft += 5;
    if (bitsLeft >= 8) {
      uint8_t b = (buffer >> (bitsLeft - 8)) & 0xFF;
      bitsLeft -= 8;
      if (outLen >= outMax) return false;
      out[outLen++] = b;
    }
  }
  return true;
}

// =======================
// HMAC-SHA1 for TOTP (RFC 6238)
// =======================
#if defined(MBEDTLS_SHA1_C) || defined(MBEDTLS_MD_C)
static bool hmac_sha1(const uint8_t* key, size_t keyLen,
                      const uint8_t* msg, size_t msgLen,
                      uint8_t out[20]) {
  const mbedtls_md_info_t* md = mbedtls_md_info_from_type(MBEDTLS_MD_SHA1);
  if (!md) return false;
  mbedtls_md_context_t ctx;
  mbedtls_md_init(&ctx);
  if (mbedtls_md_setup(&ctx, md, 1) != 0) {
    mbedtls_md_free(&ctx);
    return false;
  }
  if (mbedtls_md_hmac_starts(&ctx, key, keyLen) != 0) {
    mbedtls_md_free(&ctx);
    return false;
  }
  if (mbedtls_md_hmac_update(&ctx, msg, msgLen) != 0) {
    mbedtls_md_free(&ctx);
    return false;
  }
  if (mbedtls_md_hmac_finish(&ctx, out) != 0) {
    mbedtls_md_free(&ctx);
    return false;
  }
  mbedtls_md_free(&ctx);
  return true;
}

// TOTP: 6-digit code from base32 secret and unix time. Returns 0 on error.
static uint32_t totp_code(const char* secretBase32, uint32_t unixTime) {
  uint8_t key[64];  // HMAC key (padded if < block size)
  size_t keyLen = 0;
  if (!base32_decode(secretBase32, key, sizeof(key), keyLen) || keyLen == 0) return 0;
  uint32_t T = unixTime / 30;
  uint8_t counter[8];
  counter[0] = (T >> 56) & 0xFF;
  counter[1] = (T >> 48) & 0xFF;
  counter[2] = (T >> 40) & 0xFF;
  counter[3] = (T >> 32) & 0xFF;
  counter[4] = (T >> 24) & 0xFF;
  counter[5] = (T >> 16) & 0xFF;
  counter[6] = (T >> 8) & 0xFF;
  counter[7] = T & 0xFF;
  uint8_t hash[20];
  if (!hmac_sha1(key, keyLen, counter, 8, hash)) return 0;
  int offset = hash[19] & 0x0F;
  uint32_t code = ((uint32_t)(hash[offset] & 0x7F) << 24)
                  | ((uint32_t)hash[offset + 1] << 16)
                  | ((uint32_t)hash[offset + 2] << 8)
                  | (uint32_t)hash[offset + 3];
  return code % 1000000;
}
#else
static uint32_t totp_code(const char* secretBase32, uint32_t unixTime) {
  (void)secretBase32;
  (void)unixTime;
  return 0;
}
#endif

// =======================
// RTC: AXP2101 PMIC at 0x34 (board has IMU at 0x68, so no DS3231)
// AXP RTC block typically at 0xE0-0xE6 (sec, min, hr, dow, date, month, year BCD).
// If your AXP2101 datasheet uses different offsets, adjust RTC_AXP_RTC_BASE.
// =======================
#define RTC_AXP2101_ADDR 0x34
#define RTC_AXP_RTC_BASE 0xE0
static uint8_t bcd2dec(uint8_t b) {
  return (b >> 4) * 10 + (b & 0x0F);
}
static uint8_t dec2bcd(uint8_t d) {
  return ((d / 10) << 4) | (d % 10);
}

// Convert (year, month, day, hour, min, sec) to Unix time. month 1-12, day 1-31.
static uint32_t tm_to_unix(uint16_t year, uint8_t month, uint8_t day, uint8_t hour, uint8_t min, uint8_t sec) {
  if (year < 1970 || year > 2099 || month < 1 || month > 12 || day < 1 || day > 31) return 0;
  const uint8_t daysInMonth[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
  uint32_t days = 0;
  for (uint16_t y = 1970; y < year; y++)
    days += (365 + ((y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) ? 1 : 0));
  uint8_t dm = daysInMonth[month - 1];
  if (month == 2 && (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0))) dm = 29;
  if (day > dm) return 0;
  for (uint8_t m = 1; m < month; m++) days += (m == 2 && (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0))) ? 29 : daysInMonth[m - 1];
  days += (day - 1);
  return (uint32_t)days * 86400UL + (uint32_t)hour * 3600UL + (uint32_t)min * 60UL + (uint32_t)sec;
}

// Read current time from AXP2101 RTC. Returns true and writes Unix time to *out if valid.
static bool rtc_read_unix(uint32_t* out) {
  if (!out) return false;
  Wire.beginTransmission(RTC_AXP2101_ADDR);
  Wire.write(RTC_AXP_RTC_BASE);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)RTC_AXP2101_ADDR, (uint8_t)7) != 7) return false;
  uint8_t sec = bcd2dec(Wire.read() & 0x7F);
  uint8_t min = bcd2dec(Wire.read() & 0x7F);
  uint8_t hour = bcd2dec(Wire.read() & 0x3F);
  (void)Wire.read();
  uint8_t date = bcd2dec(Wire.read() & 0x3F);
  uint8_t month = Wire.read();
  uint8_t century = (month & 0x80) ? 1 : 0;
  month = bcd2dec(month & 0x1F);
  uint16_t year = (uint16_t)bcd2dec(Wire.read() & 0xFF) + (century ? 2000 : 1900);
  *out = tm_to_unix(year, month, date, hour, min, sec);
  return (*out >= 1600000000UL && *out <= 4102444800UL);
}

// Write Unix time to AXP2101 RTC (when user sets time manually).
static void rtc_write_unix(uint32_t t) {
  if (t < 1600000000UL || t > 4102444800UL) return;
  uint32_t days = t / 86400UL;
  uint32_t rem = t % 86400UL;
  uint8_t sec = (uint8_t)(rem % 60);
  rem /= 60;
  uint8_t min = (uint8_t)(rem % 60);
  uint8_t hour = (uint8_t)(rem / 60);
  uint32_t y = 1970;
  for (;;) {
    uint32_t n = (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) ? 366 : 365;
    if (days < n) break;
    days -= n;
    y++;
  }
  uint16_t year = (uint16_t)y;
  const uint8_t daysInMonth[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
  uint8_t month = 1;
  for (; month <= 12; month++) {
    uint8_t dm = daysInMonth[month - 1];
    if (month == 2 && (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0))) dm = 29;
    if ((uint32_t)days < dm) break;
    days -= dm;
  }
  uint8_t date = (uint8_t)days + 1;
  Wire.beginTransmission(RTC_AXP2101_ADDR);
  Wire.write(RTC_AXP_RTC_BASE);
  Wire.write(dec2bcd(sec));
  Wire.write(dec2bcd(min));
  Wire.write(dec2bcd(hour));
  Wire.write(1);
  Wire.write(dec2bcd(date));
  Wire.write(dec2bcd(month) | (year >= 2000 ? 0x80 : 0));
  Wire.write(dec2bcd(year % 100));
  if (Wire.endTransmission() != 0) return;
}

// Unix time for TOTP: prefer user-set time (NVS + millis); only use RTC if never set.
// (RTC can be wrong on some boards — e.g. AXP register map — so don't let it override a set time.)
static uint32_t get_unix_time() {
  if (g_unixTimeBaseSec != 0 || g_unixTimeBaseMillis != 0) {
    uint32_t now = millis();
    if (now >= g_unixTimeBaseMillis)
      return g_unixTimeBaseSec + (now - g_unixTimeBaseMillis) / 1000;
    return g_unixTimeBaseSec + now / 1000;
  }
  uint32_t rtcTime = 0;
  if (rtc_read_unix(&rtcTime)) return rtcTime;
  return 0;
}
static void set_unix_time(uint32_t unixSec) {
  g_unixTimeBaseSec = unixSec;
  g_unixTimeBaseMillis = millis();
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putULong("time_sec", (unsigned long)g_unixTimeBaseSec);
  prefs.putULong("time_ms", (unsigned long)g_unixTimeBaseMillis);
  prefs.end();
}
// Load last set time from NVS. After reboot we use saved time as "time at boot" and add
// uptime — so set time again after a long power-off to resync (we have no RTC/NTP).
static void load_unix_time_from_prefs() {
  Preferences prefs;
  prefs.begin("seedmask", true);
  uint32_t savedSec = (uint32_t)prefs.getULong("time_sec", 0);
  uint32_t savedMs = (uint32_t)prefs.getULong("time_ms", 0);
  prefs.end();
  if (savedSec == 0 && savedMs == 0) return;
  g_unixTimeBaseSec = savedSec;
  g_unixTimeBaseMillis = 0;  // treat load as "boot": time advances from savedSec with uptime
}

static String group4(const String& s) {
  String out;
  out.reserve(s.length() + s.length() / 4 + 8);
  const size_t n = s.length();
  const size_t rem = n % 4;
  for (size_t i = 0; i < n; i++) {
    // Keep a short leftover on the last group (24-word SPB1 is 69 chars → idle "-k").
    if (i && (i % 4 == 0) && !(rem && i + rem == n)) out += '-';
    out += s[i];
  }
  return out;
}

