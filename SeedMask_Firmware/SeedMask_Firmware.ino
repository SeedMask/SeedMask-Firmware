static const uint8_t PW_BIP85_META_SLOTS = 24;
struct PwBip85MetaEntry {
  bool used;
  char titleMeta[sizeof(PwItem::title)];
  uint8_t mode;  // PwGenMode
  uint32_t index;
  uint8_t wc;               // 12 or 24
  uint8_t bip85_out_type;   // Bip85PwOutType
  uint8_t bip85_rand_tier;  // Bip85PwRandTier
  uint8_t bip85_dw_words;   // 4..10
};
static PwBip85MetaEntry g_pwBip85Meta[PW_BIP85_META_SLOTS] = {};

static void pw_gen_meta_set_for_title(const char* titleMeta, uint8_t mode, uint32_t idx, uint8_t wc,
                                      uint8_t bip85_out_type, uint8_t bip85_rand_tier, uint8_t bip85_dw_words) {
  if (!titleMeta || !titleMeta[0]) return;
  const uint8_t MODE_BIP85 = 2u;
  if (mode == MODE_BIP85 && !(wc == 12 || wc == 24)) return;
  int freeSlot = -1;
  for (uint8_t i = 0; i < PW_BIP85_META_SLOTS; i++) {
    if (g_pwBip85Meta[i].used) {
      if (strncmp(g_pwBip85Meta[i].titleMeta, titleMeta, sizeof(g_pwBip85Meta[i].titleMeta)) == 0) {
        g_pwBip85Meta[i].mode = (uint8_t)mode;
        g_pwBip85Meta[i].index = idx;
        g_pwBip85Meta[i].wc = wc;
        if (mode == MODE_BIP85) {
          g_pwBip85Meta[i].bip85_out_type = bip85_out_type;
          g_pwBip85Meta[i].bip85_rand_tier = bip85_rand_tier;
          g_pwBip85Meta[i].bip85_dw_words = bip85_dw_words;
        }
        return;
      }
    } else if (freeSlot < 0) {
      freeSlot = (int)i;
    }
  }
  if (freeSlot < 0) freeSlot = 0;  // overwrite oldest slot policy not tracked; use slot 0 fallback
  g_pwBip85Meta[freeSlot].used = true;
  strncpy(g_pwBip85Meta[freeSlot].titleMeta, titleMeta, sizeof(g_pwBip85Meta[freeSlot].titleMeta) - 1);
  g_pwBip85Meta[freeSlot].titleMeta[sizeof(g_pwBip85Meta[freeSlot].titleMeta) - 1] = 0;
  g_pwBip85Meta[freeSlot].mode = (uint8_t)mode;
  g_pwBip85Meta[freeSlot].index = idx;
  g_pwBip85Meta[freeSlot].wc = wc;
  g_pwBip85Meta[freeSlot].bip85_out_type = bip85_out_type;
  g_pwBip85Meta[freeSlot].bip85_rand_tier = bip85_rand_tier;
  g_pwBip85Meta[freeSlot].bip85_dw_words = bip85_dw_words;
}

static bool pw_gen_meta_get_for_title(const char* titleMeta, uint8_t* outMode, uint32_t* outIdx, uint8_t* outWc,
                                      uint8_t* outBip85OutType, uint8_t* outBip85RandTier, uint8_t* outBip85DwWords) {
  if (!titleMeta || !titleMeta[0]) return false;
  for (uint8_t i = 0; i < PW_BIP85_META_SLOTS; i++) {
    if (!g_pwBip85Meta[i].used) continue;
    if (strncmp(g_pwBip85Meta[i].titleMeta, titleMeta, sizeof(g_pwBip85Meta[i].titleMeta)) == 0) {
      if (outMode) *outMode = g_pwBip85Meta[i].mode;
      if (outIdx) *outIdx = g_pwBip85Meta[i].index;
      if (outWc) *outWc = g_pwBip85Meta[i].wc;
      if (outBip85OutType) *outBip85OutType = g_pwBip85Meta[i].bip85_out_type;
      if (outBip85RandTier) *outBip85RandTier = g_pwBip85Meta[i].bip85_rand_tier;
      if (outBip85DwWords) *outBip85DwWords = g_pwBip85Meta[i].bip85_dw_words;
      return true;
    }
  }
  return false;
}

