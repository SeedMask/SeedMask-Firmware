/** Touch-down inside focused strip (metadata card or password box): exclude from swipe-right collapse so horizontal drag scrolls text. */
static bool pwEditorFocusSwipeDownInsideStrip(int16_t downX, int16_t downY) {
  if (g_editMode != EditMode::EDIT_PW_VALUE || !g_pwEditKeyboardVisible || g_pwEditFocusField < 1 || g_pwEditFocusField > 5)
    return false;
  const int boxX = 24;
  const int boxW = 272;
  const int boxH = 48;
  const int expand = 12;
  const int labAbove = 14;
  int16_t boxY = pwValueStripBoxYKeyboardOpen();
  return downX >= (int16_t)(boxX - expand) && downX < (int16_t)(boxX + boxW + expand) && downY >= (int16_t)(boxY - labAbove - expand) && downY < (int16_t)(boxY + boxH + expand);
}

