static void wallet_context_apply_snapshots(const String& pw, const String& notes, const String& totp) {
  pwSvc_clearAll();
  g_noteCount = 0;
  g_totpCount = 0;
  if (g_noteItems) memset(g_noteItems, 0, NOTE_ITEMS_TOTAL_BYTES);
  memset(g_totpItems, 0, sizeof(g_totpItems));
  if (pw.length()) vault_import_passwords_plaintext(pw.c_str(), pw.length());
  if (notes.length()) notes_deserialize_plain(notes.c_str(), notes.length());
  if (totp.length()) totp_deserialize_plain(totp.c_str(), totp.length());
  g_pwListScroll = 0;
  g_noteListScroll = 0;
  g_pwListEditMode = false;
  g_noteListEditMode = false;
  g_showSendPopup = false;
  g_showSendConfirm = false;
  g_showNoteSendPopup = false;
  g_showNoteSendConfirm = false;
