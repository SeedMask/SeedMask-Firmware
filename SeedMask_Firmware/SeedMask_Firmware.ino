  g_cryptoConnectSparrowUrFountain = false;

  char masterXfp[9] = { 0 };
  (void)current_master_xfp(masterXfp);
  char combined[2300];

  if (crypto_home_asset_is_kaspa()) {
    char kpub[120] = { 0 };
    char deriv[44] = { 0 };
    uint32_t purpose = multisigFlow ? 45u : 44u;
    if (multisigFlow) {
      if (!kaspa_multisig_account_kpub(g_addrAccount, kpub, sizeof(kpub))) {
        setMsg(g_addrLastErr[0] ? g_addrLastErr : "multisig kpub failed");
