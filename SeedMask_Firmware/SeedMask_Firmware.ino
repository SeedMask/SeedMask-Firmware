    int popupX = (LCD_W - w) / 2, popupY = (LCD_H - h) / 2;
    int r = (int)((float)popupR * scale);
    if (r < 4) r = 4;
    uint16_t* fb = gfx->getFramebuffer();
    if (fb) {
      for (int py = popupY; py < popupY + h; py++) {
        for (int px = popupX; px < popupX + w; px++) {
          size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
          uint16_t bg = fb[idx];
          fb[idx] = (uint16_t)(((bg & 0xF7DE) >> 1) + ((UI_CARD & 0xF7DE) >> 1));
        }
      }
    } else {
      gfx->fillRoundRect(popupX, popupY, w, h, r, UI_CARD);
    }
    gfx->drawRoundRect(popupX, popupY, w, h, r, UI_ACCENT);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(1);
    const int pad = 8, lineH = 12;
    gfx->setCursor(popupX + pad, popupY + pad);
    gfx->print("The digits 0, 1, 8 and 9 are");
    gfx->setCursor(popupX + pad, popupY + pad + lineH);
    gfx->print("excluded to avoid confusion");
    gfx->setCursor(popupX + pad, popupY + pad + 2 * lineH);
    gfx->print("when reading or typing.");
    gfx->setTextColor(UI_ACCENT);
    gfx->setCursor(popupX + pad, popupY + h - 14);
    gfx->print("Tap to close");
  }

  ui_flush();
}

// Duplicate master seed (BIP85 / SeedQR): semi-transparent card (framebuffer blend like password editor) on Temporary seed.
static void drawTempSeedAlreadyInUsePopupOverlay() {
  const uint16_t warnRed = blendRGB565(RGB565_RED, RGB565_BLACK, 0.15f);

  const int padTop = 12;
  const int padBottom = 12;
  const int padH = 12;
  const int triH = 86;
  const int halfBase = (int)((float)triH / 1.732050808f + 0.5f);
  const int gapBaseToLabel = 10;
  const int okH = 44;
  const int okTextSize = 2;
  const int okW = (int)strlen("OK") * 6 * okTextSize + 36;
  const char* cap = "ALREADY IN USE";
  const int labelW = (int)strlen(cap) * 12;
  const int triSpan = (int)((float)halfBase * 1.055f * 2.f + 8.f);
  const int contentW = max(max(labelW + 2 * padH, okW + 2 * padH), triSpan + 2 * padH);
  const int cardW = max(contentW + 40, 284);
  const int capBaselineToOkTop = 22;
  const int cardH = padTop + triH + gapBaseToLabel + capBaselineToOkTop + okH + padBottom;

  const int cardX = (LCD_W - cardW) / 2;
  const int cardY = (LCD_H - cardH) / 2;
  const int rad = (cardW < 28 || cardH < 28) ? 10 : 14;

  fillRoundRectFramebufferBlend(cardX, cardY, cardW, cardH, rad, UI_CARD, 0.78f);
  gfx->drawRoundRect(cardX, cardY, cardW, cardH, rad, UI_BORDER);
  {
    int ir = rad - 1;
    if (ir < 1) ir = 1;
    gfx->drawRoundRect(cardX + 1, cardY + 1, cardW - 2, cardH - 2, ir, blendRGB565(UI_BORDER, RGB565_WHITE, 0.28f));
  }

  const int cx = cardX + cardW / 2;
  const int yTop = cardY + padTop;
  const int yBase = yTop + triH;
  const float gx = (float)cx;
  const float gy = (float)(yTop + 2 * yBase) / 3.0f;

  auto scalePt = [&](int px, int py, float sc, int* ox, int* oy) {
    *ox = (int)(gx + (float)(px - gx) * sc + 0.5f);
    *oy = (int)(gy + (float)(py - gy) * sc + 0.5f);
  };

  int o0x, o0y, o1x, o1y, o2x, o2y;
  scalePt(cx, yTop, 1.055f, &o0x, &o0y);
  scalePt(cx - halfBase, yBase, 1.055f, &o1x, &o1y);
  scalePt(cx + halfBase, yBase, 1.055f, &o2x, &o2y);
  gfx->fillTriangle(o0x, o0y, o1x, o1y, o2x, o2y, RGB565_BLACK);

  int i0x, i0y, i1x, i1y, i2x, i2y;
  scalePt(cx, yTop, 0.965f, &i0x, &i0y);
  scalePt(cx - halfBase, yBase, 0.965f, &i1x, &i1y);
  scalePt(cx + halfBase, yBase, 0.965f, &i2x, &i2y);
  gfx->fillTriangle(i0x, i0y, i1x, i1y, i2x, i2y, RGB565_WHITE);

  const int barW = 18;
  const int barH = 32;
  const int gap = 5;
  const int dotR = 9;
  const int exTotal = barH + gap + 2 * dotR;
  const int barTop = yTop + (triH - exTotal) / 2 + 4;
  gfx->fillRoundRect(cx - barW / 2, barTop, barW, barH, 5, warnRed);
  const int dotCy = barTop + barH + gap + dotR;
  gfx->fillCircle(cx, dotCy, dotR, warnRed);

  const int capY = yBase + gapBaseToLabel;
  gfx->setTextSize(2);
  gfx->setTextColor(RGB565_RED);
  int tx = cx - labelW / 2;
  if (tx < cardX + padH) tx = cardX + padH;
  gfx->setCursor(tx, capY);
  gfx->print(cap);

  const int okY = capY + capBaselineToOkTop;
  const int okX = cx - okW / 2;
  g_btnTempAlreadyOkHit = { (int16_t)okX, (int16_t)okY, (int16_t)okW, (int16_t)okH };
  drawBtn(g_btnTempAlreadyOkHit, "OK", RGB565_BLACK, (uint8_t)okTextSize);
}

