static void handleCryptoNewAccountTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_optionsHomeScreen = UIScreen::CRYPTO_SETTINGS;
    show(UIScreen::BURGER_MENU);
    return;
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 4 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 5 + infoHalf);
    const int16_t padHit = 4;
    const Rect rNewAcctInfo = {
      (int16_t)(infoCx - infoHalf - padHit), (int16_t)(infoCy - infoHalf - padHit),
      (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHit), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHit)
    };
    if (hit(rNewAcctInfo, x, y)) {
      flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
      delay(85);
      show(UIScreen::CRYPTO_NEW_ACCOUNT_INFO);
      return;
    }
  }
  for (int r = 0; r < SETTIME_NUMPAD_ROWS; r++) {
    for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
      int rx = c * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
      int ry = SETTIME_NUMPAD_Y0 + r * (SETTIME_KEY_H + SETTIME_NUMPAD_GAP);
      Rect rect = { (int16_t)rx, (int16_t)ry, (int16_t)SETTIME_KEY_W, (int16_t)SETTIME_KEY_H };
      if (!hit(rect, x, y)) continue;
      if (r == 3 && c == 0) {
        backspaceStr(g_newAccountBuf, sizeof(g_newAccountBuf));
        draw();
        return;
      }
      if (r == 3 && c == 2) {
        if (strlen(g_newAccountBuf) == 0) {
          setMsg("Enter a number");
          draw();
          return;
        }
        unsigned long val = strtoul(g_newAccountBuf, nullptr, 10);
        if (val == 0) {
          setMsg("Use 1 or higher (0 is default)");
          draw();
          return;
        }
        if (val > 2147483647UL) {
          setMsg("Account too large");
          draw();
          return;
        }
        if (crypto_accounts_contains((uint32_t)val)) {
          setMsg("Already added");
          draw();
          return;
        }
        g_newAccountPending = (uint32_t)val;
        g_accountNameEditIsRename = false;
        g_newAccountNameBuf[0] = 0;
        setMsg("");
        show(UIScreen::CRYPTO_NEW_ACCOUNT_NAME);
        return;
      }
      if (r == 3 && c == 1) {
        if (strlen(g_newAccountBuf) < 10) appendChar(g_newAccountBuf, sizeof(g_newAccountBuf), '0');
        draw();
        return;
      }
      char digit = (char)('1' + r * 3 + c);
      if (strlen(g_newAccountBuf) < 10) appendChar(g_newAccountBuf, sizeof(g_newAccountBuf), digit);
      draw();
      return;
    }
  }
}

