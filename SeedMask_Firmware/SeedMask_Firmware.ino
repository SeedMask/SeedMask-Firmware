  fillRoundRectGradientV(r, rad, top, bottom);
  gfx->drawRoundRect(r.x, r.y, r.w, r.h, rad, RGB565_BLACK);
  gfx->drawRoundRect(r.x + 1, r.y + 1, r.w - 2, r.h - 2, 11, RGB565_BLACK);
  gfx->setTextColor(RGB565_BLACK);
  gfx->setTextSize(textSize);
  if (!txt) return;
  uint16_t tw = (uint16_t)(strlen(txt) * 6 * textSize);
  uint16_t th = (uint16_t)(8 * textSize);
  uint16_t tx = r.x + (r.w - tw) / 2;
  uint16_t ty = r.y + (r.h - th) / 2;
  gfx->setCursor(tx, ty);
  gfx->print(txt);
}

