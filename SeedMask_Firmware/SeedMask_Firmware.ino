static void handleAddressQrTap(uint16_t x, uint16_t y) {
  if (g_addrQrConfirmMarkUnused) {
    const int16_t popupW = 260;
    const int16_t popupH = 138;
    const int16_t popupX = (LCD_W - popupW) / 2;
    const int16_t popupY = 132;
    const Rect rYes = { (int16_t)(popupX + 16), (int16_t)(popupY + 86), 112, 40 };
    const Rect rNo = { (int16_t)(popupX + 132), (int16_t)(popupY + 86), 112, 40 };
    if (hit(rYes, x, y)) {
      addr_status_set_used(g_addrQrIndex, false);
      g_addrQrConfirmMarkUnused = false;
      draw();
      return;
    }
    if (hit(rNo, x, y) || hit(BTN_TOP_BURGER, x, y)) {
      g_addrQrConfirmMarkUnused = false;
      draw();
      return;
    }
    return;
  }
  if (g_addrQrFullscreen) {
    g_addrQrFullscreen = false;
    draw();
    g_touchIgnoreUntil = millis() + 120;
    return;
  }
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_addrQrFullscreen = false;
    g_optionsHomeScreen = g_addrExplorerFromBitcoin ? UIScreen::CRYPTO_HOME : UIScreen::MENU;
    show(UIScreen::BURGER_MENU);
    return;
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    const int16_t padHit = 4;
    const Rect rAddrInfo = {
      (int16_t)(infoCx - infoHalf - padHit), (int16_t)(infoCy - infoHalf - padHit),
      (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHit), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHit)
    };
    if (hit(rAddrInfo, x, y)) {
      g_addressInfoReturnScreen = UIScreen::ADDRESS_QR;
      flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
      delay(85);
      show(UIScreen::ADDRESS_EXPLORER_INFO);
      return;
    }
  }
  if (hit(g_addrQrSearchHit, x, y)) {
    flashAddrQrSearchHitLight();
    g_addrQrFullscreen = false;
    if (g_addrQrFromMultisigReceive) {
      g_addrExplorerMultisig = true;
      g_addrExplorerStep = AddrExplorerStep::LIST;
      g_addrPage = g_addrQrIndex / (uint32_t)ADDR_PAGE_ROWS;
      invalidate_address_explorer_cache();
      show(UIScreen::ADDRESS_EXPLORER);
    } else {
      show(UIScreen::ADDRESS_EXPLORER);
    }
    return;
  }
  if (hit(g_addrQrUsedToggleHit, x, y)) {
    if (addr_status_is_used(g_addrQrIndex)) {
      g_addrQrConfirmMarkUnused = true;
    } else {
      addr_status_set_used(g_addrQrIndex, true);
    }
    draw();
    return;
  }
  if (g_addrDetail[0] && g_addrQrQrHit.w > 0 && hit(g_addrQrQrHit, x, y)) {
    g_addrQrFullscreen = true;
    draw();
    g_touchIgnoreUntil = millis() + 120;
    return;
  }
}

