static const char* dw_separator_label(uint8_t sepRaw) {
  DwSeparator sep = (DwSeparator)sepRaw;
  switch (sep) {
    case DwSeparator::HYPHEN: return "Hyphen";
    case DwSeparator::SPACE: return "Space";
    case DwSeparator::UNDERSCORE: return "Underscore";
    case DwSeparator::COMMA: return "Comma";
    case DwSeparator::PERIOD: return "Period";
    default: return "Hyphen";
  }
}

static int pw_advanced_panel_row_count(void) {
  if (g_pwGenMode == PwGenMode::BIP85) {
    switch (g_pwBip85AdvPanel) {
      case Bip85PwAdvPanel::ROOT:
        return g_pwBip85LocalPassphrase[0] ? 3 : 2;
      case Bip85PwAdvPanel::TYPE_MENU:
        return 3;
      case Bip85PwAdvPanel::RAND_STRENGTH:
        return 4;
      case Bip85PwAdvPanel::DICEWARE_WORDS:
        return 2;
    }
  }
  if (g_pwGenMode == PwGenMode::DICEWARE)
    return g_dwSeparatorPickerOpen ? 6 : 2;
  return 4;
}

static void drawPwAdvancedGeneratorOverlay() {
  if (!g_pwAdvancedPanelOpen) return;
  Rect rAdv = pwAdvancedBtnRect();
  int panelTop = rAdv.y + rAdv.h + 2;
  if (panelTop >= LCD_H) return;

  const int sheetSideInset = 5;
  const int sheetRad = 10;
  const int sheetX = sheetSideInset;
  const int sheetW = LCD_W - 2 * sheetSideInset;
  const int rowX = sheetX + 11;
  const int rowW = sheetW - 22;
  const int rowH = 34;
  const int rowY = panelTop + 19;  // lifted 15px higher from previous placement
  int numRows = pw_advanced_panel_row_count();
  const int bottomPad = 12;
  const int rowBlockBottom = rowY + numRows * rowH;
  const int sheetBottom = rowBlockBottom + bottomPad;
  int sheetH = sheetBottom - panelTop;
  if (sheetH < 12) sheetH = 12;
  if (panelTop + sheetH > LCD_H) sheetH = LCD_H - panelTop;

  gfx->fillRoundRect(sheetX, panelTop, sheetW, sheetH, sheetRad, RGB565(18, 28, 48));
  gfx->drawRoundRect(sheetX, panelTop, sheetW, sheetH, sheetRad, UI_ACCENT);

  auto drawToggleKnob = [&](int x, int y, bool on) {
    const int swW = 40, swH = 16;
    gfx->fillRoundRect(x, y, swW, swH, 8, on ? UI_SUCCESS : RGB565_DARKGREY);
    gfx->drawRoundRect(x, y, swW, swH, 8, UI_BORDER);
    int kx = on ? (x + swW - 14) : (x + 2);
    gfx->fillRoundRect(kx, y + 2, 12, 12, 6, UI_TEXT);
  };

  auto drawRowText = [&](int idx, const char* label, const char* right) {
    int ry = rowY + idx * rowH;
    if (idx > 0) gfx->drawFastHLine(rowX, ry - 2, rowW, UI_BORDER);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(1);
    gfx->setCursor(rowX + 2, ry + 10);
    gfx->print(label);
    if (right && right[0]) {
      uint16_t tw = (uint16_t)(strlen(right) * 6u);
      gfx->setTextColor(RGB565(175, 188, 210));
      gfx->setCursor(rowX + rowW - (int)tw - 2, ry + 10);
      gfx->print(right);
    }
  };

  auto drawToggleRow = [&](int idx, const char* label, bool on) {
    drawRowText(idx, label, "");
    int ry = rowY + idx * rowH;
    drawToggleKnob(rowX + rowW - 44, ry + 8, on);
  };

  if (g_pwGenMode == PwGenMode::BIP85) {
    switch (g_pwBip85AdvPanel) {
      case Bip85PwAdvPanel::ROOT:
        {
          char sum[40];
          if (g_pwBip85OutType == Bip85PwOutType::RANDOM) {
            const char* tr = g_pwBip85RandTier == Bip85PwRandTier::SIMPLE   ? "Simple"
                             : g_pwBip85RandTier == Bip85PwRandTier::STRONG ? "Strong"
                                                                            : "Complex";
            snprintf(sum, sizeof(sum), "Rand - %s", tr);
          } else if (g_pwBip85OutType == Bip85PwOutType::DICEWARE) {
            snprintf(sum, sizeof(sum), "Dice - %uw", (unsigned)g_pwBip85DwWords);
          } else {
            snprintf(sum, sizeof(sum), "Hex");
          }
          drawRowText(0, "Type of password", sum);
          drawRowText(1, "Passphrase", g_pwBip85LocalPassphrase[0] ? "(active)" : "Tap to set");
          if (g_pwBip85LocalPassphrase[0])
            drawRowText(2, "Fingerprint", g_pwBip85LocalPassphraseFp);
          break;
        }
      case Bip85PwAdvPanel::TYPE_MENU:
        drawRowText(0, "Random characters", g_pwBip85OutType == Bip85PwOutType::RANDOM ? "Selected" : "");
        drawRowText(1, "Diceware", g_pwBip85OutType == Bip85PwOutType::DICEWARE ? "Selected" : "");
        drawRowText(2, "Hex", g_pwBip85OutType == Bip85PwOutType::PW_HEX ? "Selected" : "");
        break;
      case Bip85PwAdvPanel::RAND_STRENGTH:
        drawRowText(0, "< Back", "");
        drawRowText(1, "Simple", g_pwBip85RandTier == Bip85PwRandTier::SIMPLE ? "Selected" : "");
        drawRowText(2, "Strong", g_pwBip85RandTier == Bip85PwRandTier::STRONG ? "Selected" : "");
        drawRowText(3, "Complex", g_pwBip85RandTier == Bip85PwRandTier::COMPLEX ? "Selected" : "");
        break;
      case Bip85PwAdvPanel::DICEWARE_WORDS:
        {
          char wc[16];
          snprintf(wc, sizeof(wc), "%u words", (unsigned)g_pwBip85DwWords);
          drawRowText(0, "< Back", "");
          drawRowText(1, "Word count", wc);
          break;
        }
    }
  } else if (g_pwGenMode == PwGenMode::DICEWARE) {
    if (!g_dwSeparatorPickerOpen) {
      char sep[24];
      snprintf(sep, sizeof(sep), "%s  >", dw_separator_label((uint8_t)g_dwSeparator));
      drawRowText(0, "Word separator", sep);
      drawToggleRow(1, "Uppercase", g_dwCapitalize);
    } else {
      drawRowText(0, "< Back", "");
      drawRowText(1, "Hyphen", g_dwSeparator == DwSeparator::HYPHEN ? "Selected" : "");
      drawRowText(2, "Space", g_dwSeparator == DwSeparator::SPACE ? "Selected" : "");
      drawRowText(3, "Underscore", g_dwSeparator == DwSeparator::UNDERSCORE ? "Selected" : "");
      drawRowText(4, "Comma", g_dwSeparator == DwSeparator::COMMA ? "Selected" : "");
      drawRowText(5, "Period", g_dwSeparator == DwSeparator::PERIOD ? "Selected" : "");
    }
  } else {
    drawToggleRow(0, "Uppercase letters", g_randClassUpper);
    drawToggleRow(1, "Lowercase letters", g_randClassLower);
    drawToggleRow(2, "Numbers", g_randClassDigit);
    drawToggleRow(3, "Symbols", g_randClassSym);
  }
}

