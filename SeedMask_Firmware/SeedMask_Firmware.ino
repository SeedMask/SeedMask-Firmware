static bool nav_recent_is_current(UIScreen s) {
  if (s == g_screen) return true;
  if (s == UIScreen::PASSWORDS && g_screen == UIScreen::EDITOR && g_prevScreen != UIScreen::NOTES) return true;
  if (s == UIScreen::NOTES && g_screen == UIScreen::EDITOR && g_prevScreen == UIScreen::NOTES) return true;
  if (isCryptoModeScreen(g_screen) && s == nav_recent_snapshot_key(g_screen)) return true;
  return false;
}

static void nav_blit_thumb(const uint16_t* src, int dx, int dy, int dw, int dh) {
  if (!src || dw <= 0 || dh <= 0) return;
  uint16_t* fb = gfx->getFramebuffer();
  const float dstAspect = (float)dw / (float)dh;
  const float srcAspect = (float)NAV_THUMB_W / (float)NAV_THUMB_H;
  int cropX = 0, cropY = 0, cropW = NAV_THUMB_W, cropH = NAV_THUMB_H;
  if (srcAspect > dstAspect) {
    cropW = (int)((float)NAV_THUMB_H * dstAspect + 0.5f);
    if (cropW < 1) cropW = 1;
    cropX = (NAV_THUMB_W - cropW) / 2;
  } else {
    cropH = (int)((float)NAV_THUMB_W / dstAspect + 0.5f);
    if (cropH < 1) cropH = 1;
    cropY = (NAV_THUMB_H - cropH) / 2;
  }
  for (int py = 0; py < dh; py++) {
    int sy = cropY + (dh > 1 ? (py * (cropH - 1) / (dh - 1)) : 0);
    if (sy >= NAV_THUMB_H) sy = NAV_THUMB_H - 1;
    for (int px = 0; px < dw; px++) {
      int sx = cropX + (dw > 1 ? (px * (cropW - 1) / (dw - 1)) : 0);
      if (sx >= NAV_THUMB_W) sx = NAV_THUMB_W - 1;
      uint16_t c = src[(size_t)sy * (size_t)NAV_THUMB_W + (size_t)sx];
      int fx = dx + px;
      int fy = dy + py;
      if (fb && fx >= 0 && fx < LCD_W && fy >= 0 && fy < LCD_H)
        fb[(size_t)fy * (size_t)LCD_W + (size_t)fx] = c;
      else
        gfx->drawPixel(fx, fy, c);
    }
  }
}

static int nav_switcher_pitch() {
  return NAV_SWITCH_SLOT_PITCH;
}

static int nav_switcher_max_scroll() {
  if (g_navRecentCount <= 1) return 0;
  return ((int)g_navRecentCount - 1) * nav_switcher_pitch();
}

static int nav_switcher_focus_index() {
  if (g_navRecentCount == 0) return 0;
  const int pitch = nav_switcher_pitch();
  int idx = ((int)g_navSwitcherScrollPx + pitch / 2) / pitch;
  if (idx < 0) idx = 0;
  if (idx >= (int)g_navRecentCount) idx = (int)g_navRecentCount - 1;
  return idx;
}

static void nav_switcher_clamp_scroll() {
  if (g_navSwitcherActive && g_navSwitcherTouchMode == NavSwitcherTouchMode::SCROLL) return;
  int maxS = nav_switcher_max_scroll();
  if ((int)g_navSwitcherScrollPx < 0) g_navSwitcherScrollPx = 0;
  if ((int)g_navSwitcherScrollPx > maxS) g_navSwitcherScrollPx = (int16_t)maxS;
}

static int nav_switcher_snap_target_px(int scrollPx, int scrollVelPxPerSec) {
  if (g_navRecentCount <= 1) return 0;
  const int pitch = nav_switcher_pitch();
  const int maxS = nav_switcher_max_scroll();
  int clamped = scrollPx;
  if (clamped < 0) clamped = 0;
  if (clamped > maxS) clamped = maxS;

  float idx = (float)clamped / (float)pitch;
  if (scrollVelPxPerSec > NAV_SWITCH_FLING_VEL_PX_S) idx += 0.42f;
  else if (scrollVelPxPerSec < -NAV_SWITCH_FLING_VEL_PX_S) idx -= 0.42f;

  int i = (int)(idx + 0.5f);
  if (i < 0) i = 0;
  if (i >= (int)g_navRecentCount) i = (int)g_navRecentCount - 1;
  return i * pitch;
}

static void nav_switcher_start_snap_anim(int targetPx, uint32_t nowMs) {
  g_navSwitcherSnapAnimFromPx = (int)g_navSwitcherScrollPx;
  g_navSwitcherSnapAnimToPx = targetPx;
  g_navSwitcherSnapAnimStartMs = nowMs;
  g_navSwitcherSnapAnimLastDrawMs = nowMs;
  g_navSwitcherSnapAnimActive = true;
}

static void nav_switcher_sample_scroll_velocity(uint32_t nowMs) {
  if (g_navSwitcherVelSampleMs == 0) {
    g_navSwitcherVelSampleScrollPx = g_navSwitcherScrollPx;
    g_navSwitcherVelSampleMs = nowMs;
    return;
  }
  uint32_t dt = nowMs - g_navSwitcherVelSampleMs;
  if (dt == 0 || dt > 120) return;
  int ds = (int)g_navSwitcherScrollPx - (int)g_navSwitcherVelSampleScrollPx;
  g_navSwitcherScrollVelPxPerSec = (ds * 1000) / (int)dt;
  g_navSwitcherVelSampleScrollPx = g_navSwitcherScrollPx;
  g_navSwitcherVelSampleMs = nowMs;
}

static float nav_switcher_card_scale_for_index(int cardIdx, int focusIdx) {
  if (g_navRecentCount <= 1) return 1.0f;
  return (cardIdx == focusIdx) ? 1.0f : NAV_SWITCH_SIDE_CARD_SCALE;
}

static void nav_switcher_card_layout(uint8_t i, int focusIdx, int cardW, int cardH, int cardY, int pitch,
                                     int centerX, int scroll, int& outCardX, int& outDrawY,
                                     int& outSx, int& outSy, int& outSw, int& outSh) {
  outCardX = centerX - cardW / 2 + (int)i * pitch - scroll;
  const float scale = nav_switcher_card_scale_for_index((int)i, focusIdx);
  outSw = (int)((float)cardW * scale);
  outSh = (int)((float)cardH * scale);
  outDrawY = nav_switcher_card_draw_y((int)i, cardY);
  outSx = outCardX + (cardW - outSw) / 2;
  outSy = outDrawY + (cardH - outSh) / 2;
}

static bool nav_switcher_card_visual_hit(uint8_t i, int tx, int ty) {
  const int cardW = NAV_SWITCH_CARD_W;
  const int cardH = NAV_SWITCH_CARD_H;
  const int cardY = NAV_SWITCH_CARD_Y;
  const int pitch = nav_switcher_pitch();
  const int centerX = LCD_W / 2;
  const int scroll = (int)g_navSwitcherScrollPx;
  const int focusIdx = nav_switcher_focus_index();
  int cardX, drawY, sx, sy, sw, sh;
  nav_switcher_card_layout(i, focusIdx, cardW, cardH, cardY, pitch, centerX, scroll,
                           cardX, drawY, sx, sy, sw, sh);
  if (cardX + cardW < -48 || cardX > LCD_W + 48) return false;
  const int pad = NAV_SWITCH_CARD_HIT_PAD;
  return (tx >= sx - pad && tx < sx + sw + pad && ty >= sy - pad && ty < sy + sh + pad);
}

static bool nav_switcher_hit_card(int tx, int ty, uint8_t& outIdx) {
  if (g_navRecentCount == 0) return false;
  const int focusIdx = nav_switcher_focus_index();

  if (nav_switcher_card_visual_hit((uint8_t)focusIdx, tx, ty)) {
    outIdx = (uint8_t)focusIdx;
    return true;
  }

  uint8_t bestSide = 0;
  int bestSideDist = 1000000;
  bool sideHit = false;
  const int centerX = LCD_W / 2;
  const int cardW = NAV_SWITCH_CARD_W;
  const int pitch = nav_switcher_pitch();
  const int scroll = (int)g_navSwitcherScrollPx;
  for (uint8_t i = 0; i < g_navRecentCount; i++) {
    if ((int)i == focusIdx) continue;
    if (!nav_switcher_card_visual_hit(i, tx, ty)) continue;
    const int cardX = centerX - cardW / 2 + (int)i * pitch - scroll;
    const int dist = abs(cardX + cardW / 2 - centerX);
    if (dist < bestSideDist) {
      bestSideDist = dist;
      bestSide = i;
      sideHit = true;
    }
  }
  if (sideHit) {
    outIdx = bestSide;
    return true;
  }
  return false;
}

static bool nav_switcher_carousel_zone_contains(int tx, int ty) {
  const int top = NAV_SWITCH_CARD_Y - NAV_SWITCH_CAROUSEL_PAD_Y;
  const int bottom = NAV_SWITCH_CARD_Y + NAV_SWITCH_CARD_H + NAV_SWITCH_CAROUSEL_PAD_Y;
  return tx >= NAV_SWITCH_CAROUSEL_PAD_X && tx < LCD_W - NAV_SWITCH_CAROUSEL_PAD_X
         && ty >= top && ty < bottom;
}

/** One sticky mode per touch: dominant axis wins; tap only if still undecided on release. */
static NavSwitcherTouchMode nav_switcher_update_touch_mode(int dx, int dy,
                                                           NavSwitcherTouchMode mode, bool hasCard) {
  if (mode == NavSwitcherTouchMode::SCROLL)
    return NavSwitcherTouchMode::SCROLL;
  if (mode == NavSwitcherTouchMode::DISMISS) {
    if (abs(dx) > NAV_SWITCH_SCROLL_STEAL_DX
        && abs(dx) > abs(dy) + NAV_SWITCH_AXIS_MARGIN)
      return NavSwitcherTouchMode::SCROLL;
    return NavSwitcherTouchMode::DISMISS;
  }
  const int adx = abs(dx);
  const int ady = abs(dy);
  if (adx < NAV_SWITCH_AXIS_SLOP && ady < NAV_SWITCH_AXIS_SLOP)
    return NavSwitcherTouchMode::UNDECIDED;
  if (g_navRecentCount > 1
      && adx >= NAV_SWITCH_SCROLL_LOCK_DX
      && adx > ady + NAV_SWITCH_AXIS_MARGIN)
    return NavSwitcherTouchMode::SCROLL;
  if (hasCard
      && dy < -(int)NAV_SWITCH_DISMISS_LOCK_DY
      && ady > adx + NAV_SWITCH_AXIS_MARGIN)
    return NavSwitcherTouchMode::DISMISS;
  return NavSwitcherTouchMode::UNDECIDED;
}

static bool nav_switcher_release_is_tap(int dx, int dy, bool scrollLocked,
                                        NavSwitcherTouchMode releaseMode, int dismissDragY) {
  if (scrollLocked || releaseMode == NavSwitcherTouchMode::SCROLL)
    return false;
  if (releaseMode == NavSwitcherTouchMode::DISMISS) {
    if (dismissDragY <= -12 || dy <= -12)
      return false;
  }
  return abs(dx) <= (int)NAV_SWITCH_TAP_MAX_DX
         && abs(dy) <= (int)NAV_SWITCH_TAP_MAX_DY;
}

static bool nav_switcher_release_is_scroll(int dx, int dy, bool scrollLocked,
                                           NavSwitcherTouchMode releaseMode) {
  if (scrollLocked || releaseMode == NavSwitcherTouchMode::SCROLL)
    return true;
  if (g_navRecentCount <= 1)
    return false;
  const int adx = abs(dx);
  return adx >= NAV_SWITCH_SCROLL_LOCK_DX
         && adx > abs(dy) + NAV_SWITCH_AXIS_MARGIN;
}

static int nav_switcher_card_dismiss_offset_y() {
  if (g_navSwitcherScrollLocked
      || g_navSwitcherTouchMode == NavSwitcherTouchMode::SCROLL)
    return 0;
  if (g_navSwitcherDismissAnimActive) {
    uint32_t elapsed = millis() - g_navSwitcherDismissAnimStartMs;
    float u = (float)elapsed / (float)NAV_SWITCH_DISMISS_ANIM_MS;
    if (u > 1.f) u = 1.f;
    float t = 1.f - (1.f - u) * (1.f - u);
    return (int)(g_navSwitcherDismissAnimFromY
                 + (g_navSwitcherDismissAnimToY - g_navSwitcherDismissAnimFromY) * t);
  }
  if (g_navSwitcherDismissCardIdx >= 0
      && g_navSwitcherTouchMode == NavSwitcherTouchMode::DISMISS)
    return (int)g_navSwitcherDismissDragY;
  return 0;
}

static int nav_switcher_card_draw_y(int cardIdx, int cardY) {
  if (g_navSwitcherDismissAnimActive && cardIdx == (int)g_navSwitcherDismissAnimRemoveIdx)
    return cardY + nav_switcher_card_dismiss_offset_y();
  if (g_navSwitcherTouchMode == NavSwitcherTouchMode::DISMISS
      && cardIdx == (int)g_navSwitcherDismissCardIdx)
    return cardY + nav_switcher_card_dismiss_offset_y();
  return cardY;
}

static int nav_switcher_find_focus_index() {
  for (uint8_t i = 0; i < g_navRecentCount; i++) {
    if (nav_recent_is_current(g_navRecent[i].screen)) return (int)i;
  }
  return (g_navRecentCount > 0) ? (int)g_navRecentCount - 1 : 0;
}

static void nav_draw_switcher_card(int x, int y, int w, int h, uint8_t recentIdx, bool current, float scale) {
  if (recentIdx >= g_navRecentCount) return;
  if (scale < 0.5f) scale = 0.5f;
  if (scale > 1.0f) scale = 1.0f;
  const int sw = (int)((float)w * scale);
  const int sh = (int)((float)h * scale);
  const int sx = x + (w - sw) / 2;
  const int sy = y + (h - sh) / 2;
  const NavRecentEntry& e = g_navRecent[recentIdx];
  if (e.hasThumb) {
    const uint16_t* src = nav_recent_thumb_row(recentIdx);
    if (src) nav_blit_thumb(src, sx, sy, sw, sh);
    else gfx->fillRoundRect(sx, sy, sw, sh, 16, blendRGB565(UI_CARD, UI_ACCENT, 0.35f));
  } else {
    gfx->fillRoundRect(sx, sy, sw, sh, 16, blendRGB565(UI_CARD, UI_ACCENT, 0.35f));
  }
  gfx->drawRoundRect(sx, sy, sw, sh, 16, blendRGB565(UI_BORDER, RGB565_WHITE, 0.28f));
  if (current)
    gfx->drawRoundRect(sx - 2, sy - 2, sw + 4, sh + 4, 18, RGB565_WHITE);
}

static void nav_switcher_snap_to_nearest() {
  if (g_navRecentCount == 0) {
    g_navSwitcherScrollPx = 0;
    return;
  }
  g_navSwitcherScrollPx = (int16_t)(nav_switcher_focus_index() * nav_switcher_pitch());
}

static void nav_switcher_reset_touch() {
  g_navSwitcherTouchMode = NavSwitcherTouchMode::NONE;
  g_navSwitcherTouchDownX = 0;
  g_navSwitcherTouchDownY = 0;
  g_navSwitcherScrollAtTouchDown = g_navSwitcherScrollPx;
  g_navSwitcherReleaseStartMs = 0;
  g_navSwitcherActive = false;
  g_navSwitcherSnapAnimActive = false;
  g_navSwitcherVelSampleScrollPx = g_navSwitcherScrollPx;
  g_navSwitcherVelSampleMs = 0;
  g_navSwitcherScrollVelPxPerSec = 0;
  g_navSwitcherLastDrawScrollPx = g_navSwitcherScrollPx;
  g_navSwitcherLastDrawMs = 0;
  g_navSwitcherBarTracking = false;
  g_navSwitcherConsumeRelease = false;
  g_navSwitcherDismissCardIdx = -1;
  g_navSwitcherTapDownCardIdx = -1;
  g_navSwitcherPressCardIdx = -1;
  g_navSwitcherDismissDragY = 0;
  g_navSwitcherDismissAnimActive = false;
  g_navSwitcherDismissAnimRemoveIdx = 255;
  g_navSwitcherScrollLocked = false;
}

static void nav_switcher_start_dismiss_anim(int fromY, int toY, uint8_t removeIdx) {
  g_navSwitcherDismissAnimFromY = (int16_t)fromY;
  g_navSwitcherDismissAnimToY = (int16_t)toY;
  g_navSwitcherDismissAnimRemoveIdx = (toY < 0) ? removeIdx : 255;
  g_navSwitcherDismissCardIdx = (int8_t)removeIdx;
  g_navSwitcherDismissAnimStartMs = millis();
  g_navSwitcherDismissAnimLastDrawMs = millis();
  g_navSwitcherDismissAnimActive = true;
  g_navSwitcherSnapAnimActive = false;
}

static void nav_switcher_finish_bar_gesture(int x, int y) {
  if (g_navSwitcherConsumeRelease) {
    g_navSwitcherConsumeRelease = false;
    nav_switcher_reset_touch();
    return;
  }
  const int dx = x - (int)g_navSwitcherTouchDownX;
  const int dy = y - (int)g_navSwitcherTouchDownY;
  nav_switcher_reset_touch();
  nav_overlay_close();
}

static void nav_switcher_reanchor_touch(int x, int y) {
  g_navSwitcherSnapAnimActive = false;
  g_navSwitcherVelSampleMs = 0;
  g_navSwitcherScrollVelPxPerSec = 0;
  g_navSwitcherTouchDownX = (int16_t)x;
  g_navSwitcherTouchDownY = (int16_t)y;
  g_navSwitcherScrollAtTouchDown = g_navSwitcherScrollPx;
  g_navSwitcherReleaseStartMs = 0;
  g_navSwitcherConsumeRelease = true;
  if (nav_switcher_bar_zone_contains((uint16_t)x, (uint16_t)y)) {
    g_navSwitcherBarTracking = true;
    g_navSwitcherActive = false;
    g_navSwitcherTouchMode = NavSwitcherTouchMode::NONE;
  } else {
    g_navSwitcherBarTracking = false;
    g_navSwitcherActive = true;
    g_navSwitcherTouchMode = NavSwitcherTouchMode::UNDECIDED;
  }
}

static void nav_switcher_redraw_only() {
  if (g_navOverlay != NavOverlay::APP_SWITCHER) return;
  drawNavAppSwitcher();
  if (gfx) gfx->flush();
}

static void nav_switcher_close_all() {
  g_navRecentCount = 0;
  g_navSwitcherScrollPx = 0;
  nav_switcher_reset_touch();
  g_navOverlay = NavOverlay::NONE;
  g_navSkipNextShowSnapshot = true;
  if (nav_bar_on_crypto_side())
    show(UIScreen::CRYPTO_HOME);
  else
    show(UIScreen::MENU);
  g_touchIgnoreUntil = millis() + 220;
}

static void nav_switcher_open_card(uint8_t idx) {
  if (idx >= g_navRecentCount) return;
  g_navOverlay = NavOverlay::NONE;
  nav_switcher_reset_touch();
  if (g_editMode != EditMode::NONE) exitEditor();
  g_navSkipNextShowSnapshot = true;
  show(g_navRecent[idx].screen);
  g_touchIgnoreUntil = millis() + 220;
}

static void nav_switcher_dismiss_card(uint8_t idx) {
  if (idx >= g_navRecentCount) return;
  nav_recent_remove_at(idx);
  nav_switcher_snap_to_nearest();
  nav_switcher_clamp_scroll();
  g_navSwitcherDismissCardIdx = -1;
  g_navSwitcherDismissDragY = 0;
  if (g_navRecentCount == 0) {
    nav_switcher_close_all();
    return;
  }
  nav_switcher_redraw_only();
}

static void nav_switcher_tick(uint32_t nowMs) {
  if (g_navOverlay != NavOverlay::APP_SWITCHER) return;

  if (g_navSwitcherDismissAnimActive) {
    if ((uint32_t)(nowMs - g_navSwitcherDismissAnimLastDrawMs) >= NAV_SWITCH_SCROLL_REDRAW_MIN_MS) {
      g_navSwitcherDismissAnimLastDrawMs = nowMs;
      nav_switcher_redraw_only();
    }
    if ((uint32_t)(nowMs - g_navSwitcherDismissAnimStartMs) >= NAV_SWITCH_DISMISS_ANIM_MS) {
      g_navSwitcherDismissAnimActive = false;
      const uint8_t rmIdx = g_navSwitcherDismissAnimRemoveIdx;
      g_navSwitcherDismissDragY = 0;
      g_navSwitcherDismissCardIdx = -1;
      if (g_navSwitcherDismissAnimToY < 0 && rmIdx != 255 && rmIdx < g_navRecentCount)
        nav_switcher_dismiss_card(rmIdx);
      else
        nav_switcher_redraw_only();
    }
    return;
  }

  if (!g_navSwitcherSnapAnimActive) return;
  uint32_t elapsed = nowMs - g_navSwitcherSnapAnimStartMs;
  if (elapsed >= NAV_SWITCH_SNAP_ANIM_MS) {
    g_navSwitcherScrollPx = (int16_t)g_navSwitcherSnapAnimToPx;
    g_navSwitcherSnapAnimActive = false;
    nav_switcher_redraw_only();
    return;
  }
  float u = (float)elapsed / (float)NAV_SWITCH_SNAP_ANIM_MS;
  float t = 1.f - (1.f - u) * (1.f - u) * (1.f - u);
  g_navSwitcherScrollPx = (int16_t)(g_navSwitcherSnapAnimFromPx
                                    + (int)((g_navSwitcherSnapAnimToPx - g_navSwitcherSnapAnimFromPx) * t));
  if ((uint32_t)(nowMs - g_navSwitcherSnapAnimLastDrawMs) >= NAV_SWITCH_SCROLL_REDRAW_MIN_MS) {
    g_navSwitcherSnapAnimLastDrawMs = nowMs;
    nav_switcher_redraw_only();
  }
}

static void nav_switcher_set_scroll_px(int next, uint32_t nowMs, bool forceDraw) {
  g_navSwitcherSnapAnimActive = false;
  const int maxS = nav_switcher_max_scroll();
  if (g_navSwitcherActive && g_navSwitcherTouchMode == NavSwitcherTouchMode::SCROLL) {
    if (next < 0) next = next / 3;
    else if (next > maxS) next = maxS + (next - maxS) / 3;
  } else {
    if (next < 0) next = 0;
    if (next > maxS) next = maxS;
  }
  if (next == (int)g_navSwitcherScrollPx) return;
  g_navSwitcherScrollPx = (int16_t)next;
  nav_switcher_sample_scroll_velocity(nowMs);

  bool shouldDraw = forceDraw;
  if (!shouldDraw) {
    const int delta = abs(next - (int)g_navSwitcherLastDrawScrollPx);
    shouldDraw = (delta >= NAV_SWITCH_SCROLL_REDRAW_MIN_PX)
                 || (g_navSwitcherLastDrawMs == 0)
                 || ((uint32_t)(nowMs - g_navSwitcherLastDrawMs) >= NAV_SWITCH_SCROLL_REDRAW_MIN_MS);
  }
  if (shouldDraw) {
    g_navSwitcherLastDrawScrollPx = g_navSwitcherScrollPx;
    g_navSwitcherLastDrawMs = nowMs;
    nav_switcher_redraw_only();
  }
}

static void nav_switcher_finish_scroll_snap(uint32_t nowMs) {
  if (g_navRecentCount > 1) {
    const int targetPx = nav_switcher_snap_target_px((int)g_navSwitcherScrollPx, g_navSwitcherScrollVelPxPerSec);
    if (abs(targetPx - (int)g_navSwitcherScrollPx) <= 2) {
      g_navSwitcherScrollPx = (int16_t)targetPx;
      nav_switcher_redraw_only();
    } else {
      nav_switcher_start_snap_anim(targetPx, nowMs);
      nav_switcher_redraw_only();
    }
  } else {
    g_navSwitcherScrollPx = 0;
    nav_switcher_redraw_only();
  }
}

static void nav_switcher_begin_gesture(int x, int y) {
  g_navSwitcherSnapAnimActive = false;
  g_navSwitcherDismissAnimActive = false;
  g_navSwitcherVelSampleMs = 0;
  g_navSwitcherScrollVelPxPerSec = 0;
  g_navSwitcherTouchDownX = (int16_t)x;
  g_navSwitcherTouchDownY = (int16_t)y;
  g_navSwitcherScrollAtTouchDown = g_navSwitcherScrollPx;
  g_navSwitcherReleaseStartMs = 0;
  g_navSwitcherDismissDragY = 0;
  g_navSwitcherDismissCardIdx = -1;
  g_navSwitcherTapDownCardIdx = -1;
  g_navSwitcherPressCardIdx = -1;
  g_navSwitcherScrollLocked = false;
  uint8_t hitIdx = 0;
  if (nav_switcher_hit_card(x, y, hitIdx)) {
    g_navSwitcherDismissCardIdx = (int8_t)hitIdx;
    g_navSwitcherTapDownCardIdx = (int8_t)hitIdx;
    g_navSwitcherPressCardIdx = (int8_t)hitIdx;
  }
  g_navSwitcherActive = true;
  g_navSwitcherTouchMode = NavSwitcherTouchMode::UNDECIDED;
}

static void nav_switcher_finish_gesture(int x, int y, uint32_t nowMs) {
  if (!g_navSwitcherActive) return;

  const int dx = x - (int)g_navSwitcherTouchDownX;
  const int dy = y - (int)g_navSwitcherTouchDownY;
  const bool scrollLocked = g_navSwitcherScrollLocked;
  const NavSwitcherTouchMode releaseMode = g_navSwitcherTouchMode;
  const int8_t dismissIdx = g_navSwitcherDismissCardIdx;
  const int8_t pressCardIdx = g_navSwitcherPressCardIdx;
  const int16_t dismissDragY = g_navSwitcherDismissDragY;
  const bool gestureBlocked = scrollLocked
                              || releaseMode == NavSwitcherTouchMode::SCROLL
                              || releaseMode == NavSwitcherTouchMode::DISMISS;

  g_navSwitcherActive = false;
  g_navSwitcherTouchMode = NavSwitcherTouchMode::NONE;
  g_navSwitcherReleaseStartMs = 0;

  if (g_navSwitcherConsumeRelease) {
    g_navSwitcherConsumeRelease = false;
    g_navSwitcherDismissCardIdx = -1;
    g_navSwitcherTapDownCardIdx = -1;
    g_navSwitcherPressCardIdx = -1;
    return;
  }

  if (!gestureBlocked
      && (hit(g_navSwitcherCloseAllHit, (int16_t)x, (int16_t)y)
          || hit(g_navSwitcherCloseAllHit, g_navSwitcherTouchDownX, g_navSwitcherTouchDownY))) {
    nav_switcher_close_all();
    return;
  }

  if (releaseMode == NavSwitcherTouchMode::DISMISS && dismissIdx >= 0 && !scrollLocked) {
    if (dismissDragY <= -NAV_SWIPE_DISMISS_COMMIT_DY || dy <= -NAV_SWIPE_DISMISS_COMMIT_DY) {
      const int fromY = (dismissDragY < 0) ? (int)dismissDragY : dy;
      nav_switcher_start_dismiss_anim(fromY, -LCD_H, (uint8_t)dismissIdx);
      return;
    }
    if (dismissDragY <= -8 || dy <= -8) {
      const int fromY = (dismissDragY < 0) ? (int)dismissDragY : dy;
      nav_switcher_start_dismiss_anim(fromY, 0, 255);
      return;
    }
  }

  if (dy > NAV_SWIPE_MIN_DY && dy > abs(dx)) {
    nav_overlay_close();
    return;
  }

  if (pressCardIdx >= 0 && (uint8_t)pressCardIdx < g_navRecentCount
      && nav_switcher_release_is_tap(dx, dy, scrollLocked, releaseMode, (int)dismissDragY)) {
    nav_switcher_open_card((uint8_t)pressCardIdx);
    return;
  }

  uint8_t tapIdx = 0;
  if (nav_switcher_release_is_tap(dx, dy, scrollLocked, releaseMode, (int)dismissDragY)
      && nav_switcher_hit_card(x, y, tapIdx)) {
    nav_switcher_open_card(tapIdx);
    return;
  }

  if (nav_switcher_release_is_scroll(dx, dy, scrollLocked, releaseMode)) {
    nav_switcher_finish_scroll_snap(nowMs);
    return;
  }

  if (dismissIdx >= 0
      && dy < -(int)NAV_SWITCH_DISMISS_LOCK_DY
      && abs(dy) > abs(dx) + NAV_SWITCH_AXIS_MARGIN) {
    const int upY = (dismissDragY < 0) ? (int)dismissDragY : dy;
    if (upY <= -NAV_SWIPE_DISMISS_COMMIT_DY) {
      nav_switcher_start_dismiss_anim(upY, -LCD_H, (uint8_t)dismissIdx);
      return;
    }
    if (upY <= -(int)NAV_SWITCH_DISMISS_LOCK_DY) {
      nav_switcher_start_dismiss_anim(upY, 0, 255);
      return;
    }
  }

  const int cardTop = NAV_SWITCH_CARD_Y - 12;
  const int cardBottom = NAV_SWITCH_CARD_Y + NAV_SWITCH_CARD_H + 56;
  if (y < cardTop || y > cardBottom)
    nav_overlay_close();
}

/** Phone-style recents touch: nav bar isolated; card carousel separate. */
static void nav_switcher_handle_touch(bool physPressed, bool wasPressed, int x, int y, uint32_t nowMs) {
  if (g_navSwitcherDismissAnimActive) return;

  if (physPressed)
    g_navSwitcherReleaseStartMs = 0;

  // Nav bar owns its own gesture — never mixed with card scroll state.
  if (g_navSwitcherBarTracking) {
    if (physPressed) {
      // Finger moved from nav bar into carousel — card gestures take over (not home).
      if (nav_switcher_carousel_zone_contains(x, y)
          && !nav_switcher_bar_zone_contains((uint16_t)x, (uint16_t)y)) {
        g_navSwitcherBarTracking = false;
        nav_switcher_begin_gesture(x, y);
      } else {
        return;
      }
    } else {
      nav_switcher_finish_bar_gesture(x, y);
      return;
    }
  }

  if (physPressed && !wasPressed && nav_switcher_bar_zone_contains((uint16_t)x, (uint16_t)y)) {
    g_navSwitcherTouchDownX = (int16_t)x;
    g_navSwitcherTouchDownY = (int16_t)y;
    g_navSwitcherBarTracking = true;
    g_navSwitcherSnapAnimActive = false;
    g_navSwitcherActive = false;
    g_navSwitcherTouchMode = NavSwitcherTouchMode::NONE;
    return;
  }

  if (physPressed && !wasPressed && !g_navSwitcherActive)
    nav_switcher_begin_gesture(x, y);

  if (!g_navSwitcherActive) return;

  const int dx = x - (int)g_navSwitcherTouchDownX;
  const int dy = y - (int)g_navSwitcherTouchDownY;
  const bool inCarousel = nav_switcher_carousel_zone_contains((int)g_navSwitcherTouchDownX, (int)g_navSwitcherTouchDownY)
                          || nav_switcher_carousel_zone_contains(x, y);
  const bool hasCard = (g_navSwitcherDismissCardIdx >= 0) && inCarousel;

  NavSwitcherTouchMode mode = g_navSwitcherTouchMode;
  if (inCarousel)
    mode = nav_switcher_update_touch_mode(dx, dy, mode, hasCard);
  if (mode == NavSwitcherTouchMode::SCROLL) {
    g_navSwitcherScrollLocked = true;
    g_navSwitcherDismissDragY = 0;
  }
  g_navSwitcherTouchMode = mode;

  if (mode == NavSwitcherTouchMode::DISMISS && !g_navSwitcherScrollLocked) {
    int dragY = dy;
    if (dragY > 0) dragY = 0;
    g_navSwitcherDismissDragY = (int16_t)dragY;
    nav_switcher_redraw_only();
    if (physPressed) return;
  }

  if (mode == NavSwitcherTouchMode::SCROLL && g_navRecentCount > 1 && physPressed)
    nav_switcher_set_scroll_px((int)g_navSwitcherScrollAtTouchDown - dx, nowMs, false);

  if (!physPressed) {
    if (g_navSwitcherReleaseStartMs == 0)
      g_navSwitcherReleaseStartMs = nowMs;
    const bool pendingFinish = g_navSwitcherScrollLocked
                               || mode == NavSwitcherTouchMode::SCROLL
                               || (mode == NavSwitcherTouchMode::DISMISS
                                   && (g_navSwitcherDismissDragY <= -8 || dy <= -8));
    if (pendingFinish) {
      if ((uint32_t)(nowMs - g_navSwitcherReleaseStartMs) >= NAV_SWITCH_RELEASE_DEBOUNCE_MS)
        nav_switcher_finish_gesture(x, y, nowMs);
    } else {
      nav_switcher_finish_gesture(x, y, nowMs);
    }
  }
}

static void nav_switcher_reset_drag() {
  nav_switcher_reset_touch();
}

static void nav_overlay_close() {
  g_navOverlay = NavOverlay::NONE;
  g_navSwitcherCardHitValid = false;
  nav_switcher_reset_drag();
  g_navGestureTracking = false;
  g_navHomeLineDown = false;
  g_navSpacebarNavSession = false;
  g_navGesturePeakMinY = 0xFFFF;
  g_navReleaseArmMs = 0;
#if SEEDMASK_NOTE_SEND_UI
  hidEnablePromptClear();
#endif
  if (nav_bar_keyboard_active())
    g_navBarAwake = false;
  // Dismiss tap must not fall through into Passwords/Notes/Receive/etc. underneath.
  g_navOverlayConsumeTouch = true;
  g_touchIgnoreUntil = millis() + 320;
  g_lastTapMs = millis();
  g_touchReleasedSinceTap = false;
  g_listTouchPending = false;
  g_listDidDrag = true;
  g_deviceSettingsListTouchPending = false;
  g_duressGamesListTouchPending = false;
  g_showCodeVpTapPending = false;
  draw();
}

static void nav_bar_go_home() {
  if (g_editMode != EditMode::NONE) {
    if (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && g_pwEditFocusField >= 1 && g_pwEditFocusField <= 5) {
      pwEditCollapseFocusedFieldToBrowse();
      g_touchIgnoreUntil = millis() + 260;
      draw();
      return;
    }
    if (g_editMode == EditMode::EDIT_PW_VALUE && pwEditHasUnsavedChanges()) {
      g_pwEditExitPrompt = true;
      draw();
      return;
    }
    exitEditor();
  }
  if (g_navOverlay == NavOverlay::APP_SWITCHER)
    g_navSkipNextShowSnapshot = true;
  g_navOverlay = NavOverlay::NONE;
#if SEEDMASK_NOTE_SEND_UI
  g_hidEnablePromptViaPlus1 = 0;
  g_hidEnablePromptFromSp = false;
#endif
  // Hub home: crypto stack → Bitcoin/Kaspa home (asset already selected); otherwise Passwords/Notes/2FA menu.
  if (nav_bar_on_crypto_side())
    show(UIScreen::CRYPTO_HOME);
  else
    show(UIScreen::MENU);
  g_touchIgnoreUntil = millis() + 220;
}

