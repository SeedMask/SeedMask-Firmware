static void handleCryptoMultisigImportTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    multisig_duplicate_notice_dismiss();
    g_optionsHomeScreen = UIScreen::CRYPTO_MULTISIG_IMPORT;
    show(UIScreen::BURGER_MENU);
