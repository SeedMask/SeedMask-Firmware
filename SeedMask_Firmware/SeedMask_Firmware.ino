    snprintf(filepath, sizeof(filepath), "%s/%s", g_sdCwd, g_sdFiles[sel]);
    if (!restore_try_open_sd_selection(filepath, g_sdFiles[sel])) {
      setMsg("Unknown file type");
      draw();
    }
    return;
  }

  int startIdx = g_sdScrollOffset;
  int endIdx = min(startIdx + SD_FILES_PER_PAGE, g_sdFileCount);
  int yPos = SD_LIST_TOP;
  for (int i = startIdx; i < endIdx; i++) {
    if (x >= SD_LIST_LEFT && x <= SD_LIST_RIGHT && y >= yPos - 2 && y <= yPos + MULTISIG_SD_LIST_ROW_H) {
      const char* nm = g_sdFiles[i];
      if (strcmp(nm, "..") == 0) {
        if (sd_browser_go_parent()) {
          scanSdFiles();
          g_sdScrollOffset = 0;
          g_sdSelectedFile = -1;
          g_touchIgnoreUntil = millis() + 320;
          sdScrollLastY = -1;
          sdScrollAccum = 0.f;
        }
        drawRestoreSd();
        return;
      }
      g_sdSelectedFile = i;
      drawRestoreSd();
      return;
    }
    yPos += MULTISIG_SD_LIST_ROW_H;
  }
}

// After Backup_*.bin restore: user picks which SPV vault .bin to load (same folder scan as save-picker).
static const int kRestoreVaultPickListTop = 124;
static int g_restoreVaultPickN = 0;
static char (*g_restoreVaultPickPaths)[192] = nullptr;  // 8 paths — PSRAM
static int g_restoreVaultPickScroll = 0;
static int g_restoreVaultPickSel = -1;

static void restore_vault_pick_fill_list(void) {
  g_restoreVaultPickN = 0;
  g_restoreVaultPickScroll = 0;
  g_restoreVaultPickSel = -1;
  if (!g_masterPw[0] || strlen(g_masterPw) < 4) return;
  if (!seedmask_prepare_sd_backup_paths_for_current_vault()) return;

  char folder[192];
  strncpy(folder, PW_FILE, sizeof(folder) - 1);
  folder[sizeof(folder) - 1] = 0;
  char* slash = strrchr(folder, '/');
  if (!slash || slash <= folder) return;
  *slash = 0;

  char cand[8][192];
  int n = sd_list_wallet_vault_bins(folder, cand, 8, g_masterPw);
  if (!g_restoreVaultPickPaths) return;
  for (int i = 0; i < n; i++) {
    strncpy(g_restoreVaultPickPaths[i], cand[i], sizeof(g_restoreVaultPickPaths[0]) - 1);
    g_restoreVaultPickPaths[i][sizeof(g_restoreVaultPickPaths[0]) - 1] = 0;
  }
  g_restoreVaultPickN = n;

  if (g_restoreVaultPickN >= 8) return;

  if (g_lastSdBackupCodePath[0] && strncmp(g_lastSdBackupCodePath, "/sdcard/", 8) == 0) {
    char alt[192];
    strncpy(alt, g_lastSdBackupCodePath, sizeof(alt) - 1);
    alt[sizeof(alt) - 1] = 0;
    char* s2 = strrchr(alt, '/');
    if (s2 && s2 > alt) {
      *s2 = 0;
      if (strcasecmp(alt, folder) != 0) {
        n = sd_list_wallet_vault_bins(alt, cand, 8, g_masterPw);
        for (int j = 0; j < n && g_restoreVaultPickN < 8; j++) {
          bool dup = false;
          for (int k = 0; k < g_restoreVaultPickN; k++) {
            if (strcasecmp(g_restoreVaultPickPaths[k], cand[j]) == 0) {
              dup = true;
              break;
            }
          }
          if (!dup) {
            strncpy(g_restoreVaultPickPaths[g_restoreVaultPickN], cand[j],
                    sizeof(g_restoreVaultPickPaths[0]) - 1);
            g_restoreVaultPickPaths[g_restoreVaultPickN][sizeof(g_restoreVaultPickPaths[0]) - 1] = 0;
            g_restoreVaultPickN++;
          }
        }
      }
    }
  }
  if (g_restoreVaultPickN == 1) g_restoreVaultPickSel = 0;
}

static Rect restore_vault_pick_scroll_up_rect(int listTop, int listH) {
  (void)listH;
  return { 272, (int16_t)listTop, 40, 30 };
}
static Rect restore_vault_pick_scroll_down_rect(int listTop, int listH) {
  return { 272, (int16_t)(listTop + listH - 30), 40, 30 };
}

static void drawRestoreVaultPick() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Vault chooser", false);
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(1);
  gfx->setCursor(10, 50);
  gfx->print("Several vault backups (.bin) may appear.");
  gfx->setCursor(10, 65);
  gfx->print("Select which file this wallet should use.");
  gfx->setCursor(10, 80);
  gfx->print("After loading, every vault save from this");
  gfx->setCursor(10, 95);
  gfx->print("device will use that file until you pick a");
  gfx->setCursor(10, 110);
  gfx->print("different save location.");

  const int listTop = kRestoreVaultPickListTop;
  const int listH = SD_FILES_PER_PAGE * MULTISIG_SD_LIST_ROW_H;
  const bool pager = (g_restoreVaultPickN > SD_FILES_PER_PAGE);
  const int listClipRight = pager ? 260 : (int)SD_LIST_RIGHT;
  const int scrollColX = 264;
  int startIdx = g_restoreVaultPickScroll;
  int endIdx = min(startIdx + SD_FILES_PER_PAGE, g_restoreVaultPickN);

  if (g_restoreVaultPickN > 0) {
    int y = listTop;
    for (int i = startIdx; i < endIdx; i++) {
      if (i == g_restoreVaultPickSel) {
        gfx->fillRect(SD_LIST_LEFT, y - 2, listClipRight - SD_LIST_LEFT, MULTISIG_SD_LIST_ROW_H, UI_ACCENT);
        gfx->setTextColor(RGB565_BLACK);
      } else {
        gfx->setTextColor(UI_TEXT);
      }
      const char* path = g_restoreVaultPickPaths[i];
      const char* bn = strrchr(path, '/');
      bn = bn ? bn + 1 : path;
      char disp[40];
      strncpy(disp, bn, sizeof(disp) - 1);
      disp[sizeof(disp) - 1] = 0;
      if (pager && strlen(disp) > 20) {
        snprintf(disp, sizeof(disp), "%.18s..", bn);
      }
      gfx->setTextSize(2);
      gfx->setCursor(SD_LIST_LEFT + 6, y + 10);
      gfx->printf("%d) ", i + 1);
      gfx->print(disp);
      y += MULTISIG_SD_LIST_ROW_H;
    }
  } else {
    gfx->setTextColor(RGB565_LIGHTGREY);
    gfx->setTextSize(2);
    gfx->setCursor(10, listTop + 8);
    gfx->print("No vault backups found.");
    gfx->setCursor(10, listTop + 36);
    gfx->setTextSize(1);
    gfx->print("Copy a PW_*.bin for this wallet");
    gfx->setCursor(10, listTop + 50);
    gfx->print("to the backup folder on SD.");
  }

  if (g_restoreVaultPickN > SD_FILES_PER_PAGE) {
    const int sbX = scrollColX, sbW = 8, sbY = listTop, sbH = listH;
    gfx->fillRoundRect(sbX, sbY, sbW, sbH, 4, UI_CARD);
    gfx->drawRoundRect(sbX, sbY, sbW, sbH, 4, UI_BORDER);
    int maxOff = g_restoreVaultPickN - SD_FILES_PER_PAGE;
    int thumbH = max(12, (SD_FILES_PER_PAGE * sbH) / g_restoreVaultPickN);
    int thumbY = sbY + (maxOff > 0 ? (g_restoreVaultPickScroll * (sbH - thumbH)) / maxOff : 0);
    gfx->fillRoundRect(sbX + 1, thumbY, sbW - 2, thumbH, 3, UI_ACCENT);
    drawGradientSilverButton(restore_vault_pick_scroll_up_rect(listTop, listH), "^^", 1);
    drawGradientSilverButton(restore_vault_pick_scroll_down_rect(listTop, listH), "vv", 1);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(1);
    gfx->setCursor((int16_t)scrollColX, listH + listTop + 6);
    gfx->printf("%d-%d/%d", startIdx + 1, endIdx, g_restoreVaultPickN);
  }

  drawBtn(BTN_LIST_BACK, "BACK", RGB565_DARKGREY, 2);
  if (g_restoreVaultPickSel >= 0 && g_restoreVaultPickSel < g_restoreVaultPickN)
    drawGradientSilverButton(BTN_RESTORE_VAULT_PICK_RESTORE, "RESTORE", 2);

  ui_flush();
}

static void handleRestoreVaultPickTap(uint16_t x, uint16_t y) {
  if (hit(BTN_LIST_BACK, x, y)) {
    setMsg("");
    show(UIScreen::RESTORE_VAULT_CHOICE);
    return;
  }

  if (g_restoreVaultPickN > SD_FILES_PER_PAGE) {
    const int listTop = kRestoreVaultPickListTop;
    const int listH = SD_FILES_PER_PAGE * MULTISIG_SD_LIST_ROW_H;
    if (hit(restore_vault_pick_scroll_up_rect(listTop, listH), x, y) && g_restoreVaultPickScroll > 0) {
      g_restoreVaultPickScroll = max(0, g_restoreVaultPickScroll - SD_FILES_PER_PAGE);
      drawRestoreVaultPick();
      return;
    }
    if (hit(restore_vault_pick_scroll_down_rect(listTop, listH), x, y)
        && g_restoreVaultPickScroll + SD_FILES_PER_PAGE < g_restoreVaultPickN) {
      g_restoreVaultPickScroll =
        min(g_restoreVaultPickN - SD_FILES_PER_PAGE, g_restoreVaultPickScroll + SD_FILES_PER_PAGE);
      drawRestoreVaultPick();
      return;
    }
  }

  if (g_restoreVaultPickSel >= 0 && g_restoreVaultPickSel < g_restoreVaultPickN
      && hit(BTN_RESTORE_VAULT_PICK_RESTORE, x, y)) {
    flashKeyRectTranslucent(BTN_RESTORE_VAULT_PICK_RESTORE);
    delay(85);
    strncpy(PW_FILE, g_restoreVaultPickPaths[g_restoreVaultPickSel], sizeof(PW_FILE) - 1);
    PW_FILE[sizeof(PW_FILE) - 1] = 0;
    if (pw_vault_load_from_sd(g_masterPw)) {
      sd_prefs_put_vault_path(PW_FILE);
      // Passwords are in RAM; write vault_pw NVS only after screen lock is set.
      g_restorePwNvsPending = true;
      menu_show_vault_restore_success_panel();
      show_menu_or_onboard_lock_after_restore();
    } else {
      if (!g_msg[0]) setMsg("Could not load vault");
      show(UIScreen::ERROR_SCREEN);
    }
    return;
  }

  int startIdx = g_restoreVaultPickScroll;
  int endIdx = min(startIdx + SD_FILES_PER_PAGE, g_restoreVaultPickN);
  int yPos = kRestoreVaultPickListTop;
  const bool pager = (g_restoreVaultPickN > SD_FILES_PER_PAGE);
  const int listClipRight = pager ? 260 : (int)SD_LIST_RIGHT;
  for (int i = startIdx; i < endIdx; i++) {
    if (x >= SD_LIST_LEFT && x <= listClipRight && y >= yPos - 2 && y <= yPos + MULTISIG_SD_LIST_ROW_H) {
      g_restoreVaultPickSel = i;
      drawRestoreVaultPick();
      return;
    }
    yPos += MULTISIG_SD_LIST_ROW_H;
  }
}

