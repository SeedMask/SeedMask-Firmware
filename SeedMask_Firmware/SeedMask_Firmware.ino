static bool start_qr_scan() {
  if (!camera_pins_configured()) return false;

  // power up camera via TCA if used
  tcaSetBit(EXIO_CAM_PWDN, false);
  delay(30);

  if (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT) {
    if (g_qr_preserve_kaspa_fountain)
      kaspa_ur_scan_resume_after_camera_restart();
    else
      kaspa_ur_scan_session_reset();
  }
  if (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT) {
    seedmask_ur_psbt_scan_reset();
  }

  g_qr_decode_fail_streak = 0;
  g_qr_need_high_res = false;
  if (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT || g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT) {
    crypto_tx_scan_poll_reset();
#if SEEDMASK_PSBT_START_SVGA
    g_qr_w = 800;
    g_qr_h = 600;
    g_qr_framesize = FRAMESIZE_SVGA;
#endif
  }
  // Encrypted vault restore prefers SVGA; fall back to VGA if PSRAM cannot host SVGA DMA + Quirc.
  if (g_qrScanTarget == QrScanTarget::RESTORE && !g_restoreSeedQrOnlyScan) {
    g_qr_w = 800;
    g_qr_h = 600;
    g_qr_framesize = FRAMESIZE_SVGA;
    s_vault_mp_isp_entry_done = false;
    if (g_vaultLatchRaw) {
      free(g_vaultLatchRaw);
      g_vaultLatchRaw = nullptr;
    }
    g_vaultLatchImgBytes = 0;
    g_vaultLatchUntilMs = 0;
  }
  if (!camera_init_grayscale(g_qr_framesize, g_qr_w, g_qr_h)) {
    if (g_qrScanTarget == QrScanTarget::RESTORE && !g_restoreSeedQrOnlyScan &&
        g_qr_framesize == FRAMESIZE_SVGA) {
      Serial.println("Vault scan: SVGA init failed — falling back to VGA");
      g_qr_w = 640;
      g_qr_h = 480;
      g_qr_framesize = FRAMESIZE_VGA;
      if (!camera_init_grayscale(g_qr_framesize, g_qr_w, g_qr_h)) return false;
    } else {
      return false;
    }
  }
  g_camOn = true;
  return true;
}

