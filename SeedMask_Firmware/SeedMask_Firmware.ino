/// Raw BIP32 master fingerprint (first 4 bytes of HASH160(pubkey)) for PSBT review / change detection.
static bool current_master_fp_bytes(uint8_t fp4[4]) {
  if (!fp4) return false;
  if (!ensure_bip39_derived_seed_cached()) return false;
  uint8_t seed[64];
  memcpy(seed, g_bip39DerivedSeedCache, 64);
  Bip32Node m;
  memset(&m, 0, sizeof(m));
  if (!bip32_master_from_seed(seed, &m)) {
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  uint8_t pub[33];
  if (!secp_pubkey_compressed(m.k, pub)) {
    secure_memzero(&m, sizeof(m));
    return false;
  }
  uint8_t h160[20];
  if (!hash160(pub, sizeof(pub), h160)) {
    secure_memzero(&m, sizeof(m));
    secure_memzero(pub, sizeof(pub));
    return false;
  }
  memcpy(fp4, h160, 4);
  secure_memzero(&m, sizeof(m));
  secure_memzero(pub, sizeof(pub));
  secure_memzero(h160, sizeof(h160));
  return true;
}

static void format_sat_btc_line(uint64_t sat, char* buf, size_t cap) {
  uint64_t whole = sat / 100000000ULL;
  uint64_t frac = sat % 100000000ULL;
  snprintf(buf, cap, "%llu.%08llu BTC", (unsigned long long)whole, (unsigned long long)frac);
}

static void format_sat_sats_grouped(uint64_t sat, char* buf, size_t cap) {
  if (!buf || cap < 12) return;
  char tmp[24];
  snprintf(tmp, sizeof(tmp), "%llu", (unsigned long long)sat);
  int n = (int)strlen(tmp);
  int lead = n % 3;
  if (lead == 0) lead = 3;
  char mid[40];
  size_t p = 0;
  for (int i = 0; i < n;) {
    if (i > 0 && p + 1 < sizeof(mid)) mid[p++] = ' ';
    int take = (i == 0) ? lead : 3;
    while (take-- && i < n && p + 1 < sizeof(mid)) mid[p++] = tmp[i++];
  }
  mid[p] = 0;
  snprintf(buf, cap, "%s sats", mid);
}

static void psbt_review_format_amount_line(uint64_t sat, char* out, size_t outCap) {
  if (g_psbtReviewUnitSats)
    format_sat_sats_grouped(sat, out, outCap);
  else
    format_sat_btc_line(sat, out, outCap);
}

/// Decode common mainnet scriptPubKeys to address string for PSBT review.
static bool script_pubkey_to_address(const uint8_t* spk, size_t spkLen, char* out, size_t outLen) {
  if (!spk || !out || outLen < 20) return false;
  if (spkLen == 22 && spk[0] == 0x00 && spk[1] == 0x14) {
    return bech32_encode_segwit("bc", 0, spk + 2, 20, out, outLen);
  }
  if (spkLen == 25 && spk[0] == 0x76 && spk[1] == 0xa9 && spk[2] == 0x14 && spk[23] == 0x88 && spk[24] == 0xac) {
    uint8_t payload[21];
    payload[0] = 0x00;
    memcpy(payload + 1, spk + 3, 20);
    bool ok = base58check_encode(payload, sizeof(payload), out, outLen);
    secure_memzero(payload, sizeof(payload));
    return ok;
  }
  if (spkLen == 23 && spk[0] == 0xa9 && spk[1] == 0x14 && spk[22] == 0x87) {
    uint8_t payload[21];
    payload[0] = 0x05;
    memcpy(payload + 1, spk + 2, 20);
    bool ok = base58check_encode(payload, sizeof(payload), out, outLen);
    secure_memzero(payload, sizeof(payload));
    return ok;
  }
  // P2WSH (native segwit): OP_0 + push32 + witness program
  if (spkLen == 34 && spk[0] == 0x00 && spk[1] == 0x20) {
    return bech32_encode_segwit("bc", 0, spk + 2, 32, out, outLen);
  }
  // P2TR (taproot): OP_1 + push32 + x-only pubkey
  if (spkLen == 34 && spk[0] == 0x51 && spk[1] == 0x20) {
    return bech32_encode_segwit("bc", 1, spk + 2, 32, out, outLen);
  }
  snprintf(out, outLen, "Unknown output (%ub)", (unsigned)spkLen);
  return true;
}

static void crypto_invalidate_psbt_review(void) {
  g_cryptoReviewSummaryValid = false;
  g_psbtReviewUnitSats = false;
  memset(&g_cryptoReviewSummary, 0, sizeof(g_cryptoReviewSummary));
  g_cryptoReviewAmt[0] = g_cryptoReviewDest[0] = g_cryptoReviewChg[0] = g_cryptoReviewChgAddr[0] = g_cryptoReviewFee[0] = 0;
}

static void crypto_refresh_psbt_review(void) {
  crypto_invalidate_psbt_review();
  if (!g_cryptoPsbtDecodedBuf || g_cryptoPsbtDecodedLen == 0 || !g_cryptoHasUnsigned) return;
  uint8_t fp[4];
  if (!current_master_fp_bytes(fp)) return;
  if (!seedmask_psbt_review_summarize(g_cryptoPsbtDecodedBuf, g_cryptoPsbtDecodedLen, fp, &g_cryptoReviewSummary)) {
    snprintf(g_cryptoReviewAmt, sizeof(g_cryptoReviewAmt), "-");
    snprintf(g_cryptoReviewDest, sizeof(g_cryptoReviewDest), "Parse error");
    snprintf(g_cryptoReviewFee, sizeof(g_cryptoReviewFee), "-");
    const char* e = g_cryptoReviewSummary.err[0] ? g_cryptoReviewSummary.err : "review";
    snprintf(g_cryptoReviewChg, sizeof(g_cryptoReviewChg), "%s", e);
    return;
  }
  if (!g_cryptoReviewSummary.ok) return;
  format_sat_btc_line(g_cryptoReviewSummary.send_sat, g_cryptoReviewAmt, sizeof(g_cryptoReviewAmt));
  if (g_cryptoReviewSummary.change_sat == 0) {
    snprintf(g_cryptoReviewChg, sizeof(g_cryptoReviewChg), "No change");
    g_cryptoReviewChgAddr[0] = 0;
  } else {
    format_sat_btc_line(g_cryptoReviewSummary.change_sat, g_cryptoReviewChg, sizeof(g_cryptoReviewChg));
    g_cryptoReviewChgAddr[0] = 0;
    if (g_cryptoReviewSummary.first_change_spk_len > 0
        && script_pubkey_to_address(g_cryptoReviewSummary.first_change_spk,
                                    g_cryptoReviewSummary.first_change_spk_len, g_cryptoReviewChgAddr,
                                    sizeof(g_cryptoReviewChgAddr))) {
      /* show first change address only — no "(+N)" suffix */
    } else {
      snprintf(g_cryptoReviewChgAddr, sizeof(g_cryptoReviewChgAddr), "(see outputs)");
    }
  }
  format_sat_btc_line(g_cryptoReviewSummary.fee_sat, g_cryptoReviewFee, sizeof(g_cryptoReviewFee));

  g_cryptoReviewDest[0] = 0;
  if (g_cryptoReviewSummary.num_send_outputs == 0) {
    snprintf(g_cryptoReviewDest, sizeof(g_cryptoReviewDest), "-");
  } else if (g_cryptoReviewSummary.first_send_spk_len > 0
             && script_pubkey_to_address(g_cryptoReviewSummary.first_send_spk, g_cryptoReviewSummary.first_send_spk_len,
                                         g_cryptoReviewDest, sizeof(g_cryptoReviewDest))) {
    /* first destination only — no "(+N)" extra-output suffix */
  } else {
    snprintf(g_cryptoReviewDest, sizeof(g_cryptoReviewDest), "(see outputs)");
  }

  g_cryptoReviewSummaryValid = true;
}

