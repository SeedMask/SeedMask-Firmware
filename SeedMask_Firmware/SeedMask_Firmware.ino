  // Card navigation
  if (hit(menuMainCardRect(0), x, y)) {
    flashMainMenuDarkCard(menuMainCardRect(0));
    show(UIScreen::PASSWORDS);
    return;
  }
  if (hit(menuMainCardRect(1), x, y)) {
    flashMainMenuDarkCard(menuMainCardRect(1));
    show(UIScreen::NOTES);
