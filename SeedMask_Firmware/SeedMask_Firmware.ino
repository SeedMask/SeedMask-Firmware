    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    drawWipeInfoBitmapAt(infoCx, infoCy, true);
  }
  ui_flush();
}

static void drawCryptoTempSeed() {
  const uint16_t accent = cryptoSettingsDetailAccent();
  const uint16_t actionBtn = cryptoSettingsActionColor();
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Temporary seed", true);
  const int dy = TEMP_SEED_MAIN_DY;

  const char* sourceLab = "none";
  if (g_tempSeedActive) {
    switch (g_tempSeedActiveSource) {
      case TempSeedActiveSource::BIP85: sourceLab = "BIP-85 child"; break;
      case TempSeedActiveSource::SEED_QR: sourceLab = "SeedQR"; break;
      case TempSeedActiveSource::MANUAL_WORDS: sourceLab = "Manual words"; break;
      case TempSeedActiveSource::BACKUP_CODE: sourceLab = "Backup code"; break;
      default: sourceLab = "Imported"; break;
    }
  }
  // ASCII hyphen only — Adafruit GFX has no UTF-8, so "—" renders as "rçö".
  const char* wordsLab = g_tempSeedActive ? (g_tempSeedWordCount == 24 ? "24" : "12") : "-";

  char fpDisp[9];
  fpDisp[0] = 0;
  if (g_tempSeedActive) {
    if (g_tempSeedXfp[0]) {
      strncpy(fpDisp, g_tempSeedXfp, sizeof(fpDisp));
      fpDisp[sizeof(fpDisp) - 1] = 0;
    } else {
      strncpy(fpDisp, "--------", sizeof(fpDisp));
    }
  } else {
    if (!current_master_xfp(fpDisp)) strncpy(fpDisp, "--------", sizeof(fpDisp));
    fpDisp[sizeof(fpDisp) - 1] = 0;
  }

  // Status card: badge + source/words + fingerprint (no title — clears the (i) icon).
  const int cardX = 10, cardW = 300, cardR = 12;
  // Sit fully below the (i) icon (icon bottom ≈ 88); keep a gap above BIP-85 / Clear.
  const int cardY = 90;
  const int cardH = 76;
  const uint16_t cardEdge = g_tempSeedActive ? accent : UI_BORDER;
  const uint16_t cardFill = blendRGB565(UI_CARD, g_tempSeedActive ? accent : RGB565_BLACK,
                                        g_tempSeedActive ? 0.10f : 0.0f);
  gfx->fillRoundRect(cardX, cardY, cardW, cardH, cardR, cardFill);
  gfx->drawRoundRect(cardX, cardY, cardW, cardH, cardR, cardEdge);
  gfx->drawRoundRect(cardX + 1, cardY + 1, cardW - 2, cardH - 2, cardR - 1,
                     blendRGB565(cardEdge, RGB565_BLACK, 0.35f));

  // ACTIVE/OFF badge only (removed "Vault context" / "Session wallet").
  const int badgeW = 72, badgeH = 16;
  const int badgeX = cardX + cardW - 12 - badgeW;
  const int badgeY = cardY + 5;
  if (g_tempSeedActive) {
    gfx->fillRoundRect(badgeX, badgeY, badgeW, badgeH, 6, UI_SUCCESS);
    gfx->setTextSize(1);
    gfx->setTextColor(RGB565_BLACK);
    gfx->setCursor(badgeX + 14, badgeY + 4);
    gfx->print("ACTIVE");
  } else {
    gfx->fillRoundRect(badgeX, badgeY, badgeW, badgeH, 6, RGB565_DARKGREY);
    gfx->setTextSize(1);
    gfx->setTextColor(UI_TEXT);
    gfx->setCursor(badgeX + 26, badgeY + 4);
    gfx->print("OFF");
  }

  const int divY = cardY + 24;
  gfx->drawFastHLine(cardX + 12, divY, cardW - 24, blendRGB565(cardEdge, RGB565_BLACK, 0.55f));

  // Source | Words columns
  const int col1X = cardX + 12;
  const int col2X = cardX + 168;
  gfx->setTextSize(1);
  gfx->setTextColor(RGB565_LIGHTGREY);
  gfx->setCursor(col1X, divY + 3);
  gfx->print("Source");
  gfx->setCursor(col2X, divY + 3);
  gfx->print("Words");
  gfx->setTextSize(2);
  gfx->setTextColor(UI_TEXT);
  gfx->setCursor(col1X, divY + 14);
  gfx->print(sourceLab);
  gfx->setCursor(col2X, divY + 14);
  gfx->print(wordsLab);
  gfx->drawFastVLine(cardX + 156, divY + 2, 26, blendRGB565(cardEdge, RGB565_BLACK, 0.60f));

  // Fingerprint strip — only as wide as label + hex (not full card width).
  const char* fpLab = "Current fingerprint";
  const int fpCharW = 6;
  const int fpPadX = 8;
  const int fpGap = 8;
  const int fpLabW = (int)strlen(fpLab) * fpCharW;
  const int fpValW = (int)strlen(fpDisp) * fpCharW;
  int fpStripW = fpPadX + fpLabW + fpGap + fpValW + fpPadX;
  if (fpStripW > cardW - 16) fpStripW = cardW - 16;
  const int fpStripX = cardX + 8;
  const int fpY = cardY + cardH - 20;
  gfx->fillRoundRect(fpStripX, fpY, fpStripW, 16, 6, RGB565_BLACK);
  gfx->drawRoundRect(fpStripX, fpY, fpStripW, 16, 6,
                     g_tempSeedActive ? RGB565_CYAN : blendRGB565(UI_BORDER, RGB565_CYAN, 0.35f));
  gfx->setTextSize(1);
  gfx->setTextColor(RGB565_CYAN);
  gfx->setCursor(fpStripX + fpPadX, fpY + 4);
  gfx->print(fpLab);
  gfx->setTextColor(RGB565_AMBER);
  gfx->setCursor(fpStripX + fpPadX + fpLabW + fpGap, fpY + 4);
  gfx->print(fpDisp);

  if (!g_tempSeedActive) {
    drawBtn(BTN_TEMP_USE_BIP85, "BIP-85 (child seed)", actionBtn, 1);
    drawBtn(BTN_TEMP_MANUAL, "Enter 12/24 words", actionBtn, 1);
    drawBtn(BTN_TEMP_SCAN_SEEDQR, "Scan SeedQR", actionBtn, 1);
    drawBtn(BTN_TEMP_SCAN_ENCRYPTED_QR, "Encrypted QR code", actionBtn, 1);
    drawBtn(BTN_TEMP_IMPORT_BACKUP, "Import backup code", actionBtn, 1);
  } else {
    drawBtn(BTN_TEMP_CLEAR, "Clear temporary seed", RGB565_RED, 1);
  }
  // Intentionally no footer status line on this screen; it overlaps the bottom action area.
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    drawWipeInfoBitmapAt(infoCx, infoCy, true);
  }
  if (g_tempSeedAlreadyInUsePopup) {
    drawTempSeedAlreadyInUsePopupOverlay();
  }
  ui_flush();
}

