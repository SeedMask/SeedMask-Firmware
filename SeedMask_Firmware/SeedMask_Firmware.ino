static void handleDeviceRenameTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    show(UIScreen::DEVICE_SETTINGS);
    return;
  }
  if (hit(RECT_TOP_TITLE, x, y)) {
    show(UIScreen::DEVICE_SETTINGS);
    return;
  }
  if (hitOkKey((int16_t)x, (int16_t)y)) {
    char tmp[DEVICE_NAME_MAX];
    const char* src = g_deviceRenameBuf;
    while (*src == ' ') src++;
    strncpy(tmp, src, sizeof(tmp) - 1);
    tmp[sizeof(tmp) - 1] = 0;
    size_t L = strlen(tmp);
    while (L > 0 && tmp[L - 1] == ' ') {
      tmp[L - 1] = 0;
      L--;
    }
    if (L == 0) {
      if (!duressUsesGenericDeviceName())
        strncpy(g_deviceName, "SeedMask", sizeof(g_deviceName) - 1);
    } else if (!duressUsesGenericDeviceName()) {
      strncpy(g_deviceName, tmp, sizeof(g_deviceName) - 1);
    }
    if (!duressUsesGenericDeviceName()) {
      g_deviceName[sizeof(g_deviceName) - 1] = 0;
      deviceNamePersist();
    }
    setMsg("");
    g_deviceRenameFeedbackPhase = DeviceRenameFeedbackPhase::LOADING;
    g_deviceRenameFeedbackPhaseStartMs = millis();
    show(UIScreen::DEVICE_RENAME_FEEDBACK);
    return;
  }
  passwordInputTap(x, y, g_deviceRenameBuf, sizeof(g_deviceRenameBuf));
}

