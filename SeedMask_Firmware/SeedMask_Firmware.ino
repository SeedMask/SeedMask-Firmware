    gfx->fillRect(sx, sy, 2, 2, RGB565(200, 210, 255));
  }
  int rows = 2, cols = 5;
  int ew = (aw - 20) / cols - 3;
  int eh = 11;
  for (int r = 0; r < rows; r++) {
    for (int c = 0; c < cols; c++) {
      int ex = ax + 10 + c * (ew + 3);
      int ey = ay + 12 + r * (eh + 4);
      uint16_t hull = RGB565(40 + r * 35, 80 + c * 20, 160 - r * 25);
      duress_space_draw_enemy_ship((int16_t)ex, (int16_t)ey, (int16_t)ew, (int16_t)eh, hull, RGB565(220, 235, 255));
    }
  }
  int cx = ax + aw / 2;
  int baseY = ay + ah - 10;
  gfx->fillTriangle((int16_t)cx, (int16_t)(baseY - 14), (int16_t)(cx - 16), baseY, (int16_t)(cx + 16), baseY,
                    RGB565(120, 200, 255));
  gfx->drawTriangle((int16_t)cx, (int16_t)(baseY - 14), (int16_t)(cx - 16), baseY, (int16_t)(cx + 16), baseY,
                    RGB565(40, 70, 90));
  gfx->fillCircle(cx, ay + ah - 26, 2, RGB565(255, 220, 80));
  gfx->fillRoundRect((int16_t)(ax + aw / 2 - 14), (int16_t)(ay + ah / 2), 10, 12, 2, RGB565(255, 210, 70));
  gfx->drawRoundRect((int16_t)(ax + aw / 2 - 14), (int16_t)(ay + ah / 2), 10, 12, 2, RGB565(80, 70, 30));
  gfx->setTextSize(1);
  gfx->setTextColor(RGB565(40, 30, 10));
  gfx->setCursor((int16_t)(ax + aw / 2 - 11), (int16_t)(ay + ah / 2 + 3));
  gfx->print("R");
}

/** Game-store style tile: poster art + title strip (full rect is tappable). */
static void duress_games_draw_game_tile(const Rect& r, const char* title,
                                        void (*drawArt)(int16_t, int16_t, int16_t, int16_t)) {
  const int rad = 14;
  gfx->fillRoundRect(r.x + 3, r.y + 4, r.w, r.h, rad, RGB565(4, 4, 8));
  gfx->fillRoundRect(r.x, r.y, r.w, r.h, rad, UI_CARD);
  gfx->drawRoundRect(r.x, r.y, r.w, r.h, rad, UI_BORDER);
  const int16_t pad = 10;
  const int16_t titleH = 28;
  const int16_t artX = r.x + pad;
  const int16_t artY = r.y + pad;
  const int16_t artW = r.w - 2 * pad;
  const int16_t artH = r.h - titleH - 2 * pad - 2;
  gfx->fillRoundRect(artX - 1, artY - 1, artW + 2, artH + 2, 10, RGB565(0, 0, 0));
  drawArt(artX, artY, artW, artH);
  const int16_t ty = r.y + r.h - titleH - 4;
  gfx->fillRoundRect(r.x + 8, ty, r.w - 16, titleH, 8, RGB565(14, 16, 28));
  gfx->drawRoundRect(r.x + 8, ty, r.w - 16, titleH, 8, RGB565(60, 65, 90));
  gfx->setTextSize(2);
  gfx->setTextColor(RGB565_WHITE);
  size_t tl = title ? strlen(title) : 0;
  uint16_t tw = (uint16_t)(tl * 12);
  gfx->setCursor((int16_t)(r.x + (r.w - (int)tw) / 2), (int16_t)(ty + 7));
  if (title) gfx->print(title);
}

