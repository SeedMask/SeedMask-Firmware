static bool scan_payload_looks_like_ur(const char* s) {
  return s && strlen(s) >= 3 && (strncasecmp(s, "ur:", 3) == 0);
}

static bool kaspa_poll_consume_ur_part(char* outText, size_t outLen);

/** Feed one `ur:bytes/…` fountain frame into Kaspa PSKT JSON assembly. Returns 0=not UR, 1=need more, 2=complete, -1=error. */
static int kaspa_feed_ur_scan_part(const char* ur, char* err, size_t errLen) {
  if (!scan_payload_looks_like_ur(ur)) return 0;
  if (!g_urPartNormScratch || !g_kaspaLastUrPart || !g_kaspaPsktScanBuf) {
    if (err && errLen) snprintf(err, errLen, "UR scratch missing");
    return -1;
  }
  char* urNorm = g_urPartNormScratch;
  size_t n = strlen(ur);
  if (n >= KASPA_UR_PART_MAX) {
    if (err && errLen) snprintf(err, errLen, "UR too long");
    return -1;
  }
  for (size_t i = 0; i < n; i++)
    urNorm[i] = (char)tolower((unsigned char)ur[i]);
  urNorm[n] = 0;
  uint32_t gotBefore = 0, needBefore = 0;
  seedmask_ur_kaspa_pskt_get_scan_progress(nullptr, &gotBefore, &needBefore, nullptr);
  if (g_kaspaLastUrPart[0] && strcmp(urNorm, g_kaspaLastUrPart) == 0) {
    return 1;
  }
  float pct = 0;
  int urRes = seedmask_ur_feed_kaspa_pskt_qr(urNorm, g_kaspaPsktScanBuf, KASPA_PSKT_SCAN_MAX - 1, &pct, err, errLen);
  if (urRes == SEEDMASK_UR_PSBT_COMPLETE) {
    strncpy(g_kaspaLastUrPart, urNorm, KASPA_UR_PART_MAX - 1);
    g_kaspaLastUrPart[KASPA_UR_PART_MAX - 1] = 0;
    return 2;
  }
  if (urRes == SEEDMASK_UR_PSBT_NEED_MORE) {
    uint32_t gotAfter = 0;
    seedmask_ur_kaspa_pskt_get_scan_progress(nullptr, &gotAfter, nullptr, nullptr);
    if (gotAfter > gotBefore) {
      strncpy(g_kaspaLastUrPart, urNorm, KASPA_UR_PART_MAX - 1);
      g_kaspaLastUrPart[KASPA_UR_PART_MAX - 1] = 0;
    }
    return 1;
  }
  return -1;
}

static int multisig_feed_policy_ur_scan_part(const char* ur, char* out, size_t outCap, float* pct, char* err,
                                             size_t errLen) {
  if (!scan_payload_looks_like_ur(ur)) return 0;
  if (!g_urPartNormScratch || !g_policyLastUrPart) {
    if (err && errLen) snprintf(err, errLen, "UR scratch missing");
    return SEEDMASK_UR_PSBT_ERROR;
  }
  char* urNorm = g_urPartNormScratch;
  size_t n = strlen(ur);
  if (n >= KASPA_UR_PART_MAX) {
    if (err && errLen) snprintf(err, errLen, "UR too long");
    return SEEDMASK_UR_PSBT_ERROR;
  }
  for (size_t i = 0; i < n; i++)
    urNorm[i] = (char)tolower((unsigned char)ur[i]);
  urNorm[n] = 0;

  uint32_t gotBefore = 0, needBefore = 0;
  seedmask_ur_policy_get_scan_progress(nullptr, &gotBefore, &needBefore, nullptr);
  if (g_policyLastUrPart[0] && strcmp(urNorm, g_policyLastUrPart) == 0) {
    if (pct) {
      float curPct = 0;
      seedmask_ur_policy_get_scan_progress(&curPct, nullptr, nullptr, nullptr);
      *pct = curPct;
    }
    return SEEDMASK_UR_PSBT_NEED_MORE;
  }

  int urRes = seedmask_ur_feed_policy_qr(urNorm, out, outCap, pct, err, errLen);
  if (urRes == SEEDMASK_UR_PSBT_COMPLETE || urRes == SEEDMASK_UR_PSBT_NEED_MORE) {
    uint32_t gotAfter = 0;
    seedmask_ur_policy_get_scan_progress(nullptr, &gotAfter, nullptr, nullptr);
    if (urRes == SEEDMASK_UR_PSBT_COMPLETE || gotAfter > gotBefore || needBefore == 0) {
      strncpy(g_policyLastUrPart, urNorm, KASPA_UR_PART_MAX - 1);
      g_policyLastUrPart[KASPA_UR_PART_MAX - 1] = 0;
    }
  }
  return urRes;
}

/** Feed UR here (like before); return false while assembling so poll redraws HUD + keeps scanning. */
static bool kaspa_poll_consume_ur_part(char* outText, size_t outLen) {
  if (g_qrScanTarget != QrScanTarget::CRYPTO_KASPA_PSKT) return true;

  uint32_t urGot = 0, urNeed = 0;
  seedmask_ur_kaspa_pskt_get_scan_progress(nullptr, &urGot, &urNeed, nullptr);
  const bool fountainActive = (urNeed > 0u) || (urGot > 0u);

  char urErr[128] = { 0 };
  const int urState = kaspa_feed_ur_scan_part(outText, urErr, sizeof(urErr));
  if (urState == 0) {
    if (fountainActive) return false;
    if (kaspa_pskt_qr_payload_looks_valid(outText, strlen(outText))) return true;
    return false;
  }
  if (urState == 1)
    return false;
  if (urState == 2) {
    setMsg("");
    g_kaspaPsktScanLen = strlen(g_kaspaPsktScanBuf);
    size_t n = g_kaspaPsktScanLen;
    if (n >= outLen) n = outLen - 1;
    memcpy(outText, g_kaspaPsktScanBuf, n);
    outText[n] = 0;
    return true;
  }
  setMsg(urErr[0] ? urErr : "PSKT UR error");
  return false;
}

/** Feed Kaspa UR + refresh HUD. Returns true only when full JSON is ready (main loop may finish). */
static bool kaspa_crypto_tx_decode_hit(char* outText, size_t outLen, const uint8_t* raw, camera_fb_t* fb,
                                       float* urPct, uint32_t* urGot, uint32_t* urNeed, bool latchActive,
                                       bool finderOverlay) {
  const bool done = kaspa_poll_consume_ur_part(outText, outLen);
  if (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT)
    seedmask_ur_kaspa_pskt_get_scan_progress(urPct, urGot, urNeed, nullptr);
  crypto_tx_scan_render_hud(raw, psbt_allow_success_cam_blit(), urPct ? *urPct : 0.f, urGot ? *urGot : 0u,
                            urNeed ? *urNeed : 0u, latchActive, finderOverlay);
  if (fb) esp_camera_fb_return(fb);
  return done;
}

#ifndef SEEDMASK_KASPA_SCAN_VIOLENT
#define SEEDMASK_KASPA_SCAN_VIOLENT 1
#endif

/** One staggered violent decode step; returns true only when full PSKT JSON is ready. */
static bool kaspa_try_violent_step(const uint8_t* raw, size_t imgSize, char* outText, size_t outLen, uint8_t step,
                                     int* count) {
  if (!g_gray) return false;
  static const int8_t kOtsuBiases[] = { 0, 8, -6, 12, -12, 4 };
  static const float kZoom[] = { 0.40f, 0.48f, 0.56f, 0.64f, 0.72f, 0.80f, 0.88f };
  const unsigned nOtsu = (unsigned)(sizeof(kOtsuBiases) / sizeof(kOtsuBiases[0]));
  const unsigned nZoom = 7u;

  if (step < nOtsu) {
    memcpy(g_gray, raw, imgSize);
    contrast_stretch_psbt_qr(g_gray, imgSize);
    otsu_binarize(g_gray, imgSize, (int)kOtsuBiases[step] + (int)s_kaspa_mp_otsu_bias);
    return kaspa_try_decode_feed(g_gray, imgSize, outText, outLen, "k-otsu", count);
  }
  if (step == nOtsu) {
    memcpy(g_gray, raw, imgSize);
    mean_binarize(g_gray, imgSize, -8);
    return kaspa_try_decode_feed(g_gray, imgSize, outText, outLen, "k-mean-", count);
  }
  if (step == nOtsu + 1u) {
    memcpy(g_gray, raw, imgSize);
    mean_binarize(g_gray, imgSize, 6);
    return kaspa_try_decode_feed(g_gray, imgSize, outText, outLen, "k-mean+", count);
  }
  if (step == nOtsu + 2u) {
    memcpy(g_gray, raw, imgSize);
    for (size_t i = 0; i < imgSize; i++) g_gray[i] = (uint8_t)(255 - raw[i]);
    return kaspa_try_decode_feed(g_gray, imgSize, outText, outLen, "k-inv", count);
  }
  const unsigned zi = (unsigned)(step - nOtsu - 3u) % nZoom;
  psbt_crop_zoom_resize(raw, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, kZoom[zi]);
  contrast_stretch_psbt_qr(g_gray, imgSize);
  otsu_binarize(g_gray, imgSize, (int)kOtsuBiases[zi % nOtsu]);
  return kaspa_try_decode_feed(g_gray, imgSize, outText, outLen, "k-zoom", count);
}

/** Full fountain snap ladder (Otsu, zooms, mean, invert). */
static const uint8_t kKaspaViolentOrder[16] = { 0, 9, 10, 11, 12, 6, 7, 8, 1, 2, 13, 14, 3, 4, 15, 5 };

/** One ladder step — cheap per poll while UI-only polls keep preview smooth. */
static bool kaspa_violent_decode_one_step(const uint8_t* decodeRaw, size_t imgSize, char* outText, size_t outLen,
                                          camera_fb_t* fb, int* count) {
  const uint8_t step = kKaspaViolentOrder[s_kaspa_decode_slot % 16u];
  s_kaspa_decode_slot = (uint8_t)((s_kaspa_decode_slot + 1u) % 16u);
  if (kaspa_try_violent_step(decodeRaw, imgSize, outText, outLen, step, count)) {
    if (fb) esp_camera_fb_return(fb);
    return true;
  }
  return false;
}

static bool kaspa_violent_decode_burst(const uint8_t* decodeRaw, size_t imgSize, char* outText, size_t outLen,
                                       camera_fb_t* fb, int* count, uint32_t budgetUs, const uint8_t* stepOrder,
                                       unsigned orderLen, unsigned minSteps, unsigned maxSteps) {
  if (!g_gray || !stepOrder || orderLen == 0) return false;
  const uint32_t t0 = micros();
  unsigned ran = 0;
  const unsigned cap = min(maxSteps, (unsigned)SEEDMASK_KASPA_MAX_VIOLENT_STEPS);
  for (unsigned n = 0; n < cap; n++) {
    const uint8_t step = stepOrder[(s_kaspa_decode_slot + n) % orderLen];
    if (kaspa_try_violent_step(decodeRaw, imgSize, outText, outLen, step, count)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    ran++;
    if (ran >= minSteps && (uint32_t)(micros() - t0) >= budgetUs)
      break;
  }
  s_kaspa_decode_slot = (uint8_t)((s_kaspa_decode_slot + ran) % 16u);
  return false;
}

static bool kaspa_scan_finish_if_complete(char* outText, size_t outLen, camera_fb_t* fb) {
  if (!kaspa_decode_finished(outText)) return false;
  if (outText[0]) {
    g_kaspaPsktScanLen = strlen(outText);
    if (g_kaspaPsktScanLen >= KASPA_PSKT_SCAN_MAX)
      g_kaspaPsktScanLen = KASPA_PSKT_SCAN_MAX - 1;
    memcpy(g_kaspaPsktScanBuf, outText, g_kaspaPsktScanLen);
    g_kaspaPsktScanBuf[g_kaspaPsktScanLen] = 0;
  } else if (g_kaspaPsktScanBuf[0]) {
    g_kaspaPsktScanLen = strlen(g_kaspaPsktScanBuf);
    size_t n = g_kaspaPsktScanLen;
    if (n >= outLen) n = outLen - 1;
    memcpy(outText, g_kaspaPsktScanBuf, n);
    outText[n] = 0;
  }
  if (fb) esp_camera_fb_return(fb);
  return g_kaspaPsktScanLen > 0 && kaspa_pskt_qr_payload_looks_valid(g_kaspaPsktScanBuf, g_kaspaPsktScanLen);
}

/** Kaspa PSKT: release camera FB early; decode hard on g_grayRaw; preview on alternating polls only. */
static bool kaspa_pskt_poll_scan(char* outText, size_t outLen, const uint8_t* raw, camera_fb_t* fb, size_t imgSize) {
  float urPct = 0.f;
  uint32_t urGot = 0, urNeed = 0;
  seedmask_ur_kaspa_pskt_get_scan_progress(&urPct, &urGot, &urNeed, nullptr);
  const bool fountain = (urNeed > 0u) || (urGot > 0u);
  const uint32_t now_ms = millis();
  int count = 0;

  const uint8_t* decodeRaw = raw;
#if SEEDMASK_PSBT_EARLY_FB_RETURN
  if (g_grayRaw && fb && imgSize == (size_t)g_qr_w * (size_t)g_qr_h) {
    memcpy(g_grayRaw, raw, imgSize);
    esp_camera_fb_return(fb);
    fb = nullptr;
    decodeRaw = g_grayRaw;
  }
#endif

  if (fountain) {
    s_kaspa_mp_poll_ctr++;
    if (!s_kaspa_fountain_isp_entry_done) {
      psbt_multipart_isp_stabilize(decodeRaw, imgSize, true);
      s_kaspa_fountain_isp_entry_done = true;
    }
  }

  if (kaspa_try_decode_feed(decodeRaw, imgSize, outText, outLen, "k-raw", &count)
      && kaspa_scan_finish_if_complete(outText, outLen, fb))
    return true;

  const bool sawQr = (count > 0);
  if (sawQr)
    s_kaspa_engaged_until_ms = now_ms + (uint32_t)SEEDMASK_KASPA_ENGAGED_LATCH_MS;
  const bool engagedLatch =
      (s_kaspa_engaged_until_ms != 0 && now_ms < s_kaspa_engaged_until_ms);
  const bool snapNow = sawQr || fountain || engagedLatch;
  const uint32_t uiEveryN = (uint32_t)max(2, (int)SEEDMASK_KASPA_FOUNTAIN_UI_EVERY_N);
  const bool uiOnlyPoll = fountain && ((s_kaspa_mp_poll_ctr % uiEveryN) == 0u);
  const bool decodePoll = !uiOnlyPoll;

#if SEEDMASK_KASPA_SCAN_VIOLENT
  if (decodePoll && snapNow && g_gray) {
    if (sawQr && !fountain) {
      memcpy(g_gray, decodeRaw, imgSize);
      contrast_stretch_psbt_qr(g_gray, imgSize);
      otsu_binarize(g_gray, imgSize, 0);
      if (kaspa_try_decode_feed(g_gray, imgSize, outText, outLen, "k-snap0", &count)
          && kaspa_scan_finish_if_complete(outText, outLen, fb))
        return true;
    }
    const bool mpStalled = fountain && (s_kaspa_no_prog >= (uint32_t)SEEDMASK_KASPA_STALL_NO_PROG_POLLS);
    if (fountain && !mpStalled) {
      if (kaspa_violent_decode_one_step(decodeRaw, imgSize, outText, outLen, fb, &count)
          && kaspa_scan_finish_if_complete(outText, outLen, fb))
        return true;
    } else {
      uint32_t budget = fountain ? (uint32_t)SEEDMASK_KASPA_DECODE_BUDGET_FOUNTAIN_US
                                 : (uint32_t)SEEDMASK_KASPA_DECODE_BUDGET_PREFOUNTAIN_US;
      unsigned minSteps =
          fountain ? (unsigned)SEEDMASK_KASPA_MIN_VIOLENT_FOUNTAIN : (unsigned)SEEDMASK_KASPA_MIN_VIOLENT_PREFOUNTAIN;
      unsigned maxSteps =
          fountain ? (unsigned)SEEDMASK_KASPA_MAX_VIOLENT_FOUNTAIN : 6u;
      if (mpStalled) {
        budget = (uint32_t)SEEDMASK_KASPA_DECODE_BUDGET_STALL_US;
        minSteps = (unsigned)SEEDMASK_KASPA_MIN_VIOLENT_STALL;
        maxSteps = (unsigned)SEEDMASK_KASPA_MAX_VIOLENT_STEPS;
        s_kaspa_decode_slot = 0;
      }
      if (kaspa_violent_decode_burst(decodeRaw, imgSize, outText, outLen, fb, &count, budget, kKaspaViolentOrder, 16u,
                                     minSteps, maxSteps)
          && kaspa_scan_finish_if_complete(outText, outLen, fb))
        return true;
      if (mpStalled && g_gray) {
        static const int8_t kMpCrisp[] = { 0, 8, -6 };
        for (unsigned bi = 0; bi < (sizeof(kMpCrisp) / sizeof(kMpCrisp[0])); bi++) {
          memcpy(g_gray, decodeRaw, imgSize);
          contrast_stretch_psbt_qr(g_gray, imgSize);
          otsu_binarize(g_gray, imgSize, (int)kMpCrisp[bi] + (int)s_kaspa_mp_otsu_bias);
          if (kaspa_try_decode_feed(g_gray, imgSize, outText, outLen, "k-mp", &count)
              && kaspa_scan_finish_if_complete(outText, outLen, fb))
            return true;
        }
      }
    }
  } else if (decodePoll && g_gray) {
    memcpy(g_gray, decodeRaw, imgSize);
    contrast_stretch_psbt_qr(g_gray, imgSize);
    otsu_binarize(g_gray, imgSize, 0);
    if (kaspa_try_decode_feed(g_gray, imgSize, outText, outLen, "k-hunt", &count)
        && kaspa_scan_finish_if_complete(outText, outLen, fb))
      return true;
  }
#else
  if (g_gray && snapNow) {
    memcpy(g_gray, decodeRaw, imgSize);
    contrast_stretch_psbt_qr(g_gray, imgSize);
    otsu_binarize(g_gray, imgSize, 0);
    if (kaspa_try_decode_feed(g_gray, imgSize, outText, outLen, "k-otsu", &count)
        && kaspa_scan_finish_if_complete(outText, outLen, fb))
      return true;
  }
#endif

  seedmask_ur_kaspa_pskt_get_scan_progress(&urPct, &urGot, &urNeed, nullptr);
  if (urGot > s_kaspa_last_got) {
    kaspa_after_part_accepted(now_ms);
    s_kaspa_last_got = urGot;
    s_kaspa_no_prog = 0;
  } else if (fountain && s_kaspa_no_prog < 0xFFFFu) {
    s_kaspa_no_prog++;
    if (s_kaspa_no_prog >= (uint32_t)SEEDMASK_KASPA_STALL_NO_PROG_POLLS)
      s_kaspa_mp_otsu_bias = ((s_kaspa_mp_poll_ctr & 1u) == 0u) ? 8 : -6;
  }

  const bool progressChanged = (urGot != s_kaspa_hud_last_draw_got) || (urNeed != s_kaspa_hud_last_draw_need);
  const bool previewDue =
      (s_kaspa_preview_ms == 0) || (uint32_t)(now_ms - s_kaspa_preview_ms) >= (uint32_t)SEEDMASK_KASPA_PREVIEW_MS_FOUNTAIN;
  const bool partUiCooldown =
      fountain && s_kaspa_part_ui_cooldown_until_ms != 0 && now_ms < s_kaspa_part_ui_cooldown_until_ms;

  if (fountain) {
    if (partUiCooldown) {
      if (progressChanged)
        kaspa_paint_progress_text_bar(urGot, urNeed);
    } else if (uiOnlyPoll && previewDue) {
      kaspa_paint_fountain_live(decodeRaw, urGot, urNeed);
      s_kaspa_preview_ms = now_ms;
    } else if (progressChanged) {
      kaspa_paint_progress_text_bar(urGot, urNeed);
    }
  } else if (!snapNow) {
    const bool huntPreview =
        (s_kaspa_preview_ms == 0) || (uint32_t)(now_ms - s_kaspa_preview_ms) >= (uint32_t)SEEDMASK_KASPA_PREVIEW_MS_HUNT;
    if (huntPreview) {
      crypto_tx_scan_render_hud(decodeRaw, true, urPct, urGot, urNeed, false, false);
      s_kaspa_preview_ms = now_ms;
    }
  } else {
    if (previewDue) {
      kaspa_paint_fountain_live(decodeRaw, urGot, urNeed);
      s_kaspa_first_snap_hud = true;
      s_kaspa_preview_ms = now_ms;
    } else if (progressChanged) {
      kaspa_paint_progress_text_bar(urGot, urNeed);
    }
  }

  if (progressChanged || (s_kaspa_preview_ms == now_ms)) {
    s_kaspa_hud_last_draw_got = urGot;
    s_kaspa_hud_last_draw_need = urNeed;
  }

  if (fb) esp_camera_fb_return(fb);
  return false;
}

/** After Quirc decode in Bitcoin PSBT or Kaspa PSKT scan: feed UR parts, draw HUD, return whether main loop should finish. */
static bool crypto_tx_scan_poll_decode_success(char* outText, size_t outLen, const uint8_t* raw, camera_fb_t* fb,
                                               float* urPct, uint32_t* urGot, uint32_t* urNeed, bool latchActive,
                                               bool finderOverlay) {
  if (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT)
    return kaspa_crypto_tx_decode_hit(outText, outLen, raw, fb, urPct, urGot, urNeed, latchActive, finderOverlay);
  crypto_tx_scan_render_hud(raw, psbt_allow_success_cam_blit(), urPct ? *urPct : 0.f, urGot ? *urGot : 0u,
                          urNeed ? *urNeed : 0u, latchActive, finderOverlay);
  if (fb) esp_camera_fb_return(fb);
  return true;
}

static bool poll_qr_scan_result(char* outText, size_t outLen) {
  const uint32_t tPollStartUs = micros();
  if (!g_camOn) return false;
  const bool isTfaQrMode = (g_qrScanTarget == QrScanTarget::TFA_ADD);
  const bool isPsbtQrMode = (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT);
  const bool isKaspaTxQrMode = (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT);
  /** Dense-monitor QR scan: Bitcoin PSBT (BIP174) or Kaspa PSKT (coordinator JSON in ur:bytes/). */
  const bool isCryptoTxQrScan = isPsbtQrMode || isKaspaTxQrMode;
  const bool isSeedQrOnlyMode = (g_qrScanTarget == QrScanTarget::RESTORE && g_restoreSeedQrOnlyScan);
  /** Encrypted / vault QR restore (not compact SeedQR): stay on VGA, tune preview + decode for smooth scan. */
  const bool restoreEncQr = (g_qrScanTarget == QrScanTarget::RESTORE && !g_restoreSeedQrOnlyScan);
  /** When already locked on a QR: run Quirc before LCD blit so SPI cannot stall decode (same capture — raw/g_grayRaw). */
  bool vaultDeferredRestoreUi = false;
  int vault_mp_have = 0;
  if (restoreEncQr && g_restoreChunkTotal > 0) {
    for (int i = 0; i < g_restoreChunkTotal; i++) vault_mp_have += g_restoreChunkGot[i];
  }
  const bool vaultMpNeedMore =
    restoreEncQr && g_restoreChunkTotal > 0 && vault_mp_have < (int)g_restoreChunkTotal;
  /** Multipart SPE1-M or stuck ECC: never use alternating fast-path skips — same ladder every poll (fixes “some parts freeze”). */
  const bool vaultDecodeUniform =
    vaultMpNeedMore || (restoreEncQr && g_qr_decode_fail_streak >= 5);
  if (restoreEncQr && s_vault_mp_handoff_until_ms != 0 && (int32_t)(millis() - s_vault_mp_handoff_until_ms) >= 0)
    s_vault_mp_handoff_until_ms = 0;
  const bool vaultHandoffActive = restoreEncQr && s_vault_mp_handoff_until_ms != 0;

  camera_fb_t* fb = esp_camera_fb_get();
  if (!fb) return false;
  if ((int)fb->width != g_qr_w || (int)fb->height != g_qr_h) {
    if (!sync_quirc_gray_to_live_fb(fb)) {
      esp_camera_fb_return(fb);
      return false;
    }
  }

  size_t imgSize = (size_t)g_qr_w * (size_t)g_qr_h;
  const uint8_t* raw = (const uint8_t*)fb->buf;

  // ========================================================================
  //  Bitcoin PSBT / Kaspa PSKT camera — idle vs engaged vs fountain (BC-UR multipart).
  //  IDLE: raw decode + periodic AE + occasional idle Otsu probe.
  //  ENGAGED: washout ISP clamp + zoom/Otsu variants (third variant gated); overlay uses cached raw finder geometry.
  //  FOUNTAIN: raw then crisp Otsu; OV5640 multipart ISP re-applied every frame (HW AE fights single writes).
  // ========================================================================
  if (isCryptoTxQrScan) {
    const uint32_t captureUs = (uint32_t)(micros() - tPollStartUs);
    uint32_t renderUs = 0;
    bool earlyUiDrawn = false;
    auto decodeBudgetOk = [&](uint32_t reserveUs) -> bool {
      return ((uint32_t)(micros() - tPollStartUs) + reserveUs) < (uint32_t)SEEDMASK_PSBT_FRAME_BUDGET_US;
    };
#if SEEDMASK_PSBT_EARLY_FB_RETURN
    if (g_grayRaw && imgSize == (size_t)g_qr_w * (size_t)g_qr_h) {
      memcpy(g_grayRaw, raw, imgSize);
      esp_camera_fb_return(fb);
      fb = nullptr;
      raw = g_grayRaw;
    }
#endif
    if (isKaspaTxQrMode)
      return kaspa_pskt_poll_scan(outText, outLen, raw, fb, imgSize);

    float urPct = 0;
    uint32_t urGot = 0, urNeed = 0;
    int urMulti = 0;
    seedmask_ur_psbt_get_scan_progress(&urPct, &urGot, &urNeed, &urMulti);
    (void)urMulti;
    const uint32_t now_ms = millis();

    int count = 0;

    if (try_decode_frame_variant(raw, imgSize, outText, outLen, "raw", &count)) {
      const bool done = crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, false, false);
#if SEEDMASK_PSBT_TELEMETRY
      const uint32_t totalUs = (uint32_t)(micros() - tPollStartUs);
      const uint32_t decodeUs = (totalUs > captureUs + renderUs) ? (totalUs - captureUs - renderUs) : 0;
      psbt_perf_log_tick(captureUs, decodeUs, renderUs, totalUs, false, millis());
#endif
      if (done)
        return done;
    }
    if (count > 0 && g_q) {
      const int n = count > 4 ? 4 : count;
      s_psbt_raw_overlay_n = n;
      for (int i = 0; i < n; i++)
        quirc_extract(g_q, i, &s_psbt_raw_overlay_codes[i]);
    } else {
      s_psbt_raw_overlay_n = 0;
    }

    const bool ur_assembling = (urNeed > 0u) || (urGot > 0u);
    if (count > 0 && !ur_assembling) {
      if (g_psbtLatchRaw && g_psbtLatchImgBytes != imgSize) {
        free(g_psbtLatchRaw);
        g_psbtLatchRaw = nullptr;
        g_psbtLatchImgBytes = 0;
      }
      if (!g_psbtLatchRaw) {
        g_psbtLatchRaw = (uint8_t*)ps_malloc(imgSize);
        if (g_psbtLatchRaw) g_psbtLatchImgBytes = imgSize;
      }
      if (g_psbtLatchRaw)
        memcpy(g_psbtLatchRaw, raw, imgSize);
      g_psbtLatchUntilMs = now_ms + (uint32_t)SEEDMASK_PSBT_LATCH_HOLD_MS;
    }
    const bool latchActive = (!ur_assembling && count <= 0 && g_psbtLatchRaw && now_ms < g_psbtLatchUntilMs);
    const uint8_t* decodeBase = latchActive ? g_psbtLatchRaw : raw;
    const bool finder_sees_qr = (count > 0) || latchActive;
    // Raw grayscale pass is the best “finder” signal; inner variants overwrite `count` — keep this for ISP tuning.
    const int rawQuircDetections = count;
    s_qr_last_count = finder_sees_qr ? max(rawQuircDetections, 1) : 0;
    const bool engaged = ur_assembling || finder_sees_qr;
    const bool enter_mpart = ur_assembling && !g_psbt_was_multipart;
    const bool progressChanged = (urGot != s_psbt_hud_last_got) || (urNeed != s_psbt_hud_last_need);

    // Optional pre-decode live refresh. Disabled by default because it can steal too much budget from decode.
#if SEEDMASK_PSBT_PREDECODE_UI
    {
      const int pvStep = seedmask_qr_preview_step_for_width();
      const int prevTop = 46;
      const uint32_t camGap = ur_assembling
                                ? (uint32_t)SEEDMASK_PSBT_CAM_PREVIEW_MIN_MS_MP
                                : (uint32_t)SEEDMASK_PSBT_CAM_PREVIEW_MIN_MS;
      const bool renderBudgetOk = (uint32_t)(micros() - tPollStartUs) < (uint32_t)SEEDMASK_PSBT_RENDER_BUDGET_US;
      const bool camDue = engaged && (g_psbt_last_cam_preview_ms == 0 || (uint32_t)(now_ms - g_psbt_last_cam_preview_ms) >= camGap);
      const bool hudDueEarly = enter_mpart || progressChanged || (engaged && (uint32_t)(now_ms - g_psbt_last_hud_ms) >= (uint32_t)SEEDMASK_PSBT_HUD_MS);
      if ((camDue && renderBudgetOk) || hudDueEarly) {
        const uint32_t tR = micros();
        if (camDue) {
          g_psbt_cam_preview_step = pvStep;
          g_psbt_last_cam_preview_ms = now_ms;
          drawCameraPreviewGray(raw, pvStep, prevTop);
          const int outH = min((g_qr_h * 2) / pvStep, PREVIEW_H);
          const int endY = prevTop + outH;
          if (endY < LCD_H) gfx->fillRect(0, endY, LCD_W, LCD_H - endY, RGB565_BLACK);
          if (!ur_assembling && s_psbt_raw_overlay_n > 0)
            drawQRDetectOverlayFromCodes(s_psbt_raw_overlay_codes, s_psbt_raw_overlay_n);
        }
        if (hudDueEarly) {
          g_psbt_last_hud_ms = now_ms;
          s_psbt_hud_last_got = urGot;
          s_psbt_hud_last_need = urNeed;
          gfx->fillRect(0, 40, LCD_W, 20, RGB565_BLACK);
          gfx->setTextColor(RGB565_WHITE);
          gfx->setTextSize(1);
          gfx->setCursor(10, 44);
          if (urNeed > 0) {
            int ip = (int)(urPct * 100.0f + 0.5f);
            if (ip < 0) ip = 0;
            if (ip > 100) ip = 100;
            if (isKaspaTxQrMode)
              gfx->print("PSKT UR ");
            else
              gfx->print("PSBT UR ");
            gfx->setTextColor(RGB565_CYAN);
            gfx->print(ip);
            gfx->print("%");
            gfx->setTextColor(RGB565_WHITE);
            gfx->printf("  %lu/%lu", (unsigned long)urGot, (unsigned long)urNeed);
          } else if (s_qr_last_count > 0) {
            if (isKaspaTxQrMode)
              gfx->print(latchActive ? "PSKT locked - hold steady..." : "PSKT QR seen - decoding...");
            else if (latchActive)
              gfx->print("QR locked - keep steady...");
            else
              gfx->print("QR seen - decoding...");
          } else {
            s_qr_spinner = (s_qr_spinner + 1) % 4;
            if (isKaspaTxQrMode)
              gfx->print("Point PSKT QR ");
            else
              gfx->print("Point Sparrow QR ");
            for (int d = 0; d < s_qr_spinner; d++) gfx->print(".");
            for (int d = s_qr_spinner; d < 3; d++) gfx->print(" ");
          }
          drawBtn(BTN_CRYPTO_SCAN_BACK, "BACK", RGB565_DARKGREY, 2);
        }
        ui_flush();
        renderUs += (uint32_t)(micros() - tR);
        earlyUiDrawn = true;
        g_psbt_cam_preview_step = 0;
      }
    }
#endif

    if (finder_sees_qr && !ur_assembling) {
      psbt_engaged_isp_washout_clamp(decodeBase, imgSize, rawQuircDetections);
    }

    if (enter_mpart) {
      psbt_multipart_isp_stabilize(raw, imgSize, true);
      s_psbt_eng_phase = 0;
    }
    g_psbt_was_multipart = ur_assembling;

    static const float kPsbtZooms[] = { 0.62f, 0.45f };
    const uint8_t nZooms = (uint8_t)(sizeof(kPsbtZooms) / sizeof(kPsbtZooms[0]));

    if (!engaged) {
      g_psbt_idle_ticks++;
      g_qr_decode_fail_streak = 0;
      const bool idleWarmup = (g_psbt_idle_ticks <= (uint32_t)SEEDMASK_PSBT_IDLE_WARMUP_TICKS);
      if (g_gray && (idleWarmup ? ((g_psbt_idle_ticks % 4u) == 0u) : ((g_psbt_idle_ticks % 8u) == 0u))) {
        memcpy(g_gray, raw, imgSize);
        contrast_stretch_psbt_qr(g_gray, imgSize);
        otsu_binarize(g_gray, imgSize, 0);
        if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "idle-probe", &count)) {
          return crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, false, false);
        }
      }

      if (idleWarmup) {
        psbt_adaptive_camera_tune(raw, imgSize, 0);
        psbt_idle_warmup_isp(raw, imgSize);
      } else if ((g_psbt_idle_ticks % 12u) == 0u) {
        psbt_adaptive_camera_tune(raw, imgSize, 0);
      }
    } else if (ur_assembling) {
      // Fountain / animated UR (and Kaspa pre-first-part hunt): crisp Otsu + multipart ISP.
      g_psbt_idle_ticks = 0;
#if SEEDMASK_PSBT_FOUNTAIN_VIOLENT
      {
        const uint32_t ispN = (uint32_t)max(1, (int)SEEDMASK_PSBT_FOUNTAIN_MP_ISP_EVERY_N);
        const bool mpIspDue =
            enter_mpart || (s_psbt_mp_no_progress_polls >= 1u) || ((s_psbt_mp_poll_ctr % ispN) == 0u);
        if (mpIspDue)
          psbt_multipart_isp_stabilize(raw, imgSize, enter_mpart);
      }
#else
      if (!enter_mpart)
        psbt_multipart_isp_stabilize(raw, imgSize, false);
#endif

      s_psbt_mp_poll_ctr++;
      if (urGot > s_psbt_mp_last_got) {
        s_psbt_mp_last_got = urGot;
        s_psbt_mp_no_progress_polls = 0;
      } else if (s_psbt_mp_no_progress_polls < 0xFFFFu) {
        s_psbt_mp_no_progress_polls++;
      }
      const bool mpStalled =
#if SEEDMASK_PSBT_FOUNTAIN_VIOLENT
          (s_psbt_mp_no_progress_polls >= 1u);
#else
          (s_psbt_mp_no_progress_polls >= 2u);
#endif
      const bool mpFlowing = (urGot > 0u) && (s_psbt_mp_no_progress_polls <= 1u);
      if (mpFlowing) {
        if (s_psbt_mp_otsu_bias > 0) s_psbt_mp_otsu_bias--;
        else if (s_psbt_mp_otsu_bias < 0) s_psbt_mp_otsu_bias++;
      } else if (mpStalled) {
        s_psbt_mp_otsu_bias = ((s_psbt_mp_poll_ctr & 1u) == 0u) ? 8 : -6;
      }
#if SEEDMASK_PSBT_FOUNTAIN_VIOLENT
      const bool runMpCrisp = true;
      const bool allowMpHeavy = true;
#else
      const uint32_t flowMod = mpFlowing ? (uint32_t)SEEDMASK_PSBT_FOUNTAIN_CRISP_FLOW_MOD : 2u;
      const uint32_t crispEvery = flowMod ? flowMod : 1u;
      bool runMpCrisp =
          enter_mpart || mpStalled || ((s_psbt_mp_poll_ctr % crispEvery) == 0u);
      bool allowMpHeavy =
          mpStalled || mpFlowing || (urNeed > 0u && urGot == 0u) || decodeBudgetOk(4500u);
#endif

      if (g_gray && runMpCrisp && allowMpHeavy) {
#if SEEDMASK_PSBT_FOUNTAIN_VIOLENT
        static const int8_t kMpViolentBiases[] = { 0, 8, -6, 12, -12 };
        for (unsigned bi = 0; bi < (sizeof(kMpViolentBiases) / sizeof(kMpViolentBiases[0])); bi++) {
          memcpy(g_gray, raw, imgSize);
          contrast_stretch_psbt_qr(g_gray, imgSize);
          otsu_binarize(g_gray, imgSize, (int)kMpViolentBiases[bi]);
          if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "mp-crisp", &count)) {
            return crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, latchActive, false);
          }
        }
#if SEEDMASK_PSBT_FOUNTAIN_MP_ALT
        memcpy(g_gray, raw, imgSize);
        contrast_stretch_psbt_qr(g_gray, imgSize);
        otsu_binarize(g_gray, imgSize, +14);
        if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "mp-alt", &count)) {
          return crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, latchActive, false);
        }
#endif
        memcpy(g_gray, raw, imgSize);
        mean_binarize(g_gray, imgSize, -8);
        if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "mp-mean-", &count)) {
          return crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, latchActive, false);
        }
        memcpy(g_gray, raw, imgSize);
        mean_binarize(g_gray, imgSize, 6);
        if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "mp-mean+", &count)) {
          return crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, latchActive, false);
        }
#else
        memcpy(g_gray, raw, imgSize);
        contrast_stretch_psbt_qr(g_gray, imgSize);
        otsu_binarize(g_gray, imgSize, (int)s_psbt_mp_otsu_bias);
        if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "mp-crisp", &count)) {
          return crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, latchActive, false);
        }
#if SEEDMASK_PSBT_FOUNTAIN_MP_ALT
        if ((++s_psbt_fountain_alt_tick & 1u) == 0u) {
          memcpy(g_gray, raw, imgSize);
          contrast_stretch_psbt_qr(g_gray, imgSize);
          otsu_binarize(g_gray, imgSize, +8);
          if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "mp-alt", &count)) {
            return crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, latchActive, false);
          }
        }
#endif
        yield();
#endif
      }
#if !SEEDMASK_PSBT_FOUNTAIN_VIOLENT
      if (g_gray && mpFlowing && decodeBudgetOk(2000u)) {
        memcpy(g_gray, raw, imgSize);
        mean_binarize(g_gray, imgSize, -5);
        if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "mp-mean", &count)) {
          return crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, latchActive, false);
        }
      }
#endif
    } else {
      g_psbt_idle_ticks = 0;
      s_psbt_eng_poll_ctr++;

      bool decoded = false;
      if (g_gray) {
        float zf = kPsbtZooms[g_psbt_zoom_i % nZooms];
#if SEEDMASK_PSBT_ENGAGED_STAGGER_DECODE
        const unsigned ph = (unsigned)s_psbt_eng_phase % 3u;
        // One variant per poll so loop() can redraw HUD between heavy Quirc passes.
        if (ph == 0u) {
          memcpy(g_gray, decodeBase, imgSize);
          contrast_stretch_psbt_qr(g_gray, imgSize);
          otsu_binarize(g_gray, imgSize, 0);
          if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "eng-raw-otsu", &count))
            decoded = true;
        } else if (ph == 1u) {
          if (decodeBudgetOk(5000u)) {
            psbt_crop_zoom_resize(decodeBase, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf);
            if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "eng-z-first", &count))
              decoded = true;
          }
        } else {
          const bool runEngZo12St =
            (g_qr_decode_fail_streak >= (uint32_t)SEEDMASK_PSBT_ENGAGED_ZO12_FAIL_STREAK) && decodeBudgetOk(7000u)
            && (SEEDMASK_PSBT_ENGAGED_ZO12_POLL_MOD <= 1 || ((s_psbt_eng_poll_ctr % (uint32_t)SEEDMASK_PSBT_ENGAGED_ZO12_POLL_MOD) == 0u));
          if (runEngZo12St) {
            psbt_crop_zoom_resize(decodeBase, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf);
            contrast_stretch_psbt_qr(g_gray, imgSize);
            otsu_binarize(g_gray, imgSize, +12);
            if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "eng-zo12", &count))
              decoded = true;
          }
          g_psbt_zoom_i = (uint8_t)((g_psbt_zoom_i + 1u) % nZooms);
        }
        yield();
        s_psbt_eng_phase = (uint8_t)((s_psbt_eng_phase + 1u) % 3u);
#else
        memcpy(g_gray, decodeBase, imgSize);
        contrast_stretch_psbt_qr(g_gray, imgSize);
        otsu_binarize(g_gray, imgSize, 0);
        if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "eng-raw-otsu", &count))
          decoded = true;
        yield();
        if (!decoded) {
          if (decodeBudgetOk(5000u)) {
            psbt_crop_zoom_resize(decodeBase, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf);
            if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "eng-z-first", &count))
              decoded = true;
            yield();
          }
        }
        const bool runEngZo12 =
          (g_qr_decode_fail_streak >= (uint32_t)SEEDMASK_PSBT_ENGAGED_ZO12_FAIL_STREAK) && decodeBudgetOk(7000u)
          && (SEEDMASK_PSBT_ENGAGED_ZO12_POLL_MOD <= 1 || ((s_psbt_eng_poll_ctr % (uint32_t)SEEDMASK_PSBT_ENGAGED_ZO12_POLL_MOD) == 0u));
#if SEEDMASK_PSBT_FOUNTAIN_VIOLENT
        if (!decoded && finder_sees_qr && decodeBudgetOk(4000u)) {
          psbt_crop_zoom_resize(decodeBase, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, 0.55f);
          contrast_stretch_psbt_qr(g_gray, imgSize);
          otsu_binarize(g_gray, imgSize, 0);
          if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "eng-violent-z", &count))
            decoded = true;
        }
#endif
        if (!decoded && runEngZo12) {
          psbt_crop_zoom_resize(decodeBase, g_qr_w, g_qr_h, g_gray, g_qr_w, g_qr_h, zf);
          contrast_stretch_psbt_qr(g_gray, imgSize);
          otsu_binarize(g_gray, imgSize, +12);
          if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "eng-zo12", &count))
            decoded = true;
          yield();
        }
        g_psbt_zoom_i = (uint8_t)((g_psbt_zoom_i + 1u) % nZooms);
#endif
      }

      if (decoded) {
        s_psbt_eng_phase = 0;
#if SEEDMASK_PSBT_TELEMETRY
        const bool ok = crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, latchActive, false);
        const uint32_t totalUs = (uint32_t)(micros() - tPollStartUs);
        const uint32_t decodeUs = (totalUs > captureUs + renderUs) ? (totalUs - captureUs - renderUs) : 0;
        psbt_perf_log_tick(captureUs, decodeUs, renderUs, totalUs, progressChanged, now_ms);
        return ok;
#else
        return crypto_tx_scan_poll_decode_success(outText, outLen, raw, fb, &urPct, &urGot, &urNeed, latchActive, false);
#endif
      }

      // No psbt_adaptive_camera_tune here: finder is always locked in this branch — tuning caused visible smear.

      if (g_qr_decode_fail_streak < 0xFFFF) g_qr_decode_fail_streak++;
      yield();
    }

    const uint32_t camThrottleMs =
      ur_assembling ? (uint32_t)SEEDMASK_PSBT_CAM_PREVIEW_MIN_MS_MP
                    : ((engaged && finder_sees_qr) ? (uint32_t)SEEDMASK_PSBT_CAM_PREVIEW_ENGAGED_MS
                                                   : (uint32_t)SEEDMASK_PSBT_CAM_PREVIEW_MIN_MS);
    const bool skipCamThrottle =
      (camThrottleMs > 0) && !enter_mpart && g_psbt_last_cam_preview_ms != 0 && (uint32_t)(now_ms - g_psbt_last_cam_preview_ms) < camThrottleMs;
    bool paintCam = !skipCamThrottle;
#if SEEDMASK_PSBT_FOUNTAIN_VIOLENT
    if (ur_assembling && paintCam) {
      const uint32_t prevN = (uint32_t)max(1, (int)SEEDMASK_PSBT_FOUNTAIN_PREVIEW_EVERY_N);
      paintCam = enter_mpart || progressChanged || ((s_psbt_mp_poll_ctr % prevN) == 0u);
    }
#endif

    if (!earlyUiDrawn) {
      const uint32_t tR = micros();
      /* Do not fillScreen here — same-frame preview blit keeps live view smooth (PSBT + Kaspa fountain). */
      (void)enter_mpart;

      crypto_tx_scan_render_hud(raw, paintCam, urPct, urGot, urNeed, latchActive,
                               !ur_assembling && s_psbt_raw_overlay_n > 0);

      renderUs += (uint32_t)(micros() - tR);
    }

    if (fb) esp_camera_fb_return(fb);
    // Dense monitor UR/JSON at VGA: request SVGA upgrade from loop() (PSBT + Kaspa fountain).
    if (isCryptoTxQrScan && g_qr_framesize == FRAMESIZE_VGA) {
      const bool stallDense =
        ur_assembling && s_psbt_mp_no_progress_polls >= 2u && urNeed > 0u && urGot + 2u < urNeed;
      const uint32_t svgaFailStreak =
#if SEEDMASK_PSBT_FOUNTAIN_VIOLENT
        4u;
#else
        7u;
#endif
      if ((rawQuircDetections > 0 && g_qr_decode_fail_streak >= (int)svgaFailStreak) || stallDense
          || (!ur_assembling && !finder_sees_qr && g_qr_decode_fail_streak >= 22))
        g_qr_need_high_res = true;
    }
#if SEEDMASK_PSBT_TELEMETRY
    if (isCryptoTxQrScan) {
      const uint32_t totalUs = (uint32_t)(micros() - tPollStartUs);
      const uint32_t decodeUs = (totalUs > captureUs + renderUs) ? (totalUs - captureUs - renderUs) : 0;
      psbt_perf_log_tick(captureUs, decodeUs, renderUs, totalUs, progressChanged, now_ms);
    }
#endif
    yield();
    return false;
  }

  // SeedQR-only restore mode: lightweight path (raw decode only, no heavy preprocessing).
  if (isSeedQrOnlyMode) {
    static uint8_t s_seedqr_preview_skip = 0;
    if ((++s_seedqr_preview_skip & 1u) == 0u) {
      drawCameraPreviewGray(raw);
      if (s_qr_last_count > 0) drawQRDetectOverlay(g_q, s_qr_last_count);
      gfx->fillRect(0, 40, LCD_W, 20, RGB565_BLACK);
      gfx->setTextColor(RGB565_WHITE);
      gfx->setTextSize(1);
      gfx->setCursor(10, 44);
      if (s_qr_last_count > 0) gfx->print("SeedQR seen - decoding...");
      else gfx->print("Scan SeedQR");
      drawGradientSilverButton(BTN_SCAN_BACK, "BACK", 1);
      ui_flush();
    }

    int count = 0;
    if (try_decode_frame_variant(raw, imgSize, outText, outLen, "seedqr-raw", &count)) {
      esp_camera_fb_return(fb);
      return true;
    }
    esp_camera_fb_return(fb);
    if (g_qr_decode_fail_streak < 0xFFFF) g_qr_decode_fail_streak++;
    return false;
  }

  // Bitcoin Tools (Verify / Sign message): lightweight path — not PSBT UR pipeline, not vault restore.
  const bool isToolsQrMode = (g_qrScanTarget == QrScanTarget::TOOLS_VERIFY_ADDRESS || g_qrScanTarget == QrScanTarget::TOOLS_SIGN_MESSAGE || g_qrScanTarget == QrScanTarget::MULTISIG_POLICY);
  if (isToolsQrMode) {
    static uint8_t s_tools_preview_skip = 0;
    if ((++s_tools_preview_skip & 1u) == 0u) {
      drawCameraPreviewGray(raw);
      if (s_qr_last_count > 0) drawQRDetectOverlay(g_q, s_qr_last_count);
      {
        const int step = seedmask_qr_preview_step_for_width();
        const int outH = min((g_qr_h * 2) / step, PREVIEW_H);
        const int endY = 60 + outH;
        if (endY < LCD_H) gfx->fillRect(0, endY, LCD_W, LCD_H - endY, RGB565_BLACK);
      }
      gfx->fillRect(0, 40, LCD_W, 20, RGB565_BLACK);
      gfx->setTextColor(RGB565_WHITE);
      gfx->setTextSize(1);
      gfx->setCursor(10, 44);
      float polPct = 0;
      uint32_t polGot = 0, polNeed = 0;
      int polMulti = 0;
      seedmask_ur_policy_get_scan_progress(&polPct, &polGot, &polNeed, &polMulti);
      const bool policyMultipartHud = (g_qrScanTarget == QrScanTarget::MULTISIG_POLICY && polNeed > 0);
      if (policyMultipartHud) {
        int ip = (int)(polPct * 100.0f + 0.5f);
        if (ip < 0) ip = 0;
        if (ip > 100) ip = 100;
        gfx->setTextColor(RGB565_WHITE);
        gfx->print("Policy UR ");
        gfx->setTextColor(RGB565_CYAN);
        gfx->print(ip);
        gfx->print("%");
        gfx->setTextColor(RGB565_WHITE);
        gfx->printf("  %lu/%lu", (unsigned long)polGot, (unsigned long)polNeed);
        const int step = seedmask_qr_preview_step_for_width();
        const int outH = min((g_qr_h * 2) / step, PREVIEW_H);
        const int endY = 60 + outH;
        const int barH = 12;
        int barY = endY - barH - 8;
        if (barY < 140) barY = 140;
        const int barX = 16;
        const int barW = LCD_W - 32;
        const uint16_t barBg = UI_CARD;
        const uint16_t barOutline = UI_BORDER;
        const uint16_t barBlue = blendRGB565(RGB565_BLUE, RGB565_CYAN, 0.45f);
        const uint16_t barBlueHi = blendRGB565(barBlue, RGB565_WHITE, 0.30f);
        gfx->fillRoundRect(barX, barY, barW, barH, 5, barBg);
        gfx->drawRoundRect(barX, barY, barW, barH, 5, barOutline);
        int filledW = (barW * ip + 50) / 100;
        if (filledW < 0) filledW = 0;
        if (ip > 0 && filledW < 1) filledW = 1;
        if (filledW > 0) {
          const int filledR = min(6, max(2, filledW / 2));
          gfx->fillRoundRect(barX, barY, filledW, barH, filledR, barBlue);
          const int hiY0 = barY + 2;
          const int hiY1 = barY + 4;
          if (hiY1 > hiY0) gfx->fillRect(barX + 1, hiY0, max(0, filledW - 2), hiY1 - hiY0, barBlueHi);
          const int hiX0 = barX + 1;
          const int hiX1 = barX + filledW - 2;
          if (hiX1 > hiX0) gfx->drawLine(hiX0, barY + 5, hiX1, barY + 5, barBlueHi);
        }
      } else if (s_qr_last_count > 0) {
        if (g_qrScanTarget == QrScanTarget::TOOLS_SIGN_MESSAGE) gfx->print("Message QR seen");
        else if (g_qrScanTarget == QrScanTarget::MULTISIG_POLICY) gfx->print("Policy QR seen");
        else gfx->print("Address QR seen");
      } else {
        if (g_qrScanTarget == QrScanTarget::TOOLS_SIGN_MESSAGE) gfx->print("Scan message QR");
        else if (g_qrScanTarget == QrScanTarget::MULTISIG_POLICY) gfx->print("Scan policy QR (UR)");
        else gfx->print("Scan address QR");
      }
      drawGradientSilverButton(BTN_SCAN_BACK, "BACK", 1);
      ui_flush();
    }
    int count = 0;
    if (try_decode_frame_variant(raw, imgSize, outText, outLen, "tools-raw", &count)) {
      esp_camera_fb_return(fb);
      return true;
    }
    esp_camera_fb_return(fb);
    if (g_qr_decode_fail_streak < 0xFFFF) g_qr_decode_fail_streak++;
    return false;
  }

  // ========================================================================
  //  RESTORE / TFA path
  // ========================================================================

// 1 = copy vault encrypted frame to PSRAM then esp_camera_fb_return immediately — sensor captures next frame while Quirc runs (smoother preview; same pixels).
#ifndef SEEDMASK_RESTORE_QR_EARLY_FB_RETURN
#define SEEDMASK_RESTORE_QR_EARLY_FB_RETURN 1
#endif
#if SEEDMASK_RESTORE_QR_EARLY_FB_RETURN
  if (restoreEncQr && g_grayRaw && imgSize == (size_t)g_qr_w * (size_t)g_qr_h) {
    memcpy(g_grayRaw, raw, imgSize);
    esp_camera_fb_return(fb);
    fb = nullptr;
    raw = g_grayRaw;
  }
#endif

  // Vault: hunt paints before finder probe; engaged decode-first (below) runs Quirc before SPI when finder already latched.
  const uint32_t vaultPhase = s_vault_poll_phase++;
  bool vaultRunDecode = restoreEncQr && s_vault_seek_engaged;
  bool vaultSnapDecode = vaultRunDecode;

  // Encrypted vault: hunt = paint first for aiming; engaged (already saw finder) = decode-first, paint only if ECC fails.
  if (restoreEncQr && raw && imgSize > 0) {
    vaultDeferredRestoreUi = s_vault_seek_engaged;
    const bool preEngaged = s_vault_seek_engaged;
    const bool doVaultHud = true;
    if (doVaultHud && !vaultDeferredRestoreUi) {
      const int vaultPvStep =
        preEngaged ? (int)SEEDMASK_VAULT_ENGAGED_PREVIEW_STEP : (int)SEEDMASK_VAULT_HUNT_PREVIEW_STEP;
      const int lcdFullEvery = max(1, (int)SEEDMASK_VAULT_ENGAGED_LCD_FULL_EVERY_N);
      const bool vaultEngagedSkipLiveBlit =
        restoreEncQr && preEngaged && lcdFullEvery > 1 && ((vaultPhase % (uint32_t)lcdFullEvery) != 0u);
      if (!vaultEngagedSkipLiveBlit)
        vault_paint_restore_scan_ui(raw, vaultPvStep, preEngaged);
      else {
        const bool mpHud = (g_restoreChunkTotal > 0);
        gfx->fillRect(0, 40, LCD_W, mpHud ? 54 : 20, RGB565_BLACK);
        gfx->setTextColor(RGB565_WHITE);
        gfx->setTextSize(1);
        gfx->setCursor(10, 44);
        if (mpHud) {
          int nr = 0;
          for (int i = 0; i < g_restoreChunkTotal; i++) nr += g_restoreChunkGot[i];
          gfx->printf("%d of %d parts", nr, g_restoreChunkTotal);
          drawVaultMultipartPartIndicators(54);
        } else if (s_qr_last_count > 0) {
          gfx->print("QR seen - decoding...");
        } else {
          gfx->print("Scanning...");
        }
        drawGradientSilverButton(BTN_SCAN_BACK, "BACK", 1);
        ui_flush();
      }
    }
    /* Empty-air hunting: single tiered yield at end of branch (no duplicate yield here — was stuttering preview FPS). */

    // Empty field (no engagement yet): advance streak — multipart uses lower relax/mega thresholds for max-smooth idle live view.
    if (!preEngaged && s_vault_last_probe_nfind >= 0 && s_vault_last_probe_nfind == 0)
      s_vault_polls_since_empty_probe =
        (uint16_t)min((unsigned)s_vault_polls_since_empty_probe + 1u, 0xFFFEu);

    uint16_t thrRelax = (uint16_t)SEEDMASK_VAULT_HUNT_RELAX_AFTER_EMPTY_POLLS;
    uint16_t thrMega = (uint16_t)SEEDMASK_VAULT_HUNT_MEGA_RELAX_AFTER_EMPTY_POLLS;
    if (vaultMpNeedMore) {
      thrRelax = (uint16_t)min((unsigned)thrRelax, (unsigned)SEEDMASK_VAULT_HUNT_MP_RELAX_AFTER_EMPTY_POLLS);
      thrMega = (uint16_t)min((unsigned)thrMega, (unsigned)SEEDMASK_VAULT_HUNT_MP_MEGA_RELAX_AFTER_EMPTY_POLLS);
    }
    const bool relaxEmptyHunt =
      !preEngaged && (s_vault_polls_since_empty_probe >= thrRelax);
    const bool megaEmptyHunt =
      !preEngaged && (s_vault_polls_since_empty_probe >= thrMega);

    // Hunt AFTER flush: tiered finder cadence + no crop-zoom in mega tier (empty air max-smooth for every multipart part).
    if (!preEngaged && !vaultHandoffActive) {
      uint32_t per = (uint32_t)max(1, (int)SEEDMASK_VAULT_HUNT_PROBE_POLL_PERIOD);
      if (megaEmptyHunt)
        per = (uint32_t)max(1, (int)SEEDMASK_VAULT_HUNT_PROBE_POLL_PERIOD_MEGA);
      else if (relaxEmptyHunt)
        per = (uint32_t)max(1, (int)SEEDMASK_VAULT_HUNT_PROBE_POLL_PERIOD_RELAXED);
      if ((vaultPhase % per) == 0u) {
        bool deep = false;
        if (!megaEmptyHunt) {
          s_vault_idle_deep_ctr++;
          deep = (s_vault_idle_deep_ctr % (uint8_t)max(2, (int)SEEDMASK_VAULT_HUNT_DEEP_ZOOM_EVERY)) == 0;
        }
        const int nfind = vault_hunt_finder_probe(raw, imgSize, deep);
        if (nfind > 0) {
          s_vault_last_probe_nfind = (int8_t)min(nfind, 127);
          s_vault_polls_since_empty_probe = 0;
          s_qr_last_count = nfind;
          s_vault_seek_engaged = true;
          s_vault_lost_qr_streak = 0;
        } else {
          s_vault_last_probe_nfind = 0;
        }
      }
    }

    vaultRunDecode = restoreEncQr && s_vault_seek_engaged;
    vaultSnapDecode = vaultRunDecode;

    if (!preEngaged && s_vault_seek_engaged && s_qr_last_count > 0) {
      drawQRDetectOverlay(g_q, s_qr_last_count);
      ui_flush();
    }

    if (vaultRunDecode) {
      uint8_t vm = s_vault_engaged_luma_cache;
      if (vaultDecodeUniform || (vaultPhase & 1u) == 0u) {
        sample_luma_stats_sparse(raw, imgSize, &vm, nullptr, nullptr);
        s_vault_engaged_luma_cache = vm;
      }
      // rawFinderCount must stay 0 here: passing >0 sets forceDark and forces washout ISP every call (same bug as finder path),
      // which hammers the sensor before Quirc and makes phone decode look “stuck” while PC still works.
      // Very bright = always wash; moderate = every other poll unless multipart/uniform (full wash each poll).
      if (vm > (vaultSnapDecode ? 74 : 78)) {
        const uint8_t washCeil = vaultSnapDecode ? (uint8_t)88 : (uint8_t)92;
        if (vaultDecodeUniform || vm > washCeil || (vaultPhase & 1u) == 0u)
          psbt_engaged_isp_washout_clamp(raw, imgSize, 0);
      }
      const uint32_t ispN = vaultDecodeUniform
                              ? 1u
                              : (uint32_t)max(
                                1, vaultSnapDecode ? (int)SEEDMASK_VAULT_SNAP_ISP_EVERY_N : (int)SEEDMASK_VAULT_ISP_STABILIZE_EVERY_N);
      const bool runVaultIsp = ((vaultPhase % ispN) == 0u);
      if (runVaultIsp) {
        if (g_camSensorOv5640) {
          psbt_multipart_isp_stabilize(raw, imgSize, !s_vault_mp_isp_entry_done);
          s_vault_mp_isp_entry_done = true;
        } else {
          vault_qr_isp_stabilize(raw, imgSize);
        }
      }
    } else {
      s_qr_last_count = 0;
      const unsigned ispMod = (unsigned)SEEDMASK_VAULT_IDLE_AIR_ISP_EVERY;
      if ((++s_vault_preview_isp_touch % ispMod) == 0u) {
        uint8_t vm = 127;
        sample_luma_stats_sparse(raw, imgSize, &vm, nullptr, nullptr);
        const uint8_t washThr =
          megaEmptyHunt ? (uint8_t)94 : (relaxEmptyHunt ? (uint8_t)92 : (uint8_t)88);
        if (vm > washThr)
          psbt_engaged_isp_washout_clamp(raw, imgSize, 0);
      }
      /* Tier yields while hunting empty-air: fewer scheduler yields ⇒ higher preview FPS (multipart uses MP thresholds). */
      if (megaEmptyHunt) {
        if ((vaultPhase & 7u) == 0u)
          yield();
      } else if (relaxEmptyHunt) {
        if ((vaultPhase & 1u) == 0u)
          yield();
      } else {
        if ((vaultPhase & 1u) == 0u)
          yield();
      }
      return false;
    }
  }

  // ---------- PREVIEW: TFA / other restore paths (not encrypted vault — vault drew above every poll) ----------
  if (!restoreEncQr) {
    const uint8_t previewEvery = isTfaQrMode
                                   ? 2
                                   : ((s_dense_lock_frames > 0) ? 8 : ((s_qr_last_count > 0 || g_qr_decode_fail_streak > 10) ? 5 : 3));
    static uint8_t s_preview_skip = 0;
    if (++s_preview_skip >= previewEvery) {
      s_preview_skip = 0;
      drawCameraPreviewGray(raw);
      if (s_qr_last_count > 0) drawQRDetectOverlay(g_q, s_qr_last_count);
      gfx->fillRect(0, 40, LCD_W, 20, RGB565_BLACK);
      gfx->setTextColor(RGB565_WHITE);
      gfx->setTextSize(1);
      gfx->setCursor(10, 44);
      if (g_restoreChunkTotal > 0) {
        int nr = 0;
        for (int i = 0; i < g_restoreChunkTotal; i++) nr += g_restoreChunkGot[i];
        gfx->print("Loading part ");
        gfx->print(nr);
        gfx->print("/");
        gfx->print(g_restoreChunkTotal);
      } else if (s_qr_last_count > 0) {
        if (s_dense_lock_frames > 0)
          gfx->print("QR seen - dense lock-on decode...");
        else if (g_qr_decode_fail_streak >= 15)
          gfx->print("QR seen, decode retrying. Hold still/closer");
        else
          gfx->print("QR seen - decoding...");
      } else {
        s_qr_spinner = (s_qr_spinner + 1) % 4;
        gfx->print("Scanning");
        for (int d = 0; d < s_qr_spinner; d++) gfx->print(".");
        for (int d = s_qr_spinner; d < 3; d++) gfx->print(" ");
      }
      drawGradientSilverButton(BTN_SCAN_BACK, "BACK", 1);
      ui_flush();
    }
  }

  // Vault encrypted: decode path below (heavy work).
  const bool vaultSkipDecode = false;
  if (vaultSkipDecode) {
    if (fb) esp_camera_fb_return(fb);
    yield();
    return false;
  }

  if (restoreEncQr) s_qr_last_count = 0;

  const uint32_t vault_now_ms = millis();
  const uint8_t* vaultSrc = raw;

  // ---------- DECODE pass 1: live frame; latch last finder-good capture like PSBT (phone AE flickers finder). ----------
  int qcLive = 0;
  if (try_decode_frame_variant(raw, imgSize, outText, outLen, "raw", &qcLive)) {
    if (fb) esp_camera_fb_return(fb);
    return true;
  }
  // Bright phone OLED: optional darken on a decode-only copy (never mutate `raw` — keeps preview natural).
  // Uniform path (multipart / stuck): always run raw-d — alternating skips caused uneven part-to-part speed.
  if (restoreEncQr && g_gray) {
    const bool needRawDark =
      vaultDecodeUniform || (qcLive > 0) || (g_qr_decode_fail_streak >= 4) || ((vaultPhase & 1u) == 0u);
    if (needRawDark) {
      const uint32_t vaultRawDarkBudgetUs =
        (qcLive > 0) ? (uint32_t)SEEDMASK_VAULT_FRAME_BUDGET_ENGAGED_US
                     : (uint32_t)SEEDMASK_VAULT_FRAME_BUDGET_US;
      if ((uint32_t)(micros() - tPollStartUs) >= vaultRawDarkBudgetUs) {
        if (fb) esp_camera_fb_return(fb);
        yield();
        if (g_qr_decode_fail_streak < 0xFFFF) g_qr_decode_fail_streak++;
        if (!isTfaQrMode && g_qr_framesize == FRAMESIZE_VGA && qcLive > 0 && g_qr_decode_fail_streak >= 8)
          g_qr_need_high_res = true;
        if (vaultDeferredRestoreUi && g_grayRaw && raw == g_grayRaw)
          vault_paint_restore_scan_ui(raw, (int)SEEDMASK_VAULT_ENGAGED_PREVIEW_STEP, s_vault_seek_engaged);
        return false;
      }
      memcpy(g_gray, raw, imgSize);
      vault_soft_darken_if_washed_out(g_gray, imgSize);
      int qcD = 0;
      if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "raw-d", &qcD)) {
        if (fb) esp_camera_fb_return(fb);
        return true;
      }
      if (qcD > qcLive) qcLive = qcD;
    }
  }
  if (restoreEncQr && qcLive > 0) {
    if (g_vaultLatchImgBytes != imgSize) {
      if (g_vaultLatchRaw) {
        free(g_vaultLatchRaw);
        g_vaultLatchRaw = nullptr;
      }
      g_vaultLatchRaw = (uint8_t*)ps_malloc(imgSize);
      g_vaultLatchImgBytes = g_vaultLatchRaw ? imgSize : 0;
    }
    if (g_vaultLatchRaw) {
      memcpy(g_vaultLatchRaw, raw, imgSize);
      g_vaultLatchUntilMs = vault_now_ms + (uint32_t)SEEDMASK_VAULT_LATCH_HOLD_MS;
    }
  }
  int qcLatch = 0;
  if (restoreEncQr && qcLive == 0 && g_vaultLatchRaw && vault_now_ms < g_vaultLatchUntilMs && g_vaultLatchImgBytes == imgSize) {
    if (try_decode_frame_variant(g_vaultLatchRaw, imgSize, outText, outLen, "vault-latch", &qcLatch)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    vaultSrc = g_vaultLatchRaw;
  }
  const int vaultRawFinder = restoreEncQr ? max(qcLive, qcLatch) : 0;
  // When decoding latched pixels but finder count stuck at 0, still bias engaged paths:
  const int vaultFinderEff =
    restoreEncQr ? max(vaultRawFinder, (vaultSrc != raw && g_vaultLatchRaw) ? 1 : 0) : 0;
  int count = restoreEncQr ? max(qcLive, qcLatch) : qcLive;
  if (restoreEncQr && vaultFinderEff > count) count = vaultFinderEff;

  const uint32_t vaultPollBudgetUs =
    (restoreEncQr && (qcLive > 0 || qcLatch > 0 || vaultFinderEff > 0))
      ? (uint32_t)SEEDMASK_VAULT_FRAME_BUDGET_ENGAGED_US
      : (uint32_t)SEEDMASK_VAULT_FRAME_BUDGET_US;

  const auto vaultBudgetExit = [&]() -> bool {
    if (!restoreEncQr) return false;
    if ((uint32_t)(micros() - tPollStartUs) < vaultPollBudgetUs) return false;
    if (fb) {
      esp_camera_fb_return(fb);
      fb = nullptr;
    }
    yield();
    if (restoreEncQr) {
      s_vault_finder_peak_last_poll = s_qr_last_count;
      s_vault_extra_phase++;
      // Budget abort: do not increment lost-QR streak — we intentionally yield; next poll retries the same lock-on.
      if (s_vault_seek_engaged) {
        const int sawEff = max(max(qcLive, qcLatch), count);
        if (sawEff > 0 || s_dense_lock_frames > 0 || g_qr_decode_fail_streak < 10)
          s_vault_lost_qr_streak = 0;
      }
      yield();
      if (!vaultSnapDecode) {
        if ((vaultPhase & 7u) == 0u)
          yield();
      } else if ((vaultPhase & 31u) == 0u)
        yield();
    }
    if (g_qr_decode_fail_streak < 0xFFFF) g_qr_decode_fail_streak++;
    if (!isTfaQrMode && g_qr_framesize == FRAMESIZE_VGA) {
      if (restoreEncQr) {
        if (count > 0 && g_qr_decode_fail_streak >= 8)
          g_qr_need_high_res = true;
      } else if ((count > 0 && g_qr_decode_fail_streak >= 10) || (count == 0 && g_qr_decode_fail_streak >= 24)) {
        g_qr_need_high_res = true;
      }
    }
    if (restoreEncQr && vaultDeferredRestoreUi && g_grayRaw && raw == g_grayRaw) {
      vault_paint_restore_scan_ui(raw, (int)SEEDMASK_VAULT_ENGAGED_PREVIEW_STEP, s_vault_seek_engaged);
    }
    return true;
  };

  // Skip expensive full-frame stretch+Otsu on phone-like scenes (same rule for part 1 and every SPE1-M part — do not
  // treat multipart assembly as “always flat-Otsu”; that path duplicated work and stalled parts 2+ for tens of seconds).
  const bool vaultOmitFlatOtsu =
    restoreEncQr && s_vault_seek_engaged && !vaultDecodeUniform && (vaultFinderEff == 0 || g_qr_decode_fail_streak >= (uint16_t)SEEDMASK_VAULT_OMIT_FLAT_FINDER_FAIL_STREAK);

  // Engaged but raw finders = 0: zoom ring slices per poll (extra during SPE1-M assembly — each part is its own dense QR).
  if (restoreEncQr && g_gray && s_vault_seek_engaged && vaultFinderEff == 0) {
    if (vaultBudgetExit()) return false;
    const int nfrac = (int)(sizeof(kVaultZoomFrac) / sizeof(kVaultZoomFrac[0]));
    const int span = max(1, (int)SEEDMASK_VAULT_NOFINDER_ZOOM_SPAN);
    const int zloops =
      vaultSnapDecode ? (vaultDecodeUniform ? 2 : 1) : 2;
    for (int zpass = 0; zpass < zloops; zpass++) {
      int zb = 0, ze = nfrac;
      vault_zoom_ring_slice(nfrac, span, &s_vault_nofinder_zoom_phase, false, &zb, &ze);
      if (vault_try_zoom_decode(vaultSrc, imgSize, outText, outLen, &count, fb, zb, ze, tPollStartUs,
                                vaultPollBudgetUs))
        return true;
    }
  }

  const bool hardDecodeMode =
    (vaultFinderEff > 0) || (count > 0) || (s_dense_lock_frames > 0) || (g_qr_decode_fail_streak > 8) || (restoreEncQr && g_qr_decode_fail_streak > 3);
  const bool isSvga = (g_qr_framesize == FRAMESIZE_SVGA);

  // Full-frame vault-dense + Otsu — before crop-zoom when finders are visible: usually fewer memcpy+Quirc ops than zoom ring.
  if (restoreEncQr && g_gray && !vaultOmitFlatOtsu) {
    if (vaultBudgetExit()) return false;
    memcpy(g_gray, vaultSrc, imgSize);
    contrast_stretch_vault_dense_qr(g_gray, imgSize);
    otsu_binarize(g_gray, imgSize, -6);
    if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "otsu-flat", &count)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
    if (vaultBudgetExit()) return false;
    // When finders are visible, never skip flat-p on alternating polls — that delayed ECC by a full frame for no gain.
    const bool skipFlatP =
      vaultFinderEff > 0 ? false
                         : (!vaultDecodeUniform && vaultSnapDecode && g_qr_decode_fail_streak < 6 && (vaultPhase & 1u));
    if (!skipFlatP) {
      memcpy(g_gray, vaultSrc, imgSize);
      contrast_stretch_psbt_qr(g_gray, imgSize);
      otsu_binarize(g_gray, imgSize, -6);
      if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, "otsu-flat-p", &count)) {
        if (fb) esp_camera_fb_return(fb);
        return true;
      }
    }
    if (vaultBudgetExit()) return false;
    if (vaultDecodeUniform || (g_qr_decode_fail_streak >= 12) || ((vaultPhase & 1u) == 0u)) {
      if (vault_try_inverted_otsu(vaultSrc, imgSize, outText, outLen, fb))
        return true;
    }
  }

  // Finders visible: crop-zoom ring after full-frame passes — ECC still stuck on raw grayscale or flat binarization.
  if (restoreEncQr && vaultFinderEff > 0) {
    const int denseCap =
      vaultSnapDecode ? (int)SEEDMASK_VAULT_SNAP_DENSE_LOCK_CAP : (int)SEEDMASK_VAULT_ENGAGED_DENSE_LOCK_FRAMES;
    s_dense_lock_frames = (uint8_t)min(255, denseCap);
    // Washout already applied before decode when scene is bright; do not pass finder count>0 (forces forceDark + ISP rewrite every poll).
    if (g_gray) {
      if (vaultBudgetExit()) return false;
      const int nfrac = (int)(sizeof(kVaultZoomFrac) / sizeof(kVaultZoomFrac[0]));
      const int span = max(1, (int)SEEDMASK_VAULT_NOFINDER_ZOOM_SPAN);
      const int zoomPasses =
        (vaultDecodeUniform || g_qr_decode_fail_streak >= 5) ? 2 : 1;
      for (int zpass = 0; zpass < zoomPasses; zpass++) {
        int zb = 0, ze = nfrac;
        vault_zoom_ring_slice(nfrac, span, &s_vault_finder_zoom_phase, true, &zb, &ze);
        if (vault_try_zoom_decode(vaultSrc, imgSize, outText, outLen, &count, fb, zb, ze, tPollStartUs,
                                  vaultPollBudgetUs))
          return true;
      }
    }
  }

  // If detector sees QR but decode keeps failing, enter temporary aggressive lock-on (non-vault: wait for fail streak).
  if (!isTfaQrMode && !restoreEncQr && count > 0 && s_dense_lock_frames == 0) {
    if (g_qr_decode_fail_streak >= 8)
      s_dense_lock_frames = 18;
  }

  // ---------- DECODE passes 2..4: adaptive preprocessing variants ----------
  uint8_t variantsThisFrame = 0;
  if (isTfaQrMode) {
    static uint8_t s_tfaHeavySkip = 0;
    variantsThisFrame = ((count > 0) || (g_qr_decode_fail_streak > 6))
                          ? (((++s_tfaHeavySkip & 1) == 0) ? 1 : 0)
                          : 0;
  } else if (restoreEncQr) {
    int vp = max(1, (int)SEEDMASK_VAULT_ENGAGED_VARIANT_PASSES);
    if (vaultFinderEff == 0 && !vaultDecodeUniform)
      vp = min(vp, max(1, (int)SEEDMASK_VAULT_VARIANTS_WHEN_NO_FINDER));
    if (vaultSnapDecode)
      vp = min(vp, max(1, (int)SEEDMASK_VAULT_SNAP_VARIANT_CAP));
    variantsThisFrame =
      (uint8_t)min(vaultSnapDecode ? (int)SEEDMASK_VAULT_SNAP_VARIANT_CAP : 7, vp);
    if (s_dense_lock_frames > 0)
      s_dense_lock_frames--;
  } else if (s_dense_lock_frames > 0) {
    variantsThisFrame = 4;
    s_dense_lock_frames--;
  } else if (!hardDecodeMode) {
    if ((++s_qr_poll_heavy_skip & 1) == 0) variantsThisFrame = 1;
  } else if (!isSvga) {
    variantsThisFrame = 3;
  } else {
    variantsThisFrame = ((++s_qr_poll_heavy_skip % 3) == 0) ? 1 : 0;
    if (count > 0 && g_qr_decode_fail_streak > 30 && (s_qr_poll_heavy_skip % 9) == 0) variantsThisFrame = 2;
  }

  for (uint8_t pass = 0; pass < variantsThisFrame; pass++) {
    if (restoreEncQr && vaultBudgetExit()) return false;
    if (restoreEncQr && pass > 0)
      yield();
    int bias = 0;
    const char* tag = "otsu";
    bool useMean = false;
    if (s_qr_poll_decode_variant_phase == 1) {
      bias = -14;
      tag = "otsu-dark";
    } else if (s_qr_poll_decode_variant_phase == 2) {
      bias = +14;
      tag = "otsu-light";
    } else if (s_qr_poll_decode_variant_phase == 3) {
      bias = -8;
      tag = "mean-dark";
      useMean = true;
    } else if (s_qr_poll_decode_variant_phase == 4) {
      bias = +18;
      tag = "otsu-light2";
    }
    s_qr_poll_decode_variant_phase =
      (uint8_t)((s_qr_poll_decode_variant_phase + 1) % 5);
    memcpy(g_gray, restoreEncQr ? vaultSrc : raw, imgSize);
    if (restoreEncQr) contrast_stretch_vault_dense_qr(g_gray, imgSize);
    else contrast_stretch(g_gray, imgSize);
    if (useMean) mean_binarize(g_gray, imgSize, bias);
    else otsu_binarize(g_gray, imgSize, bias);
    if (try_decode_frame_variant(g_gray, imgSize, outText, outLen, tag, restoreEncQr ? &count : nullptr)) {
      if (fb) esp_camera_fb_return(fb);
      return true;
    }
  }

  if (fb) esp_camera_fb_return(fb);
  if (restoreEncQr) {
    s_vault_finder_peak_last_poll = s_qr_last_count;
    s_vault_extra_phase++;
    if (s_vault_seek_engaged) {
      // Include `count` — zoom / variant passes may see finders when raw frame briefly reports 0 (blur/AE).
      const int sawEff = max(max(qcLive, qcLatch), count);
      if (sawEff > 0 || s_dense_lock_frames > 0 || g_qr_decode_fail_streak < 10)
        s_vault_lost_qr_streak = 0;
      else if (++s_vault_lost_qr_streak >= SEEDMASK_VAULT_LOST_QR_DISENGAGE) {
        s_vault_seek_engaged = false;
        s_vault_lost_qr_streak = 0;
        s_qr_last_count = 0;
        s_vault_last_probe_nfind = -1;
        s_vault_polls_since_empty_probe = 0;
      }
    }
    /* Always yield once per vault poll — long Quirc pipelines must not starve lwIP, touch, or TWDT on ESP32. */
    yield();
    if (!vaultSnapDecode) {
      if ((vaultPhase & 7u) == 0u)
        yield();
    } else if ((vaultPhase & 31u) == 0u)
      yield();
  }
  if (g_qr_decode_fail_streak < 0xFFFF) g_qr_decode_fail_streak++;
  // Generic RESTORE (non-vault): SVGA when stalled. Vault encrypted: upgrade when finder sees QR but ECC decode stalls (dense SPE1).
  if (!isTfaQrMode && g_qr_framesize == FRAMESIZE_VGA) {
    if (restoreEncQr) {
      if (count > 0 && g_qr_decode_fail_streak >= 8)
        g_qr_need_high_res = true;
    } else if ((count > 0 && g_qr_decode_fail_streak >= 10) || (count == 0 && g_qr_decode_fail_streak >= 24)) {
      g_qr_need_high_res = true;
    }
  }
  // Only paint from PSRAM copy — after esp_camera_fb_return, DMA `fb` buffer must not be read.
  if (restoreEncQr && vaultDeferredRestoreUi && g_grayRaw && raw == g_grayRaw) {
    vault_paint_restore_scan_ui(raw, (int)SEEDMASK_VAULT_ENGAGED_PREVIEW_STEP, s_vault_seek_engaged);
  }
  return false;
}

static void prepareQrScanDefaults() {
  // Encrypted vault QR restore: SVGA by default (dense SPE1 / multipart). SeedQR / TFA / tools: VGA.
  // Requires g_qrScanTarget (and g_restoreSeedQrOnlyScan for RESTORE) set before this runs — see handlers before start_qr_scan().
  if (g_qrScanTarget == QrScanTarget::RESTORE && !g_restoreSeedQrOnlyScan) {
    g_qr_w = 800;
    g_qr_h = 600;
    g_qr_framesize = FRAMESIZE_SVGA;
  } else if (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT) {
    g_qr_w = 640;
    g_qr_h = 480;
    g_qr_framesize = FRAMESIZE_VGA;
  } else if (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT) {
#if SEEDMASK_PSBT_START_SVGA
    g_qr_w = 800;
    g_qr_h = 600;
    g_qr_framesize = FRAMESIZE_SVGA;
#else
    g_qr_w = 640;
    g_qr_h = 480;
    g_qr_framesize = FRAMESIZE_VGA;
#endif
  } else {
    g_qr_w = 640;
    g_qr_h = 480;
    g_qr_framesize = FRAMESIZE_VGA;
  }
  g_qr_need_high_res = false;
  g_qr_decode_fail_streak = 0;
  if (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT || g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT)
    crypto_tx_scan_poll_reset();
  if (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT)
    kaspa_ur_scan_session_reset();
  s_qr_last_count = 0;
  s_dense_lock_frames = 0;
  s_vault_finder_peak_last_poll = 0;
  s_vault_extra_phase = 0;
  s_vault_mp_isp_entry_done = false;
  s_vault_seek_engaged = false;
  s_vault_poll_phase = 0;
  s_vault_engaged_luma_cache = 127;
  s_vault_lost_qr_streak = 0;
  s_vault_hunt_preview_skip = 0;
  s_vault_nofinder_zoom_phase = 0;
  s_vault_finder_zoom_phase = 0;
  s_vault_preview_isp_touch = 0;
  s_qr_poll_decode_variant_phase = 0;
  s_qr_poll_heavy_skip = 0;
  s_vault_polls_since_empty_probe = 0;
  s_vault_last_probe_nfind = -1;
  if (g_vaultLatchRaw) {
    free(g_vaultLatchRaw);
    g_vaultLatchRaw = nullptr;
  }
  g_vaultLatchImgBytes = 0;
  g_vaultLatchUntilMs = 0;
  s_vault_mp_handoff_until_ms = 0;
  /* Prime deep-zoom phase so the first hunt probe after opening the scanner can run a crop pass soon. */
  s_vault_idle_deep_ctr =
    (uint8_t)(max(2, (int)SEEDMASK_VAULT_HUNT_DEEP_ZOOM_EVERY) - 1);
}

static void handleRestoreMpChunkOkTap(uint16_t x, uint16_t y) {
  if (hit(BTN_RESTORE_MP_NEXT, x, y)) {
    g_qrScanTarget = QrScanTarget::RESTORE;
    g_restoreSeedQrOnlyScan = false;
    prepareQrScanDefaults();
    if (!start_qr_scan()) {
      setMsg("Camera init failed");
      draw();
      return;
    }
    g_qrScanning = true;
    setMsg("");
    show(UIScreen::RESTORE_SCAN_QR);
    waitTouchRelease(120);
    return;
  }
  if (hit(BTN_SCAN_BACK, x, y)) {
    restore_vault_multipart_cancel_progress();
    setMsg("");
    show(UIScreen::RESTORE_CODE);
    waitTouchRelease(120);
  }
}

static bool pw_encrypt_blob(const char* masterPw,
                            const uint8_t* plain, size_t plainLen,
                            std::vector<uint8_t>& outBlob) {
  if (!masterPw || strlen(masterPw) < 4) return false;

  uint8_t salt[4];
  esp_fill_random(salt, sizeof(salt));

  uint8_t key[32];
  if (!pbkdf2_sha256((const uint8_t*)masterPw, strlen(masterPw),
                     salt, sizeof(salt), PBKDF2_ITERATIONS, key, sizeof(key))) return false;

  outBlob.clear();
  outBlob.reserve(4 + 1 + 1 + 4 + 2 + plainLen + 2);

  // Header: "SPPW" ver=1 flags=0 salt[4] len(u16)
  outBlob.insert(outBlob.end(), { 'S', 'P', 'P', 'W' });
  outBlob.push_back(1);  // version
  outBlob.push_back(0);  // flags
  outBlob.insert(outBlob.end(), salt, salt + 4);

  uint16_t L = (uint16_t)plainLen;
  outBlob.push_back((L >> 8) & 0xFF);
  outBlob.push_back((L >> 0) & 0xFF);

  // ciphertext
  size_t ctOff = outBlob.size();
  outBlob.insert(outBlob.end(), plain, plain + plainLen);
  xor_keystream(key, outBlob.data() + ctOff, plainLen);

  // CRC over everything so far
  uint16_t crc = crc16_ccitt(outBlob.data(), outBlob.size());
  outBlob.push_back((crc >> 8) & 0xFF);
  outBlob.push_back((crc >> 0) & 0xFF);

  return true;
}

