    bool rowSel = (g_sdSavePathPickStep == 1 && ri == g_sdSavePickVaultRowSel);
    gfx->fillRoundRect(row.x, row.y, row.w, row.h, 6, rowSel ? UI_ACCENT : UI_CARD);
    gfx->drawRoundRect(row.x, row.y, row.w, row.h, 6, rowSel ? RGB565_WHITE : UI_BORDER);
    char line[96];
