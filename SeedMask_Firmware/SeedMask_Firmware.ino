static int spRoundDiv32(int32_t num, int32_t den) {
  if (den <= 0) return 0;
  if (num >= 0) return (int)((num + den / 2) / den);
  return (int)((num - den / 2) / den);
}

static void draw2FAAppIcon(int x, int y, int s, uint16_t bg) {
  const bool darkTile = (bg == RGB565_BLACK || bg == mainMenuDarkCardTile565());
  if (s < 24) return;
  x -= 1;
  y += 6;
  // Shield path (SVG, Y-flipped): centroid-scaled fills; no drawLine on rims.
  const uint16_t shieldMain = blendRGB565(blendRGB565(RGB565_BLUE, RGB565_CYAN, 0.48f), RGB565_WHITE, 0.14f);
  const uint16_t shieldLight = blendRGB565(blendRGB565(RGB565_CYAN, RGB565_WHITE, 0.62f), RGB565_BLUE, 0.10f);
  const uint16_t shieldEdge = blendRGB565(blendRGB565(RGB565_BLUE, RGB565_DARKGREY, 0.44f), UI_BORDER, 0.20f);
  const uint16_t rimCatch = blendRGB565(blendRGB565(RGB565_WHITE, shieldLight, 0.28f), RGB565_CYAN, 0.08f);
  const uint16_t rimMid = blendRGB565(blendRGB565(shieldMain, shieldEdge, 0.42f), shieldLight, 0.20f);
  const uint16_t rimGroove = blendRGB565(blendRGB565(shieldEdge, shieldMain, 0.52f), RGB565_DARKGREY, 0.08f);
  const uint16_t faceBand = blendRGB565(blendRGB565(shieldMain, RGB565_WHITE, 0.38f), shieldLight, 0.18f);
  const uint16_t innerPearl = blendRGB565(blendRGB565(shieldLight, RGB565_WHITE, 0.45f), shieldMain, 0.08f);
  const uint16_t innerShadow = blendRGB565(blendRGB565(shieldMain, shieldEdge, 0.52f), RGB565_DARKGREY, 0.12f);
  const uint16_t bowlCore = blendRGB565(blendRGB565(shieldMain, shieldEdge, 0.35f), RGB565_BLUE, 0.15f);
  // Face fill: L/R blues + top-left key from (nx,ny).
  const uint16_t faceLightBlue = blendRGB565(blendRGB565(RGB565_CYAN, RGB565_WHITE, 0.42f), RGB565_BLUE, 0.12f);
  const uint16_t faceDarkBlue = blendRGB565(blendRGB565(RGB565_BLUE, shieldEdge, 0.62f), RGB565_DARKGREY, 0.22f);
  const uint16_t faceKeyDeep = blendRGB565(blendRGB565(RGB565_BLUE, shieldEdge, 0.58f), RGB565_DARKGREY, 0.12f);
  const uint16_t faceRimLit = blendRGB565(blendRGB565(shieldMain, shieldLight, 0.40f), RGB565_WHITE, 0.14f);
  const uint16_t bowlLightBlue = blendRGB565(blendRGB565(bowlCore, RGB565_CYAN, 0.35f), RGB565_WHITE, 0.08f);
  const uint16_t bowlDarkBlue = blendRGB565(blendRGB565(bowlCore, RGB565_BLUE, 0.58f), shieldEdge, 0.48f);
  const uint16_t bowlKeyDeep = blendRGB565(blendRGB565(bowlCore, shieldEdge, 0.55f), RGB565_BLUE, 0.12f);
  // Inset bevels on dexter/sinister arcs only.
  const uint16_t dexBevelHi = blendRGB565(blendRGB565(faceLightBlue, RGB565_WHITE, 0.50f), shieldLight, 0.12f);
  const uint16_t dexBevelMid = blendRGB565(blendRGB565(faceLightBlue, shieldLight, 0.38f), RGB565_WHITE, 0.08f);
  const uint16_t sinBevelSh = blendRGB565(blendRGB565(faceDarkBlue, shieldEdge, 0.42f), RGB565_DARKGREY, 0.10f);
  const uint16_t bowlDexHi = blendRGB565(blendRGB565(bowlLightBlue, RGB565_WHITE, 0.36f), shieldLight, 0.10f);
  const uint16_t bowlSinSh = blendRGB565(blendRGB565(bowlDarkBlue, shieldEdge, 0.48f), RGB565_DARKGREY, 0.08f);
  // Dexter spec (curved strip).
  const uint16_t dexSpecHalo = blendRGB565(blendRGB565(shieldLight, RGB565_WHITE, 0.52f), RGB565_CYAN, 0.14f);
  const uint16_t dexSpecGlow = blendRGB565(blendRGB565(RGB565_WHITE, shieldLight, 0.44f), RGB565_CYAN, 0.12f);
  const uint16_t dexSpecCore = blendRGB565(RGB565_WHITE, blendRGB565(shieldLight, RGB565_CYAN, 0.20f), 0.26f);
  const uint16_t strokeHi = blendRGB565(RGB565_WHITE, shieldLight, 0.10f);
  // White rim: feathered bands (RGB565).
  const uint16_t strokeHiR1 = blendRGB565(strokeHi, rimCatch, 0.11f);
  const uint16_t strokeHiR2 = blendRGB565(strokeHi, rimCatch, 0.24f);
  const uint16_t strokeHiR3 = blendRGB565(strokeHi, rimCatch, 0.40f);
  const uint16_t rimOutlineBlue =
    blendRGB565(blendRGB565(blendRGB565(RGB565_BLUE, RGB565_BLACK, 0.44f), shieldEdge, 0.52f), RGB565_DARKGREY, 0.20f);
  const uint16_t rimOutlineBlueOuter = blendRGB565(rimOutlineBlue, rimMid, 0.18f);
  const uint16_t rimOutlineBlueR1L = blendRGB565(rimOutlineBlue, faceLightBlue, 0.30f);
  const uint16_t rimOutlineBlueR1R = blendRGB565(rimOutlineBlue, faceDarkBlue, 0.30f);
  const uint16_t rimOutlineBlueR2L = blendRGB565(rimOutlineBlue, faceLightBlue, 0.46f);
  const uint16_t rimOutlineBlueR2R = blendRGB565(rimOutlineBlue, faceDarkBlue, 0.46f);
  const uint16_t rimOutlineBlueR3L = blendRGB565(rimOutlineBlue, faceLightBlue, 0.62f);
  const uint16_t rimOutlineBlueR3R = blendRGB565(rimOutlineBlue, faceDarkBlue, 0.62f);
  const uint16_t rimOutlineBlueR4L = blendRGB565(rimOutlineBlue, faceLightBlue, 0.78f);
  const uint16_t rimOutlineBlueR4R = blendRGB565(rimOutlineBlue, faceDarkBlue, 0.78f);
  const uint16_t strokeLo = blendRGB565(blendRGB565(shieldMain, shieldEdge, 0.48f), rimGroove, 0.22f);

  const int pad = 0;
  const int labH = 22;
  const int shH = s - labH - pad * 2;
  if (shH < 28) return;
  const int shY = y + pad;
  const int cx = x + s / 2;
  const int by = shY + shH - 3;
  const int fh = max(26, shH - 6);
  const int ty = by - fh;
  const int32_t halfW = ((int32_t)fh * 111824L) / 245760L;

  int ox[256], oy[256], oxOut[256], oyOut[256], oxRl[256], oyRl[256], oxMid[256], oyMid[256], oxGrv[256], oyGrv[256], bx[256], bpy[256], bxCore[256], bpyCore[256];
  int nx1[128], ny1[128];
  int nxPath[256], nyPath[256];
  for (int i = 0; i < k2FAShieldN; i++) {
    const int j = (i + 1) % k2FAShieldN;
    nx1[2 * i] = k2FAShieldNx[i];
    ny1[2 * i] = k2FAShieldNy[i];
    nx1[2 * i + 1] = (k2FAShieldNx[i] + k2FAShieldNx[j]) / 2;
    ny1[2 * i + 1] = (k2FAShieldNy[i] + k2FAShieldNy[j]) / 2;
  }
  for (int i = 0; i < k2FAShieldDenseN; i++) {
    const int j = (i + 1) % k2FAShieldDenseN;
    nxPath[2 * i] = nx1[i];
    nyPath[2 * i] = ny1[i];
    nxPath[2 * i + 1] = (nx1[i] + nx1[j]) / 2;
    nyPath[2 * i + 1] = (ny1[i] + ny1[j]) / 2;
  }
  for (int i = 0; i < k2FAShieldSmoothN; i++) {
    ox[i] = cx + spRoundDiv32((int32_t)nxPath[i] * halfW, 1000);
    oy[i] = ty + spRoundDiv32((int32_t)(1000 - nyPath[i]) * fh, 1000);
  }

  int ax = 0, ay = 0;
  for (int i = 0; i < k2FAShieldSmoothN; i++) {
    ax += ox[i];
    ay += oy[i];
  }
  ax /= k2FAShieldSmoothN;
  ay /= k2FAShieldSmoothN;

  const int kOut = 1028;
  const int kRl = 1021;
  const int kMid = 1015;
  const int kGrv = 1009;
  const int kFace = 1004;
  const int kCore = 975;
  const int outDen = 1000;
  for (int i = 0; i < k2FAShieldSmoothN; i++) {
    oxOut[i] = ax + spRoundDiv32((int32_t)(ox[i] - ax) * kOut, outDen);
    oyOut[i] = ay + spRoundDiv32((int32_t)(oy[i] - ay) * kOut, outDen);
    oxRl[i] = ax + spRoundDiv32((int32_t)(ox[i] - ax) * kRl, outDen);
    oyRl[i] = ay + spRoundDiv32((int32_t)(oy[i] - ay) * kRl, outDen);
    oxMid[i] = ax + spRoundDiv32((int32_t)(ox[i] - ax) * kMid, outDen);
    oyMid[i] = ay + spRoundDiv32((int32_t)(oy[i] - ay) * kMid, outDen);
    oxGrv[i] = ax + spRoundDiv32((int32_t)(ox[i] - ax) * kGrv, outDen);
    oyGrv[i] = ay + spRoundDiv32((int32_t)(oy[i] - ay) * kGrv, outDen);
    bx[i] = ax + spRoundDiv32((int32_t)(ox[i] - ax) * kFace, outDen);
    bpy[i] = ay + spRoundDiv32((int32_t)(oy[i] - ay) * kFace, outDen);
    bxCore[i] = ax + spRoundDiv32((int32_t)(ox[i] - ax) * kCore, outDen);
    bpyCore[i] = ay + spRoundDiv32((int32_t)(oy[i] - ay) * kCore, outDen);
  }

  for (int i = 1; i <= k2FAShieldSmoothN - 2; i++) {
    gfx->fillTriangle(oxOut[0], oyOut[0], oxOut[i], oyOut[i], oxOut[i + 1], oyOut[i + 1], shieldEdge);
  }
  for (int i = 1; i <= k2FAShieldSmoothN - 2; i++) {
    gfx->fillTriangle(oxRl[0], oyRl[0], oxRl[i], oyRl[i], oxRl[i + 1], oyRl[i + 1], rimCatch);
  }
  for (int i = 1; i <= k2FAShieldSmoothN - 2; i++) {
    gfx->fillTriangle(oxMid[0], oyMid[0], oxMid[i], oyMid[i], oxMid[i + 1], oyMid[i + 1], rimMid);
  }
  for (int i = 1; i <= k2FAShieldSmoothN - 2; i++) {
    gfx->fillTriangle(oxGrv[0], oyGrv[0], oxGrv[i], oyGrv[i], oxGrv[i + 1], oyGrv[i + 1], rimGroove);
  }

  int minYf = bpy[0], maxYf = bpy[0];
  for (int i = 1; i < k2FAShieldSmoothN; i++) {
    if (bpy[i] < minYf) minYf = bpy[i];
    if (bpy[i] > maxYf) maxYf = bpy[i];
  }
  const int yRf = max(1, maxYf - minYf);
  for (int i = 1; i <= k2FAShieldSmoothN - 2; i++) {
    const int cya = (bpy[0] + bpy[i] + bpy[i + 1]) / 3;
    const int cxa = (bx[0] + bx[i] + bx[i + 1]) / 3;
    float nx = (float)(cxa - ax) / (float)max(1, (int)halfW);
    float ny = (float)(cya - ay) / (float)max(1, fh / 2);
    if (nx < -1.0f) nx = -1.0f;
    if (nx > 1.0f) nx = 1.0f;
    if (ny < -1.0f) ny = -1.0f;
    if (ny > 1.0f) ny = 1.0f;
    const float uLR = (nx + 1.0f) * 0.5f;
    uint16_t base = blendRGB565(faceLightBlue, faceDarkBlue, uLR);
    const float termY = (1.0f - ny) * 0.5f;
    const float termX = (1.0f - nx) * 0.5f;
    float lum = 0.20f + 0.41f * termY + 0.33f * termX;
    if (ny > 0.0f) lum -= 0.12f * ny;
    if (lum < 0.08f) lum = 0.08f;
    if (lum > 1.0f) lum = 1.0f;
    uint16_t fc = blendRGB565(faceKeyDeep, base, lum);
    const float vy = (float)(cya - minYf) / (float)yRf;
    float rimLin = 1.0f - vy / 0.26f;
    if (rimLin < 0.0f) rimLin = 0.0f;
    else if (rimLin > 1.0f) rimLin = 1.0f;
    const float rimT = rimLin * rimLin * (3.0f - 2.0f * rimLin);
    float uEdge = (uLR - 0.34f) / 0.22f;
    if (uEdge < 0.0f) uEdge = 0.0f;
    else if (uEdge > 1.0f) uEdge = 1.0f;
    uEdge = uEdge * uEdge * (3.0f - 2.0f * uEdge);
    fc = blendRGB565(fc, faceRimLit, rimT * (1.0f - uEdge) * 0.24f);
    gfx->fillTriangle(bx[0], bpy[0], bx[i], bpy[i], bx[i + 1], bpy[i + 1], fc);
  }

  auto drawInsetBand = [&](const int* px, const int* py, int numOut, int numIn, int den, uint16_t col) {
    int oxx[256], oyy[256], ixx[256], iyy[256];
    for (int ii = 0; ii < k2FAShieldSmoothN; ii++) {
      oxx[ii] = ax + spRoundDiv32((int32_t)(px[ii] - ax) * numOut, den);
      oyy[ii] = ay + spRoundDiv32((int32_t)(py[ii] - ay) * numOut, den);
      ixx[ii] = ax + spRoundDiv32((int32_t)(px[ii] - ax) * numIn, den);
      iyy[ii] = ay + spRoundDiv32((int32_t)(py[ii] - ay) * numIn, den);
    }
    for (int ii = 0; ii < k2FAShieldSmoothN; ii++) {
      int jj = (ii + 1) % k2FAShieldSmoothN;
      gfx->fillTriangle(oxx[ii], oyy[ii], oxx[jj], oyy[jj], ixx[jj], iyy[jj], col);
      gfx->fillTriangle(oxx[ii], oyy[ii], ixx[jj], iyy[jj], ixx[ii], iyy[ii], col);
    }
  };
  auto drawPartialInsetAlongPath = [&](const int* px, const int* py, int numOut, int numIn, int den, uint16_t col, int side) {
    for (int ii = 0; ii < k2FAShieldSmoothN; ii++) {
      const int jj = (ii + 1) % k2FAShieldSmoothN;
      const int mx = (px[ii] + px[jj]) / 2;
      if (side < 0) {
        if (mx >= ax) continue;
      } else {
        if (mx <= ax) continue;
      }
      const int oxi = ax + spRoundDiv32((int32_t)(px[ii] - ax) * numOut, den);
      const int oyi = ay + spRoundDiv32((int32_t)(py[ii] - ay) * numOut, den);
      const int oxj = ax + spRoundDiv32((int32_t)(px[jj] - ax) * numOut, den);
      const int oyj = ay + spRoundDiv32((int32_t)(py[jj] - ay) * numOut, den);
      const int ixi = ax + spRoundDiv32((int32_t)(px[ii] - ax) * numIn, den);
      const int iyi = ay + spRoundDiv32((int32_t)(py[ii] - ay) * numIn, den);
      const int ixj = ax + spRoundDiv32((int32_t)(px[jj] - ax) * numIn, den);
      const int iyj = ay + spRoundDiv32((int32_t)(py[jj] - ay) * numIn, den);
      gfx->fillTriangle(oxi, oyi, oxj, oyj, ixj, iyj, col);
      gfx->fillTriangle(oxi, oyi, ixj, iyj, ixi, iyi, col);
    }
  };
  drawPartialInsetAlongPath(ox, oy, 1004, 1000, 1000, dexBevelHi, -1);
  drawPartialInsetAlongPath(ox, oy, 1000, 995, 1000, dexBevelMid, -1);
  drawPartialInsetAlongPath(ox, oy, 1004, 1000, 1000, sinBevelSh, +1);
  drawInsetBand(ox, oy, 1002, 993, 1000, faceBand);
  drawInsetBand(ox, oy, 988, 979, 1000, innerPearl);
  drawInsetBand(ox, oy, 978, 968, 1000, innerShadow);
  for (int i = 1; i <= k2FAShieldSmoothN - 2; i++) {
    const int cya = (bpyCore[0] + bpyCore[i] + bpyCore[i + 1]) / 3;
    const int cxa = (bxCore[0] + bxCore[i] + bxCore[i + 1]) / 3;
    float nx = (float)(cxa - ax) / (float)max(1, (int)halfW);
    float ny = (float)(cya - ay) / (float)max(1, fh / 2);
    if (nx < -1.0f) nx = -1.0f;
    if (nx > 1.0f) nx = 1.0f;
    if (ny < -1.0f) ny = -1.0f;
    if (ny > 1.0f) ny = 1.0f;
    const float uLR = (nx + 1.0f) * 0.5f;
    uint16_t litB = blendRGB565(bowlLightBlue, bowlDarkBlue, uLR);
    const float termY = (1.0f - ny) * 0.5f;
    const float termX = (1.0f - nx) * 0.5f;
    float lum = 0.16f + 0.38f * termY + 0.31f * termX;
    if (ny > 0.0f) lum -= 0.14f * ny;
    if (lum < 0.07f) lum = 0.07f;
    if (lum > 1.0f) lum = 1.0f;
    lum *= 0.90f;
    uint16_t bc = blendRGB565(bowlKeyDeep, litB, lum);
    gfx->fillTriangle(bxCore[0], bpyCore[0], bxCore[i], bpyCore[i], bxCore[i + 1], bpyCore[i + 1], bc);
  }
  drawPartialInsetAlongPath(ox, oy, 975, 970, 1000, bowlDexHi, -1);
  drawPartialInsetAlongPath(ox, oy, 975, 970, 1000, bowlSinSh, +1);
  drawPartialInsetAlongPath(ox, oy, 1001, 997, 1000, dexSpecHalo, -1);
  drawPartialInsetAlongPath(ox, oy, 999, 996, 1000, dexSpecGlow, -1);
  drawPartialInsetAlongPath(ox, oy, 997, 995, 1000, dexSpecCore, -1);
  drawInsetBand(ox, oy, 1028, 1025, 1000, strokeHi);
  drawInsetBand(ox, oy, 1025, 1021, 1000, strokeHiR1);
  drawInsetBand(ox, oy, 1021, 1017, 1000, strokeHiR2);
  drawInsetBand(ox, oy, 1017, 1013, 1000, strokeHiR3);
  drawInsetBand(ox, oy, 966, 958, 1000, strokeLo);
  auto outlineInsetLR = [&](int numOut, int numIn, uint16_t colL, uint16_t colR) {
    drawPartialInsetAlongPath(ox, oy, numOut, numIn, 1000, colL, -1);
    drawPartialInsetAlongPath(ox, oy, numOut, numIn, 1000, colR, +1);
  };
  // Face outline: last pass (z on top).
  drawInsetBand(ox, oy, 1007, 995, 1000, rimOutlineBlueOuter);
  drawInsetBand(ox, oy, 995, 984, 1000, rimOutlineBlue);
  outlineInsetLR(984, 973, rimOutlineBlueR1L, rimOutlineBlueR1R);
  outlineInsetLR(973, 962, rimOutlineBlueR2L, rimOutlineBlueR2R);
  outlineInsetLR(962, 951, rimOutlineBlueR3L, rimOutlineBlueR3R);
  outlineInsetLR(951, 940, rimOutlineBlueR4L, rimOutlineBlueR4R);

  // White "2" centered on shield (centroid); drawn after outline.
  {
    const int twoSz = (fh >= 40) ? 3 : 2;
    gfx->setTextSize(twoSz);
    gfx->setTextColor(RGB565_WHITE);
    const char* twoCh = "2";
    int16_t bbx, bby;
    uint16_t bbw, bbh;
    gfx->getTextBounds(twoCh, 0, 0, &bbx, &bby, &bbw, &bbh);
    const int twoPx = ax - (int)bbw / 2;
    const int twoWantTop = ay - (int)bbh / 2;
    gfx->getTextBounds(twoCh, twoPx, twoWantTop, &bbx, &bby, &bbw, &bbh);
    const int twoPy = twoWantTop + twoWantTop - (int)bby;
    gfx->setCursor(twoPx, twoPy);
    gfx->print(twoCh);
    gfx->setCursor(twoPx + 1, twoPy);
    gfx->print(twoCh);
  }

  gfx->setTextSize(1);
  {
    const uint16_t tfaInk = blendRGB565(blendRGB565(shieldMain, shieldLight, 0.35f), RGB565_WHITE, 0.08f);
    gfx->setTextColor(darkTile ? UI_TEXT : tfaInk);
  }
  const char* tfaLab = "2FA";
  const int charW = 6;
  const int letterGap = 2;
  const int boldDx = 1;
  const int tfaTw = (int)strlen(tfaLab) * charW + ((int)strlen(tfaLab) - 1) * letterGap;
  int tx = x + (s - tfaTw) / 2;
  if (tx < x + 1) tx = x + 1;

  // Place label under the shield with extra air.
  const int shieldBottom = by;
  const int textH = 8;
  const int labelDesiredTop = shieldBottom + max(4, s / 18);
  const int maxTop = (y + s) - textH - 2;
  int textTop = labelDesiredTop;
  if (textTop < y + 1) textTop = y + 1;
  if (textTop > maxTop) textTop = maxTop;

  int labelY = textTop;
  int16_t tbx, tby;
  uint16_t tbw, tbh;
  gfx->getTextBounds(tfaLab, tx, labelY, &tbx, &tby, &tbw, &tbh);
  labelY += textTop - (int)tby;

  for (int i = 0; i < (int)strlen(tfaLab); i++) {
    const int cx = tx + i * (charW + letterGap);
    char buf[2] = { tfaLab[i], 0 };
    gfx->setCursor(cx, labelY);
    gfx->print(buf);
    gfx->setCursor(cx + boldDx, labelY);
    gfx->print(buf);
  }
}

// Simple rounded-square card; Passwords / Notes / 2FA use a vertical gradient on the tile.
static void drawMenuRoundedCard(const Rect& r, char icon, const char* label, uint16_t accent) {
  const bool iconOnly = (label && (strcmp(label, "Passwords") == 0 || strcmp(label, "Notes") == 0 || strcmp(label, "2FA") == 0));
  const bool drawPasswordsCard = (label && strcmp(label, "Passwords") == 0);
  const bool drawNotesCard = (label && strcmp(label, "Notes") == 0);
  const bool draw2FACard = (label && strcmp(label, "2FA") == 0);

  // Draw a centered rounded-square inside the hitbox rect (rect may be non-square).
  const int sq = (r.w < r.h) ? r.w : r.h;
  const int x = r.x + (r.w - sq) / 2;
  const int y = r.y + (r.h - sq) / 2;
  // Samsung-ish radius: larger than the generic 10px so it reads as a modern rounded tile.
  const int rad = (drawPasswordsCard || drawNotesCard || draw2FACard) ? max(14, sq / 5) : 10;
  const bool drawSpecialTile = drawPasswordsCard || drawNotesCard || draw2FACard;
  if (!iconOnly || drawSpecialTile) {
    if (drawPasswordsCard || drawNotesCard || draw2FACard) {
      fillMainMenuStyleGradientTile(x, y, sq, rad);
    } else {
      gfx->fillRoundRect(x, y, sq, sq, rad, UI_CARD);
      const uint16_t borderOuter = blendRGB565(UI_CARD, RGB565_WHITE, 0.24f);
      gfx->drawRoundRect(x, y, sq, sq, rad, borderOuter);
      const int radIn = max(1, rad - 1);
      if (sq > 4) {
        const uint16_t borderInner = blendRGB565(UI_CARD, RGB565_WHITE, 0.28f);
        gfx->drawRoundRect(x + 1, y + 1, sq - 2, sq - 2, radIn, borderInner);
      }
    }
  }

  // Icon
  // Special icon for Passwords: lock + asterisks (4).
  if (label && strcmp(label, "Passwords") == 0) {
    // Vector icon (crisp like smartphone apps): no bitmap scaling artifacts.
    const int labelPadBottom = 22;
    const int pad = drawPasswordsCard ? 8 : (iconOnly ? 2 : 8);
    int iconS = iconOnly ? (sq - 2 * pad) : (sq - labelPadBottom - pad - 2);
    if (iconS < 44) iconS = 44;
    if (iconS > sq - 2 * pad) iconS = sq - 2 * pad;
    const int ix = x + (sq - iconS) / 2;
    const int iy = y + pad;
    // In icon-only mode we don't draw a UI_CARD behind the icon, so cutouts must use the real menu background.
    drawPasswordsAppIcon(ix, iy, iconS, accent, drawPasswordsCard ? mainMenuDarkCardTile565() : (iconOnly ? RGB565_BLACK : UI_CARD));
  } else if (label && strcmp(label, "Notes") == 0) {
    const int labelPadBottom = 22;
    const int pad = drawNotesCard ? 8 : (iconOnly ? 2 : 8);
    int iconS = (drawNotesCard ? (sq - 2 * pad) : (iconOnly ? sq : (sq - labelPadBottom - pad - 2)));
    if (iconS < 44) iconS = 44;
    if (iconS > sq - 2 * pad) iconS = sq - 2 * pad;
    const int ix = x + (sq - iconS) / 2;
    const int iy = y + pad;
    drawNotesAppIcon(ix, iy, iconS, drawNotesCard ? mainMenuDarkCardTile565() : (iconOnly ? RGB565_BLACK : UI_CARD));
  } else if (label && strcmp(label, "2FA") == 0) {
    const int labelPadBottom = 22;
    const int pad = draw2FACard ? 6 : (iconOnly ? 2 : 8);
    int iconS = (draw2FACard ? (sq - 2 * pad) : (iconOnly ? sq : (sq - labelPadBottom - pad - 2)));
    if (iconS < 44) iconS = 44;
    if (iconS > sq - 2 * pad) iconS = sq - 2 * pad;
    const int ix = x + (sq - iconS) / 2;
    const int iy = y + pad;
    draw2FAAppIcon(ix, iy, iconS, draw2FACard ? mainMenuDarkCardTile565() : (iconOnly ? RGB565_BLACK : UI_CARD));
  } else {
    gfx->setTextColor(accent);
    gfx->setTextSize(2);
    // Center icon near top.
    int iconX = x + (sq - 12) / 2;
    int iconY = y + 6;
    gfx->setCursor(iconX, iconY);
    gfx->print(icon);
  }

  // Label (centered)
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(1);
  int lw = (int)strlen(label) * 6;
  int lx = x + (sq - lw) / 2;
  int ly = y + sq - (iconOnly ? 16 : 22) + (iconOnly ? 0 : 10);
  // For Passwords/Notes/2FA, the label is drawn on the icon itself.
  if (label && (strcmp(label, "Passwords") == 0 || strcmp(label, "Notes") == 0 || strcmp(label, "2FA") == 0)) return;
  if (lx < x + 2) lx = x + 2;
  if (ly < y + 2) ly = y + 2;
  // Keep label inside the card.
  const int maxLy = y + sq - 10;
  if (ly > maxLy) ly = maxLy;
  gfx->setCursor(lx, ly);
  gfx->print(label);
}

