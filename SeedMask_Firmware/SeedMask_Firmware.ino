static const uint8_t SUG_MAX = 6;
static char g_sug[SUG_MAX][16];
static uint8_t g_sugN = 0;

// 2 rows of 3 pills under the word box (each suggestion = one stadium); moved down with box
static Rect SUG_AREA[SUG_MAX] = {
  { 8, 118, 100, 30 },
  { 114, 118, 100, 30 },
  { 220, 118, 100, 30 },
  { 8, 152, 100, 30 },
  { 114, 152, 100, 30 },
  { 220, 152, 100, 30 },
};
// Blink feedback when user taps a suggestion
static int8_t s_suggestionFlashIndex = -1;
static bool s_suggestionFlashHighlight = false;

static bool startsWith(const char* w, const char* prefix) {
  while (*prefix)
    if (*w++ != *prefix++) return false;
  return true;
}

static void updateSuggestions() {
  g_sugN = 0;
  if (!g_wordBuf[0]) return;
  char tmp[16];
  for (uint16_t i = 0; i < BIP39_WORD_COUNT && g_sugN < SUG_MAX; i++) {
    bip39_get_word(i, tmp, sizeof(tmp));
    if (startsWith(tmp, g_wordBuf)) {
      strncpy(g_sug[g_sugN], tmp, 15);
      g_sug[g_sugN][15] = 0;
      g_sugN++;
    }
  }
}

// =======================
// Seed entry helpers
// =======================
static void clearWordBuf() {
  g_wordBuf[0] = 0;
  updateSuggestions();
}
static void appendToWordBuf(char c) {
  if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
  if (c < 'a' || c > 'z') return;
  size_t n = strlen(g_wordBuf);
  if (n >= sizeof(g_wordBuf) - 1) return;
  g_wordBuf[n] = c;
  g_wordBuf[n + 1] = 0;
  updateSuggestions();
}
/**
 * Step back one word slot (Del on empty box, or swipe-right).
 * Parks the current field so later words are not lost when stepping back multiple times.
 */
static bool seedEntryPreviousWord() {
  if (g_seedCount == 0) return false;
  if (g_wordBuf[0]) {
    strncpy(g_seed[g_seedCount], g_wordBuf, 15);
    g_seed[g_seedCount][15] = 0;
  } else {
    memset(g_seed[g_seedCount], 0, sizeof(g_seed[g_seedCount]));
  }
  g_seedCount--;
  strncpy(g_wordBuf, g_seed[g_seedCount], sizeof(g_wordBuf) - 1);
  g_wordBuf[sizeof(g_wordBuf) - 1] = 0;
  updateSuggestions();
  setMsg("");
  return true;
}

/**
 * Step forward one word (swipe-left). Commits the current field when valid.
 * Returns true if navigation happened (including finishing all words → caller should check g_seedCount).
 */
static bool seedEntryNextWord() {
  if (g_seedCount >= g_wc) return false;
  if (!g_wordBuf[0]) return false;
  return commitWord(g_wordBuf);
}

static void backspaceWordBuf() {
  size_t n = strlen(g_wordBuf);
  if (n) {
    g_wordBuf[n - 1] = 0;
    updateSuggestions();
    return;
  }
  // Empty box: Del steps back to the previous word (same as swipe-right).
  (void)seedEntryPreviousWord();
}
static void trimSecretInPlace(char* s);
static void resetSeedEntry(uint8_t wc) {
  memset(g_seed, 0, sizeof(g_seed));
  g_wc = wc;
  g_seedCount = 0;
  clearWordBuf();
  setMsg("");
}

// BIP39 checksum: same construction as generate_mnemonic_words / entropy_to_bip39_words (BIP-0039).
// Pack word indices -> first ENT/8 bytes are entropy -> regenerate mnemonic from entropy; must match.
static bool bip39_verify_checksum(const char seedWords[][16], uint8_t wc) {
  if (wc != 12 && wc != 24) return false;
  uint16_t idx[24];
  for (int i = 0; i < wc; i++) {
    char word[16];
    strncpy(word, seedWords[i], 15);
    word[15] = 0;
    trimSecretInPlace(word);
    if (!word[0]) return false;
    int16_t fi = bip39_find_index_ci(word);
    if (fi < 0) return false;
    idx[i] = (uint16_t)fi;
  }
  uint8_t packed[33];
  memset(packed, 0, sizeof(packed));
  if (!pack_seed_indices(idx, wc, packed, sizeof(packed))) return false;

  const unsigned totalBits = (unsigned)wc * 11u;
  const unsigned csBits = totalBits / 33u;
  const unsigned entBits = totalBits - csBits;
  const size_t entBytes = (size_t)(entBits / 8u);
  if ((wc == 12 && (csBits != 4u || entBytes != 16u)) || (wc == 24 && (csBits != 8u || entBytes != 32u))) return false;

  uint8_t entropy[32];
  memset(entropy, 0, sizeof(entropy));
  memcpy(entropy, packed, entBytes);

  char regen[24][16];
  memset(regen, 0, sizeof(regen));
  if (!entropy_to_bip39_words(entropy, entBytes, wc, regen)) {
    secure_memzero(entropy, sizeof(entropy));
    return false;
  }
  secure_memzero(entropy, sizeof(entropy));

  for (int i = 0; i < wc; i++) {
    char expected[16];
    bip39_get_word(idx[i], expected, sizeof(expected));
    expected[15] = 0;
    if (strncmp(regen[i], expected, 15) != 0) return false;
  }
  return true;
}

static bool commitWord(const char* w) {
  if (g_seedCount >= g_wc) return false;
  if (!w || !w[0]) {
    setMsg("Empty word.");
    return false;
  }
  char wbuf[16];
  strncpy(wbuf, w, 15);
  wbuf[15] = 0;
  trimSecretInPlace(wbuf);
  if (!wbuf[0]) {
    setMsg("Empty word.");
    return false;
  }
  int16_t fi = bip39_find_index_ci(wbuf);
  if (fi < 0) {
    setMsg("Not a BIP39 word.");
    return false;
  }
  char canon[16];
  bip39_get_word((uint16_t)fi, canon, sizeof(canon));
  canon[15] = 0;
  strncpy(g_seed[g_seedCount], canon, 15);
  g_seed[g_seedCount][15] = 0;
  secure_memzero(canon, sizeof(canon));
  g_seedCount++;
  if (g_seedCount == g_wc) {
    clearWordBuf();
    if (!bip39_verify_checksum(g_seed, g_wc)) {
      g_seedCount--;
      memset(g_seed[g_seedCount], 0, sizeof(g_seed[g_seedCount]));
      setMsg("Checksum error. Check your words.");
      return false;
    }
  } else if (g_seed[g_seedCount][0]) {
    // Resume a word parked while stepping back with Del / swipe.
    strncpy(g_wordBuf, g_seed[g_seedCount], sizeof(g_wordBuf) - 1);
    g_wordBuf[sizeof(g_wordBuf) - 1] = 0;
    updateSuggestions();
  } else {
    clearWordBuf();
  }
  setMsg("");
  return true;
}

// =======================
// Password / code buffers
// =======================
static void clearPassword(char* p) {
  p[0] = 0;
}
static void backspaceStr(char* p, size_t cap) {
  (void)cap;
  size_t n = strlen(p);
  if (n) p[n - 1] = 0;
}
static void appendChar(char* p, size_t cap, char c) {
  size_t n = strlen(p);
  if (n >= cap - 1) return;
  p[n] = c;
  p[n + 1] = 0;
}
// Trim leading and trailing space/tab/CR/LF in place (for TOTP secret paste).
static void trimSecretInPlace(char* s) {
  if (!s || !*s) return;
  char* p = s;
  while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
  if (p > s) {
    size_t len = strlen(p) + 1;
    memmove(s, p, len);
  }
  size_t n = strlen(s);
  while (n > 0 && (s[n - 1] == ' ' || s[n - 1] == '\t' || s[n - 1] == '\r' || s[n - 1] == '\n')) n--;
  s[n] = 0;
}

static void restorePayload_clear() {
  if (g_restorePayload) g_restorePayload[0] = 0;
}
static void restorePayload_bs() {
  if (!g_restorePayload) return;
  backspaceStr(g_restorePayload, RESTORE_PAYLOAD_MAX);
}
static void restorePayload_add(char c) {
  if (!g_restorePayload) return;
  if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
  if (!((c >= 'A' && c <= 'Z') || (c >= '2' && c <= '7'))) return;
  if (!g_restorePayloadIsSpf1 && strlen(g_restorePayload) >= BACKUP_SPB1_PAYLOAD_24) return;
  appendChar(g_restorePayload, RESTORE_PAYLOAD_MAX, c);
}
static void restorePayload_buildFull() {
  if (!g_restorePayload) return;
  String payload = String(g_restorePayload);
  String grouped = group4(payload);
  String full = String(g_restorePayloadIsSpf1 ? "SPF1-" : "SPB1-") + grouped;
  const size_t need = (size_t)full.length() + 1u;
  char* dest = g_restoreFull;
  if (need > RESTORE_FULL_MAX_BYTES) {
    if (need > g_restoreLineWideCap) {
      if (g_restoreLineWide) {
        free(g_restoreLineWide);
        g_restoreLineWide = nullptr;
        g_restoreLineWideCap = 0;
      }
      g_restoreLineWide = (char*)ps_malloc(need + 64u);
      g_restoreLineWideCap = g_restoreLineWide ? (need + 64u) : 0;
    }
    dest = g_restoreLineWide;
  }
  if (!dest) {
    g_restoreLineActive = g_restoreFull;
    if (g_restoreFull) g_restoreFull[0] = 0;
    return;
  }
  strncpy(dest, full.c_str(), need);
  dest[need - 1] = 0;
  g_restoreLineActive = dest;
}

// =======================
// Random mnemonic generation
// =======================
static bool generate_mnemonic_words(uint8_t wc, char outWords[][16]) {
  uint8_t entBytes = (wc == 24) ? 32 : 16;
  uint8_t entropy[32];
#if defined(ARDUINO_ARCH_ESP32)
  // Feed the hardware RNG with SAR ADC noise while collecting seed entropy.
  // Required when Wi-Fi/BT are off (air-gapped); otherwise Espressif treats
  // esp_fill_random as pseudo-random from the post-boot RNG state only.
  // Do not use ADC / RF while this is enabled.
  bootloader_random_enable();
  esp_fill_random(entropy, entBytes);
  bootloader_random_disable();
#else
  esp_fill_random(entropy, entBytes);
#endif

  uint8_t hash[32];
  mbedtls_sha256(entropy, entBytes, hash, 0);

  uint8_t csBits = (wc == 24) ? 8 : 4;
  uint16_t idx[24] = { 0 };
  uint32_t bitpos = 0;

  auto getBit = [&](uint32_t b) -> uint8_t {
    if (b < entBytes * 8) {
      uint32_t bi = b / 8, bj = 7 - (b % 8);
      return (entropy[bi] >> bj) & 1;
    } else {
      uint32_t cb = b - entBytes * 8;
      uint32_t bj = 7 - cb;
      return (hash[0] >> bj) & 1;
    }
  };

  uint32_t totalBits = entBytes * 8 + csBits;
  for (int w = 0; w < wc; w++) {
    uint16_t v = 0;
    for (int b = 0; b < 11; b++) v = (uint16_t)((v << 1) | getBit(bitpos++));
    idx[w] = v;
    if (bitpos > totalBits) break;
  }

  for (int i = 0; i < wc; i++) {
    char tmp[16];
    bip39_get_word(idx[i], tmp, sizeof(tmp));
    strncpy(outWords[i], tmp, 15);
    outWords[i][15] = 0;
  }
  return true;
}

// =======================
// Backup code generation / restore
// =======================
static bool make_backup_code_from_seed(const char seedWords[][16], uint8_t wc,
                                       const char* password,
                                       char* outCode, size_t outCodeLen,
                                       bool alsoStoreNVS);

static bool restore_seed_from_backup_code(const char* codeWithPrefix,
                                          const char* password,
                                          char outSeed[][16], uint8_t& outWc,
                                          bool alsoStoreNVS);

static bool make_backup_code_from_seed(const char seedWords[][16], uint8_t wc,
                                       const char* password,
                                       char* outCode, size_t outCodeLen,
                                       bool alsoStoreNVS) {
  if (!backup_password_ok_for_create(password)) return false;
  if (!(wc == 12 || wc == 24)) return false;

  uint16_t idx[24];
  for (int i = 0; i < wc; i++) {
    int16_t fi = bip39_find_index(seedWords[i]);
    if (fi < 0) {
      setMsg("Seed contains invalid word.");
      return false;
    }
    idx[i] = (uint16_t)fi;
  }

  size_t seedBytesLen = packed_len_for_words(wc);
  uint8_t seedPacked[33];
  if (!pack_seed_indices(idx, wc, seedPacked, sizeof(seedPacked))) return false;

  uint8_t salt[4];
  esp_fill_random(salt, sizeof(salt));

  uint8_t key[32];
  if (!pbkdf2_sha256((const uint8_t*)password, strlen(password), salt, sizeof(salt), BACKUP_PBKDF2_ITERATIONS, key, sizeof(key))) {
    setMsg("PBKDF2 failed.");
    return false;
  }

  // XOR + 4-byte HMAC for the portable code. On-device vault stays AES-GCM (10k KDF).
  uint8_t ct[33];
  memcpy(ct, seedPacked, seedBytesLen);
  xor_keystream(key, ct, seedBytesLen);

  uint8_t ver = BACKUP_SPB1_VERSION;
  uint8_t mac[BACKUP_SPB1_MAC_LEN];
  if (!backup_spb1_mac4(key, ver, wc, salt, ct, seedBytesLen, mac)) {
    secure_memzero(key, sizeof(key));
    setMsg("HMAC failed.");
    return false;
  }
  secure_memzero(key, sizeof(key));

  uint8_t hdr[2 + 4 + 33 + BACKUP_SPB1_MAC_LEN];
  size_t p = 0;
  hdr[p++] = ver;
  hdr[p++] = wc;
  memcpy(hdr + p, salt, 4);
  p += 4;
  memcpy(hdr + p, ct, seedBytesLen);
  p += seedBytesLen;
  memcpy(hdr + p, mac, BACKUP_SPB1_MAC_LEN);
  p += BACKUP_SPB1_MAC_LEN;

  String payload = base32_encode(hdr, p);
  String code = String("SPB1-") + group4(payload);

  if (code.length() + 1 > outCodeLen) {
    setMsg("Code buffer too small.");
    return false;
  }
  strncpy(outCode, code.c_str(), outCodeLen - 1);
  outCode[outCodeLen - 1] = 0;

  if (alsoStoreNVS && !g_duressSession) {
    uint8_t nvsSalt[4];
    esp_fill_random(nvsSalt, sizeof(nvsSalt));
    uint8_t nvsCt[65];
    size_t nvsCtLen = sizeof(nvsCt);
    if (!aes_gcm_encrypt(password, nvsSalt, seedPacked, seedBytesLen, nvsCt, &nvsCtLen)) {
      setMsg("NVS save failed.");
      return false;
    }
    uint8_t nvsHdr[2 + 4 + 65 + 2];
    size_t np = 0;
    nvsHdr[np++] = 1;
    nvsHdr[np++] = wc;
    memcpy(nvsHdr + np, nvsSalt, 4);
    np += 4;
    memcpy(nvsHdr + np, nvsCt, nvsCtLen);
    np += nvsCtLen;
    uint16_t nvsCrc = crc16_ccitt(nvsHdr, np);
    nvsHdr[np++] = (uint16_t)((nvsCrc >> 8) & 0xFF);
    nvsHdr[np++] = (uint16_t)(nvsCrc & 0xFF);
    if (!nvs_save_vault(nvsHdr, np)) {
      setMsg("NVS save failed.");
      return false;
    }
    g_hasVault = true;
    // Vault on flash implies persistent mode (avoid boot path that erases NVS when stateless pref is stale).
    if (g_stateless) {
      g_stateless = false;
      persist_stateless();
    }
  }
  return true;
}

// --- SPF1: full device backup (seed vault_blob + vault_pw ciphertext) as text (Passwords→BACKUP + optional restore) ---
#ifndef SPF1_TEXT_BACKUP_MAX_CHARS
#define SPF1_TEXT_BACKUP_MAX_CHARS (96 * 1024)
#endif
static void spf1_write_le32(uint8_t* p, uint32_t v) {
  p[0] = (uint8_t)(v & 0xFF);
  p[1] = (uint8_t)((v >> 8) & 0xFF);
  p[2] = (uint8_t)((v >> 16) & 0xFF);
  p[3] = (uint8_t)((v >> 24) & 0xFF);
}
static uint32_t spf1_read_le32(const uint8_t* p) {
  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
}
static bool full_vault_spf1_backup_to_heap_string(char** outHeap, size_t* outLen) {
  *outHeap = nullptr;
  *outLen = 0;
  uint8_t* vb = nullptr;
  size_t vl = 0;
  uint8_t* vp = nullptr;
  size_t vpl = 0;
  if (!nvs_load_vault(&vb, vl)) return false;
  (void)nvs_load_vault_pw(&vp, vpl);
  size_t addrW = 0;
  const size_t addrCap = 6200u;
  uint8_t* addrScratch = (uint8_t*)ps_malloc(addrCap);
  if (addrScratch && !g_tempSeedActive) {
    if (!addr_status_write_blob(addrScratch, addrCap, &addrW)) addrW = 0;
  }
  const size_t addrExtra = (addrW > 0) ? (4u + addrW) : 0u;
  const size_t binLen = 1u + 4u + vl + 4u + vpl + addrExtra;
  uint8_t* bin = (uint8_t*)ps_malloc(binLen);
  if (!bin) {
    secure_memzero(vb, vl);
    free(vb);
    if (vp) {
      secure_memzero(vp, vpl);
      free(vp);
    }
    if (addrScratch) {
      secure_memzero(addrScratch, addrCap);
      free(addrScratch);
    }
    return false;
  }
  size_t o = 0;
  bin[o++] = 1;
  spf1_write_le32(bin + o, (uint32_t)vl);
  o += 4;
  memcpy(bin + o, vb, vl);
  o += vl;
  secure_memzero(vb, vl);
  free(vb);
  spf1_write_le32(bin + o, (uint32_t)vpl);
  o += 4;
  if (vpl && vp) memcpy(bin + o, vp, vpl);
  if (vp) {
    secure_memzero(vp, vpl);
    free(vp);
  }
  o += vpl;
  if (addrExtra && addrScratch) {
    spf1_write_le32(bin + o, (uint32_t)addrW);
    o += 4;
    memcpy(bin + o, addrScratch, addrW);
    o += addrW;
  }
  if (addrScratch) {
    secure_memzero(addrScratch, addrCap);
    free(addrScratch);
  }
  String payload = base32_encode(bin, o);
  String code = String("SPF1-") + group4(payload);
  secure_memzero(bin, binLen);
  free(bin);
  const size_t need = (size_t)code.length() + 1u;
  if (need > SPF1_TEXT_BACKUP_MAX_CHARS) return false;
  char* heap = (char*)ps_malloc(need);
  if (!heap) return false;
  memcpy(heap, code.c_str(), need);
  *outHeap = heap;
  *outLen = need;
  return true;
}

// Static buffers to avoid String and large locals on stack (loop task has limited stack)
static char s_restore_codeBuf[256];
static char s_restore_payloadBuf[256];
static char s_restore_tmp[16];  // shared bip39 word buffer in restore_seed_from_backup_code

static bool restore_seed_from_backup_code(const char* codeWithPrefix,
                                          const char* password,
                                          char outSeed[][16], uint8_t& outWc,
                                          bool alsoStoreNVS) {
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("restore_seed_from_backup_code: Starting restore...");
  Serial.print("restore_seed_from_backup_code: Code length=");
  Serial.println(codeWithPrefix ? strlen(codeWithPrefix) : 0);
  Serial.print("restore_seed_from_backup_code: Password length=");
  Serial.println(password ? strlen(password) : 0);
#endif

  if (!codeWithPrefix) return false;
  if (!password || strlen(password) < 4) {
    setMsg("Password too short.");
    return false;
  }

  size_t cLen = strlen(codeWithPrefix);
  char* s;
  if (cLen < sizeof(s_restore_codeBuf)) {
    memcpy(s_restore_codeBuf, codeWithPrefix, cLen + 1);
    s = s_restore_codeBuf;
  } else {
    s = (char*)codeWithPrefix;
  }
  while (*s == ' ' || *s == '\t') s++;
  cLen = strlen(s);
  while (cLen > 0 && (s[cLen - 1] == ' ' || s[cLen - 1] == '\t')) { s[--cLen] = 0; }
  for (size_t i = 0; s[i]; i++)
    if (s[i] >= 'a' && s[i] <= 'z') s[i] = (char)(s[i] - 'a' + 'A');

  // SPF1: full vault (seed NVS blob + vault_pw ciphertext). Must be before SPB1 handling.
  if (strncmp(s, "SPF1-", 5) == 0) {
    size_t maxBin = (cLen * 5u) / 8u + 128u;
    if (maxBin < 256u) maxBin = 256u;
    uint8_t* pkg = (uint8_t*)ps_malloc(maxBin);
    if (!pkg) {
      setMsg("No memory");
      return false;
    }
    size_t pkgLen = 0;
    if (!base32_decode(s + 5, pkg, maxBin, pkgLen)) {
      secure_memzero(pkg, maxBin);
      free(pkg);
      setMsg("Invalid Base32");
      return false;
    }
    if (pkgLen < 9u || pkg[0] != 1) {
      secure_memzero(pkg, maxBin);
      free(pkg);
      setMsg("Invalid SPF1 backup");
      return false;
    }
    uint32_t vl = spf1_read_le32(pkg + 1);
    if (vl > 100000u || (size_t)(5u + vl + 4u) > pkgLen) {
      secure_memzero(pkg, maxBin);
      free(pkg);
      setMsg("Invalid SPF1 backup");
      return false;
    }
    const uint8_t* seedBlob = pkg + 5;
    uint32_t vpl = spf1_read_le32(pkg + 5u + vl);
    const size_t basePkg = 5u + (size_t)vl + 4u + (size_t)vpl;
    if (pkgLen < basePkg) {
      secure_memzero(pkg, maxBin);
      free(pkg);
      setMsg("Invalid SPF1 backup");
      return false;
    }
    const uint8_t* spf1AddrPtr = nullptr;
    size_t spf1AddrLen = 0;
    if (pkgLen > basePkg) {
      if (pkgLen < basePkg + 4u) {
        secure_memzero(pkg, maxBin);
        free(pkg);
        setMsg("Invalid SPF1 backup");
        return false;
      }
      const uint32_t addrLenU32 = spf1_read_le32(pkg + basePkg);
      if (addrLenU32 > 100000u || pkgLen != basePkg + 4u + (size_t)addrLenU32) {
        secure_memzero(pkg, maxBin);
        free(pkg);
        setMsg("Invalid SPF1 backup");
        return false;
      }
      if (addrLenU32 > 0u) {
        spf1AddrPtr = pkg + basePkg + 4u;
        spf1AddrLen = (size_t)addrLenU32;
      }
    }
    const uint8_t* vpBlob = pkg + 5u + vl + 4u;
    if (alsoStoreNVS && !g_duressSession) {
      if (!nvs_save_vault(seedBlob, vl)) {
        secure_memzero(pkg, maxBin);
        free(pkg);
        setMsg("NVS save failed");
        return false;
      }
      if (vpl) {
        if (!nvs_save_vault_pw(vpBlob, vpl)) {
          secure_memzero(pkg, maxBin);
          free(pkg);
          setMsg("NVS save failed");
          return false;
        }
      } else {
        nvs_clear_vault_pw();
      }
      g_hasVault = true;
    }
    uint8_t wc = 12;
    bool ok = restore_seed_from_vault_blob(seedBlob, vl, password, outSeed, wc);
    outWc = wc;
    if (ok && spf1AddrPtr && spf1AddrLen) {
      if (!addr_status_apply_blob(spf1AddrPtr, spf1AddrLen, false)) ok = false;
      else if (alsoStoreNVS && !g_tempSeedActive && (outWc == 12 || outWc == 24)) {
        char xfpSpf[9];
        if (bip39_mnemonic_words_fingerprint((const char(*)[16])outSeed, outWc, xfpSpf) && xfpSpf[0]) {
          uint8_t tb[6200];
          size_t tw = 0;
          if (addr_status_write_blob(tb, sizeof(tb), &tw)) {
            char pk[16];
            snprintf(pk, 16, "asu_%s", xfpSpf);
            Preferences prefs;
            prefs.begin("seedmask", false);
            prefs.putBytes(pk, tb, tw);
            prefs.end();
          }
        }
      }
    }
    secure_memzero(pkg, maxBin);
    free(pkg);
    return ok;
  }

  if (strncmp(s, "SPB1-", 5) != 0) {
    setMsg("Code must start SPB1- or SPF1-");
    return false;
  }
  if (strlen(password) < BACKUP_PASSWORD_MIN_LEN) {
    setMsg("Use at least 12 characters.");
    return false;
  }
  const char* src = s + 5;
  char* dst = s_restore_payloadBuf;
  size_t cap = sizeof(s_restore_payloadBuf) - 1;
  while (*src && cap > 0) {
    if (*src != '-') {
      *dst++ = *src;
      cap--;
    }
    src++;
  }
  *dst = 0;
  size_t payloadLen = strlen(s_restore_payloadBuf);

  size_t maxOut = (payloadLen * 5) / 8 + 8;
  uint8_t* buf = (uint8_t*)ps_malloc(maxOut);
  if (!buf) {
    setMsg("No memory");
    return false;
  }
  size_t blen = 0;
  if (!base32_decode(s_restore_payloadBuf, buf, maxOut, blen)) {
    secure_memzero(buf, maxOut);
    free(buf);
    setMsg("Invalid Base32");
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("restore_seed_from_backup_code: Base32 decoded ");
  Serial.print(blen);
  Serial.println(" bytes");

  Serial.print("restore_seed_from_backup_code: Processing backup code: ");
  Serial.println(codeWithPrefix);

  Serial.print("restore_seed_from_backup_code: Vault structure - ver=");
  Serial.print(buf[0]);
  Serial.print(", wc=");
  Serial.print(buf[1]);
  Serial.print(", salt=");
  for (int i = 0; i < 4; i++) {
    if (buf[2 + i] < 16) Serial.print("0");
    Serial.print(buf[2 + i], HEX);
  }
  Serial.print(", data_len=");
  Serial.println(blen > 10 ? (blen - 10) : 0);
#endif

  if (blen < 8) {
    secure_memzero(buf, maxOut);
    free(buf);
    setMsg("Invalid backup code");
    return false;
  }

  // v1 XOR+CRC codes are not restored.
  if (blen == (size_t)(1 + 1 + 4 + 17 + 2) || blen == (size_t)(1 + 1 + 4 + 33 + 2)) {
    secure_memzero(buf, maxOut);
    free(buf);
    setMsg("This backup format is no longer supported.");
    return false;
  }

  uint8_t ver = buf[0];
  uint8_t wc = buf[1];
  if (!(wc == 12 || wc == 24)) {
    secure_memzero(buf, maxOut);
    free(buf);
    setMsg("Bad version");
    return false;
  }

  size_t seedBytesLen = packed_len_for_words(wc);
  size_t xorHmacLen = (size_t)(1 + 1 + 4 + seedBytesLen + BACKUP_SPB1_MAC_LEN);
  if (blen == xorHmacLen) {
    if (ver != BACKUP_SPB1_VERSION) {
      secure_memzero(buf, maxOut);
      free(buf);
      setMsg("Bad version");
      return false;
    }
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("restore_seed_from_backup_code: Detected XOR+HMAC backup code");
#endif
    static uint8_t s_restore_ct[33];
    static uint8_t s_restore_key[32];
    static uint16_t s_restore_idx[24];
    static uint8_t s_restore_newSalt[4];
    static uint8_t s_restore_newSeedPacked[33];
    static uint8_t s_restore_newCt[65];
    static uint8_t s_restore_newHdr[2 + 4 + 61 + 2];
    static uint8_t s_restore_mac[BACKUP_SPB1_MAC_LEN];
    static uint8_t s_restore_got_mac[BACKUP_SPB1_MAC_LEN];

    memcpy(s_restore_ct, buf + 6, seedBytesLen);
    memcpy(s_restore_got_mac, buf + 6 + seedBytesLen, BACKUP_SPB1_MAC_LEN);
    if (!pbkdf2_sha256((const uint8_t*)password, strlen(password), buf + 2, 4, BACKUP_PBKDF2_ITERATIONS, s_restore_key, 32)) {
      secure_memzero(s_restore_ct, sizeof(s_restore_ct));
      secure_memzero(buf, maxOut);
      free(buf);
      setMsg("PBKDF2 failed");
      return false;
    }
    if (!backup_spb1_mac4(s_restore_key, ver, wc, buf + 2, s_restore_ct, seedBytesLen, s_restore_mac) ||
        !backup_mac4_eq(s_restore_mac, s_restore_got_mac)) {
      secure_memzero(s_restore_key, sizeof(s_restore_key));
      secure_memzero(s_restore_ct, sizeof(s_restore_ct));
      secure_memzero(s_restore_mac, sizeof(s_restore_mac));
      secure_memzero(s_restore_got_mac, sizeof(s_restore_got_mac));
      secure_memzero(buf, maxOut);
      free(buf);
      setMsg("Wrong password or code");
      return false;
    }
    xor_keystream(s_restore_key, s_restore_ct, seedBytesLen);
    unpack_seed_indices(s_restore_ct, wc, s_restore_idx);
    secure_memzero(s_restore_key, sizeof(s_restore_key));
    secure_memzero(s_restore_ct, sizeof(s_restore_ct));
    secure_memzero(s_restore_mac, sizeof(s_restore_mac));
    secure_memzero(s_restore_got_mac, sizeof(s_restore_got_mac));

    for (int i = 0; i < wc; i++) {
      if (s_restore_idx[i] >= BIP39_WORD_COUNT) {
        secure_memzero(s_restore_key, sizeof(s_restore_key));
        secure_memzero(s_restore_ct, sizeof(s_restore_ct));
        secure_memzero(buf, maxOut);
        free(buf);
        setMsg("Decode invalid");
        return false;
      }
      bip39_get_word(s_restore_idx[i], s_restore_tmp, sizeof(s_restore_tmp));
      strncpy(outSeed[i], s_restore_tmp, 15);
      outSeed[i][15] = 0;
    }
    outWc = wc;
    if (alsoStoreNVS && !g_duressSession) {
      g_hasVault = true;
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("restore_seed_from_backup_code: Creating AES-GCM vault from restored seed...");
#endif
      esp_fill_random(s_restore_newSalt, 4);
      if (!pack_seed_indices(s_restore_idx, wc, s_restore_newSeedPacked, sizeof(s_restore_newSeedPacked))) {
#if SEEDMASK_CRYPTO_DEBUG
        Serial.println("restore_seed_from_backup_code: Failed to pack restored seed");
#endif
        secure_memzero(buf, maxOut);
        free(buf);
        setMsg("Failed to create storage");
        return false;
      }
      size_t newCtLen = sizeof(s_restore_newCt);
      if (!aes_gcm_encrypt(password, s_restore_newSalt, s_restore_newSeedPacked, seedBytesLen, s_restore_newCt, &newCtLen)) {
#if SEEDMASK_CRYPTO_DEBUG
        Serial.println("restore_seed_from_backup_code: Failed to encrypt new vault");
#endif
        secure_memzero(s_restore_newCt, sizeof(s_restore_newCt));
        secure_memzero(buf, maxOut);
        free(buf);
        setMsg("Failed to create storage");
        return false;
      }
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("restore_seed_from_backup_code: AES-GCM vault created successfully");
#endif

      size_t newP = 0;
      s_restore_newHdr[newP++] = 1;
      s_restore_newHdr[newP++] = wc;
      memcpy(s_restore_newHdr + newP, s_restore_newSalt, 4);
      newP += 4;
      memcpy(s_restore_newHdr + newP, s_restore_newCt, newCtLen);
      newP += newCtLen;

      uint16_t newCrc = crc16_ccitt(s_restore_newHdr, newP);
      s_restore_newHdr[newP++] = (newCrc >> 8) & 0xFF;
      s_restore_newHdr[newP++] = newCrc & 0xFF;

      if (newP > sizeof(g_deferred_vault_buf)) {
        secure_memzero(buf, maxOut);
        free(buf);
        setMsg("Data too large");
        return false;
      }
      memcpy(g_deferred_vault_buf, s_restore_newHdr, newP);
      g_deferred_vault_len = newP;
      g_deferred_nvs_save_pending = true;
      if (!flush_deferred_vault_nvs_save()) {
        secure_memzero(buf, maxOut);
        free(buf);
        setMsg("NVS save failed");
        return false;
      }
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("restore_seed_from_backup_code: New AES-GCM vault saved to NVS");
#endif
      if (g_stateless) {
        g_stateless = false;
        persist_stateless();
      }
    }
    secure_memzero(s_restore_newCt, sizeof(s_restore_newCt));
    secure_memzero(buf, maxOut);
    free(buf);
    return true;

  } else if (blen == (size_t)(1 + 1 + 4 + 45 + 2) || blen == (size_t)(1 + 1 + 4 + 61 + 2)) {
    if (ver != 1) {
      secure_memzero(buf, maxOut);
      free(buf);
      setMsg("Bad version");
      return false;
    }
    uint16_t got = ((uint16_t)buf[blen - 2] << 8) | buf[blen - 1];
    uint16_t calc = crc16_ccitt(buf, blen - 2);
    if (got != calc) {
      secure_memzero(buf, maxOut);
      free(buf);
      setMsg("Wrong password or code");
      return false;
    }
    // AES-GCM format - vault storage (12-word: 45-byte ct, 24-word: 61-byte ct). Use static buffers to reduce stack.
    size_t aesCtLen = blen - 2 - 4 - 2;  // ver+wc + salt + ct + crc
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("restore_seed_from_backup_code: Detected AES-GCM format (vault storage)");
#endif
    static uint8_t s_restore_aes_salt[4];
    static uint8_t s_restore_aes_ct[65];  // 61 for 24-word
    static uint8_t s_restore_aes_pt[33];
    static uint16_t s_restore_aes_idx[24];

    memcpy(s_restore_aes_salt, buf + 2, 4);
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("restore_seed_from_backup_code: AES-GCM extracted salt=");
    for (int i = 0; i < 4; i++) {
      if (s_restore_aes_salt[i] < 16) Serial.print("0");
      Serial.print(s_restore_aes_salt[i], HEX);
      Serial.print(" ");
    }
    Serial.println();
    Serial.print("restore_seed_from_backup_code: Salt match: ");
    bool saltMatch = (s_restore_aes_salt[0] == 0x6F && s_restore_aes_salt[1] == 0x41 && s_restore_aes_salt[2] == 0x71 && s_restore_aes_salt[3] == 0x31);
    Serial.println(saltMatch ? "YES" : "NO");
#endif

    memcpy(s_restore_aes_ct, buf + 6, aesCtLen);
    size_t ptLen = sizeof(s_restore_aes_pt);
    if (!aes_gcm_decrypt(password, s_restore_aes_salt, s_restore_aes_ct, aesCtLen, s_restore_aes_pt, &ptLen)) {
      secure_memzero(s_restore_aes_ct, sizeof(s_restore_aes_ct));
      secure_memzero(buf, maxOut);
      free(buf);
      setMsg("AES-GCM decryption failed - wrong password");
      return false;
    }
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("restore_seed_from_backup_code: AES-GCM decrypted ");
    Serial.print(ptLen);
    Serial.println(" bytes");
#endif

    unpack_seed_indices(s_restore_aes_pt, wc, s_restore_aes_idx);
    secure_memzero(s_restore_aes_pt, sizeof(s_restore_aes_pt));
    secure_memzero(s_restore_aes_ct, sizeof(s_restore_aes_ct));

    for (int i = 0; i < wc; i++) {
      if (s_restore_aes_idx[i] >= BIP39_WORD_COUNT) {
        secure_memzero(buf, maxOut);
        free(buf);
        setMsg("Decode invalid");
        return false;
      }
      bip39_get_word(s_restore_aes_idx[i], s_restore_tmp, sizeof(s_restore_tmp));
      strncpy(outSeed[i], s_restore_tmp, 15);
      outSeed[i][15] = 0;
    }
    outWc = wc;

    if (alsoStoreNVS && !g_duressSession) {
      if (blen > sizeof(g_deferred_vault_buf)) {
        secure_memzero(buf, maxOut);
        free(buf);
        setMsg("Data too large");
        return false;
      }
      memcpy(g_deferred_vault_buf, buf, blen);
      g_deferred_vault_len = blen;
      g_deferred_nvs_save_pending = true;
      if (!flush_deferred_vault_nvs_save()) {
        secure_memzero(buf, maxOut);
        free(buf);
        setMsg("NVS save failed");
        return false;
      }
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("restore_seed_from_backup_code: NVS vault saved");
#endif
      g_hasVault = true;
      if (g_stateless) {
        g_stateless = false;
        persist_stateless();
      }
    }
    secure_memzero(buf, maxOut);
    free(buf);
    return true;

  } else {
    secure_memzero(buf, maxOut);
    free(buf);
    setMsg("Bad length - expected AES-GCM format");
    return false;
  }
}

// Restore from compact SeedQR payload bytes.
// Passport / SeedSigner "compact": raw entropy only — 16 bytes (12 words) or 32 bytes (24 words); checksum bits omitted.
// Legacy: full 11-bit index packing — 17 or 33 bytes (includes checksum in the bitstream tail).
static bool restore_seed_from_seedqr_bytes(const uint8_t* payload, size_t payloadLen, char outSeed[][16], uint8_t& outWc) {
  if (!payload) return false;
  // Standard SeedSigner SeedQR: only decimal digits, 48 (12×4) or 96 (24×4).
  if (payloadLen == 48 || payloadLen == 96) {
    bool allDigit = true;
    for (size_t i = 0; i < payloadLen; i++) {
      if (payload[i] < '0' || payload[i] > '9') {
        allDigit = false;
        break;
      }
    }
    if (allDigit) {
      const uint8_t wc = (payloadLen == 48) ? 12 : 24;
      for (uint8_t w = 0; w < wc; w++) {
        unsigned idx = (unsigned)(payload[w * 4] - '0') * 1000u + (unsigned)(payload[w * 4 + 1] - '0') * 100u
                       + (unsigned)(payload[w * 4 + 2] - '0') * 10u + (unsigned)(payload[w * 4 + 3] - '0');
        if (idx >= BIP39_WORD_COUNT) return false;
        bip39_get_word((uint16_t)idx, s_restore_tmp, sizeof(s_restore_tmp));
        strncpy(outSeed[w], s_restore_tmp, 15);
        outSeed[w][15] = 0;
      }
      outWc = wc;
      return bip39_verify_checksum(outSeed, outWc);
    }
  }
  if (payloadLen == 16) {
    if (!entropy_to_bip39_words(payload, 16, 12, outSeed)) return false;
    outWc = 12;
    return true;
  }
  if (payloadLen == 32) {
    if (!entropy_to_bip39_words(payload, 32, 24, outSeed)) return false;
    outWc = 24;
    return true;
  }
  uint8_t wc = 0;
  if (payloadLen == 17) wc = 12;
  else if (payloadLen == 33) wc = 24;
  else return false;
  uint8_t padded[33] = { 0 };
  memcpy(padded, payload, payloadLen);
  uint16_t idx[24];
  unpack_seed_indices(padded, wc, idx);
  for (uint8_t i = 0; i < wc; i++) {
    if (idx[i] >= BIP39_WORD_COUNT) return false;
    bip39_get_word(idx[i], s_restore_tmp, sizeof(s_restore_tmp));
    strncpy(outSeed[i], s_restore_tmp, 15);
    outSeed[i][15] = 0;
  }
  outWc = wc;
  return true;
}

// restore from stored vault blob (password only)
static bool restore_seed_from_vault_blob(const uint8_t* buf, size_t blen,
                                         const char* password,
                                         char outSeed[][16], uint8_t& outWc) {
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("restore_seed_from_vault_blob: Starting vault restoration");
  Serial.print("restore_seed_from_vault_blob: Input params - buf=");
  Serial.print((uintptr_t)buf, HEX);
  Serial.print(", blen=");
  Serial.print(blen);
  Serial.print(", password=");
  Serial.print(password ? "set" : "NULL");
  Serial.print(", pwd_len=");
  Serial.println(password ? strlen(password) : 0);
#endif

  if (!buf) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("restore_seed_from_vault_blob: ERROR - buf is NULL");
#endif
    setMsg("Data corrupted");
    return false;
  }

  // Generic minimum: version + wc + salt + crc
  size_t minHeaderSize = (size_t)(1 + 1 + 4 + 2);
  if (blen < minHeaderSize) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("restore_seed_from_vault_blob: ERROR - Vault too small: ");
    Serial.println(blen);
#endif
    setMsg("Data corrupted");
    return false;
  }

  if (!password || strlen(password) < 4) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("restore_seed_from_vault_blob: ERROR - password too short or NULL");
#endif
    setMsg("Password too short.");
    return false;
  }

  uint16_t got = ((uint16_t)buf[blen - 2] << 8) | buf[blen - 1];
  uint16_t calc = crc16_ccitt(buf, blen - 2);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("restore_seed_from_vault_blob: CRC check - got=");
  Serial.print(got, HEX);
  Serial.print(", calc=");
  Serial.println(calc, HEX);
#endif
  if (got != calc) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("restore_seed_from_vault_blob: ERROR - CRC mismatch");
#endif
    setMsg("Data corrupted");
    return false;
  }

  uint8_t ver = buf[0];
  uint8_t wc = buf[1];
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("restore_seed_from_vault_blob: Version check - ver=");
  Serial.print(ver);
  Serial.print(", wc=");
  Serial.println(wc);
#endif
  if (ver != 1 || !(wc == 12 || wc == 24)) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("restore_seed_from_vault_blob: ERROR - Bad version: ver=");
    Serial.print(ver);
    Serial.print(", wc=");
    Serial.println(wc);
#endif
    setMsg("Unsupported version");
    return false;
  }

  uint8_t salt[4];
  memcpy(salt, buf + 2, 4);

  size_t seedBytesLen = packed_len_for_words(wc);
  size_t xorVaultLen = (size_t)(1 + 1 + 4 + seedBytesLen + 2);              // legacy XOR vault
  size_t aesVaultLen = (size_t)(1 + 1 + 4 + (12 + seedBytesLen + 16) + 2);  // AES-GCM vault: iv(12)+data+tag(16)
  size_t minSizeAESGCM = (size_t)(1 + 1 + 4 + 33 + 2);                      // absolute minimum for any AES-GCM vault (smallest plausible)

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("restore_seed_from_vault_blob: Size check - blen=");
  Serial.print(blen);
  Serial.print(", xorVaultLen=");
  Serial.print(xorVaultLen);
  Serial.print(", aesVaultLen=");
  Serial.print(aesVaultLen);
  Serial.print(", minAESGCM=");
  Serial.println(minSizeAESGCM);
#endif

  // Detect and migrate legacy XOR vaults (created by older firmware)
  if (blen == xorVaultLen && blen < aesVaultLen) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("restore_seed_from_vault_blob: Detected legacy XOR vault, len=");
    Serial.println(blen);
#endif

    // XOR format: version | wc | salt(4) | ct(seedBytesLen) | crc(2)
    uint8_t ct_legacy[33];
    memcpy(ct_legacy, buf + 6, seedBytesLen);

    uint8_t key_legacy[32];
    if (!pbkdf2_sha256((const uint8_t*)password, strlen(password), salt, sizeof(salt), PBKDF2_ITERATIONS, key_legacy, sizeof(key_legacy))) {
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("restore_seed_from_vault_blob: PBKDF2 failed for legacy XOR vault");
#endif
      secure_memzero(ct_legacy, sizeof(ct_legacy));
      setMsg("PBKDF2 failed");
      return false;
    }

    xor_keystream(key_legacy, ct_legacy, seedBytesLen);

    uint16_t idx_legacy[24];
    unpack_seed_indices(ct_legacy, wc, idx_legacy);
    secure_memzero(ct_legacy, sizeof(ct_legacy));
    secure_memzero(key_legacy, sizeof(key_legacy));

    // Convert indices to BIP39 words
    for (int i = 0; i < wc; i++) {
      char tmp[16];
      if (idx_legacy[i] >= BIP39_WORD_COUNT) {
#if SEEDMASK_CRYPTO_DEBUG
        Serial.println("restore_seed_from_vault_blob: Invalid index in legacy XOR vault");
#endif
        setMsg("Data invalid");
        return false;
      }
      bip39_get_word(idx_legacy[i], tmp, sizeof(tmp));
      strncpy(outSeed[i], tmp, 15);
      outSeed[i][15] = 0;
    }
    outWc = wc;
    g_hasVault = true;

    // Migrate legacy XOR vault to AES-GCM format for future unlocks
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("restore_seed_from_vault_blob: Migrating legacy XOR vault to AES-GCM...");
#endif

    uint8_t newSalt[4];
    esp_fill_random(newSalt, sizeof(newSalt));

    uint8_t newSeedPacked[33];
    if (!pack_seed_indices(idx_legacy, wc, newSeedPacked, sizeof(newSeedPacked))) {
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("restore_seed_from_vault_blob: Failed to pack seed during migration");
#endif
      secure_memzero(newSeedPacked, sizeof(newSeedPacked));
      return true;
    }

    uint8_t newCt[65];  // 12+33+16 for 24-word
    size_t newCtLen = sizeof(newCt);
    // aes_gcm_encrypt performs PBKDF2 internally using the provided password string
    if (!aes_gcm_encrypt(password, newSalt, newSeedPacked, seedBytesLen, newCt, &newCtLen)) {
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("restore_seed_from_vault_blob: AES-GCM encrypt failed during migration");
#endif
      secure_memzero(newSeedPacked, sizeof(newSeedPacked));
      secure_memzero(newCt, sizeof(newCt));
      return true;
    }
    secure_memzero(newSeedPacked, sizeof(newSeedPacked));

    uint8_t newHdr[2 + 4 + 61 + 2];  // 24-word vault size
    size_t newP = 0;
    newHdr[newP++] = 1;
    newHdr[newP++] = wc;
    memcpy(newHdr + newP, newSalt, 4);
    newP += 4;
    memcpy(newHdr + newP, newCt, newCtLen);
    newP += newCtLen;

    uint16_t newCrc = crc16_ccitt(newHdr, newP);
    newHdr[newP++] = (newCrc >> 8) & 0xFF;
    newHdr[newP++] = newCrc & 0xFF;

    if (!nvs_save_vault(newHdr, newP)) {
#if SEEDMASK_CRYPTO_DEBUG
      Serial.println("restore_seed_from_vault_blob: Failed to save migrated AES-GCM vault");
#endif
      secure_memzero(newCt, sizeof(newCt));
      // Still return success; vault will remain legacy XOR until rewritten
      return true;
    }
    secure_memzero(newCt, sizeof(newCt));

#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("restore_seed_from_vault_blob: Legacy XOR vault migrated to AES-GCM successfully");
#endif
    return true;
  }

  // If not legacy XOR and still too small for AES-GCM, reject
  if (blen < minSizeAESGCM) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("restore_seed_from_vault_blob: ERROR - Vault too small for AES-GCM: ");
    Serial.println(blen);
#endif
    setMsg("Incompatible format - please restore again");
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("restore_seed_from_vault_blob: Vault format - blen=");
  Serial.print(blen);
  Serial.print(", wc=");
  Serial.print(wc);
  Serial.print(", seedBytesLen=");
  Serial.print(seedBytesLen);
  Serial.println();
#endif

  // AES-GCM ciphertext includes IV and tag: iv(12) + encrypted(seedBytesLen) + tag(16)
  size_t ctLen = blen - (1 + 1 + 4 + 2);  // Total - version - wc - salt - crc
  size_t expectedAesCtLen = 12 + seedBytesLen + 16;
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("restore_seed_from_vault_blob: Calculated ctLen=");
  Serial.print(ctLen);
  Serial.print(" (expected AES-GCM ctLen=");
  Serial.print(expectedAesCtLen);
  Serial.println(")");
#endif

  if (ctLen != expectedAesCtLen) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("restore_seed_from_vault_blob: Bad ciphertext length ");
    Serial.print(ctLen);
    Serial.println(" - rejecting");
#endif
    setMsg("Data corrupted");
    return false;
  }

  // Buffer large enough for max possible AES-GCM blob (iv + data + tag): 12+33+16 = 61
  uint8_t ct[65];
  memcpy(ct, buf + 6, ctLen);

  // Only allow AES-GCM decryption (secure format)
  uint8_t pt[33];               // max packed seed size (for 24 words)
  size_t ptLen = seedBytesLen;  // provide buffer capacity to decrypt into

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("restore_seed_from_vault_blob: Attempting AES-GCM decryption with ");
  Serial.print(ctLen);
  Serial.println(" bytes ciphertext");
#endif

  // aes_gcm_decrypt performs PBKDF2 internally using the provided password string
  if (!aes_gcm_decrypt(password, salt, ct, ctLen, pt, &ptLen)) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("restore_seed_from_vault_blob: AES-GCM decryption failed - wrong password or incompatible vault format");
#endif
    secure_memzero(ct, sizeof(ct));
    // Wrong password and corrupt/incompatible ciphertext are indistinguishable here; never clear NVS
    // from this path or a single bad unlock attempt would destroy the vault.
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("restore_seed_from_vault_blob: AES-GCM decryption successful");

  Serial.print("restore_seed_from_vault_blob: Decryption successful, got ");
  Serial.print(ptLen);
  Serial.println(" bytes");
#endif

  // Validate the decrypted data length
  if (ptLen != seedBytesLen) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("restore_seed_from_vault_blob: Decrypted data length mismatch");
#endif
    secure_memzero(pt, sizeof(pt));
    secure_memzero(ct, sizeof(ct));
    setMsg("Data corrupted");
    return false;
  }

  // AES-GCM provides authentication, so no additional validation needed
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("restore_seed_from_vault_blob: AES-GCM authentication successful - password correct");
#endif

  // Unpack the seed indices from decrypted data
  uint16_t idx[24];
  unpack_seed_indices(pt, wc, idx);

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("restore_seed_from_vault_blob: First 3 decrypted indices: ");
  for (int i = 0; i < 3 && i < wc; i++) {
    Serial.print(idx[i]);
    if (i < 2) Serial.print(", ");
  }
  Serial.println();
#endif

  // Validate the decrypted indices
  for (int i = 0; i < wc; i++) {
    if (idx[i] >= BIP39_WORD_COUNT) {
#if SEEDMASK_CRYPTO_DEBUG
      Serial.print("restore_seed_from_vault_blob: Invalid index ");
      Serial.print(idx[i]);
      Serial.println(" - vault corrupted");
#endif
      secure_memzero(pt, sizeof(pt));
      secure_memzero(ct, sizeof(ct));
      setMsg("Data corrupted");
      return false;
    }
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("restore_seed_from_vault_blob: All indices valid - password correct");
#endif

  for (int i = 0; i < wc; i++) {
    if (idx[i] >= BIP39_WORD_COUNT) {
      secure_memzero(pt, sizeof(pt));
      secure_memzero(ct, sizeof(ct));
      setMsg("Decode failed");
      return false;
    }
    char tmp[16];
    bip39_get_word(idx[i], tmp, sizeof(tmp));
    strncpy(outSeed[i], tmp, 15);
    outSeed[i][15] = 0;
  }

  outWc = wc;
  secure_memzero(pt, sizeof(pt));
  secure_memzero(ct, sizeof(ct));
  return true;
}

static bool vault_blob_to_code_string(const uint8_t* buf, size_t blen, char* out, size_t outLen) {
  String payload = base32_encode(buf, blen);
  String code = String("SPB1-") + group4(payload);
  if (code.length() + 1 > outLen) return false;
  strncpy(out, code.c_str(), outLen - 1);
  out[outLen - 1] = 0;
  return true;
}

// =======================
// Confirm UX: tap-in-order shuffled grid
// =======================
static uint8_t g_confirmOrder[24];
static bool g_confirmUsed[24];
static uint8_t g_confirmPos = 0;
static int8_t g_confirmFlashK = -1;
static uint32_t g_confirmFlashUntil = 0;

static int confirmCols() {
  return (g_wc == 24) ? 4 : 3;
}
static int confirmRows() {
  return (g_wc == 24) ? 6 : 4;
}

static Rect confirmBtnRect(uint8_t k) {
  int cols = confirmCols();
  int rows = confirmRows();
  int gap = 8;
  int x0 = 8;
  int y0 = 72;
  int availH = LCD_H - y0 - 24;
  int bh = (availH - (rows - 1) * gap) / rows;
  int bw = (LCD_W - 2 * x0 - (cols - 1) * gap) / cols;
  int col = k % cols;
  int row = k / cols;
  int x = x0 + col * (bw + gap);
  int y = y0 + row * (bh + gap);
  return { (int16_t)x, (int16_t)y, (int16_t)bw, (int16_t)bh };
}

static void confirmTapInit() {
  g_confirmPos = 0;
  for (int i = 0; i < 24; i++) g_confirmUsed[i] = false;
  for (int i = 0; i < g_wc; i++) g_confirmOrder[i] = (uint8_t)i;

  for (int i = g_wc - 1; i > 0; i--) {
    uint32_t r = esp_random() % (uint32_t)(i + 1);
    uint8_t t = g_confirmOrder[i];
    g_confirmOrder[i] = g_confirmOrder[r];
    g_confirmOrder[r] = t;
  }

  g_confirmFlashK = -1;
  g_confirmFlashUntil = 0;
  setMsg("Tap in seed order. Numbers appear after each correct tap.");
}

static void drawConfirmTap() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Confirm");

  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);
  gfx->setCursor(10, 44);
  gfx->printf("Step %d/%d", (int)g_confirmPos + 1, (int)g_wc);
  gfx->setCursor(10, 56);
  gfx->print(g_msg);

  uint32_t now = millis();
  bool flashActive = (g_confirmFlashK >= 0) && (now < g_confirmFlashUntil);

  int radius = (g_wc == 12) ? 14 : 8;
  int textSize = (g_wc == 12) ? 2 : 1;
  int charW = (textSize == 2) ? 12 : 6;
  int charH = (textSize == 2) ? 16 : 8;

  for (int k = 0; k < g_wc; k++) {
    uint8_t idx = g_confirmOrder[k];
    Rect r = confirmBtnRect(k);

    bool used = g_confirmUsed[idx];
    uint16_t fill = used ? RGB565_BLACK : RGB565_DARKGREY;
    if (flashActive && k == g_confirmFlashK) fill = RGB565_RED;

    gfx->fillRoundRect(r.x, r.y, r.w, r.h, radius, fill);
    gfx->drawRoundRect(r.x, r.y, r.w, r.h, radius, RGB565_WHITE);

    const char* word = g_seedGen[idx];
    int tw = (int)strlen(word) * charW;
    gfx->setTextColor(RGB565_WHITE);
    gfx->setTextSize(textSize);
    if (used) {
      char ordBuf[8];
      snprintf(ordBuf, sizeof(ordBuf), "%u", (unsigned)(idx + 1));
      const int ordGap = 2;
      const int ordCharH = 8;
      int ordW = (int)strlen(ordBuf) * 6;
      int blockH = charH + ordGap + ordCharH;
      int topY = r.y + (r.h - blockH) / 2;
      if (topY < r.y + 2) topY = r.y + 2;
      int tx = r.x + (r.w - tw) / 2;
      gfx->setCursor(tx, topY);
      gfx->print(word);
      gfx->setTextSize(1);
      gfx->setTextColor(RGB565_LIGHTGREY);
      int ox = r.x + (r.w - ordW) / 2;
      gfx->setCursor(ox, topY + charH + ordGap);
      gfx->print(ordBuf);
    } else {
      int ty = r.y + (r.h - charH) / 2;
      int tx = r.x + (r.w - tw) / 2;
      gfx->setCursor(tx, ty);
      gfx->print(word);
    }
  }

  ui_flush();
}

/** True if (x,y) is inside a shuffled word cell — must not use left-edge swipe-back (same x band as word tiles). */
static bool createConfirmTouchInWordRect(uint16_t x, uint16_t y) {
  if (g_screen != UIScreen::CREATE_CONFIRM) return false;
  for (int k = 0; k < g_wc; k++) {
    if (hit(confirmBtnRect(k), x, y)) return true;
  }
  return false;
}

// Centered QR with explicit module scale (shared by auto-fit and target-width draws).
static void drawQRCodeAtWithScale(const QrCode& qr, int qy, int border, int scale, bool invert = false) {
  int qrSize = qr.getSize();
  int qW = (qrSize + border * 2) * scale;
  int qx = (LCD_W - qW) / 2;
  const uint16_t bg565 = invert ? (uint16_t)RGB565_BLACK : (uint16_t)0xFFFF;
  const uint16_t fg565 = invert ? (uint16_t)0xFFFF : (uint16_t)RGB565_BLACK;
  gfx->fillRect(qx, qy, qW, qW, bg565);
  const uint32_t pixelCount = (uint32_t)qW * (uint32_t)qW;
  uint16_t* pix = (uint16_t*)ps_malloc(pixelCount * 2);
  if (pix) {
    for (uint32_t i = 0; i < pixelCount; i++) pix[i] = bg565;
    for (int y = 0; y < qrSize; y++) {
      for (int x = 0; x < qrSize; x++) {
        if (!qr.getModule(x, y)) continue;
        int ox = (x + border) * scale, oy = (y + border) * scale;
        for (int dy = 0; dy < scale; dy++)
          for (int dx = 0; dx < scale; dx++) {
            int px_x = ox + dx, px_y = oy + dy;
            if (px_x < qW && px_y < qW)
              pix[(uint32_t)px_y * (uint32_t)qW + (uint32_t)px_x] = fg565;
          }
      }
      yield();
    }
    gfx->draw16bitRGBBitmap(qx, qy, pix, qW, qW);
    free(pix);
  } else {
    for (int y = 0; y < qrSize; y++) {
      int py = qy + (y + border) * scale;
      int x = 0;
      while (x < qrSize) {
        if (!qr.getModule(x, y)) {
          x++;
          continue;
        }
        int xStart = x;
        while (x < qrSize && qr.getModule(x, y)) x++;
        gfx->fillRect(qx + (xStart + border) * scale, py, (x - xStart) * scale, scale, fg565);
      }
      yield();
    }
  }
}

// Match on-screen QR square size to reference pixel width (e.g. Standard SeedQR width for VIEW_SEED export).
static void drawQRCodeAtTargetWidth(const QrCode& qr, int qy, int border, int targetW, bool invert = false) {
  int qrSize = qr.getSize();
  int denom = qrSize + border * 2;
  int scale = targetW / denom;
  if (scale < 1) scale = 1;
  while (denom * scale > LCD_W && scale > 1) scale--;
  drawQRCodeAtWithScale(qr, qy, border, scale, invert);
}

// Helper: draw a QrCode at (centered, qy). Shared by text and binary QR.
// bottomReserve: pixels left empty below qy+QR for captions / buttons (default matches prior 70px gutter).
// invert: OLED-style light modules on dark field (Passport-like); default is dark modules on white.
static void drawQRCodeAt(const QrCode& qr, int qy, int border, int bottomReserve = 70, int scaleCap = 8, bool invert = false) {
  int qrSize = qr.getSize();
  int maxW = LCD_W;
  int maxH = LCD_H - qy - bottomReserve;
  int scale = min(maxW / (qrSize + border * 2), maxH / (qrSize + border * 2));
  if (scale < 2) scale = 2;
  if (scale > scaleCap) scale = scaleCap;
  drawQRCodeAtWithScale(qr, qy, border, scale, invert);
}

// Pixel width/height of QR as drawn by drawQRCodeAt (square).
static int qrCodeDrawnSize(const QrCode& qr, int qy, int border, int bottomReserve = 70, int scaleCap = 8) {
  int qrSize = qr.getSize();
  int maxW = LCD_W;
  int maxH = LCD_H - qy - bottomReserve;
  int scale = min(maxW / (qrSize + border * 2), maxH / (qrSize + border * 2));
  if (scale < 2) scale = 2;
  if (scale > scaleCap) scale = scaleCap;
  return (qrSize + border * 2) * scale;
}

static void drawWrappedLabelText(const char* s, int x0, int y0, int lineChars, int lineSkip, int yMax,
                                 uint8_t textSz = 1) {
  if (!s || !s[0]) return;
  gfx->setTextSize(textSz);
  size_t len = strlen(s);
  int y = y0;
  for (size_t off = 0; off < len && y < yMax; off += (size_t)lineChars) {
    gfx->setCursor((int16_t)x0, (int16_t)y);
    size_t chunk = len - off;
    if (chunk > (size_t)lineChars) chunk = (size_t)lineChars;
    for (size_t i = 0; i < chunk; i++) gfx->print(s[off + i]);
    y += lineSkip;
  }
}

static void drawWrappedTextCentered(const char* s, int y0, int lineChars, int lineSkip, int yMax,
                                    uint8_t textSz = 1) {
  if (!s || !s[0]) return;
  gfx->setTextSize(textSz);
  const int charW = 6 * (int)textSz;
  size_t len = strlen(s);
  int y = y0;
  for (size_t off = 0; off < len && y < yMax; off += (size_t)lineChars) {
    size_t chunk = len - off;
    if (chunk > (size_t)lineChars) chunk = (size_t)lineChars;
    int tw = (int)(chunk * charW);
    gfx->setCursor((int16_t)((LCD_W - tw) / 2), (int16_t)y);
    for (size_t i = 0; i < chunk; i++) gfx->print(s[off + i]);
    y += lineSkip;
  }
}

// Word boundaries only (no mid-word breaks); long tokens hard-break at lineChars.
static int16_t drawWrappedLabelTextWords(const char* s, int x0, int16_t y0, int lineChars, int lineSkip, int yMax,
                                         uint8_t textSz, uint16_t col) {
  if (!s || !s[0]) return y0;
  gfx->setTextSize(textSz);
  gfx->setTextColor(col);
  int y = (int)y0;
  const char* p = s;
  while (*p && y < yMax) {
    while (*p == ' ') p++;
    if (!*p) break;

    char lineBuf[96];
    int li = 0;
    lineBuf[0] = 0;

    for (;;) {
      while (*p == ' ') p++;
      if (!*p) break;
      const char* ws = p;
      while (*p && *p != ' ') p++;
      int wlen = (int)(p - ws);
      int add = (li > 0) ? (1 + wlen) : wlen;
      if (li + add > lineChars) {
        if (li == 0) {
          int emit = (wlen <= lineChars) ? wlen : lineChars;
          gfx->setCursor((int16_t)x0, (int16_t)y);
          for (int i = 0; i < emit; i++) gfx->print(ws[i]);
          y += lineSkip;
          p = ws + emit;
        } else {
          p = ws;
        }
        break;
      }
      if (li > 0) lineBuf[li++] = ' ';
      memcpy(lineBuf + li, ws, (size_t)wlen);
      li += wlen;
      lineBuf[li] = 0;
    }

    if (li > 0) {
      gfx->setCursor((int16_t)x0, (int16_t)y);
      gfx->print(lineBuf);
      y += lineSkip;
    }
  }
  return (int16_t)y;
}

// Orange path/value then white description; continuation lines align to x0 (full width).
static int16_t drawAddrHelpValueThenWhiteDesc(const char* valOrange, const char* descWhite, int16_t y, int x0,
                                              int lineSkip, int yMax, uint8_t textSz, uint16_t orangeCol) {
  if (!descWhite) descWhite = "";
  gfx->setTextSize(textSz);
  const int charW = 6 * (int)textSz;
  const int maxX = LCD_W - 8;
  int vlen = valOrange ? (int)strlen(valOrange) : 0;

  gfx->setTextColor(orangeCol);
  gfx->setCursor((int16_t)x0, (int16_t)y);
  for (int i = 0; i < vlen; i++) gfx->print(valOrange[i]);

  int x = x0 + vlen * charW;
  if (vlen > 0) x += charW;
  gfx->setTextColor(RGB565_WHITE);

  const char* p = descWhite;
  while (*p && y < yMax) {
    while (*p == ' ') {
      p++;
      if (!*p) break;
      if (x + charW > maxX) {
        y += lineSkip;
        x = x0;
      } else {
        gfx->setCursor((int16_t)x, (int16_t)y);
        gfx->print(' ');
        x += charW;
      }
    }
    if (!*p) break;

    const char* wend = p;
    while (*wend && *wend != ' ') wend++;
    int wlen = (int)(wend - p);

    if (x + wlen * charW > maxX) {
      if (x > x0) {
        y += lineSkip;
        x = x0;
      } else if (wlen * charW > maxX - x0) {
        int maxFit = (maxX - x0) / charW;
        if (maxFit < 1) maxFit = 1;
        gfx->setCursor((int16_t)x0, (int16_t)y);
        for (int i = 0; i < maxFit && i < wlen; i++) gfx->print(p[i]);
        y += lineSkip;
        p += maxFit;
        x = x0;
        continue;
      }
    }
    gfx->setCursor((int16_t)x, (int16_t)y);
    for (int i = 0; i < wlen; i++) gfx->print(p[i]);
    x += wlen * charW;
    p = wend;
  }
  return (int16_t)(y + lineSkip + 6);
}

// Use ECC_QUARTILE+ for PSBT/base64 scans: phone cameras often misread ECC_LOW QRs → Sparrow
// "Cannot parse QR code into a transaction or PSBT".
static void drawQRAt(const char* text, int qy, int border = 2, QrCode::Ecc ecc = QrCode::Ecc::ECC_LOW) {
  if (!text || !text[0]) return;
  const QrCode& qr = QrCode::encodeText(text, ecc);
  drawQRCodeAt(qr, qy, border);
}

static void drawQRAtBytes(const uint8_t* data, size_t len, int qy, int border = 2) {
  if (!data || len == 0) return;
  const QrCode& qr = QrCode::encodeBinary(data, len, QrCode::Ecc::ECC_LOW);
  drawQRCodeAt(qr, qy, border);
}

static void drawQR(const char* text, int border = 2, const char* title = nullptr) {
  if (!text || !text[0]) return;
  gfx->fillScreen(0x0000);
  drawTopBar(title ? title : "QR Backup", true);
  drawQRAt(text, 56, border);
  drawBtn(BTN_VIEWQR_BACK, "BACK", 0x8410, 2);
  drawBtn(BTN_VIEWQR_DONE, "DONE", 0x8410, 2);
  ui_flush();
}

static bool is_ur_psbt_scan(const char* s) {
  if (!s) return false;
  return strncasecmp(s, "ur:crypto-psbt/", 15) == 0 || strncasecmp(s, "ur:psbt/", 8) == 0
         || strncasecmp(s, "ur:bytes/", 9) == 0;
}

static void crypto_set_signed_ur_type_from_scan(const char* scannedUr) {
  if (!scannedUr || !scannedUr[0]) return;
  if (strncasecmp(scannedUr, "ur:crypto-psbt/", 15) == 0) {
    strncpy(g_cryptoSignedUrRegistryType, "crypto-psbt", sizeof(g_cryptoSignedUrRegistryType) - 1);
  } else if (strncasecmp(scannedUr, "ur:psbt/", 8) == 0) {
    strncpy(g_cryptoSignedUrRegistryType, "psbt", sizeof(g_cryptoSignedUrRegistryType) - 1);
  } else {
    // ur:bytes/ or unknown prefix — emit like Passport / Sparrow default PSBT UR
    strncpy(g_cryptoSignedUrRegistryType, "crypto-psbt", sizeof(g_cryptoSignedUrRegistryType) - 1);
  }
  g_cryptoSignedUrRegistryType[sizeof(g_cryptoSignedUrRegistryType) - 1] = 0;
}

// Encode signed PSBT using Blockchain Commons bc-ur (Passport-style: echo g_cryptoSignedUrRegistryType).
// Retries with smaller fountain fragments until the UR fits our QR encoder (v16 max ~560 chars at ECC-L export).
static size_t bc_ur_initial_frag_for_payload(size_t payloadLen) {
  // Start closer to a fitting fragment so we rarely re-run begin()/next_part().
  if (payloadLen <= 350) return 200u;
  if (payloadLen <= 800) return 140u;
  if (payloadLen <= 1600) return 100u;
  if (payloadLen <= 3200) return 70u;
  return 50u;
}

static bool crypto_build_signed_psbt_ur(const uint8_t* psbt, size_t len) {
  if (!psbt || len == 0) return false;
  const size_t kBuf = CRYPTO_PSBT_SIGNED_UR_BYTES;
  const size_t kMaxUri = (size_t)SP_BC_UR_QR_MAX_URI_CHARS;
  size_t frag = bc_ur_initial_frag_for_payload(len);
  if (frag > (size_t)SP_BC_UR_MAX_FRAGMENT_LEN) frag = (size_t)SP_BC_UR_MAX_FRAGMENT_LEN;
  if (frag < 40) frag = 40;
  while (frag >= 40) {
    seedmask_bc_ur_reset();
    if (!seedmask_bc_ur_begin_psbt_ex(psbt, len, frag, g_cryptoSignedUrRegistryType)) {
      seedmask_bc_ur_reset();
      return false;
    }
    if (!seedmask_bc_ur_next_part(g_cryptoPsbtSignedUr, kBuf)) {
      seedmask_bc_ur_reset();
      return false;
    }
    size_t slen = strlen(g_cryptoPsbtSignedUr);
    if (slen <= kMaxUri) {
      g_cryptoHasSigned = true;
      g_cryptoBcUrFountain = !seedmask_bc_ur_is_single_part();
      g_cryptoSignedQrAnimPaused = false;
      g_cryptoSignedQrLastAnimMs = millis();
      return true;
    }
    if (frag <= 40) break;
    frag = (frag * 3) / 4;
    if (frag < 40) frag = 40;
  }
  seedmask_bc_ur_reset();
  return false;
}

// Decode scanned UR → sign PSBT on-device (segwit-v0 + SIGHASH_ALL) → BC-UR signed output.
static void crypto_build_signed_psbt_from_scanned() {
  if (!g_psbtParserSelftestRan || !g_psbtSigningSelftestRan) {
    setMsg("Wait: PSBT self-test still running");
    return;
  }
  if (!g_psbtParserSelftestOk) {
    setMsg(g_psbtParserSelftestErr[0] ? g_psbtParserSelftestErr : "PSBT self-test failed");
    return;
  }
  if (!g_psbtSigningSelftestOk) {
    setMsg(g_psbtSigningSelftestErr[0] ? g_psbtSigningSelftestErr : "PSBT signer self-test failed");
    return;
  }
  char err[128] = { 0 };
  size_t decLen = 0;
  const size_t kBufCap = 65536;
  uint8_t* psbtWork = (uint8_t*)malloc(kBufCap);
  uint8_t* psbtSignedWork = (uint8_t*)malloc(kBufCap);
  if (!psbtWork || !psbtSignedWork) {
    if (psbtWork) {
      secure_memzero(psbtWork, kBufCap);
      free(psbtWork);
    }
    if (psbtSignedWork) {
      secure_memzero(psbtSignedWork, kBufCap);
      free(psbtSignedWork);
    }
    setMsg("Out of memory");
    return;
  }
  g_cryptoHasSigned = false;
  g_cryptoPsbtSignedUr[0] = 0;
  seedmask_bc_ur_reset();
  if (!g_cryptoPsbtDecodedBuf || g_cryptoPsbtDecodedLen == 0) {
    secure_memzero(psbtWork, kBufCap);
    secure_memzero(psbtSignedWork, kBufCap);
    free(psbtWork);
    free(psbtSignedWork);
    setMsg("No PSBT loaded");
    return;
  }
  if (g_cryptoPsbtDecodedLen > kBufCap) {
    secure_memzero(psbtWork, kBufCap);
    secure_memzero(psbtSignedWork, kBufCap);
    free(psbtWork);
    free(psbtSignedWork);
    setMsg("PSBT too large");
    return;
  }
  memcpy(psbtWork, g_cryptoPsbtDecodedBuf, g_cryptoPsbtDecodedLen);
  decLen = g_cryptoPsbtDecodedLen;
  uint8_t activeWc = 0;
  const char(*activeWords)[16] = active_crypto_seed_words(&activeWc);
  char mnemonic[256];
  if (!build_mnemonic_string(activeWords, activeWc, mnemonic, sizeof(mnemonic))) {
    secure_memzero(psbtWork, kBufCap);
    secure_memzero(psbtSignedWork, kBufCap);
    free(psbtWork);
    free(psbtSignedWork);
    setMsg("mnemonic");
    return;
  }
  size_t signedLen = 0;
  if (!seedmask_psbt_sign_with_mnemonic(psbtWork, decLen, mnemonic, activeWc,
                                        g_bip39HasPassphrase ? g_bip39Passphrase : "",
                                        psbtSignedWork, &signedLen,
                                        kBufCap, err, sizeof(err))) {
    secure_memzero(mnemonic, sizeof(mnemonic));
    secure_memzero(psbtWork, kBufCap);
    secure_memzero(psbtSignedWork, kBufCap);
    free(psbtWork);
    free(psbtSignedWork);
    setMsg(err[0] ? err : "Sign failed");
    return;
  }
  secure_memzero(mnemonic, sizeof(mnemonic));
  secure_memzero(psbtWork, kBufCap);
  crypto_store_signed_psbt_bin(psbtSignedWork, signedLen);
  if (crypto_build_signed_psbt_ur(psbtSignedWork, signedLen)) {
    secure_memzero(psbtSignedWork, kBufCap);
    free(psbtWork);
    free(psbtSignedWork);
    setMsg("");
    return;
  }
  base64_encode(psbtSignedWork, signedLen, g_cryptoPsbtSignedUr);
  secure_memzero(psbtSignedWork, kBufCap);
  free(psbtWork);
  free(psbtSignedWork);
  g_cryptoHasSigned = true;
  g_cryptoBcUrFountain = false;
  g_cryptoSignedQrAnimPaused = false;
  g_cryptoSignedQrLastAnimMs = millis();
  setMsg("");
}

// Compact SeedQR (Passport / SeedSigner): raw entropy bytes only (checksum bits omitted from tail).
// Standard SeedQR (SeedSigner): concatenated decimal indices, each word zero-padded to 4 digits (0000–2047).
// Plain text: space-separated English words — same QR payload style as Crypto → BIP85 → QR (encodeText).
// Single draw (no deferred pass) avoids flicker. ECC-L.
// Compact + Plain text use the same on-screen square size as Standard SeedQR (digit indices).
// QR is centered horizontally (in drawQRCodeAt*) and vertically in the band below the top bar (no on-screen buttons; swipe back).
static void drawSeedQRActualContent() {
  const int bandTop = 46;  // below accent under top bar
  const int bandH = LCD_H - bandTop - 8;
  const QrCode& qrStd = QrCode::encodeNumericDigits(g_seedQrStandardDigits, QrCode::Ecc::ECC_LOW);
  const int border = 2;
  const int denomStd = qrStd.getSize() + border * 2;
  int scaleStd = min(LCD_W / denomStd, bandH / denomStd);
  if (scaleStd < 2) scaleStd = 2;
  if (scaleStd > 8) scaleStd = 8;
  const int seedQrPixelW = denomStd * scaleStd;
  const int seedQrY = bandTop + (bandH - seedQrPixelW) / 2;

  if (g_viewSeedQrKind == ViewSeedQrKind::STANDARD) {
    drawQRCodeAtWithScale(qrStd, seedQrY, border, scaleStd);
  } else if (g_viewSeedQrKind == ViewSeedQrKind::PLAINTEXT) {
    const QrCode& qr = QrCode::encodeText(g_viewSeedMnemonicQrText, QrCode::Ecc::ECC_LOW);
    drawQRCodeAtTargetWidth(qr, seedQrY, border, seedQrPixelW);
  } else {
    const QrCode& qr = QrCode::encodeBinary(g_seedQrCompact, g_seedQrLen, QrCode::Ecc::ECC_LOW);
    drawQRCodeAtTargetWidth(qr, seedQrY, border, seedQrPixelW);
  }
  ui_flush();
}

static void drawSeedQR() {
  uint8_t wc = 0;
  const char(*seedWords)[16] = active_crypto_seed_words(&wc);
  memset(g_seedQrCompact, 0, sizeof(g_seedQrCompact));
  memset(g_seedQrStandardDigits, 0, sizeof(g_seedQrStandardDigits));
  uint16_t idx[24];
  for (int i = 0; i < wc; i++) {
    int16_t fi = bip39_find_index_ci(seedWords[i]);
    if (fi < 0 || fi >= 2048) return;
    idx[i] = (uint16_t)fi;
  }
  uint8_t packed[33];
  memset(packed, 0, sizeof(packed));
  if (!pack_seed_indices(idx, wc, packed, sizeof(packed))) return;
  g_seedQrLen = (uint8_t)((wc == 12) ? 16 : 32);
  memcpy(g_seedQrCompact, packed, g_seedQrLen);

  char* p = g_seedQrStandardDigits;
  const char* end = g_seedQrStandardDigits + sizeof(g_seedQrStandardDigits);
  for (int i = 0; i < wc; i++) {
    int n = snprintf(p, (size_t)(end - p), "%04u", (unsigned)idx[i]);
    if (n <= 0 || p + n >= end) return;
    p += n;
  }
  *p = 0;

  memset(g_viewSeedMnemonicQrText, 0, sizeof(g_viewSeedMnemonicQrText));
  for (uint8_t i = 0; i < wc && i < 24; i++) {
    if (i) strlcat(g_viewSeedMnemonicQrText, " ", sizeof(g_viewSeedMnemonicQrText));
    strlcat(g_viewSeedMnemonicQrText, seedWords[i], sizeof(g_viewSeedMnemonicQrText));
  }

  gfx->fillScreen(RGB565_BLACK);
  const char* barTitle = "Compact SeedQR";
  if (g_viewSeedQrKind == ViewSeedQrKind::STANDARD) {
    barTitle = g_tempSeedActive ? "SeedQR (temp)" : "SeedQR";
  } else if (g_viewSeedQrKind == ViewSeedQrKind::PLAINTEXT) {
    barTitle = g_tempSeedActive ? "Plain text (temp)" : "Plain text";
  } else {
    barTitle = g_tempSeedActive ? "Compact SeedQR (temp)" : "Compact SeedQR";
  }
  drawTopBar(barTitle, true);
  drawSeedQRActualContent();
}

static void drawVaultQR() {
  if (g_vaultQrPartCount <= 1) {
    drawQR(g_vaultQrPayload);
    return;
  }
  const char* text = g_vaultQrPayloadParts[g_vaultQrPartIndex];
  if (!text || !text[0]) return;
  drawQR(text);
  gfx->setTextColor(RGB565_CYAN);
  gfx->setTextSize(1);
  gfx->setCursor(10, 44);
  gfx->printf("Part %u/%u - Scan each", (unsigned)(g_vaultQrPartIndex + 1), (unsigned)g_vaultQrPartCount);
  bool lastPart = (g_vaultQrPartIndex >= g_vaultQrPartCount - 1);
  drawBtn(BTN_VIEWQR_DONE, lastPart ? "DONE" : "NEXT", 0x8410, 2);
  ui_flush();
}

static void handleVaultQRTap(uint16_t x, uint16_t y) {
  if (hit(BTN_VIEWQR_BACK, x, y)) {
    show(g_viewQrBackupReturnScreen);
    return;
  }
  if (hit(BTN_VIEWQR_DONE, x, y)) {
    if (g_vaultQrPartCount > 1 && g_vaultQrPartIndex < g_vaultQrPartCount - 1) {
      g_vaultQrPartIndex++;
      draw();
    } else {
      show(g_viewQrBackupReturnScreen);
    }
    return;
  }
}
