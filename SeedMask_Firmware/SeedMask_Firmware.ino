// Swipe-back: perform the same action as the back button for the current screen
static void performSwipeBack() {
  if (g_editMode != EditMode::NONE) {
    if (!g_loggedIn) {
      exitEditor();
      if (session_should_show_lock_screen()) show(UIScreen::LOCKED);
      else show(UIScreen::HOME);
      g_touchIgnoreUntil = millis() + 220;
      return;
    }
    // In password edit focused-field mode, swipe-back should return to details view first.
    if (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && g_pwEditFocusField >= 1 && g_pwEditFocusField <= 5) {
      pwEditCollapseFocusedFieldToBrowse();
      // Consume this swipe so the same gesture cannot immediately trigger a second back action.
      g_touchIgnoreUntil = millis() + 260;
      g_lastTapMs = millis();
      g_touchReleasedSinceTap = false;
      draw();
      return;
    }
    if (g_editMode == EditMode::EDIT_PW_VALUE && pwEditHasUnsavedChanges()) {
      g_pwEditExitPrompt = true;
      draw();
      return;
    }
    exitEditor();
    show(g_prevScreen);
    g_touchIgnoreUntil = millis() + 220;  // prevent post-swipe accidental tap on next screen
    return;
  }
  switch (g_screen) {
    case UIScreen::BURGER_MENU:
      show(g_optionsHomeScreen);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SEED_SETTINGS:
      show(UIScreen::BURGER_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::DEVICE_SETTINGS:
      show(UIScreen::BURGER_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::DEVICE_BRIGHTNESS:
      show(UIScreen::DEVICE_SETTINGS);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::DEVICE_RENAME:
      show(UIScreen::DEVICE_SETTINGS);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SD_FILE_RENAME:
      show(g_sdRenameReturnScreen);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::DEVICE_AUTO_SHUTDOWN:
    case UIScreen::DEVICE_AUTO_LOCK:
    case UIScreen::DEVICE_LANGUAGE:
    case UIScreen::DEVICE_HID:
    case UIScreen::DEVICE_NAV_BAR:
      show(UIScreen::DEVICE_SETTINGS);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::DEVICE_NAV_BAR_INFO:
      show(UIScreen::DEVICE_NAV_BAR);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::WIPE_CONFIRM:
      setMsg("");
      show(g_wipeConfirmReturnScreen);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::WIPE_INFO:
      show(UIScreen::WIPE_CONFIRM);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_NEW_ACCOUNT_INFO:
      show(UIScreen::CRYPTO_NEW_ACCOUNT);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_PASSPHRASE_INFO:
      show(g_passphraseInfoReturnScreen);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_BIP85_INFO:
      show(g_bip85InfoReturnScreen);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_DURESS_TYPE_INFO:
      show(g_duressTypeInfoReturnScreen);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_LOCK_ATTEMPTS_INFO:
      show(UIScreen::SECURITY_LOCK_ATTEMPTS);
      g_touchIgnoreUntil = millis() + 220;
      break;
#if SEEDMASK_NOTE_SEND_UI
    case UIScreen::SECURITY_SENDING:
      setMsg("");
      show(UIScreen::SECURITY_MENU);
      g_touchIgnoreUntil = millis() + 220;
