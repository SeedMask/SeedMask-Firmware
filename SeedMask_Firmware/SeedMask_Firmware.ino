static bool btc_load_singlesig_xpub_export(AddrType t, uint32_t account) {
  crypto_xpub_clear_bufs();
  char xpub[112];
  if (!btc_account_xpub(t, account, xpub, sizeof(xpub))) return false;
  strncpy(g_cryptoXpubBuf, xpub, sizeof(g_cryptoXpubBuf) - 1);
  g_cryptoXpubBuf[sizeof(g_cryptoXpubBuf) - 1] = 0;
  if (!btc_singlesig_qr_scan_payload(t, account, xpub, g_cryptoXpubQrPayload, sizeof(g_cryptoXpubQrPayload))) {
    crypto_xpub_clear_bufs();
    secure_memzero(xpub, sizeof(xpub));
    return false;
  }
  secure_memzero(xpub, sizeof(xpub));
  return true;
}

// Multisig Export xpub: keep SM|xfp|deriv|xpub QR in sync when switching Native/Nested/Legacy.
static bool btc_load_multisig_xpub_export(AddrType t, uint32_t account) {
  crypto_xpub_clear_bufs();
  if (!btc_multisig_xpub(t, account, g_cryptoXpubBuf, sizeof(g_cryptoXpubBuf))) {
    crypto_xpub_clear_bufs();
    return false;
  }
  if (!btc_multisig_qr_scan_payload(t, account, g_cryptoXpubBuf, g_cryptoXpubQrPayload,
                                    sizeof(g_cryptoXpubQrPayload))) {
    crypto_xpub_clear_bufs();
    return false;
  }
  return true;
}

// BIP84 account node m/84'/0'/account' as classic xpub (Electrum ckcc_xpub) or zpub (BlueWallet keystore xpub) — same as Passport serialize_public(AF_CLASSIC) vs AF_P2WPKH.
