static bool duress_type_save_pin_for_target(const char* pin6) {
  DuressTypeSlot* slot = duress_slot_for(g_duressSetupTarget);
  if (!slot || !duress_type_pin_wrap_save(slot, pin6)) return false;
  duress_slot_save_nvs(g_duressSetupTarget, slot);
  if (g_duressSetupTarget == DuressBehavior::DECOY_VAULT && g_loggedIn && (g_wc == 12 || g_wc == 24)) {
    uint8_t key[32];
    if (!pbkdf2_sha256((const uint8_t*)pin6, 6, slot->salt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
      return false;
    bool sealed = duress_decoy_seal_with_key(key);
    secure_memzero(key, sizeof(key));
    if (!sealed) return false;
  }
  return true;
}

static bool duress_type_save_pw_for_target(const char* lockPw) {
  DuressTypeSlot* slot = duress_slot_for(g_duressSetupTarget);
  if (!slot || !duress_type_pw_wrap_save(slot, lockPw)) return false;
  duress_slot_save_nvs(g_duressSetupTarget, slot);
  if (g_duressSetupTarget == DuressBehavior::DECOY_VAULT && g_loggedIn && (g_wc == 12 || g_wc == 24)) {
    uint8_t key[32];
    size_t lpLen = strlen(lockPw);
    if (!pbkdf2_sha256((const uint8_t*)lockPw, lpLen, slot->salt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
      return false;
    bool sealed = duress_decoy_seal_with_key(key);
    secure_memzero(key, sizeof(key));
    if (!sealed) return false;
  }
  return true;
}

