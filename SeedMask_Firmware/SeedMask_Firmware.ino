static void wallet_context_enter_temporary() {
  if (g_bip39HasPassphrase && g_passphraseVaultSnapshotValid) {
    g_masterVaultPwSnapshot = g_passphraseVaultPwSnapshot;
    g_masterVaultNotesSnapshot = g_passphraseVaultNotesSnapshot;
    g_masterVaultTotpSnapshot = g_passphraseVaultTotpSnapshot;
  } else {
    wallet_context_capture_current(g_masterVaultPwSnapshot, g_masterVaultNotesSnapshot, g_masterVaultTotpSnapshot);
  }
  g_masterVaultSnapshotValid = true;
  crypto_accounts_capture_active_addr();
  memcpy(g_masterBtcAccountListSnapshot, g_btcAccountList, sizeof(g_btcAccountList));
  memcpy(g_masterBtcAccountNameListSnapshot, g_btcAccountNameList, sizeof(g_btcAccountNameList));
  g_masterBtcAccountListCountSnapshot = g_btcAccountListCount;
  memcpy(g_masterKaspaAccountListSnapshot, g_kaspaAccountList, sizeof(g_kaspaAccountList));
  memcpy(g_masterKaspaAccountNameListSnapshot, g_kaspaAccountNameList, sizeof(g_kaspaAccountNameList));
  g_masterKaspaAccountListCountSnapshot = g_kaspaAccountListCount;
  g_masterBtcAddrAccountSnapshot = g_btcAddrAccount;
  g_masterKaspaAddrAccountSnapshot = g_kaspaAddrAccount;
  g_masterAccountsSnapshotValid = true;
  // Temporary wallet starts with default account only (both coins).
  memset(g_btcAccountList, 0, sizeof(g_btcAccountList));
  memset(g_btcAccountNameList, 0, sizeof(g_btcAccountNameList));
  g_btcAccountList[0] = 0;
  btc_account_default_name(0, g_btcAccountNameList[0]);
  g_btcAccountListCount = 1;
  g_btcAddrAccount = 0;
  memset(g_kaspaAccountList, 0, sizeof(g_kaspaAccountList));
  memset(g_kaspaAccountNameList, 0, sizeof(g_kaspaAccountNameList));
  g_kaspaAccountList[0] = 0;
  btc_account_default_name(0, g_kaspaAccountNameList[0]);
  g_kaspaAccountListCount = 1;
  g_kaspaAddrAccount = 0;
  g_addrAccount = 0;
  g_addrStatusMarkedCount = 0;
  wallet_context_apply_snapshots(String(), String(), String());
  invalidate_address_explorer_cache();
  multisig_invalidate_visible_list();
  multisig_clamp_settings_scroll();
}
static void wallet_context_exit_temporary() {
  if (g_masterVaultSnapshotValid) {
    wallet_context_apply_snapshots(g_masterVaultPwSnapshot, g_masterVaultNotesSnapshot, g_masterVaultTotpSnapshot);
  } else {
    // Fallback if no snapshot available (should be rare): reload persisted master vault state.
    pwSvc_clearAll();
    g_noteCount = 0;
    g_totpCount = 0;
    if (g_noteItems) memset(g_noteItems, 0, NOTE_ITEMS_TOTAL_BYTES);
    memset(g_totpItems, 0, sizeof(g_totpItems));
    if (g_masterPw[0]) load_passwords_notes_from_nvs(g_masterPw);
  }
  if (g_masterAccountsSnapshotValid) {
    memcpy(g_btcAccountList, g_masterBtcAccountListSnapshot, sizeof(g_btcAccountList));
    memcpy(g_btcAccountNameList, g_masterBtcAccountNameListSnapshot, sizeof(g_btcAccountNameList));
    g_btcAccountListCount = g_masterBtcAccountListCountSnapshot;
    memcpy(g_kaspaAccountList, g_masterKaspaAccountListSnapshot, sizeof(g_kaspaAccountList));
    memcpy(g_kaspaAccountNameList, g_masterKaspaAccountNameListSnapshot, sizeof(g_kaspaAccountNameList));
    g_kaspaAccountListCount = g_masterKaspaAccountListCountSnapshot;
    g_btcAddrAccount = g_masterBtcAddrAccountSnapshot;
    g_kaspaAddrAccount = g_masterKaspaAddrAccountSnapshot;
    crypto_accounts_sync_runtime_addr();
  } else {
    crypto_accounts_load_all();
  }
  invalidate_address_explorer_cache();
  multisig_invalidate_visible_list();
  multisig_clamp_settings_scroll();
  if (g_bip39HasPassphrase) {
    wallet_context_capture_current(g_passphraseVaultPwSnapshot, g_passphraseVaultNotesSnapshot, g_passphraseVaultTotpSnapshot);
    g_passphraseVaultSnapshotValid = true;
    wallet_context_apply_snapshots(String(), String(), String());
  }
}
