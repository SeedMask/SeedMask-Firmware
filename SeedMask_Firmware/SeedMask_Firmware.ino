static const int kBurgerMenuIconBox = 44;

/** Rounded “smartphone” glyph: tall portrait frame + bright inner panel (lit LCD), notch + home bar. */
static void burgerMenuDrawDeviceIcon(int16_t ix, int16_t iy) {
  const uint16_t frame = blendRGB565(RGB565(48, 52, 58), RGB565(12, 14, 18), 0.42f);
  const uint16_t frameEdge = blendRGB565(frame, RGB565_WHITE, 0.2f);
  const uint16_t bezelLine = blendRGB565(frame, RGB565_BLACK, 0.5f);
  const uint16_t screenLit = blendRGB565(RGB565(195, 202, 218), RGB565(130, 160, 215), 0.35f);
  const uint16_t screenHi = blendRGB565(screenLit, RGB565_WHITE, 0.42f);
  const uint16_t notch = RGB565_BLACK;
  const uint16_t statusDim = blendRGB565(screenLit, RGB565(35, 42, 58), 0.35f);

  const int ox = ix + 4;
  const int oy = iy + 2;
  const int ow = 36;
  const int oh = 40;
  const int fr = 9;
  gfx->fillRoundRect(ox, oy, ow, oh, fr, frame);
  gfx->drawRoundRect(ox, oy, ow, oh, fr, frameEdge);
  gfx->drawRoundRect(ox + 1, oy + 1, ow - 2, oh - 2, max(6, fr - 1), bezelLine);

  const int sx = ox + 3;
  const int sy = oy + 3;
  const int sw = ow - 6;
  const int sh = oh - 6;
  const int sr = max(4, fr - 4);
  gfx->fillRoundRect(sx, sy, sw, sh, sr, screenLit);
  gfx->drawRoundRect(sx, sy, sw, sh, sr, screenHi);
  gfx->fillRect(sx + 1, sy + 1, sw - 2, max(4, sh / 8), statusDim);
  gfx->fillRoundRect(sx + sw / 2 - 8, sy + 3, 16, 5, 3, notch);
  gfx->fillRoundRect(sx + sw / 2 - 9, sy + sh - 5, 18, 3, 2, blendRGB565(screenLit, RGB565_WHITE, 0.45f));
}

/** Padlock only (gold/silver); scales inside `kBurgerMenuIconBox`. */
static void burgerMenuDrawSecurityIcon(int16_t ix, int16_t iy) {
  const int S = 40;
  const int o = (kBurgerMenuIconBox - S) / 2;
  burgerMenuDrawMiniLockIcon(ix + o, iy + o, S);
}

/** UXWing green leaf (36×36 art centered in `kBurgerMenuIconBox`): two `drawBitmap1bpp` passes, same 1bpp pattern as other burger glyphs. */
static void burgerMenuDrawSeedSettingsIcon(int16_t ix, int16_t iy) {
  const uint16_t uxLight = RGB565(137, 191, 63);  // #89BF3F
  const uint16_t uxDark = RGB565(76, 167, 30);    // #4CA71E
  const int o = (kBurgerMenuIconBox - BURGER_LEAF_UXW_W) / 2;
  drawBitmap1bpp((int16_t)(ix + o), (int16_t)(iy + o), BURGER_LEAF_UXW_LIGHT_BMP, BURGER_LEAF_UXW_W, BURGER_LEAF_UXW_H, uxLight);
  drawBitmap1bpp((int16_t)(ix + o), (int16_t)(iy + o), BURGER_LEAF_UXW_DARK_BMP, BURGER_LEAF_UXW_W, BURGER_LEAF_UXW_H, uxDark);
}

/** Left edge of icon artwork (10px left of prior −13 offset). */
static int burgerMenuIconLeftX(const Rect& r) {
  const int padL = 10;
  return r.x + padL - 23;
}

/** Translucent row flash: widen left so highlight covers the icon (icons start ~13px left of `r.x`). */
static Rect burgerMenuRowFlashRect(const Rect& r) {
  const int extendLeft = 18;
  return { (int16_t)(r.x - extendLeft), r.y, (int16_t)(r.w + extendLeft), r.h };
}

/** Labels share one column so first glyphs align (44px icon band for all three rows). */
static int burgerMenuLabelColumnX(const Rect& r) {
  return burgerMenuIconLeftX(r) + kBurgerMenuIconBox + 6;
}

/** Frozen `>` column: keep reference geometry (−13 + leaf-width gap) so chevrons do not shift when icons move. */
static int16_t burgerMenuChevronColumnX() {
  const Rect& r = BTN_MENU_SEED_SETTINGS;
  const int padL = 10;
  const int iconXRef = r.x + padL - 13;
  const int textXRef = iconXRef + SEED_LEAF_ICON_W + 6;
  const int textY = r.y + (r.h - 16) / 2;
  int16_t bx, by;
  uint16_t bw, bh;
  gfx->setTextSize(2);
  gfx->getTextBounds("Seed Settings", (int16_t)textXRef, (int16_t)textY, &bx, &by, &bw, &bh);
  return (int16_t)(bx + (int16_t)bw + 40);
}

static void burgerMenuDrawLabelWithChevron(const char* label, int textX, int textY, int16_t chevronX) {
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  gfx->setCursor((int16_t)textX, (int16_t)textY);
  gfx->print(label);
  gfx->setCursor(chevronX, (int16_t)textY);
  gfx->setTextSize(2);
  gfx->print(">");
}

static void burgerMenuDrawDeviceRow(const Rect& r, int16_t chevronX) {
  const int iconBox = kBurgerMenuIconBox;
  const int iconX = burgerMenuIconLeftX(r);
  const int iconY = r.y + (r.h - iconBox) / 2;
  burgerMenuDrawDeviceIcon((int16_t)iconX, (int16_t)iconY);
  const int textX = burgerMenuLabelColumnX(r);
  const int textY = r.y + (r.h - 16) / 2;
  burgerMenuDrawLabelWithChevron("Device", textX, textY, chevronX);
}

static void burgerMenuDrawSecurityRow(const Rect& r, int16_t chevronX) {
  const int iconBox = kBurgerMenuIconBox;
  const int iconX = burgerMenuIconLeftX(r);
  const int iconY = r.y + (r.h - iconBox) / 2;
  burgerMenuDrawSecurityIcon((int16_t)iconX, (int16_t)iconY);
  const int textX = burgerMenuLabelColumnX(r);
  const int textY = r.y + (r.h - 16) / 2;
  burgerMenuDrawLabelWithChevron("Security", textX, textY, chevronX);
}

static void drawBurgerMenu() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Options", true);

  const int16_t burgerChevronX = burgerMenuChevronColumnX();

  if (burgerMenuHideSeedAndSecurity()) {
    burgerMenuDrawDeviceRow(BTN_MENU_DEVICE_COMPACT, burgerChevronX);
    drawBtn(BTN_MENU_SETTIME_COMPACT, "SET TIME (for 2FA)", RGB565_DARKGREY);
  } else {
    // Sprouting-seed icon + label; keep BTN_MENU_SEED_SETTINGS hitbox for taps.
    {
      const Rect& r = BTN_MENU_SEED_SETTINGS;
      const int iconX = burgerMenuIconLeftX(r);
      const int iconY = r.y + (r.h - kBurgerMenuIconBox) / 2;
      burgerMenuDrawSeedSettingsIcon((int16_t)iconX, (int16_t)iconY);
      const char* t = "Seed Settings";
      const int textX = burgerMenuLabelColumnX(r);
      const int textY = r.y + (r.h - 16) / 2;
      burgerMenuDrawLabelWithChevron(t, textX, textY, burgerChevronX);
    }
    burgerMenuDrawDeviceRow(BTN_MENU_DEVICE, burgerChevronX);
    if (!burgerMenuHideSecurity())
      burgerMenuDrawSecurityRow(BTN_MENU_SECURITY, burgerChevronX);
    drawBtn(burgerMenuSetTimeBtnRect(), "SET TIME (for 2FA)", RGB565_DARKGREY);
  }

  drawSwipeBackHintOverlay();
  ui_flush();
}

static void drawPasswordsAppIcon(int x, int y, int s, uint16_t accent, uint16_t bg) {
  (void)accent;
  if (s <= 0) return;
  const bool darkTile = (bg == RGB565_BLACK || bg == mainMenuDarkCardTile565());
  const int rad = max(10, (s * 10) / 72);
  // Body / face gold + slight silver = cooler premium metal (not toy yellow).
  const uint16_t lockGold = blendRGB565(
    blendRGB565(blendRGB565(RGB565_GOLD, RGB565_DARKGREY, 0.10f), RGB565_SILVER, 0.05f),
    RGB565_WHITE, 0.07f);
  const uint16_t goldEdge = blendRGB565(blendRGB565(RGB565_GOLD, RGB565_BLACK, 0.36f), RGB565_DARKGREY, 0.16f);
  const uint16_t keyholeBronze = blendRGB565(blendRGB565(RGB565_GOLD, RGB565_BLACK, 0.62f), RGB565_DARKGREY, 0.12f);
  const uint16_t cutCol = bg;
  const uint16_t keyholeCol = keyholeBronze;
  const uint16_t hi = blendRGB565(lockGold, RGB565_WHITE, 0.42f);
  const uint16_t specSheen = blendRGB565(lockGold, RGB565_WHITE, 0.52f);
  // Shackle: mirror lock body recipe — SILVER/DARKGREY/WHITE + trace GOLD (body has trace SILVER) so both metals match.
  const uint16_t shackleFill = blendRGB565(
    blendRGB565(blendRGB565(RGB565_SILVER, RGB565_DARKGREY, 0.10f), RGB565_GOLD, 0.05f),
    RGB565_WHITE, 0.07f);
  const uint16_t shackleEdge = blendRGB565(blendRGB565(RGB565_SILVER, RGB565_BLACK, 0.36f), RGB565_DARKGREY, 0.16f);
  const uint16_t shackleHi = blendRGB565(shackleFill, RGB565_WHITE, 0.42f);
  // Inner arc: shadow groove + catch-light (same idea as body’s hi + mid rings).
  const uint16_t shackleInnerRim = blendRGB565(blendRGB565(shackleFill, shackleHi, 0.55f), RGB565_WHITE, 0.12f);
  const uint16_t shackleInnerGroove = blendRGB565(shackleEdge, shackleFill, 0.48f);
  const uint16_t shackleTopSpec = blendRGB565(shackleFill, RGB565_WHITE, 0.50f);

  // Shackle: fill → narrow top glint (center only) → outer bevels → cutout → inner groove + rim.
  const int shW = (int)(s * 0.48f);
  const int shH = (int)(s * 0.62f);
  const int shX = x + (s - shW) / 2;
  const int shY = y + (int)(s * 0.02f);
  const int shRad = shW / 2;
  gfx->fillRoundRect(shX, shY, shW, shH, max(6, shRad), shackleFill);
  {
    const int glintW = max(6, (shW * 34) / 100);
    const int glintH = max(2, (shH * 14) / 100);
    const int glintX = shX + (shW - glintW) / 2;
    gfx->fillRoundRect(glintX, shY + 1, glintW, glintH, max(2, shRad / 4), shackleTopSpec);
  }
  gfx->drawRoundRect(shX + 1, shY + 1, shW - 2, shH - 2, max(5, shRad - 1), shackleHi);
  gfx->drawRoundRect(shX + 2, shY + 2, shW - 4, shH - 4, max(4, shRad - 2), blendRGB565(shackleFill, shackleEdge, 0.45f));
  gfx->drawRoundRect(shX, shY, shW, shH, max(6, shRad), shackleEdge);
  const int thick = max(4, s / 15);
  const int cutPad = thick;
  const int innerR = max(4, shRad - cutPad);
  gfx->fillRoundRect(shX + cutPad, shY + cutPad, shW - 2 * cutPad, shH - 2 * cutPad, innerR, cutCol);
  gfx->drawRoundRect(shX + cutPad, shY + cutPad, shW - 2 * cutPad, shH - 2 * cutPad, innerR, shackleInnerGroove);
  gfx->drawRoundRect(shX + cutPad + 1, shY + cutPad + 1, shW - 2 * (cutPad + 1), shH - 2 * (cutPad + 1), max(3, innerR - 1), shackleInnerRim);

  // Body: slightly taller ratio, softer corners; specular band then bevel rings.
  const int bodyW = (int)(s * 0.68f);
  const int bodyH = (int)(s * 0.54f);
  const int bodyX = x + (s - bodyW) / 2;
  const int bodyY = y + (int)(s * 0.32f);
  gfx->fillRoundRect(bodyX, bodyY, bodyW, bodyH, max(7, rad), lockGold);
  {
    const int specH = max(3, (int)(bodyH * 0.13f));
    gfx->fillRoundRect(bodyX + 6, bodyY + 2, bodyW - 12, specH, max(3, rad / 3), specSheen);
  }
  gfx->drawRoundRect(bodyX + 1, bodyY + 1, bodyW - 2, bodyH - 2, max(5, rad - 1), hi);
  gfx->drawRoundRect(bodyX + 2, bodyY + 2, bodyW - 4, bodyH - 4, max(4, rad - 2), blendRGB565(lockGold, goldEdge, 0.45f));
  gfx->drawRoundRect(bodyX, bodyY, bodyW, bodyH, max(7, rad), goldEdge);

  // Keyhole: classic circle + tapered slot (no plate / stars below).
  const int keyCx = bodyX + bodyW / 2;
  const int keyCy = bodyY + (int)(bodyH * 0.40f);
  const int keyR = max(3, s / 20);
  gfx->fillCircle(keyCx, keyCy, keyR, keyholeCol);
  const int stemW = max(3, (keyR * 5) / 4);
  const int stemX = keyCx - stemW / 2;
  const int stemY = keyCy + keyR - 1;
  int stemH = max(7, (keyR * 11) / 4);
  const int bottomPad = max(7, bodyH / 7);
  const int maxStemH = (bodyY + bodyH - bottomPad) - stemY;
  if (stemH > maxStemH) stemH = max(6, maxStemH);
  gfx->fillRoundRect(stemX, stemY, stemW, stemH, max(2, stemW / 3), keyholeCol);

  gfx->setTextSize(1);
  const char* pwLab = "Passwords";
  const int pwLen = (int)strlen(pwLab);
  const int charW = 6;
  const int letterGap = 2;
  const int pwTw = pwLen * charW + (pwLen - 1) * letterGap;
  const int boldDx = 1;
  int pwX = bodyX + (bodyW - pwTw) / 2;
  const int lockBottom = bodyY + bodyH;
  const int gap = max(4, s / 16);
  const int pwTop = lockBottom + gap;
  const int textH = 8;
  int pwY = pwTop;
  int16_t pbx, pby;
  uint16_t pbw, pbh;
  gfx->getTextBounds(pwLab, pwX, pwY, &pbx, &pby, &pbw, &pbh);
  pwY += pwTop - (int)pby;
  pwY += max(6, s / 22);
  if (pwX < x + 2) pwX = x + 2;
  if (pwX + pwTw > x + s - 2) pwX = x + s - 2 - pwTw;
  const int maxPwY = y + s - textH - 2;
  if (pwY > maxPwY) pwY = maxPwY;
  gfx->setTextColor(darkTile ? UI_TEXT : blendRGB565(RGB565_BLACK, goldEdge, 0.12f));

  for (int i = 0; i < pwLen; i++) {
    const int cx = pwX + i * (charW + letterGap);
    char buf[2] = { pwLab[i], 0 };
    gfx->setCursor(cx, pwY);
    gfx->print(buf);
    gfx->setCursor(cx + boldDx, pwY);
    gfx->print(buf);
  }
}

static void drawNotesAppIcon(int x, int y, int s, uint16_t bg) {
  if (s <= 0) return;
  const bool darkTile = (bg == RGB565_BLACK || bg == mainMenuDarkCardTile565());
  // Premium notebook: same recipe as Passwords lock body — depth blend + spec band + hi/mid/edge rings.
  const uint16_t coverBase = UI_SUCCESS;
  const uint16_t coverGreen = blendRGB565(
    blendRGB565(blendRGB565(coverBase, RGB565_DARKGREY, 0.09f), RGB565_SILVER, 0.05f),
    RGB565_WHITE, 0.07f);
  const uint16_t coverEdge = blendRGB565(blendRGB565(coverBase, RGB565_BLACK, 0.38f), RGB565_DARKGREY, 0.15f);
  const uint16_t coverHi = blendRGB565(coverGreen, RGB565_WHITE, 0.40f);
  const uint16_t specSheen = blendRGB565(coverGreen, RGB565_WHITE, 0.48f);
  const uint16_t midRingCol = blendRGB565(coverGreen, coverEdge, 0.45f);
  // Spiral rings: silver binder metal (mirrors lock shackle recipe).
  const uint16_t ringFill = blendRGB565(
    blendRGB565(blendRGB565(RGB565_SILVER, RGB565_DARKGREY, 0.10f), RGB565_GOLD, 0.04f),
    RGB565_WHITE, 0.07f);
  const uint16_t ringEdge = blendRGB565(blendRGB565(RGB565_SILVER, RGB565_BLACK, 0.36f), RGB565_DARKGREY, 0.16f);
  const uint16_t ringHi = blendRGB565(ringFill, RGB565_WHITE, 0.38f);
  // Ink lines: near-black with a hint of cover (not harsh flat black).
  const uint16_t paperLine = blendRGB565(blendRGB565(RGB565_BLACK, coverEdge, 0.22f), coverGreen, 0.06f);

  // Requested: shift Notes icon 3px to the right.
  const int bookX = x + (int)(s * 0.10f) + 3;
  // Shift notebook up so label can sit lower with visible air.
  const int bookY = y + (int)(s * 0.06f);
  const int bookW = (int)(s * 0.70f);
  // Make the Notes icon end at the same Y-position as the Passwords lock.
  // (The Passwords lock ends at max(bodyBottom, asteriskPlateBottom).)
  const int pwBodyY = y + (int)(s * 0.40f);
  const int pwBodyH = (int)(s * 0.52f);
  const int pwBodyBottom = pwBodyY + pwBodyH;
  const int keyCy = pwBodyY + (int)(pwBodyH * 0.38f);
  const int keyR = max(3, s / 18);
  const int stemY = keyCy + keyR - 1;
  int stemH = max(8, keyR + 4);
  const int bottomPad = max(6, pwBodyH / 8);
  const int maxStemH = (pwBodyY + pwBodyH - bottomPad) - stemY;
  if (stemH > maxStemH) stemH = max(6, maxStemH);
  stemH = (stemH * 55) / 100;
  if (stemH < 6) stemH = 6;
  const int holeBottom = stemY + stemH;
  const int starGap = max(1, s / 28);
  const int starsY = holeBottom + starGap + 1;
  const int spad = max(1, s / 50);
  gfx->setTextSize(1);
  const char* stars = "****";
  int16_t sbx, sby;
  uint16_t sbw, sbh;
  gfx->getTextBounds(stars, 0, (int16_t)starsY, &sbx, &sby, &sbw, &sbh);
  const int asteriskBottom = (sby - spad) + (int)sbh + 2 * spad;
  const int desiredBottom = (asteriskBottom > pwBodyBottom) ? asteriskBottom : pwBodyBottom;

  int bookH = desiredBottom - bookY;
  // Shorten notebook slightly so the label can move down (otherwise it clamps at bottom).
  bookH -= max(6, s / 18);
  const int minBookH = max(20, max(16, s / 8) + 10);
  if (bookH < minBookH) bookH = minBookH;
  const int maxBookH = (y + s - 2) - bookY;
  if (bookH > maxBookH) bookH = maxBookH;
  const int bookR = max(8, s / 10);
  gfx->fillRoundRect(bookX, bookY, bookW, bookH, bookR, coverGreen);
  {
    const int specH = max(3, (int)(bookH * 0.11f));
    gfx->fillRoundRect(bookX + 5, bookY + 2, bookW - 10, specH, max(3, bookR / 3), specSheen);
  }
  gfx->drawRoundRect(bookX + 1, bookY + 1, bookW - 2, bookH - 2, max(6, bookR - 1), coverHi);
  gfx->drawRoundRect(bookX + 2, bookY + 2, bookW - 4, bookH - 4, max(5, bookR - 2), midRingCol);
  gfx->drawRoundRect(bookX, bookY, bookW, bookH, bookR, coverEdge);

  // Spiral rings on the left (metallic binder coils).
  const int ringN = 6;
  const int ringW = max(8, s / 8);
  const int ringH = max(4, s / 16);
  const int ringRad = ringH / 2;
  for (int i = 0; i < ringN; i++) {
    const int ry = bookY + max(8, s / 12) + i * ((bookH - max(16, s / 8)) / (ringN - 1));
    const int rx = bookX - ringW / 2;
    gfx->fillRoundRect(rx, ry - ringH / 2, ringW, ringH, ringRad, ringFill);
    gfx->drawRoundRect(rx + 1, ry - ringH / 2 + 1, ringW - 2, ringH - 2, max(1, ringRad - 1), ringHi);
    gfx->drawRoundRect(rx, ry - ringH / 2, ringW, ringH, ringRad, ringEdge);
  }

  // Horizontal writing lines.
  const int lineX = bookX + max(14, s / 6);
  int lineY = bookY + max(12, s / 7);
  const int lineW = bookW - max(24, s / 4);
  const int lineGap = max(7, s / 10);
  for (int i = 0; i < 4; i++) {
    gfx->fillRoundRect(lineX, lineY, lineW - i * max(5, s / 16), max(2, s / 22), 2, paperLine);
    lineY += lineGap;
  }

  // "Notes" label under the notebook.
  gfx->setTextSize(1);
  const char* notesLab = "Notes";
  const int notesLen = (int)strlen(notesLab);
  const int charW = 6;
  const int letterGap = 2;
  const int notesTw = notesLen * charW + (notesLen - 1) * letterGap;
  const int boldDx = 1;
  int notesX = bookX + (bookW - notesTw) / 2;

  const int textH = 8;                  // size-1 text height for clamping
  int notesTop = (bookY + bookH) + 18;  // move down by roughly 1 font height (size-1)
  const int maxTop = (y + s) - textH - 2;
  if (notesTop < y + 1) notesTop = y + 1;
  if (notesTop > maxTop) notesTop = maxTop;

  // Align so the text's top edge equals notesTop.
  int16_t tbx, tby;
  uint16_t tbw, tbh;
  int baselineY = notesTop;
  gfx->getTextBounds(notesLab, notesX, baselineY, &tbx, &tby, &tbw, &tbh);
  int notesY = baselineY + notesTop - (int)tby;

  // Keep horizontally inside the tile.
  if (notesX < x + 1) notesX = x + 1;
  if (notesX + notesTw > x + s - 1) notesX = x + s - 1 - notesTw;

  gfx->setTextColor(darkTile ? UI_TEXT : blendRGB565(RGB565_BLACK, coverEdge, 0.12f));
  for (int i = 0; i < notesLen; i++) {
    const int cx = notesX + i * (charW + letterGap);
    char buf[2] = { notesLab[i], 0 };
    gfx->setCursor(cx, notesY);
    gfx->print(buf);
    gfx->setCursor(cx + boldDx, notesY);
    gfx->print(buf);
  }
}

