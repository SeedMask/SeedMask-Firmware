static void duress_snake_place_food() {
  for (int t = 0; t < 300; t++) {
    g_duressSnakeFoodX = (int8_t)random(0, DURESS_SNAKE_GW);
    g_duressSnakeFoodY = (int8_t)random(0, DURESS_SNAKE_GH);
    bool on = false;
    for (uint8_t i = 0; i < g_duressSnakeLen; i++) {
      if (g_duressSnakeX[i] == g_duressSnakeFoodX && g_duressSnakeY[i] == g_duressSnakeFoodY) {
        on = true;
        break;
      }
    }
    if (!on) return;
  }
}

static void duress_snake_reset() {
  g_duressSnakeLen = 3;
  g_duressSnakeX[0] = 11;
  g_duressSnakeY[0] = 10;
  g_duressSnakeX[1] = 12;
  g_duressSnakeY[1] = 10;
  g_duressSnakeX[2] = 13;
  g_duressSnakeY[2] = 10;
  g_duressSnakeDir = 1;
  g_duressSnakeNextDir = -1;
  g_duressSnakeDead = false;
  duress_snake_place_food();
  g_duressSnakeNextStepMs = millis() + 200;
}

static void duress_snake_step() {
  if (g_duressSnakeDead) return;
  if (g_duressSnakeNextDir >= 0) {
    int8_t nd = g_duressSnakeNextDir;
    g_duressSnakeNextDir = -1;
    if (nd != (g_duressSnakeDir ^ 2)) g_duressSnakeDir = nd;
  }
  int8_t hx = g_duressSnakeX[g_duressSnakeLen - 1];
  int8_t hy = g_duressSnakeY[g_duressSnakeLen - 1];
  int8_t nx = hx, ny = hy;
  switch (g_duressSnakeDir) {
    case 0: ny--; break;
    case 1: nx++; break;
    case 2: ny++; break;
    default: nx--; break;
  }
  if (nx < 0 || nx >= DURESS_SNAKE_GW || ny < 0 || ny >= DURESS_SNAKE_GH) {
    g_duressSnakeDead = true;
    return;
  }
  for (uint8_t i = 0; i < g_duressSnakeLen - 1; i++) {
    if (g_duressSnakeX[i] == nx && g_duressSnakeY[i] == ny) {
      g_duressSnakeDead = true;
      return;
    }
  }
  bool eat = (nx == g_duressSnakeFoodX && ny == g_duressSnakeFoodY);
  if (eat) {
    g_duressSnakeX[g_duressSnakeLen] = nx;
    g_duressSnakeY[g_duressSnakeLen] = ny;
    g_duressSnakeLen++;
    duress_snake_place_food();
  } else {
    for (uint8_t i = 0; i < g_duressSnakeLen - 1; i++) {
      g_duressSnakeX[i] = g_duressSnakeX[i + 1];
      g_duressSnakeY[i] = g_duressSnakeY[i + 1];
    }
    g_duressSnakeX[g_duressSnakeLen - 1] = nx;
    g_duressSnakeY[g_duressSnakeLen - 1] = ny;
  }
}

static void duress_stack_reset() {
  g_duressStackBarCenter = 160.f;
  g_duressStackBarVel = 2.8f;
  g_duressStackBarW = 100;
  g_duressStackLevel = 0;
  g_duressStackGameOver = false;
  g_duressStackLastTickMs = millis();
}

static void duress_stack_tick() {
  if (g_duressStackGameOver) return;
  g_duressStackBarCenter += g_duressStackBarVel;
  int half = g_duressStackBarW / 2;
  if (g_duressStackBarCenter - (float)half < 20.f) {
    g_duressStackBarCenter = (float)(20 + half);
    g_duressStackBarVel = (g_duressStackBarVel < 0.f) ? g_duressStackBarVel : -g_duressStackBarVel;
  }
  if (g_duressStackBarCenter + (float)half > 300.f) {
    g_duressStackBarCenter = (float)(300 - half);
    g_duressStackBarVel = (g_duressStackBarVel > 0.f) ? g_duressStackBarVel : -g_duressStackBarVel;
  }
}

static void duress_stack_tap() {
  if (g_duressStackGameOver) {
    duress_stack_reset();
    return;
  }
  int half = g_duressStackBarW / 2;
  int left = (int)(g_duressStackBarCenter - (float)half);
  int right = (int)(g_duressStackBarCenter + (float)half);
  if (g_duressStackLevel == 0) {
    g_duressStackCenters[0] = g_duressStackBarCenter;
    g_duressStackWidths[0] = g_duressStackBarW;
    g_duressStackLevel = 1;
    g_duressStackBarW = (g_duressStackBarW > 28) ? (g_duressStackBarW - 6) : 28;
    if (g_duressStackBarVel < 0) g_duressStackBarVel -= 0.5f;
    else g_duressStackBarVel += 0.5f;
    return;
  }
  float prevC = g_duressStackCenters[g_duressStackLevel - 1];
  int prevW = g_duressStackWidths[g_duressStackLevel - 1];
  int pL = (int)(prevC - (float)prevW / 2.f);
  int pR = (int)(prevC + (float)prevW / 2.f);
  int oL = left > pL ? left : pL;
  int oR = right < pR ? right : pR;
  if (oL >= oR) {
    g_duressStackGameOver = true;
    return;
  }
  float newC = (oL + oR) / 2.f;
  int newW = oR - oL;
  if (newW < 10) {
    g_duressStackGameOver = true;
    return;
  }
  g_duressStackCenters[g_duressStackLevel] = newC;
  g_duressStackWidths[g_duressStackLevel] = newW;
  g_duressStackLevel++;
  g_duressStackBarCenter = newC;
  g_duressStackBarW = newW;
  if (g_duressStackBarVel < 0) g_duressStackBarVel -= 0.5f;
  else g_duressStackBarVel += 0.5f;
}

