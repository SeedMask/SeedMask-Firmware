// Sparrow MessageSignDialog.verifyMessage() tries ECKey.signedMessageToKey(message.getText().trim(), sig, true)
// first — the digest must use the same bytes as Java String.trim(): remove leading/trailing chars <= U+0020.
static void tools_sign_msg_trim_java_string_trim(char* s) {
  if (!s || !s[0]) return;
  char* p = s;
  while ((unsigned char)*p <= 0x20 && *p != 0) p++;
  if (p != s) {
    size_t len = strlen(p) + 1;
    memmove(s, p, len);
  }
  size_t n = strlen(s);
  while (n > 0 && (unsigned char)s[n - 1] <= 0x20) n--;
  s[n] = 0;
}

// Sparrow "Sign by QR" (MessageSignDialog.showQr) encodes:
//   signmessage <path> ascii:<message>   (path from KeyDerivation.writePath(..., false) → "h" hardened)
// Many cameras / QR pipelines insert U+00A0 (NBSP, UTF-8 C2 A0) before "ascii:" — strstr(" ascii:") misses
// and the device hashes the whole command → verify fails for every non-matching fallback path.
static void tools_sign_strip_utf8_bom(char* s) {
  if (!s || !s[0]) return;
  if ((unsigned char)s[0] == 0xEF && (unsigned char)s[1] == 0xBB && (unsigned char)s[2] == 0xBF) {
    memmove(s, s + 3, strlen(s + 3) + 1);
  }
}

static bool tools_sign_ci_match_ascii_colon(const char* p) {
  const char k[] = "ascii:";
  for (size_t i = 0; i < sizeof(k) - 1; i++) {
    if (!p[i]) return false;
    if (tolower((unsigned char)p[i]) != tolower((unsigned char)k[i])) return false;
  }
  return true;
}

// First "ascii:" after the signmessage prefix (case-insensitive). Not strstr(" ascii:") — NBSP breaks that.
static const char* tools_sign_find_ascii_keyword_in_signmessage(const char* s) {
  static const char pref[] = "signmessage ";
  const size_t plen = sizeof(pref) - 1;
  for (size_t j = 0; j < plen; j++) {
    if (!s[j]) return nullptr;
    if (tolower((unsigned char)s[j]) != tolower((unsigned char)pref[j])) return nullptr;
  }
  for (const char* p = s + plen; *p; p++) {
    if (tools_sign_ci_match_ascii_colon(p)) return p;
  }
  return nullptr;
}

// Sparrow MessageSignDialog.java: digest = hash only bytes after "ascii:" (same as Trezor).
static void tools_sign_extract_sparrow_signmessage_ascii(char* s) {
  if (!s || !s[0]) return;
  const char* kw = tools_sign_find_ascii_keyword_in_signmessage(s);
  if (!kw) return;
  const char* msg = kw + 6;  // after "ascii:"
  size_t n = strlen(msg);
  if (msg != s) memmove(s, msg, n + 1);
}

// Sparrow MessageSignDialog uses KeyDerivation.writePath(..., false) → hardened steps end with "h" not "'"
// (see Drongo ChildNumber.toString(false)). Accept m/{44|49|84}h/0h/Nh/C/I and m/{44|49|84}'/0'/N'/C/I (mainnet 0').

static bool tools_sign_path_u32_digits(const char** pp, uint32_t* out) {
  uint32_t v = 0;
  int nd = 0;
  while (**pp >= '0' && **pp <= '9') {
    if (nd >= 10) return false;
    v = v * 10u + (uint32_t)(**pp - '0');
    (*pp)++;
    nd++;
  }
  if (nd == 0) return false;
  *out = v;
  return true;
}

static bool tools_sign_path_consume_hardened(const char** pp) {
  if (**pp == '\'' || **pp == 'h' || **pp == 'H') {
    (*pp)++;
    return true;
  }
  return false;
}

// BIP44/49/84 path from Sparrow "Sign by QR": m/{44|49|84}'/0'/account'/chain/index (mainnet coin 0' only).
static bool tools_sign_parse_path_from_signmessage_qr(const char* s, uint32_t* outAcc, uint32_t* outChain, uint32_t* outIdx,
                                                      AddrType* outAddrType) {
  static const char pref[] = "signmessage ";
  const size_t plen = sizeof(pref) - 1;
  for (size_t j = 0; j < plen; j++) {
    if (!s[j]) return false;
    if (tolower((unsigned char)s[j]) != tolower((unsigned char)pref[j])) return false;
  }
  const char* asciiKw = tools_sign_find_ascii_keyword_in_signmessage(s);
  if (!asciiKw) return false;
  const char* pathBeg = s + plen;
  while (*pathBeg && (unsigned char)pathBeg[0] <= 0x20) pathBeg++;
  const char* pathEnd = asciiKw;
  while (pathEnd > pathBeg && ((unsigned char)pathEnd[-1] <= 0x20)) pathEnd--;
  // Trim NBSP (UTF-8) before "ascii:" — path must not include C2 A0
  while (pathEnd > pathBeg && (unsigned char)pathEnd[-1] == 0xA0 && pathEnd - 2 >= pathBeg && (unsigned char)pathEnd[-2] == 0xC2) {
    pathEnd -= 2;
  }
  while (pathEnd > pathBeg && ((unsigned char)pathEnd[-1] <= 0x20)) pathEnd--;
  if (pathEnd <= pathBeg) return false;
  size_t pathLen = (size_t)(pathEnd - pathBeg);
  if (pathLen >= 160) return false;
  char pathBuf[160];
  memcpy(pathBuf, pathBeg, pathLen);
  pathBuf[pathLen] = 0;
  const char* p = pathBuf;
  if (tolower((unsigned char)p[0]) != 'm' || p[1] != '/') return false;
  p += 2;
  uint32_t purpose = 0, coin = 0, acc = 0, ch = 0, idx = 0;
  if (!tools_sign_path_u32_digits(&p, &purpose) || !tools_sign_path_consume_hardened(&p)) return false;
  if (*p != '/') return false;
  p++;
  if (!tools_sign_path_u32_digits(&p, &coin) || !tools_sign_path_consume_hardened(&p)) return false;
  if (*p != '/') return false;
  p++;
  if (!tools_sign_path_u32_digits(&p, &acc) || !tools_sign_path_consume_hardened(&p)) return false;
  if (*p != '/') return false;
  p++;
  if (!tools_sign_path_u32_digits(&p, &ch)) return false;
  if (tools_sign_path_consume_hardened(&p)) return false;
  if (*p != '/') return false;
  p++;
  if (!tools_sign_path_u32_digits(&p, &idx)) return false;
  if (tools_sign_path_consume_hardened(&p)) return false;
  if (*p != 0) return false;
  if (coin != 0u) return false;
  AddrType at = AddrType::P2WPKH;
  if (purpose == 44u) at = AddrType::P2PKH;
  else if (purpose == 49u) at = AddrType::P2SH_P2WPKH;
  else if (purpose == 84u) at = AddrType::P2WPKH;
  else return false;
  if (ch > 1u || idx > BTC_ADDR_MAX_INDEX) return false;
  *outAcc = acc;
  *outChain = ch;
  *outIdx = idx;
  *outAddrType = at;
  return true;
}

static uint8_t tools_sign_message_header_base(AddrType t) {
  if (t == AddrType::P2SH_P2WPKH) return 35;
  return 31;
}
static void trim_ascii_in_place(char* s);

static void tools_on_verify_qr_decoded(const char* text) {
  g_toolsVerifyFound = false;
  strncpy(g_toolsQrPayload, text ? text : "", TOOLS_QR_MSG_MAX_BYTES - 1);
  g_toolsQrPayload[TOOLS_QR_MSG_MAX_BYTES - 1] = 0;
  tools_extract_payment_address(g_toolsQrPayload, g_toolsVerifyWant, sizeof(g_toolsVerifyWant));
  trim_ascii_in_place(g_toolsVerifyWant);
  for (char* c = g_toolsVerifyWant; *c; c++) {
    if (*c == '?' || *c == '#' || *c == '&') {
      *c = 0;
      break;
    }
  }
  trim_ascii_in_place(g_toolsVerifyWant);
  {
    char alt[128];
    if (tools_verify_bech32_from_raw(g_toolsQrPayload, alt, sizeof(alt))) {
      char w0 = g_toolsVerifyWant[0];
      if (!w0 || w0 == '{' || w0 == '[' || w0 == '"' || strlen(g_toolsVerifyWant) < 14) {
        strncpy(g_toolsVerifyWant, alt, sizeof(g_toolsVerifyWant) - 1);
        g_toolsVerifyWant[sizeof(g_toolsVerifyWant) - 1] = 0;
        trim_ascii_in_place(g_toolsVerifyWant);
      }
    }
  }
  if (!g_toolsVerifyWant[0]) {
    g_toolsVerifySearchActive = false;
    // Keep g_toolsVerifyDecodeMs* so a 2nd decode in the same scan can still use multisig session.
  } else {
    g_toolsVerifySearchActive = true;
    g_toolsVerifyIsMultisig = false;
    g_toolsVerifySgChain = 0;
    g_toolsVerifySgIdx = 0;
    g_toolsVerifySgTi = 0;
    g_toolsVerifyMsChain = 0;
    g_toolsVerifyMsIdx = 0;
    g_toolsVerifySearchMsVis = 0;
    g_toolsVerifySgExhausted = false;
    g_toolsVerifyMsExhausted = false;
    // tools_begin_verify_scan sets scan flags and g_qrToolsVerifySessionMsWallet together; use both so a stale
    // field cannot force singlesig search (flags are canonical; session byte is fallback if flags were cleared).
    const bool wantMs = g_multisigWalletPayloads
                        && ((g_toolsVerifyScanIsMultisig && (g_toolsVerifyScanMsStoredIdx < g_multisigWalletCount))
                            || (g_qrToolsVerifySessionMsWallet != 0xFFu
                                && (g_qrToolsVerifySessionMsWallet < g_multisigWalletCount)));
    g_toolsVerifyRunMsSearchOnly = wantMs;
    if (wantMs) {
      const uint8_t msPick =
        (g_toolsVerifyScanIsMultisig && (g_toolsVerifyScanMsStoredIdx < g_multisigWalletCount))
          ? g_toolsVerifyScanMsStoredIdx
          : g_qrToolsVerifySessionMsWallet;
      g_toolsVerifyMode = ToolsVerifyMode::Multisig;
      g_toolsVerifyMsCands[0] = msPick;
      g_toolsVerifyMsCandCount = 1;
      g_toolsVerifyMsExhausted = false;
      g_toolsVerifySgExhausted = true;  // interleaved path only; ms-only search ignores singlesig
    } else {
      g_toolsVerifyMode = ToolsVerifyMode::Singlesig;
      g_toolsVerifyMsCandCount = 0;
      g_toolsVerifySgExhausted = false;
      g_toolsVerifyMsExhausted = true;
    }
    g_toolsVerifyDecodeMsLatched = false;
  }
  show(UIScreen::CRYPTO_TOOLS_VERIFY_RESULT);
}

static void tools_on_sign_qr_decoded(const char* text) {
  strncpy(g_toolsSignMsg, text ? text : "", TOOLS_QR_MSG_MAX_BYTES - 1);
  g_toolsSignMsg[TOOLS_QR_MSG_MAX_BYTES - 1] = 0;
  tools_sign_strip_utf8_bom(g_toolsSignMsg);
  tools_sign_msg_trim_java_string_trim(g_toolsSignMsg);
  g_toolsSignPathFromQr = false;
  g_toolsSignAddrType = AddrType::P2WPKH;
  uint32_t dAcc = g_addrAccount, dChain = 0u, dIdx = 0u;
  AddrType dAt = AddrType::P2WPKH;
  if (tools_sign_parse_path_from_signmessage_qr(g_toolsSignMsg, &dAcc, &dChain, &dIdx, &dAt)) {
    g_toolsSignPathFromQr = true;
    g_toolsSignPathAccount = dAcc;
    g_toolsSignPathChain = dChain;
    g_toolsSignPathIndex = dIdx;
    g_toolsSignAddrType = dAt;
  }
  tools_sign_extract_sparrow_signmessage_ascii(g_toolsSignMsg);
  tools_sign_msg_trim_java_string_trim(g_toolsSignMsg);
  g_toolsSignSigB64[0] = 0;
  g_toolsSignAddress[0] = 0;
  if (vault_is_unlocked() && g_loggedIn) {
    uint32_t acc = g_toolsSignPathFromQr ? g_toolsSignPathAccount : g_addrAccount;
    uint32_t ch = g_toolsSignPathFromQr ? g_toolsSignPathChain : 0u;
    uint32_t idx = g_toolsSignPathFromQr ? g_toolsSignPathIndex : 0u;
    AddrType at = g_toolsSignPathFromQr ? g_toolsSignAddrType : AddrType::P2WPKH;
    (void)btc_address_for_index(at, acc, ch, idx, g_toolsSignAddress, sizeof(g_toolsSignAddress));
  }
  show(UIScreen::CRYPTO_TOOLS_SIGN_REVIEW);
}

static bool tools_sign_current_message() {
  g_toolsSignSigB64[0] = 0;
  tools_sign_strip_utf8_bom(g_toolsSignMsg);
  tools_sign_msg_trim_java_string_trim(g_toolsSignMsg);
  tools_sign_extract_sparrow_signmessage_ascii(g_toolsSignMsg);
  tools_sign_msg_trim_java_string_trim(g_toolsSignMsg);
  size_t msgLen = strlen(g_toolsSignMsg);
  if (msgLen == 0) return false;
  uint32_t acc = g_toolsSignPathFromQr ? g_toolsSignPathAccount : g_addrAccount;
  uint32_t ch = g_toolsSignPathFromQr ? g_toolsSignPathChain : 0u;
  uint32_t idx = g_toolsSignPathFromQr ? g_toolsSignPathIndex : 0u;
  AddrType at = g_toolsSignPathFromQr ? g_toolsSignAddrType : AddrType::P2WPKH;
  Bip32Node node;
  memset(&node, 0, sizeof(node));
  if (!derive_btc_node_for_index(at, acc, ch, idx, &node)) {
    secure_memzero(&node, sizeof(node));
    return false;
  }
  uint8_t hash32[32];
  if (!seedmask_bitcoin_signed_message_hash(g_toolsSignMsg, msgLen, hash32)) {
    secure_memzero(&node, sizeof(node));
    return false;
  }
  uint8_t compact[65];
  if (!seedmask_bitcoin_message_sign_compact(node.k, hash32, compact, tools_sign_message_header_base(at))) {
    secure_memzero(&node, sizeof(node));
    secure_memzero(hash32, sizeof(hash32));
    return false;
  }
  base64_encode(compact, sizeof(compact), g_toolsSignSigB64);
  secure_memzero(&node, sizeof(node));
  secure_memzero(hash32, sizeof(hash32));
  secure_memzero(compact, sizeof(compact));
  return true;
}

