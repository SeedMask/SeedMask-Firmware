  gfx->setTextSize(1);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setCursor(cx + 10, fpY + 6);
  gfx->print("Fingerprint");
  gfx->setTextSize(2);
  gfx->setCursor(cx + 10, fpY + 18);
  gfx->print(xfp);
  secure_memzero(xfp, sizeof(xfp));

  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  const int lineH = 18;
  int y = fpY + fpH + gap;
  if (g_bip85WordCount <= 12) {
    for (int i = 0; i < (int)g_bip85WordCount && i < 12; i++) {
      gfx->setCursor(12, y);
      gfx->printf("%2d %s", i + 1, g_bip85DerivedWords[i]);
      y += lineH;
      if (y > 400) break;
    }
  } else {
    int mid = 12;
    int yL = y;
    for (int i = 0; i < mid; i++) {
      gfx->setCursor(12, yL);
      gfx->printf("%2d %s", i + 1, g_bip85DerivedWords[i]);
      yL += lineH;
    }
    yL = y;
    for (int i = mid; i < 24; i++) {
      gfx->setCursor(168, yL);
      gfx->printf("%2d %s", i + 1, g_bip85DerivedWords[i]);
      yL += lineH;
    }
  }
  if (!g_tempSeedActive) {
    drawBtn(BTN_BIP85_SET_TEMP, "Set temp", accent, 1);
  } else {
    gfx->setTextSize(1);
    gfx->setTextColor(RGB565_CYAN);
    gfx->setCursor(10, 452);
    gfx->print("Temporary seed active. Clear it first.");
  }
  drawBurgerMenuSeedQRIcon(BTN_BIP85_SHOW_QR.x, BTN_BIP85_SHOW_QR.y, BTN_BIP85_SHOW_QR.w, BTN_BIP85_SHOW_QR.h);
  {
