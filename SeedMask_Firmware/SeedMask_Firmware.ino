static void handleSecurityDuressPinSetupTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_duressPinSetupPhase = 0;
    g_duressPinFirstEntry[0] = 0;
    clearPassword(g_password1);
    setMsg("");
    if (g_duressTypeSetupPending) {
      duress_type_setup_cancel();
      show(UIScreen::SECURITY_DURESS_TYPE_MENU);
    } else {
      show(UIScreen::SECURITY_DURESS_LOCK_MENU);
    }
    return;
  }
  if (hit(RECT_TOP_TITLE, x, y)) {
    g_duressPinSetupPhase = 0;
    g_duressPinFirstEntry[0] = 0;
    clearPassword(g_password1);
    setMsg("");
    if (g_duressTypeSetupPending) {
      duress_type_setup_cancel();
      show(UIScreen::SECURITY_DURESS_TYPE_MENU);
    } else {
      show(UIScreen::SECURITY_DURESS_LOCK_MENU);
    }
    return;
  }

  const int nh = pin_entry_numpad_hit(x, y, PIN_ENTRY_NUMPAD_Y0, PIN_ENTRY_KEY_H);
  if (nh < 0) return;

  if (nh == 11) {
    const int okX = 2 * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
    const int okY = PIN_ENTRY_NUMPAD_Y0 + 3 * (PIN_ENTRY_KEY_H + SETTIME_NUMPAD_GAP);
    const Rect okPad = { (int16_t)okX, (int16_t)okY, (int16_t)SETTIME_KEY_W, (int16_t)PIN_ENTRY_KEY_H };
    flashKeyRectTranslucent(okPad);
    if (strlen(g_password1) != 6) {
      setMsg("Enter 6 digits");
      draw();
      return;
    }
    for (int i = 0; i < 6; i++) {
      if (g_password1[i] < '0' || g_password1[i] > '9') {
        setMsg("Digits only");
        draw();
        return;
      }
    }
    if (g_duressPinSetupPhase == 0) {
      char mpwTest[128];
      if (g_screenLockUsesPin && screen_lock_pin_unwrap(g_password1, mpwTest, sizeof(mpwTest))) {
        secure_memzero(mpwTest, sizeof(mpwTest));
        setMsg("Cannot match screen lock PIN");
        clearPassword(g_password1);
        draw();
        return;
      }
      strncpy(g_duressPinFirstEntry, g_password1, sizeof(g_duressPinFirstEntry) - 1);
      g_duressPinFirstEntry[sizeof(g_duressPinFirstEntry) - 1] = 0;
      clearPassword(g_password1);
      setMsg("");
      g_duressPinSetupPhase = 1;
      draw();
      return;
    }
    if (strcmp(g_password1, g_duressPinFirstEntry) != 0) {
      setMsg("PINs do not match");
      g_duressPinSetupPhase = 0;
      g_duressPinFirstEntry[0] = 0;
      clearPassword(g_password1);
      draw();
      return;
    }
    if (!duress_type_save_pin_for_target(g_duressPinFirstEntry)) {
      setMsg("Could not save duress PIN");
      draw();
      return;
    }
    if (g_duressSetupTarget == DuressBehavior::DECOY_VAULT && !duress_decoy_nvs_present()) {
      setMsg("Could not seal decoy wallet");
      duress_type_clear_nvs(DuressBehavior::DECOY_VAULT);
      draw();
      return;
    }
    g_duressPinSetupPhase = 0;
    g_duressPinFirstEntry[0] = 0;
    clearPassword(g_password1);
    duress_type_setup_finish_ok();
    setMsg("");
    show(UIScreen::SECURITY_DURESS_TYPE_MENU);
    return;
  }
  if (nh == 10) {
    setMsg("");
    backspaceStr(g_password1, sizeof(g_password1));
    draw();
    return;
  }
  if (nh >= 0 && nh <= 8 && strlen(g_password1) < 6) {
    setMsg("");
    appendChar(g_password1, sizeof(g_password1), (char)('1' + nh));
    draw();
    return;
  }
  if (nh == 9 && strlen(g_password1) < 6) {
    setMsg("");
    appendChar(g_password1, sizeof(g_password1), '0');
    draw();
  }
}

