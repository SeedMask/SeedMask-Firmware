static void drawAddressExplorer() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Addresses", true);
  if (!vault_is_unlocked() || !g_loggedIn || !(g_wc == 12 || g_wc == 24)) {
    g_addrDeferPrefetchUntilAfterListFlush = false;
    gfx->setTextColor(RGB565_WHITE);
    gfx->setTextSize(2);
    gfx->setCursor(20, 150);
    gfx->print("Vault locked");
    gfx->setTextSize(1);
    gfx->setCursor(20, 182);
    gfx->print("Unlock to derive addresses.");
    {
      const int16_t topBarBottom = 46;
      const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
      const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
      const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
      drawWipeInfoBitmapAt(infoCx, infoCy, true);
    }
    ui_flush();
    return;
  }

  switch (g_addrExplorerStep) {
    case AddrExplorerStep::PICK_TYPE:
      {
        centerText("Choose address type", 58, 1);
        gfx->setTextColor(RGB565_CYAN);
        gfx->setTextSize(1);
        {
          const char* fpLab = "Fingerprint";
          int16_t lw = (int16_t)strlen(fpLab) * 6;
          gfx->setCursor((LCD_W - lw) / 2, 76);
          gfx->print(fpLab);
        }
        gfx->setTextSize(1);
        {
          const char* fpDisp;
          if (g_addrXfpValid && g_addrXfp[0]) {
            gfx->setTextColor(RGB565_WHITE);
            fpDisp = g_addrXfp;
          } else if (g_addrXfpValid) {
            gfx->setTextColor(RGB565_RED);
            fpDisp = "N/A";
          } else {
            gfx->setTextColor(RGB565_AMBER);
            fpDisp = "...";
          }
          int16_t w = (int16_t)strlen(fpDisp) * 6;
          int16_t x = (LCD_W - w) / 2;
          if (x < 0) x = 0;
          gfx->setCursor(x, 92);
          gfx->print(fpDisp);
        }
        if (!g_addrXfpValid) {
          g_addrXfpComputeRequested = true;
        }
        // Order: Native SegWit, Nested SegWit, Legacy, Taproot — single panel, rows separated by lines
        {
          const int16_t rad = 10;
          Rect panel = { ADDR_TYPE_COL_X, ADDR_TYPE_Y0, ADDR_TYPE_BTN_W, ADDR_TYPE_PANEL_H };
          gfx->fillRoundRect(panel.x, panel.y, panel.w, panel.h, rad, UI_CARD);
          gfx->drawRoundRect(panel.x, panel.y, panel.w, panel.h, rad, UI_BORDER);
          const int16_t sepInset = 14;
          for (int i = 1; i <= 3; i++) {
            int16_t yl = (int16_t)(ADDR_TYPE_Y0 + i * ADDR_TYPE_ROW_H);
            gfx->fillRect((int16_t)(panel.x + sepInset), yl, (int16_t)(panel.w - 2 * sepInset), 1, UI_BORDER);
          }
          static const char* const kAddrTypeLbls[4] = {
            "Native SegWit",
            "Nested SegWit",
            "Legacy",
            "Taproot",
          };
          static const AddrType kAddrPickTypes[4] = {
            AddrType::P2WPKH,
            AddrType::P2SH_P2WPKH,
            AddrType::P2PKH,
            AddrType::P2TR,
          };
          const int16_t textPadL = 14;
          const int16_t rowTextTop = 14;
          const int16_t titleLineH = 16;
          const int16_t pathExtraDown = 6;
          char pathLine[44];
          char pathWithScript[56];
          for (int i = 0; i < 4; i++) {
            int16_t ry = ADDR_TYPE_Y0 + (int16_t)i * ADDR_TYPE_ROW_H;
            format_xpub_deriv_path(pathLine, sizeof(pathLine), kAddrPickTypes[i], false, g_addrAccount);
            snprintf(pathWithScript, sizeof(pathWithScript), "(%s) %s", xpub_export_script_type_label(kAddrPickTypes[i], false),
                     pathLine);
            gfx->setTextColor(UI_TEXT);
            gfx->setTextSize(2);
            gfx->setCursor((int16_t)(panel.x + textPadL), (int16_t)(ry + rowTextTop));
            gfx->print(kAddrTypeLbls[i]);
            gfx->setTextColor(RGB565_CYAN);
            gfx->setTextSize(1);
            gfx->setCursor((int16_t)(panel.x + textPadL), (int16_t)(ry + rowTextTop + titleLineH + pathExtraDown));
            gfx->print(pathWithScript);
          }
        }
        {
          const int16_t topBarBottom = 46;
          const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
          const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
          const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
          drawWipeInfoBitmapAt(infoCx, infoCy, true);
        }
        ui_flush();
        return;
      }
    case AddrExplorerStep::PICK_CHAIN:
      {
        centerText(addrTypeShortName(g_addrType), 56, 2);
        drawBtn(BTN_ADDR_PICK_RECV, "Receive address", UI_CARD, 1);
        drawBtn(BTN_ADDR_PICK_CHANGE, "Change address", UI_CARD, 1);
        {
          const int16_t topBarBottom = 46;
          const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
          const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
          const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
          drawWipeInfoBitmapAt(infoCx, infoCy, true);
        }
        ui_flush();
        return;
      }
    case AddrExplorerStep::LIST:
    default:
      break;
  }

  ensure_address_page_cache();
  // Arm blink timer only after cache fill (row pixels exist). OK-press time is not used: if we started then,
  // elapsed time would skip past the blink phase by the time derivation finishes.
  if (g_addrGotoHighlightNeedClockArm && g_addrGotoHighlightIdx != kAddrHighlightNone) {
    uint32_t t = millis();
    g_addrGotoHighlightStartMs = t;
    g_addrExplorerHighlightLastAnimMs = t;
    g_addrGotoHighlightNeedClockArm = false;
  }
  gfx->setTextSize(1);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setCursor(10, 52);
  if (g_addrExplorerMultisig) {
    gfx->print("Multisig");
    if (g_multisigReceiveStoredIdx < g_multisigWalletCount && g_multisigWalletNames[g_multisigReceiveStoredIdx][0]) {
      gfx->print(" - ");
      gfx->print(g_multisigWalletNames[g_multisigReceiveStoredIdx]);
    }
  } else if (g_addrExplorerKaspa) {
    gfx->print("Kaspa receive");
    gfx->setCursor(10, 66);
    gfx->setTextColor(RGB565_CYAN);
    char kpath[48];
    snprintf(kpath, sizeof(kpath), "m/44'/111111'/%lu'/0", (unsigned long)g_addrAccount);
    gfx->print(kpath);
    gfx->setTextColor(RGB565_WHITE);
  }
  drawBtn(BTN_ADDR_STATUS, "Used addresses", UI_CARD, 1);
  drawAddressExplorerGotoGlyph();

  {
    uint32_t start = g_addrPage * (uint32_t)ADDR_PAGE_ROWS;
    for (uint8_t r = 0; r < ADDR_PAGE_ROWS; r++) {
      uint32_t idx = start + (uint32_t)r;
      Rect rr = addrRowRect(r);
      if (idx > ADDR_MAX_INDEX) {
        gfx->fillRoundRect(rr.x, rr.y, rr.w, rr.h, 8, RGB565_DARKGREY);
        continue;
      }
      bool ok = g_addrPageOk[r];
      bool hi = (ok && g_addrGotoHighlightIdx != kAddrHighlightNone && idx == g_addrGotoHighlightIdx);
      uint16_t rowFill = ok ? UI_CARD : RGB565_RED;
      uint16_t rowBorder = UI_BORDER;
      bool orangeOn = false;
      if (hi) {
        uint32_t el = (uint32_t)(millis() - g_addrGotoHighlightStartMs);
        if (el >= kAddrHighlightBlinkMs) {
          orangeOn = true;
        } else {
          uint32_t seg = el / 100u;
          // Two 100ms orange pulses then solid. Use seg 0+2 (not 1+3) so the first pulse is visible on the
          // first frame after the list appears — 1+3 left the row un-highlighted for the first 100ms after arm.
          orangeOn = (seg == 0u || seg == 2u);
        }
        if (orangeOn) {
          const uint16_t hiCol = g_addrExplorerKaspa ? RGB565_KASPA_TEAL : RGB565_BITCOIN_ORANGE;
          rowFill = hiCol;
          rowBorder = hiCol;
        }
      }
      gfx->fillRoundRect(rr.x, rr.y, rr.w, rr.h, 8, rowFill);
      gfx->drawRoundRect(rr.x, rr.y, rr.w, rr.h, 8, rowBorder);
      gfx->setTextColor((hi && orangeOn) ? RGB565_WHITE : RGB565_CYAN);
      gfx->setTextSize(1);
      gfx->setCursor(rr.x + 6, rr.y + 6);
      gfx->printf("#%u", (unsigned)idx);
      gfx->setTextColor(RGB565_WHITE);
      const int addrCol = rr.x + 52;
      if (ok) {
        const char* a = g_addrPageAddr[r];
        const size_t len = strlen(a);
        const size_t MAX_PER_LINE = 40;
        gfx->setCursor(addrCol, rr.y + 4);
        size_t n1 = (len <= MAX_PER_LINE) ? len : MAX_PER_LINE;
        for (size_t i = 0; i < n1; i++) gfx->print(a[i]);
        if (len > n1) {
          gfx->setCursor(addrCol, rr.y + 22);
          for (size_t i = n1; i < len; i++) gfx->print(a[i]);
        }
      } else {
        gfx->setCursor(addrCol, rr.y + 8);
        gfx->print("Derivation failed");
        if (g_addrLastErr[0]) {
          gfx->setTextColor(RGB565_YELLOW);
          gfx->setCursor(addrCol, rr.y + 24);
          gfx->print(g_addrLastErr);
        }
      }
      if (ok && addr_status_is_used(idx)) {
        gfx->setTextColor(RGB565_RED);
        gfx->setTextSize(2);
        gfx->setCursor(addrCol + 88, rr.y + 31);
        gfx->print("Used");
        gfx->setTextSize(1);
      }
    }
  }

  drawBtn(BTN_ADDR_PREV, "PREV", RGB565_DARKGREY, 2);
  drawBtn(BTN_ADDR_NEXT, "NEXT", RGB565_DARKGREY, 2);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);
  gfx->setCursor(10, 404);
  uint32_t pStart = g_addrPage * (uint32_t)ADDR_PAGE_ROWS;
  uint32_t pEnd = pStart + (uint32_t)ADDR_PAGE_ROWS - 1u;
  if (pEnd > ADDR_MAX_INDEX) pEnd = ADDR_MAX_INDEX;
  {
    char rs[20], re[20], rm[20];
    format_u32_with_commas(rs, sizeof(rs), pStart);
    format_u32_with_commas(re, sizeof(re), pEnd);
    format_u32_with_commas(rm, sizeof(rm), ADDR_MAX_INDEX);
    gfx->printf("Range %s-%s of %s", rs, re, rm);
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    drawWipeInfoBitmapAt(infoCx, infoCy, true);
  }
  ui_flush();
  if (g_addrDeferPrefetchUntilAfterListFlush) {
    g_addrDeferPrefetchUntilAfterListFlush = false;
    // Running prefetch here blocks loop() for a long time; the highlight blink needs ~70ms redraws or the
    // two orange pulses merge into one. Defer until blink phase ends or highlight clears.
    bool blinkActive = (g_addrGotoHighlightIdx != kAddrHighlightNone && !g_addrGotoHighlightSettled);
    if (blinkActive) {
      g_addrNeighborPrefetchPending = true;
    } else if (!g_addrExplorerMultisig) {
      prefetch_address_explorer_neighbors(g_addrPage);
    }
  }
}

