// US-style thousands separators for on-screen address indices (e.g. 999999 -> "999,999").
static void format_u32_with_commas(char* buf, size_t buflen, uint32_t v) {
  if (!buf || buflen < 8) {
    if (buf && buflen) buf[0] = 0;
    return;
  }
  if (v < 1000u) {
    snprintf(buf, buflen, "%lu", (unsigned long)v);
    return;
  }
  uint32_t hi = v / 1000u;
  uint32_t lo = v % 1000u;
  if (hi < 1000u) {
    snprintf(buf, buflen, "%lu,%03lu", (unsigned long)hi, (unsigned long)lo);
    return;
  }
  uint32_t top = hi / 1000u;
  uint32_t mid = hi % 1000u;
  snprintf(buf, buflen, "%lu,%03lu,%03lu", (unsigned long)top, (unsigned long)mid, (unsigned long)lo);
}
