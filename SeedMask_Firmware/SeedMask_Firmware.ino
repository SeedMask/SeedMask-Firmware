static bool sd_card_alive() {
  return bsp_sdcard_probe();
}

static void sd_reset_ready_cache() {
  bsp_sdcard_deinit();
  g_sdReadyInitialized = false;
  g_sdReadyLastStatus = false;
  g_sdMounted = false;
}

static bool sd_presence_for_ui() {
  return g_sdPresenceUi;
}

static void sd_refresh_presence_ui_fast() {
  if (!g_sdPresenceUi) return;
  if (!sd_card_alive()) {
    sd_reset_ready_cache();
    g_sdPresenceUi = false;
  }
}

static void sd_refresh_presence_ui_full() {
  if (g_sdPresenceUi) {
    sd_refresh_presence_ui_fast();
  } else {
    g_sdPresenceUi = sd_ready();
  }
}

static bool ui_screen_shows_sd_status_icon() {
  if (g_pwListEditMode || g_noteListEditMode) return false;
  return g_screen == UIScreen::MENU || g_screen == UIScreen::CRYPTO_HOME
         || g_screen == UIScreen::PASSWORDS;
}

static void sd_poll_hotplug() {
  static uint32_t lastMs = 0;
  const uint32_t now = millis();
  if (now - lastMs < 400) return;
  lastMs = now;

  const bool prev = g_sdPresenceUi;
  sd_refresh_presence_ui_full();
  if (prev == g_sdPresenceUi) return;

  if (!g_busy && ui_screen_shows_sd_status_icon()) draw();
}

static bool sd_mount() {
  if (g_sdMounted) return true;

  // Use BSP SD card initialization instead of SPI SD
  bsp_sdcard_init();
  g_sdMounted = true;
  return true;
}

static bool sd_ready() {
  static uint32_t lastInitAttemptMs = 0;

  // Quick check first (after initial init): if mount vanished, force a re-init attempt.
  if (g_sdReadyInitialized) {
    if (!sd_card_alive()) {
      sd_reset_ready_cache();
      g_sdReadyLastStatus = false;
    } else {
      g_sdReadyLastStatus = true;
    }
  }

  // Full init path (also used as recovery). Rate-limit attempts a bit.
  if (!g_sdReadyInitialized) {
    uint32_t now = millis();
    if (now - lastInitAttemptMs < 600) {
      return false;
    }
    lastInitAttemptMs = now;

    Serial.println("sd_ready: Initializing (or recovering) SD...");
    bsp_sdcard_init();  // returns void; assume success if it doesn't crash
    g_sdReadyInitialized = true;
    g_sdReadyLastStatus = true;

    if (g_sdReadyLastStatus) g_sdReadyLastStatus = sd_test_write();

    if (g_sdReadyLastStatus) {
      if (!sd_ensure_dir("/sdcard/seedmask")) g_sdReadyLastStatus = false;
    }

    if (!g_sdReadyLastStatus) {
      g_sdReadyInitialized = false;
      g_sdMounted = false;
      return false;
    }
  }

  return g_sdReadyLastStatus;
}

// Grid scrolling (2-column lists): g_*ListScroll stores the first visible *item index*,
// but we scroll by whole rows (cols at a time). Max start must be computed by rows,
// otherwise a partially-filled last row (e.g. 9th item) becomes unreachable.
static int gridMaxStartIndex(int itemCount, int cols, int visibleRows) {
  if (itemCount <= 0) return 0;
  int totalRows = (itemCount + cols - 1) / cols;  // ceil
  int maxRowScroll = totalRows - visibleRows;
  if (maxRowScroll < 0) maxRowScroll = 0;
  return maxRowScroll * cols;  // convert row offset to item index
}

static inline uint8_t gridAlignStart(uint8_t startIdx, int cols) {
  if (cols <= 1) return startIdx;
  return (uint8_t)(startIdx - (startIdx % cols));
}

