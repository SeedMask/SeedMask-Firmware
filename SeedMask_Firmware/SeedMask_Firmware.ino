// Draw 1bpp bitmap at (x,y); color for set bits, transparent for clear
static void drawBitmap1bpp(int16_t x, int16_t y, const uint8_t* bmp, int w, int h, uint16_t color) {
  int bytesPerRow = (w + 7) / 8;
  for (int row = 0; row < h; row++) {
    for (int col = 0; col < w; col++) {
      int byteIdx = row * bytesPerRow + (col / 8);
      int bitIdx = 7 - (col % 8);
      if (pgm_read_byte(bmp + byteIdx) & (1 << bitIdx))
        gfx->drawPixel(x + col, y + row, color);
    }
  }
}

static bool bmp1bpp_get(const uint8_t* bmp, int w, int h, int col, int row) {
  if (col < 0 || row < 0 || col >= w || row >= h) return false;
  int bytesPerRow = (w + 7) / 8;
  int byteIdx = row * bytesPerRow + (col / 8);
  int bitIdx = 7 - (col % 8);
  return (pgm_read_byte(bmp + byteIdx) & (1 << bitIdx)) != 0;
}

// 1bpp mask: two colors split by the leaf midrib — infinite line through tip → stem (not screen-horizontal).
// (tipFx,tipFy) and (stemFx,stemFy) are normalized [0..1] positions in the w×h bitmap (tip = pointy end, stem = base).
// Half-planes: 2D cross product (P - tip) × (stem - tip). colorLeft / colorRight = lighter / darker lateral halves.
// midribRotateDegCw: rotate tip/stem around bitmap center so the split tracks the visual midrib (y-down screen coords).
// Optional dark fringe outside the mask to soften 1bpp edges on black.
static void drawBitmap1bppTwoToneVertical(int16_t x, int16_t y, const uint8_t* bmp, int w, int h,
                                          uint16_t colorLeft, uint16_t colorRight, bool fringeOut,
                                          float tipFx, float tipFy, float stemFx, float stemFy,
                                          float midribRotateDegCw) {
  const float wm = (w > 1) ? (float)(w - 1) : 1.0f;
  const float hm = (h > 1) ? (float)(h - 1) : 1.0f;
  float tipX = tipFx * wm;
  float tipY = tipFy * hm;
  float stemX = stemFx * wm;
  float stemY = stemFy * hm;
  if (fabsf(midribRotateDegCw) > 1e-4f) {
    const float cx = 0.5f * wm;
    const float cy = 0.5f * hm;
    const float rad = midribRotateDegCw * (3.14159265f / 180.0f);
    const float cr = cosf(rad);
    const float sr = sinf(rad);
    auto rotCw = [&](float& px, float& py) {
      float dx = px - cx;
      float dy = py - cy;
      float dx2 = dx * cr - dy * sr;
      float dy2 = dx * sr + dy * cr;
      px = cx + dx2;
      py = cy + dy2;
    };
    rotCw(tipX, tipY);
    rotCw(stemX, stemY);
  }
  const float vx = stemX - tipX;
  const float vy = stemY - tipY;

  for (int row = 0; row < h; row++) {
    for (int col = 0; col < w; col++) {
      if (!bmp1bpp_get(bmp, w, h, col, row)) continue;
      float fcol = (float)col - tipX;
      float frow = (float)row - tipY;
      float cross = fcol * vy - frow * vx;
      uint16_t px = (cross >= 0.0f) ? colorLeft : colorRight;
      gfx->drawPixel(x + col, y + row, px);
    }
  }

  if (!fringeOut) return;

  uint16_t mid = blendRGB565(colorLeft, colorRight, 0.52f);
  for (int row = 0; row < h; row++) {
    for (int col = 0; col < w; col++) {
      if (bmp1bpp_get(bmp, w, h, col, row)) continue;
      bool adj = false;
      for (int dy = -1; dy <= 1 && !adj; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
          if (dx == 0 && dy == 0) continue;
          if (bmp1bpp_get(bmp, w, h, col + dx, row + dy)) {
            adj = true;
            break;
          }
        }
      }
      if (!adj) continue;
      uint16_t px = blendRGB565(mid, RGB565_BLACK, 0.36f);
      gfx->drawPixel(x + col, y + row, px);
    }
  }
}

// Legacy horizontal gap for burger-menu chevron column (`burgerMenuChevronColumnX`); artwork is `BURGER_LEAF_UXW_*`.
#define SEED_LEAF_ICON_W 25

// Samsung-style cursor trackpad overlay: semi-transparent over whole keyboard, finger + "Cursor" centered, spacebar redrawn on top
static void drawCursorTrackpadOverlay() {
  int kbY0 = getKbY0();
  int overlayH = LCD_H - kbY0;
  uint16_t overlayColor = blend565(RGB565_BLACK, UI_CARD, 0.6f);
  uint16_t* fb = gfx->getFramebuffer();
  if (fb) {
    for (int py = kbY0; py < LCD_H; py++) {
      for (int px = 0; px < LCD_W; px++) {
        size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
        uint16_t bg = fb[idx];
        fb[idx] = (uint16_t)(((bg & 0xF7DE) >> 1) + ((overlayColor & 0xF7DE) >> 1));
      }
    }
  } else {
    gfx->fillRect(0, kbY0, LCD_W, overlayH, overlayColor);
  }
  int centerX = LCD_W / 2;
  int centerY = kbY0 + overlayH / 2;
  int fingerX = centerX - FINGER_POINT_W / 2;
  int fingerY = centerY - (FINGER_POINT_H + 14) / 2;
  drawBitmap1bpp(fingerX, fingerY, FINGER_POINT_BMP, FINGER_POINT_W, FINGER_POINT_H, UI_TEXT);
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  gfx->setCursor(centerX - 36, centerY + FINGER_POINT_H / 2 + 4);
  gfx->print("Cursor");
  const Rect& space = keyRectRow4[1];
  gfx->fillRoundRect(space.x, space.y, space.w, space.h, 10, RGB565_KEYFLASH);
  gfx->drawRoundRect(space.x, space.y, space.w, space.h, 10, UI_BORDER);
}

// Brief neutral flash when a key is tapped (light grey, not orange)
static void flashKeyRect(const Rect& r) {
  const int rad = 10;
  gfx->fillRoundRect(r.x, r.y, r.w, r.h, rad, RGB565_KEYFLASH);
  gfx->drawRoundRect(r.x, r.y, r.w, r.h, rad, UI_BORDER);
  ui_flush();
  // no delay: max typing speed, flash is overwritten by next draw() anyway
}

/** True if (px,py) lies inside a filled round-rect (matches drawBtn / drawKeyRect, rad 10). */
static bool pixel_in_fill_round_rect(int16_t px, int16_t py, int16_t rx, int16_t ry, int16_t rw, int16_t rh, int16_t rad) {
  if (rw <= 0 || rh <= 0) return false;
  if (px < rx || py < ry || px >= rx + rw || py >= ry + rh) return false;
  int16_t r = rad;
  if (r < 0) r = 0;
  int16_t maxR = rw / 2;
  if (rh / 2 < maxR) maxR = rh / 2;
  if (r > maxR) r = maxR;
  if (r <= 0) return true;
  if (px < rx + r && py < ry + r) {
    int32_t dx = (int32_t)px - (int32_t)(rx + r), dy = (int32_t)py - (int32_t)(ry + r);
    return dx * dx + dy * dy <= (int32_t)r * (int32_t)r;
  }
  if (px >= rx + rw - r && py < ry + r) {
    int32_t dx = (int32_t)px - (int32_t)(rx + rw - r), dy = (int32_t)py - (int32_t)(ry + r);
    return dx * dx + dy * dy <= (int32_t)r * (int32_t)r;
  }
  if (px < rx + r && py >= ry + rh - r) {
    int32_t dx = (int32_t)px - (int32_t)(rx + r), dy = (int32_t)py - (int32_t)(ry + rh - r);
    return dx * dx + dy * dy <= (int32_t)r * (int32_t)r;
  }
  if (px >= rx + rw - r && py >= ry + rh - r) {
    int32_t dx = (int32_t)px - (int32_t)(rx + rw - r), dy = (int32_t)py - (int32_t)(ry + rh - r);
    return dx * dx + dy * dy <= (int32_t)r * (int32_t)r;
  }
  return true;
}

/** Blend KEYFLASH over a main-menu dark card (Passwords / Notes / 2FA); same centered-square geometry as drawMenuRoundedCard. */
static void flashMainMenuDarkCard(const Rect& r) {
  const int sq = (r.w < r.h) ? r.w : r.h;
  const int x = r.x + (r.w - sq) / 2;
  const int y = r.y + (r.h - sq) / 2;
  const int rad = max(14, sq / 5);
  const float wash = 0.38f;
  uint16_t* fb = gfx->getFramebuffer();
  if (fb) {
    for (int py = y; py < y + sq && py < LCD_H; py++) {
      for (int px = x; px < x + sq && px < LCD_W; px++) {
        if (!pixel_in_fill_round_rect((int16_t)px, (int16_t)py, (int16_t)x, (int16_t)y, (int16_t)sq, (int16_t)sq, (int16_t)rad)) continue;
        size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
        uint16_t bg = fb[idx];
        fb[idx] = blend565(bg, RGB565_KEYFLASH, wash);
      }
    }
  } else {
    gfx->fillRoundRect(x, y, sq, sq, rad, RGB565_KEYFLASH);
  }
  ui_flush();
  delay(120);
}

/** Same tap feedback as flashKeyRect but blends KEYFLASH so labels stay visible (address index numpad, etc.). */
static void flashKeyRectTranslucent(const Rect& r) {
  const int rad = 10;
  const float wash = 0.48f;
  uint16_t* fb = gfx->getFramebuffer();
  if (fb) {
    for (int py = r.y; py < r.y + r.h && py < LCD_H; py++) {
      for (int px = r.x; px < r.x + r.w && px < LCD_W; px++) {
        if (!pixel_in_fill_round_rect((int16_t)px, (int16_t)py, r.x, r.y, r.w, r.h, rad)) continue;
        size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
        uint16_t bg = fb[idx];
        fb[idx] = blend565(bg, RGB565_KEYFLASH, wash);
      }
    }
  } else {
    gfx->drawRoundRect(r.x, r.y, r.w, r.h, rad, RGB565_KEYFLASH);
    gfx->drawRoundRect(r.x + 1, r.y + 1, r.w - 2, r.h - 2, rad > 2 ? rad - 2 : 2, RGB565_KEYFLASH);
  }
  ui_flush();
}

/** Translucent KEYFLASH over a disk — same wash as flashKeyRectTranslucent. If no RAM framebuffer, uses fillCircle+UI_BORDER so the tap is still visible (outline-only was nearly invisible). */
static void flashKeyCircleTranslucent(int16_t cx, int16_t cy, int16_t radius) {
  const float wash = 0.48f;
  const int32_t r2 = (int32_t)radius * (int32_t)radius;
  const int16_t x0 = (int16_t)(cx - radius);
  const int16_t y0 = (int16_t)(cy - radius);
  const int16_t x1 = (int16_t)(cx + radius);
  const int16_t y1 = (int16_t)(cy + radius);
  uint16_t* fb = gfx->getFramebuffer();
  if (fb) {
    for (int py = y0; py <= y1 && py < LCD_H; py++) {
      if (py < 0) continue;
      for (int px = x0; px <= x1 && px < LCD_W; px++) {
        if (px < 0) continue;
        int32_t dx = (int32_t)px - (int32_t)cx;
        int32_t dy = (int32_t)py - (int32_t)cy;
        if (dx * dx + dy * dy > r2) continue;
        size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
        uint16_t bg = fb[idx];
        fb[idx] = blend565(bg, RGB565_KEYFLASH, wash);
      }
    }
  } else {
    gfx->fillCircle(cx, cy, radius, RGB565_KEYFLASH);
    gfx->drawCircle(cx, cy, radius, UI_BORDER);
  }
  ui_flush();
}

/** Translucent KEYFLASH over address QR search icon (envelope stays visible); short hold so the tap is visible. */
