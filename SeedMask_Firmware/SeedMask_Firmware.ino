static void drawCardIcon(int cx, int cy, char id, uint16_t col, uint16_t bg, bool big = false) {
  switch (id) {
    case 'P':
      {
        const int ox = cx - PASSPHRASE_ICON_W / 2;
        const int oy = cy - PASSPHRASE_ICON_H / 2 - 9;
        for (int py = 0; py < PASSPHRASE_ICON_H; py++) {
          for (int px = 0; px < PASSPHRASE_ICON_W; px++) {
            uint16_t c = pgm_read_word(
              &PASSPHRASE_ICON_RGB565[(size_t)py * (size_t)PASSPHRASE_ICON_W + (size_t)px]);
            if (c == PASSPHRASE_ICON_CHROMA_KEY) continue;
            gfx->drawPixel(ox + px, oy + py, cryptoHomeRemapIconPixel(c));
          }
        }
        break;
      }
    case 'N':
      {
        // Crypto settings → New account: RGB565 asset (magenta chroma); same vertical nudge as Connect Software.
        const int ox = cx - CRYPTO_NEW_ACCOUNT_ICON_W / 2;
        const int oy = cy - CRYPTO_NEW_ACCOUNT_ICON_H / 2 - 9;
        for (int py = 0; py < CRYPTO_NEW_ACCOUNT_ICON_H; py++) {
          for (int px = 0; px < CRYPTO_NEW_ACCOUNT_ICON_W; px++) {
            uint16_t c = pgm_read_word(
              &CRYPTO_NEW_ACCOUNT_ICON_RGB565[(size_t)py * (size_t)CRYPTO_NEW_ACCOUNT_ICON_W + (size_t)px]);
            if (c == CRYPTO_NEW_ACCOUNT_ICON_CHROMA_KEY) continue;
            gfx->drawPixel(ox + px, oy + py, c);
          }
        }
        break;
      }
    case 'B':
      {
        const int ox = cx - BIP85_ICON_W / 2;
        const int oy = cy - BIP85_ICON_H / 2 - 3;
        for (int py = 0; py < BIP85_ICON_H; py++) {
          for (int px = 0; px < BIP85_ICON_W; px++) {
            uint16_t c = pgm_read_word(
              &BIP85_ICON_RGB565[(size_t)py * (size_t)BIP85_ICON_W + (size_t)px]);
            if (c == BIP85_ICON_CHROMA_KEY) continue;
            gfx->drawPixel(ox + px, oy + py, cryptoHomeRemapIconPixel(c));
          }
        }
        break;
      }
    case 'R':
      {  // Receive: 58×58 RGB565; arrow orange, hand+cuff black; magenta chroma.
