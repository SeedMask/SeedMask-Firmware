static void drawEditor(const char* title, const char* hint) {
  if (g_editMode == EditMode::ADD_NOTE_BODY || g_editMode == EditMode::EDIT_NOTE_BODY) {
    drawNoteBodyScreen();
    return;
  }
  gfx->fillScreen(RGB565_BLACK);
  // Password credential editor: never use top-bar title edit (Name is edited in the Name row only).
  if (g_editMode == EditMode::EDIT_PW_VALUE && g_editingTitle) {
    g_editingTitle = false;
    g_editMaxLen = EDIT_BUF_MAX - 1;
    if (g_viewPwIndex < pwSvc_getCount())
      edit_set(pwSvc_getValueCStr(g_viewPwIndex));
  }
  if (g_editingTitle && g_editMode != EditMode::EDIT_PW_VALUE)
    drawTopBarEditableTitle();
  else {
    const char* topTitle = (g_editMode == EditMode::EDIT_PW_VALUE) ? "" : title;
    drawTopBar(topTitle, true);
  }

  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);
  gfx->setCursor(10, 48);
  gfx->print(hint ? hint : "");

  gfx->setTextSize(2);

  bool isPwValue = (g_editMode == EditMode::ADD_PW_VALUE || g_editMode == EditMode::EDIT_PW_VALUE);
  if (isPwValue) {
    // Safety sync: password details view must always show the current stored password.
    // If editor buffer is empty on entry, reload from PasswordService.
    if (g_editMode == EditMode::EDIT_PW_VALUE && !g_pwEditKeyboardVisible && g_viewPwIndex < pwSvc_getCount() && g_editBuf[0] == 0) {
      if (!g_tmpPwValue[0]) pwEditInitTmpValueFromVault();
      edit_set(g_tmpPwValue);
      g_editViewOffset = 0;
      g_editViewOffsetPx = 0;
    }
    Rect rPwMode = pwModeBtnRect();
    bool metaActiveFocus = (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && pwEditIsMetaFocusField(g_pwEditFocusField));
    bool pwActiveFocus = (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && pwEditIsPasswordFocusField(g_pwEditFocusField));
    const bool isPwEditDetails = (g_editMode == EditMode::EDIT_PW_VALUE);
    const uint16_t pwDetailEditOutlineBlue = blendRGB565(RGB565_BLUE, RGB565_WHITE, 0.22f);  // same fill as EDIT pill
    const bool pwUnlockedBrowseFiveCards =
      isPwEditDetails && g_pwEditUnlocked && !g_pwEditKeyboardVisible && !metaActiveFocus && !pwActiveFocus;
    if (isPwEditDetails && !metaActiveFocus && !pwActiveFocus) {
      if (g_viewPwIndex < pwSvc_getCount())
        drawPwCredentialAvatarForIndex(g_viewPwIndex, PW_EDIT_AVATAR_X, PW_EDIT_AVATAR_Y, PW_DETAIL_AVATAR_SIZE);
      const Rect dName = { 24, PW_EDIT_ROW_NAME_Y, PW_EDIT_DETAIL_W, 40 };
      const Rect dUser = { 24, PW_EDIT_ROW_USER_Y, PW_EDIT_DETAIL_W, 40 };
      const Rect dSite = { 24, PW_EDIT_ROW_SITE_Y, PW_EDIT_DETAIL_W, 40 };
      const Rect dNotes = { 24, PW_EDIT_ROW_NOTES_Y, PW_EDIT_DETAIL_W, 40 };
      const Rect details[4] = { dName, dUser, dSite, dNotes };
      static const uint8_t kPwDetailBrowseFieldId[4] = { PW_FOCUS_NAME, PW_FOCUS_USER, PW_FOCUS_SITE, PW_FOCUS_NOTES };
      const char* labels[4] = { "Name", "Username/Email", "Website/App", "Notes" };
      const char* values[4] = { g_tmpTitle, g_tmpUser, g_tmpWebsite, g_tmpPwNotes };
      for (int i = 0; i < 4; i++) {
        if (details[i].y + details[i].h < 46 || details[i].y > LCD_H) continue;
        bool active = (g_pwEditKeyboardVisible && g_pwEditFocusField == kPwDetailBrowseFieldId[i]);
        gfx->fillRoundRect(details[i].x, details[i].y, details[i].w, details[i].h, 6, UI_CARD);
        gfx->drawRoundRect(details[i].x, details[i].y, details[i].w, details[i].h, 6,
                           active ? UI_ACCENT : (pwUnlockedBrowseFiveCards ? pwDetailEditOutlineBlue : UI_BORDER));
        gfx->setTextColor(RGB565_DARKGREY);
        gfx->setTextSize(1);
        int lblX = details[i].x + (details[i].w - (int)strlen(labels[i]) * 6) / 2;
        if (lblX < details[i].x) lblX = details[i].x;
        gfx->setCursor(lblX, details[i].y - 9);
        gfx->print(labels[i]);
        gfx->setTextColor(UI_TEXT);
        gfx->setTextSize(2);
        int valX = details[i].x + 8;
        gfx->setCursor(valX, details[i].y + 11);
        int maxChars = (details[i].w - 16) / 12;
        if (!active) {
          char shown[96];
          strncpy(shown, values[i] ? values[i] : "", sizeof(shown) - 1);
          shown[sizeof(shown) - 1] = 0;
          if ((int)strlen(shown) > maxChars && maxChars > 3) {
            shown[maxChars - 3] = '.';
            shown[maxChars - 2] = '.';
            shown[maxChars - 1] = '.';
            shown[maxChars] = 0;
          }
          gfx->print(shown);
        } else {
          uint16_t* view = (kPwDetailBrowseFieldId[i] == PW_FOCUS_NAME)   ? &g_addPwViewName
                           : (kPwDetailBrowseFieldId[i] == PW_FOCUS_USER) ? &g_addPwViewUser
                           : (kPwDetailBrowseFieldId[i] == PW_FOCUS_SITE) ? &g_addPwViewSite
                                                                          : &g_addPwViewNotes;
          uint16_t* cur = (kPwDetailBrowseFieldId[i] == PW_FOCUS_NAME)   ? &g_addPwCursorName
                          : (kPwDetailBrowseFieldId[i] == PW_FOCUS_USER) ? &g_addPwCursorUser
                          : (kPwDetailBrowseFieldId[i] == PW_FOCUS_SITE) ? &g_addPwCursorSite
                                                                         : &g_addPwCursorNotes;
          size_t lenA = strlen(g_editBuf);
          if (g_editCursor > lenA) g_editCursor = (uint16_t)lenA;
          *cur = g_editCursor;
          if (*view > (uint16_t)lenA) *view = (uint16_t)lenA;
          if (g_editCursor < *view) *view = g_editCursor;
          else if (g_editCursor > (uint16_t)(*view + maxChars)) *view = (uint16_t)(g_editCursor - maxChars);
          uint16_t start = *view;
          uint16_t end = (uint16_t)lenA;
          if (end > (uint16_t)(start + maxChars)) end = (uint16_t)(start + maxChars);
          char shown[96];
          uint16_t o = 0;
          for (uint16_t k = start; k < end && o < sizeof(shown) - 1; k++) shown[o++] = g_editBuf[k];
          shown[o] = 0;
          gfx->print(shown);
          bool cursorOn = cursorShouldBeSolidNow() || (((millis() / 700) & 1) == 0);
          if (cursorOn) {
            int cx = details[i].x + 8 + ((int)g_editCursor - (int)start) * 12;
            int cy = details[i].y + 11;
            if (cx < details[i].x + 8) cx = details[i].x + 8;
            if (cx > details[i].x + details[i].w - 8) cx = details[i].x + details[i].w - 8;
            gfx->drawLine(cx, cy - 2, cx, cy + 14, UI_ACCENT);
          }
        }
      }
      if (!g_pwEditUnlocked) {
        if (g_pwEditorSendPickerActive)
          drawBtn(pwEditUnlockBtnRect(), tr("Cancel", "Otkazi"), RGB565_ORANGE, 2);
        else
          drawBtn(pwEditUnlockBtnRect(), "EDIT", pwDetailEditOutlineBlue, 2);
      } else {
        if (g_pwEditorSendPickerActive)
          drawBtn(pwSaveBtnRect(), tr("Cancel", "Otkazi"), RGB565_ORANGE, 2);
        else
          drawBtn(pwSaveBtnRect(), "SAVE", uiSaveButtonFill565(), 2);
      }
      drawBtn(pwEditorSendCancelBtnRect(), tr("Send", "Posalji"), pwEditorSendBtnBlue565(), 2);
    } else if (isPwEditDetails && metaActiveFocus) {
      // Active metadata field mode: show only focused field, like password active mode.
      const int y = rPwMode.y - 65;
      const Rect a = { 24, (int16_t)y, PW_EDIT_DETAIL_W, 48 };
      const char* label = (g_pwEditFocusField == PW_FOCUS_NAME)   ? "Name"
                          : (g_pwEditFocusField == PW_FOCUS_USER) ? "Username/Email"
                          : (g_pwEditFocusField == PW_FOCUS_SITE) ? "Website/App"
                                                                  : "Notes";
      gfx->setTextColor(UI_TEXT);
      gfx->setTextSize(1);
      gfx->setCursor(24, y - 12);
      gfx->print("Edit ");
      gfx->print(label);
      gfx->fillRoundRect(a.x, a.y, a.w, a.h, 10, UI_CARD);
      gfx->drawRoundRect(a.x, a.y, a.w, a.h, 10, UI_ACCENT);
      gfx->setTextColor(RGB565_DARKGREY);
      gfx->setTextSize(1);
      int lblX = a.x + (a.w - (int)strlen(label) * 6) / 2;
      if (lblX < a.x) lblX = a.x;
      gfx->setCursor(lblX, a.y - 9);
      gfx->print(label);
      gfx->setTextColor(UI_TEXT);
      gfx->setTextSize(2);
      const int maxChars = (a.w - 16) / 12;
      uint16_t* view = (g_pwEditFocusField == PW_FOCUS_NAME)   ? &g_addPwViewName
                       : (g_pwEditFocusField == PW_FOCUS_USER) ? &g_addPwViewUser
                       : (g_pwEditFocusField == PW_FOCUS_SITE) ? &g_addPwViewSite
                                                               : &g_addPwViewNotes;
      size_t lenA = strlen(g_editBuf);
      if (g_editCursor > lenA) g_editCursor = (uint16_t)lenA;
      if (*view > (uint16_t)lenA) *view = (uint16_t)lenA;
      if (g_editCursor < *view) *view = g_editCursor;
      else if (g_editCursor > (uint16_t)(*view + maxChars)) *view = (uint16_t)(g_editCursor - maxChars);
      uint16_t start = *view;
      uint16_t end = (uint16_t)lenA;
      if (end > (uint16_t)(start + maxChars)) end = (uint16_t)(start + maxChars);
      char shown[96];
      uint16_t o = 0;
      for (uint16_t k = start; k < end && o < sizeof(shown) - 1; k++) shown[o++] = g_editBuf[k];
      shown[o] = 0;
      gfx->setCursor(a.x + 8, a.y + 15);
      gfx->print(shown);
      bool cursorOn = cursorShouldBeSolidNow() || (((millis() / 700) & 1) == 0);
      if (cursorOn) {
        int cx = a.x + 8 + ((int)g_editCursor - (int)start) * 12;
        if (cx < a.x + 8) cx = a.x + 8;
        if (cx > a.x + a.w - 8) cx = a.x + a.w - 8;
        gfx->drawLine(cx, a.y + 13, cx, a.y + 31, UI_ACCENT);
      }
      gfx->setTextColor(RGB565_DARKGREY);
      gfx->setTextSize(1);
    }

    // When editing title: show saved value in box, no cursor. Else: g_editBuf and cursor.
    const char* pwDisplayBuf = g_editBuf;
    size_t len = strlen(g_editBuf);
    // In password details view (or metadata-focus editing), always render the real stored password,
    // not whichever metadata field text currently lives in g_editBuf.
    if (g_editMode == EditMode::EDIT_PW_VALUE && !pwEditIsPasswordFocusField(g_pwEditFocusField)) {
      pwDisplayBuf = g_tmpPwValue;
      len = strlen(pwDisplayBuf);
    }
    if (g_editingTitle && g_viewPwIndex < pwSvc_getCount()) {
      pwDisplayBuf = pwSvc_getValueCStr(g_viewPwIndex);
      len = strlen(pwDisplayBuf);
    }
    // g_editCursor indexes g_editBuf (active field). Never clamp it to `len` above — that is only for
    // drawing the password strip (stored PW while editing Name/User/Site/Notes is shorter than metadata).
    {
      size_t editLen = strlen(g_editBuf);
      if (g_editCursor > editLen) g_editCursor = (uint16_t)editLen;
    }

    const int boxX = 24, boxW = 272;
    const int boxY =
      pwActiveFocus ? pwValueStripBoxYKeyboardOpen()
                    : (isPwEditDetails ? PW_EDIT_ROW_PASS_Y : 60);
    // Credential details grid: password row matches metadata cards (40px, r=6); add-password strip stays taller.
    const bool pwDetailStaticGrid = isPwEditDetails && !metaActiveFocus && !pwActiveFocus;
    const int boxH = pwDetailStaticGrid ? 40 : 48;
    const int pwCardRadius = pwDetailStaticGrid ? 6 : 12;
    const int pwPadding = 12;
    const int pwCharW = 12;
    const int maxChars = (boxW - pwPadding * 2) / pwCharW;

    const bool pwPickerCoversPassword = (isPwEditDetails && g_pwEditorSendPickerActive);
    if (!metaActiveFocus && boxY + boxH > 46 && boxY < LCD_H && !pwPickerCoversPassword) {
      gfx->fillRoundRect(boxX, boxY, boxW, boxH, pwCardRadius, UI_CARD);
      uint16_t pwBorderCol = UI_ACCENT;
      if (pwDetailStaticGrid && pwUnlockedBrowseFiveCards)
        pwBorderCol = pwDetailEditOutlineBlue;
      else if (pwDetailStaticGrid || (isPwEditDetails && !g_pwEditUnlocked))
        pwBorderCol = UI_BORDER;
      gfx->drawRoundRect(boxX, boxY, boxW, boxH, pwCardRadius, pwBorderCol);
      if (isPwEditDetails) {
        gfx->setTextColor(RGB565_DARKGREY);
        gfx->setTextSize(1);
        int lblX = boxX + (boxW - (int)strlen("Password") * 6) / 2;
        if (lblX < boxX) lblX = boxX;
        gfx->setCursor(lblX, boxY - 9);
        gfx->print("Password");
      }
    }
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(2);
    const int pwY = pwDetailStaticGrid ? (boxY + 11) : (boxY + (boxH - 16) / 2);
    gfx->setCursor(boxX + pwPadding, pwY);

    if (!metaActiveFocus && len > 0 && !pwPickerCoversPassword) {
      if (g_editingTitle) {
        // Show saved value only (no scroll, no cursor)
        size_t n = (size_t)maxChars;
        if (n > len) n = len;
        for (size_t i = 0; i < n; ++i) {
          gfx->setCursor(boxX + pwPadding + (int)i * pwCharW, pwY);
          gfx->print(pwDisplayBuf[i]);
        }
      } else {
        // Ensure cursor is visible within the current window
        if (g_editCursor < g_editViewOffset) {
          g_editViewOffset = g_editCursor;
          g_editViewOffsetPx = 0;
        } else if (g_editCursor > g_editViewOffset + maxChars) {
          g_editViewOffset = g_editCursor - maxChars;
          g_editViewOffsetPx = 0;
        }
        // When string shrunk (e.g. backspace), show start of remaining string so user can keep deleting
        if (g_editViewOffset > (uint16_t)len)
          g_editViewOffset = ((uint16_t)len >= (uint16_t)maxChars) ? (uint16_t)((uint16_t)len - maxChars) : 0;

        size_t start = g_editViewOffset;
        size_t end = start + maxChars + 1;  // +1 so partial last char is drawn when smooth-scrolling
        if (end > len) end = len;

        int drawX = boxX + pwPadding - g_editViewOffsetPx;
        for (size_t i = start; i < end; ++i) {
          gfx->setCursor(drawX, pwY);
          gfx->print(pwDisplayBuf[i]);
          drawX += pwCharW;
        }
      }
    }

    // Cursor in password box only when that row is actively focused (same rule as metadata rows after EDIT unlock).
    const bool bip85IndexActive =
      (g_pwGenMode == PwGenMode::BIP85 && (g_pwBip85IndexEditing || g_pwBip85PassphraseEditing));
    const bool pwCaretAllowed =
      !isPwEditDetails || (g_pwEditKeyboardVisible && pwEditIsPasswordFocusField(g_pwEditFocusField));
    if (!metaActiveFocus && !g_editingTitle && pwCaretAllowed && !pwPickerCoversPassword && !bip85IndexActive) {
      bool cursorOn = cursorShouldBeSolidNow() || (((millis() / 700) & 1) == 0);
      if (cursorOn) {
        int cursorX;
        if (len == 0) {
          cursorX = boxX + pwPadding;
        } else {
          cursorX = boxX + pwPadding - g_editViewOffsetPx + (int)((int)g_editCursor - (int)g_editViewOffset) * pwCharW;
        }
        const int cursorTop = pwDetailStaticGrid ? (pwY - 2) : (pwY - 14);
        const int cursorBottom = pwY + 14;
        gfx->drawLine(cursorX, cursorTop, cursorX, cursorBottom, UI_ACCENT);
      }
    }
    if (g_pwEditorSendPickerActive && isPwEditDetails && !metaActiveFocus && !pwActiveFocus) {
      drawPwEditorSendPickerOverlay();
    }

    // Password strength meter + reason (add-password flow, or password-details when Password row focused)
    if (len > 0 && !g_editingTitle && (!isPwEditDetails || pwActiveFocus)) {
      uint8_t score = 0;
      const char* reason = nullptr;
      if (g_pwGenMode == PwGenMode::DICEWARE || g_pwGenMode == PwGenMode::BIP85) {
        score = password_strength_score_diceware(g_editBuf);
        reason = password_strength_reason_diceware(g_editBuf);
      } else {  // RANDOM CHARS mode
        score = password_strength_score_random(g_editBuf);
        reason = password_strength_reason_random(g_editBuf);
      }
      // Place the bar a bit lower below the field, above the generator buttons
      int barY = boxY + boxH + 22;
      drawPasswordStrengthBar(10, barY, 300, score);
      bool doneActive = diceware_manual_done_active();
      bool doneApplied = diceware_manual_done_applied();
      bool showDoneToggle = (diceware_manual_prompt_eligible(g_editBuf) && (!doneApplied || doneActive));
      if (showDoneToggle || (score == 0 && reason && reason[0])) {
        uint16_t reasonCol = (showDoneToggle && doneActive) ? RGB565_DARKGREY : RGB565_RED;
        const char* shownReason = (showDoneToggle ? "generate randomly instead" : reason);
        gfx->setTextColor(reasonCol);
        gfx->setTextSize(1);
        gfx->setCursor(10, barY + 16);  // just below the bar
        gfx->print(shownReason);
      }
      if (showDoneToggle) {
        Rect cb = diceware_manual_done_checkbox_rect(barY);
        gfx->drawRect(cb.x, cb.y, cb.w, cb.h, UI_TEXT);
        if (doneActive) {
          gfx->drawLine(cb.x + 2, cb.y + 6, cb.x + 5, cb.y + 9, UI_SUCCESS);
          gfx->drawLine(cb.x + 5, cb.y + 9, cb.x + 10, cb.y + 2, UI_SUCCESS);
        }
        gfx->setTextColor(doneActive ? RGB565_DARKGREY : UI_TEXT);
        gfx->setTextSize(1);
        gfx->setCursor(cb.x + cb.w + 4, barY + 21);
        gfx->print("Done already");
      }
    }
  } else if (isAddPwMetaMode(g_editMode)) {
    const Rect f1 = { 16, 66, 288, 40 };
    const Rect f2 = { 16, 112, 288, 40 };
    const Rect f3 = { 16, 158, 288, 40 };
    const Rect f4 = { 16, 204, 288, 40 };
    const char* v1 = (g_editMode == EditMode::ADD_PW_TITLE) ? g_editBuf : g_tmpTitle;
    const char* v2 = (g_editMode == EditMode::ADD_PW_USER) ? g_editBuf : g_tmpUser;
    const char* v3 = (g_editMode == EditMode::ADD_PW_SITE) ? g_editBuf : g_tmpWebsite;
    const char* v4 = (g_editMode == EditMode::ADD_PW_NOTES) ? g_editBuf : g_tmpPwNotes;
    const Rect fields[4] = { f1, f2, f3, f4 };
    const char* labels[4] = { "Name", "Username/Email", "Website/App", "Notes" };
    const char* values[4] = { v1, v2, v3, v4 };
    for (int i = 0; i < 4; i++) {
      bool active = ((i == 0 && g_editMode == EditMode::ADD_PW_TITLE) || (i == 1 && g_editMode == EditMode::ADD_PW_USER) || (i == 2 && g_editMode == EditMode::ADD_PW_SITE) || (i == 3 && g_editMode == EditMode::ADD_PW_NOTES));
      gfx->fillRoundRect(fields[i].x, fields[i].y, fields[i].w, fields[i].h, 10, UI_CARD);
      gfx->drawRoundRect(fields[i].x, fields[i].y, fields[i].w, fields[i].h, 10, active ? UI_ACCENT : UI_BORDER);
      gfx->setTextColor(RGB565_DARKGREY);
      gfx->setTextSize(1);
      gfx->setCursor(fields[i].x + 8, fields[i].y + 4);
      gfx->print(labels[i]);
      gfx->setTextColor(UI_TEXT);
      gfx->setTextSize(2);
      const int maxChars = (fields[i].w - 16) / 12;
      const int textY = fields[i].y + 18;
      const char* vv = values[i] ? values[i] : "";
      if (!active) {
        char shown[96];
        strncpy(shown, vv, sizeof(shown) - 1);
        shown[sizeof(shown) - 1] = 0;
        if ((int)strlen(shown) > maxChars && maxChars > 3) {
          shown[maxChars - 3] = '.';
          shown[maxChars - 2] = '.';
          shown[maxChars - 1] = '.';
          shown[maxChars] = 0;
        }
        gfx->setCursor(fields[i].x + 8, textY);
        gfx->print(shown);
      } else {
        size_t len = strlen(g_editBuf);
        uint16_t* v = (i == 0) ? &g_addPwViewName : (i == 1) ? &g_addPwViewUser
                                                  : (i == 2) ? &g_addPwViewSite
                                                             : &g_addPwViewNotes;
        if (*v > (uint16_t)len) *v = (uint16_t)len;
        if (g_editCursor < *v) *v = g_editCursor;
        else if (g_editCursor > (uint16_t)(*v + maxChars)) *v = (uint16_t)(g_editCursor - maxChars);
        char shown[96];
        uint16_t start = *v;
        uint16_t end = (uint16_t)len;
        if (end > (uint16_t)(start + maxChars)) end = (uint16_t)(start + maxChars);
        uint16_t out = 0;
        for (uint16_t k = start; k < end && out < sizeof(shown) - 1; k++) shown[out++] = g_editBuf[k];
        shown[out] = 0;
        gfx->setCursor(fields[i].x + 8, textY);
        gfx->print(shown);
      }
    }
    // Cursor on active row
    bool cursorOn = cursorShouldBeSolidNow() || (((millis() / 700) & 1) == 0);
    if (cursorOn) {
      int charW = 12;
      uint16_t v = (g_editMode == EditMode::ADD_PW_TITLE)  ? g_addPwViewName
                   : (g_editMode == EditMode::ADD_PW_USER) ? g_addPwViewUser
                   : (g_editMode == EditMode::ADD_PW_SITE) ? g_addPwViewSite
                                                           : g_addPwViewNotes;
      int x = f1.x + 8 + ((int)g_editCursor - (int)v) * charW;
      int y = (g_editMode == EditMode::ADD_PW_TITLE)  ? (f1.y + 18)
              : (g_editMode == EditMode::ADD_PW_USER) ? (f2.y + 18)
              : (g_editMode == EditMode::ADD_PW_SITE) ? (f3.y + 18)
                                                      : (f4.y + 18);
      if (x < 24) x = 24;
      if (x > 304) x = 304;
      gfx->drawLine(x, y - 2, x, y + 14, UI_ACCENT);
    }
  } else {
    gfx->setCursor(10, 74);
    gfx->print("> ");
    gfx->print(g_editBuf);
  }

  if (!(g_editMode == EditMode::EDIT_PW_VALUE && !g_pwEditKeyboardVisible))
    drawKeyboard();
  // No generic BACK button in editor; use swipe or keyboard OK/navigation to leave

  if (isPwValue && (g_editMode != EditMode::EDIT_PW_VALUE || (g_pwEditKeyboardVisible && pwEditIsPasswordFocusField(g_pwEditFocusField)))) {
    Rect rAdv = pwAdvancedBtnRect();
    Rect rPwMode = pwModeBtnRect();
    Rect rPwGen = pwGenBtnRect();
    Rect rPwMinus = pwMinusBtnRect();
    Rect rPwPlus = pwPlusBtnRect();
    Rect rPwWords = pwWordsBtnRect();
    {
      gfx->setTextColor(UI_ACCENT);
      gfx->setTextSize(1);
      const char* advLab = "Advanced";
      int16_t abx, aby;
      uint16_t abw, abh;
      gfx->getTextBounds(advLab, 0, 0, &abx, &aby, &abw, &abh);
      int16_t advTx = (LCD_W - (int16_t)abw) / 2;
      gfx->setCursor(advTx, rAdv.y + 8);
      gfx->print(advLab);
    }
    // Generator row: DICEWARE / RANDOM / BIP85 + GENERATE + controls.
    drawBtn(rPwGen, "GENERATE", RGB565_BLUE, 1);
    if (g_pwGenMode == PwGenMode::BIP85) {
      Rect rIdx = pwBip85IndexFieldRect();
      const uint16_t idxBg = 0x39E7;  // darker gray
      gfx->fillRoundRect(rIdx.x, rIdx.y, rIdx.w, rIdx.h, 10, idxBg);
      gfx->drawRoundRect(rIdx.x, rIdx.y, rIdx.w, rIdx.h, 10, RGB565_WHITE);
      gfx->setTextSize(1);
      const int tx = rIdx.x + 10;
      const int ty = rIdx.y + (rIdx.h / 2 - 6);
      if (g_pwBip85PassphraseEditing) {
        gfx->setTextColor(UI_TEXT);
        gfx->setCursor(tx, ty - 6);
        gfx->print("Passphrase");
        gfx->setCursor(tx, ty + 6);
        size_t pl = strlen(g_pwBip85PassphraseInput);
        for (size_t i = 0; i < pl && i < 36; i++) gfx->print("*");
        bool cursorOn = (((millis() / 500) & 1) == 0);
        if (cursorOn) {
          int cx = tx + (int)pl * 6;
          if (cx > rIdx.x + rIdx.w - 6) cx = rIdx.x + rIdx.w - 6;
          gfx->drawLine(cx, ty + 4, cx, ty + 14, UI_TEXT);
        }
      } else if (g_pwBip85IndexBuf[0]) {
        char idxTxt[24];
        snprintf(idxTxt, sizeof(idxTxt), "Index: %s", g_pwBip85IndexBuf);
        gfx->setTextColor(UI_TEXT);
        gfx->setCursor(tx, ty);
        gfx->print(idxTxt);
      } else {
        gfx->setTextColor(0xC618);  // faded white placeholder
        gfx->setCursor(tx, ty);
        gfx->print("Insert index");
      }
      if (g_pwBip85IndexEditing && !g_pwBip85PassphraseEditing) {
        bool cursorOn = (((millis() / 500) & 1) == 0);
        if (cursorOn) {
          int cx = tx;  // always blink at beginning of the input field while editing
          if (g_pwBip85IndexBuf[0]) {
            int16_t dbx, dby;
            uint16_t dbw, dbh;
            char idxTxt[24];
            snprintf(idxTxt, sizeof(idxTxt), "Index: %s", g_pwBip85IndexBuf);
            gfx->getTextBounds(idxTxt, tx, ty, &dbx, &dby, &dbw, &dbh);
            cx = tx + (int)dbw;
          }
          if (cx > rIdx.x + rIdx.w - 6) cx = rIdx.x + rIdx.w - 6;
          gfx->drawLine(cx, ty - 1, cx, ty + 9, UI_TEXT);
        }
      }
    } else {
      drawBtn(rPwMinus, "-", RGB565_DARKGREY, 1);
      drawBtn(rPwPlus, "+", RGB565_DARKGREY, 1);
    }

    // MODE button (toggle) with premium transition when switching DICEWARE <-> RANDOM CHARS
    {
      uint32_t now = millis();
      if (g_pwModeTransitionStartMs != 0 && (now - g_pwModeTransitionStartMs) >= 280)
        g_pwModeTransitionStartMs = 0;
      if (g_pwModeTransitionStartMs != 0 && g_pwGenMode != PwGenMode::BIP85) {
        uint32_t elapsed = now - g_pwModeTransitionStartMs;
        float t = (float)elapsed / 280.0f;
        if (t > 1.0f) t = 1.0f;
        t = 1.0f - (1.0f - t) * (1.0f - t);  // ease-out
        uint16_t fromC = g_pwModeTransitionFromDiceware ? RGB565_BLUE : RGB565_DARKGREEN;
        uint16_t toC = g_pwModeTransitionFromDiceware ? RGB565_DARKGREEN : RGB565_BLUE;
        int r0 = (fromC >> 11) & 0x1F, g0 = (fromC >> 5) & 0x3F, b0 = fromC & 0x1F;
        int r1 = (toC >> 11) & 0x1F, g1 = (toC >> 5) & 0x3F, b1 = toC & 0x1F;
        int r = (int)(r0 + (r1 - r0) * t), g = (int)(g0 + (g1 - g0) * t), b = (int)(b0 + (b1 - b0) * t);
        if (r > 31) r = 31;
        if (r < 0) r = 0;
        if (g > 63) g = 63;
        if (g < 0) g = 0;
        if (b > 31) b = 31;
        if (b < 0) b = 0;
        uint16_t color = (uint16_t)((r << 11) | (g << 5) | b);
        float scale = 1.0f + 0.08f * 4.0f * t * (1.0f - t);  // subtle pop at t=0.5
        int dx = (int)((rPwMode.w * (scale - 1.0f)) / 2.0f);
        int dy = (int)((rPwMode.h * (scale - 1.0f)) / 2.0f);
        Rect rScaled = { (int16_t)(rPwMode.x - dx), (int16_t)(rPwMode.y - dy), (int16_t)(rPwMode.w + 2 * dx), (int16_t)(rPwMode.h + 2 * dy) };
        drawBtn(rScaled, g_pwGenMode == PwGenMode::DICEWARE ? "DICEWARE" : "RANDOM CHARS", color, 1);
      } else {
        if (g_pwGenMode == PwGenMode::DICEWARE) {
          drawBtn(rPwMode, "DICEWARE", RGB565_BLUE, 1);
        } else if (g_pwGenMode == PwGenMode::RANDOM) {
          drawBtn(rPwMode, "RANDOM CHARS", RGB565_DARKGREEN, 1);
        } else {
          drawBtn(rPwMode, "BIP85", RGB565_AMBER, 1);
        }
      }
    }

    // Count label: words (diceware), chars (random), or BIP85 selector.
    char tmp[20];
    if (g_pwGenMode == PwGenMode::DICEWARE)
      snprintf(tmp, sizeof(tmp), "%u words", (unsigned)g_pwGenWords);
    else if (g_pwGenMode == PwGenMode::RANDOM)
      snprintf(tmp, sizeof(tmp), "%u chars", (unsigned)g_randLen);
    else
      snprintf(tmp, sizeof(tmp), "%u words", (unsigned)g_pwBip85WordCount);
    drawBtn(rPwWords, tmp, RGB565_BLACK, 1);
    if (g_pwAdvancedPanelOpen) drawPwAdvancedGeneratorOverlay();
  }

  // Long-press popup: window with full password (height fits content, up to max)
  if (isPwValue && g_pwShowFullPopup && g_editBuf[0]) {
    const int pad = 12, lineH = 10, charsPerLine = 42;
    const int tapLineH = 14;  // "Tap to close" row
    size_t len = strlen(g_editBuf);
    int linesNeeded = (int)((len + charsPerLine - 1) / charsPerLine);
    if (linesNeeded < 1) linesNeeded = 1;
    int maxLines = (EDIT_BUF_MAX + charsPerLine - 1) / charsPerLine;
    if (linesNeeded > maxLines) linesNeeded = maxLines;
    int contentH = linesNeeded * lineH;
    int popupH = contentH + pad + tapLineH + pad;
    if (popupH > LCD_H - 40) popupH = LCD_H - 40;
    const int popupW = 280, popupR = 12;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    int contentTop = popupY + pad;
    int contentBottom = popupY + popupH - pad - tapLineH;  // content area = [contentTop, contentBottom)

    gfx->fillRoundRect(popupX, popupY, popupW, popupH, popupR, UI_CARD);
    gfx->drawRoundRect(popupX, popupY, popupW, popupH, popupR, UI_ACCENT);

    gfx->setTextSize(1);
    gfx->setTextColor(UI_TEXT);
    int yy = contentTop;
    for (size_t i = 0; i < len && yy + lineH <= contentBottom; i += charsPerLine) {
      gfx->setCursor(popupX + pad, yy);
      size_t n = (size_t)charsPerLine;
      if (i + n > len) n = len - i;
      for (size_t k = 0; k < n; k++) gfx->print(g_editBuf[i + k]);
      yy += lineH;
    }

    gfx->setCursor(popupX + pad, popupY + popupH - pad - tapLineH);
    gfx->setTextColor(UI_ACCENT);
    gfx->print("Tap to close");
  }

  // Generate will replace current password — real semi-transparent popup via framebuffer blend
  if (g_showPwGenerateConfirm) {
    const int popupW = 260, popupH = 140, popupR = 12;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    uint16_t* fb = gfx->getFramebuffer();
    if (fb) {
      // 50% blend of existing pixels with UI_CARD (RGB565: average each component)
      for (int py = popupY; py < popupY + popupH; py++) {
        for (int px = popupX; px < popupX + popupW; px++) {
          size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
          uint16_t bg = fb[idx];
          fb[idx] = (uint16_t)(((bg & 0xF7DE) >> 1) + ((UI_CARD & 0xF7DE) >> 1));
        }
      }
    } else {
      gfx->fillRoundRect(popupX, popupY, popupW, popupH, popupR, UI_CARD);
    }
    gfx->drawRoundRect(popupX, popupY, popupW, popupH, popupR, UI_ACCENT);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(2);
    gfx->setCursor(popupX + 12, popupY + 12);
    gfx->print("This will replace");
    gfx->setCursor(popupX + 12, popupY + 32);
    gfx->print("your password.");
    gfx->setCursor(popupX + 12, popupY + 54);
    gfx->print("Continue?");
    drawBtn(Rect{ popupX + 20, popupY + 82, 100, 44 }, "Yes", RGB565_RED, 2);
    drawBtn(Rect{ popupX + 140, popupY + 82, 100, 44 }, "Cancel", RGB565_DARKGREY, 2);
  }
  if (g_msg[0] && !g_pwEditExitPrompt && !g_showPwGenerateConfirm && !g_pwShowFullPopup)
    menu_draw_message_card_overlay();

  if (g_pwEditExitPrompt) {
    const int popupW = 282, popupH = 148, popupR = 12;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    gfx->fillRoundRect(popupX, popupY, popupW, popupH, popupR, UI_CARD);
    gfx->drawRoundRect(popupX, popupY, popupW, popupH, popupR, UI_ACCENT);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(1);
    gfx->setCursor(popupX + 12, popupY + 16);
    gfx->print("Unsaved changes");
    gfx->setCursor(popupX + 12, popupY + 32);
    gfx->print("Save changes before leaving?");
    drawBtn(Rect{ (int16_t)(popupX + 8), (int16_t)(popupY + 82), 84, 44 }, "Save", RGB565_GREEN, 1);
    drawBtn(Rect{ (int16_t)(popupX + 99), (int16_t)(popupY + 82), 94, 44 }, "Don't save", RGB565_ORANGE, 1);
    drawBtn(Rect{ (int16_t)(popupX + 201), (int16_t)(popupY + 82), 74, 44 }, "Cancel", RGB565_DARKGREY, 1);
  }

  ui_flush();
}

// Set by composePasswordTitleMeta(); defined before handleEditorTap uses it after compose.
static bool g_pwMetaComposeTruncated = false;

static void handleEditorTap(uint16_t x, uint16_t y) {
  if (g_sdSavePathPickOpen) return;
  if (nav_bar_home_tap_hit((int16_t)x, (int16_t)y)) return;
  bool keyboardVisibleForEditor = !(g_editMode == EditMode::EDIT_PW_VALUE && !g_pwEditKeyboardVisible);
  if (g_pwEditExitPrompt) {
    const int popupW = 282, popupH = 148;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    Rect rSave = { (int16_t)(popupX + 8), (int16_t)(popupY + 82), 84, 44 };
    Rect rDont = { (int16_t)(popupX + 99), (int16_t)(popupY + 82), 94, 44 };
    Rect rCancel = { (int16_t)(popupX + 201), (int16_t)(popupY + 82), 74, 44 };
    if (hit(rSave, x, y)) {
      pwEditSaveAndExit();
      return;
    }
    if (hit(rDont, x, y)) {
      g_pwEditExitPrompt = false;
      exitEditor();
      show(g_prevScreen);
      return;
    }
    if (hit(rCancel, x, y)) {
      g_pwEditExitPrompt = false;
      draw();
      return;
    }
    return;
  }
  // Generate-replace confirm popup: Yes = generate into field, Cancel = close
  if (g_showPwGenerateConfirm) {
    const int popupW = 260, popupH = 140;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    Rect rYes = { (int16_t)(popupX + 20), (int16_t)(popupY + 82), 100, 44 };
    Rect rCancel = { (int16_t)(popupX + 140), (int16_t)(popupY + 82), 100, 44 };
    if (hit(rYes, x, y)) {
      flashKeyRect(rYes);
      g_showPwGenerateConfirm = false;
      g_pwGenerateConfirmShownThisSession = true;  // next Generate this session: no popup
      edit_clear();
      if (g_pwGenMode == PwGenMode::DICEWARE) {
        diceware_generate(g_editBuf, sizeof(g_editBuf), g_pwGenWords);
        if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount())
          pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::DICEWARE, 0, 12, 0, 0, 4);
      } else if (g_pwGenMode == PwGenMode::RANDOM) {
        random_chars_generate(g_editBuf, sizeof(g_editBuf), g_randLen);
        if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount())
          pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::RANDOM, 0, 12, 0, 0, 4);
      } else {
        uint32_t idx = (uint32_t)strtoul(g_pwBip85IndexBuf[0] ? g_pwBip85IndexBuf : "0", nullptr, 10);
        if (idx > 999999u) {
          setMsg("Max index is 999999");
          draw();
          return;
        }
        g_pwBip85Index = idx;
        if (!bip85_password_generate(g_editBuf, sizeof(g_editBuf), g_pwBip85Index, g_pwBip85WordCount)) {
          draw();
          return;
        }
        if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount()) {
          pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::BIP85, g_pwBip85Index, g_pwBip85WordCount,
                                    (uint8_t)g_pwBip85OutType, (uint8_t)g_pwBip85RandTier, g_pwBip85DwWords);
        }
      }
      g_pwValueWasGenerated = true;
      g_pwValueStartedFromGenerate = true;
      g_dicewareManualDoneAlready = false;
      g_dicewareManualDoneAtMs = 0;
      g_editCursor = (uint16_t)strlen(g_editBuf);
      draw();
      return;
    }
    if (hit(rCancel, x, y)) {
      flashKeyRect(rCancel);
      g_showPwGenerateConfirm = false;
      draw();
      return;
    }
    return;
  }

  const bool pwGenUi = !g_editingTitle && (g_editMode == EditMode::ADD_PW_VALUE || (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && pwEditIsPasswordFocusField(g_pwEditFocusField)));
  if (pwGenUi) {
    Rect rAdv = pwAdvancedBtnRect();
    Rect rAdvTap = pwAdvancedLabelTapRect();
    if (hit(rAdvTap, x, y)) {
      flashKeyRect(rAdvTap);
      g_pwAdvancedPanelOpen = !g_pwAdvancedPanelOpen;
      g_dwSeparatorPickerOpen = false;
      if (g_pwAdvancedPanelOpen && g_pwGenMode == PwGenMode::BIP85)
        g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
      draw();
      return;
    }
    if (g_pwAdvancedPanelOpen) {
      int panelTop = rAdv.y + rAdv.h + 2;
      if (y >= (unsigned)panelTop && y < (unsigned)LCD_H) {
        const int sheetSideInset = 5;
        const int sheetX = sheetSideInset;
        const int sheetW = LCD_W - 2 * sheetSideInset;
        const int rowH = 34;
        const int rowY = panelTop + 19;
        const int rowX = sheetX + 11;
        const int rowW = sheetW - 22;
        int numRows = pw_advanced_panel_row_count();
        const int bottomPad = 12;
        const int rowBlockBottom = rowY + numRows * rowH;
        const int sheetBottom = rowBlockBottom + bottomPad;
        int sheetH = sheetBottom - panelTop;
        if (sheetH < 12) sheetH = 12;
        if (panelTop + sheetH > LCD_H) sheetH = LCD_H - panelTop;
        const int paintedBottom = panelTop + sheetH;
        const int closeThresholdY = rowBlockBottom;
        const int kbY0 = getKbY0();
        bool closeAdvanced = ((int)y >= closeThresholdY);
        if (!closeAdvanced && (int)y >= kbY0 && (int)y >= rowBlockBottom)
          closeAdvanced = true;
        if (closeAdvanced) {
          g_pwAdvancedPanelOpen = false;
          g_dwSeparatorPickerOpen = false;
          g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
          g_blockKeyboardUntilRelease = true;
          draw();
          return;
        }

        if ((int)y >= panelTop && (int)y < paintedBottom && ((int)x < sheetX || (int)x >= sheetX + sheetW)) {
          g_pwAdvancedPanelOpen = false;
          g_dwSeparatorPickerOpen = false;
          g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
          g_blockKeyboardUntilRelease = true;
          draw();
          return;
        }

        if (y >= (unsigned)rowY && y < (unsigned)(rowY + numRows * rowH) && x >= (unsigned)sheetX && x < (unsigned)(sheetX + sheetW)) {
          int row = ((int)y - rowY) / rowH;
          if (row >= 0 && row < numRows) {
            if (g_pwGenMode == PwGenMode::BIP85) {
              switch (g_pwBip85AdvPanel) {
                case Bip85PwAdvPanel::ROOT:
                  if (row == 0) {
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::TYPE_MENU;
                    draw();
                    return;
                  }
                  if (row == 1) {
                    g_pwBip85PassphraseEditing = true;
                    strlcpy(g_pwBip85PassphraseInput, g_pwBip85LocalPassphrase, sizeof(g_pwBip85PassphraseInput));
                    g_pwBip85IndexEditing = false;
                    g_pwBip85PpPrevKbModeRaw = (uint8_t)g_kbMode;
                    g_pwBip85PpPrevShift = g_shift;
                    g_kbMode = KBMode::LETTERS;
                    g_shift = 0;
                    g_pwAdvancedPanelOpen = false;
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
                    setMsg("BIP85 passphrase — OK when done");
                    draw();
                    return;
                  }
                  draw();
                  return;
                case Bip85PwAdvPanel::TYPE_MENU:
                  if (row == 0) {
                    g_pwBip85OutType = Bip85PwOutType::RANDOM;
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::RAND_STRENGTH;
                  } else if (row == 1) {
                    g_pwBip85OutType = Bip85PwOutType::DICEWARE;
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::DICEWARE_WORDS;
                  } else if (row == 2) {
                    g_pwBip85OutType = Bip85PwOutType::PW_HEX;
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
                  }
                  edit_clear();
                  draw();
                  return;
                case Bip85PwAdvPanel::RAND_STRENGTH:
                  if (row == 0) {
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::TYPE_MENU;
                  } else if (row == 1) {
                    g_pwBip85RandTier = Bip85PwRandTier::SIMPLE;
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
                    edit_clear();
                  } else if (row == 2) {
                    g_pwBip85RandTier = Bip85PwRandTier::STRONG;
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
                    edit_clear();
                  } else if (row == 3) {
                    g_pwBip85RandTier = Bip85PwRandTier::COMPLEX;
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
                    edit_clear();
                  }
                  draw();
                  return;
                case Bip85PwAdvPanel::DICEWARE_WORDS:
                  if (row == 0) {
                    g_pwBip85AdvPanel = Bip85PwAdvPanel::TYPE_MENU;
                    draw();
                    return;
                  }
                  if (row == 1) {
                    int mx = (int)x - rowX;
                    int third = (int)rowW / 3;
                    if (mx < third) {
                      if (g_pwBip85DwWords > 4) g_pwBip85DwWords--;
                    } else if (mx > 2 * third) {
                      if (g_pwBip85DwWords < 10) g_pwBip85DwWords++;
                    }
                    edit_clear();
                    draw();
                    return;
                  }
                  break;
              }
              draw();
              return;
            }
            if (g_pwGenMode == PwGenMode::DICEWARE) {
              if (!g_dwSeparatorPickerOpen) {
                if (row == 0) {
                  g_dwSeparatorPickerOpen = true;
                  draw();
                  return;
                }
                if (row == 1) {
                  g_dwCapitalize = !g_dwCapitalize;
                  draw();
                  return;
                }
              } else {
                if (row == 0) {
                  g_dwSeparatorPickerOpen = false;
                  draw();
                  return;
                }
                if (row >= 1 && row <= 5) {
                  g_dwSeparator = (DwSeparator)(row - 1);
                  g_dwSeparatorPickerOpen = false;
                  draw();
                  return;
                }
              }
            } else {
              switch (row) {
                case 0: g_randClassUpper = !g_randClassUpper; break;
                case 1: g_randClassLower = !g_randClassLower; break;
                case 2: g_randClassDigit = !g_randClassDigit; break;
                case 3: g_randClassSym = !g_randClassSym; break;
              }
              // Random charset changed: clear previous value to avoid stale password under new rules.
              edit_clear();
              draw();
              return;
            }
          }
        }
        // On sheet (top margin or bottom padding): block keyboard, keep panel open.
        // Do not redraw here; repeated taps in this dead zone caused visible flicker.
        return;
      }
    }
  }

  // Dismiss full-password popup on tap (ignore taps for 500ms after show so release/bounce doesn't close it)
  if (g_pwShowFullPopup) {
    if (millis() - g_pwPopupShownAtMs >= 500) {
      g_pwShowFullPopup = false;
      draw();
      return;
    }
    return;  // tap during cooldown: do nothing, keep popup
  }

  // ---- Title-edit mode (top bar): BACK = cancel, DONE = save title, tap title area = cursor ----
  if (g_editingTitle) {
    // Drag on the title to scroll horizontally
    if (hitTopTitleArea(x, y) && !g_titleDragging) {
      g_titleDragging = true;
      g_titleDragLastX = (int16_t)x;
    }
    if (hit(BTN_BACK, x, y)) {
      g_editingTitle = false;
      g_editMaxLen = EDIT_BUF_MAX - 1;
      if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount())
        edit_set(pwSvc_getValueCStr(g_viewPwIndex));
      else if (g_editMode == EditMode::EDIT_NOTE_BODY && g_viewNoteIndex < g_noteCount)
        edit_set(g_noteItems[g_viewNoteIndex].body);
      draw();
      return;
    }
    if (hitOkKey(x, y)) {
      flashKeyRectTranslucent(keyRectRow4[2]);
      g_editingTitle = false;
      g_editMaxLen = EDIT_BUF_MAX - 1;
      memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
      strncpy(g_tmpTitle, g_editBuf, sizeof(g_tmpTitle) - 1);
      g_tmpTitle[sizeof(g_tmpTitle) - 1] = 0;
      if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount()) {
        char titleMeta[sizeof(PwItem::title)];
        composePasswordTitleMeta(g_tmpTitle, g_tmpUser, g_tmpWebsite, g_tmpPwNotes, titleMeta, sizeof(titleMeta));
        if (g_pwMetaComposeTruncated) {
          setMsg("Name & details too long");
          draw();
          return;
        }
        pwSvc_setTitle(g_viewPwIndex, titleMeta);
        edit_set(pwSvc_getValueCStr(g_viewPwIndex));
        g_vaultQrDirty = true;
        // Save + exit back to list (consistent with value OK behavior)
        if (!session_can_persist_vault_data()) {
          setMsg("No password in session");
          draw();
          return;
        }
        if (!vault_require_sd_for_pm_save()) {
          draw();
          return;
        }
        if (!vault_commit_passwords_notes_persist()) {
          if (g_sdSavePathPickOpen) return;
          draw();
          return;
        }
        memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
        exitEditor();
        show(UIScreen::PASSWORDS);
        return;
      } else if (g_editMode == EditMode::EDIT_NOTE_BODY && g_viewNoteIndex < g_noteCount) {
        strncpy(g_noteItems[g_viewNoteIndex].title, g_tmpTitle, sizeof(g_noteItems[0].title) - 1);
        g_noteItems[g_viewNoteIndex].title[sizeof(g_noteItems[0].title) - 1] = 0;
        edit_set(g_noteItems[g_viewNoteIndex].body);
        g_vaultQrDirty = true;
        if (!vault_commit_passwords_notes_persist()) {
          if (g_sdSavePathPickOpen) return;
          if (!g_msg[0]) setMsg("Insert microSD to save");
          draw();
          return;
        }
        memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
        exitEditor();
        show(UIScreen::NOTES);
        return;
      }
      draw();
      return;
    }
    if (hitTopTitleArea(x, y)) {
      const int titleCharW = 12;
      int relX = (int)x - 38;
      if (relX < 0) relX = 0;
      int idx = (relX / titleCharW) + (int)g_titleViewOffset;
      size_t len = strlen(g_editBuf);
      if (idx > (int)g_editMaxLen) idx = (int)g_editMaxLen;
      if (idx > (int)len) idx = (int)len;
      g_editCursor = (uint16_t)idx;
      draw();
      return;
    }
    // If user taps outside top bar + outside keyboard, exit title edit (save) and
    // continue handling the tap (so buttons like GENERATE/MODE work immediately).
    if (y < (uint16_t)getKbY0()) {
      // Commit same as OK
      g_editingTitle = false;
      g_editMaxLen = EDIT_BUF_MAX - 1;
      memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
      strncpy(g_tmpTitle, g_editBuf, sizeof(g_tmpTitle) - 1);
      g_tmpTitle[sizeof(g_tmpTitle) - 1] = 0;
      if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount()) {
        char titleMeta[sizeof(PwItem::title)];
        composePasswordTitleMeta(g_tmpTitle, g_tmpUser, g_tmpWebsite, g_tmpPwNotes, titleMeta, sizeof(titleMeta));
        if (g_pwMetaComposeTruncated) {
          setMsg("Name & details too long");
          draw();
          return;
        }
        pwSvc_setTitle(g_viewPwIndex, titleMeta);
        edit_set(pwSvc_getValueCStr(g_viewPwIndex));
        g_vaultQrDirty = true;
        if (!vault_commit_passwords_notes_persist()) {
          if (g_sdSavePathPickOpen) return;
          if (!g_msg[0]) setMsg("Insert microSD to save");
          draw();
          return;
        }
      } else if (g_editMode == EditMode::EDIT_NOTE_BODY && g_viewNoteIndex < g_noteCount) {
        strncpy(g_noteItems[g_viewNoteIndex].title, g_tmpTitle, sizeof(g_noteItems[0].title) - 1);
        g_noteItems[g_viewNoteIndex].title[sizeof(g_noteItems[0].title) - 1] = 0;
        edit_set(g_noteItems[g_viewNoteIndex].body);
        g_vaultQrDirty = true;
        if (!vault_commit_passwords_notes_persist()) {
          if (g_sdSavePathPickOpen) return;
          if (!g_msg[0]) setMsg("Insert microSD to save");
          draw();
          return;
        }
      }
      // intentionally fall through (no return)
    }
    // Otherwise, fall through to keyboard handling below so key taps insert into title
  }

  // Tap on top-bar title (next to burger) -> enter title edit (note editor only; password name is edited in the Name row).
  if (g_editMode == EditMode::EDIT_NOTE_BODY && hitTopTitleArea(x, y)) {
    if (g_viewNoteIndex >= g_noteCount) {
      draw();
      return;
    }
    strncpy(g_noteItems[g_viewNoteIndex].body, g_editBuf, sizeof(g_noteItems[0].body) - 1);
    g_noteItems[g_viewNoteIndex].body[sizeof(g_noteItems[0].body) - 1] = 0;
    g_editingTitle = true;
    g_editMaxLen = (uint16_t)(sizeof(g_noteItems[0].title) - 1);
    strncpy(g_editBuf, g_noteItems[g_viewNoteIndex].title, sizeof(g_noteItems[0].title) - 1);
    g_editBuf[g_editMaxLen] = 0;
    g_editCursor = (uint16_t)strlen(g_editBuf);
    draw();
    return;
  }

  // Password edit details view: tap any field to enter focus mode.
  // Only when keyboard is hidden; otherwise hidden hitboxes can interfere with focused editing.
  if (g_editMode == EditMode::EDIT_PW_VALUE && !g_editingTitle && !g_pwEditKeyboardVisible) {
    auto editorDismissSendPicker = [&]() {
      g_pwEditorSendPickerActive = false;
      g_pwEditorSendDevicePromptActive = false;
      g_pwEditorSendMask = 0;
    };
    auto editorToggleSendPicker = [&]() {
#if SEEDMASK_NOTE_SEND_UI
      if (pwSendDisabled()) {
        setMsgTr("Sending is disabled", "Slanje je iskljuceno");
        return;
      }
#endif
#if SEEDMASK_USB_HID_KEYBOARD
      if (!hidHostTypingEnabled()) {
        setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
        return;
      }
#endif
      if (g_pwEditorSendPickerActive) {
        editorDismissSendPicker();
      } else {
#if SEEDMASK_USB_HID_KEYBOARD
        g_pwEditorSendPickerActive = true;
        g_pwEditorSendDevicePromptActive = false;
        g_pwEditorSendMask = 0;
#else
        setMsg("USB HID unavailable on this board");
#endif
      }
    };

    if (!g_pwEditUnlocked) {
      if (hit(pwEditUnlockBtnRect(), x, y)) {
        flashKeyRect(pwEditUnlockBtnRect());
        if (g_pwEditorSendPickerActive)
          editorDismissSendPicker();
        else
          g_pwEditUnlocked = true;
        draw();
        return;
      }
      if (hit(pwEditorSendCancelBtnRect(), x, y)) {
        flashKeyRect(pwEditorSendCancelBtnRect());
        if (g_pwEditorSendPickerActive) {
#if SEEDMASK_USB_HID_KEYBOARD
          if (!hidHostTypingEnabled()) {
            setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
            draw();
            return;
          }
          pwEditorOnSendPickerSendTapped();
#else
          setMsg("USB HID unavailable on this board");
#endif
        } else {
          editorToggleSendPicker();
        }
        draw();
        return;
      }
      if (g_pwEditorSendPickerActive) {
#if SEEDMASK_USB_HID_KEYBOARD
        if (g_pwEditorSendDevicePromptActive) {
          Rect card, rPc, rPh;
          pwEditorSendWherePopupRects(&card, &rPc, &rPh);
          if (hit(rPc, x, y)) {
            if (!hidHostTypingEnabled()) {
              setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
              draw();
              return;
            }
            pwEditorExecuteSendToHost(0);
            draw();
            return;
          }
          if (hit(rPh, x, y)) {
            if (!hidHostTypingEnabled()) {
              setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
              draw();
              return;
            }
            pwEditorExecuteSendToHost(2);
            draw();
            return;
          }
          g_pwEditorSendDevicePromptActive = false;
          draw();
          return;
        }
#endif
        for (int ii = 0; ii < 5; ii++) {
          if (hit(pwEditorSendPickerHitRect(ii), x, y)) {
            g_pwEditorSendMask ^= (uint8_t)(1u << ii);
            draw();
            return;
          }
        }
      }
      return;
    }

    if (g_pwEditorSendPickerActive) {
#if SEEDMASK_USB_HID_KEYBOARD
      if (g_pwEditorSendDevicePromptActive) {
        Rect card, rPc, rPh;
        pwEditorSendWherePopupRects(&card, &rPc, &rPh);
        if (hit(rPc, x, y)) {
          if (!hidHostTypingEnabled()) {
            setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
            draw();
            return;
          }
          pwEditorExecuteSendToHost(0);
          draw();
          return;
        }
        if (hit(rPh, x, y)) {
          if (!hidHostTypingEnabled()) {
            setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
            draw();
            return;
          }
          pwEditorExecuteSendToHost(2);
          draw();
          return;
        }
        g_pwEditorSendDevicePromptActive = false;
        draw();
        return;
      }
#endif
      if (hit(pwEditUnlockBtnRect(), x, y)) {
        flashKeyRect(pwEditUnlockBtnRect());
        editorDismissSendPicker();
        draw();
        return;
      }
      if (hit(pwEditorSendCancelBtnRect(), x, y)) {
        flashKeyRect(pwEditorSendCancelBtnRect());
#if SEEDMASK_USB_HID_KEYBOARD
        if (!hidHostTypingEnabled()) {
          setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
          draw();
          return;
        }
        pwEditorOnSendPickerSendTapped();
#else
        setMsg("USB HID unavailable");
#endif
        draw();
        return;
      }
      for (int ii = 0; ii < 5; ii++) {
        if (hit(pwEditorSendPickerHitRect(ii), x, y)) {
          g_pwEditorSendMask ^= (uint8_t)(1u << ii);
          draw();
          return;
        }
      }
      return;
    }

    if (hit(pwSaveBtnRect(), x, y)) {
      if (g_pwEditorSendPickerActive) {
        editorDismissSendPicker();
        draw();
        return;
      }
      pwEditSaveInPlace();
      return;
    }
    if (hit(pwEditorSendCancelBtnRect(), x, y)) {
      flashKeyRect(pwEditorSendCancelBtnRect());
      if (g_pwEditorSendPickerActive) {
#if SEEDMASK_USB_HID_KEYBOARD
        if (!hidHostTypingEnabled()) {
          setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
          draw();
          return;
        }
        pwEditorOnSendPickerSendTapped();
#else
        setMsg("USB HID unavailable");
#endif
      } else {
        editorToggleSendPicker();
      }
      draw();
      return;
    }

    // Hit targets include the label strip above each card (labels are drawn at rowY-9).
    const int16_t labH = 14;
    const Rect fName = { 24, (int16_t)(PW_EDIT_ROW_NAME_Y - labH), PW_EDIT_DETAIL_W, (int16_t)(40 + labH) };
    const Rect fUser = { 24, (int16_t)(PW_EDIT_ROW_USER_Y - labH), PW_EDIT_DETAIL_W, (int16_t)(40 + labH) };
    const Rect fPass = { 24, (int16_t)(PW_EDIT_ROW_PASS_Y - labH), 272, (int16_t)(40 + labH) };
    const Rect fSite = { 24, (int16_t)(PW_EDIT_ROW_SITE_Y - labH), PW_EDIT_DETAIL_W, (int16_t)(40 + labH) };
    const Rect fNote = { 24, (int16_t)(PW_EDIT_ROW_NOTES_Y - labH), PW_EDIT_DETAIL_W, (int16_t)(40 + labH) };
    if (hit(fName, x, y) || hit(fUser, x, y) || hit(fPass, x, y) || hit(fSite, x, y) || hit(fNote, x, y)) {
      // Persist currently focused field before switching focus.
      if (g_pwEditKeyboardVisible && pwEditIsPasswordFocusField(g_pwEditFocusField))
        pwEditPersistPasswordFromEditor();
      else if (g_pwEditKeyboardVisible && pwEditIsMetaFocusField(g_pwEditFocusField))
        pwEditPersistFocusedFieldFromEditor();
      g_pwEditKeyboardVisible = true;
      if (hit(fName, x, y)) {
        g_pwEditFocusField = PW_FOCUS_NAME;
        edit_set(g_tmpTitle);
        pwMetaSetCursorAtEnd(PW_FOCUS_NAME);
      } else if (hit(fUser, x, y)) {
        g_pwEditFocusField = PW_FOCUS_USER;
        edit_set(g_tmpUser);
        pwMetaSetCursorAtEnd(PW_FOCUS_USER);
      } else if (hit(fPass, x, y)) {
        g_pwEditFocusField = PW_FOCUS_PASS;
        edit_set(g_tmpPwValue);
        pwValueSetCursorAtEnd();
      } else if (hit(fSite, x, y)) {
        g_pwEditFocusField = PW_FOCUS_SITE;
        edit_set(g_tmpWebsite);
        pwMetaSetCursorAtEnd(PW_FOCUS_SITE);
      } else if (hit(fNote, x, y)) {
        g_pwEditFocusField = PW_FOCUS_NOTES;
        edit_set(g_tmpPwNotes);
        pwMetaSetCursorAtEnd(PW_FOCUS_NOTES);
      }
      draw();
      return;
    }
  }

  // Metadata / password focus: exit focus only via swipe-right (performSwipeBack), not tap outside.

  // Password active mode (5): BIP85 index field tap starts index editing (exit focus = swipe only).
  if (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && pwEditIsPasswordFocusField(g_pwEditFocusField)) {
    Rect rPwBip85Idx = pwBip85IndexFieldRect();
    bool onBip85Index =
      (g_pwGenMode == PwGenMode::BIP85) && !g_pwBip85PassphraseEditing && hit(rPwBip85Idx, x, y);
    if (onBip85Index) {
      g_pwBip85IndexEditing = true;
      g_pwBip85PrevKbModeRaw = (uint8_t)g_kbMode;
      g_pwBip85PrevShift = g_shift;
      g_kbMode = KBMode::SYMBOLS;
      g_shift = 0;
      draw();
      return;
    }
  }

  // ADD PASSWORD multi-field: tap any rectangle to jump directly to that field.
  if (!g_editingTitle && isAddPwMetaMode(g_editMode)) {
    const Rect fName = { 16, 66, 288, 40 };
    const Rect fUser = { 16, 112, 288, 40 };
    const Rect fSite = { 16, 158, 288, 40 };
    const Rect fNotes = { 16, 204, 288, 40 };
    auto persistCurrentAddPwField = [&]() {
      if (g_editMode == EditMode::ADD_PW_TITLE) {
        strncpy(g_tmpTitle, g_editBuf, sizeof(g_tmpTitle) - 1);
        g_tmpTitle[sizeof(g_tmpTitle) - 1] = 0;
      } else if (g_editMode == EditMode::ADD_PW_USER) {
        strncpy(g_tmpUser, g_editBuf, sizeof(g_tmpUser) - 1);
        g_tmpUser[sizeof(g_tmpUser) - 1] = 0;
      } else if (g_editMode == EditMode::ADD_PW_SITE) {
        strncpy(g_tmpWebsite, g_editBuf, sizeof(g_tmpWebsite) - 1);
        g_tmpWebsite[sizeof(g_tmpWebsite) - 1] = 0;
      } else if (g_editMode == EditMode::ADD_PW_NOTES) {
        strncpy(g_tmpPwNotes, g_editBuf, sizeof(g_tmpPwNotes) - 1);
        g_tmpPwNotes[sizeof(g_tmpPwNotes) - 1] = 0;
      }
      saveAddPwFieldEditorState();
    };
    auto switchToAddPwField = [&](EditMode mode, const char* src) {
      loadAddPwFieldEditorState(mode, src);
      draw();
    };
    if (hit(fName, x, y)) {
      persistCurrentAddPwField();
      switchToAddPwField(EditMode::ADD_PW_TITLE, g_tmpTitle);
      return;
    }
    if (hit(fUser, x, y)) {
      persistCurrentAddPwField();
      switchToAddPwField(EditMode::ADD_PW_USER, g_tmpUser);
      return;
    }
    if (hit(fSite, x, y)) {
      persistCurrentAddPwField();
      switchToAddPwField(EditMode::ADD_PW_SITE, g_tmpWebsite);
      return;
    }
    if (hit(fNotes, x, y)) {
      persistCurrentAddPwField();
      switchToAddPwField(EditMode::ADD_PW_NOTES, g_tmpPwNotes);
      return;
    }
  }

  // Note body: tap in body area (y >= 48, above keyboard) to place cursor — skip when editing title so keyboard works
  if (!g_editingTitle && (g_editMode == EditMode::ADD_NOTE_BODY || g_editMode == EditMode::EDIT_NOTE_BODY)) {
    const int areaX = 8, areaY = 48, lineH = 18, charW = 12, pad = 6;
    bool aboveKeyboard = (y < (uint16_t)KB_Y0_DEFAULT);
    bool inBodyArea = (y >= (uint16_t)areaY);
    bool notOnBack = !hit(BTN_BACK, x, y);
    if (aboveKeyboard && inBodyArea && notOnBack) {
      int relY = (int)y - (areaY + pad);
      int relX = (int)x - (areaX + pad) + g_noteViewOffsetPx;
      if (relY < 0) relY = 0;
      if (relX < 0) relX = 0;
      int visibleLine = relY / lineH;
      int tapLine = (int)g_noteScrollLine + visibleLine;
      int tapCol = relX / charW;
      // Visual cursor always goes where user tapped
      g_noteVisualCursorLine = tapLine;
      g_noteVisualCursorCol = tapCol;
      // Pad buffer so (tapLine, tapCol) is a valid position — then typing writes there
      notePadToLineCol(tapLine, tapCol);
      g_noteDragLastX = (int16_t)x;
      g_noteDragLastY = (int16_t)y;
      draw();
      return;
    }
  }

  // Active text field: tap-in-field to set cursor (password or metadata focus).
  if (!g_editingTitle && (g_editMode == EditMode::ADD_PW_VALUE || (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && (g_pwEditFocusField == 0 || (g_pwEditFocusField >= 1 && g_pwEditFocusField <= 5))))) {
    if (g_pwGenMode == PwGenMode::BIP85 && g_pwBip85IndexEditing) {
      Rect rPwBip85Idx = pwBip85IndexFieldRect();
      if (hit(rPwBip85Idx, x, y)) {
        // Keep index typing focus; do not pass this tap to password field cursor routing.
        return;
      }
    }
    const int boxX = 24, boxW = 272;
    int boxY = pwValueStripBoxYKeyboardOpen();
    const int boxH = 48;
    const int expand = 12;  // generous hit area so tap reliably hits the field (calibration / finger size)
    if (x >= (uint16_t)(boxX - expand) && x < (uint16_t)(boxX + boxW + expand) && y >= (uint16_t)(boxY - expand) && y < (uint16_t)(boxY + boxH + expand)) {
      size_t len = strlen(g_editBuf);
      const int pwPadding = 12;
      const int pwCharW = 12;
      const int maxChars = (boxW - pwPadding * 2) / pwCharW;

      uint16_t* activeView = &g_editViewOffset;
      if (g_editMode == EditMode::EDIT_PW_VALUE) {
        if (g_pwEditFocusField == PW_FOCUS_NAME) activeView = &g_addPwViewName;
        else if (g_pwEditFocusField == PW_FOCUS_USER) activeView = &g_addPwViewUser;
        else if (g_pwEditFocusField == PW_FOCUS_SITE) activeView = &g_addPwViewSite;
        else if (g_pwEditFocusField == PW_FOCUS_NOTES) activeView = &g_addPwViewNotes;
      }
      if (pwEditIsMetaFocusField(g_pwEditFocusField)) {
        pwMetaSetCursorAtEnd(g_pwEditFocusField);
      } else if (pwEditIsPasswordFocusField(g_pwEditFocusField)) {
        pwValueSetCursorAtEnd();
      } else if (len > 0) {
        // Tap position in visible text: account for horizontal pixel scroll so cursor is correct when scrolled
        int relX = (int)x - (boxX + pwPadding) + g_editViewOffsetPx;
        if (relX < 0) relX = 0;
        int indexInWindow = relX / pwCharW;
        if (indexInWindow < 0) indexInWindow = 0;
        if (indexInWindow > maxChars) indexInWindow = maxChars;

        // Map to absolute cursor index
        size_t newCursor = (size_t)(*activeView) + (size_t)indexInWindow;
        if (newCursor > len) newCursor = len;
        g_editCursor = (uint16_t)newCursor;
      } else {
        g_editCursor = 0;
        *activeView = 0;
      }
      g_editViewOffsetPx = 0;  // snap to character on tap
      g_pwFieldDragging = true;
      g_pwDragLastX = (int16_t)x;
      g_pwLongPressStartMs = millis();
      draw();
      return;
    }
  }

  // BACK (not shown on password value screen — use swipe or keyboard OK to go back)
  bool onPwValueScreen = (g_editMode == EditMode::ADD_PW_VALUE || g_editMode == EditMode::EDIT_PW_VALUE);
  if (!onPwValueScreen && hit(BTN_BACK, x, y)) {
    exitEditor();
    show(g_prevScreen);
    return;
  }

  // OK (keyboard key next to spacebar) — same action for all editor modes
  if (keyboardVisibleForEditor && hitOkKeyResolved((int16_t)x, (int16_t)y)) {
    // In editor we handle OK before keyboardHit(), so flash it here for feedback.
    flashKeyRectTranslucent(keyRectRow4[2]);
    if (g_pwGenMode == PwGenMode::BIP85 && g_pwBip85PassphraseEditing) {
      strlcpy(g_pwBip85LocalPassphrase, g_pwBip85PassphraseInput, sizeof(g_pwBip85LocalPassphrase));
      bip85_refresh_passphrase_fingerprint();
      secure_memzero(g_pwBip85PassphraseInput, sizeof(g_pwBip85PassphraseInput));
      g_pwBip85PassphraseEditing = false;
      g_kbMode = (KBMode)g_pwBip85PpPrevKbModeRaw;
      g_shift = g_pwBip85PpPrevShift;
      g_pwEditFocusField = PW_FOCUS_PASS;
      // Show Advanced immediately so Fingerprint appears under Passphrase (no manual reopen).
      g_pwAdvancedPanelOpen = true;
      g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
      g_dwSeparatorPickerOpen = false;
      setMsg("");
      draw();
      return;
    }
    if (g_pwGenMode == PwGenMode::BIP85 && g_pwBip85IndexEditing) {
      uint32_t idx = (uint32_t)strtoul(g_pwBip85IndexBuf[0] ? g_pwBip85IndexBuf : "0", nullptr, 10);
      if (idx > 999999u) {
        setMsg("Max index is 999999");
        draw();
        return;
      }
      g_pwBip85Index = idx;
      // OK while typing BIP85 index behaves like confirming + pressing GENERATE.
      Rect rPwGen = pwGenBtnRect();
      flashKeyRect(rPwGen);
      if (g_editMode == EditMode::EDIT_PW_VALUE && !g_pwGenerateConfirmShownThisSession) {
        // Same warning flow as tapping GENERATE in password edit.
        g_showPwGenerateConfirm = true;
      } else {
        edit_clear();
        if (!bip85_password_generate(g_editBuf, sizeof(g_editBuf), g_pwBip85Index, g_pwBip85WordCount)) {
          draw();
          return;
        }
        if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount()) {
          pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::BIP85, g_pwBip85Index, g_pwBip85WordCount,
                                    (uint8_t)g_pwBip85OutType, (uint8_t)g_pwBip85RandTier, g_pwBip85DwWords);
        }
        g_pwValueWasGenerated = true;
        g_pwValueStartedFromGenerate = true;
        g_dicewareManualDoneAlready = false;
        g_dicewareManualDoneAtMs = 0;
        g_editCursor = (uint16_t)strlen(g_editBuf);
      }
      g_pwBip85IndexEditing = false;
      g_kbMode = (KBMode)g_pwBip85PrevKbModeRaw;
      g_shift = g_pwBip85PrevShift;
      g_pwEditFocusField = PW_FOCUS_PASS;
      pwValueSetCursorAtEnd();
      draw();
      return;
    }
    Serial.printf("EDITOR OK: editMode=%d editingTitle=%d sd=%d masterPw=%d pwCount=%u viewPw=%u\n",
                  (int)g_editMode, (int)g_editingTitle, (int)sd_ready(), (int)(g_masterPw[0] != 0),
                  (unsigned)pwSvc_getCount(), (unsigned)g_viewPwIndex);

    // NAME -> USERNAME
    if (g_editMode == EditMode::ADD_PW_TITLE) {
      if (!g_editBuf[0]) {
        setMsg("Name empty");
        draw();
        return;
      }

      memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
      strncpy(g_tmpTitle, g_editBuf, sizeof(g_tmpTitle) - 1);
      g_tmpTitle[sizeof(g_tmpTitle) - 1] = 0;

      edit_clear();
      g_kbMode = KBMode::LETTERS;
      g_shift = 0;

      g_addPwCursorName = (uint16_t)strlen(g_tmpTitle);
      g_editMode = EditMode::ADD_PW_USER;
      draw();
      return;
    }

    // USERNAME -> WEBSITE
    if (g_editMode == EditMode::ADD_PW_USER) {
      memset(g_tmpUser, 0, sizeof(g_tmpUser));
      strncpy(g_tmpUser, g_editBuf, sizeof(g_tmpUser) - 1);
      g_tmpUser[sizeof(g_tmpUser) - 1] = 0;
      g_addPwCursorUser = (uint16_t)strlen(g_tmpUser);
      edit_clear();
      g_kbMode = KBMode::LETTERS;
      g_shift = 0;
      g_editMode = EditMode::ADD_PW_SITE;
      draw();
      return;
    }

    // WEBSITE -> NOTES
    if (g_editMode == EditMode::ADD_PW_SITE) {
      memset(g_tmpWebsite, 0, sizeof(g_tmpWebsite));
      strncpy(g_tmpWebsite, g_editBuf, sizeof(g_tmpWebsite) - 1);
      g_tmpWebsite[sizeof(g_tmpWebsite) - 1] = 0;
      g_addPwCursorSite = (uint16_t)strlen(g_tmpWebsite);
      edit_clear();
      g_kbMode = KBMode::LETTERS;
      g_shift = 0;
      g_editMode = EditMode::ADD_PW_NOTES;
      draw();
      return;
    }

    // NOTES -> VALUE
    if (g_editMode == EditMode::ADD_PW_NOTES) {
      memset(g_tmpPwNotes, 0, sizeof(g_tmpPwNotes));
      strncpy(g_tmpPwNotes, g_editBuf, sizeof(g_tmpPwNotes) - 1);
      g_tmpPwNotes[sizeof(g_tmpPwNotes) - 1] = 0;
      if (!g_tmpTitle[0] && !g_tmpUser[0]) {
        setMsg("Name or username required before password.");
        draw();
        return;
      }
      g_addPwCursorNotes = (uint16_t)strlen(g_tmpPwNotes);
      edit_clear();
      g_kbMode = KBMode::LETTERS;
      g_shift = 0;
      g_editMode = EditMode::ADD_PW_VALUE;
      // ADD flow starts fresh: no carried BIP85 index from previous credentials.
      g_pwBip85Index = 0;
      g_pwBip85IndexBuf[0] = 0;
      g_pwBip85IndexEditing = false;
      secure_memzero(g_pwBip85LocalPassphrase, sizeof(g_pwBip85LocalPassphrase));
      g_pwBip85LocalPassphraseFp[0] = 0;
      g_pwBip85PassphraseEditing = false;
      g_pwBip85PassphraseInput[0] = 0;
      g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
      g_pwBip85OutType = Bip85PwOutType::RANDOM;
      g_pwBip85RandTier = Bip85PwRandTier::STRONG;
      g_pwBip85DwWords = 4;
      draw();
      return;
    }

    // NOTE TITLE -> NOTE BODY (full-screen editor)
    if (g_editMode == EditMode::ADD_NOTE_TITLE) {
      if (!g_editBuf[0]) {
        setMsg("Title empty");
        draw();
        return;
      }
      memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
      strncpy(g_tmpTitle, g_editBuf, sizeof(g_tmpTitle) - 1);
      g_tmpTitle[sizeof(g_tmpTitle) - 1] = 0;
      edit_clear();
      g_kbMode = KBMode::LETTERS;
      g_shift = 0;
      g_editMode = EditMode::ADD_NOTE_BODY;
      g_noteBodyEnteredAt = millis();
      g_noteScrollLine = 0;
      g_noteViewOffsetPx = 0;
      g_noteVisualCursorLine = 0;
      g_noteVisualCursorCol = 0;
      draw();
      return;
    }

    // VALUE -> SAVE (new password)
    if (g_editMode == EditMode::ADD_PW_VALUE) {
      if (!g_tmpTitle[0] && !g_tmpUser[0]) {
        setMsg("Need name or username");
        draw();
        return;
      }
      if (!g_editBuf[0]) {
        setMsg("Password empty");
        draw();
        return;
      }
      if (pwSvc_isFull()) {
        setMsg("PW list full");
        draw();
        return;
      }
      if (!session_can_persist_vault_data()) {
        setMsg("No password in session");
        draw();
        return;
      }
      if (!vault_require_sd_for_pm_save()) {
        draw();
        return;
      }

      setMsg("Saving...");
      draw();

      char titleMeta[sizeof(PwItem::title)];
      composePasswordTitleMeta(g_tmpTitle, g_tmpUser, g_tmpWebsite, g_tmpPwNotes, titleMeta, sizeof(titleMeta));
      if (g_pwMetaComposeTruncated) {
        setMsg("Name & details too long");
        draw();
        return;
      }
      if (!pwSvc_append(titleMeta, g_editBuf)) {
        setMsg("PW list full");
        draw();
        return;
      }
      g_vaultQrDirty = true;

      if (!vault_commit_passwords_notes_persist()) {
        pwSvc_removeLast();
        if (g_sdSavePathPickOpen) return;
        if (!g_msg[0]) setMsg("Insert microSD to save");
        draw();
        return;
      }

      setMsg("Password saved");

      memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
      memset(g_tmpUser, 0, sizeof(g_tmpUser));
      exitEditor();

      triggerListCountFlash(UIScreen::PASSWORDS);
      nav_cancel_pending_gesture();
      show(UIScreen::PASSWORDS);
      return;
    }

    // EDIT existing password: OK on any focused row returns to details view (SAVE button writes vault).
    if (g_editMode == EditMode::EDIT_PW_VALUE) {
      if (g_pwEditFocusField >= 1 && g_pwEditFocusField <= 5) {
        pwEditCollapseFocusedFieldToBrowse();
        draw();
        return;
      }
      pwEditSaveAndExit();
      return;
    }

    // NOTE BODY -> SAVE NOTE (DONE)
    if (g_editMode == EditMode::ADD_NOTE_BODY) {
      if (millis() - g_noteBodyEnteredAt < 600) {
        draw();
        return;
      }
      if (g_noteCount >= MAX_NOTE_ITEMS) {
        setMsg("Notes list full");
        draw();
        return;
      }
      if (!session_can_persist_vault_data()) {
        setMsg("No password in session");
        draw();
        return;
      }
      if (!vault_require_sd_for_pm_save()) {
        draw();
        return;
      }
      strncpy(g_noteItems[g_noteCount].title, g_tmpTitle, sizeof(g_noteItems[0].title) - 1);
      g_noteItems[g_noteCount].title[sizeof(g_noteItems[0].title) - 1] = 0;
      strncpy(g_noteItems[g_noteCount].body, g_editBuf, sizeof(g_noteItems[0].body) - 1);
      g_noteItems[g_noteCount].body[sizeof(g_noteItems[0].body) - 1] = 0;
      g_noteCount++;
      g_vaultQrDirty = true;
      if (!vault_commit_passwords_notes_persist()) {
        g_noteCount--;
        memset(&g_noteItems[g_noteCount], 0, sizeof(g_noteItems[0]));
        if (g_sdSavePathPickOpen) return;
        if (!g_msg[0]) setMsg("Insert microSD to save");
        draw();
        return;
      }
      memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
      exitEditor();
      triggerListCountFlash(UIScreen::NOTES);
      nav_cancel_pending_gesture();
      show(UIScreen::NOTES);
      return;
    }

    // EDIT NOTE BODY -> SAVE CHANGES
    if (g_editMode == EditMode::EDIT_NOTE_BODY) {
      if (millis() - g_noteBodyEnteredAt < 600) {
        draw();
        return;
      }
      if (g_viewNoteIndex < g_noteCount) {
        if (!session_can_persist_vault_data()) {
          setMsg("No password in session");
          draw();
          return;
        }
        if (!vault_require_sd_for_pm_save()) {
          draw();
          return;
        }
        strncpy(g_noteItems[g_viewNoteIndex].body, g_editBuf, sizeof(g_noteItems[0].body) - 1);
        g_noteItems[g_viewNoteIndex].body[sizeof(g_noteItems[0].body) - 1] = 0;
        g_vaultQrDirty = true;
        if (!vault_commit_passwords_notes_persist()) {
          if (g_sdSavePathPickOpen) return;
          if (!g_msg[0]) setMsg("Insert microSD to save");
          draw();
          return;
        }
      }
      exitEditor();
      show(UIScreen::NOTES);
      return;
    }
  }

  // Generator buttons on value screen — in EDIT mode only when password field is active
  if (!g_editingTitle && (g_editMode == EditMode::ADD_PW_VALUE || (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && pwEditIsPasswordFocusField(g_pwEditFocusField)))) {
    const int kbY0 = getKbY0();
    // Keyboard-area taps should never trigger generator controls.
    if ((int)y < kbY0) {
      Rect rPwMode = pwModeBtnRect();
      Rect rPwMinus = pwMinusBtnRect();
      Rect rPwPlus = pwPlusBtnRect();
      Rect rPwGen = pwGenBtnRect();
      Rect rPwWords = pwWordsBtnRect();
      Rect rPwBip85Idx = pwBip85IndexFieldRect();
      if (diceware_manual_prompt_eligible(g_editBuf)) {
        int boxY = pwValueStripBoxYKeyboardOpen();
        int barY = boxY + 48 + 22;
        Rect rDoneCb = diceware_manual_done_checkbox_rect(barY);
        Rect rDoneTap = { rDoneCb.x, rDoneCb.y, (int16_t)(rDoneCb.w + 80), rDoneCb.h };
        if (hit(rDoneTap, x, y)) {
          g_dicewareManualDoneAlready = true;
          g_dicewareManualDoneAtMs = millis();
          draw();
          return;
        }
      }

      if (hit(rPwMode, x, y)) {
        flashKeyRect(rPwMode);
        PwGenMode prev = g_pwGenMode;
        if (g_pwGenMode == PwGenMode::DICEWARE) g_pwGenMode = PwGenMode::RANDOM;
        else if (g_pwGenMode == PwGenMode::RANDOM) g_pwGenMode = PwGenMode::BIP85;
        else g_pwGenMode = PwGenMode::DICEWARE;
        bool dToR = (prev == PwGenMode::DICEWARE && g_pwGenMode == PwGenMode::RANDOM);
        bool rToD = (prev == PwGenMode::RANDOM && g_pwGenMode == PwGenMode::DICEWARE);
        g_pwModeTransitionFromDiceware = dToR;
        // Avoid cross-mode strength confusion: switching generator mode starts from empty input.
        edit_clear();
        if (g_pwGenMode == PwGenMode::BIP85) {
          g_pwBip85IndexEditing = true;  // active immediately in BIP85 mode
          g_pwBip85PrevKbModeRaw = (uint8_t)g_kbMode;
          g_pwBip85PrevShift = g_shift;
          g_kbMode = KBMode::SYMBOLS;
          g_shift = 0;
        } else {
          g_pwBip85IndexEditing = false;
        }
        if (prev == PwGenMode::BIP85 && g_pwGenMode != PwGenMode::BIP85) {
          secure_memzero(g_pwBip85LocalPassphrase, sizeof(g_pwBip85LocalPassphrase));
          g_pwBip85LocalPassphraseFp[0] = 0;
          g_pwBip85PassphraseEditing = false;
          g_pwBip85PassphraseInput[0] = 0;
          g_pwBip85AdvPanel = Bip85PwAdvPanel::ROOT;
        }
        if (g_pwGenMode == PwGenMode::RANDOM && prev == PwGenMode::DICEWARE) g_randLen = (uint8_t)PW_RAND_LEN_MIN;
        g_dwSeparatorPickerOpen = false;
        g_pwModeTransitionStartMs = (dToR || rToD) ? millis() : 0;
        draw();
        return;
      }

      if (g_pwGenMode != PwGenMode::BIP85 && hit(rPwMinus, x, y)) {
        flashKeyRect(rPwMinus);
        if (g_pwGenMode == PwGenMode::DICEWARE) {
          if (g_pwGenWords > 4) g_pwGenWords--;
        } else if (g_pwGenMode == PwGenMode::RANDOM) {
          if (g_randLen > PW_RAND_LEN_MIN) g_randLen--;
        }
        draw();
        return;
      }

      if (g_pwGenMode != PwGenMode::BIP85 && hit(rPwPlus, x, y)) {
        flashKeyRect(rPwPlus);
        if (g_pwGenMode == PwGenMode::DICEWARE) {
          if (g_pwGenWords < 10) g_pwGenWords++;
        } else if (g_pwGenMode == PwGenMode::RANDOM) {
          if (g_randLen < PW_RAND_LEN_MAX) g_randLen++;
        }
        draw();
        return;
      }
      if (g_pwGenMode == PwGenMode::BIP85 && !g_pwBip85PassphraseEditing && hit(rPwBip85Idx, x, y)) {
        flashKeyRect(rPwBip85Idx);
        g_pwBip85IndexEditing = true;
        g_pwBip85PrevKbModeRaw = (uint8_t)g_kbMode;
        g_pwBip85PrevShift = g_shift;
        g_kbMode = KBMode::SYMBOLS;
        g_shift = 0;
        draw();
        return;
      }
      if (g_pwGenMode == PwGenMode::BIP85 && g_pwBip85IndexEditing && !g_pwBip85PassphraseEditing && !hit(rPwBip85Idx, x, y) && !hit(rPwGen, x, y) && !hit(rPwWords, x, y) && !hit(rPwMode, x, y)) {
        g_pwBip85IndexEditing = false;
      }
      if (hit(rPwWords, x, y)) {
        flashKeyRect(rPwWords);
        if (g_pwGenMode == PwGenMode::BIP85) {
          // Keep focus in index field after toggling 12/24 words.
          g_pwBip85IndexEditing = true;
          g_pwBip85PrevKbModeRaw = (uint8_t)g_kbMode;
          g_pwBip85PrevShift = g_shift;
          g_kbMode = KBMode::SYMBOLS;
          g_shift = 0;
          g_pwBip85WordCount = (g_pwBip85WordCount == 12) ? 24 : 12;
          draw();
          return;
        }
      }

      if (hit(rPwGen, x, y)) {
        flashKeyRect(rPwGen);
        g_pwBip85IndexEditing = false;
        g_pwBip85PassphraseEditing = false;
        if (g_editMode == EditMode::EDIT_PW_VALUE) {
          if (g_pwGenerateConfirmShownThisSession) {
            // Already confirmed once this session: replace without popup
            edit_clear();
            if (g_pwGenMode == PwGenMode::DICEWARE) {
              diceware_generate(g_editBuf, sizeof(g_editBuf), g_pwGenWords);
              if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount())
                pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::DICEWARE, 0, 12, 0, 0, 4);
            } else if (g_pwGenMode == PwGenMode::RANDOM) {
              random_chars_generate(g_editBuf, sizeof(g_editBuf), g_randLen);
              if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount())
                pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::RANDOM, 0, 12, 0, 0, 4);
            } else {
              uint32_t idx = (uint32_t)strtoul(g_pwBip85IndexBuf[0] ? g_pwBip85IndexBuf : "0", nullptr, 10);
              if (idx > 999999u) {
                setMsg("Max index is 999999");
                draw();
                return;
              }
              g_pwBip85Index = idx;
              if (!bip85_password_generate(g_editBuf, sizeof(g_editBuf), g_pwBip85Index, g_pwBip85WordCount)) {
                draw();
                return;
              }
              if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount()) {
                pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::BIP85, g_pwBip85Index, g_pwBip85WordCount,
                                          (uint8_t)g_pwBip85OutType, (uint8_t)g_pwBip85RandTier, g_pwBip85DwWords);
              }
            }
            g_pwValueWasGenerated = true;
            g_pwValueStartedFromGenerate = true;
            g_dicewareManualDoneAlready = false;
            g_dicewareManualDoneAtMs = 0;
            g_editCursor = (uint16_t)strlen(g_editBuf);
          } else {
            g_showPwGenerateConfirm = true;
          }
          draw();
          return;
        }
        edit_clear();
        if (g_pwGenMode == PwGenMode::DICEWARE) {
          diceware_generate(g_editBuf, sizeof(g_editBuf), g_pwGenWords);
          if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount())
            pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::DICEWARE, 0, 12, 0, 0, 4);
        } else if (g_pwGenMode == PwGenMode::RANDOM) {
          random_chars_generate(g_editBuf, sizeof(g_editBuf), g_randLen);
          if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount())
            pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::RANDOM, 0, 12, 0, 0, 4);
        } else {
          uint32_t idx = (uint32_t)strtoul(g_pwBip85IndexBuf[0] ? g_pwBip85IndexBuf : "0", nullptr, 10);
          if (idx > 999999u) {
            setMsg("Max index is 999999");
            draw();
            return;
          }
          g_pwBip85Index = idx;
          if (!bip85_password_generate(g_editBuf, sizeof(g_editBuf), g_pwBip85Index, g_pwBip85WordCount)) {
            draw();
            return;
          }
          if (g_editMode == EditMode::EDIT_PW_VALUE && g_viewPwIndex < pwSvc_getCount()) {
            pw_gen_meta_set_for_title(pwSvc_getTitleCStr(g_viewPwIndex), (uint8_t)PwGenMode::BIP85, g_pwBip85Index, g_pwBip85WordCount,
                                      (uint8_t)g_pwBip85OutType, (uint8_t)g_pwBip85RandTier, g_pwBip85DwWords);
          }
        }
        g_pwValueWasGenerated = true;
        g_pwValueStartedFromGenerate = true;
        g_dicewareManualDoneAlready = false;
        g_dicewareManualDoneAtMs = 0;
        g_editCursor = (uint16_t)strlen(g_editBuf);
        draw();
        return;
      }
    }
  }

  // Keyboard (disabled when password edit keyboard is intentionally hidden)
  if (g_editMode == EditMode::EDIT_PW_VALUE && !g_pwEditKeyboardVisible) return;
  if (g_blockKeyboardUntilRelease) return;
  char c = keyboardHit(x, y);
  if (!c) return;

  if (g_kbMode == KBMode::LETTERS && g_shift && c >= 'a' && c <= 'z') {
    c = (char)(c - 'a' + 'A');
    if (g_shift == 1) g_shift = 0;
  }

  const bool onPwValueGenUi =
    !g_editingTitle && (g_editMode == EditMode::ADD_PW_VALUE || (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && pwEditIsPasswordFocusField(g_pwEditFocusField)));
  if (g_pwGenMode == PwGenMode::BIP85 && g_pwBip85PassphraseEditing && onPwValueGenUi) {
    if (c == '\b')
      backspaceStr(g_pwBip85PassphraseInput, sizeof(g_pwBip85PassphraseInput));
    else
      appendChar(g_pwBip85PassphraseInput, sizeof(g_pwBip85PassphraseInput), c);
    draw();
    return;
  }
  if (g_pwGenMode == PwGenMode::BIP85 && g_pwBip85IndexEditing && onPwValueGenUi) {
    if (c == '\b') {
      backspaceStr(g_pwBip85IndexBuf, sizeof(g_pwBip85IndexBuf));
    } else if (c >= '0' && c <= '9') {
      if (strlen(g_pwBip85IndexBuf) < 6) appendChar(g_pwBip85IndexBuf, sizeof(g_pwBip85IndexBuf), c);
      uint32_t idx = (uint32_t)strtoul(g_pwBip85IndexBuf, nullptr, 10);
      if (idx > 999999u) {
        idx = 999999u;
        snprintf(g_pwBip85IndexBuf, sizeof(g_pwBip85IndexBuf), "%lu", (unsigned long)idx);
      }
      g_pwBip85Index = idx;
      setMsg("");
    } else {
      // Ignore non-digit key presses while editing BIP85 index.
    }
    if (!g_pwBip85IndexBuf[0]) g_pwBip85Index = 0;
    draw();
    return;
  }

  if (c == '\b') edit_bs();
  else edit_add_char(c);

  draw();
}

