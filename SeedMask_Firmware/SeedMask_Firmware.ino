static void handleAddressExplorerIndexTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_addrGotoIndexBuf[0] = 0;
    setMsg("");
    show(UIScreen::ADDRESS_EXPLORER);
    return;
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    const int16_t padHit = 4;
    const Rect rAddrInfo = {
      (int16_t)(infoCx - infoHalf - padHit), (int16_t)(infoCy - infoHalf - padHit),
      (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHit), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHit)
    };
    if (hit(rAddrInfo, x, y)) {
      g_addressInfoReturnScreen = UIScreen::ADDRESS_EXPLORER_INDEX;
      flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
      delay(85);
      show(UIScreen::ADDRESS_EXPLORER_INFO);
      return;
    }
  }
  for (int r = 0; r < SETTIME_NUMPAD_ROWS; r++) {
    for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
      int rx = c * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
      int ry = SETTIME_NUMPAD_Y0 + r * (SETTIME_KEY_H + SETTIME_NUMPAD_GAP);
      Rect rect = { (int16_t)rx, (int16_t)ry, (int16_t)SETTIME_KEY_W, (int16_t)SETTIME_KEY_H };
      if (!hit(rect, x, y)) continue;
      if (r == 3 && c == 0) {
        flashKeyRectTranslucent(rect);
        backspaceStr(g_addrGotoIndexBuf, sizeof(g_addrGotoIndexBuf));
        setMsg("");
        draw();
        return;
      }
      if (r == 3 && c == 2) {
        flashKeyRectTranslucent(rect);
        if (strlen(g_addrGotoIndexBuf) == 0) {
          setMsg("Enter index");
          draw();
          return;
        }
        unsigned long long v = strtoull(g_addrGotoIndexBuf, nullptr, 10);
        if (v > (unsigned long long)ADDR_MAX_INDEX) {
          setMsg("Max index is 999,999");
          draw();
          return;
        }
        uint32_t idx = (uint32_t)v;
        g_addrPage = idx / (uint32_t)ADDR_PAGE_ROWS;
        g_addrGotoHighlightIdx = idx;
        g_addrGotoHighlightNeedClockArm = true;
        g_addrGotoHighlightSettled = false;
        g_addrGotoIndexBuf[0] = 0;
        setMsg("");
        invalidate_address_explorer_cache();
        g_addrDeferPrefetchUntilAfterListFlush = true;
        show(UIScreen::ADDRESS_EXPLORER);
        return;
      }
      if (r == 3 && c == 1) {
        flashKeyRectTranslucent(rect);
        if (strlen(g_addrGotoIndexBuf) < sizeof(g_addrGotoIndexBuf) - 1)
          appendChar(g_addrGotoIndexBuf, sizeof(g_addrGotoIndexBuf), '0');
        setMsg("");
        draw();
        return;
      }
      flashKeyRectTranslucent(rect);
      char digit = (char)('1' + r * 3 + c);
      if (strlen(g_addrGotoIndexBuf) < sizeof(g_addrGotoIndexBuf) - 1)
        appendChar(g_addrGotoIndexBuf, sizeof(g_addrGotoIndexBuf), digit);
      setMsg("");
      draw();
      return;
    }
  }
}

static void handleAddressStatusUsedTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    show(UIScreen::ADDRESS_EXPLORER);
    return;
  }
  uint32_t used[ADDR_STATUS_MARK_CAP];
  size_t n = addr_status_collect_used(used, ADDR_STATUS_MARK_CAP);
  if (hit(BTN_ADDR_PREV, x, y)) {
    if (g_addrStatusUsedPage > 0) g_addrStatusUsedPage--;
    draw();
    return;
  }
  if (hit(BTN_ADDR_NEXT, x, y)) {
    uint32_t maxPage = (n == 0) ? 0u : (uint32_t)((n - 1u) / (size_t)ADDR_PAGE_ROWS);
    if (g_addrStatusUsedPage < maxPage) g_addrStatusUsedPage++;
    draw();
    return;
  }
  size_t start = (size_t)g_addrStatusUsedPage * (size_t)ADDR_PAGE_ROWS;
  size_t shown = (start < n) ? (n - start) : 0;
  if (shown > (size_t)ADDR_PAGE_ROWS) shown = (size_t)ADDR_PAGE_ROWS;
  for (uint8_t r = 0; r < (uint8_t)shown; r++) {
    Rect rr = addrRowRect(r);
    if (!hit(rr, x, y)) continue;
    uint32_t idx = used[start + r];
    char a[80];
    if (!btc_address_for_index(g_addrType, g_addrAccount, g_addrChain, idx, a, sizeof(a))) {
      setMsg("Address derivation failed");
      show(UIScreen::ERROR_SCREEN);
      return;
    }
    strncpy(g_addrDetail, a, sizeof(g_addrDetail) - 1);
    g_addrDetail[sizeof(g_addrDetail) - 1] = 0;
    g_addrQrIndex = idx;
    g_addrQrFromExplorerList = false;
    g_addrQrFromStatusUsed = true;
    g_addrQrConfirmMarkUnused = false;
    show(UIScreen::ADDRESS_QR);
    return;
  }
}

static bool btc_accounts_contains(uint32_t a) {
  for (uint8_t i = 0; i < g_btcAccountListCount; i++)
    if (g_btcAccountList[i] == a) return true;
  return false;
}
static int8_t btc_account_index(uint32_t acct) {
  for (uint8_t i = 0; i < g_btcAccountListCount; i++) {
    if (g_btcAccountList[i] == acct) return (int8_t)i;
  }
  return -1;
}
static void btc_account_default_name(uint32_t acct, char out[BTC_ACCOUNT_NAME_MAX]) {
  if (!out) return;
  if (acct == 0) {
    strncpy(out, "Default", BTC_ACCOUNT_NAME_MAX);
  } else {
    snprintf(out, BTC_ACCOUNT_NAME_MAX, "Account %lu", (unsigned long)acct);
  }
  out[BTC_ACCOUNT_NAME_MAX - 1] = 0;
}
static const char* btc_account_name_for(uint32_t acct) {
  int8_t idx = btc_account_index(acct);
  if (idx >= 0) {
    if (g_btcAccountNameList[(uint8_t)idx][0]) return g_btcAccountNameList[(uint8_t)idx];
    btc_account_default_name(acct, g_btcAccountNameList[(uint8_t)idx]);
    return g_btcAccountNameList[(uint8_t)idx];
  }
  static char fallback[BTC_ACCOUNT_NAME_MAX];
  btc_account_default_name(acct, fallback);
  return fallback;
}

static void crypto_prepare_psbt_sign_confirm_text(void) {
  if (g_cryptoPsbtDecodedBuf && g_cryptoPsbtDecodedLen > 0 && g_psbtSignConfirmCachedForLen == g_cryptoPsbtDecodedLen
      && g_psbtSignConfirmBody[0]) {
    return;
  }
  g_psbtSignConfirmBody[0] = 0;
  g_psbtSignConfirmCachedForLen = 0;
  if (!g_cryptoPsbtDecodedBuf || g_cryptoPsbtDecodedLen == 0) {
    snprintf(g_psbtSignConfirmBody, sizeof(g_psbtSignConfirmBody),
             "You are about to sign a PSBT transaction from account #%lu (%s). Sign?",
             (unsigned long)g_addrAccount, btc_account_name_for(g_addrAccount));
    return;
  }
  uint8_t fp[4];
  if (!current_master_fp_bytes(fp)) {
    snprintf(g_psbtSignConfirmBody, sizeof(g_psbtSignConfirmBody),
             "You are about to sign a PSBT transaction. Sign?");
    g_psbtSignConfirmCachedForLen = g_cryptoPsbtDecodedLen;
    return;
  }
  uint32_t accts[8];
  uint8_t n = 0;
  if (!seedmask_psbt_distinct_signing_account_indices(g_cryptoPsbtDecodedBuf, g_cryptoPsbtDecodedLen, fp, accts, &n,
                                                      (uint8_t)(sizeof(accts) / sizeof(accts[0])))) {
    n = 0;
  }
  if (n == 1) {
    snprintf(g_psbtSignConfirmBody, sizeof(g_psbtSignConfirmBody),
             "You are about to sign a PSBT transaction from account #%lu (%s). Sign?",
             (unsigned long)accts[0], btc_account_name_for(accts[0]));
  } else if (n > 1) {
    snprintf(g_psbtSignConfirmBody, sizeof(g_psbtSignConfirmBody),
             "You are about to sign a PSBT transaction using %u different account paths. Sign?", (unsigned)n);
  } else {
    snprintf(g_psbtSignConfirmBody, sizeof(g_psbtSignConfirmBody),
             "You are about to sign a PSBT transaction from account #%lu (%s). Sign?",
             (unsigned long)g_addrAccount, btc_account_name_for(g_addrAccount));
  }
  g_psbtSignConfirmCachedForLen = g_cryptoPsbtDecodedLen;
}

static bool btc_account_set_name(uint32_t acct, const char* name) {
  int8_t idx = btc_account_index(acct);
  if (idx < 0) return false;
  if (!name || !name[0]) {
    btc_account_default_name(acct, g_btcAccountNameList[(uint8_t)idx]);
  } else {
    strncpy(g_btcAccountNameList[(uint8_t)idx], name, BTC_ACCOUNT_NAME_MAX - 1);
    g_btcAccountNameList[(uint8_t)idx][BTC_ACCOUNT_NAME_MAX - 1] = 0;
  }
  return true;
}
static void btc_sort_account_list() {
  for (uint8_t i = 0; i < g_btcAccountListCount; i++) {
    for (uint8_t j = i + 1; j < g_btcAccountListCount; j++) {
      if (g_btcAccountList[j] < g_btcAccountList[i]) {
        uint32_t t = g_btcAccountList[i];
        g_btcAccountList[i] = g_btcAccountList[j];
        g_btcAccountList[j] = t;
        char tn[BTC_ACCOUNT_NAME_MAX];
        memcpy(tn, g_btcAccountNameList[i], BTC_ACCOUNT_NAME_MAX);
        memcpy(g_btcAccountNameList[i], g_btcAccountNameList[j], BTC_ACCOUNT_NAME_MAX);
        memcpy(g_btcAccountNameList[j], tn, BTC_ACCOUNT_NAME_MAX);
      }
    }
  }
}
static void btc_accounts_pref_keys(char keyN[16], char keyBlob[16], char keyCur[16], char keyNames[16]) {
  char xfp[9] = { 0 };
  // Must match at save and load. Never use a fake xfp (e.g. all zeros): every failure shared the same
  // NVS keys and could corrupt account lists when switching passphrase / master identity.
  if (current_master_xfp(xfp)) {
    snprintf(keyN, 16, "ban_%s", xfp);
    snprintf(keyBlob, 16, "ba_%s", xfp);
    snprintf(keyCur, 16, "bc_%s", xfp);
    snprintf(keyNames, 16, "bn_%s", xfp);
  } else {
    strncpy(keyN, "btc_ac_n", 16);
    keyN[15] = 0;
    strncpy(keyBlob, "btc_ac", 16);
    keyBlob[15] = 0;
    strncpy(keyCur, "btc_cur", 16);
    keyCur[15] = 0;
    strncpy(keyNames, "btc_nm", 16);
    keyNames[15] = 0;
  }
}
static void btc_accounts_load_from_prefs() {
  if (g_tempSeedActive) return;
  g_btcAccountList[0] = 0;
  btc_account_default_name(0, g_btcAccountNameList[0]);
  g_btcAccountListCount = 1;
  char keyN[16], keyBlob[16], keyCur[16], keyNames[16];
  btc_accounts_pref_keys(keyN, keyBlob, keyCur, keyNames);
  Preferences prefs;
  prefs.begin("seedmask", true);
  uint8_t n = prefs.getUChar(keyN, 0);
  size_t blobLen = prefs.getBytesLength(keyBlob);
  size_t nameBlobLen = prefs.getBytesLength(keyNames);
  // Legacy migration (no passphrase context) -> keep existing users' default wallet accounts.
  bool usedLegacy = false;
  if (!g_bip39HasPassphrase && n == 0) {
    uint8_t nLegacy = prefs.getUChar("btc_ac_n", 0);
    size_t blobLegacy = prefs.getBytesLength("btc_ac");
    if (nLegacy > 0 && nLegacy <= MAX_BTC_ACCOUNTS && blobLegacy >= nLegacy * sizeof(uint32_t)) {
      n = nLegacy;
      blobLen = blobLegacy;
      usedLegacy = true;
    }
  }
  if (n > 0 && n <= MAX_BTC_ACCOUNTS && blobLen >= n * sizeof(uint32_t)) {
    prefs.getBytes(usedLegacy ? "btc_ac" : keyBlob, g_btcAccountList, n * (size_t)sizeof(uint32_t));
    g_btcAccountListCount = n;
  }
  memset(g_btcAccountNameList, 0, sizeof(g_btcAccountNameList));
  if (!usedLegacy && n > 0 && nameBlobLen >= (size_t)n * BTC_ACCOUNT_NAME_MAX) {
    prefs.getBytes(keyNames, g_btcAccountNameList, (size_t)n * BTC_ACCOUNT_NAME_MAX);
  }
  uint32_t cur = (uint32_t)prefs.getULong(usedLegacy ? "btc_cur" : keyCur, 0);
  prefs.end();
  for (uint8_t i = 0; i < g_btcAccountListCount; i++) {
    if (!g_btcAccountNameList[i][0]) btc_account_default_name(g_btcAccountList[i], g_btcAccountNameList[i]);
  }
  btc_sort_account_list();
  if (!btc_accounts_contains(0u)) {
    if (g_btcAccountListCount < MAX_BTC_ACCOUNTS) {
      g_btcAccountList[g_btcAccountListCount++] = 0;
      btc_account_default_name(0, g_btcAccountNameList[g_btcAccountListCount - 1]);
      btc_sort_account_list();
    }
  }
  g_btcAddrAccount = btc_accounts_contains(cur) ? cur : 0u;
  if (usedLegacy) btc_accounts_save_to_prefs();
  multisig_invalidate_visible_list();
  multisig_clamp_settings_scroll();
  addr_status_load_from_prefs();
}

/** Add acct to the in-memory list if missing (default name). Persists unless temporary seed session. */
static bool btc_accounts_ensure_present(uint32_t acct) {
  if (acct > 2147483647u) return false;
  if (btc_accounts_contains(acct)) return true;
  if (g_btcAccountListCount >= MAX_BTC_ACCOUNTS) return false;
  g_btcAccountList[g_btcAccountListCount++] = acct;
  btc_account_default_name(acct, g_btcAccountNameList[g_btcAccountListCount - 1]);
  btc_sort_account_list();
  btc_accounts_save_to_prefs();
  return true;
}

static void btc_accounts_save_to_prefs() {
  if (g_tempSeedActive) return;
  char keyN[16], keyBlob[16], keyCur[16], keyNames[16];
  btc_accounts_pref_keys(keyN, keyBlob, keyCur, keyNames);
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar(keyN, g_btcAccountListCount);
  prefs.putBytes(keyBlob, g_btcAccountList, g_btcAccountListCount * sizeof(uint32_t));
  prefs.putBytes(keyNames, g_btcAccountNameList, (size_t)g_btcAccountListCount * BTC_ACCOUNT_NAME_MAX);
  prefs.putULong(keyCur, (unsigned long)g_btcAddrAccount);
  prefs.end();
}
static bool btc_accounts_add(uint32_t acct, const char* name) {
  if (acct == 0 || g_btcAccountListCount >= MAX_BTC_ACCOUNTS) return false;
  if (btc_accounts_contains(acct)) return false;
  if (acct > 2147483647u) return false;
  g_btcAccountList[g_btcAccountListCount++] = acct;
  btc_account_default_name(acct, g_btcAccountNameList[g_btcAccountListCount - 1]);
  if (name && name[0]) {
    strncpy(g_btcAccountNameList[g_btcAccountListCount - 1], name, BTC_ACCOUNT_NAME_MAX - 1);
    g_btcAccountNameList[g_btcAccountListCount - 1][BTC_ACCOUNT_NAME_MAX - 1] = 0;
  }
  btc_sort_account_list();
  g_btcAddrAccount = acct;
  btc_accounts_save_to_prefs();
  multisig_invalidate_visible_list();
  multisig_clamp_settings_scroll();
  return true;
}
static bool btc_accounts_remove(uint32_t acct) {
  if (acct == 0) return false;  // keep default account always
  if (g_btcAccountListCount <= 1) return false;
  uint8_t idx = 0xFF;
  for (uint8_t i = 0; i < g_btcAccountListCount; i++) {
    if (g_btcAccountList[i] == acct) {
      idx = i;
      break;
    }
  }
  if (idx == 0xFF) return false;
  for (uint8_t i = idx; i + 1 < g_btcAccountListCount; i++) {
    g_btcAccountList[i] = g_btcAccountList[i + 1];
    memcpy(g_btcAccountNameList[i], g_btcAccountNameList[i + 1], BTC_ACCOUNT_NAME_MAX);
  }
  g_btcAccountListCount--;
  if (g_btcAccountListCount == 0) {
    g_btcAccountList[0] = 0;
    g_btcAccountListCount = 1;
  }
  if (!btc_accounts_contains(0u) && g_btcAccountListCount < MAX_BTC_ACCOUNTS) {
    g_btcAccountList[g_btcAccountListCount++] = 0;
    btc_account_default_name(0, g_btcAccountNameList[g_btcAccountListCount - 1]);
    btc_sort_account_list();
  }
  if (!btc_accounts_contains(g_btcAddrAccount)) g_btcAddrAccount = 0;
  btc_accounts_save_to_prefs();
  multisig_invalidate_visible_list();
  multisig_clamp_settings_scroll();
  return true;
}

