static bool temp_seed_stage_pending(const char words[][16], uint8_t wc, uint8_t src) {
  if (!words) return false;
  if (wc != 12 && wc != 24) return false;
  if (mnemonic_matches_master_seed(words, wc)) {
    setMsg("Already in use");
    return false;
  }
  g_tempSeedPendingSource = (TempSeedPendingSource)src;
  g_tempSeedPendingWc = wc;
  for (uint8_t i = 0; i < wc; i++) {
    strncpy(g_tempSeedPendingWords[i], words[i], sizeof(g_tempSeedPendingWords[i]) - 1);
    g_tempSeedPendingWords[i][sizeof(g_tempSeedPendingWords[i]) - 1] = 0;
  }
  for (uint8_t i = wc; i < 24; i++) g_tempSeedPendingWords[i][0] = 0;
  return true;
}
/** BIP39 seed = PBKDF2-HMAC-SHA512(mnemonic, salt="mnemonic", iterations=2048), 64 bytes; passphrase empty. */
static bool bip39_derive_seed_bytes_no_passphrase(const char words[][16], uint8_t wc, uint8_t out64[64]) {
  if (!words || !out64) return false;
  char mnemonic[256];
  if (!build_mnemonic_string(words, wc, mnemonic, sizeof(mnemonic))) return false;
  static const uint8_t kSalt[8] = { 'm', 'n', 'e', 'm', 'o', 'n', 'i', 'c' };
  bool ok = pbkdf2_sha512((const uint8_t*)mnemonic, strlen(mnemonic), kSalt, sizeof(kSalt), 2048, out64, 64);
  secure_memzero(mnemonic, sizeof(mnemonic));
  return ok;
}
/** True if candidate has the same BIP39 words as the logged-in master — compares to indices captured at login (see g_masterWordIndices). */
static bool mnemonic_matches_master_seed(const char words[][16], uint8_t wc) {
  if (!words) return false;
  if (wc != 12 && wc != 24) return false;
  if (!g_loggedIn) return false;
  if (g_masterWordIndicesWc == 0 || g_masterWordIndicesWc != wc) return false;

  for (uint8_t i = 0; i < wc; i++) {
    if (g_masterWordIndices[i] == 0xFFFF) return false;
    int16_t fiC = bip39_find_index_ci(words[i]);
    if (fiC < 0) return false;
    if ((uint16_t)fiC != g_masterWordIndices[i]) return false;
  }
  return true;
}
static bool temp_seed_set_from_words(const char words[][16], uint8_t wc, uint8_t sourceKind) {
  if (!words) return false;
  if (wc != 12 && wc != 24) return false;
  if (g_tempSeedActive) return false;
  if (mnemonic_matches_master_seed(words, wc)) {
    setMsg("Already in use");
    return false;
  }
  // Copy source first: temp_seed_clear() also clears pending staging buffers.
  char srcCopy[24][16] = { 0 };
  for (uint8_t i = 0; i < wc; i++) {
    strncpy(srcCopy[i], words[i], sizeof(srcCopy[i]) - 1);
    srcCopy[i][sizeof(srcCopy[i]) - 1] = 0;
  }
  wallet_context_enter_temporary();
  temp_seed_clear();
  for (uint8_t i = 0; i < wc; i++) {
    strncpy(g_tempSeedWords[i], srcCopy[i], sizeof(g_tempSeedWords[i]) - 1);
    g_tempSeedWords[i][sizeof(g_tempSeedWords[i]) - 1] = 0;
  }
  g_tempSeedWordCount = wc;
  g_tempSeedFromBip85 = (sourceKind == (uint8_t)TempSeedActiveSource::BIP85);
  g_tempSeedActiveSource = (TempSeedActiveSource)sourceKind;
  g_tempSeedActive = true;
  if (!bip39_mnemonic_words_fingerprint((const char(*)[16])g_tempSeedWords, g_tempSeedWordCount, g_tempSeedXfp)) {
    strncpy(g_tempSeedXfp, "--------", sizeof(g_tempSeedXfp));
    g_tempSeedXfp[sizeof(g_tempSeedXfp) - 1] = 0;
  }
  invalidate_bip39_seed_cache();
  g_addrXfpValid = false;
  g_addrXfp[0] = 0;
  g_addrXfpComputeRequested = false;
  invalidate_address_explorer_cache();
  multisig_capture_state_for_temp_session();
  return true;
}
static const char (*active_crypto_seed_words(uint8_t* outWc))[16] {
  if (g_tempSeedActive && (g_tempSeedWordCount == 12 || g_tempSeedWordCount == 24)) {
    if (outWc) *outWc = g_tempSeedWordCount;
    return (const char(*)[16])g_tempSeedWords;
  }
  if (outWc) *outWc = g_wc;
  return (const char(*)[16])g_seed;
}
static void crypto_clear_bip39_passphrase() {
  passphrase_vault_restore_to_ram();
  bip39_passphrase_zero_crypto_state();
}

static void crypto_set_bip39_passphrase(const char* s) {
  const bool had_pp = g_bip39HasPassphrase;
  bip39_passphrase_zero_crypto_state();
  if (!s) return;
  size_t n = strnlen(s, sizeof(g_bip39Passphrase) - 1);
  if (n == 0) return;
  if (!had_pp) {
    passphrase_vault_capture_and_clear();
  }
  memcpy(g_bip39Passphrase, s, n);
  g_bip39Passphrase[n] = 0;
  g_bip39HasPassphrase = true;
  invalidate_bip39_seed_cache();
}
