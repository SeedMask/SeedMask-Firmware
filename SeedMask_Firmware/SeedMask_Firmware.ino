static DuressTypeSlot* duress_slot_for(DuressBehavior b) {
  if (b == DuressBehavior::EMPTY_VAULT) return &g_duressSlotEmpty;
  if (b == DuressBehavior::GAMES) return &g_duressSlotGames;
  if (b == DuressBehavior::DECOY_VAULT) return &g_duressSlotDecoy;
  return nullptr;
}

static void duress_slot_zero(DuressTypeSlot* s) {
  if (!s) return;
  s->active = false;
  s->wrapLen = 0;
  memset(s->salt, 0, sizeof(s->salt));
  memset(s->wrap, 0, sizeof(s->wrap));
}

static bool duress_type_pin_verify(const DuressTypeSlot* slot, const char* pin6, char* outBuf, size_t cap) {
  if (!slot || !slot->active || strlen(pin6) != 6 || slot->wrapLen < 28) return false;
  for (int i = 0; i < 6; i++) {
    if (pin6[i] < '0' || pin6[i] > '9') return false;
  }
  uint8_t key[32];
  if (!pbkdf2_sha256((const uint8_t*)pin6, 6, slot->salt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t ptlen = cap;
  bool ok = aes_gcm_decrypt_with_key(key, slot->wrap, slot->wrapLen, (uint8_t*)outBuf, &ptlen);
  secure_memzero(key, sizeof(key));
  if (!ok || ptlen == 0 || ptlen >= cap) {
    if (outBuf) secure_memzero(outBuf, cap);
    return false;
  }
  if (outBuf[ptlen - 1] != '\0') {
    secure_memzero(outBuf, cap);
    return false;
  }
  if (ptlen < cap) outBuf[ptlen] = '\0';
  const size_t expect = strlen(kDuressWrapPayload) + 1;
  if (ptlen != expect || memcmp(outBuf, kDuressWrapPayload, expect) != 0) {
    secure_memzero(outBuf, cap);
    return false;
  }
  return true;
}

static bool duress_type_pw_verify(const DuressTypeSlot* slot, const char* lockPw, char* outBuf, size_t cap) {
  if (!slot || !slot->active || !lockPw || !lockPw[0] || slot->wrapLen < 28) return false;
  uint8_t key[32];
  size_t lpLen = strlen(lockPw);
  if (!pbkdf2_sha256((const uint8_t*)lockPw, lpLen, slot->salt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t ptlen = cap;
  bool ok = aes_gcm_decrypt_with_key(key, slot->wrap, slot->wrapLen, (uint8_t*)outBuf, &ptlen);
  secure_memzero(key, sizeof(key));
  if (!ok || ptlen == 0 || ptlen >= cap) {
    if (outBuf) secure_memzero(outBuf, cap);
    return false;
  }
  if (outBuf[ptlen - 1] != '\0') {
    secure_memzero(outBuf, cap);
    return false;
  }
  if (ptlen < cap) outBuf[ptlen] = '\0';
  const size_t expect = strlen(kDuressWrapPayload) + 1;
  if (ptlen != expect || memcmp(outBuf, kDuressWrapPayload, expect) != 0) {
    secure_memzero(outBuf, cap);
    return false;
  }
  return true;
}

static bool duress_type_pin_wrap_save(DuressTypeSlot* slot, const char* pin6) {
  if (!slot || strlen(pin6) != 6) return false;
  for (int i = 0; i < 6; i++) {
    if (pin6[i] < '0' || pin6[i] > '9') return false;
  }
  esp_fill_random(slot->salt, 16);
  uint8_t key[32];
  if (!pbkdf2_sha256((const uint8_t*)pin6, 6, slot->salt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t plen = strlen(kDuressWrapPayload) + 1;
  size_t ctlen = sizeof(slot->wrap);
  if (!aes_gcm_encrypt_with_key(key, (const uint8_t*)kDuressWrapPayload, plen, slot->wrap, &ctlen)) {
    secure_memzero(key, sizeof(key));
    return false;
  }
  slot->wrapLen = ctlen;
  slot->active = true;
  secure_memzero(key, sizeof(key));
  return true;
}

static bool duress_type_pw_wrap_save(DuressTypeSlot* slot, const char* lockPw) {
  if (!slot || !lockPw || strlen(lockPw) < (size_t)SCREEN_LOCK_SEP_PW_MIN_LEN) return false;
  esp_fill_random(slot->salt, 16);
  uint8_t key[32];
  size_t lpLen = strlen(lockPw);
  if (!pbkdf2_sha256((const uint8_t*)lockPw, lpLen, slot->salt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t plen = strlen(kDuressWrapPayload) + 1;
  size_t ctlen = sizeof(slot->wrap);
  if (!aes_gcm_encrypt_with_key(key, (const uint8_t*)kDuressWrapPayload, plen, slot->wrap, &ctlen)) {
    secure_memzero(key, sizeof(key));
    return false;
  }
  slot->wrapLen = ctlen;
  slot->active = true;
  secure_memzero(key, sizeof(key));
  return true;
}

static bool duress_type_derive_key_from_cred(const DuressTypeSlot* slot, const char* cred, bool isPin, uint8_t key[32]) {
  if (!slot || !slot->active || !cred || !cred[0] || !key) return false;
  if (isPin) {
    if (strlen(cred) != 6) return false;
    return pbkdf2_sha256((const uint8_t*)cred, 6, slot->salt, 16, PIN_PBKDF_ITERATIONS, key, 32);
  }
  return pbkdf2_sha256((const uint8_t*)cred, strlen(cred), slot->salt, 16, PIN_PBKDF_ITERATIONS, key, 32);
}

static void duress_cred_kind_save_prefs() {
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar("dr_cred", (uint8_t)g_duressCredKind);
  prefs.end();
}

static void duress_slot_save_nvs(DuressBehavior b, const DuressTypeSlot* slot) {
  if (!slot) return;
  Preferences prefs;
  prefs.begin("seedmask", false);
  const char* onKey = (b == DuressBehavior::EMPTY_VAULT) ? "dr_e_on"
                      : (b == DuressBehavior::GAMES)     ? "dr_g_on"
                                                         : "dr_d_on";
  const char* saltKey = (b == DuressBehavior::EMPTY_VAULT) ? "dr_esalt"
                        : (b == DuressBehavior::GAMES)     ? "dr_gsalt"
                                                           : "dr_dsalt";
  const char* wrapKey = (b == DuressBehavior::EMPTY_VAULT) ? "dr_ewrap"
                        : (b == DuressBehavior::GAMES)     ? "dr_gwrap"
                                                           : "dr_dwrap";
  prefs.putUChar(onKey, slot->active ? 1 : 0);
  if (slot->active && slot->wrapLen > 0) {
    prefs.putBytes(saltKey, slot->salt, 16);
    prefs.putBytes(wrapKey, slot->wrap, slot->wrapLen);
  } else {
    prefs.remove(saltKey);
    prefs.remove(wrapKey);
  }
  prefs.end();
}

static void duress_slot_load_nvs(DuressBehavior b, DuressTypeSlot* slot) {
  if (!slot) return;
  duress_slot_zero(slot);
  Preferences prefs;
  prefs.begin("seedmask", true);
  const char* onKey = (b == DuressBehavior::EMPTY_VAULT) ? "dr_e_on"
                      : (b == DuressBehavior::GAMES)     ? "dr_g_on"
                                                         : "dr_d_on";
  const char* saltKey = (b == DuressBehavior::EMPTY_VAULT) ? "dr_esalt"
                        : (b == DuressBehavior::GAMES)     ? "dr_gsalt"
                                                           : "dr_dsalt";
  const char* wrapKey = (b == DuressBehavior::EMPTY_VAULT) ? "dr_ewrap"
                        : (b == DuressBehavior::GAMES)     ? "dr_gwrap"
                                                           : "dr_dwrap";
  if (prefs.getUChar(onKey, 0) != 1) {
    prefs.end();
    return;
  }
  if (prefs.getBytesLength(saltKey) != 16) {
    prefs.end();
    return;
  }
  size_t wlen = prefs.getBytesLength(wrapKey);
  if (wlen == 0 || wlen > sizeof(slot->wrap)) {
    prefs.end();
    return;
  }
  prefs.getBytes(saltKey, slot->salt, 16);
  prefs.getBytes(wrapKey, slot->wrap, wlen);
  slot->wrapLen = wlen;
  slot->active = true;
  prefs.end();
}

static void duress_migrate_legacy_if_needed() {
  Preferences prefs;
  prefs.begin("seedmask", true);
  if (prefs.isKey("dr_e_on") || prefs.isKey("dr_cred")) {
    prefs.end();
    return;
  }
  const bool hasPin = prefs.getUChar("dr_pin", 0) == 1;
  const bool hasPw = prefs.getUChar("dr_pw", 0) == 1;
  if (!hasPin && !hasPw) {
    prefs.end();
    return;
  }
  uint8_t beh = prefs.getUChar("dr_beh", 0);
  uint8_t legSalt[16];
  uint8_t legWrap[PIN_WRAP_BLOB_MAX];
  size_t legWrapLen = 0;
  if (hasPin) {
    if (prefs.getBytesLength("dr_salt") != 16) {
      prefs.end();
      return;
    }
    legWrapLen = prefs.getBytesLength("dr_wrap");
    if (legWrapLen == 0 || legWrapLen > sizeof(legWrap)) {
      prefs.end();
      return;
    }
    prefs.getBytes("dr_salt", legSalt, 16);
    prefs.getBytes("dr_wrap", legWrap, legWrapLen);
  } else {
    if (prefs.getBytesLength("dr_pw_salt") != 16) {
      prefs.end();
      return;
    }
    legWrapLen = prefs.getBytesLength("dr_pw_wrap");
    if (legWrapLen == 0 || legWrapLen > sizeof(legWrap)) {
      prefs.end();
      return;
    }
    prefs.getBytes("dr_pw_salt", legSalt, 16);
    prefs.getBytes("dr_pw_wrap", legWrap, legWrapLen);
  }
  prefs.end();

  DuressBehavior target = DuressBehavior::EMPTY_VAULT;
  if (beh == 1) target = DuressBehavior::GAMES;
  else if (beh == 3) target = DuressBehavior::DECOY_VAULT;
  DuressTypeSlot* slot = duress_slot_for(target);
  if (!slot) return;
  slot->active = true;
  memcpy(slot->salt, legSalt, 16);
  memcpy(slot->wrap, legWrap, legWrapLen);
  slot->wrapLen = legWrapLen;
  g_duressCredKind = hasPin ? DuressCredKind::PIN : DuressCredKind::PASSWORD;
  duress_cred_kind_save_prefs();
  duress_slot_save_nvs(target, slot);

  prefs.begin("seedmask", false);
  prefs.putUChar("dr_pin", 0);
  prefs.remove("dr_salt");
  prefs.remove("dr_wrap");
  prefs.putUChar("dr_pw", 0);
  prefs.remove("dr_pw_salt");
  prefs.remove("dr_pw_wrap");
  prefs.remove("dr_beh");
  prefs.end();
}

static void duress_load_all_prefs() {
  duress_slot_zero(&g_duressSlotEmpty);
  duress_slot_zero(&g_duressSlotGames);
  duress_slot_zero(&g_duressSlotDecoy);
  g_duressCredKind = DuressCredKind::NONE;
  Preferences prefs;
  prefs.begin("seedmask", true);
  if (prefs.isKey("dr_cred"))
    g_duressCredKind = (DuressCredKind)prefs.getUChar("dr_cred", 0);
  prefs.end();
  duress_migrate_legacy_if_needed();
  duress_slot_load_nvs(DuressBehavior::EMPTY_VAULT, &g_duressSlotEmpty);
  duress_slot_load_nvs(DuressBehavior::GAMES, &g_duressSlotGames);
  duress_slot_load_nvs(DuressBehavior::DECOY_VAULT, &g_duressSlotDecoy);
}

static void duress_type_clear_nvs(DuressBehavior b) {
  DuressTypeSlot* slot = duress_slot_for(b);
  if (slot) duress_slot_zero(slot);
  duress_slot_save_nvs(b, slot ? slot : &g_duressSlotEmpty);
  if (b == DuressBehavior::DECOY_VAULT)
    duress_decoy_clear_nvs();
}

static void duress_all_types_clear_nvs() {
  duress_type_clear_nvs(DuressBehavior::EMPTY_VAULT);
