      break;
    case UIScreen::CRYPTO_BIP85_QR:
      show(UIScreen::CRYPTO_BIP85_SHOW);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_BIP85_SHOW:
      bip85_wipe_derived_words();
      setMsg("");
      show(UIScreen::CRYPTO_BIP85_INDEX);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_BIP85_INDEX:
      setMsg("");
      if (g_tempSeedBip85Flow) {
        g_tempSeedBip85Flow = false;
        show(UIScreen::CRYPTO_TEMP_SEED);
      } else {
        show(UIScreen::CRYPTO_BIP85_WORDLEN);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_BIP85_WORDLEN:
      setMsg("");
      if (g_tempSeedBip85Flow) {
        g_tempSeedBip85Flow = false;
        show(UIScreen::CRYPTO_TEMP_SEED);
      } else {
        show(UIScreen::CRYPTO_SETTINGS);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_TEMP_SEED:
      setMsg("");
      show(UIScreen::CRYPTO_SETTINGS);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_TEMP_SEED_CONFIRM:
      g_tempSeedPendingSource = TempSeedPendingSource::NONE;
      g_tempSeedPendingWc = 0;
      secure_memzero(g_tempSeedPendingWords, sizeof(g_tempSeedPendingWords));
      setMsg("");
      show(UIScreen::CRYPTO_TEMP_SEED);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_PASSPHRASE:
      {
        const bool fromSettings = g_cryptoPassphraseFromSettings;
        g_cryptoPassphraseFromSettings = false;
        show(fromSettings ? UIScreen::CRYPTO_SETTINGS : UIScreen::CRYPTO_HOME);
        g_touchIgnoreUntil = millis() + 220;
        break;
      }
    case UIScreen::CRYPTO_PASSPHRASE_INPUT:
      secure_memzero(g_bip39PassphraseInput, sizeof(g_bip39PassphraseInput));
      g_bip39PassphraseInput[0] = 0;
      setMsg("");
      show(UIScreen::CRYPTO_PASSPHRASE);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_XPUB_EXPORT:
      g_cryptoXpubQrFullscreen = false;
      secure_memzero(g_cryptoXpubBuf, sizeof(g_cryptoXpubBuf));
      if (g_cryptoXpubBackToMultisigStub || g_cryptoXpubBackToMode) {
        g_cryptoXpubBackToMultisigStub = false;
        g_cryptoXpubBackToMode = false;
        show(UIScreen::CRYPTO_XPUB_MODE);
      } else {
        show(UIScreen::CRYPTO_HOME);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_TOOLS_MENU:
      show(UIScreen::CRYPTO_HOME);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_SCAN_TOOLS:
      if (g_qrScanning) {
        g_qrScanning = false;
        stop_qr_scan();
      }
      g_toolsVerifyMode = ToolsVerifyMode::None;
      g_toolsVerifyScanIsMultisig = false;
      g_toolsVerifyDecodeMsLatched = false;
      g_qrToolsVerifySessionMsWallet = 0xFF;
      g_toolsVerifyRunMsSearchOnly = false;
      show(UIScreen::CRYPTO_TOOLS_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_TOOLS_VERIFY_PICK:
      g_toolsVerifyMode = ToolsVerifyMode::None;
      g_toolsVerifyScanIsMultisig = false;
      g_toolsVerifyDecodeMsLatched = false;
      g_qrToolsVerifySessionMsWallet = 0xFF;
      g_toolsVerifyRunMsSearchOnly = false;
      show(UIScreen::CRYPTO_TOOLS_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_TOOLS_VERIFY_MULTISIG:
      show(UIScreen::CRYPTO_TOOLS_VERIFY_PICK);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_TOOLS_VERIFY_RESULT:
    case UIScreen::CRYPTO_TOOLS_SIGN_REVIEW:
    case UIScreen::CRYPTO_TOOLS_SIGN_RESULT:
      g_toolsVerifySearchActive = false;
      g_toolsVerifyMode = ToolsVerifyMode::None;
      g_toolsVerifyScanIsMultisig = false;
      g_toolsVerifyDecodeMsLatched = false;
      g_qrToolsVerifySessionMsWallet = 0xFF;
      g_toolsVerifyRunMsSearchOnly = false;
      secure_memzero(g_toolsVerifyWant, sizeof(g_toolsVerifyWant));
      g_toolsSignAddress[0] = 0;
      g_toolsSignPathFromQr = false;
      g_toolsSignAddrType = AddrType::P2WPKH;
      secure_memzero(g_toolsSignMsg, TOOLS_QR_MSG_MAX_BYTES);
      secure_memzero(g_toolsSignSigB64, sizeof(g_toolsSignSigB64));
      show(UIScreen::CRYPTO_TOOLS_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_SIGN_SOURCE:
      show(UIScreen::CRYPTO_HOME);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_TX_SD_BROWSE:
      show(UIScreen::CRYPTO_SIGN_SOURCE);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_SCAN_PSBT:
      if (g_qrScanning) {
        g_qrScanning = false;
        stop_qr_scan();
      }
      seedmask_ur_psbt_scan_reset();
      show(UIScreen::CRYPTO_SIGN_SOURCE);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_SCAN_KASPA_PSKT:
      if (g_qrScanning) {
        g_qrScanning = false;
        stop_qr_scan();
      }
      g_kaspaPsktScanLen = 0;
      g_kaspaPsktScanBuf[0] = 0;
      kaspa_ur_scan_session_reset();
      show(UIScreen::CRYPTO_SIGN_SOURCE);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_REVIEW_KASPA_TX:
      show(UIScreen::CRYPTO_HOME);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_KASPA_FEE:
      if ((uint32_t)millis() < g_psbtSlideSuppressSwipeBackUntil) {
        g_touchIgnoreUntil = millis() + 120;
        break;
      }
      if (g_psbtSignCancelConfirmPopup) {
        g_psbtSignCancelConfirmPopup = false;
        draw();
        g_touchIgnoreUntil = millis() + 220;
      } else if (g_psbtVisualizeActive) {
        g_psbtVisualizeActive = false;
        draw();
        g_touchIgnoreUntil = millis() + 220;
      } else if (g_psbtSignConfirmActive) {
        g_psbtSignConfirmActive = false;
        g_psbtVisualizeActive = false;
        psbt_slide_reset();
        setMsg("");
        draw();
        g_touchIgnoreUntil = millis() + 220;
      } else {
        show(UIScreen::CRYPTO_REVIEW_KASPA_TX);
        g_touchIgnoreUntil = millis() + 220;
      }
      break;
    case UIScreen::CRYPTO_KASPA_SIGNED_QR:
      if ((uint32_t)millis() < g_psbtSlideSuppressSwipeBackUntil || g_psbtSlideCommitBlocksSwipeBack) {
        g_touchIgnoreUntil = millis() + 120;
        break;
      }
      show(UIScreen::CRYPTO_HOME);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_PSBT_FEE:
      if ((uint32_t)millis() < g_psbtSlideSuppressSwipeBackUntil) {
        g_touchIgnoreUntil = millis() + 120;
        break;
      }
      if (g_psbtSignCancelConfirmPopup) {
        g_psbtSignCancelConfirmPopup = false;
        draw();
        g_touchIgnoreUntil = millis() + 220;
      } else if (g_psbtVisualizeActive) {
        g_psbtVisualizeActive = false;
        draw();
        g_touchIgnoreUntil = millis() + 220;
      } else if (g_psbtSignConfirmActive) {
        // Confirm overlay → back to fee only (not PSBT review).
        g_psbtSignConfirmActive = false;
        g_psbtVisualizeActive = false;
        g_cryptoAutoSignPending = false;
        psbt_slide_reset();
        setMsg("");
        draw();
        g_touchIgnoreUntil = millis() + 220;
      } else {
        show(UIScreen::CRYPTO_REVIEW_PSBT);
        g_touchIgnoreUntil = millis() + 220;
      }
      break;
    case UIScreen::CRYPTO_REVIEW_PSBT:
      show(UIScreen::CRYPTO_HOME);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CRYPTO_SIGNED_QR:
      if ((uint32_t)millis() < g_psbtSlideSuppressSwipeBackUntil || g_psbtSlideCommitBlocksSwipeBack) {
        g_touchIgnoreUntil = millis() + 120;
        break;
      }
      show(UIScreen::CRYPTO_HOME);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::VIEW_QR:
      if (g_viewQrCustomActive) {
        UIScreen dst = g_viewQrCustomBackScreen;
        g_viewQrCustomActive = false;
        g_viewQrCustomPayload[0] = 0;
        show(dst);
      } else {
        show(UIScreen::VIEW_CODE);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::VIEW_QR_BACKUP:
      show(g_viewQrBackupReturnScreen);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CONFIRM_MASTER_SHOW:
    case UIScreen::CONFIRM_MASTER_SEND:
      show(UIScreen::PASSWORDS);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CONFIRM_PASSPHRASE_CLEAR:
      show(g_prevScreen);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SET_TIME:
      show(UIScreen::MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_MENU:
      show(UIScreen::BURGER_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_LOCK_ATTEMPTS:
      setMsg("");
      show(UIScreen::SECURITY_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_LOCK_TYPE:
      show(UIScreen::SECURITY_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_LOCK_PW_CONFIRM_VAULT:
      clearPassword(g_password1);
      setMsg("");
      show(UIScreen::SECURITY_LOCK_TYPE);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_LOCK_PW_SETUP:
      g_secLockPwSetupPhase = 0;
      g_screenLockPwFirst[0] = 0;
      g_secLockPwReauthPending = false;
      g_secLockPwSetupMoreOpen = false;
      g_secLockSwitchToPin = false;
      clearPassword(g_password1);
      setMsg("");
      show(g_onboardLockFlow ? UIScreen::CREATE_LOCK_TYPE : UIScreen::SECURITY_LOCK_TYPE);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_DURESS_PW_SETUP:
      g_duressPwSetupPhase = 0;
      g_duressPwFirst[0] = 0;
      clearPassword(g_password1);
      setMsg("");
      if (g_duressTypeSetupPending) {
        duress_type_setup_cancel();
        show(UIScreen::SECURITY_DURESS_TYPE_MENU);
      } else {
        show(UIScreen::SECURITY_DURESS_LOCK_MENU);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_PIN_SETUP:
      g_pinSetupPhase = 0;
      g_pinFirstEntry[0] = 0;
      g_pinSetupIsChanging = false;
      g_pinSetupSwitchToPassword = false;
      clearPassword(g_password1);
      setMsg("");
      show(g_onboardLockFlow ? UIScreen::CREATE_LOCK_TYPE : UIScreen::SECURITY_LOCK_TYPE);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_DURESS_MENU:
      show(UIScreen::SECURITY_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_DURESS_PIN_SETUP:
      g_duressPinSetupPhase = 0;
      g_duressPinFirstEntry[0] = 0;
      clearPassword(g_password1);
      setMsg("");
      if (g_duressTypeSetupPending) {
        duress_type_setup_cancel();
        show(UIScreen::SECURITY_DURESS_TYPE_MENU);
      } else {
        show(UIScreen::SECURITY_DURESS_LOCK_MENU);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_DURESS_LOCK_MENU:
      show(UIScreen::SECURITY_DURESS_MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SECURITY_DURESS_TYPE_MENU:
      if (!g_duressDecoyIndexWarnPending) {
        show(UIScreen::SECURITY_DURESS_MENU);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::DURESS_GAME_SNAKE:
    case UIScreen::DURESS_GAME_STACK:
    case UIScreen::DURESS_GAME_BREAKOUT:
    case UIScreen::DURESS_GAME_SPACE:
      show(UIScreen::DURESS_GAMES);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::SD_BROWSER:
      show(UIScreen::MENU);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::EDITOR:
      exitEditor();
      if (!g_loggedIn) {
        if (session_should_show_lock_screen()) show(UIScreen::LOCKED);
        else show(UIScreen::HOME);
      } else {
        show(g_prevScreen);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::ERROR_SCREEN:
      show(UIScreen::HOME);
      g_touchIgnoreUntil = millis() + 220;
      break;
    default:
      break;
  }
}

static void handleOrphanEditorScreenTap(uint16_t x, uint16_t y) {
  (void)x;
  (void)y;
  if (g_editMode != EditMode::NONE) return;
  if (session_should_show_lock_screen()) show(UIScreen::LOCKED);
  else show(UIScreen::HOME);
}

static void show(UIScreen s) {
  // Mandatory onboard lock (esp. after restore): never enter main UI without PIN/password lock.
  if (onboard_lock_setup_incomplete()
      && (s == UIScreen::MENU || s == UIScreen::HOME || s == UIScreen::BURGER_MENU
          || s == UIScreen::CRYPTO_HOME || s == UIScreen::SECURITY_MENU)) {
    s = UIScreen::CREATE_LOCK_TYPE;
  }
  if (g_loggedIn && g_screen != s && !g_navSkipNextShowSnapshot)
    nav_recent_capture_snapshot();
  g_navSkipNextShowSnapshot = false;
  g_prevScreen = g_screen;
  g_screen = s;
  nav_recent_on_show(s);
  if (s != UIScreen::MENU) {
    const bool keepVaultRestorePanel = g_menuVaultRestoredPanel
        && (s == UIScreen::CREATE_LOCK_TYPE
            || s == UIScreen::SECURITY_PIN_SETUP
            || s == UIScreen::SECURITY_LOCK_PW_SETUP);
    if (!keepVaultRestorePanel) {
      g_menuToastHideAtMs = 0;
      g_menuVaultRestoredPanel = false;
      g_menuVaultRestoredFile[0] = 0;
      g_menuToastRetainMsg = false;
    }
  }
  if (g_prevScreen == UIScreen::CRYPTO_MULTISIG_WALLET && s != UIScreen::CRYPTO_MULTISIG_WALLET) {
    g_multisigWalletShowDeleteConfirm = false;
  }
  if ((g_prevScreen == UIScreen::CRYPTO_MULTISIG_IMPORT && s != UIScreen::CRYPTO_MULTISIG_IMPORT)
      || (g_prevScreen == UIScreen::CRYPTO_MULTISIG_SD_BROWSE && s != UIScreen::CRYPTO_MULTISIG_SD_BROWSE)
      || (g_prevScreen == UIScreen::CRYPTO_MULTISIG_IMPORT_REVIEW && s != UIScreen::CRYPTO_MULTISIG_IMPORT_REVIEW)) {
    multisig_duplicate_notice_dismiss();
  }
  if (s != UIScreen::CRYPTO_PSBT_FEE && s != UIScreen::CRYPTO_KASPA_FEE) {
    g_psbtSignConfirmActive = false;
    g_psbtSignCancelConfirmPopup = false;
    g_psbtVisualizeActive = false;
    psbt_slide_reset();
  }
  if (s == UIScreen::DEVICE_SETTINGS) {
    g_deviceSettingsScrollPx = 0;
    g_deviceSettingsScrollDragLastY = -1;
  }
  if (s == UIScreen::DURESS_GAMES) {
    g_duressGamesScrollPx = 0;
    g_duressGamesScrollDragLastY = -1;
  }
  if (s != UIScreen::VIEW_CODE) g_viewCodeSaveSuccessHideAtMs = 0;
  if (s != UIScreen::CRYPTO_SIGNED_QR && s != UIScreen::CRYPTO_KASPA_SIGNED_QR) {
    crypto_tx_save_feedback_clear();
  }
  if (s == UIScreen::VIEW_CODE) {
    // Clear stale global toasts (e.g. accessory "Sent to LCD"); drawViewCode only shows SD-save feedback here.
    setMsg("");
  }
  // loop() redraws the whole UI every ~120ms while g_busy — if we navigate here with a stale busy flag,
  // static entry screens flicker badly. Idle entry screens must never stay "busy".
  if (s == UIScreen::HOME || s == UIScreen::LOCKED
      || s == UIScreen::CREATE_PICK || s == UIScreen::UNLOCK_PASSWORD) {
    g_busy = false;
    g_spin = 0;
  }
  if (s == UIScreen::HOME || s == UIScreen::LOCKED || s == UIScreen::CREATE_PICK
      || s == UIScreen::UNLOCK_PASSWORD) {
    g_staticWelcomeTouchPollMs = 0;
  }
  if (s == UIScreen::LOCKED) {
    g_lockedNeedsRedraw = true;
    g_pinNumpadFlashRect.w = 0;
    if (!g_screenLockUsesPin) {
      g_kbMode = KBMode::LETTERS;
      g_shift = 0;
    }
  }
  if (s == UIScreen::MENU) {
    if (!g_menuToastRetainMsg && !g_menuVaultRestoredPanel)
      setMsg("");
    g_menuToastRetainMsg = false;
  }
  if (s == UIScreen::SECURITY_LOCK_TYPE) {
    g_secLockPwPopupOpen = false;
  } else if (g_prevScreen == UIScreen::SECURITY_LOCK_TYPE && s != UIScreen::SECURITY_LOCK_TYPE) {
    g_secLockPwPopupOpen = false;
  }
  if (s == UIScreen::SECURITY_LOCK_PW_CONFIRM_VAULT) {
    clearPassword(g_password1);
    setMsg("Enter vault password");
  }
  if (s == UIScreen::SECURITY_LOCK_PW_SETUP) {
    g_secLockPwSetupPhase = 0;
    g_screenLockPwFirst[0] = 0;
    clearPassword(g_password1);
    // Flags are set by the caller before show(); preserve switch/change intent.
    if (g_secLockSwitchToPin) {
      g_secLockPwReauthPending = true;
      setMsg("Enter current lock screen password");
    } else if (g_secLockPwReauthPending) {
      setMsg("Enter current password");
    } else {
      setMsg("8+ characters");
    }
  }
  if (s == UIScreen::SECURITY_DURESS_PW_SETUP) {
    g_duressPwSetupPhase = 0;
    g_duressPwFirst[0] = 0;
    clearPassword(g_password1);
    setMsg("");
  }
  if (s == UIScreen::SECURITY_PIN_SETUP) {
    g_pinNumpadFlashRect.w = 0;
  }
  if (g_prevScreen == UIScreen::SECURITY_LOCK_PW_SETUP && s != UIScreen::SECURITY_LOCK_PW_SETUP) {
    g_secLockPwSetupPhase = 0;
    g_screenLockPwFirst[0] = 0;
    g_secLockPwReauthPending = false;
    g_secLockPwSetupMoreOpen = false;
    if (s != UIScreen::SECURITY_PIN_SETUP) g_secLockSwitchToPin = false;
    clearPassword(g_password1);
  }
  if (g_prevScreen == UIScreen::SECURITY_PIN_SETUP && s != UIScreen::SECURITY_PIN_SETUP) {
    g_pinSetupPhase = 0;
    g_pinFirstEntry[0] = 0;
    g_pinSetupIsChanging = false;
    if (s != UIScreen::SECURITY_LOCK_PW_SETUP) g_pinSetupSwitchToPassword = false;
    clearPassword(g_password1);
  }
  if (g_prevScreen == UIScreen::SECURITY_DURESS_PIN_SETUP && s != UIScreen::SECURITY_DURESS_PIN_SETUP) {
    g_duressPinSetupPhase = 0;
    g_duressPinFirstEntry[0] = 0;
    clearPassword(g_password1);
    if (g_duressTypeSetupPending && s != UIScreen::SECURITY_DURESS_TYPE_MENU)
      duress_type_setup_cancel();
  }
  if (g_prevScreen == UIScreen::SECURITY_DURESS_PW_SETUP && s != UIScreen::SECURITY_DURESS_PW_SETUP) {
    g_duressPwSetupPhase = 0;
    g_duressPwFirst[0] = 0;
    clearPassword(g_password1);
    if (g_duressTypeSetupPending && s != UIScreen::SECURITY_DURESS_TYPE_MENU)
      duress_type_setup_cancel();
  }
  if (s == UIScreen::DURESS_GAME_SNAKE) {
    randomSeed(esp_random() ^ millis());
    duress_snake_reset();
  }
  if (s == UIScreen::DURESS_GAME_STACK) duress_stack_reset();
  if (s == UIScreen::DURESS_GAME_BREAKOUT) duress_breakout_reset_full();
  if (s == UIScreen::DURESS_GAME_SPACE) duress_space_reset_full();
  // Leaving live QR/camera UIs must fully stop capture. If g_qrScanning stayed true by mistake, loop() would
  // keep touching the camera while drawing HOME / RESTORE_SD — visible as full-screen twitch / SPI contention.
  if (s != UIScreen::RESTORE_SCAN_QR && s != UIScreen::CRYPTO_SCAN_PSBT && s != UIScreen::CRYPTO_SCAN_KASPA_PSKT
      && s != UIScreen::CRYPTO_SCAN_TOOLS) {
    if (g_qrScanning) {
      g_qrScanning = false;
      stop_qr_scan();
    }
  }
  // SeedMask/Bitcoin toggle animation only makes sense on MENU + crypto shell screens; cancel everywhere else
  // so loop() never spams draw() (~30ms) after navigating to seed HOME, restore wizard, etc.
  if (s != UIScreen::MENU && s != UIScreen::CRYPTO_HOME && s != UIScreen::CRYPTO_SETTINGS) {
    g_cryptoModeToggleAnimActive = false;
  }
  if (s == UIScreen::HOME) {
    // Idle loop skips list-count flash cleanup on HOME; clear so no stale state if we came from MENU/lists.
    g_listCountFlashActive = false;
    g_listCountFlashOn = true;
    g_listCountFlashTogglesLeft = 0;
    g_homeNeedsRedraw = true;
  }
  if (s == UIScreen::CREATE_PICK) {
    g_createPickNeedsRedraw = true;
  }
  if (s == UIScreen::SHOW_CODE_FULLSCREEN) {
    g_showCodeFullscreenScrollPx = 0;
  }
  if (s != UIScreen::SHOW_CODE_FULLSCREEN) {
    g_showCodeFullscreenDismissPending = false;
  }
  if (s != UIScreen::MENU && g_deviceNameFlashActive) {
    g_deviceNameFlashActive = false;
    g_deviceNameFlashOn = true;
    g_deviceNameFlashTogglesLeft = 0;
  }
  if (s != UIScreen::VIEW_SEED) g_viewSeedExportSheetOpen = false;
  if (s == UIScreen::CRYPTO_TEMP_SEED) {
    if (!(g_tempSeedAlreadyInUsePopup && (g_prevScreen == UIScreen::RESTORE_SCAN_QR || g_prevScreen == UIScreen::CRYPTO_BIP85_INDEX))) {
      g_tempSeedAlreadyInUsePopup = false;
    }
  }
  if (s != UIScreen::CRYPTO_HOME) {
    g_cryptoAccountMenuOpen = false;
    g_cryptoAccountDetailsOpen = false;
  }
  // Drop deferred auto-sign unless staying on review or moving to signed QR result.
  if (s != UIScreen::CRYPTO_REVIEW_PSBT && s != UIScreen::CRYPTO_PSBT_FEE && s != UIScreen::CRYPTO_SIGNED_QR) {
    g_cryptoAutoSignPending = false;
  }
  if (s == UIScreen::RESTORE_CODE) g_showBackupCodeDigitPopup = false;
  // Stop swipe-hint animation loop (40ms draw) when entering restore / SD — avoids stray redraws during long SD scans.
  // Same for create-seed wizard (confirm grid is sensitive to periodic redraws).
  // Seed HOME: clear hint so lock/session transitions never leave a stale 40ms loop or overlay state.
  if (s == UIScreen::HOME
      || s == UIScreen::RESTORE_CODE || s == UIScreen::RESTORE_SD || s == UIScreen::RESTORE_PASSWORD
      || s == UIScreen::RESTORE_SCAN_QR || s == UIScreen::RESTORE_DONE || s == UIScreen::RESTORE_MP_CHUNK_OK
      || s == UIScreen::RESTORE_VAULT_CHOICE || s == UIScreen::RESTORE_VAULT_PICK
      || s == UIScreen::SD_BROWSER || s == UIScreen::SD_FILE_RENAME
      || s == UIScreen::BACKUP_CHOOSE_WORDS || s == UIScreen::BACKUP_FROM_SEED || s == UIScreen::BACKUP_REVIEW_WORDS
      || s == UIScreen::BACKUP_PASSWORD1 || s == UIScreen::BACKUP_PASSWORD2 || s == UIScreen::BACKUP_SHOW_CODE
      || s == UIScreen::CREATE_PICK || s == UIScreen::CREATE_ENTROPY_METHOD
      || s == UIScreen::CREATE_ENTROPY_HW_WARN
      || s == UIScreen::CREATE_DICE_WORDS || s == UIScreen::CREATE_DICE_ROLL
      || s == UIScreen::CREATE_GEN || s == UIScreen::CREATE_VERIFY_CHOICE
      || s == UIScreen::CREATE_CONFIRM || s == UIScreen::CREATE_LOCK_TYPE
      || s == UIScreen::CREATE_BACKUP_OPT
      || s == UIScreen::CREATE_PASSWORD || s == UIScreen::CREATE_PASSWORD2 || s == UIScreen::CREATE_SHOW_CODE) {
    g_swipeHintActive = false;
    g_swipeHintStartMs = 0;
  }
  // Populate listing before draw() — avoids empty SD frame then immediate rescan (visible twitch).
  if (s == UIScreen::RESTORE_SD || s == UIScreen::SD_BROWSER) {
    if (g_prevScreen != UIScreen::SD_FILE_RENAME) {
      sd_browser_begin();
    }
  }
  if (s == UIScreen::CRYPTO_SCAN_PSBT) {
    seedmask_ur_psbt_scan_reset();
    crypto_tx_scan_poll_reset();
  }
  if (s == UIScreen::CRYPTO_SCAN_KASPA_PSKT) {
    kaspa_ur_scan_session_reset();
    crypto_tx_scan_poll_reset();
  }
  if (s == UIScreen::CRYPTO_REVIEW_PSBT) {
    // Fresh taps on NEXT (QR scan can leave stale touch edges / debounce).
    g_touchReleasedSinceTap = true;
    g_lastTapMs = 0;
    g_psbtSignConfirmActive = false;
    g_psbtSignCancelConfirmPopup = false;
    g_psbtVisualizeActive = false;
    g_psbtSignConfirmBody[0] = 0;
    psbt_slide_reset();
    crypto_tx_review_reset_scroll_touch();
    setMsg("");
    crypto_refresh_psbt_review();
  }
  if (s == UIScreen::CRYPTO_PSBT_FEE) {
    g_touchReleasedSinceTap = true;
    g_lastTapMs = 0;
    g_psbtSignCancelConfirmPopup = false;
    g_psbtVisualizeActive = false;
    setMsg("");
    crypto_refresh_psbt_review();
  }
  if (s == UIScreen::CRYPTO_REVIEW_KASPA_TX) {
    g_touchReleasedSinceTap = true;
    g_lastTapMs = 0;
    g_psbtSignConfirmActive = false;
    g_psbtSignCancelConfirmPopup = false;
    g_psbtVisualizeActive = false;
    g_psbtSignConfirmBody[0] = 0;
    psbt_slide_reset();
    crypto_tx_review_reset_scroll_touch();
    setMsg("");
    crypto_refresh_kaspa_review();
  }
  if (s == UIScreen::CRYPTO_KASPA_FEE) {
    g_touchReleasedSinceTap = true;
    g_lastTapMs = 0;
    g_psbtSignCancelConfirmPopup = false;
    g_psbtVisualizeActive = false;
    setMsg("");
    crypto_refresh_kaspa_review();
  }
  if (s == UIScreen::CRYPTO_TOOLS_SIGN_REVIEW || s == UIScreen::CRYPTO_TOOLS_SIGN_RESULT) {
    // Same as PSBT review: QR scan / navigation can leave debounce or g_touchIgnoreUntil eating the first tap.
    g_touchReleasedSinceTap = true;
    g_lastTapMs = 0;
    g_touchIgnoreUntil = 0;
  }
  if (s == UIScreen::CRYPTO_CONNECT_SINGLESIG) {
    g_touchReleasedSinceTap = true;
    g_lastTapMs = 0;
    g_touchIgnoreUntil = 0;
  }
  if (s == UIScreen::CRYPTO_CONNECT_MULTISIG) {
    g_touchReleasedSinceTap = true;
    g_lastTapMs = 0;
    g_touchIgnoreUntil = 0;
  }
  if (s == UIScreen::CRYPTO_BIP85_INDEX || s == UIScreen::CRYPTO_BIP85_QR || s == UIScreen::CRYPTO_BIP85_INFO
      || s == UIScreen::ADDRESS_EXPLORER_INFO || s == UIScreen::CRYPTO_XPUB_INFO || s == UIScreen::SHOW_CODE_INFO
      || s == UIScreen::SHOW_CODE_FULLSCREEN
      || s == UIScreen::DEVICE_LANGUAGE || s == UIScreen::DEVICE_HID || s == UIScreen::DEVICE_NAV_BAR
      || s == UIScreen::DEVICE_NAV_BAR_INFO) {
    g_touchReleasedSinceTap = true;
    g_lastTapMs = 0;
    g_touchIgnoreUntil = 0;
  }
  // Seed backup views: swipe-back sets g_touchIgnoreUntil — must not block Save to SD / QR on first tap.
  if (s == UIScreen::VIEW_CODE || s == UIScreen::VIEW_SEED || s == UIScreen::VIEW_SEED_QR
      || s == UIScreen::VIEW_QR) {
    g_touchReleasedSinceTap = true;
    g_lastTapMs = 0;
    g_touchIgnoreUntil = 0;
  }
  if (s == UIScreen::CRYPTO_SIGNED_QR) {
    g_cryptoSignedQrAnimPaused = false;
    g_cryptoSignedQrLastAnimMs = millis();
  }
  if (s == UIScreen::LOCKED || s == UIScreen::UNLOCK_PASSWORD) {
    g_touchReleasedSinceTap = true;
    g_lastTapMs = millis();
    g_touchIgnoreUntil = millis() + 200;
  }
  if (s == UIScreen::DEVICE_RENAME) {
    strncpy(g_deviceRenameBuf, ui_device_display_name(), sizeof(g_deviceRenameBuf) - 1);
    g_deviceRenameBuf[sizeof(g_deviceRenameBuf) - 1] = 0;
    setMsg("");
  }
  if (s == UIScreen::SD_FILE_RENAME) {
    g_kbMode = KBMode::LETTERS;
    g_shift = 0;
    g_touchReleasedSinceTap = true;
    setMsg("");
  }
  if (s == UIScreen::CREATE_SHOW_CODE || s == UIScreen::BACKUP_SHOW_CODE) {
    g_showCodeScrollPx = 0;
  }
#if SEEDMASK_USB_HID_KEYBOARD
  if (s != UIScreen::CREATE_SHOW_CODE && s != UIScreen::BACKUP_SHOW_CODE) {
    g_showBackupCodeSendConfirm = false;
  }
#endif
  startSwipeHintIfNeeded(s);
  if (s == UIScreen::MENU || s == UIScreen::CRYPTO_HOME || s == UIScreen::PASSWORDS)
    sd_refresh_presence_ui_full();
  draw();
}

