    g_sdSavePickBkPaths = (char(*)[192])seedmask_zalloc_psram((size_t)8 * 192);
  if (!g_restoreVaultPickPaths)
    g_restoreVaultPickPaths = (char(*)[192])seedmask_zalloc_psram((size_t)8 * 192);
  g_restoreLineActive = g_restoreFull;
}

void setup() {
  Serial.begin(115200);
  // Native USB before ANY Serial output — Espressif KeyboardSerial.ino: Keyboard.begin() then USB.begin()
  // must run before CDC traffic or the composite HID+CDC descriptor breaks (Mac gets no keystrokes).
#if SEEDMASK_USB_HID_KEYBOARD
#if SEEDMASK_USB_APPLE_KEYBOARD_IDS
  USB.VID(0x05ac);  // Apple Inc.
  USB.PID(0x0267);  // Magic Keyboard (ANSI); may hide USB CDC on some hosts — not default
#endif
  Keyboard.begin();
  USB.begin();
#endif
#if defined(ARDUINO_ARCH_ESP32)
  delay(800);  // host Serial Monitor attach (after composite USB is enumerated)
#endif
  printf("SeedMask: setup begin\n");
  fflush(stdout);
  Serial.println("SeedMask: setup begin");
  Serial.flush();
  delay(200);
  seedmask_alloc_psram_scratch_buffers();
  pwSvc_alloc_storage();
  if (!g_restoreFull || !g_vaultQrPayload || !g_noteItems || !g_restorePayload
      || !g_kaspaPsktScanBuf || !g_kaspaPsktWorkBuf || !g_kaspaSignedJson
      || !g_kaspaLastUrPart || !g_policyLastUrPart || !g_urPartNormScratch
      || !g_sdSavePickVaultPaths || !g_sdSavePickBkPaths || !g_restoreVaultPickPaths
      || !pwSvc_storage_ok()) {
    Serial.println("FATAL: core buffers failed to allocate (PSRAM/internal heap)");
    while (1) { delay(1000); }
  }
#if SEEDMASK_CRYPTO_DEBUG
  if (address_explorer_vectors_ok()) {
    Serial.println("addr_explorer: vectors OK");
  } else {
    Serial.println("addr_explorer: vector mismatch");
  }
#endif

  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setClock(100000);

  tcaInit();
  tcaSetBit(EXIO_CAM_PWDN, true);  // start powered down
  tcaSetBit(EXIO_LCD_RST, true);

  lcdBacklightInit();

  lcdResetViaTCA();
  gfx->begin();

  kb_layout_init(KB_Y0_DEFAULT);

  // NVS save runs in this task so loop task stack is never used for nvs_save_vault
  xTaskCreate(nvs_save_task, "nvs_save", 4096, NULL, 1, &g_nvs_save_task_handle);
  // Signing spinner: yields every frame (safe for TWDT). Paint only while g_cryptoSignInProgress.
  xTaskCreatePinnedToCore(crypto_sign_spinner_task, "sign_spin", 8192, NULL, 1, &g_cryptoSignSpinnerTask, 0);

  setMsg("");
  load_unix_time_from_prefs();
  screen_lock_load_prefs();
  duress_load_all_prefs();
  lockout_load_prefs();
  lockout_preload_vpw_hollow_from_nvs();
  lockout_load_hollow_armed_from_nvs();
  // Loads legacy btc_ac_* only; xfp-keyed list needs master seed (see btc_accounts_load_from_prefs after unlock).
  crypto_accounts_load_all();
  // Read-write so namespace opens reliably; stateless preference (default = stateful / persistent)
  bool msigMigratedLegacy = false;
  prefs.begin("seedmask", false);
  g_stateless = prefs.getBool("stateless", false);
  {
    String dn = prefs.getString("dev_name", "SeedMask");
    strncpy(g_deviceName, dn.c_str(), sizeof(g_deviceName) - 1);
    g_deviceName[sizeof(g_deviceName) - 1] = 0;
    if (g_deviceName[0] == '\0') {
      strncpy(g_deviceName, "SeedMask", sizeof(g_deviceName) - 1);
      g_deviceName[sizeof(g_deviceName) - 1] = 0;
    }
    g_autoShutdownIdleSeconds = prefs.getUInt("auto_sd", 0);
    if (!autoShutdownSecondsValid(g_autoShutdownIdleSeconds)) g_autoShutdownIdleSeconds = 0;
    g_uiLanguage = prefs.getUChar("ui_lang", 0);
    if (g_uiLanguage > 1) g_uiLanguage = 0;
#if SEEDMASK_USB_HID_KEYBOARD
    g_hidHostEnabled = prefs.getBool("hid_host", true);
#endif
    g_navSwitcherDisabled = prefs.getBool("sw_off", prefs.getBool("sw_hide_th", false));
    g_navBarEnabled = prefs.getBool("nav_bar", false);
    g_airgappedMode = prefs.getBool("airgapped", false);
#if SEEDMASK_NOTE_SEND_UI
    g_pwSendVia = prefs.getUChar("pw_send_via", 0);
    pwSendViaClampForBuild();
#endif
    if (g_airgappedMode)
      nav_sp_apply_airgapped_effects(false);
#if SEEDMASK_NOTE_SEND_UI
    pwSendSyncHidHostFromVia();
#endif
    kaspa_multisig_policy_mode_load_from_open_prefs();
    msigMigratedLegacy = multisig_load_from_prefs_boot();
  }
  prefs.end();
  if (msigMigratedLegacy) multisig_save_all_prefs();
  g_lastUserActivityMs = millis();
  // Detect vault without malloc (ps_malloc can fail early at boot and used to make g_hasVault false).
  size_t vaultBlobBytes = 0;
  const bool vaultOnFlash = nvs_vault_blob_size(&vaultBlobBytes);
  if (vaultOnFlash) {
    // Flash vault wins over a stale "stateless" pref — never erase a stored wallet on boot.
    if (g_stateless) {
      g_stateless = false;
      persist_stateless();
    }
    g_hasVault = true;
  } else {
    if (g_stateless) {
      nvs_clear_vault();
      nvs_clear_vault_pw();
    }
    g_hasVault = false;
  }
  if (g_lockoutSilentWipeArmed || g_lockoutSilentNoVerify) {
    g_hasVault = false;
    g_pwMasked = true;
    clearPassword(g_password1);
    show(UIScreen::LOCKED);
    g_touchIgnoreUntil = millis() + 400;
  } else if (g_hasVault) {
    // Incomplete restore/create lock setup: never boot into vault-password unlock.
    if (screen_lock_setup_required() && !g_screenLockUsesPin && !g_screenLockSeparatePw) {
      discard_incomplete_onboard_lock_vault();
      show(UIScreen::HOME);
      g_touchIgnoreUntil = millis() + 400;
    } else {
      g_pwMasked = true;
      clearPassword(g_password1);
      show(UIScreen::LOCKED);
      // Ignore touches for a short period after boot to avoid phantom touch (e.g. 'p') from touch controller
      g_touchIgnoreUntil = millis() + 400;
    }
  } else {
    if (screen_lock_setup_required()) screen_lock_set_setup_required(false);
    // No vault on flash: same as after WIPE + session_lock — must be HOME (Create/Restore), not MENU.
    // Showing MENU here made a post-reset device look "logged in" (cards + Bitcoin toggle) while RAM
    // was empty (VIEW SEED blank, crypto inert).
    show(UIScreen::HOME);
  }

  // Reset-button robustness: make sure LCD backlight is explicitly resumed after boot UI draw.
  // Some boards can briefly boot with BL latched low after EN reset.
  g_lcdBacklightSuspended = false;
  lcdBacklightApply();

  // Parser + signer self-tests take several seconds — run in a FreeRTOS task so setup() returns and
  // loop() services USB HID immediately (blocking here made the keyboard dead for ~3s after boot).
#if SEEDMASK_PSBT_SELFTEST_ON_BOOT
  {
    BaseType_t stOk = xTaskCreatePinnedToCore(psbt_boot_selftest_task, "psbt_selftest", 16384, NULL, 0, NULL, 0);
    if (stOk != pdPASS) {
      boot_log_line("SeedMask: self-test task failed — running Kaspa tests inline");
      run_kaspa_boot_selftests();
      g_psbtParserSelftestRan = true;
      g_psbtSigningSelftestRan = true;
      g_psbtParserSelftestOk = true;
      g_psbtSigningSelftestOk = true;
    } else {
      boot_log_line("SeedMask: self-test task started (watch for PASS lines)");
    }
  }
  printf("SeedMask: setup done (%lu ms)\n", (unsigned long)millis());
  fflush(stdout);
  Serial.printf("SeedMask: setup done (%lu ms)\n", (unsigned long)millis());
  Serial.flush();
#else
  g_psbtParserSelftestOk = true;
  g_psbtParserSelftestRan = true;
  g_psbtSigningSelftestOk = true;
  g_psbtSigningSelftestRan = true;
#endif
#if SEEDMASK_KASPA_SELFTEST_ON_BOOT && !SEEDMASK_PSBT_SELFTEST_ON_BOOT
  g_kaspaSighashSelftestOk = seedmask_kaspa_sighash_selftest(g_kaspaSighashSelftestErr, sizeof(g_kaspaSighashSelftestErr));
  g_kaspaSighashSelftestRan = true;
  g_kaspaBip340SelftestOk = seedmask_kaspa_bip340_selftest(g_kaspaBip340SelftestErr, sizeof(g_kaspaBip340SelftestErr));
  g_kaspaBip340SelftestRan = true;
#elif !SEEDMASK_KASPA_SELFTEST_ON_BOOT
  g_kaspaSighashSelftestOk = true;
  g_kaspaSighashSelftestRan = true;
  g_kaspaBip340SelftestOk = true;
  g_kaspaBip340SelftestRan = true;
#endif
}

void loop() {
  pollBootButtonLock();
  sd_poll_hotplug();

  // Never spin the ~120ms busy redraw path on static welcome/unlock chrome (stale g_busy or bad transition).
  if (g_busy && (g_screen == UIScreen::HOME || g_screen == UIScreen::LOCKED || g_screen == UIScreen::CREATE_PICK || g_screen == UIScreen::UNLOCK_PASSWORD)) {
    g_busy = false;
    g_spin = 0;
  }

  {
    uint32_t idleNow = millis();
    if (autoShutdownIdleShouldArm()
        && (uint32_t)(idleNow - g_lastUserActivityMs) >= g_autoShutdownIdleSeconds * 1000UL) {
      autoShutdownExecute();
      return;
    }
  }

  if (g_viewCodeSaveSuccessHideAtMs != 0
      && (int32_t)(millis() - g_viewCodeSaveSuccessHideAtMs) >= 0) {
    g_viewCodeSaveSuccessHideAtMs = 0;
    if (g_screen == UIScreen::VIEW_CODE) {
      setMsg("");
      draw();
    }
  }

  if (g_cryptoTxSaveFeedbackUntilMs != 0
      && (int32_t)(millis() - g_cryptoTxSaveFeedbackUntilMs) >= 0) {
    crypto_tx_save_feedback_clear();
    if (g_screen == UIScreen::CRYPTO_SIGNED_QR || g_screen == UIScreen::CRYPTO_KASPA_SIGNED_QR) {
      draw();
    }
  }

  if (g_lockedWrongMsgHideAtMs != 0
      && (int32_t)(millis() - g_lockedWrongMsgHideAtMs) >= 0
      && g_screen == UIScreen::LOCKED) {
    g_lockedWrongMsgHideAtMs = 0;
    setMsg("");
    draw();
  }

  if (g_menuToastHideAtMs != 0
      && (int32_t)(millis() - g_menuToastHideAtMs) >= 0
      && g_screen == UIScreen::MENU
      && !g_menuVaultRestoredPanel) {
    g_menuToastHideAtMs = 0;
    setMsg("");
    draw();
  }

  nav_bar_sleep_if_expired(millis());

  {
    static bool s_navKbWasActive = false;
    const bool kbNow = nav_bar_keyboard_active();
    if (kbNow && !s_navKbWasActive)
      g_navBarAwake = false;
    else if (!kbNow)
      g_navBarAwake = false;
    s_navKbWasActive = kbNow;
  }

  if (g_pinNumpadFlashRect.w > 0
      && (int32_t)((int32_t)millis() - (int32_t)g_pinNumpadFlashUntilMs) >= 0
      && ((g_screen == UIScreen::LOCKED && g_screenLockUsesPin)
          || g_screen == UIScreen::SECURITY_PIN_SETUP)) {
    g_pinNumpadFlashRect.w = 0;
    if (g_screen == UIScreen::LOCKED) g_lockedNeedsRedraw = true;
    draw();
  }

  // Tools → Verify address: finish wallet scan in slices so UI stays responsive after QR decode.
  if (g_screen == UIScreen::CRYPTO_TOOLS_VERIFY_RESULT && g_toolsVerifySearchActive) {
    uint32_t t0 = millis();
    while (g_toolsVerifySearchActive && (millis() - t0) < 42) {
      if (tools_verify_search_chunk(96)) break;
    }
    if (!g_toolsVerifySearchActive) draw();
  }

  // Deferred master fingerprint (heavy PBKDF2+EC) so first Addresses frame stays responsive
  if (g_addrXfpComputeRequested && g_screen == UIScreen::ADDRESS_EXPLORER && g_addrExplorerStep == AddrExplorerStep::PICK_TYPE
      && vault_is_unlocked() && g_loggedIn && (g_wc == 12 || g_wc == 24)) {
    g_addrXfpComputeRequested = false;
    if (!current_master_xfp(g_addrXfp)) {
      g_addrXfp[0] = 0;
    }
    g_addrXfpValid = true;
    draw();
    return;
  }

  // Address list: two orange blinks then solid on "go to" row (timer starts right after cache fill; see seg 0+2 in draw).
  // Do not return after draw(): touch handling runs later in this same loop() — early return made taps impossible until blink ended.
  if (g_screen == UIScreen::ADDRESS_EXPLORER && g_addrExplorerStep == AddrExplorerStep::LIST
      && g_addrGotoHighlightIdx != kAddrHighlightNone && !g_busy && !g_addrGotoHighlightNeedClockArm) {
    uint32_t el = (uint32_t)(millis() - g_addrGotoHighlightStartMs);
    uint32_t now = millis();
    if (el < kAddrHighlightBlinkMs) {
      if ((uint32_t)(now - g_addrExplorerHighlightLastAnimMs) >= 70u) {
        g_addrExplorerHighlightLastAnimMs = now;
        draw();
      }
    } else if (!g_addrGotoHighlightSettled) {
      g_addrGotoHighlightSettled = true;
      if (g_addrNeighborPrefetchPending) {
        g_addrNeighborPrefetchEarliestMs = millis() + 450u;
      }
      draw();
    }
  }

  // Professional switch toggle animation between SeedMask and Bitcoin.
  // Only redraw while still on a screen that shows the toggle; if the user navigates away (e.g. lock → seed HOME)
  // mid-animation, cancel — otherwise draw() would run every ~30ms on the wrong screen (visible twitch).
  if (g_navOverlay == NavOverlay::APP_SWITCHER
      && (g_navSwitcherSnapAnimActive || g_navSwitcherDismissAnimActive) && !g_busy) {
    nav_switcher_tick(millis());
  }
  if (g_navOverlay == NavOverlay::STATUS_PANEL && g_navSpSendFlashStartMs != 0 && !g_busy)
    nav_sp_tick(millis());

  if (g_cryptoModeToggleAnimActive && !g_busy) {
    uint32_t now = millis();
    const bool onToggleScreen =
      (g_screen == UIScreen::MENU || g_screen == UIScreen::CRYPTO_HOME || g_screen == UIScreen::CRYPTO_SETTINGS);
    if (!onToggleScreen) {
      g_cryptoModeToggleAnimActive = false;
    } else {
      if ((uint32_t)(now - g_cryptoModeToggleAnimLastDrawMs) >= 30u) {
        g_cryptoModeToggleAnimLastDrawMs = now;
        draw();
      }
      if ((uint32_t)(now - g_cryptoModeToggleAnimStartMs) >= g_cryptoModeToggleAnimDurMs) {
        g_cryptoModeToggleAnimActive = false;
        show(g_cryptoModeToggleTargetScreen);
        return;
      }
    }
  }

  // Warning (wipe): large (i) pulses continuously while this screen is shown.
  if (g_screen == UIScreen::WIPE_CONFIRM && !g_busy) {
    uint32_t now = millis();
    if ((uint32_t)(now - g_wipeConfirmPulseLastDrawMs) >= 33u) {
      g_wipeConfirmPulseLastDrawMs = now;
      draw();
    }
  }

  // Duress mini-games: Snake advances on a timer; Stack moves the sliding bar continuously.
  if (!g_busy) {
    uint32_t nowGame = millis();
    if (g_screen == UIScreen::DURESS_GAME_SNAKE) {
      if ((uint32_t)(nowGame - g_duressSnakeNextStepMs) >= 145u) {
        g_duressSnakeNextStepMs = nowGame;
        duress_snake_step();
        draw();
      }
    } else if (g_screen == UIScreen::DURESS_GAME_STACK) {
      if ((uint32_t)(nowGame - g_duressStackLastTickMs) >= 24u) {
        g_duressStackLastTickMs = nowGame;
        duress_stack_tick();
        draw();
      }
    } else if (g_screen == UIScreen::DURESS_GAME_BREAKOUT) {
      if ((uint32_t)(nowGame - g_breakoutLastTickMs) >= 12u) {
        g_breakoutLastTickMs = nowGame;
        duress_breakout_tick();
        draw();
      }
    } else if (g_screen == UIScreen::DURESS_GAME_SPACE) {
      if ((uint32_t)(nowGame - g_dsLastTickMs) >= 14u) {
        g_dsLastTickMs = nowGame;
        duress_space_tick();
        draw();
      }
    }
  }

  // PSBT: optional auto-flow — advance Review → Fee, then same confirm overlay as manual NEXT → SIGN.
  if (g_cryptoAutoSignPending && g_cryptoHasUnsigned && !g_busy
      && (g_screen == UIScreen::CRYPTO_REVIEW_PSBT || g_screen == UIScreen::CRYPTO_PSBT_FEE)) {
    if (!vault_is_unlocked() || !g_loggedIn) {
      g_cryptoAutoSignPending = false;
      setMsg("Unlock wallet to sign");
      draw();
      return;
    }
    if (g_screen == UIScreen::CRYPTO_REVIEW_PSBT) {
      show(UIScreen::CRYPTO_PSBT_FEE);
      draw();
      return;
    }
    if (!g_psbtSignConfirmActive) {
      crypto_prepare_psbt_sign_confirm_text();
      psbt_slide_reset();
      g_psbtSignCancelConfirmPopup = false;
      g_psbtVisualizeActive = false;
      g_psbtSignConfirmActive = true;
      draw();
      return;
    }
    return;
  }

  // Wake the NVS save task to do the write (loop task never calls nvs_save_vault — avoids stack canary)
  if (g_deferred_nvs_save_pending && g_nvs_save_task_handle) {
    xTaskNotifyGive(g_nvs_save_task_handle);
  }

  // Animated BC-UR fountain parts (Blockchain Commons — same sequence as Passport Core)
  if (g_screen == UIScreen::CRYPTO_SIGNED_QR && g_cryptoHasSigned && g_cryptoPsbtSignedUr[0]
      && g_cryptoBcUrFountain && !g_cryptoSignedQrAnimPaused && !g_busy
      && !crypto_tx_save_feedback_active()) {
    uint32_t now = millis();
    if ((uint32_t)(now - g_cryptoSignedQrLastAnimMs) >= CRYPTO_SIGNED_QR_ANIM_INTERVAL_MS) {
      g_cryptoSignedQrLastAnimMs = now;
      if (seedmask_bc_ur_next_part(g_cryptoPsbtSignedUr, CRYPTO_PSBT_SIGNED_UR_BYTES)) {
        draw();
      }
      return;
    }
  }

  // PSBT Confirm → Visualize: animate connectors (do NOT return — must still process Done/scroll touch)
  if ((g_screen == UIScreen::CRYPTO_PSBT_FEE || g_screen == UIScreen::CRYPTO_KASPA_FEE) && g_psbtSignConfirmActive && g_psbtVisualizeActive && !g_busy) {
    uint32_t nowAnim = millis();
    if ((uint32_t)(nowAnim - g_psbtVizLastAnimMs) >= PSBT_VIZ_ANIM_INTERVAL_MS) {
      g_psbtVizLastAnimMs = nowAnim;
      drawPsbtTxVisualizeOverlay();
      ui_flush();
    }
  }

  // Kaspa signed multi-input: animated ur:bytes/ (static encodeText overflows QR v16 above ~2 sigs).
  if (g_screen == UIScreen::CRYPTO_KASPA_SIGNED_QR && g_kaspaHasSigned && g_kaspaSignedUrFountain
      && g_cryptoPsbtSignedUr && g_cryptoPsbtSignedUr[0] && !g_kaspaSignedQrAnimPaused && !g_busy
      && !crypto_tx_save_feedback_active()) {
    uint32_t now = millis();
    if ((uint32_t)(now - g_kaspaSignedQrLastAnimMs) >= CRYPTO_SIGNED_QR_ANIM_INTERVAL_MS) {
      g_kaspaSignedQrLastAnimMs = now;
      if (seedmask_bc_ur_next_part(g_cryptoPsbtSignedUr, CRYPTO_PSBT_SIGNED_UR_BYTES)) {
        draw();
      }
      return;
    }
  }

  // Sparrow pairing: BC-UR bytes fountain (full Passport JSON — same idea as Passport Core + Sparrow webcam).
  if (g_screen == UIScreen::CRYPTO_CONNECT_SPARROW_QR && g_cryptoConnectSparrowUrFountain && !g_cryptoConnectSparrowQrAnimPaused
      && !g_busy && g_cryptoConnectSparrowUr[0]) {
    uint32_t now = millis();
    if ((uint32_t)(now - g_cryptoConnectSparrowQrLastAnimMs) >= CRYPTO_SIGNED_QR_ANIM_INTERVAL_MS) {
      g_cryptoConnectSparrowQrLastAnimMs = now;
      if (seedmask_bc_ur_next_part(g_cryptoConnectSparrowUr, CRYPTO_CONNECT_SPARROW_UR_BYTES)) {
        draw();
      }
      return;
    }
  }

  // spinner while busy
  if (g_busy) {
    g_spin++;
    // On restore flows, show the modern restoring spinner screen
    if (g_screen == UIScreen::RESTORE_CODE
        || g_screen == UIScreen::RESTORE_SD
        || g_screen == UIScreen::RESTORE_SCAN_QR
        || g_screen == UIScreen::RESTORE_PASSWORD) {
      drawValidatingScreen();
    } else {
      draw();
    }
    delay(120);
    return;
  }

  // 2FA list and detail: redraw each second for code/step; faster when countdown in last 10s (wedge blink)
  if ((g_screen == UIScreen::TFA_LIST || g_screen == UIScreen::TFA_SHOW_CODE) && g_totpCount > 0) {
    static uint32_t lastTfaDrawSec = 0;
    static uint32_t lastTfaBlinkDrawMs = 0;
    uint32_t ut = get_unix_time();
    if (ut != 0) {
      int sl = 30 - (int)(ut % 30);
      if (sl == 0) sl = 30;
      const uint32_t nowMs = millis();
      if (ut != lastTfaDrawSec) {
        lastTfaDrawSec = ut;
        draw();
        lastTfaBlinkDrawMs = nowMs;
      } else if (sl <= 10 && (uint32_t)(nowMs - lastTfaBlinkDrawMs) >= 55u) {
        lastTfaBlinkDrawMs = nowMs;
        draw();
      }
    }
  }

  // ---- QR scan live polling ----
  if ((g_screen == UIScreen::RESTORE_SCAN_QR || g_screen == UIScreen::CRYPTO_SCAN_PSBT || g_screen == UIScreen::CRYPTO_SCAN_KASPA_PSKT || g_screen == UIScreen::CRYPTO_SCAN_TOOLS) && g_qrScanning) {
    // SVGA upgrade: PSBT + Kaspa dense monitor QR (vault RESTORE remains VGA).
    {
      const bool wantsSvga = g_qr_need_high_res && g_qr_framesize == FRAMESIZE_VGA;
      const bool kaspaPsktScan = (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT);
      if (kaspaPsktScan)
        g_qr_need_high_res = false;
      const bool cryptoTxSvga = wantsSvga && (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT);
      const bool vaultSvga = wantsSvga && g_qrScanTarget == QrScanTarget::RESTORE && !g_restoreSeedQrOnlyScan;
      if (cryptoTxSvga) {
        Serial.println("PSBT scan: upgrading to SVGA for dense UR decode...");
        g_qr_need_high_res = false;
        g_qr_decode_fail_streak = 0;
        setMsg("Switching to high-res decode...");
        draw();
        stop_qr_scan();
        g_qr_w = 800;
        g_qr_h = 600;
        g_qr_framesize = FRAMESIZE_SVGA;
        if (!start_qr_scan()) {
          setMsg("Camera init failed");
          show(UIScreen::ERROR_SCREEN);
          g_qrScanning = false;
          return;
        }
        setMsg("");
        show(UIScreen::CRYPTO_SCAN_PSBT);
        g_touchIgnoreUntil = millis() + 400;
        g_syncTouchAfterQrScan = true;
        delay(20);
        return;
      }
      if (vaultSvga) {
        Serial.println("Vault scan: upgrading to SVGA for dense SPE1 decode...");
        g_qr_need_high_res = false;
        g_qr_decode_fail_streak = 0;
        s_dense_lock_frames = 0;
        setMsg("Switching to high-res decode...");
        draw();
        stop_qr_scan();
        g_qr_w = 800;
        g_qr_h = 600;
        g_qr_framesize = FRAMESIZE_SVGA;
        if (!start_qr_scan()) {
          // Prefer staying on VGA over aborting the restore scan.
          Serial.println("Vault scan: SVGA upgrade failed — staying on VGA");
          g_qr_w = 640;
          g_qr_h = 480;
          g_qr_framesize = FRAMESIZE_VGA;
          if (!start_qr_scan()) {
            setMsg("Camera init failed");
            show(UIScreen::ERROR_SCREEN);
            g_qrScanning = false;
            return;
          }
          setMsg("High-res unavailable");
        } else {
          setMsg("");
        }
        show(UIScreen::RESTORE_SCAN_QR);
        g_touchIgnoreUntil = millis() + 400;
        g_syncTouchAfterQrScan = true;
        delay(20);
        return;
      }
    }
    if (g_qrScanLoopBuf && poll_qr_scan_result(g_qrScanLoopBuf, QR_SCAN_LOOP_BUF_BYTES)) {
      // Don't stop scan yet — multi-part may need more frames

      Serial.print("QR scanned, len=");
      Serial.print(strlen(g_qrScanLoopBuf));
      Serial.print(", prefix: ");
      char preview[30];
      strncpy(preview, g_qrScanLoopBuf, 29);
      preview[29] = 0;
      Serial.println(preview);

      // SeedQR-only mode (RESTORE -> Seed -> SeedQR): accept compact binary payload only.
      if (g_qrScanTarget == QrScanTarget::RESTORE && g_restoreSeedQrOnlyScan) {
        uint8_t wc = 0;
        if (restore_seed_from_seedqr_bytes(s_qr_last_payload, s_qr_last_payload_len, s_restore_out, wc)) {
          g_qrScanning = false;
          g_restoreSeedQrOnlyScan = false;
          stop_qr_scan();
          if (g_tempSeedImportMode == TempSeedImportMode::SEED_QR) {
            if (!temp_seed_stage_pending((const char(*)[16])s_restore_out, wc, (uint8_t)TempSeedPendingSource::SEED_QR)) {
              if (strcmp(g_msg, "Already in use") == 0) {
                g_qrScanning = false;
                stop_qr_scan();
                g_syncTouchAfterQrScan = true;
                g_tempSeedAlreadyInUsePopup = true;
                setMsg("");
                show(UIScreen::CRYPTO_TEMP_SEED);
                return;
              }
              if (g_msg[0] == 0) setMsg("Could not stage temporary seed");
              draw();
              return;
            }
            g_tempSeedImportMode = TempSeedImportMode::NONE;
            setMsg("");
            show(UIScreen::CRYPTO_TEMP_SEED_CONFIRM);
            return;
          }
          // Restore → Seed → SeedQR (stateful persists at lock setup; same as typed words).
          pwSvc_clearAll();
          g_noteCount = 0;
          if (g_noteItems) memset(g_noteItems, 0, NOTE_ITEMS_TOTAL_BYTES);
          memset(g_totpItems, 0, sizeof(g_totpItems));
          g_totpCount = 0;
          memset(g_masterPw, 0, sizeof(g_masterPw));
          g_backupCode[0] = 0;
          portable_backup_clear();
          g_hasVault = false;
          g_restorePwNvsPending = false;
          session_login_from_seed((const char(*)[16])s_restore_out, wc, "");
          setMenuToast("SeedQR restored");
          show_menu_or_onboard_lock_after_restore();
          return;
        } else {
          // Explicitly ignore non-SeedQR payloads in this mode.
          setMsg("Not a valid SeedQR");
          draw();
          delay(10);
          return;
        }
      }

      // Trim whitespace only (do NOT uppercase — base64 in SPE1 is case-sensitive)
      char* p = g_qrScanLoopBuf;
      while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
      size_t len = strlen(p);
      while (len > 0 && (p[len - 1] == ' ' || p[len - 1] == '\t' || p[len - 1] == '\r' || p[len - 1] == '\n')) { p[--len] = 0; }

      // Bitcoin Tools: stop camera first, then navigate — no UR/PSBT decode, no heavy work on this frame.
      if (g_qrScanTarget == QrScanTarget::TOOLS_VERIFY_ADDRESS) {
        g_qrScanning = false;
        stop_qr_scan();
        g_syncTouchAfterQrScan = true;
        tools_on_verify_qr_decoded(p);
        waitTouchRelease(120);
        return;
      }
      if (g_qrScanTarget == QrScanTarget::TOOLS_SIGN_MESSAGE) {
        g_qrScanning = false;
        stop_qr_scan();
        g_syncTouchAfterQrScan = true;
        tools_on_sign_qr_decoded(p);
        waitTouchRelease(120);
        return;
      }
      if (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT) {
        if (g_kaspaPsktScanLen > 0 && kaspa_pskt_qr_payload_looks_valid(g_kaspaPsktScanBuf, g_kaspaPsktScanLen)) {
          p = g_kaspaPsktScanBuf;
          len = g_kaspaPsktScanLen;
        } else if (scan_payload_looks_like_ur(p)) {
          char urErr[128] = { 0 };
          const int urState = kaspa_feed_ur_scan_part(p, urErr, sizeof(urErr));
          if (urState == 1) return;
          if (urState == -1) {
            setMsg(urErr[0] ? urErr : "PSKT UR error");
            draw();
            delay(10);
            return;
          }
          if (urState == 2) {
            len = strlen(g_kaspaPsktScanBuf);
            p = g_kaspaPsktScanBuf;
            g_kaspaPsktScanLen = len;
          }
        }
        if (!kaspa_pskt_qr_payload_looks_valid(p, len)) {
          setMsg("Not a Kaspa PSKT JSON QR");
          draw();
          delay(10);
          return;
        }
        if (len >= KASPA_PSKT_SCAN_MAX) {
          setMsg("Kaspa payload too large");
          draw();
          delay(10);
          return;
        }
        if (p != g_kaspaPsktScanBuf) {
          memcpy(g_kaspaPsktScanBuf, p, len);
          g_kaspaPsktScanBuf[len] = 0;
        }
        g_kaspaPsktScanLen = len;
        g_kaspaExpectedAddr[0] = 0;
        g_kaspaKpubStatus = -1;
        g_qrScanning = false;
        stop_qr_scan();
        g_syncTouchAfterQrScan = true;
        if (!kaspa_accept_loaded_unsigned_for_wallet()) {
          const bool askImport = seedmask_kaspa_unsigned_has_multisig_redeem(g_kaspaPsktScanBuf, g_kaspaPsktScanLen)
                                 && g_kaspaMultisigPolicyMode == KaspaMultisigPolicyMode::ASK_TO_IMPORT
                                 && !kaspa_has_imported_multisig_policy_for_current_account();
          char errKeep[96];
          strncpy(errKeep, g_msg, sizeof(errKeep) - 1);
          errKeep[sizeof(errKeep) - 1] = 0;
          kaspa_clear_loaded_unsigned();
          if (askImport) {
            show(UIScreen::CRYPTO_MULTISIG_IMPORT);
            setMsg(errKeep[0] ? errKeep : "Import multisig policy first");
          } else {
            show(UIScreen::CRYPTO_SIGN_SOURCE);
            setMsg(errKeep);
          }
          waitTouchRelease(250);
          return;
        }
        setMsg("PSKT captured");
        show(UIScreen::CRYPTO_REVIEW_KASPA_TX);
        waitTouchRelease(250);
        return;
      }
      if (g_qrScanTarget == QrScanTarget::MULTISIG_POLICY) {
        if (strncasecmp(p, "ur:", 3) == 0) {
          char urErr[128] = { 0 };
          float pct = 0;
          char dec[MULTISIG_WALLET_PAYLOAD_BYTES];
          int urRes = multisig_feed_policy_ur_scan_part(p, dec, sizeof(dec), &pct, urErr, sizeof(urErr));
          if (urRes == SEEDMASK_UR_PSBT_NEED_MORE) {
            int ip = (int)(pct * 100.0f + 0.5f);
            if (ip < 0) ip = 0;
            if (ip > 99) ip = 99;
            char m[80];
            snprintf(m, sizeof(m), "Policy UR %d%% — scan next frame", ip);
            setMsg(m);
            draw();
            delay(10);
            return;
          }
          if (urRes == SEEDMASK_UR_PSBT_ERROR) {
            setMsg(urErr[0] ? urErr : "UR error");
            draw();
            delay(10);
            return;
          }
          strncpy(g_multisigPolicyPayload, dec, MULTISIG_WALLET_PAYLOAD_BYTES - 1);
          g_multisigPolicyPayload[MULTISIG_WALLET_PAYLOAD_BYTES - 1] = 0;
          g_qrScanning = false;
          stop_qr_scan();
          g_syncTouchAfterQrScan = true;
          if (!multisig_prepare_review_from_payload(g_multisigPolicyPayload, true)) {
            if (!g_msg[0] && !g_multisigDuplicateNoticeActive) setMsg("Invalid multisig policy QR");
            show(UIScreen::CRYPTO_MULTISIG_IMPORT);
            waitTouchRelease(120);
            return;
          }
          g_multisigReviewReturnScreen = UIScreen::CRYPTO_MULTISIG_IMPORT;
          setMsg("Policy scanned. Review and confirm.");
          show(UIScreen::CRYPTO_MULTISIG_IMPORT_REVIEW);
          waitTouchRelease(120);
          return;
        }
        g_qrScanning = false;
        stop_qr_scan();
        g_syncTouchAfterQrScan = true;
        if (!multisig_prepare_review_from_scanned_qr(p)) {
          if (!g_msg[0] && !g_multisigDuplicateNoticeActive) setMsg("Invalid multisig policy QR");
          show(UIScreen::CRYPTO_MULTISIG_IMPORT);
          waitTouchRelease(120);
          return;
        }
        g_multisigReviewReturnScreen = UIScreen::CRYPTO_MULTISIG_IMPORT;
        setMsg("Policy scanned. Review and confirm.");
        show(UIScreen::CRYPTO_MULTISIG_IMPORT_REVIEW);
        waitTouchRelease(120);
        return;
      }

      // TFA add QR mode: accept otpauth://totp/... and return to TFA_ADD with parsed fields.
      if (g_qrScanTarget == QrScanTarget::TFA_ADD) {
        char parsedLabel[sizeof(g_tfaAddLabel)] = { 0 };
        char parsedSecret[sizeof(g_tfaAddSecret)] = { 0 };
        if (parseTotpUriToItem(p, parsedLabel, sizeof(parsedLabel), parsedSecret, sizeof(parsedSecret))) {
          uint8_t dummy[64];
          size_t dlen = 0;
          if (!base32_decode(parsedSecret, dummy, sizeof(dummy), dlen) || dlen < 8) {
            setMsg("QR secret invalid/too short.");
            draw();
            delay(10);
            return;
          }
          if (g_totpCount >= MAX_TOTP_ITEMS) {
            setMsg("2FA list full.");
            draw();
            delay(10);
            return;
          }
          g_qrScanning = false;
          stop_qr_scan();
          splitTotpLabel(parsedLabel, g_tfaAddLabel, sizeof(g_tfaAddLabel), g_tfaAddAccount, sizeof(g_tfaAddAccount));
          stripCharInPlace(g_tfaAddLabel, ':');
          strncpy(g_tfaAddSecret, parsedSecret, sizeof(g_tfaAddSecret) - 1);
          g_tfaAddSecret[sizeof(g_tfaAddSecret) - 1] = 0;
          g_tfaAddFocus = 2;
          g_tfaEditMode = false;
          g_tfaAddCursorLabel = (uint16_t)strlen(g_tfaAddLabel);
          g_tfaAddCursorAccount = (uint16_t)strlen(g_tfaAddAccount);
          g_tfaAddCursorSecret = (uint16_t)strlen(g_tfaAddSecret);
          g_tfaAddViewOffsetLabel = (g_tfaAddCursorLabel > 20) ? (uint16_t)(g_tfaAddCursorLabel - 20) : 0;
          g_tfaAddViewOffsetAccount = (g_tfaAddCursorAccount > 20) ? (uint16_t)(g_tfaAddCursorAccount - 20) : 0;
          g_tfaAddViewOffsetSecret = (g_tfaAddCursorSecret > 20) ? (uint16_t)(g_tfaAddCursorSecret - 20) : 0;
          setMsg("");
          show(UIScreen::TFA_ADD);
          tfaAddTryCommit();
          waitTouchRelease(180);
          return;
        }
        setMsg("QR is not a valid otpauth TOTP code.");
        draw();
        delay(10);
        return;
      }

      // Crypto wallet QR mode: accept UR PSBT (single-frame or BC-UR fountain multipart).
      if (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT) {
        if (is_ur_psbt_scan(p)) {
          const size_t kPsbtCap = 65536;
          char urErr[128] = { 0 };
          size_t decLen = 0;
          uint8_t* tmp = (uint8_t*)malloc(kPsbtCap);
          if (!tmp) {
            setMsg("Out of memory");
            draw();
            delay(10);
            return;
          }
          int urRes = seedmask_ur_feed_psbt_qr(p, tmp, kPsbtCap, &decLen, nullptr, urErr, sizeof(urErr));
          if (urRes == SEEDMASK_UR_PSBT_NEED_MORE) {
            free(tmp);
            crypto_set_signed_ur_type_from_scan(p);
            setMsg("Frame OK — scan next QR");
            strncpy(g_cryptoPsbtUrRaw, p, CRYPTO_PSBT_UR_RAW_BYTES - 1);
            g_cryptoPsbtUrRaw[CRYPTO_PSBT_UR_RAW_BYTES - 1] = 0;
            draw();
            delay(10);
            return;
          }
          if (urRes == SEEDMASK_UR_PSBT_ERROR) {
            free(tmp);
            setMsg(urErr[0] ? urErr : "UR error");
            draw();
            delay(10);
            return;
          }
          crypto_release_psbt_decoded_buf();
          g_cryptoPsbtDecodedBuf = tmp;
          g_cryptoPsbtDecodedLen = decLen;
          crypto_set_signed_ur_type_from_scan(p);
          g_qrScanning = false;
          stop_qr_scan();
          strncpy(g_cryptoPsbtUrRaw, p, CRYPTO_PSBT_UR_RAW_BYTES - 1);
          g_cryptoPsbtUrRaw[CRYPTO_PSBT_UR_RAW_BYTES - 1] = 0;
          g_cryptoHasUnsigned = true;
          g_cryptoHasSigned = false;
          g_cryptoPsbtSignedUr[0] = 0;
          g_cryptoBcUrFountain = false;
          seedmask_bc_ur_reset();
          setMsg("PSBT QR captured");
          g_syncTouchAfterQrScan = true;
          g_cryptoAutoSignPending = false;
          show(UIScreen::CRYPTO_REVIEW_PSBT);
          waitTouchRelease(250);
          return;
        }
        // Bad decode (noise / wrong QR): do NOT return — otherwise swipe-back never runs while camera
        // keeps re-decoding garbage every frame.
        setMsg("Not a UR PSBT QR");
        draw();
        delay(10);
      } else {
        if (g_qrScanTarget == QrScanTarget::RESTORE) {
          for (size_t align = 0; align + 10 <= len && align < 512u; align++) {
            if (strncasecmp(p + align, "SPE1-M", 6) != 0) continue;
            if (p[align + 6] < '0' || p[align + 6] > '9') continue;
            if (align > 0) {
              size_t rest = len - align + 1;
              memmove(p, p + align, rest);
              len = strlen(p);
            }
            break;
          }
        }
        // Multi-part vault: "SPE1-Mk/n|" + chunk (e.g. SPE1-M1/3|base64chunk)
        // Multi-part vault: "SPE1-Mk/n|chunk" where k=part, n=total (e.g. SPE1-M1/3|base64...)
        bool isMultiPart =
          len >= 8 && strncasecmp(p, "SPE1-M", 6) == 0 && p[6] >= '0' && p[6] <= '9';
        // Vault encrypted restore only — same prefix must not touch g_restoreChunk* from other QR modes.
        if (isMultiPart && g_qrScanTarget == QrScanTarget::RESTORE) {
          Serial.print("Multi-part QR detected: ");
          Serial.println(preview);
          unsigned int pk = 0, pn = 0;
          // Find '|' after "SPE1-M"; scan full remainder (prefix is only k/n| — no tiny cap).
          size_t searchLen = (len > 6) ? (len - 6) : 0;
          const char* bar = searchLen ? (const char*)memchr(p + 6, '|', searchLen) : nullptr;
          if (bar && bar - p >= 8) {
            int sc = sscanf(p + 6, "%u/%u", &pk, &pn);
            Serial.printf("Multi-part parse: sc=%d, pk=%u, pn=%u\n", sc, pk, pn);
            if (sc == 2 && pn >= 1 && pn <= VAULT_QR_MAX_PARTS && pk >= 1 && pk <= pn) {
              const char* chunk = bar + 1;
              size_t chunkLen = strlen(chunk);
              Serial.printf("Multi-part chunk %u/%u: %u chars\n", pk, pn, (unsigned)chunkLen);
              if (chunkLen > 0 && chunkLen < sizeof(g_restoreChunks[0])) {
                if ((unsigned)pn != g_restoreChunkTotal) {
                  g_restoreChunkTotal = (uint8_t)pn;
                  memset(g_restoreChunkGot, 0, sizeof(g_restoreChunkGot));
                  if (g_restoreChunks) {
                    memset(g_restoreChunks, 0,
                           (size_t)VAULT_QR_MAX_PARTS * (size_t)VAULT_QR_PART_LINE_BYTES);
                  }
                }
                g_restoreChunkGot[pk - 1] = 1;
                memcpy(g_restoreChunks[pk - 1], chunk, chunkLen + 1);
                int have = 0;
                for (int i = 0; i < g_restoreChunkTotal; i++) have += g_restoreChunkGot[i];
                Serial.printf("Multi-part progress: %d/%d parts received\n", have, (int)g_restoreChunkTotal);
                if (have == (int)g_restoreChunkTotal) {
                  size_t pos = 0;
                  strcpy(g_restoreFull, "SPE1|");
                  pos = 5;
                  for (int i = 0; i < g_restoreChunkTotal && pos < RESTORE_FULL_MAX_BYTES - 1; i++) {
                    size_t L = strlen(g_restoreChunks[i]);
                    if (pos + L >= RESTORE_FULL_MAX_BYTES) L = RESTORE_FULL_MAX_BYTES - 1 - pos;
                    memcpy(g_restoreFull + pos, g_restoreChunks[i], L);
                    pos += L;
                  }
                  g_restoreFull[pos] = 0;
                  g_restoreChunkTotal = 0;
                  memset(g_restoreChunkGot, 0, sizeof(g_restoreChunkGot));
                  g_qrScanning = false;
                  stop_qr_scan();
                  clearPassword(g_password1);
                  preparePasswordPromptKeyboard();
                  setMsg("QR OK. Enter password to decrypt.");
                  show(UIScreen::RESTORE_PASSWORD);
                  waitTouchRelease(400);
                } else {
                  // Intermediate part: stop camera (full refresh on Next), show confirm — last part uses branch above.
                  g_restoreMpConfirmSavedPart = (uint8_t)pk;
                  g_restoreMpConfirmTotalParts = (uint8_t)pn;
                  g_qrScanning = false;
                  stop_qr_scan();
                  setMsg("");
                  show(UIScreen::RESTORE_MP_CHUNK_OK);
                  waitTouchRelease(400);
                }
              }
            }
          }
          return;
        }

        bool isSPE1 = (strncmp(p, "SPE1|", 5) == 0 || strncmp(p, "spe1|", 5) == 0);
        bool isSP2 = (strncmp(p, "SP2|", 4) == 0 || strncmp(p, "sp2|", 4) == 0);
        bool isSPB1 = (strncmp(p, "SPB1-", 5) == 0 || strncmp(p, "spb1-", 5) == 0);
        bool isSPF1 = (strncmp(p, "SPF1-", 5) == 0 || strncmp(p, "spf1-", 5) == 0);
        if (!isSPE1 && !isSP2 && !isSPB1 && !isSPF1) {
          for (int i = 0; i < 20 && p[i]; i++) {
            if ((p[i] == 'S' || p[i] == 's') && (p[i + 1] == 'P' || p[i + 1] == 'p')) {
              if (strncasecmp(p + i, "SPE1|", 5) == 0) {
                p += i;
                isSPE1 = true;
                break;
              }
              if (strncasecmp(p + i, "SP2|", 4) == 0) {
                p += i;
                isSP2 = true;
                break;
              }
              if (strncasecmp(p + i, "SPB1-", 5) == 0) {
                p += i;
                isSPB1 = true;
                break;
              }
              if (strncasecmp(p + i, "SPF1-", 5) == 0) {
                p += i;
                isSPF1 = true;
                break;
              }
            }
          }
        }

        if (isSPE1 || isSP2) {
          g_qrScanning = false;
          stop_qr_scan();
          strncpy(g_restoreFull, p, RESTORE_FULL_MAX_BYTES - 1);
          g_restoreFull[RESTORE_FULL_MAX_BYTES - 1] = 0;
          clearPassword(g_password1);
          preparePasswordPromptKeyboard();
          setMsg("QR OK. Enter password to decrypt.");
          show(UIScreen::RESTORE_PASSWORD);
          waitTouchRelease(400);
        } else if (isSPB1 || isSPF1) {
          g_qrScanning = false;
          stop_qr_scan();
          // Uppercase the payload only (base32 is case-insensitive)
          for (size_t i = 0; p[i]; i++)
            if (p[i] >= 'a' && p[i] <= 'z') p[i] = (char)(p[i] - 'a' + 'A');
          strncpy(g_restoreFull, p, RESTORE_FULL_MAX_BYTES - 1);
          g_restoreFull[RESTORE_FULL_MAX_BYTES - 1] = 0;
          if (!g_restorePayload) {
            setMsg("Memory low");
            show(UIScreen::ERROR_SCREEN);
            waitTouchRelease(120);
            return;
          }
          g_restorePayloadIsSpf1 = isSPF1;
          const char* src = p + 5;
          char* dst = g_restorePayload;
          size_t cap = (size_t)RESTORE_PAYLOAD_MAX - 1;
          while (*src && cap > 0) {
            if (*src != '-') {
              *dst++ = *src;
              cap--;
            }
            src++;
          }
          *dst = 0;
          clearPassword(g_password1);
          preparePasswordPromptKeyboard();
          setMsg("QR OK. Enter password to decrypt.");
          show(UIScreen::RESTORE_PASSWORD);
          waitTouchRelease(400);  // sync touch state so keyboard works
        } else {
          g_qrScanning = false;
          stop_qr_scan();
          strncpy(g_restoreFull, p, RESTORE_FULL_MAX_BYTES - 1);
          g_restoreFull[RESTORE_FULL_MAX_BYTES - 1] = 0;
          Serial.print("QR unrecognized prefix: ");
          Serial.println(preview);
          setMsg("QR not SPE1/SP2/SPB1/SPF1. Tap NEXT to try password.");
          if (!g_restoreCodeEntryMode) g_restoreCodeEntryMode = true;
          show(UIScreen::RESTORE_CODE);
        }
      }  // end RESTORE-only decode (else: not CRYPTO_PSBT)
    }

    delay(2);
    // Do not return: fall through so swipe-back and BACK work while the camera is running.
  }

  // ---- NORMAL TOUCH/UI HANDLING ----
  // ---- NORMAL TOUCH/UI HANDLING ----
  static bool wasPressed = false;
  // Throttle I2C touch reads while finger is held to reduce bus traffic (avoids display fog); tap/release stay responsive
  static uint32_t lastTouchReadMs = 0;
  static uint16_t lastSx = 0, lastSy = 0;
  static const uint32_t TOUCH_HOLD_THROTTLE_MS = 18;
  static const uint32_t STATIC_WELCOME_TOUCH_POLL_MS = 28;

  uint16_t sx = 0, sy = 0;
  bool pressed;
  uint32_t now = millis();
  bool onSdFileScreen = (g_screen == UIScreen::SD_BROWSER || g_screen == UIScreen::RESTORE_SD
                         || g_screen == UIScreen::CRYPTO_MULTISIG_SD_BROWSE
                         || g_screen == UIScreen::CRYPTO_TX_SD_BROWSE);
  const bool staticWelcomeTouchIdle =
    !onSdFileScreen
    && !g_busy
    && g_editMode == EditMode::NONE
    && !wasPressed
    && !g_pwFieldDragging && !g_noteFieldDragging && !g_titleDragging
    && !g_spaceTrackActive && !g_brightnessBarDragging && !g_psbtSlideDragging
    // Same as HOME: when finger is up, throttle I2C reads so QSPI LCD updates are not fighting the bus (visible flicker).
    // While pressed / dragging, wasPressed is true so we always read live — typing stays responsive.
    && (g_screen == UIScreen::HOME || g_screen == UIScreen::CREATE_PICK
        || g_screen == UIScreen::LOCKED || g_screen == UIScreen::UNLOCK_PASSWORD);

  if (staticWelcomeTouchIdle
      && g_staticWelcomeTouchPollMs != 0
      && (uint32_t)(now - g_staticWelcomeTouchPollMs) < STATIC_WELCOME_TOUCH_POLL_MS) {
    pressed = g_staticWelcomeTouchLastPressed;
    sx = g_staticWelcomeTouchLastSx;
    sy = g_staticWelcomeTouchLastSy;
  } else if (!onSdFileScreen && wasPressed && (now - lastTouchReadMs) < TOUCH_HOLD_THROTTLE_MS) {
    // While using drag gestures (fields, title scroll, spacebar trackpad, brightness bar, nav swipe),
    // read live coords — frozen samples make upward swipes look like taps and steal Status panel.
    if (!g_pwFieldDragging && !g_noteFieldDragging && !g_titleDragging && !g_spaceTrackActive && !g_brightnessBarDragging
        && !g_psbtSlideDragging && !g_psbtSlideAwaitSwipe
        && !g_navGestureTracking && !g_navHomeLineDown && !g_navWakeTracking
        && g_navOverlay != NavOverlay::APP_SWITCHER) {
      pressed = true;
      sx = lastSx;
      sy = lastSy;
    } else {
      pressed = readTouchScreen(sx, sy);
      lastTouchReadMs = now;
      if (pressed) {
        lastSx = sx;
        lastSy = sy;
      }
    }
  } else {
    pressed = readTouchScreen(sx, sy);
    lastTouchReadMs = now;
    if (pressed) {
      lastSx = sx;
      lastSy = sy;
    }
    if (g_screen == UIScreen::HOME || g_screen == UIScreen::LOCKED || g_screen == UIScreen::CREATE_PICK
        || g_screen == UIScreen::UNLOCK_PASSWORD) {
      g_staticWelcomeTouchLastPressed = pressed;
      g_staticWelcomeTouchLastSx = sx;
      g_staticWelcomeTouchLastSy = sy;
      g_staticWelcomeTouchPollMs = now;
    }
  }
  if (pressed) {
    g_lastUserActivityMs = now;
    lcdBacklightResumeIfSuspended();
  }
  // Nav bar: capture gesture on touch-down before other handlers can return early.
  if (pressed && !wasPressed) {
    g_navWakeTracking = false;
    g_navWakeArmed = false;
    g_navSleepWakeOnSpace = false;
    g_navSpacebarNavSession = false;
    g_navWakeDownMs = 0;
    g_navHomeLineDown = false;
    g_navReleaseArmMs = 0;
    g_navGesturePeakMinY = sy;
    // Home pill wins over spacebar: kb_layout_init() keeps row4 rects warm even when the
    // keyboard is hidden, so a naive hitSpacebar() on the center strip falsely blocked Home
    // on every non-keyboard screen (Connect Software, lists, etc.).
    const bool homeLineHit = nav_bar_visible() && nav_bar_home_tap_hit((int16_t)sx, (int16_t)sy);
    if (g_navOverlay == NavOverlay::APP_SWITCHER) {
      // Switcher owns its own drag tracking; do not arm bottom-nav gesture state.
      g_navGestureTracking = false;
      g_navHomeLineDown = false;
    } else if (g_navOverlay == NavOverlay::STATUS_PANEL) {
      // Status panel icon taps must not arm nav-gesture ownership (that made toggles flaky).
      g_navGestureTracking = false;
      g_navHomeLineDown = false;
      g_navReleaseArmMs = 0;
    } else if (!g_spaceTrackActive && nav_bar_wake_touch_down_contains(sx, sy, now)) {
      g_navWakeTracking = true;
      g_navWakeArmed = true;
      g_navWakeDownX = sx;
      g_navWakeDownY = sy;
      g_navWakeDownMs = now;
      // Keep gesture tracking so release debounce + swipe commit still run after wake.
      g_navGestureTracking = true;
      g_navGestureDownX = sx;
      g_navGestureDownY = sy;
      g_navGestureDownMs = now;
      g_navHomeLineDown = homeLineHit;
    } else if (!g_spaceTrackActive && nav_bar_gestures_allowed(now)
               && homeLineHit
               && !nav_bar_ui_blocks_gesture_at((int16_t)sx, (int16_t)sy)) {
      // Arm only from the white home pill — not the full bottom strip — so bottom
      // buttons (Import backup, ADD, Back, Export, …) stay tappable.
      g_navGestureTracking = true;
      g_navGestureDownX = sx;
      g_navGestureDownY = sy;
      g_navGestureDownMs = now;
      g_navSpacebarNavSession = false;
      g_navHomeLineDown = true;
      nav_bar_touch_activity(now);
    } else if (!g_spaceTrackActive && homeLineHit && g_navOverlay == NavOverlay::NONE
               && !nav_bar_ui_blocks_gesture_at((int16_t)sx, (int16_t)sy)) {
      // Home line arms even when nav is asleep — but never over a bottom CTA
      // (BIP85 OK, confirm SET, …) that overlaps the pill band.
      g_navGestureTracking = true;
      g_navGestureDownX = sx;
      g_navGestureDownY = sy;
      g_navGestureDownMs = now;
      g_navSpacebarNavSession = false;
      g_navHomeLineDown = true;
      nav_bar_touch_activity(now);
    } else {
      g_navGestureTracking = false;
      g_navSpacebarNavSession = false;
      g_navHomeLineDown = false;
      g_navGesturePeakMinY = 0xFFFF;
      g_navReleaseArmMs = 0;
    }
  }

  // ===== Nav bar gesture owner =====
  // Owns the touch until commit. Debounces brief touch dropouts that previously
  // turned mid-swipe samples into a Home tap (breaking Status panel / App switcher).
  if (g_navGestureTracking && g_navOverlay == NavOverlay::NONE) {
    if (pressed) {
      g_navReleaseArmMs = 0;
      if (sy < g_navGesturePeakMinY) g_navGesturePeakMinY = sy;

      // Keyboard asleep: wake on upward swipe, then continue this same gesture.
      if (g_navWakeTracking && g_navWakeArmed && nav_bar_keyboard_active()
          && !nav_bar_awake_now(now)) {
        const int wakeDx = (int)sx - (int)g_navWakeDownX;
        const int wakeDy = (int)sy - (int)g_navWakeDownY;
        const uint32_t wakeHoldMs = (g_navWakeDownMs > 0) ? (now - g_navWakeDownMs) : 0;
        if (nav_bar_wake_swipe_qualifies(wakeDx, wakeDy, wakeHoldMs)) {
          nav_bar_wake(now);
          g_navWakeTracking = false;
          g_navWakeArmed = false;
          g_navWakeDownMs = 0;
        }
      }

      const int upLive = (int)g_navGestureDownY - (int)g_navGesturePeakMinY;
      const uint32_t holdMs = (g_navGestureDownMs > 0) ? (now - g_navGestureDownMs) : 0;
      // Live long-swipe / hold → App switcher (before release).
      if (upLive >= NAV_LONG_SWIPE_DY
          || (holdMs >= NAV_HOLD_MS && upLive >= NAV_SWIPE_MIN_DY)) {
        g_navGestureTracking = false;
        g_navHomeLineDown = false;
        g_navSpacebarNavSession = false;
        g_navWakeTracking = false;
        g_navWakeArmed = false;
        g_navGesturePeakMinY = 0xFFFF;
        g_navReleaseArmMs = 0;
        if (!g_navSwitcherDisabled)
          nav_open_app_switcher(true, sx, sy);
        else
          nav_open_status_panel();
        g_touchIgnoreUntil = now + 180;
        wasPressed = pressed;
        return;
      }

      wasPressed = pressed;
      return;
    }

    // Finger reported up — wait out dropouts before committing.
    if (g_navReleaseArmMs == 0) g_navReleaseArmMs = now;
    if ((now - g_navReleaseArmMs) < NAV_RELEASE_DEBOUNCE_MS) {
      wasPressed = true;
      return;
    }

    int up = (int)g_navGestureDownY - (int)g_navGesturePeakMinY;
    if (up < 0) up = 0;
    if (lastSy != 0) {
      const int upLast = (int)g_navGestureDownY - (int)lastSy;
      if (upLast > up) up = upLast;
    }
    const uint32_t holdMs = (g_navGestureDownMs > 0) ? (now - g_navGestureDownMs) : 0;
    const bool onPill = nav_bar_home_tap_hit((int16_t)g_navGestureDownX, (int16_t)g_navGestureDownY);
    const bool spacebarNav = g_navSpacebarNavSession;

    g_navGestureTracking = false;
    g_navHomeLineDown = false;
    g_navSpacebarNavSession = false;
    g_navWakeTracking = false;
    g_navWakeArmed = false;
    g_navGesturePeakMinY = 0xFFFF;
    g_navReleaseArmMs = 0;

    if (up >= NAV_LONG_SWIPE_DY || (holdMs >= NAV_HOLD_MS && up >= NAV_SWIPE_MIN_DY)) {
      if (!g_navSwitcherDisabled)
        nav_open_app_switcher(false, 0, 0);
      else
        nav_open_status_panel();
      g_touchIgnoreUntil = now + 180;
    } else if (up >= NAV_SWIPE_MIN_DY) {
      nav_open_status_panel();
      g_touchIgnoreUntil = now + 180;
    } else if (onPill && !spacebarNav) {
      nav_bar_go_home();
    }

    wasPressed = false;
    return;
  }

  // App switcher owns touch (Android/iOS pattern: lock scroll after slop, tap only if still).
  if (g_navOverlay == NavOverlay::APP_SWITCHER) {
    const int useX = pressed ? (int)sx : (int)lastSx;
    const int useY = pressed ? (int)sy : (int)lastSy;
    nav_switcher_handle_touch(pressed, wasPressed, useX, useY, now);
    wasPressed = pressed;
    return;
  }

  if (g_navOverlay == NavOverlay::STATUS_PANEL) {
    const int useX = pressed ? (int)sx : (int)lastSx;
    const int useY = pressed ? (int)sy : (int)lastSy;
    nav_status_panel_handle_touch(pressed, wasPressed, useX, useY, now);
    wasPressed = pressed;
    return;
  }

  // Status panel / App switcher just closed: do not deliver this finger's remaining
  // samples (or a bounce re-press) to the screen underneath.
  if (g_navOverlayConsumeTouch) {
    if (pressed) {
      wasPressed = pressed;
      return;
    }
    g_navOverlayConsumeTouch = false;
    g_touchReleasedSinceTap = true;
    wasPressed = false;
    return;
  }

  if (pressed && g_screen == UIScreen::DURESS_GAME_BREAKOUT && g_editMode == EditMode::NONE
      && (int)sy >= BO_PADDLE_ZONE_TOP) {
    float px = (float)sx;
    const float phw = (float)BO_PADDLE_W * 0.5f;
    if (px < phw + 4.f) px = phw + 4.f;
    if (px > (float)LCD_W - phw - 4.f) px = (float)LCD_W - phw - 4.f;
    if (fabsf(px - g_breakoutPaddleX) > 0.5f) {
      g_breakoutPaddleX = px;
    }
  }
  if (pressed && g_screen == UIScreen::DURESS_GAME_SPACE && g_editMode == EditMode::NONE
      && (int)sy >= DS_PADDLE_ZONE_TOP) {
    float px = (float)sx;
    const float phw = (float)duress_space_player_half_w_i();
    if (px < phw + 4.f) px = phw + 4.f;
    if (px > (float)LCD_W - phw - 4.f) px = (float)LCD_W - phw - 4.f;
    if (fabsf(px - g_dsPlayerX) > 0.5f) g_dsPlayerX = px;
  }
  // PSBT Visualize: vertical scroll of FLOW when many inputs
  if ((g_screen == UIScreen::CRYPTO_PSBT_FEE || g_screen == UIScreen::CRYPTO_KASPA_FEE) && g_editMode == EditMode::NONE && g_psbtSignConfirmActive
      && g_psbtVisualizeActive) {
    const int16_t panelTop = 90;
    const int16_t panelBot = (g_psbtVizPanelBot > panelTop) ? g_psbtVizPanelBot : (int16_t)260;
    if (pressed && !wasPressed) {
      if (hitPad(BTN_PSBT_VIZ_CLOSE, (int16_t)sx, (int16_t)sy, 18) || hit(BTN_TOP_BURGER, (int16_t)sx, (int16_t)sy)) {
        g_psbtVisualizeActive = false;
        g_psbtVizScrolling = false;
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        draw();
        wasPressed = pressed;
        return;
      }
      if ((int16_t)sy >= panelTop && (int16_t)sy < panelBot && g_psbtVizScrollMax > 0) {
        g_psbtVizScrolling = true;
        g_psbtVizScrollLastY = (int16_t)sy;
        g_psbtVizScrollAccum = 0;
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        wasPressed = pressed;
        return;
      }
    }
    if (pressed && wasPressed && g_psbtVizScrolling) {
      int16_t dy = (int16_t)((int16_t)g_psbtVizScrollLastY - (int16_t)sy);
      g_psbtVizScrollLastY = (int16_t)sy;
      if (dy != 0) {
        g_psbtVizScrollAccum = (int16_t)(g_psbtVizScrollAccum + (dy < 0 ? -dy : dy));
        int16_t next = (int16_t)(g_psbtVizScrollY + dy);
        if (next < 0) next = 0;
        if (next > g_psbtVizScrollMax) next = g_psbtVizScrollMax;
        if (next != g_psbtVizScrollY) {
          g_psbtVizScrollY = next;
          drawPsbtTxVisualizeOverlay();
          ui_flush();
        }
      }
      wasPressed = pressed;
      return;
    }
    if (!pressed && wasPressed && g_psbtVizScrolling) {
      g_psbtVizScrolling = false;
      g_psbtVizScrollLastY = -1;
      wasPressed = pressed;
      return;
    }
  }

  // PSBT slide: digitizer often reports brief pressed=false while finger is still — debounce real lift-off.
  if ((g_screen == UIScreen::CRYPTO_PSBT_FEE || g_screen == UIScreen::CRYPTO_KASPA_FEE) && g_editMode == EditMode::NONE && g_psbtSignConfirmActive
      && !g_psbtVisualizeActive && g_psbtSlideDragging) {
    if (pressed) {
      g_psbtSlideDragReleaseStartMs = 0;
    } else {
      if (g_psbtSlideDragReleaseStartMs == 0) g_psbtSlideDragReleaseStartMs = now;
      if ((uint32_t)(now - g_psbtSlideDragReleaseStartMs) >= PSBT_SLIDE_DRAG_RELEASE_DEBOUNCE_MS) {
        g_psbtSlideDragging = false;
        g_psbtSlideDragReleaseStartMs = 0;
        // Final position from last finger X (skip slew lag that left the thumb short of the end).
        {
          int16_t maxO = psbt_slide_max_offset();
          uint16_t xLift = lastSx;
          if (xLift >= LCD_W) xLift = (uint16_t)(LCD_W - 1);
          int16_t liftOff = psbt_slide_stable_offset_from_x(xLift, maxO, -1);
          if (liftOff > g_psbtSlideThumbOffset) g_psbtSlideThumbOffset = liftOff;
          if (psbt_slide_finger_in_commit_zone(xLift) && maxO > 0) g_psbtSlideThumbOffset = maxO;
        }
        if (psbt_slide_past_commit_threshold() || psbt_slide_finger_in_commit_zone(lastSx)) {
          psbt_slide_commit_sign();
        } else {
          psbt_slide_reset();
          draw();
        }
        wasPressed = pressed;
        return;
      }
    }
  }
  // PSBT confirm: lifted finger before swipe armed — ignore tap-to-jump
  if ((g_screen == UIScreen::CRYPTO_PSBT_FEE || g_screen == UIScreen::CRYPTO_KASPA_FEE) && g_editMode == EditMode::NONE && g_psbtSignConfirmActive
      && !g_psbtVisualizeActive && !pressed && wasPressed
      && g_psbtSlideAwaitSwipe && !g_psbtSlideDragging) {
    g_psbtSlideAwaitSwipe = false;
    wasPressed = pressed;
    return;
  }
  // PSBT confirm overlay: thumb follows finger while dragging (slew + last X during brief false pressed).
  if ((g_screen == UIScreen::CRYPTO_PSBT_FEE || g_screen == UIScreen::CRYPTO_KASPA_FEE) && g_editMode == EditMode::NONE && g_psbtSignConfirmActive
      && !g_psbtVisualizeActive && wasPressed
      && g_psbtSlideDragging) {
    const bool slideContact =
      pressed
      || (g_psbtSlideDragReleaseStartMs != 0
          && (uint32_t)(now - g_psbtSlideDragReleaseStartMs) < PSBT_SLIDE_DRAG_RELEASE_DEBOUNCE_MS);
    if (slideContact) {
      uint16_t xUse = pressed ? sx : lastSx;
      float xIn = (float)xUse;
      if (g_psbtSlideFilteredX < 0.f) {
        g_psbtSlideFilteredX = xIn;
      } else {
        float dv = fabsf(xIn - g_psbtSlideFilteredX);
        float alpha = PSBT_SLIDE_X_EMA_ALPHA_BASE;
        if (dv > PSBT_SLIDE_X_EMA_FAST_DV) alpha += PSBT_SLIDE_X_EMA_BOOST;
        if (dv > PSBT_SLIDE_X_EMA_BURST_DV) alpha += PSBT_SLIDE_X_EMA_BURST_EXTRA;
        if (alpha > PSBT_SLIDE_X_EMA_ALPHA_MAX) alpha = PSBT_SLIDE_X_EMA_ALPHA_MAX;
        g_psbtSlideFilteredX += alpha * (xIn - g_psbtSlideFilteredX);
      }
      uint16_t xSmooth = (uint16_t)(g_psbtSlideFilteredX + 0.5f);
      if (xSmooth >= LCD_W) xSmooth = (uint16_t)(LCD_W - 1);
      int16_t maxO = psbt_slide_max_offset();
      int16_t targetOff = psbt_slide_stable_offset_from_x(xSmooth, maxO, g_psbtSlideThumbOffset);
      int16_t fingerOff = psbt_slide_slew_toward(targetOff, g_psbtSlideThumbOffset, maxO);
      // If finger is already in the commit zone, snap thumb to the end (don't wait on slew).
      if (psbt_slide_finger_in_commit_zone(xSmooth) && maxO > 0) fingerOff = maxO;
      if (fingerOff != g_psbtSlideThumbOffset) {
        g_psbtSlideThumbOffset = fingerOff;
        const uint32_t n = millis();
        const bool atEnd = (maxO > 0 && fingerOff >= maxO);
        const int dPaint = abs((int)fingerOff - (int)g_psbtSlidePaintedOffset);
        if (atEnd || dPaint >= 2 || (uint32_t)(n - g_psbtSlideDragPaintMs) >= 12u) {
          g_psbtSlideDragPaintMs = n;
          g_psbtSlidePaintedOffset = fingerOff;
          draw();
        }
      }
      // Commit when thumb/finger reaches the end — don't require a perfect release.
      if (maxO > 0
          && (g_psbtSlideThumbOffset >= maxO || psbt_slide_finger_in_commit_zone(xSmooth))) {
        g_psbtSlideDragging = false;
        g_psbtSlideDragReleaseStartMs = 0;
        psbt_slide_commit_sign();
        wasPressed = pressed;
        return;
      }
    }
    wasPressed = pressed;
    return;
  }
  // PSBT: thumb moves only after horizontal swipe passes threshold (tap at track end does nothing)
  if ((g_screen == UIScreen::CRYPTO_PSBT_FEE || g_screen == UIScreen::CRYPTO_KASPA_FEE) && g_editMode == EditMode::NONE && g_psbtSignConfirmActive
      && !g_psbtVisualizeActive && pressed && wasPressed
      && g_psbtSlideAwaitSwipe && !g_psbtSlideDragging) {
    const int dx = (int)sx - (int)g_psbtSlideDownX;
    if (dx >= PSBT_SLIDE_SWIPE_START_PX) {
      g_psbtSlideSuppressSwipeBackUntil = millis() + PSBT_SLIDE_POST_COMMIT_SWIPE_BLOCK_MS;
      g_psbtSlideDragging = true;
      g_psbtSlideAwaitSwipe = false;
      g_psbtSlideFilteredX = (float)sx;
      int16_t maxO = psbt_slide_max_offset();
      int16_t fingerOff = psbt_slide_stable_offset_from_x(sx, maxO);
      g_psbtSlideThumbOffset = fingerOff;
      g_psbtSlideDragPaintMs = millis();
      g_psbtSlidePaintedOffset = fingerOff;
      draw();
    }
    wasPressed = pressed;
    return;
  }
  if (pressed && !wasPressed) {
    g_swipeDownX = sx;
    g_swipeDownY = sy;
    g_swipeReserved = false;
    g_multisigEdgeDeferTap = false;
    // PSBT Fee: overlay CANCEL + slide must not use KEY_DEBOUNCE_MS — right after NEXT, debounce blocked slide.
    // Thumb uses immediate drag; empty track uses swipe threshold (see below).
    if ((g_screen == UIScreen::CRYPTO_PSBT_FEE || g_screen == UIScreen::CRYPTO_KASPA_FEE) && g_editMode == EditMode::NONE) {
      if (g_psbtSignConfirmActive) {
        if (g_psbtVisualizeActive) {
          if (hitPad(BTN_PSBT_VIZ_CLOSE, (int16_t)sx, (int16_t)sy, 18) || hit(BTN_TOP_BURGER, (int16_t)sx, (int16_t)sy)) {
            g_lastTapMs = now;
            g_touchReleasedSinceTap = false;
            g_psbtVisualizeActive = false;
            g_psbtVizScrolling = false;
            draw();
            wasPressed = pressed;
            return;
          }
          // Scroll arming handled above; ignore other press-downs here
          g_lastTapMs = now;
          g_touchReleasedSinceTap = false;
          wasPressed = pressed;
          return;
        }
        if (g_psbtSignCancelConfirmPopup) {
          Rect rYes, rNo;
          psbt_sign_cancel_popup_btn_rects(&rYes, &rNo);
          if (hit(rYes, (int16_t)sx, (int16_t)sy)) {
            g_lastTapMs = now;
            g_touchReleasedSinceTap = false;
            psbt_slide_reset();
            g_psbtSignCancelConfirmPopup = false;
            g_psbtVisualizeActive = false;
            setMsg("");
            show(UIScreen::CRYPTO_HOME);
            wasPressed = pressed;
            return;
          }
          if (hit(rNo, (int16_t)sx, (int16_t)sy)) {
            g_lastTapMs = now;
            g_touchReleasedSinceTap = false;
            g_psbtSignCancelConfirmPopup = false;
            draw();
            wasPressed = pressed;
            return;
          }
          g_lastTapMs = now;
          g_touchReleasedSinceTap = false;
          wasPressed = pressed;
          return;
        }
        if (hit(BTN_PSBT_SIGN_CONF_VISUALIZE, (int16_t)sx, (int16_t)sy)) {
          g_lastTapMs = now;
          g_touchReleasedSinceTap = false;
          if (g_screen == UIScreen::CRYPTO_KASPA_FEE)
            crypto_refresh_kaspa_review();
          else
            crypto_refresh_psbt_review();
          g_psbtVisualizeActive = true;
          g_psbtVizScrollY = 0;
          g_psbtVizScrolling = false;
          g_psbtVizLastAnimMs = millis();
          draw();
          wasPressed = pressed;
          return;
        }
        if (hit(BTN_PSBT_SIGN_CONF_CANCEL, (int16_t)sx, (int16_t)sy)) {
          g_lastTapMs = now;
          g_touchReleasedSinceTap = false;
          g_psbtSignCancelConfirmPopup = true;
          draw();
          wasPressed = pressed;
          return;
        }
        if (psbt_slide_thumb_contains((int16_t)sx, (int16_t)sy)) {
          g_psbtSlideSuppressSwipeBackUntil = millis() + PSBT_SLIDE_POST_COMMIT_SWIPE_BLOCK_MS;
          g_psbtSlideDragging = true;
          g_psbtSlideAwaitSwipe = false;
          g_psbtSlideFilteredX = (float)sx;
          int16_t maxO = psbt_slide_max_offset();
          int16_t fingerOff = psbt_slide_stable_offset_from_x(sx, maxO);
          g_psbtSlideThumbOffset = fingerOff;
          g_psbtSlideDragPaintMs = now;
          g_psbtSlidePaintedOffset = fingerOff;
          g_lastTapMs = now;
          g_touchReleasedSinceTap = false;
          wasPressed = pressed;
          draw();
          return;
        }
        if (psbt_slide_hit_grab_zone((int16_t)sx, (int16_t)sy)) {
          g_psbtSlideSuppressSwipeBackUntil = millis() + PSBT_SLIDE_POST_COMMIT_SWIPE_BLOCK_MS;
          g_psbtSlideAwaitSwipe = true;
          g_psbtSlideDownX = (int16_t)sx;
          g_lastTapMs = now;
          g_touchReleasedSinceTap = false;
          wasPressed = pressed;
          return;
        }
      }
      if ((now - g_lastTapMs > (uint32_t)KEY_DEBOUNCE_MS) && hit(BTN_TOP_BURGER, sx, sy)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        show(UIScreen::CRYPTO_HOME);
        wasPressed = pressed;
        return;
      }
    }
    // VIEW_CODE: Save to SD on first frame — before space track, list logic, or swipe-reserve can return.
    if (g_screen == UIScreen::VIEW_CODE && g_editMode == EditMode::NONE && g_touchReleasedSinceTap && sd_ready()
        && (now - g_lastTapMs > (uint32_t)KEY_DEBOUNCE_MS)) {
      if (viewCodeTrySaveToSdTap(sx, sy)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        wasPressed = pressed;
        return;
      }
    }
    // 2FA list: capture touch-down on first frame so scroll has correct start (works when time not set too)
    if (g_screen == UIScreen::TFA_LIST && (int)sy >= 56 && (int)sy <= 419) {
      if (!hit(BTN_TFA_ADD, sx, sy)) {
        g_listTouchPending = true;
        g_listTouchDownX = sx;
        g_listTouchDownY = sy;
        g_listTouchDownMs = now;
      }
    }
    if (g_screen == UIScreen::DEVICE_SETTINGS && (int)sy >= DEVICE_SETTINGS_VIEW_TOP && (int)sy <= DEVICE_SETTINGS_VIEW_BOTTOM) {
      if (!hit(BTN_TOP_BURGER, sx, sy) && !hit(RECT_TOP_TITLE, sx, sy)) {
        g_deviceSettingsListTouchPending = true;
        g_deviceSettingsListDownX = sx;
        g_deviceSettingsListDownY = sy;
        g_deviceSettingsListDownMs = now;
        g_deviceSettingsListDidDrag = false;
      }
    }
    if (g_screen == UIScreen::DURESS_GAMES && (int)sy >= (int)DURESS_GAMES_LIST_TOP
        && (int)sy <= (int)DURESS_GAMES_LIST_BOTTOM) {
      if (!hit(BTN_TOP_BURGER, sx, sy) && !hit(RECT_TOP_TITLE, sx, sy)) {
        g_duressGamesListTouchPending = true;
        g_duressGamesListDownX = sx;
        g_duressGamesListDownY = sy;
        g_duressGamesListDownMs = now;
        g_duressGamesListDidDrag = false;
      }
    }
    if ((g_screen == UIScreen::CREATE_SHOW_CODE || g_screen == UIScreen::BACKUP_SHOW_CODE)
        && g_editMode == EditMode::NONE) {
      const char* dispTap = (g_pwScreenSpf1BackupCode && g_pwScreenSpf1BackupCode[0]) ? g_pwScreenSpf1BackupCode : g_backupCode;
      const bool spf1Tap = dispTap && dispTap[0] && strncmp(dispTap, "SPF1-", 5) == 0;
      const int16_t vpTopTap = (int16_t)((spf1Tap ? 84 : 78) + 25);
      const int16_t vpBottomTap = 406;
      bool inVpTap = (sx >= 8 && sx < LCD_W - 8 && (int16_t)sy >= vpTopTap && (int16_t)sy < vpBottomTap);
      const int16_t topBarBottomTap = 46;
      const int16_t infoHalfTap = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
      const int16_t infoCxTap = (int16_t)(LCD_W - 8 - infoHalfTap);
      const int16_t infoCyTap = (int16_t)(topBarBottomTap + 6 + infoHalfTap);
      const int16_t padHitTap = 4;
      Rect rShowCodeInfoTap = {
        (int16_t)(infoCxTap - infoHalfTap - padHitTap), (int16_t)(infoCyTap - infoHalfTap - padHitTap),
        (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHitTap), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHitTap)
      };
      if (inVpTap && !hit(BTN_SHOWQR, sx, sy) && !hit(BTN_DONE, sx, sy)
#if SEEDMASK_USB_HID_KEYBOARD
          && !hit(BTN_SHOWCODE_SEND, sx, sy)
#endif
          && !hit(rShowCodeInfoTap, sx, sy)) {
        g_showCodeVpTapPending = true;
        g_showCodeVpTapDownX = sx;
        g_showCodeVpTapDownY = sy;
        g_showCodeVpTapDownMs = now;
        g_showCodeVpTapDidDrag = false;
      }
    }
    if (g_screen == UIScreen::SHOW_CODE_FULLSCREEN && g_editMode == EditMode::NONE) {
      g_showCodeFullscreenDismissPending = true;
      g_showCodeFullscreenDismissDownX = sx;
      g_showCodeFullscreenDismissDownY = sy;
      g_showCodeFullscreenDismissDownMs = now;
      g_showCodeFullscreenDismissDidDrag = false;
    }
  }

  // Spacebar trackpad: while in editor, holding spacebar + dragging moves cursor.
  // Only (re)activate when not already active; some touch controllers briefly
  // report pressed=false while the finger is still down, which would otherwise
  // reset overlay state and cause flicker.
  bool tfaTypingScreen = (g_screen == UIScreen::TFA_ADD);
  bool keyboardSurfaceEnabled = !(g_editMode == EditMode::EDIT_PW_VALUE && !g_pwEditKeyboardVisible);
  bool pwAdvancedOverlayActive = (g_editMode == EditMode::ADD_PW_VALUE)
                                 || (g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && pwEditIsPasswordFocusField(g_pwEditFocusField));
  pwAdvancedOverlayActive = pwAdvancedOverlayActive && g_pwAdvancedPanelOpen;
  if (!g_spaceTrackActive && !g_navWakeTracking && pressed && !wasPressed
      && !g_sdSavePathPickOpen && keyboardSurfaceEnabled && !g_blockKeyboardUntilRelease && ((uint32_t)(now - g_spaceTrackLastInsertMs) > 140u) && (g_editMode != EditMode::NONE || tfaTypingScreen) && !pwAdvancedOverlayActive && hitSpacebar((int16_t)sx, (int16_t)sy)) {
    g_spaceTrackActive = true;
    g_spaceTrackMoved = false;
    g_spaceTrackReleaseMs = 0;
    g_spaceTrackOverlayShown = false;
    g_spaceTrackStartMs = now;
    g_spaceTrackOriginX = (int16_t)sx;
    g_spaceTrackOriginY = (int16_t)sy;
    g_spaceTrackLastX = (int16_t)sx;
    g_spaceTrackLastY = (int16_t)sy;
    g_spaceTrackAccumX = 0;
    g_spaceTrackAccumY = 0;
    g_spaceTrackInsertedSpace = false;
    g_navSleepWakeOnSpace = nav_bar_wake_allowed(now);
    if (!g_navGestureTracking && nav_bar_gestures_allowed(now)) {
      g_navGestureTracking = true;
      g_navGestureDownX = sx;
      g_navGestureDownY = sy;
      g_navGestureDownMs = now;
      g_navSpacebarNavSession = true;
      nav_bar_touch_activity(now);
    }
    drawKeyboard();
    ui_flush();
  }

  if (!pressed) {
    int endXn = (sx != 0 || sy != 0) ? (int)sx : (int)lastSx;
    int endYn = (sx != 0 || sy != 0) ? (int)sy : (int)lastSy;
    // Wake-only path (no gesture tracking) — rare; nav owner handles the normal case.
    if (nav_handle_wake_release(endXn, endYn, now)) {
      g_spaceTrackActive = false;
      g_spaceTrackMoved = false;
      g_spaceTrackReleaseMs = 0;
      g_spaceTrackOverlayShown = false;
      g_spaceTrackInsertedSpace = false;
      g_navSleepWakeOnSpace = false;
      g_navSpacebarNavSession = false;
      g_navGestureTracking = false;
      g_navGesturePeakMinY = 0xFFFF;
      g_navReleaseArmMs = 0;
      wasPressed = pressed;
      return;
    }
  }

  // Show semi-transparent overlay only after a real "hold/trackpad" gesture,
  // so quick space taps don't briefly flash the overlay.
  if (pressed && g_spaceTrackActive && !g_sdSavePathPickOpen && !g_spaceTrackMoved && !g_spaceTrackOverlayShown
      && (now - g_spaceTrackStartMs) >= SPACE_TRACK_OVERLAY_APPEAR_MS) {
    g_spaceTrackOverlayShown = true;
    drawKeyboard();
    ui_flush();
  }

  if (!pressed && g_spaceTrackActive && !g_sdSavePathPickOpen) {
    // Release debounce: require finger to stay released for 120ms before exiting.
    // Avoids twitching when touch controller reports spurious brief releases.
    if (g_spaceTrackReleaseMs == 0) {
      g_spaceTrackReleaseMs = now;
    }
    uint32_t heldMs = g_spaceTrackReleaseMs - g_spaceTrackStartMs;
    bool tapSpaceCandidate =
      (g_editMode != EditMode::NONE || tfaTypingScreen)
      && !g_spaceTrackMoved
      && !g_spaceTrackOverlayShown
      && !g_pwAdvancedPanelOpen
      && (heldMs < SPACE_TRACK_SPACE_INSERT_MAX_MS);

    uint32_t requiredReleaseMs = tapSpaceCandidate ? SPACE_TRACK_TAP_RELEASE_DEBOUNCE_MS : SPACE_TRACK_RELEASE_DEBOUNCE_MS;
    if ((now - g_spaceTrackReleaseMs) >= requiredReleaseMs) {
      bool didSleepWake = false;
      if (g_navSleepWakeOnSpace && nav_bar_wake_allowed(now)) {
        const int endX = (sx != 0 || sy != 0) ? (int)sx : (int)lastSx;
        const int endY = (sx != 0 || sy != 0) ? (int)sy : (int)lastSy;
        const int wdx = endX - (int)g_spaceTrackOriginX;
        const int wdy = endY - (int)g_spaceTrackOriginY;
        const uint32_t wakeHoldMs = (g_spaceTrackStartMs > 0) ? (now - g_spaceTrackStartMs) : 0;
        if (nav_bar_wake_swipe_qualifies(wdx, wdy, wakeHoldMs)) {
          nav_bar_wake(now);
          didSleepWake = true;
        }
      }
      g_navSleepWakeOnSpace = false;
      if (!didSleepWake && tapSpaceCandidate && !g_spaceTrackInsertedSpace) {
        flashKeyRectTranslucent(keyRectRow4[1]);
        if (nav_kb_try_insert_space(now))
          g_spaceTrackInsertedSpace = true;
      }
      g_spaceTrackActive = false;
      g_spaceTrackMoved = false;
      g_spaceTrackOverlayShown = false;
      g_spaceTrackReleaseMs = 0;
      g_spaceTrackInsertedSpace = false;
      if (g_editMode != EditMode::NONE || tfaTypingScreen) {
        // Overlay blends directly into framebuffer (including gaps between keys),
        // so fully clear the keyboard region before redrawing keys.
        int kbY0 = getKbY0();
        gfx->fillRect(0, kbY0, LCD_W, LCD_H - kbY0, UI_CARD);
        drawKeyboard();
        ui_flush();
      }
    }
  }

  if (pressed && g_spaceTrackActive)
    g_spaceTrackReleaseMs = 0;  // cancel pending release; finger still down

  if (pressed && g_spaceTrackActive && !g_sdSavePathPickOpen && (g_editMode != EditMode::NONE || tfaTypingScreen)) {
    int dx = (int)sx - (int)g_spaceTrackLastX;
    int dy = (int)sy - (int)g_spaceTrackLastY;
    // Avoid huge jumps if the controller skips frames / briefly deasserts pressed.
    if (dx > 80) dx = 80;
    if (dx < -80) dx = -80;
    if (dy > 80) dy = 80;
    if (dy < -80) dy = -80;
    g_spaceTrackLastX = (int16_t)sx;
    g_spaceTrackLastY = (int16_t)sy;
    // Do not move cursor while just holding spacebar.
    // Require a deliberate drag away from touch-down origin before enabling movement.
    if (!g_spaceTrackMoved) {
      int fromOrigin = abs((int)sx - (int)g_spaceTrackOriginX) + abs((int)sy - (int)g_spaceTrackOriginY);
      if (fromOrigin < SPACE_TRACK_ACTIVATE_DEADZONE_PX) {
        g_spaceTrackAccumX = 0;
        g_spaceTrackAccumY = 0;
        wasPressed = pressed;
        return;
      }
      g_spaceTrackMoved = true;
      g_spaceTrackOverlayShown = true;
      g_spaceTrackAccumX = 0;
      g_spaceTrackAccumY = 0;
      wasPressed = pressed;
      return;  // start accumulating from next frame to avoid jump on activation
    }

    g_spaceTrackAccumX += (int16_t)dx;
    g_spaceTrackAccumY += (int16_t)dy;

    // Smaller thresholds = smoother trackpad feel
    const int charW = 8;
    const int lineH = 12;
    int stepX = 0;
    int stepY = 0;
    while (g_spaceTrackAccumX >= charW) {
      g_spaceTrackAccumX -= charW;
      stepX++;
    }
    while (g_spaceTrackAccumX <= -charW) {
      g_spaceTrackAccumX += charW;
      stepX--;
    }
    while (g_spaceTrackAccumY >= lineH) {
      g_spaceTrackAccumY -= lineH;
      stepY++;
    }
    while (g_spaceTrackAccumY <= -lineH) {
      g_spaceTrackAccumY += lineH;
      stepY--;
    }

    if (stepX != 0 || stepY != 0) {
      g_spaceTrackMoved = true;
      g_spaceTrackOverlayShown = true;

      if (g_editingTitle) {
        // Title is 1-line: left/right only
        size_t len = strlen(g_editBuf);
        int cur = (int)g_editCursor + stepX;
        if (cur < 0) cur = 0;
        if (cur > (int)len) cur = (int)len;
        g_editCursor = (uint16_t)cur;
        draw();
      } else if (g_editMode == EditMode::ADD_NOTE_BODY || g_editMode == EditMode::EDIT_NOTE_BODY) {
        // Note body: 2D cursor move
        int curLine = 0, curCol = 0;
        noteCursorToLineCol((size_t)g_editCursor, &curLine, &curCol);
        curLine += stepY;
        curCol += stepX;
        if (curLine < 0) curLine = 0;
        if (curCol < 0) curCol = 0;
        size_t len = strlen(g_editBuf);
        int totalLines = 0;
        if (len > 0) {
          int tl, tc;
          noteCursorToLineCol(len, &tl, &tc);
          totalLines = tl + 1;
        }
        if (totalLines < 1) totalLines = 1;
        if (curLine >= totalLines) curLine = totalLines - 1;
        size_t idx = noteLineColToIndex((size_t)curLine, (size_t)curCol);
        if (idx > len) idx = len;
        g_editCursor = (uint16_t)idx;
        g_noteVisualCursorLine = curLine;
        g_noteVisualCursorCol = curCol;

        // Keep cursor line visible
        const int areaY = 48;
        const int visibleLines = (KB_Y0_DEFAULT - 2 - areaY) / lineH;
        int maxScroll = totalLines - visibleLines + NOTE_EXTRA_SCROLL_LINES;
        if (maxScroll < 0) maxScroll = 0;
        if (curLine < (int)g_noteScrollLine) g_noteScrollLine = (uint16_t)curLine;
        else if (curLine >= (int)g_noteScrollLine + visibleLines) {
          int ns = curLine - visibleLines + 1;
          if (ns < 0) ns = 0;
          if (ns > maxScroll) ns = maxScroll;
          g_noteScrollLine = (uint16_t)ns;
        }
        draw();
      } else if (tfaTypingScreen) {
        char* curBuf = (g_tfaAddFocus == 0) ? g_tfaAddLabel : (g_tfaAddFocus == 1) ? g_tfaAddAccount
                                                                                   : g_tfaAddSecret;
        uint16_t& curPos = (g_tfaAddFocus == 0) ? g_tfaAddCursorLabel : (g_tfaAddFocus == 1) ? g_tfaAddCursorAccount
                                                                                             : g_tfaAddCursorSecret;
        size_t len = strlen(curBuf);
        int cur = (int)curPos + stepX;
        if (cur < 0) cur = 0;
        if (cur > (int)len) cur = (int)len;
        curPos = (uint16_t)cur;
        draw();
      } else {
        // Password value (and any other 1-line editor field): left/right only
        size_t len = strlen(g_editBuf);
        int cur = (int)g_editCursor + stepX;
        if (cur < 0) cur = 0;
        if (cur > (int)len) cur = (int)len;
        g_editCursor = (uint16_t)cur;
        draw();
      }
    }

    // While trackpad is active, suppress normal touch dispatch.
    wasPressed = pressed;
    return;
  }

  // Finger scrolling on SD file list: drag in list area to scroll (vault/restore + multisig policy import)
  if (onSdFileScreen) {
    const int sdListCount =
      (g_screen == UIScreen::CRYPTO_MULTISIG_SD_BROWSE || g_screen == UIScreen::CRYPTO_TX_SD_BROWSE)
        ? g_msSdCount
        : g_sdFileCount;
    const int sdRowH =
      (g_screen == UIScreen::CRYPTO_MULTISIG_SD_BROWSE
       || g_screen == UIScreen::CRYPTO_TX_SD_BROWSE
       || g_screen == UIScreen::SD_BROWSER
       || g_screen == UIScreen::RESTORE_SD)
        ? MULTISIG_SD_LIST_ROW_H
        : SD_LIST_ROW_H;
    if (sdListCount > SD_FILES_PER_PAGE) {
      int listBottom = SD_LIST_TOP + SD_FILES_PER_PAGE * sdRowH;
      bool inListArea = (sx >= SD_LIST_LEFT && sx <= SD_LIST_RIGHT && sy >= SD_LIST_TOP && sy <= listBottom);
      if (!pressed) {
        sdScrollLastY = -1;
      } else if (inListArea) {
        if (sdScrollLastY < 0) {
          sdScrollLastY = (int)sy;
        } else {
          int delta = (int)sy - sdScrollLastY;
          sdScrollLastY = (int)sy;
          if (abs(delta) < 2) {
            // Sub-2px jitter: skip scroll accumulation (avoids list full-redraw spam).
          } else {
            sdScrollAccum -= (float)delta;  // drag up = scroll down, drag down = scroll up (natural list)
            int maxOffset = max(0, sdListCount - SD_FILES_PER_PAGE);
            while (sdScrollAccum >= sdRowH) {
              if (g_screen == UIScreen::CRYPTO_MULTISIG_SD_BROWSE) {
                if (g_msSdScrollOffset < maxOffset) {
                  g_msSdScrollOffset++;
                  drawCryptoMultisigSdBrowse();
                }
              } else if (g_screen == UIScreen::CRYPTO_TX_SD_BROWSE) {
                if (g_msSdScrollOffset < maxOffset) {
                  g_msSdScrollOffset++;
                  drawCryptoTxSdBrowse();
                }
              } else if (g_sdScrollOffset < maxOffset) {
                g_sdScrollOffset++;
                if (g_screen == UIScreen::SD_BROWSER) drawSdBrowser();
                else drawRestoreSd();
              }
              sdScrollAccum -= (float)sdRowH;
            }
            while (sdScrollAccum <= -sdRowH) {
              if (g_screen == UIScreen::CRYPTO_MULTISIG_SD_BROWSE) {
                if (g_msSdScrollOffset > 0) {
                  g_msSdScrollOffset--;
                  drawCryptoMultisigSdBrowse();
                }
              } else if (g_screen == UIScreen::CRYPTO_TX_SD_BROWSE) {
                if (g_msSdScrollOffset > 0) {
                  g_msSdScrollOffset--;
                  drawCryptoTxSdBrowse();
                }
              } else if (g_sdScrollOffset > 0) {
                g_sdScrollOffset--;
                if (g_screen == UIScreen::SD_BROWSER) drawSdBrowser();
                else drawRestoreSd();
              }
              sdScrollAccum += (float)sdRowH;
            }
          }
        }
      } else {
        sdScrollLastY = -1;
      }
    } else if (!pressed) {
      sdScrollLastY = -1;
    }
  } else if (!pressed) {
    sdScrollLastY = -1;
  }

  // Backup code screen: vertical drag in code viewport (long SPF1 line)
  if (g_editMode == EditMode::NONE
      && (g_screen == UIScreen::CREATE_SHOW_CODE || g_screen == UIScreen::BACKUP_SHOW_CODE)) {
    const char* disp = (g_pwScreenSpf1BackupCode && g_pwScreenSpf1BackupCode[0]) ? g_pwScreenSpf1BackupCode : g_backupCode;
    const bool spf1 = disp && disp[0] && strncmp(disp, "SPF1-", 5) == 0;
    const int16_t vpTop = (int16_t)((spf1 ? 84 : 78) + 25);
    const int16_t vpBottom = 406;
    bool inVp = (sx >= 8 && sx < LCD_W - 8 && (int16_t)sy >= vpTop && (int16_t)sy < vpBottom);
    if (pressed && g_showCodeVpTapPending) {
      int ddx = abs((int)sx - (int)g_showCodeVpTapDownX);
      int ddy = abs((int)sy - (int)g_showCodeVpTapDownY);
      if (ddx > LIST_DRAG_THRESHOLD || ddy > LIST_DRAG_THRESHOLD) g_showCodeVpTapDidDrag = true;
    }
    if (!pressed) {
      g_showCodeDragLastY = -1;
    } else if (inVp && g_showCodeMaxScrollPx > 0) {
      if (g_showCodeDragLastY < 0) {
        g_showCodeDragLastY = (int16_t)sy;
      } else {
        int delta = (int)sy - (int)g_showCodeDragLastY;
        g_showCodeDragLastY = (int16_t)sy;
        if (delta != 0) g_showCodeVpTapDidDrag = true;
        // Match finger motion: drag down → content moves down (invert document scroll)
        g_showCodeScrollPx = (int16_t)(g_showCodeScrollPx - delta);
        if (g_showCodeScrollPx < 0) g_showCodeScrollPx = 0;
        if (g_showCodeScrollPx > g_showCodeMaxScrollPx) g_showCodeScrollPx = g_showCodeMaxScrollPx;
        draw();
      }
    } else if (!inVp) {
      g_showCodeDragLastY = -1;
    }
  } else if (!pressed) {
    g_showCodeDragLastY = -1;
  }

  // Fullscreen backup text (SHOW_CODE_FULLSCREEN): vertical drag; same vp as drawShowCodeFullscreen
  if (g_editMode == EditMode::NONE && g_screen == UIScreen::SHOW_CODE_FULLSCREEN) {
    const char* dispFs = (g_pwScreenSpf1BackupCode && g_pwScreenSpf1BackupCode[0]) ? g_pwScreenSpf1BackupCode : g_backupCode;
    const bool spf1Fs = dispFs && dispFs[0] && strncmp(dispFs, "SPF1-", 5) == 0;
    const int16_t vpTopFs = spf1Fs ? 76 : 52;
    const int16_t vpBottomFs = (int16_t)(LCD_H - 22);
    bool inVpFs = (sx >= 8 && sx < LCD_W - 8 && (int16_t)sy >= vpTopFs && (int16_t)sy < vpBottomFs);
    if (pressed && g_showCodeFullscreenDismissPending) {
      int ddx = abs((int)sx - (int)g_showCodeFullscreenDismissDownX);
      int ddy = abs((int)sy - (int)g_showCodeFullscreenDismissDownY);
      if (ddx > LIST_DRAG_THRESHOLD || ddy > LIST_DRAG_THRESHOLD) g_showCodeFullscreenDismissDidDrag = true;
    }
    if (!pressed) {
      g_showCodeFullscreenDragLastY = -1;
    } else if (inVpFs && g_showCodeFullscreenMaxScrollPx > 0) {
      if (g_showCodeFullscreenDragLastY < 0) {
        g_showCodeFullscreenDragLastY = (int16_t)sy;
      } else {
        int deltaFs = (int)sy - (int)g_showCodeFullscreenDragLastY;
        g_showCodeFullscreenDragLastY = (int16_t)sy;
        if (deltaFs != 0) g_showCodeFullscreenDismissDidDrag = true;
        g_showCodeFullscreenScrollPx = (int16_t)(g_showCodeFullscreenScrollPx - deltaFs);
        if (g_showCodeFullscreenScrollPx < 0) g_showCodeFullscreenScrollPx = 0;
        if (g_showCodeFullscreenScrollPx > g_showCodeFullscreenMaxScrollPx) {
          g_showCodeFullscreenScrollPx = g_showCodeFullscreenMaxScrollPx;
        }
        draw();
      }
    } else if (!inVpFs) {
      g_showCodeFullscreenDragLastY = -1;
    }
  } else if (!pressed) {
    g_showCodeFullscreenDragLastY = -1;
  }

  // Device settings: vertical scroll (taller than viewport when HID row is shown)
  if (g_editMode == EditMode::NONE && g_screen == UIScreen::DEVICE_SETTINGS) {
    const int DS_TOP = DEVICE_SETTINGS_VIEW_TOP, DS_BOT = DEVICE_SETTINGS_VIEW_BOTTOM;
    bool inDs = (sx >= 8 && sx < LCD_W - 8 && (int)sy >= DS_TOP && (int)sy <= DS_BOT);
    if (pressed && g_deviceSettingsListTouchPending) {
      int ddx = abs((int)sx - (int)g_deviceSettingsListDownX);
      int ddy = abs((int)sy - (int)g_deviceSettingsListDownY);
      if (ddx > LIST_DRAG_THRESHOLD || ddy > LIST_DRAG_THRESHOLD) g_deviceSettingsListDidDrag = true;
    }
    if (!pressed) {
      g_deviceSettingsScrollDragLastY = -1;
    } else if (inDs && deviceSettingsMaxScrollPx() > 0) {
      if (g_deviceSettingsScrollDragLastY < 0) {
        g_deviceSettingsScrollDragLastY = (int16_t)sy;
      } else {
        int delta = (int)sy - (int)g_deviceSettingsScrollDragLastY;
        g_deviceSettingsScrollDragLastY = (int16_t)sy;
        if (delta != 0) g_deviceSettingsListDidDrag = true;
        int ms = deviceSettingsMaxScrollPx();
        int next = (int)g_deviceSettingsScrollPx - delta;
        if (next < 0) next = 0;
        if (next > ms) next = ms;
        g_deviceSettingsScrollPx = (uint16_t)next;
        draw();
      }
    } else if (!inDs) {
      g_deviceSettingsScrollDragLastY = -1;
    }
  } else if (!pressed) {
    g_deviceSettingsScrollDragLastY = -1;
  }

  // Old Games hub: vertical scroll for full-size game tiles
  if (g_editMode == EditMode::NONE && g_screen == UIScreen::DURESS_GAMES) {
    const int DG_TOP = (int)DURESS_GAMES_LIST_TOP, DG_BOT = (int)DURESS_GAMES_LIST_BOTTOM;
    bool inDg = (sx >= 8 && sx < LCD_W - 8 && (int)sy >= DG_TOP && (int)sy <= DG_BOT);
    if (pressed && g_duressGamesListTouchPending) {
      int ddx = abs((int)sx - (int)g_duressGamesListDownX);
      int ddy = abs((int)sy - (int)g_duressGamesListDownY);
      if (ddx > LIST_DRAG_THRESHOLD || ddy > LIST_DRAG_THRESHOLD) g_duressGamesListDidDrag = true;
    }
    if (!pressed) {
      g_duressGamesScrollDragLastY = -1;
    } else if (inDg && duressGamesMaxScrollPx() > 0) {
      if (g_duressGamesScrollDragLastY < 0) {
        g_duressGamesScrollDragLastY = (int16_t)sy;
      } else {
        int delta = (int)sy - (int)g_duressGamesScrollDragLastY;
        g_duressGamesScrollDragLastY = (int16_t)sy;
        if (delta != 0) g_duressGamesListDidDrag = true;
        int ms = duressGamesMaxScrollPx();
        int next = (int)g_duressGamesScrollPx - delta;
        if (next < 0) next = 0;
        if (next > ms) next = ms;
        if (next != (int)g_duressGamesScrollPx) {
          g_duressGamesScrollPx = (uint16_t)next;
          draw();
        }
      }
    } else if (!inDg) {
      g_duressGamesScrollDragLastY = -1;
    }
  } else if (!pressed) {
    g_duressGamesScrollDragLastY = -1;
  }

  // Finger-scroll on Passwords / Notes / 2FA list (smartphone-style drag) — whole screen below top bar, above bottom buttons
  bool onListScreen = (g_screen == UIScreen::PASSWORDS || g_screen == UIScreen::NOTES);
  const int LIST_SCROLL_TOP = 56;      // below EDIT/Show row
  const int LIST_SCROLL_BOTTOM = 419;  // above BACK/ADD row
  bool inListArea = onListScreen && (sy >= (uint16_t)LIST_SCROLL_TOP && sy <= (uint16_t)LIST_SCROLL_BOTTOM);
  bool inTfaListArea = (g_screen == UIScreen::TFA_LIST) && (sy >= (uint16_t)LIST_SCROLL_TOP && sy <= (uint16_t)LIST_SCROLL_BOTTOM);
  uint8_t listCount = (g_screen == UIScreen::PASSWORDS) ? pwSvc_getCount() : g_noteCount;
  int maxListScroll = (int)listCount - LIST_MAX_VISIBLE;
  int maxTfaScroll = (int)g_totpCount - TFA_LIST_VISIBLE_ROWS;
  if (maxTfaScroll < 0) maxTfaScroll = 0;
  const int noteItemsPerPage = NOTE_GRID_VISIBLE_ROWS * NOTE_GRID_COLS;  // 6
  // Passwords: either grid (2-column) or detailed list. Notes use 2-column grid.
  if (g_screen == UIScreen::PASSWORDS) {
    if (g_pwListDetailedView) {
      maxListScroll = (int)pwSvc_getCount() - PW_DETAIL_VISIBLE_ROWS;
    } else {
      maxListScroll = gridMaxStartIndex((int)pwSvc_getCount(), PW_GRID_COLS, PW_GRID_VISIBLE_ROWS);
      g_pwListScroll = gridAlignStart(g_pwListScroll, PW_GRID_COLS);
    }
  } else if (g_screen == UIScreen::NOTES) {
    maxListScroll = gridMaxStartIndex((int)g_noteCount, NOTE_GRID_COLS, NOTE_GRID_VISIBLE_ROWS);
    g_noteListScroll = gridAlignStart(g_noteListScroll, NOTE_GRID_COLS);
  }
  if (maxListScroll < 0) maxListScroll = 0;

  // If a swipe-back gesture is reserved, do not allow list scroll/long-press/taps at the same time.
  if (pressed && wasPressed && g_swipeReserved) {
    wasPressed = pressed;
    return;
  }

  // Spacebar + nav asleep: wake on upward swipe before release (tap = space via space-track only).
  if (pressed && g_spaceTrackActive && g_navSleepWakeOnSpace && nav_bar_wake_allowed(now)) {
    const int wdx = (int)sx - (int)g_spaceTrackOriginX;
    const int wdy = (int)sy - (int)g_spaceTrackOriginY;
    const uint32_t wakeHoldMs = (g_spaceTrackStartMs > 0) ? (now - g_spaceTrackStartMs) : 0;
    if (nav_bar_wake_swipe_qualifies(wdx, wdy, wakeHoldMs)) {
      nav_bar_wake(now);
      g_navSleepWakeOnSpace = false;
      g_spaceTrackActive = false;
      g_spaceTrackMoved = false;
      g_spaceTrackOverlayShown = false;
      g_spaceTrackReleaseMs = 0;
      g_spaceTrackInsertedSpace = false;
      if (g_editMode != EditMode::NONE || tfaTypingScreen) {
        int kbY0 = getKbY0();
        gfx->fillRect(0, kbY0, LCD_W, LCD_H - kbY0, UI_CARD);
        drawKeyboard();
        ui_flush();
      }
      wasPressed = pressed;
      return;
    }
  }

  // Nav bar: wake on upward swipe before release (home pill, keyboard asleep).
  // (Also handled inside the nav gesture owner when tracking is armed.)
  if (pressed && g_navWakeTracking && g_navWakeArmed && nav_bar_keyboard_active()
      && !nav_bar_awake_now(now) && g_navOverlay == NavOverlay::NONE
      && !g_navGestureTracking) {
    const int wakeDx = (int)sx - (int)g_navWakeDownX;
    const int wakeDy = (int)sy - (int)g_navWakeDownY;
    const uint32_t wakeHoldMs = (g_navWakeDownMs > 0) ? (now - g_navWakeDownMs) : 0;
    if (nav_bar_wake_swipe_qualifies(wakeDx, wakeDy, wakeHoldMs)) {
      nav_bar_wake(now);
      g_navWakeTracking = false;
      g_navWakeArmed = false;
      g_navWakeDownMs = 0;
      wasPressed = pressed;
      return;
    }
  }

  if (!pressed) {
    g_swipeReserved = false;
    bool swipeBackPerformed = false;
    if (g_showCodeVpTapPending
        && (g_screen == UIScreen::CREATE_SHOW_CODE || g_screen == UIScreen::BACKUP_SHOW_CODE)) {
      int endX = (sx != 0 || sy != 0) ? (int)sx : (int)lastSx;
      int endY = (sx != 0 || sy != 0) ? (int)sy : (int)lastSy;
      const char* dispRel = (g_pwScreenSpf1BackupCode && g_pwScreenSpf1BackupCode[0]) ? g_pwScreenSpf1BackupCode : g_backupCode;
      const bool spf1Rel = dispRel && dispRel[0] && strncmp(dispRel, "SPF1-", 5) == 0;
      const int16_t vpTopRel = (int16_t)((spf1Rel ? 84 : 78) + 25);
      const int16_t vpBottomRel = 406;
      bool endInVp = (endX >= 8 && endX < LCD_W - 8 && (int16_t)endY >= vpTopRel && (int16_t)endY < vpBottomRel);
      int slopDx = abs(endX - (int)g_showCodeVpTapDownX);
      int slopDy = abs(endY - (int)g_showCodeVpTapDownY);
      uint32_t holdMs = (uint32_t)((int32_t)now - (int32_t)g_showCodeVpTapDownMs);
      if (!g_showCodeVpTapDidDrag && endInVp && slopDx < 22 && slopDy < 22 && holdMs < 450) {
        g_showCodeFullscreenReturnScreen = g_screen;
        show(UIScreen::SHOW_CODE_FULLSCREEN);
      }
      g_showCodeVpTapPending = false;
    }
    if (g_listTouchPending && !g_listDidDrag && !g_listLongPressTriggered && g_screen == UIScreen::TFA_LIST) {
      uint32_t holdMs = (uint32_t)((int32_t)now - (int32_t)g_listTouchDownMs);
      if (holdMs < LIST_TAP_MAX_MS)
        handleTfaListTap(g_listTouchDownX, g_listTouchDownY);
    }
    if (g_deviceSettingsListTouchPending && !g_deviceSettingsListDidDrag && g_screen == UIScreen::DEVICE_SETTINGS) {
      uint32_t holdMs = (uint32_t)((int32_t)now - (int32_t)g_deviceSettingsListDownMs);
      if (holdMs < LIST_TAP_MAX_MS) {
        uint16_t ly = (uint16_t)((int)g_deviceSettingsListDownY + (int)g_deviceSettingsScrollPx);
        handleDeviceSettingsTap(g_deviceSettingsListDownX, ly);
      }
    }
    g_deviceSettingsListTouchPending = false;
    if (g_duressGamesListTouchPending && !g_duressGamesListDidDrag && g_screen == UIScreen::DURESS_GAMES) {
      uint32_t holdMsDg = (uint32_t)((int32_t)now - (int32_t)g_duressGamesListDownMs);
      if (holdMsDg < LIST_TAP_MAX_MS) {
        handleDuressGamesTap(g_duressGamesListDownX, g_duressGamesListDownY);
      }
    }
    g_duressGamesListTouchPending = false;
    bool carouselSwipeHandled = false;
    // Horizontal swipe: carousel (run before edge swipe-back so left-edge works too).
    if (wasPressed && (g_screen == UIScreen::CRYPTO_HOME || g_screen == UIScreen::CRYPTO_SETTINGS)
        && g_editMode == EditMode::NONE) {
      uint8_t nCar = crypto_carousel_count();
      if (nCar >= 2) {
        int sxDown = (int)g_swipeDownX;
        int syDown = (int)g_swipeDownY;
        if (syDown >= CRYPTO_CAROUSEL_SWIPE_Y_MIN) {
          int endAm = (sx != 0 || sy != 0) ? (int)sx : (int)lastSx;
          int endBm = (sx != 0 || sy != 0) ? (int)sy : (int)lastSy;
          int dxm = endAm - sxDown;
          int dym = endBm - syDown;
          // Mostly horizontal: |dx| >= 1.25 * |dy| (reduces accidental vertical scroll)
          if (abs(dxm) >= CRYPTO_CAROUSEL_SWIPE_MIN && (abs(dxm) * 4) >= (abs(dym) * 5)) {
            uint8_t s = crypto_carousel_slot();
            if (dxm < 0) {
              s = (uint8_t)((s + 1) % nCar);
            } else {
              s = (uint8_t)((s + nCar - 1) % nCar);
            }
            crypto_carousel_go_to(s);
            g_touchIgnoreUntil = millis() + 90;
            g_listTouchPending = false;
            g_listDidDrag = true;
            carouselSwipeHandled = true;
          }
        }
      }
    }
    // Focus-mode swipe-right: collapse to details when swipe starts outside the focused strip (not horizontal scroll in field).
    if (!carouselSwipeHandled && wasPressed && g_screen == UIScreen::EDITOR && g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && g_pwEditFocusField >= 1 && g_pwEditFocusField <= 5) {
      int endX = (sx != 0 || sy != 0) ? (int)sx : (int)lastSx;
      int endY = (sx != 0 || sy != 0) ? (int)sy : (int)lastSy;
      int dx = endX - (int)g_swipeDownX;
      int dy = endY - (int)g_swipeDownY;
      if (dx >= SWIPE_BACK_MIN && dx > abs(dy) && !pwEditorFocusSwipeDownInsideStrip((int16_t)g_swipeDownX, (int16_t)g_swipeDownY) && !pwEditorFocusSwipeStartedOnKeyboardArea((int16_t)g_swipeDownX, (int16_t)g_swipeDownY)) {
        pwEditCollapseFocusedFieldToBrowse();
        g_pwCollapseFromSwipe = true;
        g_touchIgnoreUntil = millis() + 280;
        g_lastTapMs = millis();
        g_touchReleasedSinceTap = false;
        draw();
        g_listTouchPending = false;
        g_listDidDrag = true;
        return;
      }
    }

    // Swipe-back: rightward swipe (release to the right of touch-down) = go to previous screen
    // Bitcoin menu: same gesture (start near left edge, swipe right) -> Crypto settings (not MENU).
    // Use last known touch position for end point: driver often returns (0,0) on release
    // In editor: only trigger if touch started above keyboard (so typing doesn't trigger back)
    const bool pwStaticDetailsSwipe = (g_screen == UIScreen::EDITOR
                                       && g_editMode == EditMode::EDIT_PW_VALUE
                                       && !g_pwEditKeyboardVisible);
    if (!carouselSwipeHandled && wasPressed && !g_pwCollapseFromSwipe
        && (g_swipeDownX <= SWIPE_EDGE_MAX || pwStaticDetailsSwipe)
        && !createConfirmTouchInWordRect(g_swipeDownX, g_swipeDownY)) {
      int endX = (sx != 0 || sy != 0) ? (int)sx : (int)lastSx;
      int endY = (sx != 0 || sy != 0) ? (int)sy : (int)lastSy;
      int dx = endX - (int)g_swipeDownX;
      int dy = endY - (int)g_swipeDownY;
      bool startedOnKeyboard = (!pwStaticDetailsSwipe
                                && g_editMode != EditMode::NONE
                                && (int)g_swipeDownY >= getKbY0());
      // Brightness bar: left edge overlaps SWIPE_EDGE_MAX; dragging right must not trigger swipe-back.
      const bool startedOnBrightnessBar =
        (g_screen == UIScreen::DEVICE_BRIGHTNESS
         && (int)g_swipeDownX >= BR_BRIGHTNESS_BAR_X && (int)g_swipeDownX < BR_BRIGHTNESS_BAR_X + BR_BRIGHTNESS_BAR_W
         && (int)g_swipeDownY >= BR_BRIGHTNESS_BAR_Y && (int)g_swipeDownY < BR_BRIGHTNESS_BAR_Y + BR_BRIGHTNESS_BAR_H);
      const bool brightnessBarDragRelease =
        (g_screen == UIScreen::DEVICE_BRIGHTNESS && g_brightnessBarDragging);
      const bool startedOnPsbtSlideRail =
        (g_screen == UIScreen::CRYPTO_PSBT_FEE || g_screen == UIScreen::CRYPTO_KASPA_FEE) && g_psbtSignConfirmActive
        && psbt_slide_touch_down_on_expanded_rail((int16_t)g_swipeDownX, (int16_t)g_swipeDownY);
      // Scan PSBT: camera is full-screen; slightly easier threshold so edge-swipe back registers reliably.
      int minDxSwipe = (g_screen == UIScreen::CRYPTO_SCAN_PSBT || g_screen == UIScreen::CRYPTO_SCAN_KASPA_PSKT
                        || g_screen == UIScreen::CRYPTO_SCAN_TOOLS)
                         ? 48
                       : (g_cryptoTempSeedBackupRestoreFlow
                          && (g_screen == UIScreen::RESTORE_CODE || g_screen == UIScreen::RESTORE_PASSWORD))
                         ? 48
                         : SWIPE_BACK_MIN;
      bool swipeDirOk = pwStaticDetailsSwipe ? (dx >= minDxSwipe && (dx * 2) > abs(dy))
                                             : (dx >= minDxSwipe && dx > abs(dy));
      if (swipeDirOk && !startedOnKeyboard && !startedOnBrightnessBar && !brightnessBarDragRelease
          && !startedOnPsbtSlideRail && !g_psbtSlideDragging && !g_psbtSlideAwaitSwipe
          && !g_psbtSlideCommitBlocksSwipeBack
          && (uint32_t)now >= g_psbtSlideSuppressSwipeBackUntil) {
        // Password editor active field: swipe-right should collapse to details view, not leave to list.
        if (g_screen == UIScreen::EDITOR && g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && g_pwEditFocusField >= 1 && g_pwEditFocusField <= 5 && !pwEditorFocusSwipeDownInsideStrip((int16_t)g_swipeDownX, (int16_t)g_swipeDownY)) {
          pwEditCollapseFocusedFieldToBrowse();
          g_pwCollapseFromSwipe = true;
          g_touchIgnoreUntil = millis() + 280;
          g_lastTapMs = millis();
          g_touchReleasedSinceTap = false;
          draw();
          g_listTouchPending = false;
          g_listDidDrag = true;
          return;
        }
        // CRYPTO_HOME: do not swipe-back to MENU from left edge — carousel (middle swipe) changes screens.
        if (canSwipeBack() && !(g_screen == UIScreen::CRYPTO_HOME && g_editMode == EditMode::NONE)) {
          performSwipeBack();
          g_listTouchPending = false;
          g_listDidDrag = true;  // treat as drag so no row tap fires
          swipeBackPerformed = true;
        }
      }
    }
    // Seed entry: right-edge swipe-left advances to the next word (commits current when valid).
    if (!swipeBackPerformed && wasPressed && g_screen == UIScreen::BACKUP_FROM_SEED
        && g_swipeDownX >= (uint16_t)SWIPE_EDGE_RIGHT_MIN
        && (int)g_swipeDownY < getKbY0()) {
      int endX = (sx != 0 || sy != 0) ? (int)sx : (int)lastSx;
      int endY = (sx != 0 || sy != 0) ? (int)sy : (int)lastSy;
      int dx = endX - (int)g_swipeDownX;
      int dy = endY - (int)g_swipeDownY;
      if (dx <= -SWIPE_BACK_MIN && (-dx) > abs(dy)) {
        if (seedEntryNextWord()) {
          if (g_seedCount == g_wc) {
            setMsg("All words entered.");
            show(UIScreen::BACKUP_REVIEW_WORDS);
          } else {
            draw();
          }
          g_touchIgnoreUntil = millis() + 220;
          g_listTouchPending = false;
          g_listDidDrag = true;
          swipeBackPerformed = true;
        } else {
          draw();  // show commit error (empty / not BIP39)
          g_listDidDrag = true;
          swipeBackPerformed = true;
        }
      }
    }
    // Fullscreen backup: tap release (not scroll / not swipe-back) → normal backup view
    if (g_showCodeFullscreenDismissPending) {
      if (!swipeBackPerformed && g_screen == UIScreen::SHOW_CODE_FULLSCREEN) {
        int endX = (sx != 0 || sy != 0) ? (int)sx : (int)lastSx;
        int endY = (sx != 0 || sy != 0) ? (int)sy : (int)lastSy;
        int slopDx = abs(endX - (int)g_showCodeFullscreenDismissDownX);
        int slopDy = abs(endY - (int)g_showCodeFullscreenDismissDownY);
        uint32_t holdMs = (uint32_t)((int32_t)now - (int32_t)g_showCodeFullscreenDismissDownMs);
        if (!g_showCodeFullscreenDismissDidDrag && slopDx < 22 && slopDy < 22 && holdMs < 500) {
          show(g_showCodeFullscreenReturnScreen);
        }
      }
      g_showCodeFullscreenDismissPending = false;
    }
    // Multisig: edge swipe reserved; deliver tap on release if gesture was a short press (not a back-swipe).
    if (g_multisigEdgeDeferTap && wasPressed && !swipeBackPerformed) {
      int endX = (sx != 0 || sy != 0) ? (int)sx : (int)lastSx;
      int endY = (sx != 0 || sy != 0) ? (int)sy : (int)lastSy;
      int rdx = endX - (int)g_swipeDownX;
      int rdy = endY - (int)g_swipeDownY;
      const int EDGE_TAP_SLOP = 22;
      if (abs(rdx) < EDGE_TAP_SLOP && abs(rdy) < EDGE_TAP_SLOP) {
        switch (g_screen) {
          case UIScreen::CRYPTO_MULTISIG_SETTINGS:
            handleCryptoMultisigSettingsTap(g_multisigEdgeDeferX, g_multisigEdgeDeferY);
            break;
          case UIScreen::CRYPTO_MULTISIG_IMPORT:
            handleCryptoMultisigImportTap(g_multisigEdgeDeferX, g_multisigEdgeDeferY);
            break;
          case UIScreen::CRYPTO_MULTISIG_WALLET:
            handleCryptoMultisigWalletTap(g_multisigEdgeDeferX, g_multisigEdgeDeferY);
            break;
          case UIScreen::CRYPTO_MULTISIG_RECEIVE_WALLET:
            handleCryptoMultisigReceiveWalletTap(g_multisigEdgeDeferX, g_multisigEdgeDeferY);
            break;
          case UIScreen::CRYPTO_MULTISIG_RECEIVE_TYPE:
            handleCryptoMultisigReceiveTypeTap(g_multisigEdgeDeferX, g_multisigEdgeDeferY);
            break;
          case UIScreen::CRYPTO_TOOLS_VERIFY_MULTISIG:
            handleCryptoToolsVerifyMultisigTap(g_multisigEdgeDeferX, g_multisigEdgeDeferY);
            break;
          default:
            break;
        }
      }
    }
    g_multisigEdgeDeferTap = false;
    // Swipe-left quick switch between Secrets (MENU) and Crypto removed.
    // Toggle switch is now the only way to switch between MENU and CRYPTO.
    g_listScrollLastY = -1;
    g_listScrollAccum = 0;
    if (g_listTouchPending && !g_listDidDrag && !g_listLongPressTriggered && (g_screen == UIScreen::PASSWORDS || g_screen == UIScreen::NOTES)) {
      uint32_t holdMs = (uint32_t)((int32_t)now - (int32_t)g_listTouchDownMs);
      if (holdMs < LIST_TAP_MAX_MS)
        handlePwNotesTap(g_listTouchDownX, g_listTouchDownY);
    }
    g_listTouchPending = false;
    g_listDidDrag = false;
    g_listLongPressTriggered = false;
    g_pwListLongPressRow = 0xFF;
    g_noteListLongPressRow = 0xFF;
    if (g_listFlashActive) {
      g_listFlashActive = false;
      if (g_screen == UIScreen::PASSWORDS || g_screen == UIScreen::NOTES || g_screen == UIScreen::TFA_LIST)
        draw();
    }
    g_pwCollapseFromSwipe = false;
  } else if (onListScreen && inListArea && g_screen == UIScreen::PASSWORDS && !g_pwListEditMode && g_pwListLongPressRow != 0xFF && !g_listDidDrag && !g_showSendPopup) {
    if ((uint32_t)(now - g_pwListLongPressStartMs) >= 350) {
      uint8_t currentIdx = 0xFF;
      pwIndexFromTap((int16_t)sx, (int16_t)sy, currentIdx);
      if (currentIdx == g_pwListLongPressRow && currentIdx < pwSvc_getCount()) {
        if (!g_pwListDetailedView && g_pwLongPressWasOnTitle) {
          g_showPwTitlePopup = true;
          g_pwTitlePopupIndex = g_pwListLongPressRow;
          g_listLongPressTriggered = true;
          g_pwListLongPressRow = 0xFF;
          g_listFlashActive = false;
          draw();
          return;
        }
        if (pwSvc_getValueCStr(currentIdx)[0]) {
#if SEEDMASK_NOTE_SEND_UI
          if (pwSendDisabled()) {
            setMsgTr("Sending is disabled", "Slanje je iskljuceno");
            g_listLongPressTriggered = true;
            g_pwListLongPressRow = 0xFF;
            g_listFlashActive = false;
            draw();
            return;
          }
#endif
          g_showSendPopup = true;
          g_sendPopupPwIndex = currentIdx;
          g_sendPopupShownAtMs = now;
          g_listLongPressTriggered = true;
          g_pwListLongPressRow = 0xFF;
          g_listFlashActive = false;
          draw();
        }
      }
    }
  } else if (onListScreen && inListArea && g_screen == UIScreen::NOTES && !g_noteListEditMode && g_noteListLongPressRow != 0xFF && !g_listDidDrag && !g_showNoteSendPopup) {
    if ((uint32_t)(now - g_pwListLongPressStartMs) >= 350) {
      uint8_t currentRow = 0xFF;
      if (g_screen == UIScreen::NOTES) {
        int localY = (int)sy - NOTE_GRID_TOP;
        int row = localY / NOTE_GRID_ROW_STRIDE;
        if (row >= 0 && row < NOTE_GRID_VISIBLE_ROWS) {
          // pick column based on x position (left vs right tile)
          Rect t0, c0;
          noteTileRectsForSlot(row * NOTE_GRID_COLS + 0, t0, c0);
          int col = ((int)sx >= (t0.x + t0.w + NOTE_TILE_GAP / 2)) ? 1 : 0;
          int slot = row * NOTE_GRID_COLS + col;
          int idx = (int)g_noteListScroll + slot;
          if (idx >= 0 && idx < (int)g_noteCount) currentRow = (uint8_t)idx;
        }
      }
      if (currentRow == g_noteListLongPressRow && currentRow < g_noteCount) {
        // Long-press on title caption -> show full title popup
        if (g_noteLongPressWasOnTitle) {
          g_showNoteTitlePopup = true;
          g_noteTitlePopupIndex = currentRow;
          g_listLongPressTriggered = true;
          g_noteListLongPressRow = 0xFF;
          g_listFlashActive = false;
          draw();
          return;
        }
        // Otherwise, long-press on tile -> Send (if note has content)
        if (!g_noteItems || !g_noteItems[currentRow].body[0]) return;
#if SEEDMASK_NOTE_SEND_UI
        if (pwSendDisabled()) {
          setMsgTr("Sending is disabled", "Slanje je iskljuceno");
          g_listLongPressTriggered = true;
          g_noteListLongPressRow = 0xFF;
          g_listFlashActive = false;
          draw();
          return;
        }
        g_showNoteSendPopup = true;
        g_noteSendPopupIndex = g_noteListLongPressRow;
        g_noteSendPopupShownAtMs = now;
#endif
        g_listLongPressTriggered = true;
        g_noteListLongPressRow = 0xFF;
        g_listFlashActive = false;
        draw();
      }
    }
  }
  bool listEditMode = (g_screen == UIScreen::PASSWORDS && g_pwListEditMode) || (g_screen == UIScreen::NOTES && g_noteListEditMode);
  if (listEditMode) {
    // EDIT selection mode: never scroll/drag/long-press; keep selection taps stable.
    g_listScrollLastY = -1;
    g_listScrollAccum = 0;
  }
  // In EDIT selection mode, do not allow drag-scroll: checkbox taps/holds should only select.
  // Drag-scroll when the *current* layout actually has hidden rows (maxListScroll / maxTfaScroll).
  // Do not use LIST_MAX_VISIBLE here: it is legacy single-row math (=6) and wrongly blocks scroll
  // e.g. Passwords detailed view with exactly 6 entries (maxListScroll=2 but 6>6 is false).
  bool canScrollPwNotes = onListScreen && inListArea && maxListScroll > 0;
  bool canScrollTfa = inTfaListArea && maxTfaScroll > 0;
  bool canScrollList = !listEditMode && (canScrollPwNotes || canScrollTfa) && !(g_screen == UIScreen::PASSWORDS && g_showMasterPwShowPopup);
  if (canScrollList) {
    int dx = abs((int)sx - (int)g_listTouchDownX);
    int dy = abs((int)sy - (int)g_listTouchDownY);
    if (dx <= LIST_DRAG_THRESHOLD && dy <= LIST_DRAG_THRESHOLD) {
      g_listScrollLastY = -1;
    } else {
      g_listDidDrag = true;
      if (g_listScrollLastY < 0) {
        g_listScrollLastY = (int)sy;
      } else {
        int delta = (int)sy - g_listScrollLastY;
        g_listScrollLastY = (int)sy;
        g_listScrollAccum -= (float)delta;
        int stepH = (g_screen == UIScreen::NOTES) ? NOTE_GRID_ROW_STRIDE : (g_screen == UIScreen::PASSWORDS) ? (g_pwListDetailedView ? PW_DETAIL_ROW_STRIDE : PW_GRID_ROW_STRIDE)
                                                                         : (g_screen == UIScreen::TFA_LIST)  ? TFA_LIST_ROW_STRIDE
                                                                                                             : LIST_ROW_H;
        while (g_listScrollAccum >= stepH) {
          if (g_screen == UIScreen::PASSWORDS && g_pwListScroll < (uint8_t)maxListScroll) {
            int step = g_pwListDetailedView ? 1 : PW_GRID_COLS;
            g_pwListScroll = (uint8_t)min((int)g_pwListScroll + step, maxListScroll);
            if (!g_pwListDetailedView && (g_pwListScroll & 1)) g_pwListScroll--;
            draw();
          } else if (g_screen == UIScreen::NOTES && g_noteListScroll < (uint8_t)maxListScroll) {
            g_noteListScroll = (uint8_t)min((int)g_noteListScroll + NOTE_GRID_COLS, maxListScroll);
            draw();
          } else if (g_screen == UIScreen::TFA_LIST && g_tfaListScroll < (uint8_t)maxTfaScroll) {
            g_tfaListScroll = (uint8_t)min((int)g_tfaListScroll + 1, maxTfaScroll);
            draw();
          }
          g_listScrollAccum -= stepH;
        }
        while (g_listScrollAccum <= -stepH) {
          if (g_screen == UIScreen::PASSWORDS && g_pwListScroll > 0) {
            int step = g_pwListDetailedView ? 1 : PW_GRID_COLS;
            g_pwListScroll = (uint8_t)max(0, (int)g_pwListScroll - step);
            if (!g_pwListDetailedView && (g_pwListScroll & 1)) g_pwListScroll--;
            draw();
          } else if (g_screen == UIScreen::NOTES && g_noteListScroll > 0) {
            g_noteListScroll = (uint8_t)max(0, (int)g_noteListScroll - NOTE_GRID_COLS);
            draw();
          } else if (g_screen == UIScreen::TFA_LIST && g_tfaListScroll > 0) {
            g_tfaListScroll = (uint8_t)max(0, (int)g_tfaListScroll - 1);
            draw();
          }
          g_listScrollAccum += stepH;
        }
      }
    }
  } else if (onListScreen && !inListArea && !inTfaListArea) {
    g_listScrollLastY = -1;
  } else if (g_screen == UIScreen::TFA_LIST && !inTfaListArea) {
    g_listScrollLastY = -1;
  }

  // After leaving QR scan, sync wasPressed so first real tap is recognized (no stale edge)
  if (g_syncTouchAfterQrScan) {
    wasPressed = pressed;
    g_syncTouchAfterQrScan = false;
  }
  // On password-after-QR screen, whenever finger is up, treat as released so next touch is a clean tap
  if (g_screen == UIScreen::RESTORE_PASSWORD && !pressed)
    wasPressed = false;

  if (!pressed) {
    g_touchReleasedSinceTap = true;
    g_blockKeyboardUntilRelease = false;
    g_delHeldSinceMs = 0;
    g_pwFieldDragging = false;
    g_pwLongPressTriggered = false;
    g_noteFieldDragging = false;
    g_titleDragging = false;
    g_brightnessBarDragging = false;
    g_pwFocusSwipeTracking = false;
    g_multisigReviewDragging = false;
    if (g_cryptoTxReviewNeedsDraw
        && (g_screen == UIScreen::CRYPTO_REVIEW_KASPA_TX || g_screen == UIScreen::CRYPTO_REVIEW_PSBT)) {
      crypto_tx_review_scroll_present(true);
    }
    g_cryptoTxReviewTouchPending = false;
    g_cryptoTxReviewScrolling = false;
    g_cryptoTxReviewDragLastY = -1;
  }

  // While finger is down: password-editor swipe-right hides keyboard; hold on Del repeats backspace.
  // SD vault path picker is full-screen: never treat touches as keyboard/editor (Continue sits in key row zone).
  if (pressed && wasPressed && !g_sdSavePathPickOpen) {
    if (g_screen == UIScreen::EDITOR && g_editMode == EditMode::EDIT_PW_VALUE && g_pwEditKeyboardVisible && g_pwEditFocusField >= 1 && g_pwEditFocusField <= 5) {
      if (!g_pwFocusSwipeTracking) {
        g_pwFocusSwipeTracking = true;
        g_pwFocusSwipeStartX = (int16_t)sx;
        g_pwFocusSwipeStartY = (int16_t)sy;
      } else {
        int dxLive = (int)sx - (int)g_pwFocusSwipeStartX;
        int dyLive = (int)sy - (int)g_pwFocusSwipeStartY;
        if (dxLive >= SWIPE_BACK_MIN && dxLive > abs(dyLive) && !pwEditorFocusSwipeDownInsideStrip(g_pwFocusSwipeStartX, g_pwFocusSwipeStartY) && !pwEditorFocusSwipeStartedOnKeyboardArea(g_pwFocusSwipeStartX, g_pwFocusSwipeStartY)) {
          pwEditCollapseFocusedFieldToBrowse();
          g_touchIgnoreUntil = millis() + 260;  // consume same gesture; avoid second swipe-back to list
          g_lastTapMs = millis();
          g_touchReleasedSinceTap = false;
          g_pwFocusSwipeTracking = false;
          draw();
          wasPressed = pressed;
          return;
        }
      }
    } else {
      g_pwFocusSwipeTracking = false;
    }

    bool isTypingScreen = (g_editMode != EditMode::NONE)
                          || g_screen == UIScreen::LOCKED
                          || g_screen == UIScreen::UNLOCK_PASSWORD
                          || g_screen == UIScreen::CONFIRM_MASTER_SHOW
                          || g_screen == UIScreen::CONFIRM_MASTER_SEND
                          || (g_screen == UIScreen::PASSWORDS && g_showMasterPwShowPopup)
                          || g_screen == UIScreen::CREATE_PASSWORD
                          || g_screen == UIScreen::CREATE_PASSWORD2
                          || g_screen == UIScreen::RESTORE_PASSWORD
                          || g_screen == UIScreen::BACKUP_PASSWORD1
                          || g_screen == UIScreen::BACKUP_PASSWORD2
                          || g_screen == UIScreen::BACKUP_FROM_SEED
                          || g_screen == UIScreen::RESTORE_CODE
                          || g_screen == UIScreen::SET_TIME
                          || g_screen == UIScreen::SECURITY_PIN_SETUP
                          || g_screen == UIScreen::SECURITY_LOCK_PW_CONFIRM_VAULT
                          || g_screen == UIScreen::SECURITY_LOCK_PW_SETUP
                          || g_screen == UIScreen::SECURITY_DURESS_PW_SETUP
                          || g_screen == UIScreen::SECURITY_DURESS_PIN_SETUP
                          || g_screen == UIScreen::TFA_ADD
                          || g_screen == UIScreen::CRYPTO_NEW_ACCOUNT
                          || g_screen == UIScreen::CRYPTO_NEW_ACCOUNT_NAME
                          || g_screen == UIScreen::CRYPTO_PASSPHRASE_INPUT
                          || g_screen == UIScreen::DEVICE_RENAME
                          || g_screen == UIScreen::SD_FILE_RENAME;

    if (isTypingScreen && g_screen != UIScreen::SET_TIME && g_screen != UIScreen::SECURITY_PIN_SETUP
        && g_screen != UIScreen::SECURITY_DURESS_PIN_SETUP
        && !(g_screen == UIScreen::LOCKED && g_screenLockUsesPin)) {
      for (int i = 0; i < ROW3_N; i++) {
        char c = activeCharRow(3, i);
        if (c == '\b' && hitKeyRows123(keyRectRow3[i], sx, sy)) {
          if (g_delHeldSinceMs == 0) g_delHeldSinceMs = now;
          uint32_t held = now - g_delHeldSinceMs;
          if (held >= DEL_INITIAL_MS && now - g_lastDelRepeatMs >= DEL_REPEAT_MS) {
            g_lastDelRepeatMs = now;
            handleDeleteHold();
          }
          goto after_hold_del;
        }
      }
    }
    g_delHeldSinceMs = 0;
    g_lastDelRepeatMs = now;
  }
after_hold_del:

  if (pressed && wasPressed && g_screen == UIScreen::CRYPTO_MULTISIG_IMPORT_REVIEW && g_multisigReviewDragging) {
    int dy = (int)sy - (int)g_multisigReviewDragLastY;
    g_multisigReviewDragLastY = (int16_t)sy;
    g_multisigReviewScrollY += (int16_t)dy;
    draw();
    wasPressed = pressed;
    return;
  }
  // Crypto Review (Kaspa + BTC): scroll only when content overflows.
  if (pressed && wasPressed && g_editMode == EditMode::NONE
      && (g_screen == UIScreen::CRYPTO_REVIEW_KASPA_TX || g_screen == UIScreen::CRYPTO_REVIEW_PSBT)
      && crypto_tx_review_can_scroll()
      && (g_cryptoTxReviewTouchPending || g_cryptoTxReviewScrolling)) {
    const int ddx = abs((int)sx - (int)g_cryptoTxReviewDownX);
    const int ddy = abs((int)sy - (int)g_cryptoTxReviewDownY);
    const int kEngage = 8;
    if (!g_cryptoTxReviewScrolling) {
      if (ddy > kEngage && ddy >= ddx) {
        g_cryptoTxReviewScrolling = true;
        g_cryptoTxReviewDidDrag = true;
        g_cryptoTxReviewDragLastY = (int16_t)sy;
      }
    } else {
      if (g_cryptoTxReviewDragLastY < 0) {
        g_cryptoTxReviewDragLastY = (int16_t)sy;
      } else {
        int delta = (int)sy - (int)g_cryptoTxReviewDragLastY;
        g_cryptoTxReviewDragLastY = (int16_t)sy;
        if (delta != 0) {
          const int16_t prev = g_cryptoTxReviewScrollY;
          g_cryptoTxReviewScrollY = (int16_t)((int)g_cryptoTxReviewScrollY + delta);
          crypto_tx_review_clamp_scroll();
          if (g_cryptoTxReviewScrollY != prev) g_cryptoTxReviewNeedsDraw = true;
        }
      }
      // Always feed WDT while finger is down scrolling.
      esp_task_wdt_reset();
      if (g_cryptoTxReviewNeedsDraw) {
        const uint32_t t = millis();
        // ~30fps: scrollY tracks 1:1 every sample; present uses latest offset.
        if ((t - g_cryptoTxReviewLastDrawMs) >= 33u) {
          crypto_tx_review_scroll_present(false);
        }
      }
      wasPressed = pressed;
      return;
    }
  }

  // Password field: drag left/right to scroll through long password (or long-press 1s for full password popup)
  if (pressed && wasPressed && !g_sdSavePathPickOpen && g_pwFieldDragging && (g_editMode == EditMode::ADD_PW_VALUE || g_editMode == EditMode::EDIT_PW_VALUE) && (g_editMode != EditMode::EDIT_PW_VALUE || g_pwEditKeyboardVisible)) {
    const int boxX = 24, boxW = 272;
    const int boxH = 48, expand = 4, pwCharW = 12, pwPadding = 12;
    int boxY = pwValueStripBoxYKeyboardOpen();
    const int maxChars = (boxW - pwPadding * 2) / pwCharW;
    size_t len = strlen(g_editBuf);
    uint16_t* activeView = &g_editViewOffset;
    if (g_editMode == EditMode::EDIT_PW_VALUE) {
      if (g_pwEditFocusField == PW_FOCUS_NAME) activeView = &g_addPwViewName;
      else if (g_pwEditFocusField == PW_FOCUS_USER) activeView = &g_addPwViewUser;
      else if (g_pwEditFocusField == PW_FOCUS_SITE) activeView = &g_addPwViewSite;
      else if (g_pwEditFocusField == PW_FOCUS_NOTES) activeView = &g_addPwViewNotes;
    }
    if (len > 0 && sx >= (uint16_t)(boxX - expand) && sx < (uint16_t)(boxX + boxW + expand) && sy >= (uint16_t)(boxY - expand) && sy < (uint16_t)(boxY + boxH + expand)) {
      // Long-press 0.5s: show popup with full password (once per touch)
      if (pwEditIsPasswordFocusField(g_pwEditFocusField) && !g_pwLongPressTriggered && (now - g_pwLongPressStartMs >= 500)) {
        g_pwLongPressTriggered = true;
        g_pwShowFullPopup = true;
        g_pwPopupShownAtMs = now;
        draw();
      } else if (!g_pwShowFullPopup) {
        int deltaX = (int)sx - g_pwDragLastX;
        g_pwDragLastX = (int16_t)sx;
        // Smooth pixel scroll: 1:1 with finger movement (drag right -> see more on right)
        g_editViewOffsetPx += deltaX;
        int maxOffset = (int)len - maxChars;
        if (maxOffset < 0) maxOffset = 0;
        while (g_editViewOffsetPx >= pwCharW) {
          g_editViewOffsetPx -= pwCharW;
          if ((int)(*activeView) < maxOffset) (*activeView)++;
          else g_editViewOffsetPx = 0;
        }
        while (g_editViewOffsetPx < 0) {
          g_editViewOffsetPx += pwCharW;
          if (*activeView > 0) (*activeView)--;
          else g_editViewOffsetPx = 0;
        }
        // Cursor follows finger (smartphone-style): position under finger is the new cursor
        int relX = (int)sx - (boxX + pwPadding);
        if (relX < 0) relX = 0;
        int indexInWindow = relX / pwCharW;
        if (indexInWindow > maxChars) indexInWindow = maxChars;
        size_t newCursor = (size_t)(*activeView) + indexInWindow;
        if (newCursor > len) newCursor = len;
        g_editCursor = (uint16_t)newCursor;
        draw();
      }
    }
  }

  // Password details-first view (no keyboard): swipe-back only (layout is fixed — no vertical scroll).
  if (pressed && wasPressed && !g_sdSavePathPickOpen && g_editMode == EditMode::EDIT_PW_VALUE && !g_pwEditKeyboardVisible && !g_editingTitle) {
    int dxStatic = (int)sx - (int)g_swipeDownX;
    int dyStatic = (int)sy - (int)g_swipeDownY;
    if (dyStatic < 0) dyStatic = -dyStatic;
    // Give static-details swipe-back priority once movement is clearly rightward.
    if (dxStatic >= SWIPE_BACK_MIN && (dxStatic * 2) > dyStatic) {
      performSwipeBack();
      wasPressed = pressed;
      return;
    }
  }

  // Title (top bar): drag left/right to scroll through long title while editing
  if (pressed && wasPressed && !g_sdSavePathPickOpen && g_titleDragging && g_editingTitle) {
    int deltaX = (int)sx - (int)g_titleDragLastX;
    g_titleDragLastX = (int16_t)sx;
    const int titleCharW = 12;
    int deltaChars = -deltaX / titleCharW;  // drag left -> move window right
    if (deltaChars != 0) {
      int len = (int)strlen(g_editBuf);
      const int titleX = 38;
      const int maxChars = (LCD_W - titleX - 6) / titleCharW;
      int maxOff = len - maxChars;
      if (maxOff < 0) maxOff = 0;
      int newOff = (int)g_titleViewOffset + deltaChars;
      if (newOff < 0) newOff = 0;
      if (newOff > maxOff) newOff = maxOff;
      g_titleViewOffset = (uint8_t)newOff;
      draw();
    }
  }

  // Note body: start drag only after movement (so tap-to-position isn't overwritten by jitter)
  if (pressed && !g_sdSavePathPickOpen && (g_editMode == EditMode::ADD_NOTE_BODY || g_editMode == EditMode::EDIT_NOTE_BODY)) {
    const int areaX = 8, areaY = 48, areaW = LCD_W - 16, areaH = (KB_Y0_DEFAULT - 2) - areaY;
    if (sx >= (uint16_t)areaX && sx < (uint16_t)(areaX + areaW) && sy >= (uint16_t)areaY && sy < (uint16_t)(areaY + areaH)) {
      if (!g_noteFieldDragging) {
        int dx = (int)sx - g_noteDragLastX, dy = (int)sy - g_noteDragLastY;
        if (dx < 0) dx = -dx;
        if (dy < 0) dy = -dy;
        if (dx > 8 || dy > 8) g_noteFieldDragging = true;  // start drag only after ~8px movement
      }
    }
  }
  // Note body: drag to scroll vertically and horizontally; cursor follows finger
  if (pressed && wasPressed && !g_sdSavePathPickOpen && g_noteFieldDragging && (g_editMode == EditMode::ADD_NOTE_BODY || g_editMode == EditMode::EDIT_NOTE_BODY)) {
    const int areaX = 8, areaY = 48, areaW = LCD_W - 16, areaH = (KB_Y0_DEFAULT - 2) - areaY;
    const int lineH = 18, charW = 12, pad = 6;
    const int visibleLines = areaH / lineH;
    if (sx >= (uint16_t)areaX && sx < (uint16_t)(areaX + areaW) && sy >= (uint16_t)areaY && sy < (uint16_t)(areaY + areaH)) {
      int deltaX = (int)sx - g_noteDragLastX;
      int deltaY = (int)sy - g_noteDragLastY;
      g_noteDragLastX = (int16_t)sx;
      g_noteDragLastY = (int16_t)sy;
      g_noteViewOffsetPx -= deltaX;
      if (g_noteViewOffsetPx < 0) g_noteViewOffsetPx = 0;
      int lineDelta = -deltaY / lineH;
      if (lineDelta != 0) {
        size_t lenDrag = strlen(g_editBuf);
        int totalLinesDrag = 0;
        if (lenDrag > 0) {
          int tl, tc;
          noteCursorToLineCol(lenDrag, &tl, &tc);
          totalLinesDrag = tl + 1;
        }
        int maxScrollDrag = totalLinesDrag - visibleLines + NOTE_EXTRA_SCROLL_LINES;
        if (maxScrollDrag < 0) maxScrollDrag = 0;
        int newScroll = (int)g_noteScrollLine + lineDelta;
        if (newScroll < 0) newScroll = 0;
        if (newScroll > maxScrollDrag) newScroll = maxScrollDrag;
        g_noteScrollLine = (uint16_t)newScroll;
      }
      int relY = (int)sy - (areaY + pad);
      int relX = (int)sx - (areaX + pad) + g_noteViewOffsetPx;
      int visibleLine = relY / lineH;
      if (visibleLine < 0) visibleLine = 0;
      int line = (int)g_noteScrollLine + visibleLine;
      int col = relX / charW;
      if (col < 0) col = 0;
      g_noteVisualCursorLine = line;
      g_noteVisualCursorCol = col;
      size_t len = strlen(g_editBuf);
      if (len > 0) {
        int totalLines = 0;
        {
          int tl, tc;
          noteCursorToLineCol(len, &tl, &tc);
          totalLines = tl + 1;
        }
        int textLine = line;
        if (textLine >= totalLines) textLine = totalLines - 1;
        size_t idx = noteLineColToIndex(textLine, col);
        if (idx > len) idx = len;
        g_editCursor = (uint16_t)idx;
      }
      draw();
    }
  }

  // Screen brightness: drag along the blue bar (Device → Screen brightness).
  if (pressed && wasPressed && g_screen == UIScreen::DEVICE_BRIGHTNESS && g_editMode == EditMode::NONE) {
    const bool inBar = ((int)sx >= BR_BRIGHTNESS_BAR_X && (int)sx < BR_BRIGHTNESS_BAR_X + BR_BRIGHTNESS_BAR_W
                        && (int)sy >= BR_BRIGHTNESS_BAR_Y && (int)sy < BR_BRIGHTNESS_BAR_Y + BR_BRIGHTNESS_BAR_H);
    if (inBar && !g_brightnessBarDragging) {
      g_brightnessBarDragging = true;
      g_swipeReserved = false;
    }
    if (g_brightnessBarDragging) {
      uint8_t p = brightnessPctFromBarX((int)sx);
      if (p != g_lcdBrightnessPct) {
        lcdBacklightSetPercent(p);
        draw();
      }
    }
  }

  if (pressed && !wasPressed && g_touchReleasedSinceTap) {
    // New finger-down ends the post-slide swipe-back block (signed QR may already be showing).
    g_psbtSlideCommitBlocksSwipeBack = false;
    // VIEW_CODE Save to SD: handled at first touch-down in loop (right after g_multisigEdgeDeferTap = false)
    // so it runs before g_touchIgnoreUntil / swipe-reserve — do not duplicate here.
    // After swipe-back transitions, ignore the first touch-down briefly to prevent
    // accidental taps on the destination screen (e.g. menu cards). Nav bar is exempt.
    if (now < g_touchIgnoreUntil && !nav_bar_zone_contains(sx, sy)) {
      wasPressed = pressed;
      return;
    }
    // Kaspa review → Fee: handle on touch-down before swipe-back eats the tap.
    if (g_screen == UIScreen::CRYPTO_REVIEW_KASPA_TX && g_editMode == EditMode::NONE
        && (now - g_lastTapMs > (uint32_t)KEY_DEBOUNCE_MS)) {
      if (g_kaspaReviewSummaryValid && g_kaspaReviewSummary.ok && hitPad(BTN_KASPA_UNIT, (int16_t)sx, (int16_t)sy, 18)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        g_kaspaReviewUnitSompi = !g_kaspaReviewUnitSompi;
        draw();
        wasPressed = pressed;
        return;
      }
      if (hitPad(BTN_KASPA_REVIEW_CONTINUE, (int16_t)sx, (int16_t)sy, 22)
          && !nav_bar_home_tap_hit((int16_t)sx, (int16_t)sy)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        if (!g_kaspaPsktScanLen || !g_kaspaPsktScanBuf[0]) {
          setMsg("No Kaspa tx scanned");
          draw();
        } else if (!kaspa_accept_loaded_unsigned_for_wallet()) {
          draw();
        } else {
          show(UIScreen::CRYPTO_KASPA_FEE);
        }
        wasPressed = pressed;
        return;
      }
      if (hit(BTN_TOP_BURGER, sx, sy)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        show(UIScreen::CRYPTO_HOME);
        wasPressed = pressed;
        return;
      }
    }
    // Kaspa fee → Confirm signing (same pattern as PSBT fee NEXT).
    if (g_screen == UIScreen::CRYPTO_KASPA_FEE && g_editMode == EditMode::NONE
        && (now - g_lastTapMs > (uint32_t)KEY_DEBOUNCE_MS)) {
      if (!g_psbtSignConfirmActive && hitPad(BTN_CRYPTO_REVIEW_SIGN, (int16_t)sx, (int16_t)sy, 22)
          && !nav_bar_home_tap_hit((int16_t)sx, (int16_t)sy)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        if (!g_kaspaPsktScanLen || !g_kaspaPsktScanBuf[0]) {
          setMsg("No Kaspa tx scanned");
          draw();
        } else {
          crypto_prepare_kaspa_sign_confirm_text();
          psbt_slide_reset();
          g_psbtSignCancelConfirmPopup = false;
          g_psbtVisualizeActive = false;
          g_psbtSignConfirmActive = true;
          draw();
        }
        wasPressed = pressed;
        return;
      }
    }
    // PSBT review → Fee screen: run before left-edge swipe reservation eats tap-down on NEXT.
    if (g_screen == UIScreen::CRYPTO_REVIEW_PSBT && g_editMode == EditMode::NONE
        && (now - g_lastTapMs > (uint32_t)KEY_DEBOUNCE_MS)) {
      if (g_cryptoReviewSummaryValid && g_cryptoReviewSummary.ok && hitPad(BTN_PSBT_BITCOIN_UNIT, (int16_t)sx, (int16_t)sy, 18)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        g_psbtReviewUnitSats = !g_psbtReviewUnitSats;
        draw();
        wasPressed = pressed;
        return;
      }
      // Do not steal the home-pill column (Continue pad reaches into the nav band).
      if (hitPad(BTN_CRYPTO_REVIEW_PSBT_NEXT, (int16_t)sx, (int16_t)sy, 22)
          && !nav_bar_home_tap_hit((int16_t)sx, (int16_t)sy)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        if (!g_cryptoHasUnsigned) {
          setMsg("No PSBT scanned");
          draw();
        } else {
          show(UIScreen::CRYPTO_PSBT_FEE);
        }
        wasPressed = pressed;
        return;
      }
      if (hit(BTN_TOP_BURGER, sx, sy)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        show(UIScreen::CRYPTO_HOME);
        wasPressed = pressed;
        return;
      }
    }
    // PSBT fee screen only: NEXT → confirm (Kaspa has its own handler above).
    if (g_screen == UIScreen::CRYPTO_PSBT_FEE && g_editMode == EditMode::NONE
        && (now - g_lastTapMs > (uint32_t)KEY_DEBOUNCE_MS)) {
      if (!g_psbtSignConfirmActive && hitPad(BTN_CRYPTO_REVIEW_SIGN, (int16_t)sx, (int16_t)sy, 22)
          && !nav_bar_home_tap_hit((int16_t)sx, (int16_t)sy)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        if (!g_cryptoHasUnsigned) {
          setMsg("No PSBT scanned");
          draw();
        } else {
          crypto_prepare_psbt_sign_confirm_text();
          psbt_slide_reset();
          g_psbtSignCancelConfirmPopup = false;
          g_psbtVisualizeActive = false;
          g_psbtSignConfirmActive = true;
          draw();
        }
        wasPressed = pressed;
        return;
      }
    }
    // Scan PSBT: make BACK respond immediately on touch-down (camera loop runs continuously).
    if (g_screen == UIScreen::CRYPTO_SCAN_PSBT && g_editMode == EditMode::NONE && pressed && !wasPressed) {
      if (hitPad(BTN_CRYPTO_SCAN_BACK, (int16_t)sx, (int16_t)sy, 14) || hit(BTN_TOP_BURGER, sx, sy)) {
        g_lastTapMs = now;
        g_touchReleasedSinceTap = false;
        if (g_qrScanning) {
          g_qrScanning = false;
          stop_qr_scan();
        }
        seedmask_ur_psbt_scan_reset();
        show(UIScreen::CRYPTO_HOME);
        wasPressed = pressed;
        return;
      }
    }
