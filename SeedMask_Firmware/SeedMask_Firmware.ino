static bool multisig_prepare_review_from_payload(const char* payload, bool rejectIfDuplicateImport) {
  if (rejectIfDuplicateImport) {
    int dupIdx = multisig_payload_find_duplicate_stored_idx(payload);
    if (dupIdx >= 0) {
      multisig_duplicate_notice_activate((uint8_t)dupIdx);
      setMsg("");
      return false;
    }
  }
  if (!multisig_fill_review_from_payload(payload)) return false;
  if (!multisig_import_policy_matches_device_fingerprint_ex(false)) return false;
  return true;
}

// BIP48 cosigner path m/48'/<coin>'/<account>'/<script>' — third number is the BTC account index.
static bool multisig_parse_bip48_path_account(const char* inDeriv, uint32_t* outAccount) {
  if (!inDeriv || !outAccount) return false;
  if (!strstr(inDeriv, "48") && !strstr(inDeriv, "45")) return false;
  char d[80];
  size_t n = 0;
  for (size_t i = 0; inDeriv[i] && n + 1 < sizeof(d); i++) {
    char c = inDeriv[i];
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') continue;
    if (c == 'h' || c == 'H') c = '\'';
    d[n++] = c;
  }
  d[n] = 0;
  unsigned coin = 0, acct = 0, script = 0;
  if (sscanf(d, "m/45'/111111'/%u'", &acct) == 1 || sscanf(d, "45'/111111'/%u'", &acct) == 1) {
    *outAccount = (uint32_t)acct;
    return true;
  }
  if (sscanf(d, "m/48'/%u'/%u'/%u'", &coin, &acct, &script) != 3
      && sscanf(d, "48'/%u'/%u'/%u'", &coin, &acct, &script) != 3) {
    return false;
  }
  *outAccount = (uint32_t)acct;
  (void)coin;
  (void)script;
  return true;
}

// Resolve BTC account for storing this import: prefer this device's cosigner path, else consensus across paths.
static bool multisig_target_btc_account_for_import(uint32_t* outAcc) {
  if (!outAcc) return false;
  char dev[9] = { 0 };
  const bool haveDev = current_master_xfp(dev);

  uint32_t fromDev = 0xFFFFFFFFu;
  if (haveDev) {
    for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
      if (!looks_like_fp8(g_multisigReviewFp[i])) continue;
      if (!multisig_fp8_hex_eq_ci(g_multisigReviewFp[i], dev)) continue;
      uint32_t ac = 0;
      if (multisig_parse_bip48_path_account(g_multisigReviewDerivs[i], &ac)) {
        fromDev = ac;
        break;
      }
    }
  }

  // Device row wins first so a bogus path on another cosigner cannot force g_addrAccount via consensus conflict.
  if (fromDev != 0xFFFFFFFFu) {
    *outAcc = fromDev;
    return true;
  }

  uint32_t consensus = 0xFFFFFFFFu;
  for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
    uint32_t ac = 0;
    if (!multisig_parse_bip48_path_account(g_multisigReviewDerivs[i], &ac)) continue;
    if (consensus == 0xFFFFFFFFu) consensus = ac;
    else if (consensus != ac) {
      *outAcc = g_addrAccount;
      return true;
    }
  }

  if (consensus != 0xFFFFFFFFu) {
    *outAcc = consensus;
    return true;
  }
  uint32_t ac = 0;
  if (multisig_parse_bip48_path_account(g_multisigReviewDeriv, &ac)) {
    *outAcc = ac;
    return true;
  }
  *outAcc = g_addrAccount;
  return true;
}

static bool multisig_commit_import() {
  if (g_multisigWalletCount >= MULTISIG_MAX_STORED_WALLETS) {
    setMsg("Maximum imported wallets (16)");
    return false;
  }
  {
    int dupIdx = multisig_payload_find_duplicate_stored_idx(g_multisigPolicyPayload);
    if (dupIdx >= 0) {
      multisig_duplicate_notice_activate((uint8_t)dupIdx);
      setMsg("");
      return false;
    }
  }
  uint32_t targetAcct = g_addrAccount;
  (void)multisig_target_btc_account_for_import(&targetAcct);
  if (!btc_accounts_ensure_present(targetAcct)) {
    setMsg("Account list full");
    return false;
  }
  g_btcAddrAccount = targetAcct;
  g_addrAccount = targetAcct;
  btc_accounts_save_to_prefs();
  multisig_invalidate_visible_list();
  multisig_clamp_settings_scroll();

  snprintf(g_multisigWalletNames[g_multisigWalletCount], sizeof(g_multisigWalletNames[0]), "%s",
           g_multisigReviewName[0] ? g_multisigReviewName : "Imported multisig");
  memcpy(g_multisigWalletPayloads[g_multisigWalletCount], g_multisigPolicyPayload, MULTISIG_WALLET_PAYLOAD_BYTES);
  {
    uint32_t ctxTag = MULTISIG_CTX_TAG_UNKNOWN;
    if (!current_master_xfp_u32(&ctxTag)) ctxTag = MULTISIG_CTX_TAG_UNKNOWN;
    g_multisigWalletContextTag[g_multisigWalletCount] = ctxTag;
  }
  g_multisigWalletBtcAccount[g_multisigWalletCount] = targetAcct;
  g_multisigWalletCount++;
  multisig_invalidate_visible_list();
  multisig_save_all_prefs();
  multisig_clamp_settings_scroll();
  if (g_multisigVisibleCount > MULTISIG_SETTINGS_VISIBLE_ROWS) {
    g_multisigSettingsScroll = (uint8_t)(g_multisigVisibleCount - MULTISIG_SETTINGS_VISIBLE_ROWS);
  }
  return true;
}

static bool multisig_prepare_review_from_scanned_qr(const char* scanText) {
  if (!scanText || !scanText[0]) return false;
  char urDecoded[MULTISIG_WALLET_PAYLOAD_BYTES] = { 0 };
  char urErr[96] = { 0 };
  if (strncasecmp(scanText, "ur:", 3) == 0) {
    if (!seedmask_ur_decode_text_payload(scanText, urDecoded, sizeof(urDecoded), urErr, sizeof(urErr))) {
      setMsg(urErr[0] ? urErr : "Unsupported policy UR");
      return false;
    }
    strncpy(g_multisigPolicyPayload, urDecoded, MULTISIG_WALLET_PAYLOAD_BYTES - 1);
    g_multisigPolicyPayload[MULTISIG_WALLET_PAYLOAD_BYTES - 1] = 0;
  } else {
    strncpy(g_multisigPolicyPayload, scanText, MULTISIG_WALLET_PAYLOAD_BYTES - 1);
    g_multisigPolicyPayload[MULTISIG_WALLET_PAYLOAD_BYTES - 1] = 0;
  }
  return multisig_prepare_review_from_payload(g_multisigPolicyPayload, true);
}

static void multisig_sd_scan_dir() {
  g_msSdCount = 0;
  g_msSdSelectedFile = -1;
  DIR* dir = opendir(g_msSdCwd);
  if (!dir) return;
  if (strcmp(g_msSdCwd, "/sdcard") != 0) {
    strncpy(g_msSdNames[g_msSdCount], "..", sizeof(g_msSdNames[0]) - 1);
    g_msSdNames[g_msSdCount][sizeof(g_msSdNames[0]) - 1] = 0;
    g_msSdIsDir[g_msSdCount] = 1;
    g_msSdCount++;
  }
  struct dirent* entry;
  while ((entry = readdir(dir)) != NULL && g_msSdCount < SD_MAX_FILES) {
    if (entry->d_name[0] == '.') continue;
    char full[192];
    snprintf(full, sizeof(full), "%s/%s", g_msSdCwd, entry->d_name);
    struct stat st;
    if (stat(full, &st) != 0) continue;
    strncpy(g_msSdNames[g_msSdCount], entry->d_name, 63);
    g_msSdNames[g_msSdCount][63] = 0;
    g_msSdIsDir[g_msSdCount] = S_ISDIR(st.st_mode) ? 1 : 0;
    g_msSdCount++;
  }
  closedir(dir);
}

static void ms_sd_select_file_by_basename(const char* basename) {
  g_msSdSelectedFile = -1;
  if (!basename || !basename[0] || !g_msSdNames) return;
  for (int i = 0; i < g_msSdCount; i++) {
    if (g_msSdIsDir[i]) continue;
    if (strcmp(g_msSdNames[i], basename) == 0) {
      g_msSdSelectedFile = i;
      return;
    }
  }
}

static bool multisig_sd_go_parent() {
  if (strcmp(g_msSdCwd, "/sdcard") == 0) return false;
  char* slash = strrchr(g_msSdCwd + 1, '/');
  if (!slash) return false;
  *slash = 0;
  if (strlen(g_msSdCwd) < strlen("/sdcard")) strncpy(g_msSdCwd, "/sdcard", sizeof(g_msSdCwd));
  g_msSdCwd[sizeof(g_msSdCwd) - 1] = 0;
  return true;
}

static bool multisig_import_policy_from_path(const char* path) {
  FILE* f = fopen(path, "rb");
  if (!f) {
    setMsg("Cannot open file");
    return false;
  }
  size_t n = fread(g_multisigPolicyPayload, 1, MULTISIG_WALLET_PAYLOAD_BYTES - 1, f);
  fclose(f);
  g_multisigPolicyPayload[n] = 0;
  if (!multisig_prepare_review_from_payload(g_multisigPolicyPayload, true)) {
    if (!g_msg[0] && !g_multisigDuplicateNoticeActive) setMsg("Invalid multisig policy file");
    return false;
  }
  g_multisigReviewReturnScreen = UIScreen::CRYPTO_MULTISIG_SD_BROWSE;
  show(UIScreen::CRYPTO_MULTISIG_IMPORT_REVIEW);
  return true;
}

static void multisig_sd_browse_begin() {
  if (!sd_ready()) {
    setMsg("Insert microSD");
    return;
  }
  strncpy(g_msSdCwd, "/sdcard", sizeof(g_msSdCwd));
  g_msSdCwd[sizeof(g_msSdCwd) - 1] = 0;
  g_msSdScrollOffset = 0;
  g_msSdShowDeleteConfirm = false;
  g_showSdDeleteConfirm = false;
  multisig_sd_scan_dir();
  setMsg("");
  show(UIScreen::CRYPTO_MULTISIG_SD_BROWSE);
}

static void crypto_sign_begin_scan_qr() {
  if (crypto_home_asset_is_kaspa()) {
    g_qrScanTarget = QrScanTarget::CRYPTO_KASPA_PSKT;
    kaspa_ur_scan_session_reset();
