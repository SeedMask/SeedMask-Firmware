static void handleCryptoNewAccountNameTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    if (g_multisigRenameActive) {
      g_multisigRenameActive = false;
      show(UIScreen::CRYPTO_MULTISIG_WALLET);
    } else if (g_accountNameEditIsRename) show(UIScreen::CRYPTO_HOME);
    else show(UIScreen::CRYPTO_NEW_ACCOUNT);
    return;
  }
  if (hitOkKey((int16_t)x, (int16_t)y)) {
    if (strlen(g_newAccountNameBuf) == 0) {
      setMsg("Enter account name");
      draw();
      return;
    }
    if (g_multisigRenameActive) {
      uint32_t cur = MULTISIG_CTX_TAG_UNKNOWN;
      if (g_multisigSelectedIdx >= g_multisigWalletCount || !current_master_xfp_u32(&cur)
          || g_multisigWalletContextTag[g_multisigSelectedIdx] != cur) {
        g_multisigRenameActive = false;
        show(UIScreen::CRYPTO_MULTISIG_SETTINGS);
        return;
      }
      snprintf(g_multisigWalletNames[g_multisigSelectedIdx], sizeof(g_multisigWalletNames[0]), "%s", g_newAccountNameBuf);
      multisig_save_all_prefs();
      g_newAccountNameBuf[0] = 0;
      g_multisigRenameActive = false;
      setMsg("Wallet renamed");
      show(UIScreen::CRYPTO_MULTISIG_WALLET);
      return;
    }
    if (g_accountNameEditIsRename) {
      if (!crypto_account_set_name(g_newAccountPending, g_newAccountNameBuf)) {
        setMsg("Rename failed");
        draw();
        return;
      }
      crypto_accounts_save_all_prefs();
      setMsg("");
      g_accountNameEditIsRename = false;
      show(UIScreen::CRYPTO_HOME);
      return;
    }
    if (crypto_accounts_contains(g_newAccountPending)) {
      setMsg("Already added");
      show(UIScreen::CRYPTO_NEW_ACCOUNT);
      return;
    }
    if (!crypto_accounts_add(g_newAccountPending, g_newAccountNameBuf)) {
      setMsg("List full");
      show(UIScreen::CRYPTO_NEW_ACCOUNT);
      return;
    }
    g_newAccountBuf[0] = 0;
    g_newAccountNameBuf[0] = 0;
    g_newAccountPending = 0;
    setMsg("");
    invalidate_address_explorer_cache();
    show(UIScreen::CRYPTO_SETTINGS);
    return;
  }
  passwordInputTap(x, y, g_newAccountNameBuf, sizeof(g_newAccountNameBuf));
