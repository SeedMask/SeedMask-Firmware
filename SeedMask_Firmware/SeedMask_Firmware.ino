                               || g_screen == UIScreen::BACKUP_PASSWORD1 || g_screen == UIScreen::BACKUP_PASSWORD2);
  if (createPwScreen && !g_busy)
    drawPasswordCreateHintCard(g_createVaultPasswordThenAdd ? kMsgVaultPwCreated : kMsgBackupPwCreated);

  // Password field geometry (messages stack upward from just below this)
  const int boxX = 24, boxY = 195, boxW = 272, boxH = 48;
  const int padAboveField = 10;

  bool isRestorePw = (g_screen == UIScreen::RESTORE_PASSWORD);
  bool isSdFile = isRestorePw && g_restoreFull[0] && (strncmp(g_restoreFull, "/sdcard/", 8) == 0);
  const bool sdProgressMsg = isSdFile && (strstr(g_msg, "Validating") || strstr(g_msg, "Restoring"));
  const bool hideDecryptPrompt = isSdFile && (strncmp(g_msg, "Enter password to decrypt", 25) == 0);

  gfx->setTextColor(RGB565_WHITE);
  // Baseline for the bottom-most line of helper/status text (just above the password box)
  int ty = boxY - padAboveField;

  // Status / prompt (closest to password field)
  if (isSdFile) {
    if (g_msg[0] && !hideDecryptPrompt) {
      gfx->setTextSize(sdProgressMsg ? 2 : 1);
      int lh = sdProgressMsg ? 18 : 10;
      ty -= lh;
      gfx->setCursor(10, ty);
      gfx->print(g_msg);
    }
  } else if (g_msg[0]) {
    gfx->setTextSize(sdProgressMsg ? 2 : 1);
    int lh = sdProgressMsg ? 18 : 10;
    ty -= lh;
    gfx->setCursor(10, ty);
    gfx->print(g_msg);
  }

  // Duress setup: two lines above status
  if (g_screen == UIScreen::SECURITY_DURESS_PW_SETUP) {
    gfx->setTextSize(1);
    ty -= 12;
    gfx->setCursor(10, ty);
    gfx->print(g_duressPwSetupPhase == 0 ? "Enter password" : "Confirm password");
    ty -= 12;
    gfx->setCursor(10, ty);
    if (g_duressTypeSetupPending)
      gfx->print("Duress unlock for this type only");
    else
      gfx->print("Enter a different password from your main password");
  }

  // RESTORE_PASSWORD: source info above the other lines
  if (isRestorePw && g_restoreFull[0]) {
    gfx->setTextSize(1);
    ty -= 16;
    gfx->setCursor(10, ty);
    if (isSdFile) {
      const char* base = strrchr(g_restoreFull, '/');
      base = base ? base + 1 : g_restoreFull;
      gfx->print("File: ");
      gfx->print(base);
    } else if (strncmp(g_restoreFull, "SPE1|", 5) == 0) {
      gfx->print("Scanned: Encrypted (SPE1)");
    } else if (strncmp(g_restoreFull, "SP2|", 4) == 0) {
      gfx->print("Scanned: Plain (SP2)");
    } else if (strncmp(g_restoreFull, "SPB1-", 5) == 0) {
      gfx->print("Scanned: ");
      size_t showLen = strlen(g_restoreFull);
      if (showLen > 28) showLen = 28;
      for (size_t i = 0; i < showLen; i++) gfx->print(g_restoreFull[i]);
      if (strlen(g_restoreFull) > 28) gfx->print("...");
    }
  }

  // Password field: box with eye icon at right end (text must not overlap eye)
  const int pwPadding = 12;
  const int pwCharW = 12;                  // 6*textSize(2)
  const int eyeRight = BTN_PW_SHOWHIDE.x;  // text must end before eye
  const int maxPwChars = (eyeRight - boxX - pwPadding - 4) / pwCharW;
  gfx->fillRoundRect(boxX, boxY, boxW, boxH, 12, UI_CARD);
  gfx->drawRoundRect(boxX, boxY, boxW, boxH, 12, UI_ACCENT);
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  int pwY = boxY + (boxH - 16) / 2;
  gfx->setCursor(boxX + pwPadding, pwY);
  size_t len = strlen(pw);
  if (masked) {
    size_t n = len <= (size_t)maxPwChars ? len : maxPwChars;
    for (size_t i = 0; i < n; i++) gfx->print("*");
  } else {
    if (len > (size_t)maxPwChars)
      gfx->print(pw + (len - maxPwChars));
    else
      gfx->print(pw);
  }
  if (strlen(pw) > 0) {
    int cx = BTN_PW_SHOWHIDE.x + BTN_PW_SHOWHIDE.w / 2, cy = BTN_PW_SHOWHIDE.y + BTN_PW_SHOWHIDE.h / 2;
    drawPasswordEyeIcon(cx, cy, masked);
