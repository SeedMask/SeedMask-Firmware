static void handleCryptoConnectSinglesigTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_optionsHomeScreen = UIScreen::CRYPTO_HOME;
    show(UIScreen::BURGER_MENU);
    return;
  }
  if (crypto_home_asset_is_kaspa()) {
    if (hit(BTN_CONNECT_SEEDMASK_ONLY, x, y)) {
      (void)crypto_open_connect_seedmask_qr(false);
    }
    return;
  }
  if (hit(BTN_CONNECT_SPARROW, x, y)) {
    (void)crypto_open_connect_sparrow_qr(false);
    return;
  }
  // Blue Wallet — Electrum/Coldcard JSON (same as Coordinator). keystore.label becomes the wallet name in BlueWallet.
  if (hit(BTN_CONNECT_BLUE, x, y)) {
    g_cryptoConnectQrFromMultisig = false;
    memset(g_cryptoConnectSparrowUr, 0, CRYPTO_CONNECT_SPARROW_UR_BYTES);
    g_cryptoConnectSparrowUrFountain = false;
    g_cryptoConnectSparrowQrAnimPaused = false;

    char masterXfpHex[9] = { 0 };
    if (!current_master_xfp(masterXfpHex) || !masterXfpHex[0]) {
      setMsg("xfp failed");
      draw();
      return;
    }
    // ckcc_xfp = little-endian uint32 of the 4 fingerprint bytes (Coldcard / BlueWallet convention).
    uint32_t xfp_be = 0;
    if (!current_master_xfp_u32(&xfp_be)) {
      setMsg("xfp failed");
      draw();
      return;
    }
    const uint32_t ckcc_fp = __builtin_bswap32(xfp_be);

    char ckcc_xpub[120] = { 0 };
    char zpub[120] = { 0 };
    if (!btc_bip84_account_extpub(g_addrAccount, true, ckcc_xpub, sizeof(ckcc_xpub))
        || !btc_bip84_account_extpub(g_addrAccount, false, zpub, sizeof(zpub))) {
      setMsg(g_addrLastErr[0] ? g_addrLastErr : "xpub export failed");
      draw();
      return;
    }
    char deriv[48] = { 0 };
    format_xpub_deriv_path(deriv, sizeof(deriv), AddrType::P2WPKH, false, g_addrAccount);
    char label[48] = { 0 };
    snprintf(label, sizeof(label), "SeedMask [%s]", masterXfpHex);

    int nw = snprintf(
      g_cryptoConnectSparrowUr, CRYPTO_CONNECT_SPARROW_UR_BYTES,
      "{\"seed_version\":17,\"use_encryption\":false,\"wallet_type\":\"standard\","
      "\"keystore\":{\"ckcc_xfp\":%u,\"ckcc_xpub\":\"%s\",\"hw_type\":\"passport\",\"type\":\"hardware\","
      "\"label\":\"%s\",\"derivation\":\"%s\",\"xpub\":\"%s\"}}",
      (unsigned)ckcc_fp, ckcc_xpub, label, deriv, zpub);
    if (nw <= 0 || (size_t)nw >= CRYPTO_CONNECT_SPARROW_UR_BYTES) {
      g_cryptoConnectSparrowUr[0] = 0;
      setMsg("Blue Wallet export too large");
      draw();
