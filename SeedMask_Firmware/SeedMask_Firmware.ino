  return NAV_BAR_ZONE_H;
}

static int nav_bar_zone_top() {
  return nav_bar_zone_bottom() - nav_bar_zone_h();
}
static int nav_bar_indicator_y() {
  return nav_bar_zone_bottom() - NAV_BAR_INDICATOR_H - 4;
}

static bool nav_bar_keyboard_active() {
