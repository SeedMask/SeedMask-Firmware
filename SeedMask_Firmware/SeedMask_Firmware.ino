static void handleCryptoPsbtFeeTap(uint16_t x, uint16_t y) {
  if (g_psbtSignConfirmActive) {
    if (g_psbtVisualizeActive) {
      if (hitPad(BTN_PSBT_VIZ_CLOSE, (int16_t)x, (int16_t)y, 18) || hit(BTN_TOP_BURGER, x, y)) {
        g_psbtVisualizeActive = false;
        g_psbtVizScrolling = false;
        draw();
      }
      // Ignore other taps (scroll is handled while finger is down)
      return;
    }
    if (g_psbtSignCancelConfirmPopup) {
      Rect rYes, rNo;
      psbt_sign_cancel_popup_btn_rects(&rYes, &rNo);
      if (hit(rYes, x, y)) {
        psbt_slide_reset();
        g_psbtSignCancelConfirmPopup = false;
        g_psbtVisualizeActive = false;
        setMsg("");
        show(UIScreen::CRYPTO_HOME);
        return;
      }
      if (hit(rNo, x, y)) {
        g_psbtSignCancelConfirmPopup = false;
        draw();
        return;
      }
      return;
    }
    if (hit(BTN_PSBT_SIGN_CONF_VISUALIZE, x, y)) {
      crypto_refresh_psbt_review();
      g_psbtVisualizeActive = true;
      g_psbtVizScrollY = 0;
      g_psbtVizScrolling = false;
      g_psbtVizLastAnimMs = millis();
      draw();
      return;
    }
    if (hit(BTN_PSBT_SIGN_CONF_CANCEL, x, y)) {
      g_psbtSignCancelConfirmPopup = true;
      draw();
      return;
    }
    return;
  }
  if (hitPad(BTN_CRYPTO_REVIEW_SIGN, (int16_t)x, (int16_t)y, 22)) {
    if (!g_cryptoHasUnsigned) {
      setMsg("No PSBT scanned");
      draw();
    } else {
      crypto_prepare_psbt_sign_confirm_text();
      psbt_slide_reset();
      g_psbtSignCancelConfirmPopup = false;
      g_psbtVisualizeActive = false;
      g_psbtSignConfirmActive = true;
      draw();
    }
    return;
  }
  if (hit(BTN_TOP_BURGER, x, y)) {
    show(UIScreen::CRYPTO_HOME);
    return;
  }
}

