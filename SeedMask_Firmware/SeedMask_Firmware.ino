static uint16_t blend565(uint16_t bg, uint16_t fg, float a) {
  if (a < 0.0f) a = 0.0f;
  if (a > 1.0f) a = 1.0f;
  int r0 = (bg >> 11) & 0x1F, g0 = (bg >> 5) & 0x3F, b0 = bg & 0x1F;
  int r1 = (fg >> 11) & 0x1F, g1 = (fg >> 5) & 0x3F, b1 = fg & 0x1F;
  int r = (int)(r0 + (r1 - r0) * a);
  int g = (int)(g0 + (g1 - g0) * a);
  int b = (int)(b0 + (b1 - b0) * a);
  if (r < 0) r = 0;
  if (r > 31) r = 31;
  if (g < 0) g = 0;
  if (g > 63) g = 63;
  if (b < 0) b = 0;
  if (b > 31) b = 31;
  return (uint16_t)((r << 11) | (g << 5) | b);
}

