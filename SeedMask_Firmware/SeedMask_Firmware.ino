static void session_login_from_seed(const char seedWords[][16], uint8_t wc, const char* backupCodeOrEmpty) {
  memset(g_seed, 0, sizeof(g_seed));
  g_wc = wc;
  for (int i = 0; i < wc; i++) {
    strncpy(g_seed[i], seedWords[i], 15);
    g_seed[i][15] = 0;
  }
  memset(g_masterSeedSnapshot, 0, sizeof(g_masterSeedSnapshot));
  g_masterSeedSnapshotWc = wc;
  for (int i = 0; i < wc; i++) {
    strncpy(g_masterSeedSnapshot[i], seedWords[i], 15);
    g_masterSeedSnapshot[i][15] = 0;
  }
  memset(g_masterWordIndices, 0, sizeof(g_masterWordIndices));
  g_masterWordIndicesWc = wc;
  {
    char canon[16];
    for (int i = 0; i < wc; i++) {
      int16_t fi = bip39_find_index_ci(g_masterSeedSnapshot[i]);
      if (fi < 0) {
        g_masterWordIndices[i] = 0xFFFF;
        continue;
      }
      g_masterWordIndices[i] = (uint16_t)fi;
      bip39_get_word((uint16_t)fi, canon, sizeof(canon));
      canon[15] = 0;
      strncpy(g_seed[i], canon, 15);
      g_seed[i][15] = 0;
      strncpy(g_masterSeedSnapshot[i], canon, 15);
      g_masterSeedSnapshot[i][15] = 0;
    }
    secure_memzero(canon, sizeof(canon));
  }
  secure_memzero(g_masterBip39SeedBytes, sizeof(g_masterBip39SeedBytes));
  g_masterBip39SeedBytesValid = bip39_derive_seed_bytes_no_passphrase(
    (const char(*)[16])g_masterSeedSnapshot, g_masterSeedSnapshotWc, g_masterBip39SeedBytes);
  if (!g_masterBip39SeedBytesValid) {
    secure_memzero(g_masterBip39SeedBytes, sizeof(g_masterBip39SeedBytes));
  }
  g_loggedIn = true;
  g_vaultQrDirty = true;
  nav_recent_clear();
  // Per-session onboarding hint resets on login
  g_swipeHintSeen = false;
  g_lastUserActivityMs = millis();

  if (backupCodeOrEmpty && backupCodeOrEmpty[0]) {
    strncpy(g_backupCode, backupCodeOrEmpty, sizeof(g_backupCode) - 1);
    g_backupCode[sizeof(g_backupCode) - 1] = 0;
    // Do not set g_viewBackupCode here — only portable_backup_set_from_code() after user create/restore.
  }
  warm_vault_key_cache();
  vault_set_unlocked(true);
  g_addrXfpValid = false;
  g_addrXfpComputeRequested = false;
  invalidate_address_explorer_cache();
  invalidate_bip39_seed_cache();
  g_masterVaultSnapshotValid = false;
  g_masterAccountsSnapshotValid = false;
  passphrase_vault_forget_snapshot();
  // Account list NVS keys are namespaced by master xfp; that is only known after seed is loaded.
  // setup() runs btc_accounts_load_from_prefs() before unlock (wrong keys) — reload now with correct xfp.
  crypto_accounts_load_all();
  multisig_resolve_unknown_wallet_tags();
}

/** Security gate for SD backup-code restore while already logged in:
 * require both mnemonic seed and derived master fingerprint to match active session. */
static bool seed_and_fingerprint_match_active_session(const char seedWords[][16], uint8_t wc) {
  if (!seedWords || wc == 0 || wc > 24) return false;
  if (!g_loggedIn || g_wc == 0) return true;  // no active wallet context yet
  if (wc != g_wc) return false;
  for (uint8_t i = 0; i < wc; i++) {
    int16_t a = bip39_find_index_ci(seedWords[i]);
    int16_t b = bip39_find_index_ci(g_seed[i]);
    if (a < 0 || b < 0 || a != b) return false;
  }
  char restoredXfp[9] = { 0 };
  char activeXfp[9] = { 0 };
  if (!bip39_mnemonic_words_fingerprint(seedWords, wc, restoredXfp) || !restoredXfp[0]) return false;
  if (!current_master_xfp(activeXfp) || !activeXfp[0]) return false;
  if (strcmp(restoredXfp, activeXfp) != 0) return false;
  return true;
}

