      return;
    }
    if (hit(BTN_SCROLL_DOWN, x, y) && g_msSdScrollOffset + SD_FILES_PER_PAGE < g_msSdCount) {
      g_msSdScrollOffset = min(g_msSdCount - SD_FILES_PER_PAGE, g_msSdScrollOffset + SD_FILES_PER_PAGE);
      draw();
      return;
    }
  }
  if (ms_sd_row_is_openable_entry(g_msSdSelectedFile) && hit(BTN_CRYPTO_TX_SD_OK, x, y)) {
    int sel = g_msSdSelectedFile;
    if (sel < 0 || sel >= g_msSdCount) return;
    if (g_msSdIsDir[sel]) {
      char full[192];
      snprintf(full, sizeof(full), "%s/%s", g_msSdCwd, g_msSdNames[sel]);
      if (strlen(full) >= sizeof(g_msSdCwd)) {
        setMsg("Path too long");
        draw();
        return;
      }
      strncpy(g_msSdCwd, full, sizeof(g_msSdCwd) - 1);
      g_msSdCwd[sizeof(g_msSdCwd) - 1] = 0;
      multisig_sd_scan_dir();
      g_msSdScrollOffset = 0;
      setMsg("");
      draw();
      return;
    }
    char full[192];
    snprintf(full, sizeof(full), "%s/%s", g_msSdCwd, g_msSdNames[sel]);
    (void)crypto_load_unsigned_from_sd_path(full);
    if (g_screen == UIScreen::CRYPTO_TX_SD_BROWSE) draw();
    return;
  }
  int startIdx = g_msSdScrollOffset;
  int endIdx = min(startIdx + SD_FILES_PER_PAGE, g_msSdCount);
  int yPos = SD_LIST_TOP;
  for (int i = startIdx; i < endIdx; i++) {
    if (x >= SD_LIST_LEFT && x <= SD_LIST_RIGHT && y >= yPos - 2 && y <= yPos + MULTISIG_SD_LIST_ROW_H) {
      if (strcmp(g_msSdNames[i], "..") == 0) {
        if (multisig_sd_go_parent()) {
          multisig_sd_scan_dir();
          g_msSdScrollOffset = 0;
          setMsg("");
        }
        draw();
        return;
      }
      g_msSdSelectedFile = i;
      draw();
      return;
    }
    yPos += MULTISIG_SD_LIST_ROW_H;
  }
}

static void handleCryptoMultisigSettingsTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_optionsHomeScreen = UIScreen::CRYPTO_MULTISIG_SETTINGS;
    show(UIScreen::BURGER_MENU);
    return;
  }
  if (!vault_is_unlocked() || !g_loggedIn) {
    setMsgTr("Unlock first", "Prvo otkljucajte");
    show(UIScreen::LOCKED);
    return;
  }
  multisig_rebuild_visible_wallets();
  const bool kaspa = crypto_home_asset_is_kaspa();
  const int16_t listTop = kaspa ? 344 : MULTISIG_SETTINGS_LIST_TOP;
  const uint8_t visibleRows = kaspa ? 2 : MULTISIG_SETTINGS_VISIBLE_ROWS;
  if (g_multisigVisibleCount > 0) {
    if (hit(BTN_SCROLL_UP, x, y) && g_multisigSettingsScroll > 0) {
      g_multisigSettingsScroll--;
      draw();
      return;
    }
    if (hit(BTN_SCROLL_DOWN, x, y) && g_multisigSettingsScroll + visibleRows < g_multisigVisibleCount) {
      g_multisigSettingsScroll++;
      draw();
      return;
    }
    for (uint8_t vis = 0; vis < visibleRows; vis++) {
      uint8_t vi = g_multisigSettingsScroll + vis;
      if (vi >= g_multisigVisibleCount) break;
      uint8_t idx = g_multisigVisibleIdx[vi];
      Rect r = { 10, (int16_t)(listTop + (int16_t)vis * MULTISIG_SETTINGS_ROW_H), 300, MULTISIG_SETTINGS_ROW_H };
      if (hit(r, x, y)) {
        g_multisigSelectedIdx = idx;
        show(UIScreen::CRYPTO_MULTISIG_WALLET);
        return;
      }
    }
  }
  if (hit(BTN_MULTISIG_IMPORT_ENTRY, x, y)) {
    show(UIScreen::CRYPTO_MULTISIG_IMPORT);
    return;
  }
  if (hit(BTN_MULTISIG_RECEIVE_ENTRY, x, y)) {
    setMsg("");
    multisig_start_receive_flow();
    return;
  }
  if (kaspa && hit(BTN_MULTISIG_POLICY_ENTRY, x, y)) {
    show(UIScreen::CRYPTO_MULTISIG_POLICY);
    return;
  }
}

static void multisig_start_receive_flow() {
  multisig_rebuild_visible_wallets();
  if (g_multisigVisibleCount == 0) {
