static bool kaspa_json_extract_object_after_key_inplace(char* json, size_t* inoutLen, size_t cap, const char* key) {
  if (!json || !key || !inoutLen || *inoutLen == 0 || *inoutLen >= cap) return false;
  char pat[32];
  snprintf(pat, sizeof(pat), "\"%s\"", key);
  const char* hit = strstr(json, pat);
  if (!hit) return false;
  const char* colon = strchr(hit + strlen(pat), ':');
  if (!colon) return false;
  const char* start = colon + 1;
  while (*start == ' ' || *start == '\t' || *start == '\r' || *start == '\n') start++;
  if (*start != '{') return false;
  int depth = 0;
  bool inStr = false;
  const char* end = start;
  for (; *end; end++) {
    char c = *end;
    if (inStr) {
      if (c == '\\' && end[1]) {
        end++;
        continue;
      }
      if (c == '"') inStr = false;
      continue;
    }
    if (c == '"') {
      inStr = true;
      continue;
    }
    if (c == '{') depth++;
    else if (c == '}') {
      depth--;
      if (depth == 0) {
        end++;
        break;
      }
    }
  }
  if (depth != 0) return false;
  size_t len = (size_t)(end - start);
  if (len == 0 || len >= cap) return false;
  memmove(json, start, len);
  json[len] = 0;
  *inoutLen = len;
  return true;
}

