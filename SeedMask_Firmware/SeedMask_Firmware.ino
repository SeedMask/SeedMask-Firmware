    const uint16_t borderInner = blendRGB565(gTop, RGB565_WHITE, 0.26f);
    gfx->drawRoundRect(x + 1, y + 1, sq - 2, sq - 2, radIn, borderInner);
  }
}

// Rounded-rect overlay: blend each pixel toward tint565 (mixTowardTint 0.5 ≈ password popup 50/50 F7DE average).
static void fillRoundRectFramebufferBlend(int x, int y, int w, int h, int rad, uint16_t tint565, float mixTowardTint) {
  if (w <= 0 || h <= 0 || !gfx) return;
  if (mixTowardTint < 0.f) mixTowardTint = 0.f;
  if (mixTowardTint > 1.f) mixTowardTint = 1.f;
  uint16_t* fb = gfx->getFramebuffer();
  if (!fb) {
    uint16_t solid = blendRGB565(RGB565_BLACK, tint565, mixTowardTint);
    gfx->fillRoundRect(x, y, w, h, rad, solid);
    return;
  }
  int rEff = rad;
  if (rEff > w / 2) rEff = w / 2;
  if (rEff > h / 2) rEff = h / 2;
  if (rEff < 0) rEff = 0;
  const float rr = (float)(rEff * rEff);
  const bool fastHalf = (mixTowardTint >= 0.498f && mixTowardTint <= 0.502f);
  const uint16_t tHalf = (uint16_t)((tint565 & 0xF7DE) >> 1);
  for (int yy = 0; yy < h; yy++) {
    int py = y + yy;
    int x1 = x;
    int x2 = x + w - 1;
    if (rEff > 0) {
      if (yy < rEff) {
        float dyCircle = (float)((y + rEff) - py);
        float inner = rr - dyCircle * dyCircle;
        if (inner < 0.f) inner = 0.f;
        float f = sqrtf(inner);
        x1 = (int)(x + rEff - f + 0.5f);
        x2 = (int)(x + w - rEff + f - 0.5f);
      } else if (yy >= h - rEff) {
        float dyCircle = (float)(py - (y + h - rEff));
        float inner = rr - dyCircle * dyCircle;
        if (inner < 0.f) inner = 0.f;
        float f = sqrtf(inner);
        x1 = (int)(x + rEff - f + 0.5f);
        x2 = (int)(x + w - rEff + f - 0.5f);
      }
    }
    if (x1 > x2) continue;
    for (int px = x1; px <= x2; px++) {
      size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
      uint16_t bg = fb[idx];
      if (fastHalf)
        fb[idx] = (uint16_t)(((bg & 0xF7DE) >> 1) + tHalf);
      else
        fb[idx] = blendRGB565(bg, tint565, mixTowardTint);
    }
  }
}

