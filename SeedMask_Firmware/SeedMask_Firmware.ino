// Refresh g_backupCode from NVS seed blob (long SPB1). Used so Passwords→BACKUP matches post-unlock encoding, not the short XOR paper line.
static bool refresh_g_backup_code_from_nvs_vault_blob() {
  uint8_t* vb = nullptr;
  size_t vl = 0;
  if (!nvs_load_vault(&vb, vl)) return false;
  bool ok = vault_blob_to_code_string(vb, vl, g_backupCode, sizeof(g_backupCode));
  secure_memzero(vb, vl);
  free(vb);
  return ok;
}
