  drawTopBar("BIP85 words", true);
  const int cx = 10;
  const int cw = 300;
  const int pathY = 50;
  const int pathH = 46;
  const int gap = 8;
  const int idxY = pathY + pathH + gap;
  const int idxH = 36;
  const int fpY = idxY + idxH + gap;
  const int fpH = 36;

  gfx->fillRoundRect(cx, pathY, cw, pathH, 10, UI_CARD);
  gfx->drawRoundRect(cx, pathY, cw, pathH, 10, accent);
  gfx->setTextColor(RGB565_LIGHTGREY);
  gfx->setTextSize(2);
  gfx->setCursor(cx + 10, pathY + 8);
  gfx->print("m/83696968'/39'/0'/");
  gfx->setCursor(cx + 10, pathY + 8 + 18);
  {
    char pathTail[32];
    snprintf(pathTail, sizeof(pathTail), "%u'/%lu'",
             (unsigned)(g_bip85WordCount == 12 ? 12u : 24u), (unsigned long)g_bip85LastIndex);
