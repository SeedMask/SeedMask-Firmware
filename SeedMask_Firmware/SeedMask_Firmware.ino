static bool duress_try_match_unlock_type(const char* cred, bool credIsPin, DuressBehavior* outType) {
  if (!cred || !cred[0] || !outType) return false;
  if (g_duressSlotDecoy.active && duress_type_cred_matches(cred, credIsPin, DuressBehavior::DECOY_VAULT)) {
    *outType = DuressBehavior::DECOY_VAULT;
    return true;
  }
  if (g_duressSlotGames.active && duress_type_cred_matches(cred, credIsPin, DuressBehavior::GAMES)) {
    *outType = DuressBehavior::GAMES;
    return true;
  }
  if (g_duressSlotEmpty.active && duress_type_cred_matches(cred, credIsPin, DuressBehavior::EMPTY_VAULT)) {
    *outType = DuressBehavior::EMPTY_VAULT;
    return true;
  }
  return false;
}

