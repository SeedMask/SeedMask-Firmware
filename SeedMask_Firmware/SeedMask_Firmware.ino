static void handleAddressExplorerTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_addrShowDetail = false;
    g_addrDetail[0] = 0;
    g_addrExplorerFromBitcoin = false;
    g_addrExplorerMultisig = false;
    g_addrQrFromStatusUsed = false;
    g_addrQrConfirmMarkUnused = false;
    g_addrQrFromMultisigReceive = false;
    show(UIScreen::MENU);
    return;
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    const int16_t padHit = 4;
    const Rect rAddrInfo = {
      (int16_t)(infoCx - infoHalf - padHit), (int16_t)(infoCy - infoHalf - padHit),
      (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHit), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHit)
    };
    if (hit(rAddrInfo, x, y)) {
      g_addressInfoReturnScreen = UIScreen::ADDRESS_EXPLORER;
      flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
      delay(85);
      show(UIScreen::ADDRESS_EXPLORER_INFO);
      return;
    }
  }
  if (!vault_is_unlocked()) {
    return;
  }

  if (g_addrExplorerStep == AddrExplorerStep::PICK_TYPE) {
    if (hit(BTN_ADDR_PICK_NATIVE, x, y)) {
      flashKeyRect(BTN_ADDR_PICK_NATIVE);
      delay(85);
      g_addrType = AddrType::P2WPKH;
      g_addrExplorerStep = AddrExplorerStep::PICK_CHAIN;
      draw();
      return;
    }
    if (hit(BTN_ADDR_PICK_NESTED, x, y)) {
      flashKeyRect(BTN_ADDR_PICK_NESTED);
      delay(85);
      g_addrType = AddrType::P2SH_P2WPKH;
      g_addrExplorerStep = AddrExplorerStep::PICK_CHAIN;
      draw();
      return;
    }
    if (hit(BTN_ADDR_PICK_LEGACY, x, y)) {
      flashKeyRect(BTN_ADDR_PICK_LEGACY);
      delay(85);
      g_addrType = AddrType::P2PKH;
      g_addrExplorerStep = AddrExplorerStep::PICK_CHAIN;
      draw();
      return;
    }
    if (hit(BTN_ADDR_PICK_TAPROOT, x, y)) {
      flashKeyRect(BTN_ADDR_PICK_TAPROOT);
      delay(85);
      g_addrType = AddrType::P2TR;
      g_addrExplorerStep = AddrExplorerStep::PICK_CHAIN;
      draw();
      return;
    }
    return;
  }

  if (g_addrExplorerStep == AddrExplorerStep::PICK_CHAIN) {
    if (hit(BTN_ADDR_PICK_RECV, x, y)) {
      flashKeyRectTranslucent(BTN_ADDR_PICK_RECV);
      g_addrChain = 0;
      g_addrPage = 0;
      g_addrShowDetail = false;
      invalidate_address_explorer_cache();
      if (!ensure_address_page_cache() || !g_addrPageOk[0]) {
        g_addrDetail[0] = 0;
        setMsg(g_addrLastErr[0] ? g_addrLastErr : "Address derivation failed");
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      strncpy(g_addrDetail, g_addrPageAddr[0], sizeof(g_addrDetail) - 1);
      g_addrDetail[sizeof(g_addrDetail) - 1] = 0;
      g_addrQrIndex = 0;
      g_addrExplorerStep = AddrExplorerStep::LIST;
      g_addrQrFromExplorerList = false;
      g_addrQrFromStatusUsed = false;
      g_addrQrConfirmMarkUnused = false;
      show(UIScreen::ADDRESS_QR);
      return;
    }
    if (hit(BTN_ADDR_PICK_CHANGE, x, y)) {
      flashKeyRectTranslucent(BTN_ADDR_PICK_CHANGE);
      g_addrChain = 1;
      g_addrPage = 0;
      g_addrShowDetail = false;
      invalidate_address_explorer_cache();
      if (!ensure_address_page_cache() || !g_addrPageOk[0]) {
        g_addrDetail[0] = 0;
        setMsg(g_addrLastErr[0] ? g_addrLastErr : "Address derivation failed");
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      strncpy(g_addrDetail, g_addrPageAddr[0], sizeof(g_addrDetail) - 1);
      g_addrDetail[sizeof(g_addrDetail) - 1] = 0;
      g_addrQrIndex = 0;
      g_addrExplorerStep = AddrExplorerStep::LIST;
      g_addrQrFromExplorerList = false;
      g_addrQrFromStatusUsed = false;
      g_addrQrConfirmMarkUnused = false;
      show(UIScreen::ADDRESS_QR);
      return;
    }
    return;
  }

  // LIST (account is chosen in Crypto settings / New account — not cycled here)
  if (hit(BTN_ADDR_STATUS, x, y)) {
    g_addrStatusUsedPage = 0;
    setMsg("");
    show(UIScreen::ADDRESS_STATUS_USED);
    return;
  }
  if (hit(addrExplorerListGotoEnvelopeRect(), x, y)) {
    g_addrGotoIndexBuf[0] = 0;
    setMsg("");
    show(UIScreen::ADDRESS_EXPLORER_INDEX);
    return;
  }
  if (hit(BTN_ADDR_PREV, x, y)) {
    flashKeyRectTranslucent(BTN_ADDR_PREV);
    g_addrShowDetail = false;
    if (g_addrPage > 0) {
      uint32_t newPage = g_addrPage - 1;
      if (g_addrPrefetchPrevPage == newPage) {
        for (uint8_t i = 0; i < ADDR_PAGE_ROWS; i++) {
          memcpy(g_addrPageAddr[i], g_addrPrefetchPrevAddrs[i], sizeof(g_addrPageAddr[i]));
          g_addrPageOk[i] = g_addrPrefetchPrevOk[i];
        }
        g_addrPage = newPage;
        g_addrCacheType = g_addrType;
        g_addrCacheAccount = g_addrAccount;
        g_addrCacheChain = g_addrChain;
        g_addrCachePage = newPage;
        g_addrCacheValid = true;
        prefetch_address_explorer_neighbors(newPage);
      } else {
        g_addrPage = newPage;
        invalidate_address_explorer_cache();
      }
    }
    draw();
    return;
  }
  if (hit(BTN_ADDR_NEXT, x, y)) {
    flashKeyRectTranslucent(BTN_ADDR_NEXT);
    g_addrShowDetail = false;
    uint32_t maxPage = ADDR_MAX_INDEX / (uint32_t)ADDR_PAGE_ROWS;
    if (g_addrPage < maxPage) {
      uint32_t newPage = g_addrPage + 1;
      if (g_addrPrefetchNextPage == newPage) {
        for (uint8_t i = 0; i < ADDR_PAGE_ROWS; i++) {
          memcpy(g_addrPageAddr[i], g_addrPrefetchNextAddrs[i], sizeof(g_addrPageAddr[i]));
          g_addrPageOk[i] = g_addrPrefetchNextOk[i];
        }
        g_addrPage = newPage;
        g_addrCacheType = g_addrType;
        g_addrCacheAccount = g_addrAccount;
        g_addrCacheChain = g_addrChain;
        g_addrCachePage = newPage;
        g_addrCacheValid = true;
        prefetch_address_explorer_neighbors(newPage);
      } else {
        g_addrPage = newPage;
        invalidate_address_explorer_cache();
      }
    }
    draw();
    return;
  }
  uint32_t start = g_addrPage * (uint32_t)ADDR_PAGE_ROWS;
  ensure_address_page_cache();
  for (uint8_t r = 0; r < ADDR_PAGE_ROWS; r++) {
    Rect rr = addrRowRect(r);
    if (!hit(rr, x, y)) continue;
    uint32_t idx = start + (uint32_t)r;
    if (idx > ADDR_MAX_INDEX) return;
    if (g_addrPageOk[r]) {
      strncpy(g_addrDetail, g_addrPageAddr[r], sizeof(g_addrDetail) - 1);
      g_addrDetail[sizeof(g_addrDetail) - 1] = 0;
      g_addrQrIndex = idx;
      g_addrShowDetail = false;
      g_addrQrFromExplorerList = true;
      g_addrQrFromStatusUsed = false;
      g_addrQrConfirmMarkUnused = false;
      show(UIScreen::ADDRESS_QR);
    } else {
      g_addrShowDetail = false;
      setMsg("Address derivation failed");
      show(UIScreen::ERROR_SCREEN);
      return;
    }
    return;
  }
}

static void handleCryptoHomeTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_optionsHomeScreen = UIScreen::CRYPTO_HOME;
    show(UIScreen::BURGER_MENU);
    return;
  }
  if (sd_presence_for_ui() && hit(BTN_TOPBAR_SD, x, y)) {
    show(UIScreen::SD_BROWSER);
    return;
  }
  if (hit(BTN_CRYPTO_TO_MENU_TOGGLE, x, y)) {
    startCryptoModeToggleAnim(UIScreen::MENU, false);
    return;
  }
  if (!vault_is_unlocked() || !g_loggedIn) {
    setMsgTr("Unlock first", "Prvo otkljucajte");
    show(UIScreen::LOCKED);
    return;
  }
  const Rect popup = g_cryptoAccountDetailsOpen
                       ? Rect{ 118, 78, 190, 136 }
                       : Rect{ 162, 86, 146, 112 };
  const Rect popDetails = { (int16_t)(popup.x + 10), (int16_t)(popup.y + 8), (int16_t)(popup.w - 20), 30 };
  const Rect popRename = { (int16_t)(popup.x + 10), (int16_t)(popup.y + 41), (int16_t)(popup.w - 20), 30 };
  const Rect popDelete = { (int16_t)(popup.x + 10), (int16_t)(popup.y + 74), (int16_t)(popup.w - 20), 30 };
  const Rect popClose = { (int16_t)(popup.x + 10), (int16_t)(popup.y + 100), (int16_t)(popup.w - 20), 28 };
  if (g_cryptoAccountDetailsOpen) {
    if (hit(popClose, x, y) || !hit(popup, x, y)) {
      g_cryptoAccountDetailsOpen = false;
      g_cryptoAccountMenuOpen = false;
      draw();
      return;
    }
    return;
  }
  if (g_cryptoAccountMenuOpen) {
    if (hit(popDetails, x, y)) {
      g_cryptoAccountDetailsOpen = true;
      draw();
      return;
    }
    if (hit(popRename, x, y)) {
      g_newAccountPending = g_addrAccount;
      strncpy(g_newAccountNameBuf, crypto_account_name_for(g_addrAccount), sizeof(g_newAccountNameBuf) - 1);
      g_newAccountNameBuf[sizeof(g_newAccountNameBuf) - 1] = 0;
      g_accountNameEditIsRename = true;
      g_cryptoAccountMenuOpen = false;
      show(UIScreen::CRYPTO_NEW_ACCOUNT_NAME);
      return;
    }
    if (hit(popDelete, x, y)) {
      if (crypto_accounts_remove(g_addrAccount)) {
        invalidate_address_explorer_cache();
      } else {
        setMsg(g_addrAccount == 0 ? "Default account can't be deleted" : "Unable to delete account");
      }
      g_cryptoAccountMenuOpen = false;
      g_cryptoAccountDetailsOpen = false;
      draw();
      return;
    }
    if (!hit(popup, x, y)) {
      g_cryptoAccountMenuOpen = false;
      draw();
      return;
    }
    return;
  }
  if (hit(BTN_CRYPTO_ACCOUNT_MENU, x, y)) {
    g_cryptoAccountMenuOpen = true;
    g_cryptoAccountDetailsOpen = false;
    draw();
    return;
  }
  if (tryHitUnifiedCryptoDots(x, y)) return;
  if (hitCryptoAssetBadge((int16_t)x, (int16_t)y)) {
    crypto_accounts_capture_active_addr();
    g_cryptoHomeAsset = crypto_home_asset_is_kaspa() ? CryptoHomeAsset::Bitcoin : CryptoHomeAsset::Kaspa;
    crypto_accounts_sync_runtime_addr();
    invalidate_address_explorer_cache();
    invalidate_address_explorer_chain_node();
    draw();
    return;
  }
  const bool kaspa = crypto_home_asset_is_kaspa();
  for (uint8_t i = 0; i < 6; i++) {
    if (!hit(btcCryptoCardRect(i), x, y)) continue;
    if (cryptoHomeTopCardStealsLogoTap(i, (int16_t)x, (int16_t)y)) continue;
    flashMainMenuDarkCard(btcCryptoCardRect(i));
    if (kaspa) {
      if (i == 0) {
        setMsg("");
        show(UIScreen::CRYPTO_SIGN_SOURCE);
        return;
      }
      if (i == 1) {
        g_addrExplorerFromBitcoin = true;
        g_addrExplorerKaspa = true;
        g_addrExplorerMultisig = false;
        g_addrPage = 0;
        g_addrChain = 0;
        g_addrExplorerStep = AddrExplorerStep::LIST;
        g_addrShowDetail = false;
        g_addrDetail[0] = 0;
        invalidate_address_explorer_cache();
        if (!ensure_address_page_cache() || !g_addrPageOk[0]) {
          setMsg(g_addrLastErr[0] ? g_addrLastErr : "Kaspa address failed");
          show(UIScreen::ERROR_SCREEN);
          return;
        }
        strncpy(g_addrDetail, g_addrPageAddr[0], sizeof(g_addrDetail) - 1);
        g_addrDetail[sizeof(g_addrDetail) - 1] = 0;
        g_addrQrIndex = 0;
        g_addrQrFromExplorerList = false;
        show(UIScreen::ADDRESS_QR);
        return;
      }
      if (i == 2) {
        show(UIScreen::CRYPTO_XPUB_MODE);
        return;
      }
      if (i == 3) {
        show(UIScreen::CRYPTO_CONNECT_SOFTWARE);
        return;
      }
      if (i == 4) {
        show(UIScreen::CRYPTO_TOOLS_MENU);
        return;
      }
      if (i == 5) {
        show(UIScreen::CRYPTO_MULTISIG_SETTINGS);
        return;
      }
      setMsg("Coming soon");
      draw();
      return;
    }
    if (i == 0) {
      setMsg("");
      show(UIScreen::CRYPTO_SIGN_SOURCE);
      return;
    }
    if (i == 1) {
      g_addrExplorerFromBitcoin = true;
      g_addrExplorerMultisig = false;
      g_addrPage = 0;
      g_addrChain = 0;
      g_addrType = AddrType::P2WPKH;
      g_addrExplorerStep = AddrExplorerStep::PICK_TYPE;
      g_addrShowDetail = false;
      g_addrDetail[0] = 0;
      invalidate_address_explorer_cache();
      show(UIScreen::ADDRESS_EXPLORER);
      return;
    }
    if (i == 2) {
      show(UIScreen::CRYPTO_XPUB_MODE);
      return;
    }
    if (i == 3) {
      show(UIScreen::CRYPTO_CONNECT_SOFTWARE);
      return;
    }
    if (i == 4) {
      show(UIScreen::CRYPTO_TOOLS_MENU);
      return;
    }
    if (i == 5) {
      show(UIScreen::CRYPTO_MULTISIG_SETTINGS);
      return;
    }
    return;
  }
}

