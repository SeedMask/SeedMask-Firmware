static const Rect BTN_CRYPTO_VERIFY_PICK_SINGLESIG = { 10, 118, 300, 52 };
static const Rect BTN_CRYPTO_VERIFY_PICK_MULTISIG = { 10, 182, 300, 52 };

enum class ToolsVerifyMode : uint8_t { None = 0,
                                       Singlesig,
                                       Multisig };
static ToolsVerifyMode g_toolsVerifyMode = ToolsVerifyMode::None;
static uint8_t g_toolsVerifyMsPickStoredIdx = 0;
static uint8_t g_toolsVerifyMsListScroll = 0;
// Set in tools_begin_verify_scan when camera opens; QR decode uses this (same path for 1-of-1 MS or list pick).
static bool g_toolsVerifyScanIsMultisig = false;
static uint8_t g_toolsVerifyScanMsStoredIdx = 0;
static bool g_toolsVerifyDecodeMsLatched = false;  // true = search this stored multisig wallet; set only in tools_begin_verify_scan
static uint8_t g_toolsVerifyDecodeMsIdx = 0;
// When true, tools_verify_search_chunk runs tools_verify_ms_only_search_chunk (no interleaved singlesig / stale SgEx).
static bool g_toolsVerifyRunMsSearchOnly = false;
static const Rect BTN_TOOLS_SIGN_CONFIRM = { 10, 300, 300, 44 };

// "bc" mainnet or "tb" testnet (from first chars of a scanned bech32 address). Default mainnet.
static const char* tools_verify_segwit_hrp(const char* want) {
  if (!want || !want[0]) return "bc";
  char a = (char)tolower((unsigned char)want[0]);
  char b = want[1] ? (char)tolower((unsigned char)want[1]) : 0;
  char c = want[2] ? want[2] : 0;
  if (a == 't' && b == 'b' && c == '1') return "tb";
  return "bc";
}

static bool tools_addresses_equal(const char* a, const char* b) {
  if (!a || !b) return false;
  auto isbc1 = [](const char* s) {
    return (s[0] == 'b' || s[0] == 'B') && (s[1] == 'c' || s[1] == 'C') && s[2] == '1';
  };
  if (isbc1(a) && isbc1(b)) {
    for (size_t i = 0;; i++) {
      unsigned char ca = (unsigned char)a[i], cb = (unsigned char)b[i];
      if (ca >= 'A' && ca <= 'Z') ca = (unsigned char)(ca - 'A' + 'a');
      if (cb >= 'A' && cb <= 'Z') cb = (unsigned char)(cb - 'A' + 'a');
      if (ca != cb) return false;
      if (ca == 0) return true;
    }
  }
  return strcmp(a, b) == 0;
}

static void tools_extract_payment_address(const char* p, char* out, size_t cap) {
  if (!out || cap < 2) return;
  out[0] = 0;
  if (!p) return;
  while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
  {
    const char* k = "bitcoin:";
    bool isUri = true;
    for (int i = 0; i < 8 && isUri; i++) {
      char c = p[i];
      if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
      if (c != k[i]) isUri = false;
    }
    if (isUri) {
      const char* s = p + 8;
      const char* q = strchr(s, '?');
      size_t n = q ? (size_t)(q - s) : strlen(s);
      if (n >= cap) n = cap - 1;
      memcpy(out, s, n);
      out[n] = 0;
      return;
    }
  }
  strncpy(out, p, cap - 1);
  out[cap - 1] = 0;
}

// If QR is JSON, wrapped text, or misparsed, pull the first bc1... / tb1... segment from the raw string.
static bool tools_verify_bech32_from_raw(const char* raw, char* out, size_t cap) {
  if (!raw || !out || cap < 8) return false;
  out[0] = 0;
  for (const char* p = raw; *p; p++) {
    bool isBc1 = (p[0] == 'b' || p[0] == 'B') && (p[1] == 'c' || p[1] == 'C') && p[2] == '1';
    bool isTb1 = (p[0] == 't' || p[0] == 'T') && (p[1] == 'b' || p[1] == 'B') && p[2] == '1';
    if (!isBc1 && !isTb1) continue;
    size_t n = 0;
    for (const char* s = p; s[0] && n + 1 < cap; s++) {
      char c = s[0];
      if (c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '"' || c == '\\' || c == ',' || c == '}' || c == ']' || c == '{' || c == '?' || c == '#' || c == '&' || c == ')' || c == '>')
        break;
      out[n++] = c;
    }
    out[n] = 0;
    if (n >= 14) return true;
  }
  return false;
}

// Multisig verify only: no interleaving with singlesig (avoids any stale g_toolsVerifySgExhausted path).
static bool tools_verify_ms_only_search_chunk(uint32_t maxIter) {
  const uint32_t kMaxIdx = 500u;
  char got[88];
  uint32_t n = 0;
  if (!g_multisigWalletPayloads || g_toolsVerifyMsCandCount == 0u) {
    g_toolsVerifyFound = false;
    g_toolsVerifySearchActive = false;
    return true;
  }
  if (g_toolsVerifyMsExhausted) {
    g_toolsVerifyFound = false;
    g_toolsVerifySearchActive = false;
    return true;
  }
  while (n < maxIter && g_toolsVerifySearchActive) {
    if (g_toolsVerifySearchMsVis < g_toolsVerifyMsCandCount) {
      uint8_t storeIdx = g_toolsVerifyMsCands[g_toolsVerifySearchMsVis];
      if (multisig_wallet_deposit_address(g_multisigWalletPayloads[storeIdx], g_toolsVerifyMsChain, g_toolsVerifyMsIdx, got,
                                          sizeof(got), tools_verify_segwit_hrp(g_toolsVerifyWant))) {
        if (tools_addresses_equal(g_toolsVerifyWant, got)) {
          g_toolsVerifyFound = true;
          g_toolsVerifyIsMultisig = true;
          g_toolsVerifyIdx = g_toolsVerifyMsIdx;
          g_toolsVerifyChain = g_toolsVerifyMsChain;
          g_toolsVerifyMsMatchStoredIdx = storeIdx;
          g_toolsVerifySearchActive = false;
          return true;
        }
      }
      g_toolsVerifyMsIdx++;
      if (g_toolsVerifyMsIdx >= kMaxIdx) {
        g_toolsVerifyMsIdx = 0;
        g_toolsVerifyMsChain++;
        if (g_toolsVerifyMsChain > 1u) {
          g_toolsVerifyMsChain = 0;
          g_toolsVerifySearchMsVis++;
          if (g_toolsVerifySearchMsVis >= g_toolsVerifyMsCandCount) g_toolsVerifyMsExhausted = true;
        }
      }
    } else {
      g_toolsVerifyMsExhausted = true;
    }
    n++;
    if ((n & 31u) == 0u) yield();
    if (g_toolsVerifySearchActive && g_toolsVerifyMsExhausted) {
      g_toolsVerifyFound = false;
      g_toolsVerifySearchActive = false;
      return true;
    }
  }
  if (g_toolsVerifySearchActive && g_toolsVerifyMsExhausted) {
    g_toolsVerifyFound = false;
    g_toolsVerifySearchActive = false;
  }
  return !g_toolsVerifySearchActive;
}

// Returns true when search finished (match or exhausted). Updates g_toolsVerify* / g_toolsVerifySearchActive.
// Each chunk runs up to maxIter derivation steps—singlesig and multisig are interleaved (singlesig first) so
// a singlesig or early multisig match does not wait for the other class to run to completion.
static bool tools_verify_search_chunk(uint32_t maxIter) {
  if (g_toolsVerifyRunMsSearchOnly) return tools_verify_ms_only_search_chunk(maxIter);
  static const AddrType kTypes[4] = { AddrType::P2WPKH, AddrType::P2SH_P2WPKH, AddrType::P2PKH, AddrType::P2TR };
  const uint32_t kMaxIdx = 500u;
  const bool haveMs = g_multisigWalletPayloads && (g_toolsVerifyMsCandCount > 0u);
  char got[88];
  uint32_t n = 0;
  if (g_toolsVerifySgExhausted && g_toolsVerifyMsExhausted) {
    g_toolsVerifyFound = false;
    g_toolsVerifySearchActive = false;
    return true;
  }
  while (n < maxIter && g_toolsVerifySearchActive) {
    if (!g_toolsVerifySgExhausted) {
      AddrType t = kTypes[g_toolsVerifySgTi];
      if (btc_address_for_index(t, g_addrAccount, g_toolsVerifySgChain, g_toolsVerifySgIdx, got, sizeof(got))) {
        if (tools_addresses_equal(g_toolsVerifyWant, got)) {
          g_toolsVerifyFound = true;
          g_toolsVerifyIsMultisig = false;
          g_toolsVerifyIdx = g_toolsVerifySgIdx;
          g_toolsVerifyAddrType = t;
          g_toolsVerifyChain = g_toolsVerifySgChain;
          g_toolsVerifySearchActive = false;
          return true;
        }
      }
      g_toolsVerifySgIdx++;
      if (g_toolsVerifySgIdx >= kMaxIdx) {
        g_toolsVerifySgIdx = 0;
        g_toolsVerifySgTi++;
        if (g_toolsVerifySgTi >= 4) {
          g_toolsVerifySgTi = 0;
          g_toolsVerifySgChain++;
          if (g_toolsVerifySgChain > 1u) {
            g_toolsVerifySgExhausted = true;
            g_toolsVerifySgChain = 0;
            g_toolsVerifySgIdx = 0;
            g_toolsVerifySgTi = 0;
          }
        }
      }
      n++;
    }
    if (g_toolsVerifySearchActive && g_toolsVerifySgExhausted && g_toolsVerifyMsExhausted) {
      g_toolsVerifyFound = false;
      g_toolsVerifySearchActive = false;
      return true;
    }
    if (n >= maxIter) break;
    if (haveMs && !g_toolsVerifyMsExhausted) {
      if (g_toolsVerifySearchMsVis < g_toolsVerifyMsCandCount) {
        uint8_t storeIdx = g_toolsVerifyMsCands[g_toolsVerifySearchMsVis];
        if (multisig_wallet_deposit_address(g_multisigWalletPayloads[storeIdx], g_toolsVerifyMsChain, g_toolsVerifyMsIdx, got,
                                            sizeof(got), tools_verify_segwit_hrp(g_toolsVerifyWant))) {
          if (tools_addresses_equal(g_toolsVerifyWant, got)) {
            g_toolsVerifyFound = true;
            g_toolsVerifyIsMultisig = true;
            g_toolsVerifyIdx = g_toolsVerifyMsIdx;
            g_toolsVerifyChain = g_toolsVerifyMsChain;
            g_toolsVerifyMsMatchStoredIdx = storeIdx;
            g_toolsVerifySearchActive = false;
            return true;
          }
        }
        g_toolsVerifyMsIdx++;
        if (g_toolsVerifyMsIdx >= kMaxIdx) {
          g_toolsVerifyMsIdx = 0;
          g_toolsVerifyMsChain++;
          if (g_toolsVerifyMsChain > 1u) {
            g_toolsVerifyMsChain = 0;
            g_toolsVerifySearchMsVis++;
            if (g_toolsVerifySearchMsVis >= g_toolsVerifyMsCandCount) g_toolsVerifyMsExhausted = true;
          }
        }
      } else {
        g_toolsVerifyMsExhausted = true;
      }
      n++;
    }
    if (g_toolsVerifySearchActive && g_toolsVerifySgExhausted && g_toolsVerifyMsExhausted) {
      g_toolsVerifyFound = false;
      g_toolsVerifySearchActive = false;
      return true;
    }
    if ((n & 31u) == 0u) yield();
  }
  if (g_toolsVerifySearchActive && g_toolsVerifySgExhausted && g_toolsVerifyMsExhausted) {
    g_toolsVerifyFound = false;
    g_toolsVerifySearchActive = false;
  }
  return !g_toolsVerifySearchActive;
}

