static char g_cryptoXpubBuf[120] = { 0 };
static char g_cryptoXpubQrPayload[256] = { 0 };

static void crypto_xpub_clear_bufs(void) {
  secure_memzero(g_cryptoXpubBuf, sizeof(g_cryptoXpubBuf));
