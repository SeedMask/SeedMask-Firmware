  if (g_busy) {
    gfx->setTextSize(2);
    gfx->setCursor(10, 120);
    gfx->print("Please wait ");
    const char* f[4] = { "|", "/", "-", "\\" };
    gfx->print(f[g_spin & 3]);
  }

  drawKeyboard();

  // No BACK button; use swipe or on-screen navigation to leave
  ui_flush();
}

