// Wipe dialog info icons: RGB565 in wipe_info_icon_rgb565.h (same class as bitcoin_logo_rgb565.h).
// (cx, cy) = center. large = upper-right tap target; small = inline next to hint text.
// ox/oy shift the bitmap. pulseMul in [0,1]: blend icon from UI_CARD toward bitmap (same as t in blendRGB565).
// Always apply blend when pulseMul is passed — never skip via a 0.999 threshold (that toggled raw vs blended near
// the sine peak and flickered dark fringe pixels frame-to-frame). t=1.0 is identical to raw pixels.
static void drawWipeInfoBitmapAt(int16_t cx, int16_t cy, bool large, int16_t ox, int16_t oy, float pulseMul) {
  const int16_t w = large ? (int16_t)WIPE_INFO_ICON_LARGE_RGB565_W : (int16_t)WIPE_INFO_ICON_SMALL_RGB565_W;
  const int16_t h = large ? (int16_t)WIPE_INFO_ICON_LARGE_RGB565_H : (int16_t)WIPE_INFO_ICON_SMALL_RGB565_H;
  const uint16_t* bmp = large ? WIPE_INFO_ICON_LARGE_RGB565 : WIPE_INFO_ICON_SMALL_RGB565;
  const int16_t x0 = (int16_t)(cx - w / 2 + ox);
  const int16_t y0 = (int16_t)(cy - h / 2 + oy);
  float t = pulseMul;
  if (t < 0.f) t = 0.f;
  if (t > 1.f) t = 1.f;
  for (int16_t py = 0; py < h; py++) {
    for (int16_t px = 0; px < w; px++) {
      uint16_t c = pgm_read_word(&bmp[(size_t)py * (size_t)w + (size_t)px]);
      if (c == WIPE_INFO_ICON_CHROMA_KEY) continue;
      c = blendRGB565(UI_CARD, c, t);
      gfx->drawPixel((int16_t)(x0 + px), (int16_t)(y0 + py), c);
    }
  }
}

