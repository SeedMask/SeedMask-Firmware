static void drawPwCredentialAvatarForIndex(uint8_t idx, int x, int y, int size) {
  if (idx >= pwSvc_getCount()) return;
  char name[sizeof(PwItem::title)];
  char user[64];
  char website[64], notes[96];
  splitPasswordTitleMeta(pwSvc_getTitleCStr(idx), name, sizeof(name), user, sizeof(user), website, sizeof(website), notes, sizeof(notes));
  const char* titleTxt = name[0] ? name : (user[0] ? user : pwSvc_getTitleCStr(idx));
  if (pwEntryIsGoogleBrand(titleTxt, website)) {
    drawGoogleAvatarG(x, y, size);
  } else if (pwEntryIsFacebookBrand(titleTxt, website)) {
    drawFacebookBrandAvatar(x, y, size);
  } else if (pwEntryIsGithubBrand(titleTxt, website)) {
    drawGithubBrandAvatar(x, y, size);
  } else if (pwEntryIsLinkedinBrand(titleTxt, website)) {
    drawLinkedinBrandAvatar(x, y, size);
  } else if (pwEntryIsInstagramBrand(titleTxt, website)) {
    drawInstagramBrandAvatar(x, y, size);
  } else if (pwEntryIsTwitterXBrand(titleTxt, website)) {
    drawTwitterXBrandAvatar(x, y, size);
  } else if (pwEntryIsRedditBrand(titleTxt, website)) {
    drawRedditBrandAvatar(x, y, size);
  } else if (pwEntryIsDiscordBrand(titleTxt, website)) {
    drawDiscordBrandAvatar(x, y, size);
  } else if (pwEntryIsTiktokBrand(titleTxt, website)) {
    drawTiktokBrandAvatar(x, y, size);
  } else {
    gfx->fillRoundRect(x, y, size, size, 10, blendRGB565(UI_CARD, UI_ACCENT, 0.28f));
    gfx->drawRoundRect(x, y, size, size, 10, UI_BORDER);
    char initial = titleTxt[0] ? titleTxt[0] : '#';
    if (initial >= 'a' && initial <= 'z') initial = (char)(initial - ('a' - 'A'));
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(2);
    gfx->setCursor((int16_t)(x + size / 2 - 6), (int16_t)(y + size / 2 - 8));
    gfx->print(initial);
  }
}

