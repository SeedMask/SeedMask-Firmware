// --- Duress decoy vault (BIP-85 child wallet; sealed with duress PIN/password key) ---
static const uint32_t kDuressDecoyMagic = 0x44435631u;  // "DCV1"
static const uint32_t kDuressDecoyBip85Index24 = 1001u;
static const uint32_t kDuressDecoyBip85Index12 = 2001u;

static uint32_t duress_decoy_bip85_index_for_wc(uint8_t wc) {
  return (wc == 12) ? kDuressDecoyBip85Index12 : kDuressDecoyBip85Index24;
}

static void duress_decoy_clear_nvs() {
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.remove("dr_decoy");
  prefs.remove("dr_decoyvaultpw");
  prefs.end();
}

static bool duress_decoy_nvs_present() {
  Preferences prefs;
  prefs.begin("seedmask", true);
  size_t n = prefs.getBytesLength("dr_decoy");
  prefs.end();
  return n >= 28;
}

static bool duress_decoy_pack_from_master(char plainOut[53], uint8_t* outWc) {
  if (!g_loggedIn || !(g_wc == 12 || g_wc == 24)) return false;
  char words[24][16];
  char err[48];
  uint32_t idx = duress_decoy_bip85_index_for_wc(g_wc);
  if (!bip85_derive_mnemonic(idx, g_wc, words, err, sizeof(err))) {
    return false;
  }
  uint32_t magic = kDuressDecoyMagic;
  memcpy(plainOut, &magic, 4);
  plainOut[4] = g_wc;
  for (uint8_t i = 0; i < g_wc; i++) {
    int16_t fi = bip39_find_index_ci(words[i]);
    if (fi < 0) {
      secure_memzero(words, sizeof(words));
      return false;
    }
    uint16_t ix = (uint16_t)fi;
    memcpy(plainOut + 5 + (size_t)i * 2, &ix, 2);
  }
  if (outWc) *outWc = g_wc;
  secure_memzero(words, sizeof(words));
  return true;
}

static bool duress_decoy_unpack_to_words(const char plain[53], uint8_t wc, char words[][16]) {
  if (wc != 12 && wc != 24) return false;
  uint32_t magic = 0;
  memcpy(&magic, plain, 4);
  if (magic != kDuressDecoyMagic || plain[4] != wc) return false;
  for (uint8_t i = 0; i < wc; i++) {
    uint16_t ix = 0;
    memcpy(&ix, plain + 5 + (size_t)i * 2, 2);
    if (ix >= BIP39_WORD_COUNT) return false;
    bip39_get_word(ix, words[i], 16);
    words[i][15] = 0;
  }
  return true;
}

static bool duress_decoy_seal_with_key(const uint8_t key[32]) {
  if (!key) return false;
  char plain[53];
  uint8_t wc = 0;
  if (!duress_decoy_pack_from_master(plain, &wc)) return false;
  uint8_t ct[96];
  size_t ctlen = sizeof(ct);
  if (!aes_gcm_encrypt_with_key(key, (const uint8_t*)plain, sizeof(plain), ct, &ctlen)) {
    secure_memzero(plain, sizeof(plain));
    return false;
  }
  secure_memzero(plain, sizeof(plain));
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putBytes("dr_decoy", ct, ctlen);
  prefs.end();
  return true;
}

static bool duress_decoy_try_open_words_with_slot(const DuressTypeSlot* slot, const char* cred, bool isPin,
                                                  char words[][16], uint8_t* outWc) {
  if (!slot || !slot->active || !cred || !cred[0] || !duress_decoy_nvs_present()) return false;
  uint8_t key[32];
  if (!duress_type_derive_key_from_cred(slot, cred, isPin, key)) return false;
  Preferences prefs;
  prefs.begin("seedmask", true);
  size_t ctlen = prefs.getBytesLength("dr_decoy");
  if (ctlen == 0 || ctlen > 96) {
    prefs.end();
    secure_memzero(key, sizeof(key));
    return false;
  }
  uint8_t ct[96];
  prefs.getBytes("dr_decoy", ct, ctlen);
  prefs.end();
  char plain[53];
  size_t ptlen = sizeof(plain);
  bool ok = aes_gcm_decrypt_with_key(key, ct, ctlen, (uint8_t*)plain, &ptlen);
  secure_memzero(key, sizeof(key));
  secure_memzero(ct, sizeof(ct));
  if (!ok || ptlen != sizeof(plain)) {
    secure_memzero(plain, sizeof(plain));
    return false;
  }
  uint8_t wc = plain[4];
  if (!duress_decoy_unpack_to_words(plain, wc, words)) {
    secure_memzero(plain, sizeof(plain));
    return false;
  }
  secure_memzero(plain, sizeof(plain));
  if (outWc) *outWc = wc;
  return true;
}

static const uint8_t kDuressDecoyVaultPwBlobTag[4] = { 'D', 'C', 'V', 'P' };

static void duress_decoy_vault_key_clear(void) {
  secure_memzero(s_duressDecoyVaultKey, sizeof(s_duressDecoyVaultKey));
  s_duressDecoyVaultKeyValid = false;
}

static bool duress_decoy_vault_key_set_from_cred(const DuressTypeSlot* slot, const char* cred, bool isPin) {
  duress_decoy_vault_key_clear();
  if (!duress_type_derive_key_from_cred(slot, cred, isPin, s_duressDecoyVaultKey)) return false;
  s_duressDecoyVaultKeyValid = true;
  return true;
}

static void duress_decoy_vault_pw_clear_nvs(void) {
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.remove("dr_decoyvaultpw");
  prefs.end();
}

static void duress_decoy_vault_pw_save_nvs(void) {
  if (!s_duressDecoyVaultKeyValid || !g_loggedIn) return;
  String s;
  s.reserve(8000);
  s += vault_export_passwords_plaintext();
  s += "\n---N---\n";
  for (uint8_t i = 0; i < g_noteCount; i++) {
    s += g_noteItems[i].title;
    s += "\t";
    s += g_noteItems[i].body;
    s += "\n";
  }
  s += "\n---T---\n";
  s += totp_serialize_plain();
  size_t plainLen = s.length();
  if (plainLen == 0) {
    duress_decoy_vault_pw_clear_nvs();
    return;
  }
  size_t ctAlloc = 12 + 16 + plainLen;
  size_t ctLen = ctAlloc;
  uint8_t* ct = (uint8_t*)ps_malloc(ctLen);
  if (!ct) return;
  if (!aes_gcm_encrypt_with_key(s_duressDecoyVaultKey, (const uint8_t*)s.c_str(), plainLen, ct, &ctLen)) {
    secure_memzero(ct, ctAlloc);
    free(ct);
    return;
  }
  size_t blobLen = 4 + ctLen;
  uint8_t* blob = (uint8_t*)ps_malloc(blobLen);
  if (!blob) {
    secure_memzero(ct, ctAlloc);
    free(ct);
    return;
  }
  memcpy(blob, kDuressDecoyVaultPwBlobTag, 4);
  memcpy(blob + 4, ct, ctLen);
  secure_memzero(ct, ctAlloc);
  free(ct);
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putBytes("dr_decoyvaultpw", blob, blobLen);
  prefs.end();
  secure_memzero(blob, blobLen);
  free(blob);
}

static void import_passwords_notes_totp_from_plain(const char* p, size_t plainLen);

static void duress_decoy_vault_pw_load_nvs(void) {
  if (!s_duressDecoyVaultKeyValid) return;
  Preferences prefs;
  prefs.begin("seedmask", true);
  size_t blen = prefs.getBytesLength("dr_decoyvaultpw");
  if (blen < 4 + 12 + 16) {
    prefs.end();
    return;
  }
  uint8_t* blob = (uint8_t*)ps_malloc(blen);
  if (!blob) {
    prefs.end();
    return;
  }
  prefs.getBytes("dr_decoyvaultpw", blob, blen);
  prefs.end();
  if (memcmp(blob, kDuressDecoyVaultPwBlobTag, 4) != 0) {
    secure_memzero(blob, blen);
    free(blob);
    return;
  }
  size_t ctLen = blen - 4;
  size_t plainCap = ctLen - 12 - 16;
  if (plainCap < 1) {
    secure_memzero(blob, blen);
    free(blob);
    return;
  }
  uint8_t* plain = (uint8_t*)ps_malloc(plainCap + 1);
  if (!plain) {
    secure_memzero(blob, blen);
    free(blob);
    return;
  }
  size_t plainLen = plainCap;
  if (!aes_gcm_decrypt_with_key(s_duressDecoyVaultKey, blob + 4, ctLen, plain, &plainLen)) {
    secure_memzero(plain, plainCap + 1);
    free(plain);
    secure_memzero(blob, blen);
    free(blob);
    return;
  }
  secure_memzero(blob, blen);
  free(blob);
  plain[plainLen] = 0;
  import_passwords_notes_totp_from_plain((const char*)plain, plainLen);
  secure_memzero(plain, plainCap + 1);
  free(plain);
}

static unsigned lockout_tries_left_for_display() {
  if (g_lockoutMaxAttempts == 0) return 0;
  if (g_lockFailedAttempts >= g_lockoutMaxAttempts) return 0;
  return (unsigned)g_lockoutMaxAttempts - (unsigned)g_lockFailedAttempts;
}

/** Show red counter only when tries left is at or below this (5→3, 10→5, 15→10). */
static unsigned lockout_counter_visible_threshold() {
  switch (g_lockoutMaxAttempts) {
    case 5: return 3;
    case 10: return 5;
    case 15: return 10;
    default: return (unsigned)g_lockoutMaxAttempts;
  }
}

static bool lockout_should_show_tries_banner() {
  if (g_lockoutWipeSilently || !g_lockoutShowAttempts || g_lockoutMaxAttempts == 0) return false;
  const unsigned left = lockout_tries_left_for_display();
  return left <= lockout_counter_visible_threshold();
}

static void lockout_load_prefs() {
  Preferences prefs;
  prefs.begin("seedmask", true);
  // NVS key names max 15 chars; "lock_max_attempts" was too long — use "lock_max_att".
  uint8_t lim = 10;
  if (prefs.isKey("lock_max_att"))
    lim = prefs.getUChar("lock_max_att", 10);
  else if (prefs.isKey("lk_max_att"))
    lim = prefs.getUChar("lk_max_att", 10);
  if (lim != 5 && lim != 10 && lim != 15) lim = 10;
  g_lockoutMaxAttempts = lim;
  if (prefs.isKey("lock_show_att"))
    g_lockoutShowAttempts = prefs.getUChar("lock_show_att", 1) != 0;
  else
    g_lockoutShowAttempts = prefs.getBool("lock_show_attempts", true);
  g_lockoutWipeSilently = prefs.getUChar("lock_wipe_sl", 0) != 0;
  g_lockFailedAttempts = prefs.getUChar("lock_fail_cnt", 0);
  prefs.end();
  if (g_lockFailedAttempts > 250) g_lockFailedAttempts = 0;
  if (g_lockoutWipeSilently && g_lockoutShowAttempts)
    lockout_save_show_attempts(false);
}

static void lockout_persist_fail_count() {
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar("lock_fail_cnt", g_lockFailedAttempts);
  prefs.end();
}

static void lockout_clear_fail_count() {
  g_lockFailedAttempts = 0;
