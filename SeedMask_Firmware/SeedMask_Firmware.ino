// SeedMask mini LCD accessory: UART link (GPIOs set per board; default = disabled).
//
// ESP32-S3 1.47″ accessory (SeedMask_Accessory_S3_147): use **GPIO43 TX / GPIO44 RX** on both boards — do **not**
// use GPIO17/18 on Malina/Spotpear-class boards (those are SD data lines and glitch the LCD).
//   #define SEEDMASK_ACCESSORY_UART_TX 43
//   #define SEEDMASK_ACCESSORY_UART_RX 44
#ifndef SEEDMASK_ACCESSORY_UART_TX
#define SEEDMASK_ACCESSORY_UART_TX 43
#endif
#ifndef SEEDMASK_ACCESSORY_UART_RX
#define SEEDMASK_ACCESSORY_UART_RX 44
#endif
#ifndef SEEDMASK_ACCESSORY_UART_BAUD
#define SEEDMASK_ACCESSORY_UART_BAUD 115200
#endif

#if SEEDMASK_ACCESSORY_UART_TX >= 0 && SEEDMASK_ACCESSORY_UART_RX >= 0
#define SEEDMASK_ACCESSORY_LINK_AVAILABLE 1
static HardwareSerial SeedMaskAccessorySerial(1);
static bool g_seedmaskAccessoryUartReady = false;

static void seedmaskAccessoryUartEnsureInit(void) {
  if (!g_seedmaskAccessoryUartReady) {
    SeedMaskAccessorySerial.begin(SEEDMASK_ACCESSORY_UART_BAUD, SERIAL_8N1,
                                  SEEDMASK_ACCESSORY_UART_RX, SEEDMASK_ACCESSORY_UART_TX);
    g_seedmaskAccessoryUartReady = true;
  }
}
#else
#define SEEDMASK_ACCESSORY_LINK_AVAILABLE 0
#endif

#if SEEDMASK_USB_HID_KEYBOARD || SEEDMASK_ACCESSORY_LINK_AVAILABLE
#define SEEDMASK_NOTE_SEND_UI 1
#else
#define SEEDMASK_NOTE_SEND_UI 0
#endif

/** Framed UART send (magic + header crc + payload); returns false if accessory UART not compiled in or oversize. */
static bool seedmaskAccessorySend(SeedMaskLinkMsgType type, const uint8_t* payload, size_t len) {
#if !(SEEDMASK_ACCESSORY_UART_TX >= 0 && SEEDMASK_ACCESSORY_UART_RX >= 0)
  (void)type;
  (void)payload;
  (void)len;
  return false;
#else
  if (len > SP_LINK_MAX_PAYLOAD) return false;
  seedmaskAccessoryUartEnsureInit();
  uint8_t crc_src[4 + SP_LINK_MAX_PAYLOAD];
  crc_src[0] = (uint8_t)type;
  crc_src[1] = 0;
  crc_src[2] = (uint8_t)(len & 0xFFu);
  crc_src[3] = (uint8_t)((len >> 8) & 0xFFu);
  if (len != 0u && payload != nullptr) memcpy(crc_src + 4, payload, len);
  uint16_t crc = sp_link_crc16_ccitt(crc_src, 4u + len);
  SeedMaskAccessorySerial.write(SEEDMASK_LINK_MAGIC0);
  SeedMaskAccessorySerial.write(SEEDMASK_LINK_MAGIC1);
  SeedMaskAccessorySerial.write(crc_src[0]);
  SeedMaskAccessorySerial.write(crc_src[1]);
  SeedMaskAccessorySerial.write(crc_src[2]);
  SeedMaskAccessorySerial.write(crc_src[3]);
  SeedMaskAccessorySerial.write((uint8_t)(crc & 0xFFu));
  SeedMaskAccessorySerial.write((uint8_t)((crc >> 8) & 0xFFu));
  if (len != 0u && payload != nullptr) SeedMaskAccessorySerial.write(payload, len);
  SeedMaskAccessorySerial.flush();
  return true;
#endif
}

