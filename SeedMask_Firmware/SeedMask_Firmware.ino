static void handleWipeConfirmTap(uint16_t x, uint16_t y) {
  const int16_t topBarBottom = 46;
  const int16_t popupW = 312;
  const int16_t popupH = 288;
  const int16_t popupX = (LCD_W - popupW) / 2;
  const int16_t popupY = (int16_t)(topBarBottom + (LCD_H - topBarBottom - popupH) / 2);
  const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
  const int16_t infoCx = (int16_t)(popupX + popupW - 15 - infoHalf);
  const int16_t infoCy = (int16_t)(popupY + 14 + infoHalf);
  const int16_t padHit = 4;
  const Rect rInfo = {
    (int16_t)(infoCx - infoHalf - padHit), (int16_t)(infoCy - infoHalf - padHit),
    (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHit), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHit)
  };
  const int btnY = (int16_t)(popupY + popupH - 54);
  const Rect rNo = { (int16_t)(popupX + 20), btnY, 124, 46 };
  const Rect rYes = { (int16_t)(popupX + 168), btnY, 124, 46 };

  if (hit(rInfo, x, y)) {
    flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
    delay(85);
    show(UIScreen::WIPE_INFO);
    return;
  }
  if (hit(rYes, x, y)) {
    flashKeyRectTranslucent(rYes);
    delay(85);
    nvs_wipe(true);
    screen_lock_load_prefs();
    lockout_load_prefs();
    g_hasVault = false;
    session_lock_to_home();
    return;
  }
  if (hit(rNo, x, y)) {
    flashKeyRectTranslucent(rNo);
    delay(85);
    show(g_wipeConfirmReturnScreen);
    return;
  }
  if (hit(BTN_TOP_BURGER, x, y) || hit(RECT_TOP_TITLE, x, y)) {
    show(g_wipeConfirmReturnScreen);
    return;
  }
}

