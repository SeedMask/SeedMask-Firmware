    if (g_addPwCursorSite > len) g_addPwCursorSite = (uint16_t)len;
    g_editCursor = g_addPwCursorSite;
  } else if (m == EditMode::ADD_PW_NOTES) {
    if (g_addPwCursorNotes > len) g_addPwCursorNotes = (uint16_t)len;
    g_editCursor = g_addPwCursorNotes;
  }
}

