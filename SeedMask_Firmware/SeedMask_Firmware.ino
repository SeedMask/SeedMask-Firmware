// Case-insensitive substring (ASCII). Used for tiny weak-pattern lists only.
static bool password_substr_ci(const char* hay, const char* needle) {
  if (!hay || !needle || !needle[0]) return false;
  for (; *hay; hay++) {
    const char* a = hay;
    const char* b = needle;
    while (*a && *b && tolower((unsigned char)*a) == tolower((unsigned char)*b)) {
      a++;
      b++;
    }
    if (!*b) return true;
  }
  return false;
}

static uint32_t password_fnv1a32_ci(const char* s) {
  uint32_t h = 0x811C9DC5u;
  if (!s) return h;
  for (size_t i = 0; s[i]; i++) {
    unsigned char c = (unsigned char)tolower((unsigned char)s[i]);
    h ^= (uint32_t)c;
    h *= 0x01000193u;
  }
  return h;
}

static bool password_is_common_hash(uint32_t h) {
  int lo = 0;
  int hi = (int)kTopCommonPasswordHashCount - 1;
  while (lo <= hi) {
    int mid = lo + ((hi - lo) / 2);
    uint32_t v = pgm_read_dword(&kTopCommonPasswordHashes[mid]);
    if (h == v) return true;
    if (h < v) hi = mid - 1;
    else lo = mid + 1;
  }
  return false;
}

static void password_to_leet_folded_ascii(const char* src, char* dst, size_t dstLen);

static bool password_is_top_common_password(const char* pw) {
  if (!pw || !pw[0]) return false;
  // Exact case-insensitive lookup.
  if (password_is_common_hash(password_fnv1a32_ci(pw))) return true;
  // Leet-normalized lookup catches variants like p@ssw0rd, adm1n, etc.
  char folded[EDIT_BUF_MAX];
  password_to_leet_folded_ascii(pw, folded, sizeof(folded));
  if (folded[0] && password_is_common_hash(password_fnv1a32_ci(folded))) return true;
  return false;
}

