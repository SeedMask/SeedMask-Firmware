    11, 14, 15, 12, 5, 8, 7, 9, 11, 13, 14, 15, 6, 7, 9, 8,
    7, 6, 8, 13, 11, 9, 7, 15, 7, 12, 15, 9, 11, 7, 13, 12,
    11, 13, 6, 7, 14, 9, 13, 15, 14, 8, 13, 6, 5, 12, 7, 5,
    11, 12, 14, 15, 14, 15, 9, 8, 9, 14, 5, 6, 8, 6, 5, 12,
    9, 15, 5, 11, 6, 8, 13, 12, 5, 12, 13, 14, 11, 8, 5, 6
  };
  static const uint8_t SR[80] = {
    8, 9, 9, 11, 13, 15, 15, 5, 7, 7, 8, 11, 14, 14, 12, 6,
    9, 13, 15, 7, 12, 8, 9, 11, 7, 7, 12, 7, 6, 15, 13, 11,
    9, 7, 15, 11, 8, 6, 6, 14, 12, 13, 5, 14, 13, 13, 7, 5,
    15, 5, 8, 11, 14, 14, 6, 14, 6, 9, 12, 9, 12, 5, 15, 8,
    8, 5, 12, 9, 12, 5, 14, 6, 8, 13, 6, 5, 15, 13, 11, 11
  };
  uint32_t h0 = 0x67452301UL, h1 = 0xEFCDAB89UL, h2 = 0x98BADCFEUL, h3 = 0x10325476UL, h4 = 0xC3D2E1F0UL;
  size_t bitLenLo = (uint32_t)(len << 3);
  size_t total = len + 1 + 8;
  size_t pad = (64 - (total % 64)) % 64;
  size_t msgLen = len + 1 + pad + 8;
  uint8_t* m = (uint8_t*)malloc(msgLen);
  if (!m) return false;
  memcpy(m, msg, len);
  m[len] = 0x80;
  if (pad) memset(m + len + 1, 0, pad);
  memset(m + len + 1 + pad, 0, 8);
  uint64_t bitLen = (uint64_t)len * 8ULL;
  for (uint8_t i = 0; i < 8; i++) m[msgLen - 8 + i] = (uint8_t)(bitLen >> (8 * i));
  (void)bitLenLo;

  for (size_t off = 0; off < msgLen; off += 64) {
    uint32_t X[16];
    for (uint8_t i = 0; i < 16; i++) {
      const uint8_t* p = m + off + i * 4;
      X[i] = ((uint32_t)p[0]) | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
    }
    uint32_t al = h0, bl = h1, cl = h2, dl = h3, el = h4;
    uint32_t ar = h0, br = h1, cr = h2, dr = h3, er = h4;
    for (uint8_t j = 0; j < 80; j++) {
      uint32_t tl = rol32(al + ripemd_f(j, bl, cl, dl) + X[RL[j]] + ripemd_k(j), SL[j]) + el;
      al = el;
      el = dl;
      dl = rol32(cl, 10);
      cl = bl;
      bl = tl;
      uint8_t jj = (uint8_t)(79 - j);
      uint32_t tr = rol32(ar + ripemd_f(jj, br, cr, dr) + X[RR[j]] + ripemd_kk(j), SR[j]) + er;
      ar = er;
      er = dr;
      dr = rol32(cr, 10);
      cr = br;
      br = tr;
    }
    uint32_t t = h1 + cl + dr;
    h1 = h2 + dl + er;
    h2 = h3 + el + ar;
    h3 = h4 + al + br;
    h4 = h0 + bl + cr;
    h0 = t;
    secure_memzero(X, sizeof(X));
  }
  free(m);
  uint32_t H[5] = { h0, h1, h2, h3, h4 };
  for (uint8_t i = 0; i < 6; i++) {
    out20[i * 4 + 0] = (uint8_t)(H[i] & 0xFF);
    out20[i * 4 + 1] = (uint8_t)((H[i] >> 8) & 0xFF);
    out20[i * 4 + 2] = (uint8_t)((H[i] >> 16) & 0xFF);
    out20[i * 4 + 3] = (uint8_t)((H[i] >> 24) & 0xFF);
  }
  secure_memzero(H, sizeof(H));
  return true;
}

static bool hash160(const uint8_t* in, size_t inLen, uint8_t out20[20]) {
  uint8_t s[32];
  sha256_once(in, inLen, s);
  bool ok = ripemd160_once(s, sizeof(s), out20);
  secure_memzero(s, sizeof(s));
  return ok;
}

static bool base58check_encode(const uint8_t* data, size_t dataLen, char* out, size_t outLen) {
  static const char* ALPH = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  // BIP32 extended keys are 78 bytes + 4 checksum (needs room for base58 division)
  uint8_t buf[128];
  if (!data || dataLen + 4 > sizeof(buf) || !out || outLen < 4) return false;
  memcpy(buf, data, dataLen);
  uint8_t d1[32], d2[32];
  sha256_once(data, dataLen, d1);
  sha256_once(d1, sizeof(d1), d2);
  memcpy(buf + dataLen, d2, 4);
  size_t n = dataLen + 4;
  secure_memzero(d1, sizeof(d1));
  secure_memzero(d2, sizeof(d2));

  size_t zeros = 0;
  while (zeros < n && buf[zeros] == 0) zeros++;
  uint8_t tmp[128];
  size_t tmplen = 0;
  uint8_t work[128];
  memcpy(work, buf, n);
  size_t start = zeros;
  while (start < n) {
    uint32_t rem = 0;
    for (size_t i = start; i < n; i++) {
      uint32_t num = (rem << 8) | work[i];
      work[i] = (uint8_t)(num / 58U);
      rem = num % 58U;
    }
    if (tmplen >= sizeof(tmp)) return false;
    tmp[tmplen++] = (uint8_t)rem;
    while (start < n && work[start] == 0) start++;
  }
  size_t outNeed = zeros + tmplen + 1;
  if (outNeed > outLen) return false;
  size_t p = 0;
  for (size_t i = 0; i < zeros; i++) out[p++] = '1';
  for (size_t i = 0; i < tmplen; i++) out[p++] = ALPH[tmp[tmplen - 1 - i]];
  out[p] = 0;
  secure_memzero(buf, sizeof(buf));
  secure_memzero(work, sizeof(work));
  secure_memzero(tmp, sizeof(tmp));
  return true;
}

// Decode Base58 to big-endian bytes (Bitcoin-style). Leading '1' => zero bytes.
static bool base58_decode(const char* str, uint8_t* out, size_t outCap, size_t* outLen) {
  static const char* ALPH = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
  if (!str || !out || !outLen) return false;
  uint8_t vch[140];
  size_t vchlen = 0;
  for (const char* p = str; *p; p++) {
    const char* q = strchr(ALPH, *p);
    if (!q) return false;
    uint32_t carry = (uint32_t)(q - ALPH);
    for (size_t i = 0; i < vchlen; i++) {
      carry += 58U * (uint32_t)vch[i];
      vch[i] = (uint8_t)(carry & 0xff);
      carry >>= 8;
    }
    while (carry) {
      if (vchlen >= sizeof(vch)) return false;
      vch[vchlen++] = (uint8_t)(carry & 0xff);
      carry >>= 8;
    }
  }
  size_t z = 0;
  while (str[z] == '1') z++;
  size_t total = z + vchlen;
  if (total > outCap || total == 0) return false;
  memset(out, 0, total);
  size_t pos = 0;
  for (size_t i = 0; i < z; i++) out[pos++] = 0;
  for (size_t i = vchlen; i > 0; i--) out[pos++] = vch[i - 1];
  *outLen = total;
  secure_memzero(vch, sizeof(vch));
  return true;
}

static bool base58check_decode_payload(const char* str, uint8_t* payload, size_t expectLen) {
  if (!str || !payload || expectLen == 0) return false;
  uint8_t raw[140];
  size_t rlen = 0;
  if (!base58_decode(str, raw, sizeof(raw), &rlen)) return false;
  if (rlen < 4 || rlen != expectLen + 4) {
    secure_memzero(raw, sizeof(raw));
    return false;
  }
  uint8_t d1[32], d2[32];
  sha256_once(raw, expectLen, d1);
  sha256_once(d1, sizeof(d1), d2);
  if (memcmp(raw + expectLen, d2, 4) != 0) {
    secure_memzero(raw, sizeof(raw));
    secure_memzero(d1, sizeof(d1));
    secure_memzero(d2, sizeof(d2));
    return false;
  }
  memcpy(payload, raw, expectLen);
  secure_memzero(raw, sizeof(raw));
  secure_memzero(d1, sizeof(d1));
  secure_memzero(d2, sizeof(d2));
  return true;
}

static uint32_t bech32_polymod_step(uint32_t chk, uint8_t v) {
  uint8_t b = (uint8_t)(chk >> 25);
  chk = ((chk & 0x1ffffffU) << 5) ^ v;
  if (b & 1) chk ^= 0x3b6a57b2U;
  if (b & 2) chk ^= 0x26508e6dU;
  if (b & 4) chk ^= 0x1ea119faU;
  if (b & 8) chk ^= 0x3d4233ddU;
  if (b & 16) chk ^= 0x2a1462b3U;
  return chk;
}

static bool convert_bits(const uint8_t* in, size_t inLen, int fromBits, int toBits, bool pad, uint8_t* out, size_t* outLen) {
  uint32_t acc = 0;
  int bits = 0;
  size_t p = 0;
  uint32_t maxv = (1U << toBits) - 1U;
  uint32_t maxAcc = (1U << (fromBits + toBits - 1)) - 1U;
  for (size_t i = 0; i < inLen; i++) {
    uint8_t v = in[i];
    if ((v >> fromBits) != 0) return false;
    acc = ((acc << fromBits) | v) & maxAcc;
    bits += fromBits;
    while (bits >= toBits) {
      bits -= toBits;
      if (p >= *outLen) return false;
      out[p++] = (uint8_t)((acc >> bits) & maxv);
    }
  }
  if (pad) {
    if (bits) {
      if (p >= *outLen) return false;
      out[p++] = (uint8_t)((acc << (toBits - bits)) & maxv);
    }
  } else if (bits >= fromBits || ((acc << (toBits - bits)) & maxv)) {
    return false;
  }
  *outLen = p;
  return true;
}

static bool bech32_encode_segwit(const char* hrp, uint8_t witver, const uint8_t* prog, size_t progLen, char* out, size_t outLen) {
  static const char* CHARSET = "qpzry9x8gf2tvdw0s3jn54khce6mua7l";
  if (!hrp || !prog || !out || witver > 16) return false;
  if (!(progLen == 20 || progLen == 32)) return false;
  uint8_t data[90];
  size_t dlen = sizeof(data);
  uint8_t conv[84];
  size_t convLen = sizeof(conv);
  if (!convert_bits(prog, progLen, 8, 5, true, conv, &convLen)) return false;
  if (convLen + 1 > sizeof(data)) return false;
  data[0] = witver;
  memcpy(data + 1, conv, convLen);
  dlen = convLen + 1;

  uint32_t chk = 1;
  size_t hrpLen = strlen(hrp);
  for (size_t i = 0; i < hrpLen; i++) chk = bech32_polymod_step(chk, (uint8_t)(hrp[i] >> 5));
  chk = bech32_polymod_step(chk, 0);
  for (size_t i = 0; i < hrpLen; i++) chk = bech32_polymod_step(chk, (uint8_t)(hrp[i] & 31));
  for (size_t i = 0; i < dlen; i++) chk = bech32_polymod_step(chk, data[i]);
  for (int i = 0; i < 6; i++) chk = bech32_polymod_step(chk, 0);
  chk ^= (witver == 0) ? 1U : 0x2bc830a3U;  // bech32 for v0, bech32m otherwise

  size_t need = hrpLen + 1 + dlen + 6 + 1;
  if (need > outLen) return false;
  size_t p = 0;
  for (size_t i = 0; i < hrpLen; i++) out[p++] = (char)tolower((unsigned char)hrp[i]);
  out[p++] = '1';
  for (size_t i = 0; i < dlen; i++) out[p++] = CHARSET[data[i]];
  for (int i = 0; i < 6; i++) {
    out[p++] = CHARSET[(chk >> (5 * (5 - i))) & 31];
  }
  out[p] = 0;
  secure_memzero(data, sizeof(data));
  secure_memzero(conv, sizeof(conv));
  return true;
}

