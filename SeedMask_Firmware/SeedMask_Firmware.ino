// Vertical gradient inside a rounded rect (per-scanline fill; respects corner radius).
static void fillRoundRectGradientV(const Rect& r, int rad, uint16_t top, uint16_t bottom) {
  int x = r.x, y = r.y, w = r.w, h = r.h;
  if (w <= 0 || h <= 0 || !gfx) return;
  int rEff = rad;
  if (rEff > w / 2) rEff = w / 2;
  if (rEff > h / 2) rEff = h / 2;
  if (rEff < 0) rEff = 0;
  const float rr = (float)(rEff * rEff);
  for (int yy = 0; yy < h; yy++) {
    float t = h > 1 ? (float)yy / (float)(h - 1) : 0.f;
    uint16_t c = blendRGB565(top, bottom, t);
    int py = y + yy;
    int x1 = x;
    int x2 = x + w - 1;
    if (rEff > 0) {
      if (yy < rEff) {
        float dyCircle = (float)((y + rEff) - py);
        float inner = rr - dyCircle * dyCircle;
        if (inner < 0.f) inner = 0.f;
        float f = sqrtf(inner);
        x1 = (int)(x + rEff - f + 0.5f);
        x2 = (int)(x + w - rEff + f - 0.5f);
      } else if (yy >= h - rEff) {
        float dyCircle = (float)(py - (y + h - rEff));
        float inner = rr - dyCircle * dyCircle;
        if (inner < 0.f) inner = 0.f;
        float f = sqrtf(inner);
        x1 = (int)(x + rEff - f + 0.5f);
        x2 = (int)(x + w - rEff + f - 0.5f);
      }
    }
    if (x1 <= x2)
      gfx->fillRect(x1, py, (uint16_t)(x2 - x1 + 1), 1, c);
  }
}

/** Blue-grey vertical gradient + soft double border (main menu + Bitcoin / Crypto settings grid cards). */
