static void handleBurger(uint16_t x, uint16_t y) {
  if (!hit(BTN_TOP_BURGER, x, y)) return;
  if (!g_loggedIn) return;
  show(UIScreen::BURGER_MENU);
}

static void handleHomeTap(uint16_t x, uint16_t y) {
  // Redraw only — show(HOME) would re-run the full navigation pipeline and can contribute to visible twitch.
  if (hit(BTN_HOME_STATEFUL, x, y)) {
    g_stateless = false;
    persist_stateless();
    g_homeNeedsRedraw = true;
    yield();
    draw();
    return;
  }
  if (hit(BTN_HOME_STATELESS, x, y)) {
    g_stateless = true;
    persist_stateless();
    g_homeNeedsRedraw = true;
    yield();
    draw();
    return;
  }
  if (hit(BTN_HOME_CREATE, x, y)) {
    show(UIScreen::CREATE_PICK);
    return;
  }

  if (hit(BTN_HOME_RESTORE, x, y)) {
    g_cryptoTempSeedBackupRestoreFlow = false;
    g_restoreSeedEntryMode = false;
    g_restoreSeedFlowActive = false;
    g_restoreSeedQrOnlyScan = false;
    g_restoreCodeEntryMode = false;
    restorePayload_clear();
    setMsg("");
    g_kbMode = KBMode::LETTERS;
    g_shift = 0;
    show(UIScreen::RESTORE_CODE);
    return;
  }

  if (hit(BTN_HOME_LOCKED, x, y)) {
    if (!g_hasVault) return;

    if (g_loggedIn) {
      if (g_bip39HasPassphrase) {
        show(UIScreen::CONFIRM_PASSPHRASE_CLEAR);
        return;
      }
      session_lock_to_home();
      return;
    }
    clearPassword(g_password1);
    g_pwMasked = true;
    show(UIScreen::LOCKED);
    return;
  }
}

static void handleCreatePickTap(uint16_t x, uint16_t y) {
  if (hit(BTN_PICK_STATEFUL, x, y)) {
    g_stateless = false;
    persist_stateless();
    g_createPickNeedsRedraw = true;
    yield();
    draw();
    return;
  }
  if (hit(BTN_PICK_STATELESS, x, y)) {
    g_stateless = true;
    persist_stateless();
    g_createPickNeedsRedraw = true;
    yield();
    draw();
    return;
  }
  if (hit(BTN_PICK_GEN, x, y)) {
    g_seedFromDice = false;
    dice_rolls_reset();
    show(UIScreen::CREATE_ENTROPY_METHOD);
    return;
  }

  if (hit(BTN_PICK_BK, x, y)) {
    g_kbMode = KBMode::LETTERS;
    g_shift = 0;
    show(UIScreen::BACKUP_CHOOSE_WORDS);
    return;
  }
}

static void handleCreateEntropyMethodTap(uint16_t x, uint16_t y) {
  if (hit(HIT_ENTROPY_HW, x, y)) {
    show(UIScreen::CREATE_ENTROPY_HW_WARN);
    return;
  }
  if (hit(HIT_ENTROPY_DICE, x, y)) {
    g_seedFromDice = true;
    dice_rolls_reset();
    show(UIScreen::CREATE_DICE_WORDS);
    return;
  }
}

static void handleCreateEntropyHwWarnTap(uint16_t x, uint16_t y) {
  if (!hit(BTN_ENTROPY_HW_CONTINUE, x, y)) return;
  g_seedFromDice = false;
  dice_rolls_reset();
  g_wc = 12;
  generate_mnemonic_words(g_wc, g_seedGen);
  syncGenSeedToDisplay();
  show(UIScreen::CREATE_GEN);
}

static void handleCreateDiceWordsTap(uint16_t x, uint16_t y) {
  if (hit(BTN_DICE_WORDS_BACK, x, y)) {
    show(UIScreen::CREATE_ENTROPY_METHOD);
    return;
  }
  if (hit(BTN_DICE_WORDS_12, x, y)) {
    g_wc = 12;
    g_seedFromDice = true;
    dice_rolls_reset();
    show(UIScreen::CREATE_DICE_ROLL);
    return;
  }
  if (hit(BTN_DICE_WORDS_24, x, y)) {
    g_wc = 24;
    g_seedFromDice = true;
    dice_rolls_reset();
    show(UIScreen::CREATE_DICE_ROLL);
    return;
  }
}

static void handleCreateDiceRollTap(uint16_t x, uint16_t y) {
  if (hit(BTN_DICE_UNDO, x, y)) {
    if (g_diceRollCount > 0) {
      g_diceRollCount--;
      g_diceRolls[g_diceRollCount] = 0;
      draw();
    }
    return;
  }
  if (hit(BTN_DICE_DONE, x, y)) {
    if (g_diceRollCount < seedmask_dice_min_rolls(g_wc)) return;
    if (!seedmask_dice_rolls_to_mnemonic(g_diceRolls, g_diceRollCount, g_wc, g_seedGen)) {
      setMsg("Dice entropy failed.");
      return;
    }
    g_seedFromDice = true;
    syncGenSeedToDisplay();
    setMsg("");
    show(UIScreen::CREATE_GEN);
    return;
  }
  for (uint8_t f = 1; f <= 6; f++) {
    if (hit(diceFaceRect(f), x, y)) {
      if (g_diceRollCount >= kDiceRollsCap) return;
      flashDiceFace(f);
      g_diceRolls[g_diceRollCount++] = f;
      draw();
      return;
    }
  }
}

static void handleCreateGenTap(uint16_t x, uint16_t y) {
  if (!g_seedFromDice) {
    if (hit(BTN_GEN_12, x, y)) {
      g_wc = 12;
      generate_mnemonic_words(g_wc, g_seedGen);
      syncGenSeedToDisplay();
      draw();
      return;
    }
    if (hit(BTN_GEN_24, x, y)) {
      g_wc = 24;
      generate_mnemonic_words(g_wc, g_seedGen);
      syncGenSeedToDisplay();
      draw();
      return;
    }
  }
  if (hit(BTN_GEN_REGEN, x, y)) {
    if (g_seedFromDice) {
      dice_rolls_reset();
      show(UIScreen::CREATE_DICE_ROLL);
      return;
    }
    generate_mnemonic_words(g_wc, g_seedGen);
    syncGenSeedToDisplay();
    draw();
    return;
  }
  if (hit(BTN_GEN_NEXT, x, y)) {
    setMsg("");
    show(UIScreen::CREATE_VERIFY_CHOICE);
    return;
  }
}

static void handleCreateVerifyChoiceTap(uint16_t x, uint16_t y) {
  if (hit(BTN_CREATE_VERIFY_PHRASE, x, y)) {
    confirmTapInit();
    show(UIScreen::CREATE_CONFIRM);
    return;
  }
  if (hit(BTN_CREATE_VERIFY_SKIP, x, y)) {
    setMsg("");
    show_onboard_lock_setup(true);
    return;
  }
}

static void handleCreateConfirmTap(uint16_t x, uint16_t y) {
  for (int k = 0; k < g_wc; k++) {
    Rect r = confirmBtnRect(k);
    if (!hit(r, x, y)) continue;

    uint8_t idx = g_confirmOrder[k];
    if (g_confirmUsed[idx]) return;

    if (idx == g_confirmPos) {
      g_confirmUsed[idx] = true;
      g_confirmPos++;
      setMsg("OK");
      if (g_confirmPos >= g_wc) {
        setMsg("Confirmed.");
        show_onboard_lock_setup(true);
        return;
      }
      draw();
      return;
    }

    g_confirmFlashK = (int8_t)k;
    g_confirmFlashUntil = millis() + 250;
    setMsg("Wrong. Try next.");
    draw();
    return;
  }
}

static void handleCreateLockTypeTap(uint16_t x, uint16_t y) {
  if (hit(BTN_SEC_MODE_PIN, x, y)) {
    g_onboardLockFlow = true;
    g_pinSetupIsChanging = false;
    g_pinSetupPhase = 0;
    g_pinFirstEntry[0] = 0;
    clearPassword(g_password1);
    setMsg("");
    show(UIScreen::SECURITY_PIN_SETUP);
    return;
  }
  if (hit(BTN_SEC_MODE_PW, x, y)) {
    g_onboardLockFlow = true;
    g_secLockPwReauthPending = false;
    g_secLockPwSetupMoreOpen = false;
    g_secLockPwSetupPhase = 0;
    g_screenLockPwFirst[0] = 0;
    clearPassword(g_password1);
    g_pwMasked = true;
    setMsg("8+ characters. Unlocks device only.");
    show(UIScreen::SECURITY_LOCK_PW_SETUP);
    return;
  }
}

static void handleBackupOptTap(uint16_t x, uint16_t y) {
  if (hit(BTN_OPT_LATER, x, y)) {
    // Lock already set; vault may use device-internal master key. Skip user backup code.
    if (!g_loggedIn) {
      session_login_from_seed((const char(*)[16])g_seedGen, g_wc, "");
    }
    onboard_lock_clear_cred();
    g_onboardLockFlow = false;
    setMsg("");
    show(UIScreen::MENU);
    return;
  }
  if (hit(BTN_OPT_YES, x, y)) {
    clearPassword(g_password1);
    g_pwMasked = true;
    setMsg("Min 12 chars, A-Z, digit, symbol.");
    show(UIScreen::CREATE_PASSWORD);
    return;
  }
}

static void handleCreatePasswordTap(uint16_t x, uint16_t y) {
  if (g_password1[0] && hit(BTN_PW_SHOWHIDE, x, y)) {
    g_pwMasked = !g_pwMasked;
    draw();
    return;
  }

  Serial.println("handleCreatePasswordTap called");
  Serial.print("Touch coordinates: X=");
  Serial.print(x);
  Serial.print(", Y=");
  Serial.println(y);

  // OPTIONAL: if you really want to require SD here
  // (but usually SD is required when saving passwords, not when creating backup code)
  /*
  if (!sd_ready()) {
    showErrorAndExitEditor("Insert microSD to save");
    return;
  }
  */

  if (hitOkKeyResolved((int16_t)x, (int16_t)y)) {
    flashKeyRectTranslucent(keyRectRow4[2]);
    Serial.println("OK button hit detected!");

    if (!backup_password_ok_for_create(g_password1)) {
      Serial.println("Backup password rejected");
      draw();
      return;
    }

    // Check if this is master password creation
    if (g_creatingMasterPassword) {
      g_createVaultPasswordThenAdd = true;
      g_vaultPwThenAddReturn = UIScreen::PASSWORDS;
      g_creatingMasterPassword = false;
    }
    if (g_createVaultPasswordThenAdd) {
      clearPassword(g_password2);
      setMsg("Confirm password.");
      nav_cancel_pending_gesture();
      show(UIScreen::CREATE_PASSWORD2);
      return;
    }
    clearPassword(g_password2);
    setMsg("Confirm password.");
    nav_cancel_pending_gesture();
    show(UIScreen::CREATE_PASSWORD2);
    return;
  }

  passwordInputTap(x, y, g_password1, sizeof(g_password1));
}

static void handleCreatePassword2Tap(uint16_t x, uint16_t y) {
  if (g_password2[0] && hit(BTN_PW_SHOWHIDE, x, y)) {
    g_pwMasked = !g_pwMasked;
    draw();
    return;
  }
  if (hitOkKeyResolved((int16_t)x, (int16_t)y)) {
    flashKeyRectTranslucent(keyRectRow4[2]);
    if (strcmp(g_password1, g_password2) != 0) {
      setMsg("Passwords differ.");
      clearPassword(g_password2);
      draw();
      return;
    }

    g_busy = true;
    g_spin = 0;
    setMsg("Generating...");
    draw();
    yield();
    delay(20);

    const bool useSessionSeed = g_createBackupFromSeedSettings || g_createVaultPasswordThenAdd;
    const char (*seedWords)[16] = useSessionSeed ? (const char(*)[16])g_seed : (const char(*)[16])g_seedGen;
    const bool lockWrapActive = g_screenLockUsesPin || g_screenLockSeparatePw;
    const bool canRewrapLock = g_onboardLockCred[0] != 0;
    // Don't rewrite NVS/master when PIN wrap can't follow — that would brick the next unlock.
    const bool storeVaultNvs = !g_stateless && (!g_createVaultPasswordThenAdd || !lockWrapActive || canRewrapLock);

    bool ok = make_backup_code_from_seed(
      seedWords, g_wc,
      g_password1,
      g_backupCode, sizeof(g_backupCode),
      storeVaultNvs);
    g_busy = false;

    if (!ok) {
      show(UIScreen::ERROR_SCREEN);
      return;
    }

    if (sd_ready()) {
      if (backup_code_save_to_sd(g_backupCode, g_password1, seedWords, g_wc)) {
        char saved[96];
        snprintf(saved, sizeof(saved), "Backup code saved to microSD as %s", backup_code_sd_basename());
        setMsg(saved);
      } else {
        strncpy(g_msg, "Auto-save failed!", sizeof(g_msg) - 1);
        g_msg[sizeof(g_msg) - 1] = 0;
      }
    } else {
      strncpy(g_msg, "SD not ready for backup", sizeof(g_msg) - 1);
      g_msg[sizeof(g_msg) - 1] = 0;
    }

    if (storeVaultNvs) {
      strncpy(g_masterPw, g_password1, sizeof(g_masterPw) - 1);
      g_masterPw[sizeof(g_masterPw) - 1] = 0;
    }
    clearPassword(g_password1);
    clearPassword(g_password2);

    // Keep lock PIN/password wrapping the new vault/backup encrypt key.
    if (storeVaultNvs && g_onboardLockCred[0] && !onboard_rewrap_lock_for_master()) {
      setMsg("Lock wrap failed");
      show(UIScreen::ERROR_SCREEN);
      return;
    }

    if (g_createVaultPasswordThenAdd) {
      g_createVaultPasswordThenAdd = false;
      portable_backup_set_from_code(g_backupCode);
      UIScreen ret = g_vaultPwThenAddReturn;
      if (ret != UIScreen::PASSWORDS && ret != UIScreen::NOTES && ret != UIScreen::TFA_LIST)
        ret = UIScreen::PASSWORDS;
      setMsg("");
      nav_cancel_pending_gesture();
      show(ret);
      return;
    }

    if (g_createBackupFromSeedSettings) {
      g_createBackupFromSeedSettings = false;
      portable_backup_set_from_code(g_backupCode);
      g_backupShowCodeReturnScreen = UIScreen::SEED_SETTINGS;
      nav_cancel_pending_gesture();
      show(UIScreen::BACKUP_SHOW_CODE);
      return;
    }

    session_login_from_seed((const char(*)[16])g_seedGen, g_wc, g_backupCode);
    portable_backup_set_from_code(g_backupCode);

    if (pwSvc_getCount() > 0 && sd_ready()) {
      if (!pw_vault_save_to_sd(g_masterPw)) { /* ignore */
      }
    }
    onboard_lock_clear_cred();
    g_onboardLockFlow = false;
    nav_cancel_pending_gesture();
    show(UIScreen::CREATE_SHOW_CODE);
    return;
  }
  passwordInputTap(x, y, g_password2, sizeof(g_password2));
}

static void handleBackupChooseWordsTap(uint16_t x, uint16_t y) {
