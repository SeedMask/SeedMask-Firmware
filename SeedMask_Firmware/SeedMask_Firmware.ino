#if SEEDMASK_USB_HID_KEYBOARD
/** Between selected login fields when typing to USB host (editor send picker). */
static void hidAdvanceBeforeLoginField(int prevIdx, int nextIdx, uint8_t userPassAdvance) {
  if (prevIdx == 1 && nextIdx == 2) {
    switch (userPassAdvance) {
      case 1:
        Keyboard.write(KEY_RETURN);
        break;
      case 2:
        Keyboard.write(KEY_TAB);
        delay(25);
        Keyboard.write(KEY_TAB);
        break;
      default:
        Keyboard.write(KEY_TAB);
        break;
    }
  } else {
    Keyboard.write((uint8_t)' ');
  }
  delay(25);
}

static bool pwEditorSendMaskHasUserThenPassword(uint8_t mask) {
  if (!(mask & (uint8_t)(1u << 1)) || !(mask & (uint8_t)(1u << 2))) return false;
  if (g_viewPwIndex >= pwSvc_getCount()) return false;
  char name[sizeof(PwItem::title)];
  char user[64];
  char website[64], notes[96];
  splitPasswordTitleMeta(pwSvc_getTitleCStr(g_viewPwIndex), name, sizeof(name), user, sizeof(user), website,
                         sizeof(website), notes, sizeof(notes));
  const char* pass = (g_editMode == EditMode::EDIT_PW_VALUE) ? g_tmpPwValue : pwSvc_getValueCStr(g_viewPwIndex);
  return user[0] != 0 && pass != nullptr && pass[0] != 0;
}

static void pwEditorExecuteSendToHost(uint8_t userPassAdvance) {
  if (g_pwEditorSendMask == 0) {
    setMsg("Select one or more fields");
    return;
  }
  // Do not draw() before HID — CDC+HID stall on ESP32-S3.
  pwEditorTypeSelectedFieldsToHost(g_pwEditorSendMask, userPassAdvance);
  g_pwEditorSendDevicePromptActive = false;
  g_pwEditorSendPickerActive = false;
  g_pwEditorSendMask = 0;
}

static void pwEditorOnSendPickerSendTapped() {
  if (g_pwEditorSendMask == 0) {
    setMsg("Select one or more fields");
    return;
  }
#if SEEDMASK_NOTE_SEND_UI
  if (pwSendDisabled()) {
    setMsgTr("Sending is disabled", "Slanje je iskljuceno");
    return;
  }
#endif
  if (pwEditorSendMaskHasUserThenPassword(g_pwEditorSendMask)) {
    g_pwEditorSendDevicePromptActive = true;
    return;
  }
  pwEditorExecuteSendToHost(0);
}
#endif

static void pwEditorTypeSelectedFieldsToHost(uint8_t mask, uint8_t userPassAdvance) {
#if SEEDMASK_USB_HID_KEYBOARD
  if (g_viewPwIndex >= pwSvc_getCount()) return;
  if (!hidHostTypingEnabled()) {
    setMsgTr("HID typing is off", "USB tipkanje je iskljuceno");
    return;
  }
  char name[sizeof(PwItem::title)];
  char user[64];
  char website[64], notes[96];
  splitPasswordTitleMeta(pwSvc_getTitleCStr(g_viewPwIndex), name, sizeof(name), user, sizeof(user), website, sizeof(website), notes, sizeof(notes));
  const char* pass = (g_editMode == EditMode::EDIT_PW_VALUE) ? g_tmpPwValue : pwSvc_getValueCStr(g_viewPwIndex);
  const char* fields[5] = { name, user, pass, website, notes };
  Serial.flush();
  delay(80);
  int prevOutIdx = -1;  // last field index actually typed (0..4)
  size_t typed = 0;
  for (int i = 0; i < 5; i++) {
    if (!(mask & (uint8_t)(1u << i))) continue;
    const char* s = fields[i];
    if (!s || !s[0]) continue;
    if (prevOutIdx >= 0) {
      hidAdvanceBeforeLoginField(prevOutIdx, i, userPassAdvance);
    }
    prevOutIdx = i;
    for (const char* p = s; *p; p++) {
      char c = *p;
      if (c >= 32 && c <= 126) {
        Keyboard.write((uint8_t)c);
        delay(30);
        typed++;
      }
    }
  }
  Keyboard.releaseAll();
  setMsgTr(typed > 0 ? "Sent" : "Nothing sent", typed > 0 ? "Poslato" : "Nista nije poslato");
#else
  (void)mask;
  (void)userPassAdvance;
  setMsg("USB HID unavailable");
#endif
}

static void drawPwEditorSendPickerOverlay(void) {
  // Darken from below the button row(s); not over the credential avatar (taller than Send row).
  const int16_t sendBottom = (int16_t)(PW_EDIT_SEND_BTN_Y + 34);
  const int16_t primaryBottom = (int16_t)(PW_EDIT_PRIMARY_BTN_Y + 34);
  const int16_t btnRowBottom = (primaryBottom > sendBottom) ? primaryBottom : sendBottom;
  const int16_t avatarBottom = (int16_t)(PW_EDIT_AVATAR_Y + PW_DETAIL_AVATAR_SIZE);
  const int16_t overlayTop = (avatarBottom > btnRowBottom) ? avatarBottom : btnRowBottom;
  gfx->fillRect(0, overlayTop, LCD_W, (int16_t)(LCD_H - overlayTop), RGB565(5, 5, 6));
  const char* labels[5] = { "Name", "Username/Email", "Password", "Website/App", "Notes" };
  for (int i = 0; i < 5; i++) {
    Rect rr = pwEditorSendPickerHitRect(i);
    gfx->fillRoundRect(rr.x, rr.y, rr.w, rr.h, 8, UI_CARD);
    gfx->drawRoundRect(rr.x, rr.y, rr.w, rr.h, 8, UI_BORDER);
    const int cbY = (int)rr.y + ((int)rr.h - 20) / 2;
    gfx->drawRect(28, (int16_t)cbY, 20, 20, UI_TEXT);
    if (g_pwEditorSendMask & (uint8_t)(1u << i))
      gfx->fillRect(31, (int16_t)(cbY + 3), 14, 14, UI_ACCENT);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(2);
    gfx->setCursor(56, (int16_t)((int)rr.y + (int)rr.h / 2 - 8));
    gfx->print(labels[i]);
  }
  if (g_pwEditorSendDevicePromptActive) {
    const int popupR = 12;
    Rect card, rPc, rPh;
    pwEditorSendWherePopupRects(&card, &rPc, &rPh);
    const uint16_t sendBlue = pwEditorSendBtnBlue565();
    drawSemiTransparentCardPopup(card.x, card.y, card.w, card.h, popupR);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(2);
    gfx->setCursor(card.x + 12, card.y + 14);
    gfx->print(tr("Send where?", "Gde poslati?"));
    drawBtn(rPc, tr("Send on PC", "Posalji na racunar"), sendBlue, 2);
    drawBtn(rPh, tr("Send on phone/tablet", "Posalji na telefon/tablet"), sendBlue, 2);
  }
}

