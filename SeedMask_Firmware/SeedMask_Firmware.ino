  gfx->fillRoundRect(rUp.x, rUp.y, rUp.w, rUp.h, 8, UI_CARD);
  gfx->setTextColor(UI_TEXT);
  gfx->setCursor((int16_t)(rUp.x + 14), (int16_t)(rUp.y + 12));
  gfx->print("^");
  gfx->fillRoundRect(rDown.x, rDown.y, rDown.w, rDown.h, 8, UI_CARD);
  gfx->setCursor((int16_t)(rDown.x + 12), (int16_t)(rDown.y + 12));
