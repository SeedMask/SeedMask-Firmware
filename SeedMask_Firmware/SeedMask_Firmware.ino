// Draw filled arc (pie slice): 0 = 12 o'clock. We draw from -endAngleDeg to 0 (counter-clockwise)
// so the remaining-time wedge sits on the left and depletes from right to left.
// Fine angular steps + rounding reduce visible facets along the outer arc.
static void drawTfaClockArc(int16_t cx, int16_t cy, int16_t r, float endAngleDeg, uint16_t color) {
  if (endAngleDeg <= 0 || r <= 0) return;
  if (endAngleDeg > 360) endAngleDeg = 360;
  const float deg2rad = 3.14159265f / 180.0f;
  // ~2° segments: smooth outer edge without huge triangle count (max ~180 per full turn).
  const float stepDeg = 2.0f;
  float d = -endAngleDeg;
  while (d < -1e-5f) {
    float dNext = d + stepDeg;
    if (dNext > 0) dNext = 0;
    float a0 = d * deg2rad;
    float a1 = dNext * deg2rad;
    long x0 = lrintf(cx + (float)r * sinf(a0));
    long y0 = lrintf(cy - (float)r * cosf(a0));
    long x1 = lrintf(cx + (float)r * sinf(a1));
    long y1 = lrintf(cy - (float)r * cosf(a1));
    gfx->fillTriangle(cx, cy, (int16_t)x0, (int16_t)y0, (int16_t)x1, (int16_t)y1, color);
    d = dNext;
  }
}

// 2FA countdown: ring + remaining wedge. Last 10s: red ring always; wedge does one brief dip per second tick, then stays on.
static void drawTfaRemainingRing(int16_t cx, int16_t cy, int16_t outerRadius, int secsLeft, float arcDeg, uint32_t unixSec) {
  if (outerRadius < 2) return;
  if (secsLeft <= 10) {
    static uint32_t s_tfaRingBlinkUt = UINT32_MAX;
    static uint32_t s_tfaRingBlinkMs = 0;
    if (unixSec != s_tfaRingBlinkUt) {
      s_tfaRingBlinkUt = unixSec;
      s_tfaRingBlinkMs = millis();
    }
    uint32_t e = millis() - s_tfaRingBlinkMs;
    const bool wedgeOn = (e < 80u) || (e >= 200u);
    if (wedgeOn)
      drawTfaClockArc(cx, cy, outerRadius, arcDeg, RGB565_RED);
    gfx->drawCircle(cx, cy, outerRadius, RGB565_RED);
  } else {
    drawTfaClockArc(cx, cy, outerRadius, arcDeg, UI_ACCENT);
    gfx->drawCircle(cx, cy, outerRadius, UI_ACCENT);
  }
}

static int hexNibble(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return -1;
}

static void urlDecodeToBuf(const char* src, char* dst, size_t dstSize) {
  if (!dst || dstSize == 0) return;
  if (!src) {
    dst[0] = 0;
    return;
  }
  size_t o = 0;
  for (size_t i = 0; src[i] && o + 1 < dstSize; i++) {
    char c = src[i];
    if (c == '+') {
      dst[o++] = ' ';
    } else if (c == '%' && src[i + 1] && src[i + 2]) {
      int hi = hexNibble(src[i + 1]);
      int lo = hexNibble(src[i + 2]);
      if (hi >= 0 && lo >= 0) {
        dst[o++] = (char)((hi << 4) | lo);
        i += 2;
      } else {
        dst[o++] = c;
      }
    } else {
      dst[o++] = c;
    }
  }
  dst[o] = 0;
}

static bool getUriQueryParam(const char* query, const char* key, char* out, size_t outSize) {
  if (!query || !key || !out || outSize == 0) return false;
  out[0] = 0;
  size_t keyLen = strlen(key);
  const char* p = query;
  while (*p) {
    const char* k = p;
    const char* eq = strchr(k, '=');
    if (!eq) break;
    const char* amp = strchr(eq + 1, '&');
    size_t kLen = (size_t)(eq - k);
    if (kLen == keyLen && strncasecmp(k, key, keyLen) == 0) {
      size_t vLen = amp ? (size_t)(amp - (eq + 1)) : strlen(eq + 1);
      char tmp[256];
      if (vLen >= sizeof(tmp)) vLen = sizeof(tmp) - 1;
      memcpy(tmp, eq + 1, vLen);
      tmp[vLen] = 0;
      urlDecodeToBuf(tmp, out, outSize);
      return true;
    }
    if (!amp) break;
    p = amp + 1;
  }
  return false;
}

static bool parseTotpUriToItem(const char* uri, char* outLabel, size_t outLabelSize, char* outSecret, size_t outSecretSize) {
  if (!uri || !outLabel || !outSecret || outLabelSize == 0 || outSecretSize == 0) return false;
  outLabel[0] = 0;
  outSecret[0] = 0;

  if (strncasecmp(uri, "otpauth://totp/", 15) != 0) return false;
  const char* p = uri + 15;
  const char* q = strchr(p, '?');
  if (!q) return false;

  char labelRaw[96];
  size_t labelLen = (size_t)(q - p);
  if (labelLen >= sizeof(labelRaw)) labelLen = sizeof(labelRaw) - 1;
  memcpy(labelRaw, p, labelLen);
  labelRaw[labelLen] = 0;

  char labelDecoded[96];
  urlDecodeToBuf(labelRaw, labelDecoded, sizeof(labelDecoded));

  char secret[96];
  if (!getUriQueryParam(q + 1, "secret", secret, sizeof(secret))) return false;
  if (!secret[0]) return false;

  // Build label like Google Authenticator: "Issuer:account".
  char issuer[64];
  bool hasIssuer = getUriQueryParam(q + 1, "issuer", issuer, sizeof(issuer));
  const char* accountPtr = labelDecoded;
  const char* issuerPtr = issuer;
  const char* colon = strchr(labelDecoded, ':');
  if (colon && colon[1]) accountPtr = colon + 1;
  while (*accountPtr == ' ') accountPtr++;
  while (*issuerPtr == ' ') issuerPtr++;

  if (hasIssuer && issuerPtr[0] && accountPtr[0]) {
    snprintf(outLabel, outLabelSize, "%s:%s", issuerPtr, accountPtr);
  } else if (accountPtr[0]) {
    strncpy(outLabel, accountPtr, outLabelSize - 1);
    outLabel[outLabelSize - 1] = 0;
  } else if (hasIssuer && issuerPtr[0]) {
    strncpy(outLabel, issuerPtr, outLabelSize - 1);
    outLabel[outLabelSize - 1] = 0;
  }
  strncpy(outSecret, secret, outSecretSize - 1);
  outSecret[outSecretSize - 1] = 0;
  return outLabel[0] && outSecret[0];
}

static void splitTotpLabel(const char* full, char* providerOut, size_t providerCap, char* accountOut, size_t accountCap) {
  if (!providerOut || providerCap == 0 || !accountOut || accountCap == 0) return;
  providerOut[0] = 0;
  accountOut[0] = 0;
  if (!full || !full[0]) return;

  const char* colon = strchr(full, ':');
  if (colon && colon > full) {
    size_t pLen = (size_t)(colon - full);
    if (pLen >= providerCap) pLen = providerCap - 1;
    memcpy(providerOut, full, pLen);
    providerOut[pLen] = 0;

    const char* acc = colon + 1;
    while (*acc == ' ') acc++;
    strncpy(accountOut, acc, accountCap - 1);
    accountOut[accountCap - 1] = 0;
  } else {
    strncpy(providerOut, full, providerCap - 1);
    providerOut[providerCap - 1] = 0;
  }
}

static void copyEllipsized(const char* src, char* dst, size_t cap, int maxChars) {
  if (!dst || cap == 0) return;
  dst[0] = 0;
  if (!src) return;
  if (maxChars < 1) maxChars = 1;
  size_t len = strlen(src);
  size_t keep = (size_t)maxChars;
  if (keep > cap - 1) keep = cap - 1;
  if (len <= keep) {
    strncpy(dst, src, cap - 1);
    dst[cap - 1] = 0;
    return;
  }
  if (keep <= 3) {
    for (size_t i = 0; i < keep && i < cap - 1; i++) dst[i] = '.';
    dst[keep] = 0;
    return;
  }
  size_t base = keep - 3;
  memcpy(dst, src, base);
  dst[base] = '.';
  dst[base + 1] = '.';
  dst[base + 2] = '.';
  dst[base + 3] = 0;
}

static void stripCharInPlace(char* s, char bad) {
  if (!s) return;
  size_t r = 0, w = 0;
  while (s[r]) {
    if (s[r] != bad) s[w++] = s[r];
    r++;
  }
  s[w] = 0;
}

static void splitPasswordTitleMeta(const char* full, char* nameOut, size_t nameCap, char* userOut, size_t userCap,
                                   char* websiteOut, size_t websiteCap, char* notesOut, size_t notesCap) {
  if (!nameOut || nameCap == 0 || !userOut || userCap == 0 || !websiteOut || websiteCap == 0 || !notesOut || notesCap == 0) return;
  nameOut[0] = 0;
  userOut[0] = 0;
  websiteOut[0] = 0;
  notesOut[0] = 0;
  if (!full || !full[0]) return;
  const char* p = full;
  const char* s1 = strstr(p, " | ");
  if (!s1) {
    strncpy(nameOut, p, nameCap - 1);
    nameOut[nameCap - 1] = 0;
    return;
  }
  size_t n1 = (size_t)(s1 - p);
  if (n1 >= nameCap) n1 = nameCap - 1;
  memcpy(nameOut, p, n1);
  nameOut[n1] = 0;
  p = s1 + 3;
  const char* s2 = strstr(p, " | ");
  if (!s2) {
    strncpy(userOut, p, userCap - 1);
    userOut[userCap - 1] = 0;
    return;
  }
  size_t n2 = (size_t)(s2 - p);
  if (n2 >= userCap) n2 = userCap - 1;
  memcpy(userOut, p, n2);
  userOut[n2] = 0;
  p = s2 + 3;
  const char* s3 = strstr(p, " | ");
  if (!s3) {
    strncpy(websiteOut, p, websiteCap - 1);
    websiteOut[websiteCap - 1] = 0;
    return;
  }
  size_t n3 = (size_t)(s3 - p);
  if (n3 >= websiteCap) n3 = websiteCap - 1;
  memcpy(websiteOut, p, n3);
  websiteOut[n3] = 0;
  strncpy(notesOut, s3 + 3, notesCap - 1);
  notesOut[notesCap - 1] = 0;
}

static void composePasswordTitleMeta(const char* name, const char* user, const char* website, const char* notes, char* out, size_t outCap) {
  g_pwMetaComposeTruncated = false;
  if (!out || outCap == 0) return;
  out[0] = 0;
  const char* s = name ? name : "";
  const char* u = user ? user : "";
  const char* w = website ? website : "";
  const char* n = notes ? notes : "";
  if (!u[0] && !w[0] && !n[0]) {
    strncpy(out, s, outCap - 1);
    out[outCap - 1] = 0;
    g_pwMetaComposeTruncated = (strlen(s) > outCap - 1);
    return;
  }
  int r = snprintf(out, outCap, "%s | %s | %s | %s", s, u, w, n);
  if (r < 0 || (size_t)r >= outCap) g_pwMetaComposeTruncated = true;
}

