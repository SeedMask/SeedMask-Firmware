// Note body: map character index to (line, col) in wrapped layout; charsPerLine must match draw
static void noteCursorToLineCol(size_t cursorIndex, int* outLine, int* outCol) {
  const int charsPerLine = 24;
  int line = 0, col = 0;
  size_t i = 0;
  while (i < cursorIndex && g_editBuf[i]) {
    if (g_editBuf[i] == '\n') {
      line++;
      col = 0;
      i++;
    } else {
      col++;
      if (col >= charsPerLine) {
        line++;
        col = 0;
      }
      i++;
    }
  }
  *outLine = line;
  *outCol = col;
}

// Note body: map (line, col) to character index
static size_t noteLineColToIndex(int line, int col) {
  const int charsPerLine = 24;
  int curLine = 0, curCol = 0;
  size_t i = 0;
  while (g_editBuf[i] && (curLine < line || (curLine == line && curCol < col))) {
    if (g_editBuf[i] == '\n') {
      curLine++;
      curCol = 0;
      i++;
    } else {
      curCol++;
      if (curCol >= charsPerLine) {
        curLine++;
        curCol = 0;
      }
      i++;
    }
  }
  return i;
}

// Note body: character length of a given line (for horizontal scroll cap — no blank area)
static int noteGetLineLength(int lineIndex) {
  const int charsPerLine = 24;
  size_t lineStart = noteLineColToIndex(lineIndex, 0);
  size_t len = strlen(g_editBuf);
  int n = 0;
  size_t i = lineStart;
  while (i < len && g_editBuf[i] != '\n' && n < charsPerLine) {
    n++;
    i++;
  }
  return n;
}

// Pad buffer with newlines/spaces so (tapLine, tapCol) is a valid position; set g_editCursor there so typing writes at tap position
static void notePadToLineCol(int tapLine, int tapCol) {
  const int charsPerLine = 24;
  size_t len = strlen(g_editBuf);
  int curLine = 0, curCol = 0;
  if (len > 0) noteCursorToLineCol(len, &curLine, &curCol);
  if (tapLine < curLine || (tapLine == curLine && tapCol <= curCol)) {
    size_t idx = noteLineColToIndex(tapLine, tapCol);
    if (idx > len) idx = len;
    g_editCursor = (uint16_t)idx;
    return;
  }
  size_t cap = sizeof(g_editBuf) - 1;
  while (curLine < tapLine && len < cap) {
    g_editBuf[len++] = '\n';
    g_editBuf[len] = 0;
    curLine++;
    curCol = 0;
  }
  while (curCol < tapCol && len < cap) {
    g_editBuf[len++] = ' ';
    g_editBuf[len] = 0;
    curCol++;
  }
  g_editCursor = (uint16_t)len;
}

// Extra lines of scroll below content (Samsung Notes–style, but capped — not infinite)
#define NOTE_EXTRA_SCROLL_LINES 50

// Full-screen note body editor: multi-line, cursor, vertical/horizontal scroll, tap-to-position (Samsung-like)
static void drawNoteBodyScreen() {
  gfx->fillScreen(RGB565_BLACK);
  if (g_editingTitle)
    drawTopBarEditableTitle();
  else
    drawTopBar(g_tmpTitle[0] ? g_tmpTitle : "New note", true);

  const int areaX = 8, areaY = 48, areaW = LCD_W - 16, areaH = (KB_Y0_DEFAULT - 2) - areaY;
  const int lineH = 18, charsPerLine = 24, charW = 12;
  const int pad = 6;
  const int visibleLines = areaH / lineH;

  // When editing title: show saved body (no cursor). Else: g_editBuf and cursor.
  const char* bodyDisplayBuf = g_editBuf;
  size_t len = strlen(g_editBuf);
  if (g_editingTitle && g_viewNoteIndex < g_noteCount) {
    bodyDisplayBuf = g_noteItems[g_viewNoteIndex].body;
    len = strlen(bodyDisplayBuf);
  } else {
    if (g_editCursor > len) g_editCursor = (uint16_t)len;
  }

  gfx->fillRect(areaX, areaY, areaW, areaH, RGB565_BLACK);
  gfx->drawRect(areaX, areaY, areaW, areaH, UI_BORDER);

  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);

  int startLine = (int)g_noteScrollLine;
  if (startLine < 0) startLine = 0;
  int curLineIdx = 0, curColIdx = 0;
  int totalLines = 0;
  int visibleWidth = areaW - 2 * pad;
  int maxOffsetPx = 0;
  int drawX0 = areaX + pad;
  int skipChars = 0;

  if (g_editingTitle) {
    // Display only: draw first visibleLines lines from bodyDisplayBuf (no cursor, no scroll from g_editBuf)
    size_t i = 0;
    for (int v = 0; v < visibleLines && i < len; v++) {
      int cy = areaY + pad + v * lineH;
      int cx = areaX + pad;
      char lineBuf[32];
      int outIdx = 0;
      int n = 0;
      while (i < len && bodyDisplayBuf[i] != '\n' && n < charsPerLine && outIdx < (int)sizeof(lineBuf) - 1) {
        lineBuf[outIdx++] = bodyDisplayBuf[i];
        n++;
        i++;
      }
      lineBuf[outIdx] = 0;
      if (outIdx > 0) {
        gfx->setCursor(cx, cy);
        gfx->print(lineBuf);
      }
      if (i < len && bodyDisplayBuf[i] == '\n') i++;
    }
  } else {
    noteCursorToLineCol((size_t)g_editCursor, &curLineIdx, &curColIdx);
    if (len > 0) {
      int tl, tc;
      noteCursorToLineCol(len, &tl, &tc);
      totalLines = tl + 1;
    }
    int maxScroll = totalLines - visibleLines + NOTE_EXTRA_SCROLL_LINES;
    if (maxScroll < 0) maxScroll = 0;
    if (curLineIdx < startLine) g_noteScrollLine = (uint16_t)curLineIdx;
    if (curLineIdx >= startLine + visibleLines) g_noteScrollLine = (uint16_t)(curLineIdx - visibleLines + 1);
    if ((int)g_noteScrollLine > maxScroll) g_noteScrollLine = (uint16_t)maxScroll;
    startLine = (int)g_noteScrollLine;

    int maxLineChars = 0;
    for (int v = 0; v < visibleLines; v++) {
      int lineLen = noteGetLineLength(startLine + v);
      if (lineLen > maxLineChars) maxLineChars = lineLen;
    }
    maxOffsetPx = maxLineChars * charW - visibleWidth;
    if (maxOffsetPx < 0) maxOffsetPx = 0;
    if (g_noteViewOffsetPx > maxOffsetPx) g_noteViewOffsetPx = maxOffsetPx;
    int cursorColPx = curColIdx * charW;
    if (cursorColPx < g_noteViewOffsetPx) g_noteViewOffsetPx = cursorColPx;
    if (cursorColPx + charW > visibleWidth + g_noteViewOffsetPx) g_noteViewOffsetPx = cursorColPx + charW - visibleWidth;
    if (g_noteViewOffsetPx < 0) g_noteViewOffsetPx = 0;
    if (g_noteViewOffsetPx > maxOffsetPx) g_noteViewOffsetPx = maxOffsetPx;
    if (g_noteViewOffsetPx > 0) skipChars = g_noteViewOffsetPx / charW;
    drawX0 = areaX + pad - (g_noteViewOffsetPx % charW);

    for (int v = 0; v < visibleLines; v++) {
      int lineIndex = startLine + v;
      size_t lineStart = noteLineColToIndex(lineIndex, 0);
      if (lineStart >= len) break;
      int cy = areaY + pad + v * lineH;
      int cx = drawX0;
      char lineBuf[32];
      int outIdx = 0;
      int n = 0;
      size_t i = lineStart;
      while (i < len && g_editBuf[i] != '\n' && n < charsPerLine && outIdx < (int)sizeof(lineBuf) - 1) {
        if (n >= skipChars)
          lineBuf[outIdx++] = g_editBuf[i];
        n++;
        i++;
      }
      lineBuf[outIdx] = 0;
      if (outIdx > 0) {
        gfx->setCursor(cx, cy);
        gfx->print(lineBuf);
      }
    }
  }

  // Blinking cursor in body only when NOT editing title (title has its own cursor in top bar)
  if (!g_editingTitle) {
    int drawCurLine = g_noteVisualCursorLine;
    int drawCurCol = g_noteVisualCursorCol;
    int cursorVisLine = drawCurLine - startLine;
    if (cursorVisLine >= 0 && cursorVisLine < visibleLines) {
      int cursorColPx = drawCurCol * charW - g_noteViewOffsetPx;
      if (cursorColPx >= -charW && cursorColPx < areaW - pad) {
        bool cursorOn = cursorShouldBeSolidNow() || (((millis() / 700) & 1) == 0);
        if (cursorOn) {
          int cursorX = areaX + pad + cursorColPx;
          int cursorY = areaY + pad + cursorVisLine * lineH;
          gfx->drawLine(cursorX, cursorY - 2, cursorX, cursorY + lineH - 2, UI_ACCENT);
        }
      }
    }
  }

  if (!len) {
    const uint16_t metaColor = blendRGB565(UI_TEXT, RGB565_DARKGREY, g_pwListDetailedView ? 0.35f : 0.20f);
    gfx->setTextColor(metaColor);
    gfx->setCursor(areaX + pad, areaY + pad);
    gfx->print("Type your note...");
    gfx->setTextColor(UI_TEXT);
  }

  drawKeyboard();
  // No BACK button here; use swipe or on-screen actions to exit
  if (g_msg[0]) menu_draw_message_card_overlay();
  ui_flush();
}

