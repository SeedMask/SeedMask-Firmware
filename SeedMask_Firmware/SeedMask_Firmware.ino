static void handleSeedEntryTap(uint16_t x, uint16_t y) {
  // Tap on a suggestion: fill the field, blink, then commit (no OK needed).
  for (uint8_t i = 0; i < g_sugN; i++) {
    if (hit(SUG_AREA[i], x, y)) {
      strncpy(g_wordBuf, g_sug[i], sizeof(g_wordBuf) - 1);
      g_wordBuf[sizeof(g_wordBuf) - 1] = 0;
      updateSuggestions();
      setMsg("");
      s_suggestionFlashIndex = (int8_t)i;
      for (int b = 0; b < 4; b++) {
        s_suggestionFlashHighlight = (b % 2 == 1);
        draw();
        delay(90);
      }
      s_suggestionFlashIndex = -1;
      bool ok = commitWord(g_wordBuf);
      (void)ok;
      if (g_seedCount == g_wc) {
        setMsg("All words entered.");
        show(UIScreen::BACKUP_REVIEW_WORDS);
        return;
      }
      draw();
      return;
    }
  }

  char c = keyboardHit(x, y);
  if (c) {
    if (c == '\b') backspaceWordBuf();
    else appendToWordBuf(c);
    draw();
    return;
  }

  if (hitOkKey(x, y)) {
    bool ok = commitWord(g_wordBuf);
    if (!ok) {
      draw();
      return;
    }
    if (g_seedCount == g_wc) {
      setMsg("All words entered.");
      show(UIScreen::BACKUP_REVIEW_WORDS);
      return;
    }
    draw();
    return;
  }
}

static void handleBackupReviewWordsTap(uint16_t x, uint16_t y) {
  if (hit(BTN_BACKUP_REVIEW_CONTINUE, x, y)) {
    if (g_tempSeedImportMode == TempSeedImportMode::MANUAL_WORDS) {
      if (!temp_seed_set_from_words((const char(*)[16])g_seed, g_wc, (uint8_t)TempSeedActiveSource::MANUAL_WORDS)) {
        if (g_msg[0] == 0) setMsg("Could not set temporary seed");
        draw();
        return;
      }
      g_tempSeedImportMode = TempSeedImportMode::NONE;
      setMsg("Temporary seed active");
      show(UIScreen::CRYPTO_TEMP_SEED);
      return;
    }
    // Restore → Seed → 12/24: words → screen lock → menu (no backup password / code).
    if (g_restoreSeedFlowActive) {
      g_restoreSeedFlowActive = false;
      pwSvc_clearAll();
      g_noteCount = 0;
      if (g_noteItems) memset(g_noteItems, 0, NOTE_ITEMS_TOTAL_BYTES);
      memset(g_totpItems, 0, sizeof(g_totpItems));
      g_totpCount = 0;
      memset(g_masterPw, 0, sizeof(g_masterPw));
      g_backupCode[0] = 0;
      portable_backup_clear();
      g_hasVault = false;
      g_restorePwNvsPending = false;
      session_login_from_seed((const char(*)[16])g_seed, g_wc, "");
      setMsg("");
      show_menu_or_onboard_lock_after_restore();
      return;
    }
    clearPassword(g_password1);
    clearPassword(g_password2);
    g_pwMasked = true;
    setMsg("Min 12 chars, A-Z, digit, symbol.");
    show(UIScreen::BACKUP_PASSWORD1);
    return;
  }
}

static void handleBackupPassword1Tap(uint16_t x, uint16_t y) {
  if (g_password1[0] && hit(BTN_PW_SHOWHIDE, x, y)) {
    g_pwMasked = !g_pwMasked;
    draw();
    return;
  }
  if (hitOkKey(x, y)) {
    flashKeyRectTranslucent(keyRectRow4[2]);
    if (!backup_password_ok_for_create(g_password1)) {
      draw();
      return;
    }
    clearPassword(g_password2);
    setMsg("Confirm password.");
    show(UIScreen::BACKUP_PASSWORD2);
    return;
  }
  passwordInputTap(x, y, g_password1, sizeof(g_password1));
}

static void handleBackupPassword2Tap(uint16_t x, uint16_t y) {
  if (g_password2[0] && hit(BTN_PW_SHOWHIDE, x, y)) {
    g_pwMasked = !g_pwMasked;
    draw();
    return;
  }
  if (hitOkKey(x, y)) {
    flashKeyRectTranslucent(keyRectRow4[2]);
    if (strcmp(g_password1, g_password2) != 0) {
      setMsg("Passwords differ.");
      clearPassword(g_password2);
      draw();
      return;
    }

    g_busy = true;
    g_spin = 0;
    setMsg("Generating...");
    draw();

    bool ok = make_backup_code_from_seed((const char(*)[16])g_seed, g_wc, g_password1, g_backupCode, sizeof(g_backupCode), !g_stateless);
    g_busy = false;

    if (!ok) {
      show(UIScreen::ERROR_SCREEN);
      return;
    }

    // Auto-save backup code to SD if SD is ready
    Serial.print("Checking SD readiness (from seed)... ");
    if (sd_ready()) {
      Serial.println("SD is ready, attempting auto-save...");
      if (backup_code_save_to_sd(g_backupCode, g_password1, (const char(*)[16])g_seedGen, g_wc)) {
        Serial.println("Auto-save successful (from seed)!");
        char saved[96];
        snprintf(saved, sizeof(saved), "Backup code saved to microSD as %s", backup_code_sd_basename());
        setMsg(saved);
        draw();  // Refresh screen to show message
      } else {
        Serial.println("Auto-save failed (from seed)!");
        setMsg("Auto-save failed!");
        draw();  // Refresh screen to show message
      }
    } else {
      Serial.println("SD is not ready, skipping auto-save (from seed)");
      strncpy(g_msg, "SD not ready for backup", sizeof(g_msg) - 1);
      g_msg[sizeof(g_msg) - 1] = 0;
    }

    session_login_from_seed((const char(*)[16])g_seed, g_wc, g_backupCode);
    portable_backup_set_from_code(g_backupCode);
    show(UIScreen::BACKUP_SHOW_CODE);
    return;
  }
  passwordInputTap(x, y, g_password2, sizeof(g_password2));
}

// Opens vault QR from Passwords→BACKUP (QR button).
static void openVaultQrFromBackupFlow() {
  if (!g_backupCode[0]) {
    setMsg("No code yet");
