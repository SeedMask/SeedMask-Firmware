// --- Breakout (duress mini-game) ---
#define BO_COLS 10
#define BO_ROWS 5
#define BO_BRICK_X0 7
#define BO_BRICK_Y0 58
#define BO_BRICK_W 28
#define BO_BRICK_H 9
#define BO_GAP 2
#define BO_PADDLE_W 58
#define BO_PADDLE_H 8
#define BO_PADDLE_Y 448
#define BO_BALL_R 4
#define BO_PADDLE_ZONE_TOP 380
#define BO_FIELD_TOP 48
static uint8_t g_breakoutBricks[BO_COLS * BO_ROWS];
static float g_breakoutPaddleX = 160.f;
static float g_breakoutBallX = 160.f;
static float g_breakoutBallY = 320.f;
static float g_breakoutVelX = 3.9f;
static float g_breakoutVelY = -4.2f;
static bool g_breakoutDead = false;
static uint16_t g_breakoutScore = 0;
static uint32_t g_breakoutLastTickMs = 0;

static inline bool breakout_brick_alive(int idx) {
  return g_breakoutBricks[idx] != 0;
}
static inline void breakout_clear_bricks() {
  memset(g_breakoutBricks, 1, sizeof(g_breakoutBricks));
}
static inline float breakout_brick_left(int c) {
  return (float)(BO_BRICK_X0 + c * (BO_BRICK_W + BO_GAP));
}
static inline float breakout_brick_top(int r) {
  return (float)(BO_BRICK_Y0 + r * (BO_BRICK_H + BO_GAP));
}

static bool breakout_circle_rect_hit(float cx, float cy, float r, float rx, float ry, float rw, float rh) {
  float nx = cx;
  if (nx < rx) nx = rx;
  else if (nx > rx + rw) nx = rx + rw;
  float ny = cy;
  if (ny < ry) ny = ry;
  else if (ny > ry + rh) ny = ry + rh;
  float dx = cx - nx, dy = cy - ny;
  return (dx * dx + dy * dy) < r * r;
}

static void duress_breakout_reset_ball_in_play() {
  g_breakoutBallX = g_breakoutPaddleX;
  g_breakoutBallY = (float)BO_PADDLE_Y - (float)BO_BALL_R - (float)BO_PADDLE_H - 6.f;
  g_breakoutVelX = (random(0, 2) == 0) ? 4.4f : -4.4f;
  g_breakoutVelY = -4.6f;
}

static void duress_breakout_reset_full() {
  breakout_clear_bricks();
  g_breakoutPaddleX = 160.f;
  g_breakoutDead = false;
  g_breakoutScore = 0;
  duress_breakout_reset_ball_in_play();
  g_breakoutLastTickMs = millis();
}

static uint8_t duress_breakout_bricks_remaining() {
  uint8_t n = 0;
  for (int i = 0; i < BO_COLS * BO_ROWS; i++)
    if (breakout_brick_alive(i)) n++;
  return n;
}

static void duress_breakout_tick() {
  if (g_breakoutDead) return;
  float bx = g_breakoutBallX + g_breakoutVelX;
  float by = g_breakoutBallY + g_breakoutVelY;
  float br = (float)BO_BALL_R;

  // Walls left/right
  if (bx - br < 2.f) {
    bx = br + 2.f;
    g_breakoutVelX = fabsf(g_breakoutVelX);
  } else if (bx + br > (float)LCD_W - 2.f) {
    bx = (float)LCD_W - 2.f - br;
    g_breakoutVelX = -fabsf(g_breakoutVelX);
  }
  // Ceiling
  if (by - br < (float)BO_FIELD_TOP) {
    by = (float)BO_FIELD_TOP + br;
    g_breakoutVelY = fabsf(g_breakoutVelY);
  }

  // Brick collisions (one brick per tick max)
  bool hitBrick = false;
  for (int r = 0; r < BO_ROWS && !hitBrick; r++) {
    for (int c = 0; c < BO_COLS && !hitBrick; c++) {
      int idx = r * BO_COLS + c;
      if (!breakout_brick_alive(idx)) continue;
      float rx = breakout_brick_left(c);
      float ry = breakout_brick_top(r);
      if (breakout_circle_rect_hit(bx, by, br, rx, ry, (float)BO_BRICK_W, (float)BO_BRICK_H)) {
        g_breakoutBricks[idx] = 0;
        g_breakoutScore += 10;
        hitBrick = true;
        g_breakoutVelY = -g_breakoutVelY;
      }
    }
  }

  // Paddle (only when moving down into paddle band)
  float phw = (float)BO_PADDLE_W * 0.5f;
  float pl = g_breakoutPaddleX - phw;
  float pr = g_breakoutPaddleX + phw;
  float py = (float)BO_PADDLE_Y;
  if (g_breakoutVelY > 0.f && by + br >= py && by + br <= py + (float)BO_PADDLE_H + 10.f
      && bx >= pl - br && bx <= pr + br && by < py + (float)BO_PADDLE_H + br) {
    by = py - br;
    g_breakoutVelY = -fabsf(g_breakoutVelY);
    float hit = (bx - g_breakoutPaddleX) / phw;
    if (hit > 1.f) hit = 1.f;
    if (hit < -1.f) hit = -1.f;
    g_breakoutVelX += hit * 2.2f;
    if (g_breakoutVelX > 7.5f) g_breakoutVelX = 7.5f;
    if (g_breakoutVelX < -7.5f) g_breakoutVelX = -7.5f;
    if (fabsf(g_breakoutVelY) < 3.5f) g_breakoutVelY = -3.8f;
  }

  g_breakoutBallX = bx;
  g_breakoutBallY = by;

  if (g_breakoutBallY - br > (float)LCD_H + 6.f) {
    g_breakoutDead = true;
    return;
  }

  if (duress_breakout_bricks_remaining() == 0) {
    g_breakoutScore += 100;
    breakout_clear_bricks();
    duress_breakout_reset_ball_in_play();
  }
}

// --- Space Blaster (duress mini-game): enemy formation + auto-fire + powerups ---
#define DS_COLS 6
#define DS_ROWS 3
#define DS_EW 28
#define DS_EH 11
#define DS_GAP 6
#define DS_FORM_TOP 62
#define DS_PLAYER_Y 452
#define DS_PLAYER_W 38
#define DS_PLAYER_H 12
#define DS_BULLET_SPEED 7.f
#define DS_BULLET_MAX 10
#define DS_SHOT_INTERVAL_MS 240
#define DS_PADDLE_ZONE_TOP 380
#define DS_PU_MAX 6
#define DS_PU_FALL_SPD 2.85f
#define DS_PU_DUR_MS 5200

enum : uint8_t { DS_PU_RAPID = 0,
                 DS_PU_SPREAD = 1,
                 DS_PU_WIDE = 2,
                 DS_PU_SLOW = 3 };

static float g_dsPlayerX = 160.f;
static float g_dsAnchorX = 18.f;
static float g_dsAnchorY = 62.f;
static float g_dsVelX = 2.1f;
/** Enemy ship still active (1) or destroyed (0). Hitbox: full DS_EW×DS_EH cell. */
static uint8_t g_dsEnemy[DS_COLS * DS_ROWS];
static struct {
  bool on;
  float x, y;
} g_dsBullets[DS_BULLET_MAX];
static struct {
  bool on;
  float x, y;
  uint8_t kind;
} g_dsPuFall[DS_PU_MAX];
static uint32_t g_dsPuRapidEndMs = 0;
static uint32_t g_dsPuSpreadEndMs = 0;
static uint32_t g_dsPuWideEndMs = 0;
static uint32_t g_dsPuSlowEndMs = 0;
static uint16_t g_dsScore = 0;
static uint8_t g_dsWave = 1;
static bool g_dsDead = false;
static uint32_t g_dsLastTickMs = 0;
static uint32_t g_dsNextShotMs = 0;

static int duress_space_player_half_w_i() {
  uint32_t t = millis();
  if (t < g_dsPuWideEndMs) return (DS_PLAYER_W + 24) / 2;
  return DS_PLAYER_W / 2;
}

static bool duress_space_enemies_remain() {
  for (int i = 0; i < DS_COLS * DS_ROWS; i++)
    if (g_dsEnemy[i]) return true;
  return false;
}

static void duress_space_clear_falling_powerups() {
  for (int i = 0; i < DS_PU_MAX; i++) g_dsPuFall[i].on = false;
}

static void duress_space_formation_bounds(float ax, float* minL, float* maxR, float* lowY) {
  *minL = 99999.f;
  *maxR = -99999.f;
  *lowY = -99999.f;
  for (int r = 0; r < DS_ROWS; r++) {
    for (int c = 0; c < DS_COLS; c++) {
      int idx = r * DS_COLS + c;
      if (!g_dsEnemy[idx]) continue;
      float ex = ax + (float)c * (float)(DS_EW + DS_GAP);
      float ey = g_dsAnchorY + (float)r * (float)(DS_EH + DS_GAP);
      if (ex < *minL) *minL = ex;
      float er = ex + (float)DS_EW;
      if (er > *maxR) *maxR = er;
      float eb = ey + (float)DS_EH;
      if (eb > *lowY) *lowY = eb;
    }
  }
}

static void duress_space_reset_formation() {
  for (int i = 0; i < DS_COLS * DS_ROWS; i++) g_dsEnemy[i] = 1;
  g_dsAnchorX = 18.f;
  g_dsAnchorY = (float)DS_FORM_TOP;
  float sp = 1.65f + 0.14f * (float)(g_dsWave - 1);
  if (sp > 3.6f) sp = 3.6f;
  g_dsVelX = sp;
}

static void duress_space_reset_full() {
  g_dsPlayerX = 160.f;
  g_dsScore = 0;
  g_dsWave = 1;
  g_dsDead = false;
  g_dsPuRapidEndMs = g_dsPuSpreadEndMs = g_dsPuWideEndMs = g_dsPuSlowEndMs = 0;
  for (int i = 0; i < DS_BULLET_MAX; i++) g_dsBullets[i].on = false;
  duress_space_clear_falling_powerups();
  duress_space_reset_formation();
  g_dsLastTickMs = millis();
  g_dsNextShotMs = millis();
}

static void duress_space_next_wave() {
  duress_space_clear_falling_powerups();
  for (int i = 0; i < DS_BULLET_MAX; i++) g_dsBullets[i].on = false;
  g_dsScore = (uint16_t)((unsigned)g_dsScore + 35u + 20u * (unsigned)g_dsWave);
  if (g_dsWave < 250) g_dsWave++;
  duress_space_reset_formation();
}

static bool duress_space_try_fire_one(float x, float y) {
  for (int i = 0; i < DS_BULLET_MAX; i++) {
    if (!g_dsBullets[i].on) {
      g_dsBullets[i].on = true;
      g_dsBullets[i].x = x;
      g_dsBullets[i].y = y;
      return true;
    }
  }
  return false;
}

static void duress_space_try_spawn_powerup(float cx, float cy) {
  if (random(0, 100) >= 22) return;
  for (int i = 0; i < DS_PU_MAX; i++) {
    if (g_dsPuFall[i].on) continue;
    g_dsPuFall[i].on = true;
    g_dsPuFall[i].x = cx;
    g_dsPuFall[i].y = cy;
    g_dsPuFall[i].kind = (uint8_t)random(0, 4);
    return;
  }
}

static void duress_space_tick() {
  if (g_dsDead) return;
  if (!duress_space_enemies_remain()) {
    duress_space_next_wave();
    return;
  }

  uint32_t now = millis();

  for (int i = 0; i < DS_BULLET_MAX; i++) {
    if (!g_dsBullets[i].on) continue;
    g_dsBullets[i].y -= DS_BULLET_SPEED;
    if (g_dsBullets[i].y < 44.f) g_dsBullets[i].on = false;
  }

  for (int bi = 0; bi < DS_BULLET_MAX; bi++) {
    if (!g_dsBullets[bi].on) continue;
    float bx = g_dsBullets[bi].x;
    float by = g_dsBullets[bi].y;
    bool hitEnemy = false;
    for (int r = 0; r < DS_ROWS && !hitEnemy; r++) {
      for (int c = 0; c < DS_COLS && !hitEnemy; c++) {
        int idx = r * DS_COLS + c;
        if (!g_dsEnemy[idx]) continue;
        float ex = g_dsAnchorX + (float)c * (float)(DS_EW + DS_GAP);
        float ey = g_dsAnchorY + (float)r * (float)(DS_EH + DS_GAP);
        if (bx >= ex - 1.f && bx <= ex + (float)DS_EW + 1.f && by <= ey + (float)DS_EH + 3.f && by >= ey - 3.f) {
          g_dsEnemy[idx] = 0;
          g_dsBullets[bi].on = false;
          g_dsScore = (uint16_t)((unsigned)g_dsScore + 15u);
          duress_space_try_spawn_powerup(ex + (float)DS_EW * 0.5f, ey + (float)DS_EH * 0.5f);
          hitEnemy = true;
        }
      }
    }
  }

  if (!duress_space_enemies_remain()) {
    duress_space_next_wave();
    return;
  }

  {
    int phw = duress_space_player_half_w_i();
    float pl = g_dsPlayerX - (float)phw - 2.f;
    float pr = g_dsPlayerX + (float)phw + 2.f;
    float pt = (float)DS_PLAYER_Y - (float)DS_PLAYER_H - 6.f;
    float pb = (float)DS_PLAYER_Y + 4.f;
    for (int pi = 0; pi < DS_PU_MAX; pi++) {
      if (!g_dsPuFall[pi].on) continue;
      g_dsPuFall[pi].y += DS_PU_FALL_SPD;
      float px = g_dsPuFall[pi].x;
      float py = g_dsPuFall[pi].y;
      if (py > (float)LCD_H + 12.f) {
        g_dsPuFall[pi].on = false;
        continue;
      }
      if (px >= pl && px <= pr && py >= pt && py <= pb) {
        switch (g_dsPuFall[pi].kind) {
          case DS_PU_RAPID: g_dsPuRapidEndMs = now + DS_PU_DUR_MS; break;
          case DS_PU_SPREAD: g_dsPuSpreadEndMs = now + DS_PU_DUR_MS; break;
          case DS_PU_WIDE: g_dsPuWideEndMs = now + DS_PU_DUR_MS; break;
          case DS_PU_SLOW: g_dsPuSlowEndMs = now + DS_PU_DUR_MS; break;
          default: break;
        }
        g_dsScore = (uint16_t)((unsigned)g_dsScore + 5u);
        g_dsPuFall[pi].on = false;
      }
    }
  }

  if (now >= g_dsNextShotMs) {
    float y0 = (float)DS_PLAYER_Y - 8.f;
    uint16_t interval = (now < g_dsPuRapidEndMs) ? 105 : DS_SHOT_INTERVAL_MS;
    bool fired = false;
    if (now < g_dsPuSpreadEndMs) {
      fired |= duress_space_try_fire_one(g_dsPlayerX - 13.f, y0);
      fired |= duress_space_try_fire_one(g_dsPlayerX, y0);
      fired |= duress_space_try_fire_one(g_dsPlayerX + 13.f, y0);
    } else {
      fired = duress_space_try_fire_one(g_dsPlayerX, y0);
    }
    if (fired) g_dsNextShotMs = now + interval;
  }

  float slowMul = (now < g_dsPuSlowEndMs) ? 0.54f : 1.f;
  float nextAx = g_dsAnchorX + g_dsVelX * slowMul;
  float minL = 0.f, maxR = 0.f, lowY = 0.f;
  duress_space_formation_bounds(nextAx, &minL, &maxR, &lowY);
  if (minL > 9000.f) {
    duress_space_next_wave();
    return;
  }
  if (minL < 5.f || maxR > (float)LCD_W - 6.f) {
    g_dsVelX = -g_dsVelX;
    g_dsAnchorY += 9.f;
    duress_space_formation_bounds(g_dsAnchorX, &minL, &maxR, &lowY);
  } else {
    g_dsAnchorX = nextAx;
    duress_space_formation_bounds(g_dsAnchorX, &minL, &maxR, &lowY);
  }

  if (lowY > -9000.f && lowY >= (float)DS_PLAYER_Y - 9.f) g_dsDead = true;
}

/** Procedural enemy fighter — drawn inside cell; collision still uses full DS_EW×DS_EH rect. */
static void duress_space_draw_enemy_ship(int16_t ex, int16_t ey, int16_t cellW, int16_t cellH, uint16_t hull,
                                         uint16_t rim) {
  if (cellW < 10 || cellH < 7) return;
  int bodyY = ey + (cellH * 4) / 11;
  int bodyH = (ey + cellH) - bodyY - 1;
  if (bodyH < 2) bodyH = 2;
  int bodyW = cellW - 4;
  int rad = bodyH / 3;
  if (rad < 1) rad = 1;
  if (rad > 3) rad = 3;
  gfx->fillRoundRect((int16_t)(ex + 2), (int16_t)bodyY, bodyW, bodyH, (int16_t)rad, hull);
  gfx->drawRoundRect((int16_t)(ex + 2), (int16_t)bodyY, bodyW, bodyH, (int16_t)rad, rim);
  int noseY = ey + cellH / 8;
  if (noseY >= bodyY) noseY = bodyY - 1;
  int cx = ex + cellW / 2;
  int wingL = ex + 2 + bodyW / 4;
  int wingR = ex + 2 + (3 * bodyW) / 4;
  gfx->fillTriangle((int16_t)cx, (int16_t)noseY, (int16_t)wingL, (int16_t)bodyY, (int16_t)wingR, (int16_t)bodyY, hull);
  gfx->drawTriangle((int16_t)cx, (int16_t)noseY, (int16_t)wingL, (int16_t)bodyY, (int16_t)wingR, (int16_t)bodyY, rim);
  int podW = bodyW / 6;
  if (podW < 2) podW = 2;
  int podH = (cellH * 4) / 11;
  if (podH < 2) podH = 2;
  gfx->fillRect(ex, (int16_t)bodyY + 1, (int16_t)podW, (int16_t)podH, hull);
  gfx->fillRect((int16_t)(ex + cellW - podW), (int16_t)bodyY + 1, (int16_t)podW, (int16_t)podH, hull);
  gfx->drawRect(ex, (int16_t)bodyY + 1, (int16_t)podW, (int16_t)podH, rim);
  gfx->drawRect((int16_t)(ex + cellW - podW), (int16_t)bodyY + 1, (int16_t)podW, (int16_t)podH, rim);
  uint16_t glow = RGB565(255, 130, 55);
  int engW = bodyW / 8;
  if (engW < 2) engW = 2;
  int engY = ey + cellH - 2;
  gfx->fillRect((int16_t)(cx - engW - engW / 2), (int16_t)engY, (int16_t)engW, 2, glow);
  gfx->fillRect((int16_t)(cx + engW / 2), (int16_t)engY, (int16_t)engW, 2, glow);
  if (cellH >= 9) {
    int winR = bodyH / 5;
    if (winR < 1) winR = 1;
    if (winR > 2) winR = 2;
    gfx->fillCircle((int16_t)cx, (int16_t)(bodyY + bodyH / 2), (int16_t)winR, RGB565(200, 230, 255));
  }
}

static void drawDuressSpace() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Blaster", true);
  for (int r = 0; r < DS_ROWS; r++) {
    for (int c = 0; c < DS_COLS; c++) {
      int idx = r * DS_COLS + c;
      if (!g_dsEnemy[idx]) continue;
      int ex = (int)(g_dsAnchorX + (float)c * (float)(DS_EW + DS_GAP));
      int ey = (int)(g_dsAnchorY + (float)r * (float)(DS_EH + DS_GAP));
      uint16_t hull =
        RGB565((uint8_t)(60 + (r * 5 + c * 7) % 120), (uint8_t)(200 - r * 25), (uint8_t)(90 + c * 12));
      uint16_t rim = RGB565(230, 242, 255);
      duress_space_draw_enemy_ship((int16_t)ex, (int16_t)ey, DS_EW, DS_EH, hull, rim);
    }
  }
  for (int i = 0; i < DS_BULLET_MAX; i++) {
    if (!g_dsBullets[i].on) continue;
    gfx->fillCircle((int)g_dsBullets[i].x, (int)g_dsBullets[i].y, 3, RGB565(255, 230, 120));
    gfx->fillCircle((int)g_dsBullets[i].x, (int)g_dsBullets[i].y - 4, 2, RGB565(255, 180, 40));
  }
  uint32_t drawNow = millis();
  for (int i = 0; i < DS_PU_MAX; i++) {
    if (!g_dsPuFall[i].on) continue;
    int px = (int)g_dsPuFall[i].x - 5;
    int py = (int)g_dsPuFall[i].y;
    uint16_t shell = RGB565(60, 55, 30);
    uint16_t fill = RGB565(255, 210, 70);
    gfx->fillRoundRect((int16_t)px, (int16_t)py, 10, 12, 2, fill);
    gfx->drawRoundRect((int16_t)px, (int16_t)py, 10, 12, 2, shell);
    gfx->setTextSize(1);
    gfx->setTextColor(RGB565(20, 18, 8));
    char tag[2] = { '?', 0 };
    switch (g_dsPuFall[i].kind) {
      case DS_PU_RAPID: tag[0] = 'R'; break;
      case DS_PU_SPREAD: tag[0] = '3'; break;
      case DS_PU_WIDE: tag[0] = 'W'; break;
      case DS_PU_SLOW: tag[0] = 'S'; break;
      default: break;
    }
    gfx->setCursor((int16_t)(px + 2), (int16_t)(py + 3));
    gfx->print(tag);
  }
  {
    int px = (int)g_dsPlayerX;
    int baseY = DS_PLAYER_Y;
    int halfW = duress_space_player_half_w_i();
    int tipY = baseY - DS_PLAYER_H;
    gfx->fillTriangle((int16_t)px, (int16_t)tipY, (int16_t)(px - halfW), (int16_t)baseY, (int16_t)(px + halfW),
                      (int16_t)baseY, RGB565(100, 200, 255));
    gfx->drawTriangle((int16_t)px, (int16_t)tipY, (int16_t)(px - halfW), (int16_t)baseY, (int16_t)(px + halfW),
                      (int16_t)baseY, RGB565(40, 90, 120));
  }
  gfx->setTextColor(RGB565_LIGHTGREY);
  gfx->setTextSize(1);
  char sb[40];
  snprintf(sb, sizeof(sb), "%u pts", (unsigned)g_dsScore);
  int sw = (int)strlen(sb) * 6;
  gfx->setCursor((int16_t)(LCD_W - 8 - sw), 50);
  gfx->print(sb);
  snprintf(sb, sizeof(sb), "W%u", (unsigned)g_dsWave);
  gfx->setCursor(8, 50);
  gfx->print(sb);
  gfx->setCursor(8, 62);
  gfx->print("Enemy wave — drag low");
  {
    int bx = 8;
    gfx->setCursor((int16_t)bx, 74);
    gfx->print("Pow:");
    bx += 30;
    if (drawNow < g_dsPuRapidEndMs) {
      gfx->setCursor((int16_t)bx, 74);
      gfx->print("R");
      bx += 10;
    }
    if (drawNow < g_dsPuSpreadEndMs) {
      gfx->setCursor((int16_t)bx, 74);
      gfx->print("3");
      bx += 10;
    }
    if (drawNow < g_dsPuWideEndMs) {
      gfx->setCursor((int16_t)bx, 74);
      gfx->print("W");
      bx += 10;
    }
    if (drawNow < g_dsPuSlowEndMs) {
      gfx->setCursor((int16_t)bx, 74);
      gfx->print("S");
    }
  }
  if (g_dsDead) {
    gfx->setTextColor(RGB565_ORANGE);
    const char* m = "Hull hit — tap to retry";
    int mw = (int)strlen(m) * 6;
    gfx->setCursor((int16_t)((LCD_W - mw) / 2), (int16_t)(LCD_H / 2 - 26));
    gfx->print(m);
  }
  drawSwipeBackHintOverlay();
  ui_flush();
}

