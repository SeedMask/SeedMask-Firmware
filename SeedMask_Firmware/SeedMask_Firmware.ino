// Cursor rendering: keep cursor solid briefly after typing to avoid perceived lag (especially in note body).
static uint32_t g_lastEditInputMs = 0;
static const uint32_t CURSOR_SOLID_AFTER_TYPE_MS = 600;

static bool cursorShouldBeSolidNow() {
  // While user is actively dragging/trackpadding, keep cursor solid (no blink).
  uint32_t now = millis();
  if (g_lastEditInputMs != 0 && (now - g_lastEditInputMs) < CURSOR_SOLID_AFTER_TYPE_MS)
    return true;
  return g_pwFieldDragging || g_noteFieldDragging || g_titleDragging || g_spaceTrackActive;
}

