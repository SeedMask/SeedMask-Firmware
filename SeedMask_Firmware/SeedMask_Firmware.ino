/** 2FA detail: secret box — wraps base32 across multiple lines and grows the rect downward (capped by screen). */
static void drawTfaShowStaticSecretReadonlyRow(int16_t boxY, const char* secret, uint16_t boxBorder565) {
  const int boxX = TFA_ADD_BOX_X, boxW = TFA_ADD_BOX_W;
  const int padX = 12;
  const int lineSkip = 20;
  const int innerPadY = 8;
  const int bottomPad = 12;
  const int maxCharsLine = (boxW - padX * 2) / 12;
  int slen = (int)strlen(secret);
  if (slen <= 0 || maxCharsLine <= 0) {
    drawTfaShowStaticReadonlyRow(boxY, "Secret key", "-", boxBorder565);
    return;
  }
  int linesNeeded = (slen + maxCharsLine - 1) / maxCharsLine;
  int maxLines = (LCD_H - boxY - bottomPad - innerPadY * 2) / lineSkip;
  if (maxLines < 1)
    maxLines = 1;
  int nLines = linesNeeded;
  if (nLines > maxLines)
    nLines = maxLines;
  int boxH = innerPadY * 2 + nLines * lineSkip;
  if (boxH < TFA_ADD_BOX_H)
    boxH = TFA_ADD_BOX_H;

  gfx->setTextColor(RGB565_DARKGREY);
  gfx->setTextSize(1);
  gfx->setCursor(boxX, (int16_t)(boxY - 11));
  gfx->print("Secret key");
  gfx->fillRoundRect(boxX, boxY, boxW, boxH, 10, UI_CARD);
  gfx->drawRoundRect(boxX, boxY, boxW, boxH, 10, boxBorder565);
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  gfx->setTextWrap(false);
  int ty = boxY + innerPadY;
  for (int line = 0; line < nLines; ++line) {
    int off = line * maxCharsLine;
    if (off >= slen)
      break;
    char lineBuf[28];
    bool lastLine = (line == nLines - 1);
    bool truncated = lastLine && (slen - off) > maxCharsLine;
    if (truncated) {
      int c = maxCharsLine - 3;
      if (c < 1)
        c = 1;
      memcpy(lineBuf, secret + (size_t)off, (size_t)c);
      memcpy(lineBuf + (size_t)c, "...", 4);
    } else {
      int chunk = slen - off;
      if (chunk > maxCharsLine)
        chunk = maxCharsLine;
      memcpy(lineBuf, secret + (size_t)off, (size_t)chunk);
      lineBuf[chunk] = 0;
    }
    gfx->setCursor((int16_t)(boxX + padX), (int16_t)ty);
    gfx->print(lineBuf);
    ty += lineSkip;
  }
}

static void drawTfaShowCode() {
  gfx->fillScreen(RGB565_BLACK);
  char tfaTopTitle[48];
  tfaTopTitle[0] = 0;
  if (g_tfaShowIndex < g_totpCount) {
    char prov[48], acc[48];
    splitTotpLabel(g_totpItems[g_tfaShowIndex].label, prov, sizeof(prov), acc, sizeof(acc));
    const char* disp = prov[0] ? prov : g_totpItems[g_tfaShowIndex].label;
    copyEllipsized(disp, tfaTopTitle, sizeof(tfaTopTitle), 18);
  } else {
    strncpy(tfaTopTitle, "2FA", sizeof(tfaTopTitle) - 1);
    tfaTopTitle[sizeof(tfaTopTitle) - 1] = 0;
  }
  drawTopBar(tfaTopTitle[0] ? tfaTopTitle : "2FA", true);
  {
    int16_t odCx = (int16_t)(BTN_TFA_OVERFLOW.x + BTN_TFA_OVERFLOW.w / 2);
    int16_t odCy = (int16_t)(BTN_TFA_OVERFLOW.y + BTN_TFA_OVERFLOW.h / 2);
    drawTfaOverflowDots(odCx, odCy);
  }
  uint32_t ut = get_unix_time();
  if (ut == 0) {
    g_tfaShowOverflowOpen = false;
    g_showTfaRevealSecretConfirm = false;
    g_tfaRevealSecretStep = 0;
    gfx->setTextColor(RGB565_WHITE);
    gfx->setTextSize(1);
    gfx->setCursor(28, 160);
    gfx->print("Set time in Settings first.");
    // No BACK button; use swipe or menu navigation
    ui_flush();
    return;
  }
#if defined(MBEDTLS_SHA1_C) || defined(MBEDTLS_MD_C)
  if (g_tfaShowIndex < g_totpCount) {
    uint32_t code = totp_code(g_totpItems[g_tfaShowIndex].secret, ut);
    // 30s circular countdown (larger ring than list rows; detail screen only)
    {
      const int16_t detailClockR = 32;
      int secsLeft = 30 - (int)(ut % 30);
      if (secsLeft == 0) secsLeft = 30;
      float arcDeg = (secsLeft / 30.0f) * 360.0f;
      int16_t cx = (int16_t)(LCD_W / 2);
      int16_t cy = (int16_t)(160 - 10 - detailClockR);
      drawTfaRemainingRing(cx, cy, detailClockR, secsLeft, arcDeg, ut);
    }
    // Big code (updates when 30s expires via loop redraw) — "123 456" grouping
    char codeDisp[12];
    totpFormatCodeSpaced(code, codeDisp, sizeof(codeDisp));
    gfx->setTextColor(UI_ACCENT);
    gfx->setTextSize(5);
    int codeW = (int)strlen(codeDisp) * 30;
    gfx->setCursor((LCD_W - codeW) / 2, 160);
    gfx->print(codeDisp);
    gfx->setTextColor(UI_TEXT);
    // Name + Account (+ optional Secret key in same boxed style)
    {
      char prov[48], acc[48];
      char nameDisp[48], accDisp[48];
      splitTotpLabel(g_totpItems[g_tfaShowIndex].label, prov, sizeof(prov), acc, sizeof(acc));
      const char* nameStr = prov[0] ? prov : g_totpItems[g_tfaShowIndex].label;
      const int padX = 12;
      const int maxCharsLine = (TFA_ADD_BOX_W - padX * 2) / 12;
      copyEllipsized(nameStr, nameDisp, sizeof(nameDisp), maxCharsLine);
      if (acc[0])
        copyEllipsized(acc, accDisp, sizeof(accDisp), maxCharsLine);
      else {
        accDisp[0] = '-';
        accDisp[1] = 0;
      }
      const int16_t nameBoxY = (int16_t)(230 + 11);
      const int16_t accountBoxY = (int16_t)(nameBoxY + TFA_ADD_BOX_H + 20);
      drawTfaShowStaticReadonlyRow(nameBoxY, "Name", nameDisp);
      drawTfaShowStaticReadonlyRow(accountBoxY, "Account", accDisp);
      if (g_tfaKeyRevealed) {
        const char* s = g_totpItems[g_tfaShowIndex].secret;
        const int16_t secretBoxY = (int16_t)(accountBoxY + TFA_ADD_BOX_H + 20);
        drawTfaShowStaticSecretReadonlyRow(secretBoxY, s, RGB565_RED);
      }
    }
  }
#endif
  // No BACK button on TFA list; use swipe or other navigation

  if (g_tfaShowOverflowOpen && g_tfaShowIndex < g_totpCount)
    drawTfaShowOverflowMenu();

  if (g_showTfaRevealSecretConfirm) {
    const int popupW = 300;
    const int popupH = tfaRevealSecretConfirmPopupH(g_tfaRevealSecretStep);
    const int popupR = 12;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    gfx->fillRoundRect(popupX, popupY, popupW, popupH, popupR, UI_CARD);
    gfx->drawRoundRect(popupX, popupY, popupW, popupH, popupR, UI_ACCENT);
    const int tx = popupX + 12;
    int16_t y = (int16_t)(popupY + 14);
    gfx->setTextWrap(false);
    gfx->setTextSize(2);
    if (g_tfaRevealSecretStep == 1) {
      const int16_t lineSkip = 20;
      gfx->setTextColor(RGB565_RED);
      gfx->setCursor(tx, y);
      gfx->print("WARNING:");
      y += lineSkip + 4;
      gfx->setTextColor(RGB565_WHITE);
      gfx->setCursor(tx, y);
      gfx->print("This secret generates");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("valid login codes.");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("Anyone with it can use");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("your 2FA");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("until you revoke it at");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("the service.");
      y += (int16_t)(lineSkip + 4);
      gfx->setCursor(tx, y);
      gfx->print("Never film, stream, or");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("send this secret.");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("Do not enter it in");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("untrusted apps or sites.");
    } else {
      const int16_t lineSkip = 20;
      gfx->setTextColor(RGB565_YELLOW);
      gfx->setCursor(tx, y);
      gfx->print("REMEMBER:");
      y += lineSkip + 4;
      gfx->setCursor(tx, y);
      gfx->print("If you continue, the");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("key appears on screen.");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("Only Continue if you");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("trust your");
      y += lineSkip;
      gfx->setCursor(tx, y);
      gfx->print("surroundings.");
    }
    const int btnY = popupY + popupH - 48;
    drawBtn(Rect{ popupX + 10, btnY, 130, 44 }, "Cancel", RGB565_DARKGREY, 2);
    drawBtn(Rect{ popupX + 152, btnY, 130, 44 }, "Continue", UI_ACCENT, 2);
  }

  // Semi-transparent "Delete?" popup (same style as SD file delete)
  if (g_showTfaDeleteConfirm) {
    const int popupW = 260, popupH = 120, popupR = 12;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    uint16_t* fb = gfx->getFramebuffer();
    if (fb) {
      for (int py = popupY; py < popupY + popupH; py++) {
        for (int px = popupX; px < popupX + popupW; px++) {
          size_t idx = (size_t)py * (size_t)LCD_W + (size_t)px;
          uint16_t bg = fb[idx];
          fb[idx] = (uint16_t)(((bg & 0xF7DE) >> 1) + ((UI_CARD & 0xF7DE) >> 1));
        }
      }
    } else {
      gfx->fillRoundRect(popupX, popupY, popupW, popupH, popupR, UI_CARD);
    }
    gfx->drawRoundRect(popupX, popupY, popupW, popupH, popupR, UI_ACCENT);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(2);
    gfx->setCursor(popupX + (popupW - 12 * 7) / 2, popupY + 28);
    gfx->print("Delete?");
    drawBtn(Rect{ popupX + 20, popupY + 62, 100, 44 }, "Yes", RGB565_RED, 2);
    drawBtn(Rect{ popupX + 140, popupY + 62, 100, 44 }, "Cancel", RGB565_DARKGREY, 2);
  }

  ui_flush();
}

static void tfaAddDrawFieldRow(int16_t boxY, const char* labelText, char* buf, uint16_t& cur, uint16_t& viewOff, bool focused) {
  const int boxX = TFA_ADD_BOX_X, boxW = TFA_ADD_BOX_W, boxH = TFA_ADD_BOX_H;
  gfx->setTextColor(RGB565_DARKGREY);
  gfx->setTextSize(1);
  gfx->setCursor(boxX, boxY - 11);
  gfx->print(labelText);
  gfx->fillRoundRect(boxX, boxY, boxW, boxH, 10, UI_CARD);
  gfx->drawRoundRect(boxX, boxY, boxW, boxH, 10, focused ? UI_ACCENT : UI_BORDER);
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  const int charW = 12;
  const int padX = 12;
  const int maxChars = (boxW - padX * 2) / charW;
  size_t len = strlen(buf);
  if (cur > len) cur = (uint16_t)len;
  if (viewOff > (uint16_t)len) viewOff = (uint16_t)len;
  if (cur < viewOff) viewOff = cur;
  else if (cur > (uint16_t)(viewOff + maxChars)) viewOff = (uint16_t)(cur - maxChars);
  if (viewOff > (uint16_t)len) viewOff = (uint16_t)len;
  uint16_t start = viewOff;
  int textY = boxY + (boxH - 16) / 2;
  for (uint16_t i = start; i < (uint16_t)len && i < (uint16_t)(start + maxChars); i++) {
    gfx->setCursor(boxX + padX + (int)(i - start) * charW, textY);
    gfx->print(buf[i]);
  }
  if (focused) {
    bool cursorOn = cursorShouldBeSolidNow() || (((millis() / 700) & 1) == 0);
    if (cursorOn) {
      int cursorX = boxX + padX + ((int)cur - (int)start) * charW;
      gfx->drawLine(cursorX, textY - 14, cursorX, textY + 14, UI_ACCENT);
    }
  }
}

static void tfaAddPlaceCaret(uint16_t x, uint16_t& curPos, uint16_t& viewPos, const char* buf) {
  const int boxX = TFA_ADD_BOX_X, boxW = TFA_ADD_BOX_W, padX = 12, charW = 12;
  const int maxChars = (boxW - padX * 2) / charW;
  size_t len = strlen(buf);
  if (curPos > len) curPos = (uint16_t)len;
  uint16_t start = viewPos;
  int relX = (int)x - (boxX + padX);
  if (relX < 0) relX = 0;
  int idx = (relX / charW) + (int)start;
  if (idx < 0) idx = 0;
  if ((size_t)idx > len) idx = (int)len;
  curPos = (uint16_t)idx;
  if (curPos < viewPos) viewPos = curPos;
  else if (curPos > (uint16_t)(viewPos + maxChars)) viewPos = (uint16_t)(curPos - maxChars);
}

