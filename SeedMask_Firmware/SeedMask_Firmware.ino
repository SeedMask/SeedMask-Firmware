  Bip32Node n;
  memset(&n, 0, sizeof(n));
  if (!bip32_master_from_seed(seed, &n)) {
    addr_set_err("master");
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  const uint32_t purpose = 84;
  if (!bip32_ckd_priv(&n, purpose, true)) {
    addr_set_err("ckd purpose");
    secure_memzero(&n, sizeof(n));
    return false;
  }
  if (!bip32_ckd_priv(&n, 0, true)) {
    addr_set_err("ckd coin");
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint8_t parent_pub[33];
  if (!secp_pubkey_compressed(n.k, parent_pub)) {
    addr_set_err("parent pub");
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint8_t h160p[20];
  if (!hash160(parent_pub, sizeof(parent_pub), h160p)) {
    addr_set_err("hash160");
    secure_memzero(parent_pub, sizeof(parent_pub));
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint32_t parent_fp = ((uint32_t)h160p[0] << 24) | ((uint32_t)h160p[1] << 16) | ((uint32_t)h160p[2] << 8) | (uint32_t)h160p[3];
  secure_memzero(parent_pub, sizeof(parent_pub));
  secure_memzero(h160p, sizeof(h160p));
  if (!bip32_ckd_priv(&n, account, true)) {
    addr_set_err("ckd account");
    secure_memzero(&n, sizeof(n));
    return false;
  }

  uint8_t ver[4];
  if (classicXpub) {
    ver[0] = 0x04;
    ver[1] = 0x88;
    ver[2] = 0xb2;
    ver[3] = 0x1e;  // xpub (ckcc_xpub)
  } else {
    ver[0] = 0x04;
    ver[1] = 0xb2;
    ver[2] = 0x47;
    ver[3] = 0x46;  // zpub
  }

  uint8_t pub[33];
  if (!secp_pubkey_compressed(n.k, pub)) {
    addr_set_err("pubkey");
    secure_memzero(&n, sizeof(n));
    return false;
  }

  uint8_t serial[78];
  memcpy(serial, ver, 4);
  serial[4] = 3;
  serial[5] = (uint8_t)((parent_fp >> 24) & 0xff);
  serial[6] = (uint8_t)((parent_fp >> 16) & 0xff);
  serial[7] = (uint8_t)((parent_fp >> 8) & 0xff);
  serial[8] = (uint8_t)(parent_fp & 0xff);
  uint32_t child_num = 0x80000000u + account;
  serial[9] = (uint8_t)((child_num >> 24) & 0xff);
  serial[10] = (uint8_t)((child_num >> 16) & 0xff);
  serial[11] = (uint8_t)((child_num >> 8) & 0xff);
  serial[12] = (uint8_t)(child_num & 0xff);
  memcpy(serial + 13, n.c, 32);
  memcpy(serial + 45, pub, 33);
  secure_memzero(&n, sizeof(n));
  secure_memzero(pub, sizeof(pub));

  bool ok = base58check_encode(serial, sizeof(serial), out, outLen);
  secure_memzero(serial, sizeof(serial));
  if (!ok) addr_set_err("base58 xpub");
  return ok;
}

static bool current_master_xfp_u32(uint32_t* out) {
  if (!out) return false;
  if (!ensure_bip39_derived_seed_cached()) return false;
  uint8_t seed[64];
  memcpy(seed, g_bip39DerivedSeedCache, 64);
  Bip32Node m;
  memset(&m, 0, sizeof(m));
  if (!bip32_master_from_seed(seed, &m)) {
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  uint8_t pub[33];
  if (!secp_pubkey_compressed(m.k, pub)) {
    secure_memzero(&m, sizeof(m));
    return false;
  }
  uint8_t h160[20];
  if (!hash160(pub, sizeof(pub), h160)) {
    secure_memzero(pub, sizeof(pub));
    secure_memzero(&m, sizeof(m));
    return false;
  }
  *out = ((uint32_t)h160[0] << 24) | ((uint32_t)h160[1] << 16) | ((uint32_t)h160[2] << 8) | (uint32_t)h160[3];
  secure_memzero(h160, sizeof(h160));
  secure_memzero(pub, sizeof(pub));
  secure_memzero(&m, sizeof(m));
  return true;
}

// Cosigner-level node m/48'/0'/account'/(1'|2') or m/45'/i; parent_fp_bytes for BIP32 serialization (first 4 of HASH160(parent pub)).
static bool btc_multisig_derive_cosigner_node(AddrType t, uint32_t account, Bip32Node* outN, uint8_t parent_fp_bytes[4]) {
  if (!outN || !parent_fp_bytes) return false;
  addr_set_err("");
  if (!ensure_bip39_derived_seed_cached()) return false;
  uint8_t seed[64];
  memcpy(seed, g_bip39DerivedSeedCache, 64);
  Bip32Node n;
  memset(&n, 0, sizeof(n));
  if (!bip32_master_from_seed(seed, &n)) {
    addr_set_err("master");
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));

  uint32_t purpose = 0;
  uint32_t coin = 0;
  uint32_t script_type = 0;
  bool has_coin = true;
  memset(parent_fp_bytes, 0, 4);

  if (t == AddrType::P2WPKH) {
    purpose = 48;
    coin = 0;
    script_type = 2;
    has_coin = true;
  } else if (t == AddrType::P2SH_P2WPKH) {
    purpose = 48;
    coin = 0;
    script_type = 1;
    has_coin = true;
  } else if (t == AddrType::P2PKH) {
    purpose = 45;
    has_coin = false;
  } else {
    addr_set_err("bad multisig type");
    secure_memzero(&n, sizeof(n));
    return false;
  }

  if (!bip32_ckd_priv(&n, purpose, true)) {
    addr_set_err("ckd purpose");
    secure_memzero(&n, sizeof(n));
    return false;
  }

  if (has_coin) {
    if (!bip32_ckd_priv(&n, coin, true)) {
      addr_set_err("ckd coin");
      secure_memzero(&n, sizeof(n));
      return false;
    }
    if (!bip32_ckd_priv(&n, account, true)) {
      addr_set_err("ckd account");
      secure_memzero(&n, sizeof(n));
      return false;
    }

    uint8_t parent_pub[33];
    if (!secp_pubkey_compressed(n.k, parent_pub)) {
      addr_set_err("parent pub");
      secure_memzero(&n, sizeof(n));
      return false;
    }
    uint8_t h160p[20];
    if (!hash160(parent_pub, sizeof(parent_pub), h160p)) {
      addr_set_err("hash160");
      secure_memzero(parent_pub, sizeof(parent_pub));
      secure_memzero(&n, sizeof(n));
      return false;
    }
    parent_fp_bytes[0] = h160p[0];
    parent_fp_bytes[1] = h160p[1];
    parent_fp_bytes[2] = h160p[2];
    parent_fp_bytes[3] = h160p[3];
    secure_memzero(parent_pub, sizeof(parent_pub));
    secure_memzero(h160p, sizeof(h160p));

    if (!bip32_ckd_priv(&n, script_type, true)) {
      addr_set_err("ckd script_type");
      secure_memzero(&n, sizeof(n));
      return false;
    }
  } else {
    uint8_t parent_pub[33];
    if (!secp_pubkey_compressed(n.k, parent_pub)) {
      addr_set_err("parent pub");
      secure_memzero(&n, sizeof(n));
      return false;
    }
    uint8_t h160p[20];
    if (!hash160(parent_pub, sizeof(parent_pub), h160p)) {
      addr_set_err("hash160");
      secure_memzero(parent_pub, sizeof(parent_pub));
      secure_memzero(&n, sizeof(n));
      return false;
    }
    parent_fp_bytes[0] = h160p[0];
    parent_fp_bytes[1] = h160p[1];
    parent_fp_bytes[2] = h160p[2];
    parent_fp_bytes[3] = h160p[3];
    secure_memzero(parent_pub, sizeof(parent_pub));
    secure_memzero(h160p, sizeof(h160p));

    if (!bip32_ckd_priv(&n, account, false)) {
      addr_set_err("ckd cosigner");
      secure_memzero(&n, sizeof(n));
      return false;
    }
  }

  memcpy(outN, &n, sizeof(Bip32Node));
  secure_memzero(&n, sizeof(n));
  return true;
}

// Multisig xpub export (cosigner-level) using standard multisig derivation branches.
// We map UI "script types" onto:
// - Native SegWit  -> BIP48: m/48'/coin'/account'/2' (P2WSH) and Zpub version bytes
// - Nested SegWit  -> BIP48: m/48'/coin'/account'/1' (P2SH-P2WSH) and Ypub version bytes
// - Legacy         -> BIP45: m/45'/cosigner_index (P2SH multisig) using xpub version bytes
static bool btc_multisig_xpub(AddrType t, uint32_t account, char* out, size_t outLen) {
  if (!out || outLen < 80) {
    addr_set_err("buf");
    return false;
  }
  addr_set_err("");

  uint8_t ver[4];
  uint8_t depth = 0;
  uint32_t child_num = 0;

  if (t == AddrType::P2WPKH) {
    ver[0] = 0x02;
    ver[1] = 0xaa;
    ver[2] = 0x7e;
    ver[3] = 0xd3;  // Zpub (P2WSH)
    depth = 4;
    child_num = 0x80000000u + 2u;
  } else if (t == AddrType::P2SH_P2WPKH) {
    ver[0] = 0x02;
    ver[1] = 0x95;
    ver[2] = 0xb4;
    ver[3] = 0x3f;  // Ypub
    depth = 4;
    child_num = 0x80000000u + 1u;
  } else if (t == AddrType::P2PKH) {
    ver[0] = 0x04;
    ver[1] = 0x88;
    ver[2] = 0xb2;
    ver[3] = 0x1e;  // xpub
    depth = 2;
    child_num = account;
  } else {
    addr_set_err("bad multisig type");
    return false;
  }

  Bip32Node n;
  uint8_t parent_fp_bytes[4];
  memset(&n, 0, sizeof(n));
  if (!btc_multisig_derive_cosigner_node(t, account, &n, parent_fp_bytes)) return false;

  // Serialize xpub (Base58Check) from current node n.
  uint8_t pub[33];
  if (!secp_pubkey_compressed(n.k, pub)) {
    addr_set_err("pubkey");
    secure_memzero(&n, sizeof(n));
    return false;
  }

  uint8_t serial[78];
  memcpy(serial, ver, 4);
  serial[4] = depth;
  serial[5] = parent_fp_bytes[0];
  serial[6] = parent_fp_bytes[1];
  serial[7] = parent_fp_bytes[2];
  serial[8] = parent_fp_bytes[3];
  serial[9] = (uint8_t)((child_num >> 24) & 0xff);
  serial[10] = (uint8_t)((child_num >> 16) & 0xff);
  serial[11] = (uint8_t)((child_num >> 8) & 0xff);
  serial[12] = (uint8_t)(child_num & 0xff);
  memcpy(serial + 13, n.c, 32);
  memcpy(serial + 45, pub, 33);

  secure_memzero(&n, sizeof(n));
  secure_memzero(pub, sizeof(pub));

  bool ok = base58check_encode(serial, sizeof(serial), out, outLen);
  secure_memzero(serial, sizeof(serial));
  if (!ok) addr_set_err("base58 xpub");
  return ok;
}

static bool current_master_xfp(char outXfp[9]) {
  if (!outXfp) return false;
  memset(outXfp, 0, 9);
  if (!ensure_bip39_derived_seed_cached()) return false;
  uint8_t seed[64];
  memcpy(seed, g_bip39DerivedSeedCache, 64);
  Bip32Node m;
  memset(&m, 0, sizeof(m));
  if (!bip32_master_from_seed(seed, &m)) {
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  uint8_t pub[33];
  if (!secp_pubkey_compressed(m.k, pub)) {
    secure_memzero(&m, sizeof(m));
    return false;
  }
  uint8_t h160[20];
  bool ok = hash160(pub, sizeof(pub), h160);
  if (ok) hex4_to_upper(h160, outXfp);
  else
    outXfp[0] = 0;
  secure_memzero(h160, sizeof(h160));
  secure_memzero(pub, sizeof(pub));
  secure_memzero(&m, sizeof(m));
  return ok;
}

// BIP32 master fingerprint (first 4 bytes of HASH160(pubkey), 8 hex chars) for a BIP39 mnemonic; empty passphrase.
static bool bip39_mnemonic_words_fingerprint(const char words[][16], uint8_t wc, char outXfp[9]) {
  if (!outXfp || (wc != 12 && wc != 24)) return false;
  outXfp[0] = 0;
  char mnemonic[512];
  if (!build_mnemonic_string(words, wc, mnemonic, sizeof(mnemonic))) return false;
  uint8_t salt[8 + BIP39_PASSPHRASE_MAX_BYTES];
  memcpy(salt, "mnemonic", 8);
  const size_t passLen = 0;
  uint8_t seed[64];
  if (!pbkdf2_sha512((const uint8_t*)mnemonic, strlen(mnemonic), salt, 8 + passLen, 2048, seed, sizeof(seed))) {
    secure_memzero(mnemonic, sizeof(mnemonic));
    return false;
  }
  secure_memzero(mnemonic, sizeof(mnemonic));
  Bip32Node m;
  memset(&m, 0, sizeof(m));
  if (!bip32_master_from_seed(seed, &m)) {
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  uint8_t pub[33];
  if (!secp_pubkey_compressed(m.k, pub)) {
    secure_memzero(&m, sizeof(m));
    return false;
  }
  uint8_t h160[20];
  bool ok = hash160(pub, sizeof(pub), h160);
  if (ok) hex4_to_upper(h160, outXfp);
  secure_memzero(h160, sizeof(h160));
  secure_memzero(pub, sizeof(pub));
  secure_memzero(&m, sizeof(m));
  return ok;
}

