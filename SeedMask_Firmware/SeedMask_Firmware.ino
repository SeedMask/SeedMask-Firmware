  g_pwEditKeyboardVisible = false;
  g_pwEditFocusField = 0;
  g_pwEditUnlocked = false;
  pwEditCaptureOriginalSnapshot();
  draw();
}

static bool containsTokenCI(const char* text, const char* token) {
  if (!text || !token || !*token) return false;
  for (size_t i = 0; text[i]; i++) {
    size_t j = 0;
    while (token[j] && text[i + j]) {
      char a = text[i + j];
      char b = token[j];
      if (a >= 'A' && a <= 'Z') a = (char)(a - 'A' + 'a');
      if (b >= 'A' && b <= 'Z') b = (char)(b - 'A' + 'a');
      if (a != b) break;
      j++;
    }
    if (!token[j]) return true;
  }
  return false;
}

static void tfaIssuerIconFromLabel(const char* label, char* outIcon, uint16_t* outColor) {
  char icon = '2';
  uint16_t col = UI_ACCENT;
  const char* s = label ? label : "";

  if (containsTokenCI(s, "google") || containsTokenCI(s, "gmail") || containsTokenCI(s, "youtube")) {
    icon = 'G';
    col = RGB565_RED;
  } else if (containsTokenCI(s, "github")) {
    icon = 'H';
    col = RGB565_WHITE;
  } else if (containsTokenCI(s, "microsoft") || containsTokenCI(s, "outlook") || containsTokenCI(s, "office")) {
    icon = 'M';
    col = RGB565_BLUE;
  } else if (containsTokenCI(s, "apple") || containsTokenCI(s, "icloud")) {
    icon = 'A';
    col = RGB565_LIGHTGREY;
  } else if (containsTokenCI(s, "amazon") || containsTokenCI(s, "aws")) {
    icon = 'A';
    col = RGB565_ORANGE;
  } else if (containsTokenCI(s, "binance")) {
    icon = 'B';
    col = RGB565_YELLOW;
  } else if (containsTokenCI(s, "paypal")) {
    icon = 'P';
    col = RGB565_CYAN;
  } else if (containsTokenCI(s, "discord")) {
    icon = 'D';
    col = (uint16_t)0x7B5D;  // violet-ish
  } else if (containsTokenCI(s, "facebook") || containsTokenCI(s, "meta")) {
    icon = 'F';
    col = RGB565_BLUE;
  } else if (containsTokenCI(s, "x.com") || containsTokenCI(s, "twitter")) {
    icon = 'X';
    col = RGB565_WHITE;
  } else if (containsTokenCI(s, "dropbox")) {
    icon = 'D';
    col = RGB565_BLUE;
  } else if (containsTokenCI(s, "steam")) {
    icon = 'S';
    col = RGB565_CYAN;
  }

  *outIcon = icon;
  *outColor = col;
}

/** Format 6-digit TOTP as "123 456" for readability. */
static void totpFormatCodeSpaced(uint32_t code, char* out, size_t outCap) {
  if (!out || outCap < 8) {
    if (out && outCap) out[0] = 0;
    return;
  }
  unsigned long c = (unsigned long)(code % 1000000UL);
  snprintf(out, outCap, "%03lu %03lu", c / 1000UL, c % 1000UL);
}

static void drawTfaList() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("2FA", true);
  uint32_t ut = get_unix_time();
  int firstItemY = (ut == 0) ? 82 : 85;  // shifted lower for extra top spacing
  if (ut == 0) {
    gfx->setTextColor(RGB565_WHITE);
    gfx->setTextSize(1);
    gfx->setCursor(TFA_LIST_LEFT, 50);
    gfx->print("Set time in Settings for correct codes.");
  }
  int maxTfaScroll = (int)g_totpCount - TFA_LIST_VISIBLE_ROWS;
  if (maxTfaScroll < 0) maxTfaScroll = 0;
  if ((int)g_tfaListScroll > maxTfaScroll) g_tfaListScroll = (uint8_t)maxTfaScroll;
  for (uint8_t i = g_tfaListScroll; i < g_totpCount; i++) {
    int y = firstItemY + ((int)i - (int)g_tfaListScroll) * TFA_LIST_ROW_STRIDE;
    if (y + TFA_LIST_ROW_H > TFA_LIST_ROWS_CLIP_BOTTOM) break;
    if (g_listFlashActive && g_listFlashVisible && g_screen == UIScreen::TFA_LIST && g_listFlashIndex == i) {
      gfx->fillRect(0, y, LCD_W, TFA_LIST_ROW_H, (uint16_t)0x3186);
    }
    // 2FA issuer icon (parsed from label; default stays "2" accent for unknowns)
    drawCardIcon(TFA_LIST_ICON_CX, y + TFA_LIST_ROW_H / 2, '2', UI_ACCENT, RGB565_BLACK);
    // Left: provider (line 1) + account (line 2)
    char provider[40];
    char account[40];
    char providerDisp[40];
    char accountDisp[40];
    splitTotpLabel(g_totpItems[i].label, provider, sizeof(provider), account, sizeof(account));
    const int maxTextPx = (TFA_LIST_RIGHT_X - TFA_LIST_TEXT_X - 6);
    const int maxChars = maxTextPx / (6 * 2);  // text size 2
    copyEllipsized(provider[0] ? provider : g_totpItems[i].label, providerDisp, sizeof(providerDisp), maxChars);
    copyEllipsized(account, accountDisp, sizeof(accountDisp), maxChars);
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(2);  // slightly smaller for readability in populated 2FA list
    gfx->setCursor(TFA_LIST_TEXT_X, y + 4);
    gfx->print(providerDisp);
    if (account[0]) {
      gfx->setTextColor(RGB565_DARKGREY);
      gfx->setTextSize(2);
      gfx->setCursor(TFA_LIST_TEXT_X, y + 25);
      gfx->print(accountDisp);
      gfx->setTextColor(UI_TEXT);
    }
    // Left: 6-digit code (tap opens detail)
#if defined(MBEDTLS_SHA1_C) || defined(MBEDTLS_MD_C)
    if (ut) {
      uint32_t code = totp_code(g_totpItems[i].secret, ut);
      char codeDisp[12];
      totpFormatCodeSpaced(code, codeDisp, sizeof(codeDisp));
      gfx->setTextColor(UI_ACCENT);
      gfx->setTextSize(3);
      gfx->setCursor(TFA_LIST_TEXT_X, y + 46);
      gfx->print(codeDisp);
      gfx->setTextColor(UI_TEXT);
    }
#endif
    // Right: 30s circular countdown (Google Authenticator style)
    if (ut) {
      int secsLeft = 30 - (int)(ut % 30);
      if (secsLeft == 0) secsLeft = 30;
      int16_t cx = TFA_LIST_RIGHT_X + TFA_LIST_CLOCK_W / 2;
      int16_t cy = y + 8 + 21;
      float arcDeg = (secsLeft / 30.0f) * 360.0f;
      drawTfaRemainingRing(cx, cy, TFA_CLOCK_RADIUS, secsLeft, arcDeg, ut);
    }
  }
  if (g_totpCount == 0 && ut) {
    int yEmpty = firstItemY + 8;
    gfx->setTextColor(RGB565_DARKGREY);
    gfx->setTextSize(1);
    gfx->setCursor(TFA_LIST_LEFT, yEmpty);
    gfx->print("Tap ADD to add an account (base32 secret).");
  }
  if (g_totpCount > 0)
    drawListCountLeftOfEdit(g_totpCount);
  // ADD button: always visible (greyed out when list is full)
  if (g_totpCount < MAX_TOTP_ITEMS)
    drawBtn(BTN_TFA_ADD, "ADD", RGB565_BLUE, 2);
  else
    drawBtn(BTN_TFA_ADD, "ADD", RGB565_DARKGREY, 2);  // full (8/8), still tappable to show message
  drawSwipeBackHintOverlay();
  ui_flush();
}

/** 2FA show-secret confirm: step 2 has fewer lines — use a shorter card so it is not mostly empty. Centering uses (LCD_* - popup*) / 2. */
static int tfaRevealSecretConfirmPopupH(uint8_t step) {
  const int gapTextToBtn = 22;
  const int btnReserve = 48;  // matches btnY = popupY + popupH - 48 with 44px-tall buttons
  if (step == 1)
    return 222 + gapTextToBtn + btnReserve;  // WARNING + white body (last baseline at +222 from top)
  return 118 + gapTextToBtn + btnReserve;    // REMEMBER + 5 lines (last baseline at +118)
}

