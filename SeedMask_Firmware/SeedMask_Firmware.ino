static void drawPwListBrandIcon50(const uint16_t* logoTbl, int x, int y, int outerSize, int iconInset) {
  const int radius = max(4, outerSize / 5);
  gfx->fillRoundRect(x, y, outerSize, outerSize, radius, RGB565_WHITE);
  int inner = outerSize - 2 * iconInset;
  if (inner < 8) inner = outerSize;
  const int pad = (outerSize - inner) / 2;
  for (int dy = 0; dy < inner; ++dy) {
    const int srcY = (dy * 50) / inner;
    for (int dx = 0; dx < inner; ++dx) {
      const int srcX = (dx * 50) / inner;
      uint16_t c = pgm_read_word(&logoTbl[srcY * 50 + srcX]);
      gfx->drawPixel(x + pad + dx, y + pad + dy, c);
    }
  }
}

