static float easeOutBackRename(float x) {
  if (x <= 0.f) return 0.f;
  if (x >= 1.f) return 1.f;
  const float c1 = 1.70158f;
  const float c3 = c1 + 1.f;
  return 1.f + c3 * powf(x - 1.f, 3.f) + c1 * powf(x - 1.f, 2.f);
}

