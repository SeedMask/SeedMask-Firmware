static void handleCryptoXpubTap(uint16_t x, uint16_t y) {
  if (g_cryptoXpubQrFullscreen) {
    g_cryptoXpubQrFullscreen = false;
    draw();
    g_touchIgnoreUntil = millis() + 120;
    return;
  }
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_cryptoXpubQrFullscreen = false;
    secure_memzero(g_cryptoXpubBuf, sizeof(g_cryptoXpubBuf));
    if (g_cryptoXpubBackToMultisigStub || g_cryptoXpubBackToMode) {
      g_cryptoXpubBackToMultisigStub = false;
      g_cryptoXpubBackToMode = false;
      show(UIScreen::CRYPTO_XPUB_MODE);
    } else {
      show(UIScreen::CRYPTO_HOME);
    }
    return;
  }
  if (g_cryptoXpubBuf[0] && xpub_export_hit_qr(x, y)) {
    g_cryptoXpubQrFullscreen = true;
    draw();
    g_touchIgnoreUntil = millis() + 120;
    return;
  }
  if (crypto_home_asset_is_kaspa()) {
    return;
  }
  auto applyXpubType = [&](AddrType t) {
    if (g_cryptoXpubBackToMultisigStub && t == AddrType::P2TR) {
      setMsg("Taproot not in multisig flow");
      draw();
      return;
    }
    g_cryptoXpubQrFullscreen = false;
    g_cryptoExportType = t;
    bool ok = false;
    if (g_cryptoXpubBackToMultisigStub) {
      // Must rebuild SM|xfp|deriv|xpub — bare Ypub/Zpub alone looks like singlesig to the coordinator.
      ok = btc_load_multisig_xpub_export(g_cryptoExportType, g_addrAccount);
    } else {
      ok = btc_load_singlesig_xpub_export(g_cryptoExportType, g_addrAccount);
    }
    if (!ok) setMsg(g_addrLastErr[0] ? g_addrLastErr : "xpub export failed");
    draw();
  };
  if (hit(BTN_XPUB_TYPE_NATIVE, x, y)) {
    applyXpubType(AddrType::P2WPKH);
    return;
  }
  if (hit(BTN_XPUB_TYPE_NESTED, x, y)) {
    applyXpubType(AddrType::P2SH_P2WPKH);
    return;
  }
  if (hit(BTN_XPUB_TYPE_LEGACY, x, y)) {
    applyXpubType(AddrType::P2PKH);
    return;
  }
  if (hit(BTN_XPUB_TYPE_TAPROOT, x, y)) {
    applyXpubType(AddrType::P2TR);
    return;
  }
}

