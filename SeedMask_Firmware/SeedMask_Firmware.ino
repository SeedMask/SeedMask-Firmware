  if (g_psbt_cam_preview_step >= 2) return g_psbt_cam_preview_step;
  return seedmask_qr_preview_step_for_width();
}

/** Progress text + bar only — does not touch camera bitmap (fast between live preview frames). */
static void kaspa_paint_progress_text_bar(uint32_t urGot, uint32_t urNeed, bool flushNow = true) {
#ifndef SEEDMASK_PSBT_PREVIEW_TOP
#define SEEDMASK_PSBT_PREVIEW_TOP 46
#endif
  const int prevTop = (int)SEEDMASK_PSBT_PREVIEW_TOP;
  const int pvStep = kaspa_preview_step_for_hud();
  gfx->fillRect(0, 40, LCD_W, 20, RGB565_BLACK);
  gfx->setTextSize(1);
  gfx->setCursor(10, 44);
  if (urNeed > 0) {
    int ip = (int)((urGot * 100u + urNeed / 2u) / urNeed);
    if (ip < 0) ip = 0;
    if (ip > 100) ip = 100;
    gfx->setTextColor(RGB565_WHITE);
    gfx->print("PSKT UR ");
    gfx->setTextColor(RGB565_CYAN);
    gfx->print(ip);
    gfx->print("%");
    gfx->setTextColor(RGB565_WHITE);
    gfx->printf("  %lu/%lu", (unsigned long)urGot, (unsigned long)urNeed);
    const int outH = min((g_qr_h * 2) / pvStep, PREVIEW_H);
    const int endY = prevTop + outH;
    const int barH = 10;
    int barY = endY - barH - 8;
    if (barY < prevTop + 94) barY = prevTop + 94;
    const int barX = 16;
    const int barW = LCD_W - 32;
    int filledW = (barW * ip + 50) / 100;
    if (ip > 0 && filledW < 1) filledW = 1;
    gfx->fillRect(barX, barY, barW, barH, UI_CARD);
    gfx->drawRect(barX, barY, barW, barH, UI_BORDER);
    if (filledW > 2)
      gfx->fillRect(barX + 2, barY + 2, filledW - 4, barH - 4, blendRGB565(RGB565_BLUE, RGB565_CYAN, 0.45f));
  }
  if (flushNow)
    ui_flush();
}

/** Live camera + PSKT progress strip/bar (no status spam, no full HUD) — keeps multipart preview smooth. */
static void kaspa_paint_fountain_live(const uint8_t* raw, uint32_t urGot, uint32_t urNeed) {
  if (!raw) return;
#ifndef SEEDMASK_PSBT_PREVIEW_TOP
#define SEEDMASK_PSBT_PREVIEW_TOP 46
#endif
  const int prevTop = (int)SEEDMASK_PSBT_PREVIEW_TOP;
  const int pvStep = kaspa_preview_step_for_hud();
  if (pvStep >= 2 && s_kaspa_preview_step_lock == 0)
    s_kaspa_preview_step_lock = pvStep;
  g_psbt_cam_preview_step = pvStep;
  g_psbt_last_cam_preview_ms = millis();
  drawCameraPreviewGray(raw, pvStep, prevTop);
  const int outH = min((g_qr_h * 2) / pvStep, PREVIEW_H);
  const int endY = prevTop + outH;
  if (endY < LCD_H)
    gfx->fillRect(0, endY, LCD_W, LCD_H - endY, RGB565_BLACK);
  kaspa_paint_progress_text_bar(urGot, urNeed, false);
  if (!s_kaspa_back_on_screen) {
    drawBtn(BTN_CRYPTO_SCAN_BACK, "BACK", RGB565_DARKGREY, 2);
    s_kaspa_back_on_screen = true;
  }
  ui_flush();
}

