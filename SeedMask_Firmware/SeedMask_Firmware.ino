static void applyPwSendViaChoice(uint8_t via, uint32_t nowMsForSpFlash, bool flashSp) {
  g_pwSendVia = via;
  persistPwSendVia();
  // Sending mode is independent of Device → HID. Do not toggle g_hidHostEnabled here.
  if (via == PW_SEND_VIA_USB) {
    if (flashSp) nav_sp_show_send_flash(2, nowMsForSpFlash ? nowMsForSpFlash : millis());
  } else if (via == PW_SEND_VIA_DONGLE) {
    if (flashSp) nav_sp_show_send_flash(1, nowMsForSpFlash ? nowMsForSpFlash : millis());
  } else if (via == PW_SEND_VIA_DISABLED) {
    if (flashSp) nav_sp_show_send_flash(3, nowMsForSpFlash ? nowMsForSpFlash : millis());
  }
}

/** Request send mode. Prompt to enable HID only when choosing USB and HID is currently off. */
static void requestPwSendViaWithHidGate(uint8_t via, bool fromSp, uint32_t nowMs) {
  if (via == PW_SEND_VIA_DISABLED) {
    applyPwSendViaChoice(via, nowMs, fromSp);
    hidEnablePromptClear();
    if (fromSp) nav_sp_redraw_only();
    else draw();
    return;
  }
#if SEEDMASK_USB_HID_KEYBOARD
  // Dongle does not need HID. USB typing does — ask only if Device HID is off.
  if (via == PW_SEND_VIA_USB && !g_hidHostEnabled) {
    g_hidEnablePromptViaPlus1 = (uint8_t)(via + 1);
    g_hidEnablePromptFromSp = fromSp;
    if (fromSp) nav_sp_redraw_only();
    else draw();
    return;
  }
#endif
  applyPwSendViaChoice(via, nowMs, fromSp);
  hidEnablePromptClear();
  if (fromSp) {
    nav_sp_redraw_only();
  } else {
    setMsg("");
    draw();
  }
}

/** Returns true if the tap was consumed by the HID enable prompt. */
static bool handleHidEnablePromptTap(uint16_t x, uint16_t y) {
  if (!hidEnablePromptActive()) return false;
  Rect card, rYes, rNo;
  hidEnablePromptRects(&card, &rYes, &rNo);
  if (hit(rYes, (int16_t)x, (int16_t)y)) {
    const uint8_t via = (uint8_t)(g_hidEnablePromptViaPlus1 - 1);
    const bool fromSp = g_hidEnablePromptFromSp;
#if SEEDMASK_USB_HID_KEYBOARD
    g_hidHostEnabled = true;
    persistHidHostEnabled();
#endif
    hidEnablePromptClear();
    applyPwSendViaChoice(via, millis(), fromSp);
    if (fromSp) nav_sp_redraw_only();
    else {
      setMsg("");
      draw();
    }
    return true;
  }
  if (hit(rNo, (int16_t)x, (int16_t)y) || !hit(card, (int16_t)x, (int16_t)y)) {
    const bool fromSp = g_hidEnablePromptFromSp;
    const uint8_t pendingVia = (uint8_t)(g_hidEnablePromptViaPlus1 - 1);
    hidEnablePromptClear();
    // Status panel cycle: declining HID for USB must still advance → Disabled.
    if (fromSp && pendingVia == PW_SEND_VIA_USB) {
      applyPwSendViaChoice(PW_SEND_VIA_DISABLED, millis(), true);
      nav_sp_redraw_only();
    } else if (fromSp) {
      nav_sp_redraw_only();
    } else {
      draw();
    }
    return true;
  }
  return true;
}
#endif

