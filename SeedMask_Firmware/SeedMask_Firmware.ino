    g_toolsSignAddress[0] = 0;
    g_toolsSignPathFromQr = false;
    g_toolsSignAddrType = AddrType::P2WPKH;
    show(UIScreen::CRYPTO_TOOLS_MENU);
    return;
  }
  if (hitPad(BTN_TOOLS_SIGN_CONFIRM, (int16_t)x, (int16_t)y, 20)) {
    if (!tools_sign_current_message()) {
      setMsg("Signing failed");
      draw();
      return;
    }
    show(UIScreen::CRYPTO_TOOLS_SIGN_RESULT);
    return;
  }
}

