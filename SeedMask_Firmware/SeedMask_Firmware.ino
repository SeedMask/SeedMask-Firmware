/** Validate fields and save 2FA entry; same rules as former on-screen ADD. */
static void tfaAddTryCommit() {
  if (strlen(g_tfaAddLabel) == 0) {
    setMsg("Enter name.");
    draw();
    return;
  }
  uint8_t dummy[64];
  size_t dlen = 0;
  if (!base32_decode(g_tfaAddSecret, dummy, sizeof(dummy), dlen)) {
    setMsg("Invalid base32 secret.");
    draw();
    return;
  }
  if (dlen < 8) {
    setMsg("Secret too short.");
    draw();
    return;
  }
  if (!g_tfaEditMode && g_totpCount >= MAX_TOTP_ITEMS) {
    setMsg("2FA list full.");
    draw();
    return;
  }
  if (!session_can_persist_vault_data()) {
    setMsg("No password in session");
    draw();
    return;
  }
  if (!vault_require_sd_for_pm_save()) {
    draw();
    return;
  }
  uint8_t dst = g_tfaEditMode ? g_tfaEditIndex : g_totpCount;
  stripCharInPlace(g_tfaAddLabel, ':');  // account must use dedicated field (no "name:account" in name)
  if (g_tfaAddAccount[0]) {
    snprintf(g_totpItems[dst].label, sizeof(g_totpItems[0].label), "%s: %s", g_tfaAddLabel, g_tfaAddAccount);
  } else {
    strncpy(g_totpItems[dst].label, g_tfaAddLabel, sizeof(g_totpItems[0].label) - 1);
    g_totpItems[dst].label[sizeof(g_totpItems[0].label) - 1] = 0;
  }
  strncpy(g_totpItems[dst].secret, g_tfaAddSecret, sizeof(g_totpItems[0].secret) - 1);
  g_totpItems[dst].secret[sizeof(g_totpItems[0].secret) - 1] = 0;
  if (!g_tfaEditMode) g_totpCount++;
  g_vaultQrDirty = true;
  if (!vault_commit_passwords_notes_persist()) {
    if (!g_tfaEditMode) {
      g_totpCount--;
      memset(&g_totpItems[g_totpCount], 0, sizeof(g_totpItems[0]));
    }
    if (g_sdSavePathPickOpen) return;
    if (!g_msg[0]) setMsg("Insert microSD to save");
    draw();
    return;
  }
  g_tfaAddLabel[0] = 0;
  g_tfaAddAccount[0] = 0;
  g_tfaAddSecret[0] = 0;
  g_tfaAddCursorLabel = 0;
  g_tfaAddCursorAccount = 0;
  g_tfaAddCursorSecret = 0;
  g_tfaAddViewOffsetLabel = 0;
  g_tfaAddViewOffsetAccount = 0;
  g_tfaAddViewOffsetSecret = 0;
  if (g_tfaEditMode) {
    g_tfaEditMode = false;
    g_showTfaRevealSecretConfirm = false;
    g_tfaRevealSecretStep = 0;
    show(UIScreen::TFA_SHOW_CODE);
  } else {
    triggerListCountFlash(UIScreen::TFA_LIST);
    show(UIScreen::TFA_LIST);
  }
}

static void handleTfaListTap(uint16_t x, uint16_t y) {
  // No BACK button here; use swipe or MENU/HOME navigation
  if (hitBottomListAction(BTN_TFA_ADD, x, y) && !nav_bar_home_tap_hit((int16_t)x, (int16_t)y)) {
    if (pw_notes_tfa_prompt_vault_password_if_needed(UIScreen::TFA_LIST)) return;
    if (g_totpCount >= MAX_TOTP_ITEMS) {
      setMsg("2FA list full.");
      draw();
      return;
    }
    g_tfaAddFocus = 0;
    g_tfaEditMode = false;
    g_tfaAddCursorLabel = 0;
    g_tfaAddCursorAccount = 0;
    g_tfaAddCursorSecret = 0;
    g_tfaAddViewOffsetLabel = 0;
    g_tfaAddViewOffsetAccount = 0;
    g_tfaAddViewOffsetSecret = 0;
    g_tfaAddLabel[0] = 0;
    g_tfaAddAccount[0] = 0;
    g_tfaAddSecret[0] = 0;
    setMsg("");
    show(UIScreen::TFA_ADD);
    return;
  }
  int firstItemY = get_unix_time() ? 85 : 82;
  int rowIndex = ((int)y - firstItemY) / TFA_LIST_ROW_STRIDE;
  if (rowIndex >= 0 && rowIndex < TFA_LIST_VISIBLE_ROWS && (int)x >= TFA_LIST_LEFT && (int)x < TFA_LIST_RIGHT_X) {
    uint8_t i = (uint8_t)((int)g_tfaListScroll + rowIndex);
    if (i < g_totpCount) {
      int itemY = firstItemY + rowIndex * TFA_LIST_ROW_STRIDE;
      if ((int)y >= itemY && (int)y < itemY + TFA_LIST_ROW_H) {
        g_listFlashActive = true;
        g_listFlashVisible = true;
        g_listFlashTogglesLeft = 0;
        g_listFlashScreen = UIScreen::TFA_LIST;
        g_listFlashIndex = i;
        g_listFlashStartMs = millis();
        draw();
        delay(250);
        g_listFlashActive = false;
        g_tfaShowIndex = i;
        g_tfaKeyRevealed = false;
        g_tfaShowOverflowOpen = false;
        g_showTfaRevealSecretConfirm = false;
        g_tfaRevealSecretStep = 0;
        show(UIScreen::TFA_SHOW_CODE);
        return;
      }
    }
  }
}

static void handleTfaShowCodeTap(uint16_t x, uint16_t y) {
  // No BACK button here; rely on Yes/Cancel buttons or swipe-back

  // Delete confirm popup: Yes -> delete and go to list; Cancel -> close popup
  if (g_showTfaDeleteConfirm) {
    const int popupW = 260, popupH = 120;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    Rect rYes = { (int16_t)(popupX + 20), (int16_t)(popupY + 62), 100, 44 };
    Rect rCancel = { (int16_t)(popupX + 140), (int16_t)(popupY + 62), 100, 44 };
    if (hit(rYes, x, y)) {
      g_showTfaDeleteConfirm = false;
      g_showTfaRevealSecretConfirm = false;
      g_tfaRevealSecretStep = 0;
      if (g_tfaShowIndex < g_totpCount) {
        for (uint8_t i = g_tfaShowIndex; i + 1 < g_totpCount; i++) {
          memcpy(&g_totpItems[i], &g_totpItems[i + 1], sizeof(TotpItem));
        }
        g_totpCount--;
        g_vaultQrDirty = true;
        save_passwords_notes_to_nvs();
        if (sd_ready() && g_masterPw[0]) pw_vault_save_to_sd(g_masterPw);
        show(UIScreen::TFA_LIST);
      }
      return;
    }
    if (hit(rCancel, x, y)) {
      g_showTfaDeleteConfirm = false;
      draw();
      return;
    }
    return;
  }

  if (g_showTfaRevealSecretConfirm) {
    const int popupW = 300;
    const int popupH = tfaRevealSecretConfirmPopupH(g_tfaRevealSecretStep);
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    const int btnY = popupY + popupH - 48;
    Rect rCancel = { (int16_t)(popupX + 10), (int16_t)btnY, 130, 44 };
    Rect rContinue = { (int16_t)(popupX + 152), (int16_t)btnY, 130, 44 };
    if (hit(rContinue, x, y)) {
      if (g_tfaRevealSecretStep == 1) {
        g_tfaRevealSecretStep = 2;
        draw();
        return;
      }
      g_showTfaRevealSecretConfirm = false;
      g_tfaRevealSecretStep = 0;
      g_tfaKeyRevealed = true;
      draw();
      return;
    }
    if (hit(rCancel, x, y)) {
      g_showTfaRevealSecretConfirm = false;
      g_tfaRevealSecretStep = 0;
      draw();
      return;
    }
    return;
  }

  if (get_unix_time() == 0)
    return;

  const int16_t menuMx = LCD_W - 8 - TFA_OVERFLOW_MENU_W;
  const int16_t menuMy = 48;

  if (g_tfaShowOverflowOpen) {
    if (hit(BTN_TFA_OVERFLOW, x, y)) {
      g_tfaShowOverflowOpen = false;
      draw();
      return;
    }
    for (int r = 0; r < 3; r++) {
      int16_t ry = (int16_t)(menuMy + 4 + r * TFA_OVERFLOW_MENU_ROW_H);
      Rect row = { (int16_t)(menuMx + 4), ry, (int16_t)(TFA_OVERFLOW_MENU_W - 8), (int16_t)(TFA_OVERFLOW_MENU_ROW_H - 2) };
      if (hit(row, x, y)) {
        g_tfaShowOverflowOpen = false;
        if (r == 0) {
          if (g_tfaShowIndex < g_totpCount) {
            g_tfaEditMode = true;
            g_tfaEditIndex = g_tfaShowIndex;
            splitTotpLabel(g_totpItems[g_tfaShowIndex].label, g_tfaAddLabel, sizeof(g_tfaAddLabel), g_tfaAddAccount, sizeof(g_tfaAddAccount));
            strncpy(g_tfaAddSecret, g_totpItems[g_tfaShowIndex].secret, sizeof(g_tfaAddSecret) - 1);
            g_tfaAddSecret[sizeof(g_tfaAddSecret) - 1] = 0;
            g_tfaAddFocus = 0;
            g_tfaAddCursorLabel = (uint16_t)strlen(g_tfaAddLabel);
            g_tfaAddCursorAccount = (uint16_t)strlen(g_tfaAddAccount);
            g_tfaAddCursorSecret = (uint16_t)strlen(g_tfaAddSecret);
            g_tfaAddViewOffsetLabel = (g_tfaAddCursorLabel > 20) ? (uint16_t)(g_tfaAddCursorLabel - 20) : 0;
            g_tfaAddViewOffsetAccount = (g_tfaAddCursorAccount > 20) ? (uint16_t)(g_tfaAddCursorAccount - 20) : 0;
            g_tfaAddViewOffsetSecret = (g_tfaAddCursorSecret > 20) ? (uint16_t)(g_tfaAddCursorSecret - 20) : 0;
            setMsg("");
            show(UIScreen::TFA_ADD);
          }
          return;
        }
        if (r == 1) {
          if (g_tfaKeyRevealed) {
            g_tfaKeyRevealed = false;
            draw();
            return;
          }
          g_showTfaRevealSecretConfirm = true;
          g_tfaRevealSecretStep = 1;
          g_showTfaDeleteConfirm = false;
          draw();
          return;
        }
        g_showTfaDeleteConfirm = true;
        g_showTfaRevealSecretConfirm = false;
        g_tfaRevealSecretStep = 0;
        draw();
        return;
      }
    }
    g_tfaShowOverflowOpen = false;
    draw();
    return;
  }

  if (hit(BTN_TFA_OVERFLOW, x, y)) {
    g_tfaShowOverflowOpen = true;
    draw();
    return;
  }
}

static void handleTfaAddTap(uint16_t x, uint16_t y) {
  if (g_tfaEditMode && g_tfaAddFocus > 1) g_tfaAddFocus = 1;
  char* curBuf = (g_tfaAddFocus == 0) ? g_tfaAddLabel : (g_tfaAddFocus == 1) ? g_tfaAddAccount
                                                                             : g_tfaAddSecret;
  size_t curSize = (g_tfaAddFocus == 0) ? sizeof(g_tfaAddLabel) : (g_tfaAddFocus == 1) ? sizeof(g_tfaAddAccount)
                                                                                       : sizeof(g_tfaAddSecret);
  uint16_t& curPos = (g_tfaAddFocus == 0) ? g_tfaAddCursorLabel : (g_tfaAddFocus == 1) ? g_tfaAddCursorAccount
                                                                                       : g_tfaAddCursorSecret;
  uint16_t& viewPos = (g_tfaAddFocus == 0) ? g_tfaAddViewOffsetLabel : (g_tfaAddFocus == 1) ? g_tfaAddViewOffsetAccount
                                                                                            : g_tfaAddViewOffsetSecret;
  if (!g_tfaEditMode && hit(TFA_ADD_QR_HIT, x, y)) {
    // Reuse scanner screen in TFA-import mode.
    g_qrScanTarget = QrScanTarget::TFA_ADD;
    prepareQrScanDefaults();
    g_restoreChunkTotal = 0;
    memset(g_restoreChunkGot, 0, sizeof(g_restoreChunkGot));
    if (!start_qr_scan()) {
      setMsg("Camera init failed");
      draw();
      return;
    }
    g_qrScanning = true;
    setMsg("Scan otpauth QR");
    show(UIScreen::RESTORE_SCAN_QR);
    return;
  }
  if (hitOkKeyResolved(x, y)) {
    flashKeyRectTranslucent(keyRectRow4[2]);
    if (g_tfaAddFocus == 0) {
      if (!g_tfaAddLabel[0]) {
        setMsg("Enter name.");
        draw();
        return;
      }
      g_tfaAddFocus = 1;
      g_tfaAddCursorAccount = (uint16_t)strlen(g_tfaAddAccount);
      g_tfaAddViewOffsetAccount = (g_tfaAddCursorAccount > 20) ? (uint16_t)(g_tfaAddCursorAccount - 20) : 0;
      setMsg("");
      draw();
      return;
    }
    if (g_tfaAddFocus == 1) {
      if (g_tfaEditMode) {
        tfaAddTryCommit();
        return;
      }
      g_tfaAddFocus = 2;
      g_tfaAddCursorSecret = (uint16_t)strlen(g_tfaAddSecret);
      g_tfaAddViewOffsetSecret = (g_tfaAddCursorSecret > 20) ? (uint16_t)(g_tfaAddCursorSecret - 20) : 0;
      setMsg("");
      draw();
      return;
    }
    tfaAddTryCommit();
    return;
  }
  if (x >= TFA_ADD_BOX_X && x < TFA_ADD_BOX_X + TFA_ADD_BOX_W && y >= TFA_ADD_BOX_NAME_Y && y < TFA_ADD_BOX_NAME_Y + TFA_ADD_BOX_H) {
    g_tfaAddFocus = 0;
    tfaAddPlaceCaret(x, g_tfaAddCursorLabel, g_tfaAddViewOffsetLabel, g_tfaAddLabel);
    draw();
    return;
  }
  if (x >= TFA_ADD_BOX_X && x < TFA_ADD_BOX_X + TFA_ADD_BOX_W && y >= TFA_ADD_BOX_USER_Y && y < TFA_ADD_BOX_USER_Y + TFA_ADD_BOX_H) {
    g_tfaAddFocus = 1;
    tfaAddPlaceCaret(x, g_tfaAddCursorAccount, g_tfaAddViewOffsetAccount, g_tfaAddAccount);
    draw();
    return;
  }
  if (!g_tfaEditMode && x >= TFA_ADD_BOX_X && x < TFA_ADD_BOX_X + TFA_ADD_BOX_W && y >= TFA_ADD_BOX_SECRET_Y && y < TFA_ADD_BOX_SECRET_Y + TFA_ADD_BOX_H) {
    g_tfaAddFocus = 2;
    tfaAddPlaceCaret(x, g_tfaAddCursorSecret, g_tfaAddViewOffsetSecret, g_tfaAddSecret);
    draw();
    return;
  }
  char c = keyboardHit(x, y);
  if (c) {
    size_t n = strlen(curBuf);
    if (curPos > n) curPos = (uint16_t)n;
    if (c == '\b') {
      if (n > 0 && curPos > 0) {
        memmove(&curBuf[curPos - 1], &curBuf[curPos], n - (size_t)curPos + 1);
        curPos--;
      }
    } else if (n < curSize - 1) {
      memmove(&curBuf[curPos + 1], &curBuf[curPos], n - (size_t)curPos + 1);
      curBuf[curPos] = c;
      curPos++;
    }
    const int maxChars = (272 - 12 * 2) / 12;
    if (curPos < viewPos) viewPos = curPos;
    else if (curPos > (uint16_t)(viewPos + maxChars)) viewPos = (uint16_t)(curPos - maxChars);
    g_lastEditInputMs = millis();
    draw();
    return;
  }
}

static void drawSetTime() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Set time", true);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);
  gfx->setCursor(10, 50);
  gfx->print(g_msg);
  uint32_t ut = get_unix_time();
  if (ut == 0 && strlen(g_setTimeBuf) >= 10) {
    unsigned long val = 0;
    for (int i = 0; g_setTimeBuf[i] >= '0' && g_setTimeBuf[i] <= '9' && i < 12; i++)
      val = val * 10 + (g_setTimeBuf[i] - '0');
    if (val >= 1600000000UL && val <= 2000000000UL) ut = (uint32_t)val;
  }
  gfx->setCursor(10, 72);
  gfx->print("Unix: ");
  if (ut) {
    gfx->print((unsigned long)ut);
    gfx->setCursor(10, 86);
    gfx->setTextColor(RGB565_DARKGREY);
    gfx->print("Compare to epoch101.com");
    gfx->setTextColor(RGB565_WHITE);
  } else {
    gfx->print("(not set)");
  }
  // Input box: just below Unix line with small gap
  const int boxX = 24, boxW = 272, boxH = SETTIME_INPUT_H;
  const int boxY = SETTIME_INPUT_Y;
  gfx->fillRoundRect(boxX, boxY, boxW, boxH, 12, UI_CARD);
  gfx->drawRoundRect(boxX, boxY, boxW, boxH, 12, UI_ACCENT);
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  gfx->setCursor(boxX + 12, boxY + (boxH - 16) / 2);
  gfx->print(g_setTimeBuf);
  // 4x3 numpad: 1,2,3 / 4,5,6 / 7,8,9 / BACK, 0, SET (full width, ends below input + gap)
  for (int r = 0; r < SETTIME_NUMPAD_ROWS; r++) {
    for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
      int x = c * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
      int y = SETTIME_NUMPAD_Y0 + r * (SETTIME_KEY_H + SETTIME_NUMPAD_GAP);
      g_setTimeNumpadRects[r][c] = { (int16_t)x, (int16_t)y, (int16_t)SETTIME_KEY_W, (int16_t)SETTIME_KEY_H };
    }
  }
  for (int r = 0; r < SETTIME_NUMPAD_ROWS; r++) {
    for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
      const Rect& rect = g_setTimeNumpadRects[r][c];
      if (r == 3 && c == 0) {
        drawBtn(rect, "Del", RGB565_DARKGREY, 2);
      } else if (r == 3 && c == 2) {
        drawBtn(rect, "SET", RGB565_BLUE, 2);
      } else if (r == 3 && c == 1) {
        drawKeyRect(rect, "0");
      } else {
        char lab[4] = { (char)('1' + r * 3 + c), 0 };
        drawKeyRect(rect, lab);
      }
    }
  }
  ui_flush();
}

static void handleSetTimeTap_doSet() {
  unsigned long val = 0;
  for (int i = 0; g_setTimeBuf[i] >= '0' && g_setTimeBuf[i] <= '9' && i < 12; i++)
    val = val * 10 + (g_setTimeBuf[i] - '0');
  set_unix_time((uint32_t)val);
  rtc_write_unix((uint32_t)val);
  setMsg("Time set.");
  show(UIScreen::TFA_LIST);
}

static void handleSetTimeTap(uint16_t x, uint16_t y) {
  // Numpad hit: same rects as in drawSetTime (recompute or use stored)
  for (int r = 0; r < SETTIME_NUMPAD_ROWS; r++) {
    for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
      int rx = c * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
      int ry = SETTIME_NUMPAD_Y0 + r * (SETTIME_KEY_H + SETTIME_NUMPAD_GAP);
      Rect rect = { (int16_t)rx, (int16_t)ry, (int16_t)SETTIME_KEY_W, (int16_t)SETTIME_KEY_H };
      if (!hit(rect, x, y)) continue;
      if (r == 3 && c == 0) {
        backspaceStr(g_setTimeBuf, sizeof(g_setTimeBuf));
        draw();
        return;
      }
      if (r == 3 && c == 2) {
        if (strlen(g_setTimeBuf) < 10) {
          setMsg("Enter 10 digits");
          draw();
          return;
        }
        unsigned long val = 0;
        for (int i = 0; g_setTimeBuf[i] >= '0' && g_setTimeBuf[i] <= '9' && i < 12; i++)
          val = val * 10 + (g_setTimeBuf[i] - '0');
        if (val < 1600000000UL || val > 2000000000UL) {
          setMsg("Invalid range (use time.org)");
          draw();
          return;
        }
        handleSetTimeTap_doSet();
        return;
      }
      if (r == 3 && c == 1) {
        if (strlen(g_setTimeBuf) < 10) appendChar(g_setTimeBuf, sizeof(g_setTimeBuf), '0');
        draw();
        return;
      }
      char digit = (char)('1' + r * 3 + c);
      if (strlen(g_setTimeBuf) < 10) appendChar(g_setTimeBuf, sizeof(g_setTimeBuf), digit);
      draw();
      return;
    }
  }
}

