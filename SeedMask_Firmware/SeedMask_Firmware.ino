          if (maxCharsPerLine >= 4) {
            n2 = maxCharsPerLine - 4;
            if (n2 < 0) n2 = 0;
            l2[n2++] = ' ';
            l2[n2++] = '.';
            l2[n2++] = '.';
            l2[n2++] = '.';
          } else {
            n2 = maxCharsPerLine;
            for (int k = 0; k < n2; k++) l2[k] = '.';
          }
        }
        l2[n2] = 0;
        int l1w = n1 * charW;
        int cx1 = cap.x + (cap.w - l1w) / 2;
        if (cx1 < cap.x) cx1 = cap.x;
        gfx->setCursor(cx1, cap.y);
