static void handleCryptoToolsMenuTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_optionsHomeScreen = UIScreen::CRYPTO_HOME;
    show(UIScreen::BURGER_MENU);
    return;
  }
  if (hitCryptoAssetBadge((int16_t)x, (int16_t)y)) {
    crypto_accounts_capture_active_addr();
    g_cryptoHomeAsset = crypto_home_asset_is_kaspa() ? CryptoHomeAsset::Bitcoin : CryptoHomeAsset::Kaspa;
    crypto_accounts_sync_runtime_addr();
    invalidate_address_explorer_cache();
    invalidate_address_explorer_chain_node();
    draw();
    return;
  }
  if (!vault_is_unlocked() || !g_loggedIn) {
    setMsgTr("Unlock first", "Prvo otkljucajte");
    show(UIScreen::LOCKED);
    return;
