// Address wrap for Review PSBT. Mutates chunkedMut (strtok). Returns Y below the block.
// chunkGapPx: horizontal gap between 4-char groups (tighter than a full size-2 space so 5 fit/line).
static int16_t psbt_review_draw_dest_quiet(char* chunkedMut, Arduino_Canvas* g, int16_t x0, int16_t y0,
                                           int16_t lineH, uint16_t maxLinePx, uint8_t textSize,
                                           int16_t chunkGapPx) {
  if (!chunkedMut || !g || !chunkedMut[0]) return (int16_t)(y0 + lineH);
  if (textSize < 1) textSize = 1;
  if (chunkGapPx < 2) chunkGapPx = 2;
  g->setTextSize(textSize);
  // Default GFX font: fixed 6px * textSize — avoid getTextBounds (very hot on scroll redraws).
  const uint16_t cw = (uint16_t)(6u * (uint16_t)textSize);
  char* saveptr = nullptr;
  char* tok = strtok_r(chunkedMut, " ", &saveptr);
  unsigned idx = 0;
  int16_t cx = x0;
  int16_t cy = y0;
  while (tok) {
    uint16_t spw = (cx > x0) ? (uint16_t)chunkGapPx : 0;
    uint16_t wTok = (uint16_t)(strlen(tok) * cw);
    if (cx > x0 && (uint32_t)(cx - x0) + spw + wTok > maxLinePx) {
      cx = x0;
      cy = (int16_t)(cy + lineH);
      continue;
    }
    if (cx > x0) cx = (int16_t)(cx + (int16_t)spw);
    if (g_cryptoTxReviewScrollLite)
      g->setTextColor(RGB565_WHITE);
    else
      g->setTextColor(((idx % 2u) == 0u) ? RGB565_WHITE : blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.16f));
    g->setCursor(cx, cy);
    g->print(tok);
    cx = (int16_t)(cx + (int16_t)wTok);
    idx++;
    tok = strtok_r(nullptr, " ", &saveptr);
  }
  return (int16_t)(cy + lineH);
}

/** Measure wrapped address height (same rules as psbt_review_draw_dest_quiet). */
static int16_t psbt_review_measure_dest_h(const char* chunked, uint16_t maxLinePx, int16_t lineH,
                                         uint8_t textSize, int16_t chunkGapPx) {
  if (!chunked || !chunked[0]) return lineH;
  char work[192];
  strncpy(work, chunked, sizeof(work) - 1);
  work[sizeof(work) - 1] = 0;
  if (textSize < 1) textSize = 1;
  if (chunkGapPx < 2) chunkGapPx = 2;
  const uint16_t cw = (uint16_t)(6u * (uint16_t)textSize);
  char* saveptr = nullptr;
  char* tok = strtok_r(work, " ", &saveptr);
  int16_t cx = 0;
  int16_t lines = 1;
  while (tok) {
    uint16_t spw = (cx > 0) ? (uint16_t)chunkGapPx : 0;
    uint16_t wTok = (uint16_t)(strlen(tok) * cw);
    if (cx > 0 && (uint32_t)cx + spw + wTok > maxLinePx) {
      cx = 0;
      lines++;
      continue;
    }
    if (cx > 0) cx = (int16_t)(cx + (int16_t)spw);
    cx = (int16_t)(cx + (int16_t)wTok);
    tok = strtok_r(nullptr, " ", &saveptr);
  }
  return (int16_t)(lines * lineH);
}

static void psbt_review_draw_section_card(int16_t x, int16_t y, int16_t w, int16_t h,
                                         uint16_t bg, uint16_t border) {
