static void handleRestoreCodeTap(uint16_t x, uint16_t y) {
  if (g_restoreSeedEntryMode) {
    if (hit(BTN_RESTORE_SEED_12, x, y)) {
      g_restoreSeedEntryMode = false;
      g_restoreSeedFlowActive = true;
      resetSeedEntry(12);
      setMsg("");
      show(UIScreen::BACKUP_FROM_SEED);
      return;
    }
    if (hit(BTN_RESTORE_SEED_24, x, y)) {
      g_restoreSeedEntryMode = false;
      g_restoreSeedFlowActive = true;
      resetSeedEntry(24);
      setMsg("");
      show(UIScreen::BACKUP_FROM_SEED);
      return;
    }
    if (hit(BTN_RESTORE_SEED_QR, x, y)) {
      g_restoreSeedEntryMode = false;
      g_qrScanTarget = QrScanTarget::RESTORE;
      g_restoreSeedQrOnlyScan = true;
      prepareQrScanDefaults();
      g_restoreChunkTotal = 0;
      memset(g_restoreChunkGot, 0, sizeof(g_restoreChunkGot));
      if (!start_qr_scan()) {
        setMsg("Camera init failed");
        draw();
        return;
      }
      g_qrScanning = true;
      setMsg("Scan SeedQR");
      show(UIScreen::RESTORE_SCAN_QR);
      return;
    }
    return;
  }

  if (!g_restoreCodeEntryMode) {
    if (hit(BTN_RESTORE_METHOD_CODE, x, y)) {
      g_restoreCodeEntryMode = true;
      g_restorePayloadIsSpf1 = false;
      restorePayload_clear();
      setMsg("");
      draw();
      return;
    }
    if (hit(BTN_RESTORE_METHOD_QR, x, y)) {
      g_qrScanTarget = QrScanTarget::RESTORE;
      g_restoreSeedQrOnlyScan = false;
      prepareQrScanDefaults();
      g_restoreChunkTotal = 0;
      memset(g_restoreChunkGot, 0, sizeof(g_restoreChunkGot));
      if (!start_qr_scan()) {
        setMsg("Camera init failed");
        draw();
        return;
      }
      g_qrScanning = true;
      show(UIScreen::RESTORE_SCAN_QR);
      return;
    }
    if (hit(BTN_RESTORE_METHOD_SD, x, y)) {
      if (!sd_ready()) {
        setMsg("Insert SD card");
        draw();
        return;
      }
      clearPassword(g_password1);
      setMsg("Open seedmask folder, then BACKUP <fp>");
      show(UIScreen::RESTORE_SD);
      return;
    }
    if (hit(BTN_RESTORE_METHOD_SEED, x, y)) {
      g_restoreSeedEntryMode = true;
      setMsg("");
      draw();
      return;
    }
    return;
  }

  if (hit(BTN_RESTORE_SPF1_MODE, x, y)) {
    g_restorePayloadIsSpf1 = !g_restorePayloadIsSpf1;
    if (!g_restorePayloadIsSpf1 && g_restorePayload && strlen(g_restorePayload) > BACKUP_SPB1_PAYLOAD_24)
      g_restorePayload[BACKUP_SPB1_PAYLOAD_24] = 0;
    setMsg("");
    draw();
    return;
  }

  if (hit(BTN_RESTORE_CODE_SCAN_QR, x, y)) {
    g_qrScanTarget = QrScanTarget::RESTORE;
    g_restoreSeedQrOnlyScan = false;
    prepareQrScanDefaults();
    g_restoreChunkTotal = 0;
    memset(g_restoreChunkGot, 0, sizeof(g_restoreChunkGot));
    if (!start_qr_scan()) {
      setMsg("Camera init failed");
      draw();
      return;
    }
    g_qrScanning = true;
    setMsg("Scan backup QR");
    show(UIScreen::RESTORE_SCAN_QR);
    return;
  }

  if (hitOkKey(x, y)) {
    restorePayload_buildFull();
    if (!g_restorePayload || strlen(g_restorePayload) < 10) {
      setMsg("Code too short.");
      draw();
      return;
    }
    clearPassword(g_password1);
    preparePasswordPromptKeyboard();
    setMsg("Enter password.");
    show(UIScreen::RESTORE_PASSWORD);
    return;
  }

  // Backup code digit popup: tap anywhere to dismiss
  if (g_showBackupCodeDigitPopup) {
    const int popupW = 228, popupH = 82;
    const int popupX = (LCD_W - popupW) / 2, popupY = (LCD_H - popupH) / 2;
    if (x >= (uint16_t)popupX && x < (uint16_t)(popupX + popupW) && y >= (uint16_t)popupY && y < (uint16_t)(popupY + popupH)) {
      g_showBackupCodeDigitPopup = false;
      draw();
      return;
    }
    // Tap outside popup also dismisses
    g_showBackupCodeDigitPopup = false;
    draw();
    return;
  }

  char c = keyboardHit(x, y);
  if (c) {
    if (c == '\b') {
      restorePayload_bs();
      setMsg("");
      draw();
      return;
    }
    if (c == '0' || c == '1' || c == '8' || c == '9') {
      g_showBackupCodeDigitPopup = true;
      g_backupCodePopupShownAtMs = millis();
      setMsg("");
      draw();
      return;
    }
    restorePayload_add(c);
    setMsg("");
    draw();
    return;
  }
}

