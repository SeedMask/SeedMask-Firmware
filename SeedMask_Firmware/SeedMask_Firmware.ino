static void invalidate_address_prefetch(void) {
  g_addrPrefetchNextPage = UINT32_MAX;
  g_addrPrefetchPrevPage = UINT32_MAX;
  for (uint8_t i = 0; i < ADDR_PAGE_ROWS; i++) {
    g_addrPrefetchNextOk[i] = false;
    g_addrPrefetchPrevOk[i] = false;
    g_addrPrefetchNextAddrs[i][0] = 0;
    g_addrPrefetchPrevAddrs[i][0] = 0;
  }
}

static void fill_address_page_rows_from_chain_node(const Bip32Node* chainBase, uint32_t pageNum, char addrs[5][80],
                                                   bool ok[5]) {
  uint32_t start = pageNum * (uint32_t)ADDR_PAGE_ROWS;
  for (uint8_t r = 0; r < ADDR_PAGE_ROWS; r++) {
    addrs[r][0] = 0;
    uint32_t idx = start + (uint32_t)r;
    if (idx > ADDR_MAX_INDEX) {
      ok[r] = false;
      continue;
    }
    Bip32Node n;
    memcpy(&n, chainBase, sizeof(Bip32Node));
    if (!bip32_ckd_priv(&n, idx, false)) {
      ok[r] = false;
      if (!g_addrLastErr[0]) addr_set_err("ckd index");
      secure_memzero(&n, sizeof(n));
      continue;
    }
    addr_set_err("");
    if (g_addrExplorerKaspa) {
      ok[r] = kaspa_encode_address_from_leaf_node(&n, addrs[r], 80);
    } else {
      ok[r] = btc_encode_address_from_leaf_node(g_addrType, &n, addrs[r], 80);
    }
    secure_memzero(&n, sizeof(n));
  }
}

static void prefetch_address_explorer_neighbors(uint32_t centerPage) {
  if (!g_addrChainCacheValid) {
    invalidate_address_prefetch();
    return;
  }
  if (g_addrExplorerKaspa) {
    if (!g_addrChainCacheKaspa || g_addrChainCacheForAccount != g_addrAccount || g_addrChainCacheForChain != g_addrChain) {
      invalidate_address_prefetch();
      return;
    }
  } else if (g_addrChainCacheForType != g_addrType || g_addrChainCacheForAccount != g_addrAccount || g_addrChainCacheForChain != g_addrChain) {
    invalidate_address_prefetch();
    return;
  }
  uint32_t maxPage = ADDR_MAX_INDEX / (uint32_t)ADDR_PAGE_ROWS;
  Bip32Node chainCopy;
  memcpy(&chainCopy, &g_addrChainCacheNode, sizeof(Bip32Node));
  if (centerPage < maxPage) {
    fill_address_page_rows_from_chain_node(&chainCopy, centerPage + 1, g_addrPrefetchNextAddrs, g_addrPrefetchNextOk);
    g_addrPrefetchNextPage = centerPage + 1;
  } else {
    g_addrPrefetchNextPage = UINT32_MAX;
  }
  memcpy(&chainCopy, &g_addrChainCacheNode, sizeof(Bip32Node));
  if (centerPage > 0) {
    fill_address_page_rows_from_chain_node(&chainCopy, centerPage - 1, g_addrPrefetchPrevAddrs, g_addrPrefetchPrevOk);
    g_addrPrefetchPrevPage = centerPage - 1;
  } else {
    g_addrPrefetchPrevPage = UINT32_MAX;
  }
  secure_memzero(&chainCopy, sizeof(chainCopy));
}

static void invalidate_address_explorer_cache() {
  g_addrCacheValid = false;
  g_addrCacheKaspa = false;
  g_addrCacheMultisig = false;
  g_addrCacheMsWallet = 0;
  for (uint8_t i = 0; i < ADDR_PAGE_ROWS; i++) {
    g_addrPageOk[i] = false;
    g_addrPageAddr[i][0] = 0;
  }
  invalidate_address_prefetch();
}

static void invalidate_address_explorer_chain_node(void) {
  g_addrChainCacheValid = false;
  g_addrChainCacheKaspa = false;
  secure_memzero(&g_addrChainCacheNode, sizeof(g_addrChainCacheNode));
  invalidate_address_prefetch();
}

static bool ensure_address_page_cache() {
  if (!vault_is_unlocked() || !g_loggedIn || !(g_wc == 12 || g_wc == 24)) return false;
  if (g_addrExplorerMultisig) {
    if (g_multisigReceiveStoredIdx >= g_multisigWalletCount) return false;
    if (g_addrCacheValid && g_addrCacheMultisig && g_addrCachePage == g_addrPage && g_addrCacheChain == g_addrChain && g_addrCacheMsWallet == g_multisigReceiveStoredIdx) {
      return true;
    }
    addr_set_err("");
    const char* payload = g_multisigWalletPayloads[g_multisigReceiveStoredIdx];
    g_addrCachePage = g_addrPage;
    g_addrCacheChain = g_addrChain;
    g_addrCacheMsWallet = g_multisigReceiveStoredIdx;
    g_addrCacheMultisig = true;
    g_addrCacheValid = true;
    for (uint8_t r = 0; r < ADDR_PAGE_ROWS; r++) {
      g_addrPageAddr[r][0] = 0;
      g_addrPageOk[r] = false;
      uint32_t idx = g_addrPage * (uint32_t)ADDR_PAGE_ROWS + (uint32_t)r;
      if (idx > ADDR_MAX_INDEX) continue;
      g_addrPageOk[r] = multisig_wallet_deposit_address(payload, g_addrChain, idx, g_addrPageAddr[r],
                                                        sizeof(g_addrPageAddr[r]), NULL);
    }
    invalidate_address_prefetch();
    return true;
  }
  if (g_addrCacheValid && g_addrCacheKaspa == g_addrExplorerKaspa && g_addrCacheAccount == g_addrAccount && g_addrCacheChain == g_addrChain && g_addrCachePage == g_addrPage && (g_addrExplorerKaspa || g_addrCacheType == g_addrType)) {
    return true;
  }
  g_addrCacheKaspa = g_addrExplorerKaspa;
  if (!g_addrExplorerKaspa) g_addrCacheType = g_addrType;
  g_addrCacheAccount = g_addrAccount;
  g_addrCacheChain = g_addrChain;
  g_addrCachePage = g_addrPage;
  g_addrCacheMultisig = false;
  addr_set_err("");
  Bip32Node chainNode;
  memset(&chainNode, 0, sizeof(chainNode));
  bool chainHit = false;
  if (g_addrChainCacheValid) {
    if (g_addrExplorerKaspa) {
      chainHit = g_addrChainCacheKaspa && g_addrChainCacheForAccount == g_addrAccount && g_addrChainCacheForChain == g_addrChain;
    } else {
      chainHit = !g_addrChainCacheKaspa && g_addrChainCacheForType == g_addrType && g_addrChainCacheForAccount == g_addrAccount && g_addrChainCacheForChain == g_addrChain;
    }
  }
  if (chainHit) {
    memcpy(&chainNode, &g_addrChainCacheNode, sizeof(Bip32Node));
  } else {
    bool derived = false;
    if (g_addrExplorerKaspa) {
      derived = derive_kaspa_node_to_chain(g_addrAccount, g_addrChain, &chainNode);
    } else {
      derived = derive_btc_node_to_chain(g_addrType, g_addrAccount, g_addrChain, &chainNode);
    }
    if (!derived) {
      for (uint8_t i = 0; i < ADDR_PAGE_ROWS; i++) {
        g_addrPageAddr[i][0] = 0;
        g_addrPageOk[i] = false;
      }
      g_addrChainCacheValid = false;
      g_addrChainCacheKaspa = false;
      secure_memzero(&g_addrChainCacheNode, sizeof(g_addrChainCacheNode));
      invalidate_address_prefetch();
      g_addrCacheValid = true;
      secure_memzero(&chainNode, sizeof(chainNode));
      return false;
    }
    memcpy(&g_addrChainCacheNode, &chainNode, sizeof(Bip32Node));
    g_addrChainCacheValid = true;
    g_addrChainCacheKaspa = g_addrExplorerKaspa;
    g_addrChainCacheForAccount = g_addrAccount;
    g_addrChainCacheForChain = g_addrChain;
    if (!g_addrExplorerKaspa) g_addrChainCacheForType = g_addrType;
  }
  fill_address_page_rows_from_chain_node(&chainNode, g_addrPage, g_addrPageAddr, g_addrPageOk);
  secure_memzero(&chainNode, sizeof(chainNode));
  g_addrCacheValid = true;
  if (!g_addrDeferPrefetchUntilAfterListFlush) {
    prefetch_address_explorer_neighbors(g_addrPage);
  }
  return true;
}


