// Sparse luma stats for camera auto-tuning (mean + spread + dark fraction for washed-out blacks).
// darkFrac255 ≈ fraction of samples below ~black-module gray (scaled 0..255).
static void sample_luma_stats_sparse(const uint8_t* img, size_t len, uint8_t* outMean, uint8_t* outSpread, uint8_t* outDarkFrac255) {
  if (outMean) *outMean = 127;
  if (outSpread) *outSpread = 0;
  if (outDarkFrac255) *outDarkFrac255 = 0;
  if (!img || len == 0) return;
  const size_t step = (len > 350000) ? 128 : ((len > 180000) ? 96 : 64);
  uint64_t sum = 0;
  size_t n = 0;
  uint32_t dark = 0;
  uint8_t lo = 255, hi = 0;
  for (size_t i = 0; i < len; i += step) {
    uint8_t v = img[i];
    sum += v;
    n++;
    if (v < lo) lo = v;
    if (v > hi) hi = v;
    if (v < 72) dark++;  // likely QR black / shadow (washed scenes lose this)
  }
  if (n == 0) return;
  if (outMean) *outMean = (uint8_t)(sum / n);
  if (outSpread) *outSpread = (uint8_t)(hi - lo);
  if (outDarkFrac255) *outDarkFrac255 = (uint8_t)((dark * 255u) / n);
}

// PSBT-only adaptive camera tuning: crystal-clear edges, less washout/smudge drift.
// Uses mean + histogram spread; runs more often when scene is bad or decode is stuck.
static void psbt_adaptive_camera_tune(const uint8_t* frame, size_t imgSize, int qrCount) {
  static uint8_t s_tune_skip = 0;
  static int8_t s_curBrightness = 100;
  static int8_t s_curContrast = 100;
  static int8_t s_curSharpness = 100;
  static int8_t s_curGainCeil = 100;
  static int8_t s_curAeLevel = 100;
  if (!frame || imgSize == 0) return;
  // Never touch ISP while Quirc's finder already sees the QR — any AE/sharpness step causes temporal smear.
  if (qrCount > 0) return;

  uint8_t mean = 127, spread = 0, darkFrac = 0;
  sample_luma_stats_sparse(frame, imgSize, &mean, &spread, &darkFrac);

  // Washed QR: mean creeps up and/or too few truly dark pixels (black modules turn gray, then clip).
  const bool washoutBlacks = (darkFrac < 36 && mean > 105) || (mean >= 158 && spread < 72);
  // Tune more aggressively when bright, dark, flat (smudgy), decode failing, or AE washing blacks away.
  const int brightThresh = g_camSensorOv5640 ? 148 : 162;
  const bool badLight = (mean >= (uint8_t)brightThresh || mean <= 72);
  const bool flatScene = (spread < 48);  // low contrast / motion mush → muddy modules
  const bool decodeStuck = (g_qr_decode_fail_streak >= 14);
  uint8_t intervalMask = (badLight || flatScene || decodeStuck || washoutBlacks) ? 3u : 7u;
  if (washoutBlacks || mean >= 182) intervalMask = 1u;  // every 2 frames when clearly washing out
  if ((++s_tune_skip & intervalMask) != 0) return;

  sensor_t* s = esp_camera_sensor_get();
  if (!s) return;

  int8_t targetBrightness = g_camSensorOv5640 ? -2 : -1;  // OV5640: default under-exposed vs monitor bloom
  int8_t targetContrast = 4;                              // stronger module separation → less mud / smear on VGA-class sensors
  int8_t targetSharpness = 4;
  int8_t targetGainCeil = g_camSensorOv5640 ? 3 : 4;

  if (g_camSensorOv5640) {
    // OV5640: tends to run brighter / more gain than OV2640 at same scene — shift tiers earlier.
    if (mean >= 188) {  // severe washout / clipping
      targetBrightness = -2;
      targetContrast = 4;
      targetSharpness = 4;
      targetGainCeil = 2;
    } else if (mean >= 168) {  // bright / blooming
      targetBrightness = -2;
      targetContrast = 4;
      targetSharpness = 4;
      targetGainCeil = 2;
    } else if (mean >= 148) {  // high (OV5640 “bright” band starts lower)
      targetBrightness = -2;
      targetContrast = 4;
      targetSharpness = 4;
      targetGainCeil = 3;
    } else if (mean <= 52) {  // very dark
      targetBrightness = 2;
      targetContrast = 4;
      targetSharpness = 3;
      targetGainCeil = 5;     // OV5640: cap max gain → less noise smear
    } else if (mean <= 72) {  // dark
      targetBrightness = 1;
      targetContrast = 4;
      targetSharpness = 4;
      targetGainCeil = 2;
    }
  } else {
    if (mean >= 210) {  // severe washout / clipping
      targetBrightness = -2;
      targetContrast = 4;
      targetSharpness = 4;
      targetGainCeil = 2;
    } else if (mean >= 188) {  // bright / blooming
      targetBrightness = -2;
      targetContrast = 3;
      targetSharpness = 4;
      targetGainCeil = 2;
    } else if (mean >= 172) {  // high but usable
      targetBrightness = -2;
      targetContrast = 4;
      targetSharpness = 4;
      targetGainCeil = 2;
    } else if (mean <= 52) {  // very dark
      targetBrightness = 2;
      targetContrast = 3;
      targetSharpness = 3;
      targetGainCeil = 6;
    } else if (mean <= 72) {  // dark
      targetBrightness = 1;
      targetContrast = 4;
      targetSharpness = 3;
      targetGainCeil = 5;
    }
  }
  // else: mid-gray — targetBrightness stays -1, contrast 3 from defaults

  // Flat / smudgy histogram: push module separation (not heavy CPU filters).
  if (flatScene) {
    targetContrast = 3;
    if (targetSharpness < 4) targetSharpness = 4;
    if (targetGainCeil > (g_camSensorOv5640 ? 3 : 4)) targetGainCeil = (g_camSensorOv5640 ? 3 : 4);
  }

  if (decodeStuck) {
    if (targetContrast < 3) targetContrast = 3;
    if (targetSharpness < 4) targetSharpness = 4;
    const uint8_t brightPull = g_camSensorOv5640 ? 150 : 160;
    if (mean >= brightPull && targetBrightness > -1) targetBrightness--;
  }

  if (washoutBlacks) {
    if (targetBrightness > -2) targetBrightness--;
    if (targetGainCeil > 2) targetGainCeil = 2;
    if (targetSharpness < 4) targetSharpness = 4;
  }

  if (s->set_brightness && targetBrightness != s_curBrightness) {
    s->set_brightness(s, targetBrightness);
    s_curBrightness = targetBrightness;
  }
  if (s->set_contrast && targetContrast != s_curContrast) {
    s->set_contrast(s, targetContrast);
    s_curContrast = targetContrast;
  }
  if (s->set_sharpness && targetSharpness != s_curSharpness) {
    s->set_sharpness(s, targetSharpness);
    s_curSharpness = targetSharpness;
  }
  if (s->set_gainceiling && targetGainCeil != s_curGainCeil) {
    s->set_gainceiling(s, (gainceiling_t)targetGainCeil);
    s_curGainCeil = targetGainCeil;
  }
  // OV5640 / ESP driver: bias AE down early — bright monitor QR lifts exposure otherwise.
  if (s->set_ae_level) {
    int8_t ae = 0;
    if (mean >= 148 || washoutBlacks) ae = -2;
    else if (mean >= 104) ae = -1;
    else if (mean <= 62) ae = 1;
    else ae = 0;
    if (ae != s_curAeLevel) {
      s->set_ae_level(s, ae);
      s_curAeLevel = ae;
    }
  }
}

// Fountain / multipart: hold exposure down vs bright UR animation; crisp DSP for module edges.
static void psbt_multipart_isp_stabilize(const uint8_t* frame, size_t imgSize, bool isEntry) {
  sensor_t* s = esp_camera_sensor_get();
  if (!s) return;

  uint8_t mean = 127, darkFrac = 0;
  if (frame && imgSize > 0)
    sample_luma_stats_sparse(frame, imgSize, &mean, nullptr, &darkFrac);

  const uint8_t washMeanThr =
    (uint8_t)(g_camSensorOv5640 ? SEEDMASK_PSBT_OV5640_WASHOUT_MEAN : 138);
  const bool washout = (darkFrac < 36 && mean > 92) || mean >= washMeanThr;

  if (isEntry) {
    const int8_t g0 = g_camSensorOv5640 ? 1 : 2;
    if (g_camSensorOv5640) {
      if (s->set_ae_level) {
        s->set_ae_level(s, -2);
        g_psbt_mp_isp_ae = -2;
      }
      if (s->set_brightness) {
        s->set_brightness(s, -2);
        g_psbt_mp_isp_br = -2;
      }
      if (s->set_gainceiling) {
        s->set_gainceiling(s, (gainceiling_t)g0);
        g_psbt_mp_isp_gc = g0;
      }
      if (s->set_sharpness) {
        s->set_sharpness(s, 4);
        g_psbt_mp_isp_sh = 4;
      }
    } else {
      if (s->set_ae_level && g_psbt_mp_isp_ae != -2) {
        s->set_ae_level(s, -2);
        g_psbt_mp_isp_ae = -2;
      }
      if (s->set_brightness && g_psbt_mp_isp_br != -2) {
        s->set_brightness(s, -2);
        g_psbt_mp_isp_br = -2;
      }
      if (s->set_gainceiling && g_psbt_mp_isp_gc != g0) {
        s->set_gainceiling(s, (gainceiling_t)g0);
        g_psbt_mp_isp_gc = g0;
      }
      if (s->set_sharpness && g_psbt_mp_isp_sh != 4) {
        s->set_sharpness(s, 4);
        g_psbt_mp_isp_sh = 4;
      }
    }
    if (s->set_contrast) s->set_contrast(s, 3);
    if (s->set_denoise) s->set_denoise(s, 0);
    return;
  }

  int8_t wantAe = -2;
  int8_t wantBr = -2;
  int8_t wantGc = g_camSensorOv5640 ? 1 : 2;
  if (washout) {
    wantBr = -2;
    wantGc = 1;
  } else if (mean <= 58 && darkFrac >= 42) {
    wantAe = -1;
    wantBr = -1;
    wantGc = g_camSensorOv5640 ? 3 : 4;
  }

  // OV5640 + animated UR: HW AE ramps exposure between polls unless we rewrite every frame.
  if (g_camSensorOv5640) {
    if (s->set_ae_level) {
      s->set_ae_level(s, wantAe);
      g_psbt_mp_isp_ae = wantAe;
    }
    if (s->set_brightness) {
      s->set_brightness(s, wantBr);
      g_psbt_mp_isp_br = wantBr;
    }
    if (s->set_gainceiling) {
      s->set_gainceiling(s, (gainceiling_t)wantGc);
      g_psbt_mp_isp_gc = wantGc;
    }
    if (s->set_sharpness) {
      s->set_sharpness(s, 4);
      g_psbt_mp_isp_sh = 4;
    }
    return;
  }

  if (s->set_ae_level && g_psbt_mp_isp_ae != wantAe) {
    s->set_ae_level(s, wantAe);
    g_psbt_mp_isp_ae = wantAe;
  }
  if (s->set_brightness && g_psbt_mp_isp_br != wantBr) {
    s->set_brightness(s, wantBr);
    g_psbt_mp_isp_br = wantBr;
  }
  if (s->set_gainceiling && g_psbt_mp_isp_gc != wantGc) {
    s->set_gainceiling(s, (gainceiling_t)wantGc);
    g_psbt_mp_isp_gc = wantGc;
  }
  if (s->set_sharpness && g_psbt_mp_isp_sh != 4) {
    s->set_sharpness(s, 4);
    g_psbt_mp_isp_sh = 4;
  }
}

// Idle cold-start: bias exposure down when scene is bright (no full adaptive table; minimal I2C).
static void psbt_idle_warmup_isp(const uint8_t* frame, size_t imgSize) {
  sensor_t* s = esp_camera_sensor_get();
  if (!s || !frame || imgSize == 0) return;

  uint8_t mean = 127;
  sample_luma_stats_sparse(frame, imgSize, &mean, nullptr, nullptr);
  if (mean <= 84) return;

  int8_t wantAe = -2;
  int8_t wantBr = -2;
  // Cap analog gain early — dead branch removed (mean>=124 hid mean>=148).
  int8_t wantGc = 1;
  if (!g_camSensorOv5640 && mean < 100)
    wantGc = 2;

  if (s->set_ae_level && g_psbt_warm_isp_ae != wantAe) {
    s->set_ae_level(s, wantAe);
    g_psbt_warm_isp_ae = wantAe;
  }
  if (s->set_brightness && g_psbt_warm_isp_br != wantBr) {
    s->set_brightness(s, wantBr);
    g_psbt_warm_isp_br = wantBr;
  }
  if (s->set_gainceiling && g_psbt_warm_isp_gc != wantGc) {
    s->set_gainceiling(s, (gainceiling_t)wantGc);
    g_psbt_warm_isp_gc = wantGc;
  }
}

// Finder locked but UR fountain not started yet: hold exposure down vs bright monitor / AE drift (multipart path already does this).
// Does not replace psbt_adaptive_camera_tune — only applies washout / dark-scene clamp with minimal I2C writes.
// rawFinderCount / fail streak ⇒ assume monitor QR — force multipart-like dark limits without waiting for sparse washout stats.
// When washout is active, sensor registers are pushed every call (HW AE fights cached-only writes).
static void psbt_engaged_isp_washout_clamp(const uint8_t* frame, size_t imgSize, int rawFinderCount) {
  sensor_t* s = esp_camera_sensor_get();
  if (!s) return;

  uint8_t mean = 127, darkFrac = 0;
  if (frame && imgSize > 0)
    sample_luma_stats_sparse(frame, imgSize, &mean, nullptr, &darkFrac);

  const bool forceDark =
    (rawFinderCount > 0) || (g_qr_decode_fail_streak >= 1);
  const bool washout = forceDark || (darkFrac < 32 && mean > 98) || mean >= (uint8_t)(g_camSensorOv5640 ? SEEDMASK_PSBT_OV5640_WASHOUT_MEAN : 142);

  int8_t wantAe = -2;
  int8_t wantBr = -2;
  int8_t wantGc = g_camSensorOv5640 ? 1 : 3;
  if (washout) {
    wantBr = -2;
    wantGc = 1;
  } else if (mean <= 58 && darkFrac >= 42) {
    wantAe = -1;
    wantBr = -1;
    wantGc = g_camSensorOv5640 ? 3 : 4;
  }

  if (washout) {
    if (s->set_ae_level) {
      s->set_ae_level(s, wantAe);
      g_psbt_eng_isp_ae = wantAe;
    }
    if (s->set_brightness) {
      s->set_brightness(s, wantBr);
      g_psbt_eng_isp_br = wantBr;
    }
    if (s->set_gainceiling) {
      s->set_gainceiling(s, (gainceiling_t)wantGc);
      g_psbt_eng_isp_gc = wantGc;
    }
    if (s->set_sharpness) {
      s->set_sharpness(s, 4);
      g_psbt_eng_isp_sh = 4;
    }
    return;
  }

  if (s->set_ae_level && g_psbt_eng_isp_ae != wantAe) {
    s->set_ae_level(s, wantAe);
    g_psbt_eng_isp_ae = wantAe;
  }
  if (s->set_brightness && g_psbt_eng_isp_br != wantBr) {
    s->set_brightness(s, wantBr);
    g_psbt_eng_isp_br = wantBr;
  }
  if (s->set_gainceiling && g_psbt_eng_isp_gc != wantGc) {
    s->set_gainceiling(s, (gainceiling_t)wantGc);
    g_psbt_eng_isp_gc = wantGc;
  }
  if (s->set_sharpness && g_psbt_eng_isp_sh != 4) {
    s->set_sharpness(s, 4);
    g_psbt_eng_isp_sh = 4;
  }
}

/** Vault encrypted QR (SPE1 / multipart): OV5640 HW AE ramps toward bright phone screens — rewrite ISP each poll like PSBT multipart. */
static int8_t s_vault_qr_isp_ae = -99, s_vault_qr_isp_br = -99, s_vault_qr_isp_gc = -99, s_vault_qr_isp_sh = -99;

static void vault_qr_isp_reset_shadow(void) {
  s_vault_qr_isp_ae = s_vault_qr_isp_br = s_vault_qr_isp_gc = s_vault_qr_isp_sh = -99;
}

/** In-place luma pull for this DMA frame — ISP registers only affect the next capture. */
static void vault_soft_darken_if_washed_out(uint8_t* p, size_t len) {
  if (!p || len == 0) return;
  uint8_t mean = 127;
  sample_luma_stats_sparse(p, len, &mean, nullptr, nullptr);
  if (mean < 82) return;
  const unsigned numer = mean >= 108 ? 68u : mean >= 96 ? 78u
                                                        : 88u;
  for (size_t i = 0; i < len; ++i)
    p[i] = (uint8_t)(((unsigned)p[i] * numer) >> 7);
}

static void vault_qr_isp_stabilize(const uint8_t* frame, size_t imgSize) {
  sensor_t* s = esp_camera_sensor_get();
  if (!s || !frame || imgSize == 0) return;

  uint8_t mean = 127, darkFrac = 0;
  sample_luma_stats_sparse(frame, imgSize, &mean, nullptr, &darkFrac);

  const bool washout =
    (darkFrac < 42 && mean > 80) || mean >= (uint8_t)(g_camSensorOv5640 ? SEEDMASK_PSBT_OV5640_WASHOUT_MEAN : 130);

  int8_t wantAe = -2;
  int8_t wantBr = -2;
  int8_t wantGc = g_camSensorOv5640 ? 1 : 2;
  if (washout) {
    wantBr = -2;
    wantGc = 1;
  } else if (mean <= 58 && darkFrac >= 42) {
    wantAe = -1;
    wantBr = -1;
    wantGc = g_camSensorOv5640 ? 3 : 4;
  }

  if (g_camSensorOv5640) {
    if (s->set_ae_level) {
      s->set_ae_level(s, wantAe);
      s_vault_qr_isp_ae = wantAe;
    }
    if (s->set_brightness) {
      s->set_brightness(s, wantBr);
      s_vault_qr_isp_br = wantBr;
    }
    if (s->set_gainceiling) {
      s->set_gainceiling(s, (gainceiling_t)wantGc);
      s_vault_qr_isp_gc = wantGc;
    }
    if (s->set_sharpness) {
      s->set_sharpness(s, 4);
      s_vault_qr_isp_sh = 4;
    }
    return;
  }

  if (s->set_ae_level && s_vault_qr_isp_ae != wantAe) {
    s->set_ae_level(s, wantAe);
    s_vault_qr_isp_ae = wantAe;
  }
  if (s->set_brightness && s_vault_qr_isp_br != wantBr) {
    s->set_brightness(s, wantBr);
    s_vault_qr_isp_br = wantBr;
  }
  if (s->set_gainceiling && s_vault_qr_isp_gc != wantGc) {
    s->set_gainceiling(s, (gainceiling_t)wantGc);
    s_vault_qr_isp_gc = wantGc;
  }
  if (s->set_sharpness && s_vault_qr_isp_sh != 4) {
    s->set_sharpness(s, 4);
    s_vault_qr_isp_sh = 4;
  }
}

static bool camera_pins_configured() {
  return !(CAM_PIN_XCLK == -1 || CAM_PIN_SIOD == -1 || CAM_PIN_SIOC == -1 || CAM_PIN_D0 == -1 || CAM_PIN_D1 == -1 || CAM_PIN_D2 == -1 || CAM_PIN_D3 == -1 || CAM_PIN_D4 == -1 || CAM_PIN_D5 == -1 || CAM_PIN_D6 == -1 || CAM_PIN_D7 == -1 || CAM_PIN_VSYNC == -1 || CAM_PIN_HREF == -1 || CAM_PIN_PCLK == -1);
}

/** Tracks g_gray / g_grayRaw allocation so resolution changes (VGA→SVGA) reallocate — avoids undersized memcpy→Quirc. */
static size_t s_cam_gray_buf_bytes = 0;

static bool camera_init_grayscale(framesize_t frameSize, int w, int h) {
  if (!camera_pins_configured()) return false;

  const bool isRestoreVaultQrScan =
    (g_qrScanTarget == QrScanTarget::RESTORE && !g_restoreSeedQrOnlyScan);

  // Orphaned driver state (esp_camera_init OK, then gray/Quirc alloc failed) blocks the next init.
  esp_camera_deinit();
  g_camOn = false;

  camera_config_t config;
  memset(&config, 0, sizeof(config));

  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;

  config.pin_d0 = CAM_PIN_D0;
  config.pin_d1 = CAM_PIN_D1;
  config.pin_d2 = CAM_PIN_D2;
  config.pin_d3 = CAM_PIN_D3;
  config.pin_d4 = CAM_PIN_D4;
  config.pin_d5 = CAM_PIN_D5;
  config.pin_d6 = CAM_PIN_D6;
  config.pin_d7 = CAM_PIN_D7;

  config.pin_xclk = CAM_PIN_XCLK;
  config.pin_pclk = CAM_PIN_PCLK;
  config.pin_vsync = CAM_PIN_VSYNC;
  config.pin_href = CAM_PIN_HREF;
  config.pin_sccb_sda = CAM_PIN_SIOD;
  config.pin_sccb_scl = CAM_PIN_SIOC;
  config.pin_pwdn = CAM_PIN_PWDN;
  config.pin_reset = CAM_PIN_RESET;

  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_GRAYSCALE;
  config.frame_size = frameSize;
  config.jpeg_quality = 12;
  config.fb_location = CAMERA_FB_IN_PSRAM;
  config.grab_mode = CAMERA_GRAB_LATEST;
  // SVGA grayscale needs more DMA slack or esp_camera_fb_get() starves while CPU runs Quirc/SPI.
  int fbCount = (frameSize >= FRAMESIZE_SVGA) ? 4 : 2;
  if (frameSize >= FRAMESIZE_SVGA && isRestoreVaultQrScan)
    fbCount = (int)SEEDMASK_VAULT_SVGA_FB_COUNT;
  if (fbCount < 2) fbCount = 2;

  esp_err_t err = ESP_FAIL;
  for (int attempt = 0; attempt < 2; attempt++) {
    config.fb_count = (attempt == 0) ? fbCount : 2;
    err = esp_camera_init(&config);
    if (err == ESP_OK) break;
    Serial.printf("esp_camera_init failed err=0x%x fs=%d fb=%d\n", (unsigned)err, (int)frameSize, config.fb_count);
    esp_camera_deinit();
    if (!(frameSize >= FRAMESIZE_SVGA && isRestoreVaultQrScan) || config.fb_count <= 2)
      break;
  }
  if (err != ESP_OK) return false;

  sensor_t* s = esp_camera_sensor_get();
  if (s) {
    const bool isPsbtScan = (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT);
    const bool isKaspaTxQrScan = (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT);
    /* PSBT + Kaspa: same dense-monitor ISP (crisp preview, washout clamp) from first frame. */
    const bool isDenseMonitorQrScan = isPsbtScan || isKaspaTxQrScan;
    /** RESTORE → encrypted/vault QR (not SeedQR): cap gain + tame AE so frames aren’t blown white / unstable vs Quirc. */
    if (isRestoreVaultQrScan)
      vault_qr_isp_reset_shadow();
    g_camSensorOv5640 = (SEEDMASK_CAMERA_FORCE_OV5640 != 0) || (s->id.PID == 0x5640);
    s->set_hmirror(s, 0);
    s->set_vflip(s, 1);
    if (s->set_contrast) s->set_contrast(s, isDenseMonitorQrScan ? 3 : ((w >= 800) ? 2 : 1));
    if (s->set_saturation) s->set_saturation(s, 0);
    if (s->set_denoise) s->set_denoise(s, 0);  // no NR blur (keeps QR modules sharp)
    if (s->set_quality) s->set_quality(s, 10);
    // PSBT + Kaspa PSKT: start dark + low gain — monitor UR reads “mid gray” but clips if AE runs open-loop.
    if (isDenseMonitorQrScan && g_camSensorOv5640) {
      if (s->set_brightness) s->set_brightness(s, -2);
      if (s->set_sharpness) s->set_sharpness(s, 4);
      if (s->set_gainceiling) s->set_gainceiling(s, (gainceiling_t)1);
      if (s->set_aec2) s->set_aec2(s, 0);
    } else if (isDenseMonitorQrScan) {
      if (s->set_brightness) s->set_brightness(s, -2);
      if (s->set_sharpness) s->set_sharpness(s, 4);
      if (s->set_gainceiling) s->set_gainceiling(s, (gainceiling_t)2);
      if (s->set_aec2) s->set_aec2(s, 0);
    } else if (isRestoreVaultQrScan && g_camSensorOv5640) {
      if (s->set_contrast) s->set_contrast(s, 3);
      if (s->set_brightness) s->set_brightness(s, -2);
      if (s->set_sharpness) s->set_sharpness(s, 4);
      if (s->set_gainceiling) s->set_gainceiling(s, (gainceiling_t)1);
      if (s->set_aec2) s->set_aec2(s, 0);
      if (s->set_whitebal) s->set_whitebal(s, 0);
      if (s->set_awb_gain) s->set_awb_gain(s, 0);
      if (s->set_wb_mode) s->set_wb_mode(s, 0);
    } else if (isRestoreVaultQrScan) {
      if (s->set_brightness) s->set_brightness(s, -2);
      if (s->set_sharpness) s->set_sharpness(s, 3);
      if (s->set_gainceiling) s->set_gainceiling(s, (gainceiling_t)2);
      if (s->set_aec2) s->set_aec2(s, 0);
      if (s->set_ae_level) s->set_ae_level(s, -2);
      if (s->set_whitebal) s->set_whitebal(s, 0);
      if (s->set_awb_gain) s->set_awb_gain(s, 0);
      if (s->set_wb_mode) s->set_wb_mode(s, 0);
    } else {
      if (s->set_brightness) s->set_brightness(s, (w >= 800) ? 0 : 1);
      if (s->set_sharpness) s->set_sharpness(s, (w >= 800) ? 2 : 1);
      if (s->set_gainceiling) s->set_gainceiling(s, (gainceiling_t)6);
      if (s->set_aec2) s->set_aec2(s, 1);
    }
    if (isDenseMonitorQrScan && s->set_ae_level)
      s->set_ae_level(s, -2);
#ifndef SEEDMASK_PSBT_SENSOR_LOCK_AE
#define SEEDMASK_PSBT_SENSOR_LOCK_AE 0
#endif
#if SEEDMASK_PSBT_SENSOR_LOCK_AE
    // Experimental OV5640/OV2640: turn off HW auto exposure/gain so exposure time / analog gain can be fixed via registers.
    // Requires driver support and usually manual exposure/gain values — enable only when experimenting with washout that software bias cannot fix.
    if (isDenseMonitorQrScan) {
      if (s->set_gain_ctrl) s->set_gain_ctrl(s, 0);
      if (s->set_exposure_ctrl) s->set_exposure_ctrl(s, 0);
    }
#endif
    // OV5640 AEC continues integrating after set_ae_level — first frames are often too bright unless we flush and clamp again.
    if (isDenseMonitorQrScan && g_camSensorOv5640 && SEEDMASK_PSBT_OV5640_STARTUP_DISCARD_FRAMES > 0) {
      for (int fi = 0; fi < (int)SEEDMASK_PSBT_OV5640_STARTUP_DISCARD_FRAMES; fi++) {
        camera_fb_t* dfb = esp_camera_fb_get();
        if (dfb) esp_camera_fb_return(dfb);
      }
      if (s->set_brightness) s->set_brightness(s, -2);
      if (s->set_ae_level) s->set_ae_level(s, -2);
      if (s->set_gainceiling) s->set_gainceiling(s, (gainceiling_t)1);
      if (s->set_sharpness) s->set_sharpness(s, 4);
    }
    if (isRestoreVaultQrScan && g_camSensorOv5640) {
      if (s->set_ae_level) s->set_ae_level(s, -2);
      if (SEEDMASK_PSBT_OV5640_STARTUP_DISCARD_FRAMES > 0) {
        for (int fi = 0; fi < (int)SEEDMASK_PSBT_OV5640_STARTUP_DISCARD_FRAMES; fi++) {
          camera_fb_t* dfb = esp_camera_fb_get();
          if (dfb) esp_camera_fb_return(dfb);
        }
      }
      if (s->set_brightness) s->set_brightness(s, -2);
      if (s->set_ae_level) s->set_ae_level(s, -2);
      if (s->set_gainceiling) s->set_gainceiling(s, (gainceiling_t)1);
      if (s->set_sharpness) s->set_sharpness(s, 3);
    }
  }

  // Actual sensor/DMA output size can differ slightly from requested FRAMESIZE_* — sync globals or poll rejects every frame.
  int aw = w;
  int ah = h;
  {
    camera_fb_t* probe = esp_camera_fb_get();
    if (probe && probe->buf) {
      aw = (int)probe->width;
      ah = (int)probe->height;
      esp_camera_fb_return(probe);
    }
  }
  if (aw > 0 && ah > 0) {
    g_qr_w = aw;
    g_qr_h = ah;
  }

  const size_t needGray = (size_t)aw * (size_t)ah;
  if (needGray != s_cam_gray_buf_bytes || !g_gray || !g_grayRaw) {
    if (g_gray) {
      free(g_gray);
      g_gray = nullptr;
    }
    if (g_grayRaw) {
      free(g_grayRaw);
      g_grayRaw = nullptr;
    }
    s_cam_gray_buf_bytes = 0;
  }

  g_q = quirc_new();
  if (!g_q) {
    esp_camera_deinit();
    return false;
  }
  if (quirc_resize(g_q, aw, ah) != 0) {
    quirc_destroy(g_q);
    g_q = nullptr;
    esp_camera_deinit();
    return false;
  }

  if (!g_gray) {
    g_gray = (uint8_t*)ps_malloc(needGray);
    if (!g_gray) {
      quirc_destroy(g_q);
      g_q = nullptr;
      esp_camera_deinit();
      return false;
    }
    g_grayRaw = (uint8_t*)ps_malloc(needGray);
    if (!g_grayRaw) {
      free(g_gray);
      g_gray = nullptr;
      quirc_destroy(g_q);
      g_q = nullptr;
      esp_camera_deinit();
      return false;
    }
    s_cam_gray_buf_bytes = needGray;
  }

  return true;
}

static void camera_deinit() {
  g_camSensorOv5640 = false;
  if (g_q) {
    quirc_destroy(g_q);
    g_q = nullptr;
  }
  if (g_gray) {
    free(g_gray);
    g_gray = nullptr;
  }
  if (g_grayRaw) {
    free(g_grayRaw);
    g_grayRaw = nullptr;
  }
  s_cam_gray_buf_bytes = 0;
  if (g_psbtLatchRaw) {
    free(g_psbtLatchRaw);
    g_psbtLatchRaw = nullptr;
  }
  g_psbtLatchImgBytes = 0;
  g_psbtLatchUntilMs = 0;
  if (g_vaultLatchRaw) {
    free(g_vaultLatchRaw);
    g_vaultLatchRaw = nullptr;
  }
  g_vaultLatchImgBytes = 0;
  g_vaultLatchUntilMs = 0;
  // Always release the driver — a failed mid-init can leave it up while g_camOn is still false.
  esp_camera_deinit();
  g_camOn = false;
}

/**
 * esp32-camera often returns WxH slightly different from FRAMESIZE_* / probe — strict equality in poll dropped
 * every frame (memcpy size mismatch → decode never ran). Resync Quirc + gray scratch to match this framebuffer.
 */
static bool sync_quirc_gray_to_live_fb(camera_fb_t* fb) {
  if (!fb || !fb->buf || !g_q) return false;
  const int nw = (int)fb->width;
  const int nh = (int)fb->height;
  if (nw < 16 || nh < 16 || nw > 4096 || nh > 4096) return false;
  if (nw == g_qr_w && nh == g_qr_h) return true;

  if (quirc_resize(g_q, nw, nh) != 0) return false;

  const size_t need = (size_t)nw * (size_t)nh;
  if (need != s_cam_gray_buf_bytes || !g_gray || !g_grayRaw) {
    if (g_gray) {
      free(g_gray);
      g_gray = nullptr;
    }
    if (g_grayRaw) {
      free(g_grayRaw);
      g_grayRaw = nullptr;
    }
    s_cam_gray_buf_bytes = 0;
    if (g_psbtLatchRaw) {
      free(g_psbtLatchRaw);
      g_psbtLatchRaw = nullptr;
      g_psbtLatchImgBytes = 0;
    }
    if (g_vaultLatchRaw) {
      free(g_vaultLatchRaw);
      g_vaultLatchRaw = nullptr;
      g_vaultLatchImgBytes = 0;
    }
    g_vaultLatchUntilMs = 0;
    g_gray = (uint8_t*)ps_malloc(need);
    if (!g_gray) return false;
    g_grayRaw = (uint8_t*)ps_malloc(need);
    if (!g_grayRaw) {
      free(g_gray);
      g_gray = nullptr;
      return false;
    }
    s_cam_gray_buf_bytes = need;
  }

  g_qr_w = nw;
  g_qr_h = nh;
  return true;
}

// Preview bitmap in PSRAM: 320x320 RGB565 = 204,800 bytes; bigger camera window for easier QR aiming
static uint16_t* g_previewBuf = nullptr;
#define PREVIEW_W 320
#define PREVIEW_H 320

// Pre-computed grayscale→RGB565 LUT: eliminates per-pixel bit-math in preview hot loop
static uint16_t g_grayLut565[256];
static bool g_grayLutReady = false;
static void ensureGrayLut() {
  if (g_grayLutReady) return;
  for (int i = 0; i < 256; i++)
    g_grayLut565[i] = ((i >> 3) << 11) | ((i >> 2) << 5) | (i >> 3);
  g_grayLutReady = true;
}

// PSBT live preview only: stretch apparent contrast so modules read “crisp” on LCD (does not affect Quirc buffer).
static uint16_t g_grayLut565_psbt[256];
static bool g_grayLutPsbtReady = false;
static void ensureGrayLutPsbt() {
  if (g_grayLutPsbtReady) return;
  ensureGrayLut();
  for (int i = 0; i < 256; i++) {
    int x = i - 128;
    x = (x * SEEDMASK_PSBT_PREVIEW_LUT_STRENGTH_NUM) / 128;
    x += 128;
    if (x < 0) x = 0;
    if (x > 255) x = 255;
    uint8_t v = (uint8_t)x;
    g_grayLut565_psbt[i] = ((v >> 3) << 11) | ((v >> 2) << 5) | (v >> 3);
  }
  g_grayLutPsbtReady = true;
}

// Vault encrypted restore: engaged preview only — punchier grayscale→565 so dark QR modules read clearly on LCD.
static uint16_t g_grayLut565_vault_crisp[256];
static bool g_grayLutVaultCrispReady = false;
static void ensureGrayLutVaultCrisp() {
  if (g_grayLutVaultCrispReady) return;
  ensureGrayLut();
  for (int i = 0; i < 256; i++) {
    int x = i - 128;
    x = (x * SEEDMASK_VAULT_PREVIEW_LUT_STRENGTH_NUM) / 128;
    x += 128;
    if (x < 0) x = 0;
    if (x > 255) x = 255;
    uint8_t v = (uint8_t)x;
    g_grayLut565_vault_crisp[i] = ((v >> 3) << 11) | ((v >> 2) << 5) | (v >> 3);
  }
  g_grayLutVaultCrispReady = true;
}

/** Same mapping as drawCameraPreviewGray default step (overlay / PSBT paths must stay in sync). */
static int seedmask_qr_preview_step_for_width(void) {
  if (g_qr_w >= 800) return SEEDMASK_PSBT_PREVIEW_LCD_STEP_SVGA;
  if (g_qr_w <= (int)SEEDMASK_PREVIEW_QVGA_MAX_W) return SEEDMASK_PREVIEW_LCD_STEP_QVGA;
  return SEEDMASK_PSBT_PREVIEW_LCD_STEP_VGA;
}

static void drawCameraPreviewGray(const uint8_t* gray, int stepOverride = 0, int dstY = 60) {
  g_camera_preview_dst_y = dstY;
  if (!g_previewBuf) {
    g_previewBuf = (uint16_t*)ps_malloc(PREVIEW_W * PREVIEW_H * sizeof(uint16_t));
    if (!g_previewBuf) return;
  }
  ensureGrayLut();
  const bool psbtCrispPreview =
    (g_qrScanTarget == QrScanTarget::CRYPTO_PSBT || g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT);
  const bool vaultEncPreview =
    (g_qrScanTarget == QrScanTarget::RESTORE && !g_restoreSeedQrOnlyScan);
  if (psbtCrispPreview)
    ensureGrayLutPsbt();
  /* Encrypted vault restore: always stretched preview LUT — reads sharper / less washed-out than linear gray. */
  if (vaultEncPreview)
    ensureGrayLutVaultCrisp();
  const uint16_t* lut =
    psbtCrispPreview ? g_grayLut565_psbt : (vaultEncPreview ? g_grayLut565_vault_crisp : g_grayLut565);
  const int step =
    (stepOverride >= 2) ? stepOverride : seedmask_qr_preview_step_for_width();
  const int outW = min((g_qr_w * 2) / step, PREVIEW_W);
  const int outH = min((g_qr_h * 2) / step, PREVIEW_H);

  // Vault QR: clear the full bitmap — partial clears left stale rows when hunt/engage dimensions differed and caused glitches.
  if (vaultEncPreview)
    memset(g_previewBuf, 0, (size_t)PREVIEW_W * (size_t)PREVIEW_H * sizeof(uint16_t));

  for (int sy = 0; sy < g_qr_h; sy += step) {
    int dy = (sy * 2) / step;
    if (dy + 1 >= PREVIEW_H) break;
    uint16_t* r0 = g_previewBuf + dy * PREVIEW_W;
    uint16_t* r1 = r0 + PREVIEW_W;
    const uint8_t* sr = gray + sy * g_qr_w;
    for (int sx = 0; sx < g_qr_w; sx += step) {
      int dx = (sx * 2) / step;
      if (dx + 1 >= PREVIEW_W) break;
      uint16_t c = lut[sr[sx]];
      r0[dx] = c;
      r0[dx + 1] = c;
      r1[dx] = c;
      r1[dx + 1] = c;
    }
  }
  // Vault: avoid startWrite/endWrite batch — some ESP32+SPI LCD combos tear when batching partial RGB565 blits.
#if SEEDMASK_PSBT_PREVIEW_GFX_BATCH
  const bool batchPsbtOnly = psbtCrispPreview && !vaultEncPreview;
  if (batchPsbtOnly) {
    gfx->startWrite();
    gfx->draw16bitRGBBitmap(0, dstY, g_previewBuf, outW, outH);
    gfx->endWrite();
  } else
#endif
  {
    gfx->draw16bitRGBBitmap(0, dstY, g_previewBuf, outW, outH);
  }
  if (vaultEncPreview && outW < LCD_W)
    gfx->fillRect(outW, dstY, LCD_W - outW, outH, RGB565_BLACK);
}

static int s_qr_last_count = 0;  // cached from last decode frame (for overlay when decode runs every 2nd frame)
static uint8_t s_qr_spinner = 0;

static void qrCamToDisp(int cx, int cy, int* dx, int* dy);
static void drawQRDetectOverlayFromCodes(const struct quirc_code* codes, int count);

static bool psbt_allow_success_cam_blit(void) {
  const uint32_t t = millis();
  if ((uint32_t)(t - s_psbt_decode_success_cam_ms) >= (uint32_t)SEEDMASK_PSBT_DECODE_UI_CAM_MS) {
    s_psbt_decode_success_cam_ms = t;
    return true;
  }
  return false;
}

// One SPI pass: optional live camera bitmap + status strip + progress bar + BACK (Bitcoin PSBT or Kaspa PSKT scan).
static void crypto_tx_scan_render_hud(const uint8_t* raw, bool drawCameraBitmap, float urPct,
                                    uint32_t urGot, uint32_t urNeed, bool latchActive,
                                    bool drawFinderOverlay) {
  const bool isKaspaPsktScan = (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT);
#ifndef SEEDMASK_PSBT_PREVIEW_STEP
#define SEEDMASK_PSBT_PREVIEW_STEP 0
#endif
#if SEEDMASK_PSBT_PREVIEW_STEP >= 2
  const int pvStep = SEEDMASK_PSBT_PREVIEW_STEP;
#else
  const int pvStep =
      isKaspaPsktScan ? kaspa_preview_step_for_hud() : seedmask_qr_preview_step_for_width();
#endif
#ifndef SEEDMASK_PSBT_PREVIEW_TOP
#define SEEDMASK_PSBT_PREVIEW_TOP 46
#endif
  const int prevTop = (int)SEEDMASK_PSBT_PREVIEW_TOP;

  if (drawCameraBitmap && raw) {
    if (isKaspaPsktScan && pvStep >= 2 && s_kaspa_preview_step_lock == 0)
      s_kaspa_preview_step_lock = pvStep;
    g_psbt_cam_preview_step = pvStep;
    g_psbt_last_cam_preview_ms = millis();
    drawCameraPreviewGray(raw, pvStep, prevTop);
    const int outH = min((g_qr_h * 2) / pvStep, PREVIEW_H);
    const int endY = prevTop + outH;
    if (endY < LCD_H) gfx->fillRect(0, endY, LCD_W, LCD_H - endY, RGB565_BLACK);
    if (drawFinderOverlay && s_psbt_raw_overlay_n > 0)
      drawQRDetectOverlayFromCodes(s_psbt_raw_overlay_codes, s_psbt_raw_overlay_n);
  }

  gfx->fillRect(0, 40, LCD_W, 20, RGB565_BLACK);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);
  gfx->setCursor(10, 44);
  s_psbt_hud_last_got = urGot;
  s_psbt_hud_last_need = urNeed;
  if (urNeed > 0) {
    const uint32_t dispNeed = urNeed;
    const uint32_t dispGot = urGot;
    int ip = (dispNeed > 0) ? (int)((dispGot * 100u + dispNeed / 2u) / dispNeed) : (int)(urPct * 100.0f + 0.5f);
    if (ip < 0) ip = 0;
    if (ip > 100) ip = 100;
    gfx->setTextColor(RGB565_WHITE);
    if (isKaspaPsktScan)
      gfx->print("PSKT UR ");
    else
      gfx->print("PSBT ");
    gfx->setTextColor(RGB565_CYAN);
    gfx->print(ip);
    gfx->print("%");
    gfx->setTextColor(RGB565_WHITE);
    gfx->printf("  %lu/%lu", (unsigned long)dispGot, (unsigned long)dispNeed);

    const int outH = min((g_qr_h * 2) / pvStep, PREVIEW_H);
    const int endY = prevTop + outH;
    const int barH = 10;
    int barY = endY - barH - 8;
    if (barY < prevTop + 94) barY = prevTop + 94;
    const int barX = 16;
    const int barW = LCD_W - 32;
    int filledW = (barW * ip + 50) / 100;
    if (filledW < 0) filledW = 0;
    if (ip > 0 && filledW < 1) filledW = 1;
    gfx->fillRect(barX, barY, barW, barH, UI_CARD);
    gfx->drawRect(barX, barY, barW, barH, UI_BORDER);
    if (filledW > 2) {
      const uint16_t barBlue = blendRGB565(RGB565_BLUE, RGB565_CYAN, 0.45f);
      gfx->fillRect(barX + 2, barY + 2, filledW - 4, barH - 4, barBlue);
    }
  } else if (g_msg[0] && g_qrScanning && isKaspaPsktScan) {
    gfx->setTextColor(RGB565_AMBER);
    gfx->print(g_msg);
  } else if (s_qr_last_count > 0) {
    if (isKaspaPsktScan) {
      if (latchActive)
        gfx->print("PSKT locked - hold steady...");
      else if (g_qr_decode_fail_streak >= 15)
        gfx->print("PSKT QR seen - hold steady...");
      else
        gfx->print("PSKT QR seen - decoding...");
    } else if (latchActive)
      gfx->print("QR locked - keep steady...");
    else if (g_qr_decode_fail_streak >= 15)
      gfx->print("QR seen, hold steady...");
    else
      gfx->print("QR seen - decoding...");
  } else {
    s_qr_spinner = (s_qr_spinner + 1) % 4;
    if (isKaspaPsktScan)
      gfx->print("Point PSKT QR ");
    else
      gfx->print("Point Sparrow QR ");
    for (int d = 0; d < s_qr_spinner; d++) gfx->print(".");
    for (int d = s_qr_spinner; d < 3; d++) gfx->print(" ");
  }
  if (!isKaspaPsktScan) {
    drawBtn(BTN_CRYPTO_SCAN_BACK, "BACK", RGB565_DARKGREY, 2);
  } else if (!s_kaspa_back_on_screen) {
    drawBtn(BTN_CRYPTO_SCAN_BACK, "BACK", RGB565_DARKGREY, 2);
    s_kaspa_back_on_screen = true;
  }
  g_psbt_last_hud_ms = millis();
  /* Kaspa multipart: full flush only when camera bitmap drawn (progress-only uses kaspa_paint_progress_text_bar). */
  if (!isKaspaPsktScan || drawCameraBitmap)
    ui_flush();
  g_psbt_cam_preview_step = 0;
}

// Map camera pixel (cx, cy) to display coords used by the preview (same scale as drawCameraPreviewGray)
static void qrCamToDisp(int cx, int cy, int* dx, int* dy) {
  int step = seedmask_qr_preview_step_for_width();
  if (g_psbt_cam_preview_step >= 2) step = g_psbt_cam_preview_step;
  if (dx) *dx = (cx * 2) / step;
  if (dy) *dy = g_camera_preview_dst_y + (cy * 2) / step;
}

// Draw overlay from codes already extracted (avoids re-running Quirc finder on raw after decode variants overwrote the image buffer).
static void drawQRDetectOverlayFromCodes(const struct quirc_code* codes, int count) {
  if (!codes || count <= 0) return;
  const uint16_t color = RGB565_GREEN;
  for (int i = 0; i < count && i < 4; i++) {
    const struct quirc_code* qc = &codes[i];
    int x0, y0, x1, y1, x2, y2, x3, y3;
    qrCamToDisp(qc->corners[0].x, qc->corners[0].y, &x0, &y0);
    qrCamToDisp(qc->corners[1].x, qc->corners[1].y, &x1, &y1);
    qrCamToDisp(qc->corners[2].x, qc->corners[2].y, &x2, &y2);
    qrCamToDisp(qc->corners[3].x, qc->corners[3].y, &x3, &y3);
    gfx->drawLine(x0, y0, x1, y1, color);
    gfx->drawLine(x1, y1, x2, y2, color);
    gfx->drawLine(x2, y2, x3, y3, color);
    gfx->drawLine(x3, y3, x0, y0, color);
  }
}

// Draw the four corners of a detected QR as a green outline so user sees "squares captured"
static void drawQRDetectOverlay(struct quirc* q, int count) {
  if (!q || count <= 0) return;
  static struct quirc_code codes[4];
  const int n = count > 4 ? 4 : count;
  for (int i = 0; i < n; i++)
    quirc_extract(q, i, &codes[i]);
  drawQRDetectOverlayFromCodes(codes, n);
}

