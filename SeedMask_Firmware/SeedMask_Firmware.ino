/** Short upward swipe or quick flick — same feel as opening Status panel. */
static bool nav_bar_wake_swipe_qualifies(int dx, int dy, uint32_t holdMs) {
  const int up = -dy;
  if (up <= 0) return false;
  const int adx = abs(dx);
  if (up <= adx) return false;
  if (up >= NAV_BAR_WAKE_SWIPE_MIN_DY) return true;
  if (holdMs > NAV_BAR_WAKE_FLICK_MAX_MS) return false;
  if (up < NAV_BAR_WAKE_FLICK_MIN_DY) return false;
  const uint32_t ms = holdMs > 0 ? holdMs : 1;
  return ((float)up / (float)ms) >= NAV_BAR_WAKE_FLICK_SPEED;
}

/** Single debounced space insert for editor/TFA (space-track + nav must share this). */
static bool nav_kb_try_insert_space(uint32_t nowMs) {
  if ((uint32_t)(nowMs - g_spaceTrackLastInsertMs) < SPACE_INSERT_DEBOUNCE_MS) return false;
  if (g_editMode != EditMode::NONE) {
    edit_add_char(' ');
    g_lastEditInputMs = nowMs;
    g_spaceTrackLastInsertMs = nowMs;
    draw();
    return true;
  }
  if (g_screen != UIScreen::TFA_ADD) return false;
  char* curBuf = (g_tfaAddFocus == 0) ? g_tfaAddLabel : (g_tfaAddFocus == 1) ? g_tfaAddAccount
                                                                             : g_tfaAddSecret;
  size_t curSize = (g_tfaAddFocus == 0) ? sizeof(g_tfaAddLabel) : (g_tfaAddFocus == 1) ? sizeof(g_tfaAddAccount)
                                                                                       : sizeof(g_tfaAddSecret);
  uint16_t& curPos = (g_tfaAddFocus == 0) ? g_tfaAddCursorLabel : (g_tfaAddFocus == 1) ? g_tfaAddCursorAccount
                                                                                       : g_tfaAddCursorSecret;
  size_t n = strlen(curBuf);
  if (curPos > n) curPos = (uint16_t)n;
  if (n >= curSize - 1) return false;
  memmove(&curBuf[curPos + 1], &curBuf[curPos], n - (size_t)curPos + 1);
  curBuf[curPos] = ' ';
  curPos++;
  g_lastEditInputMs = nowMs;
  g_spaceTrackLastInsertMs = nowMs;
  draw();
  return true;
}

static bool nav_handle_wake_release(int endX, int endY, uint32_t nowMs) {
  if (!g_navWakeTracking) return false;
  g_navWakeTracking = false;
  if (!g_navWakeArmed) return false;
  g_navWakeArmed = false;
  const uint32_t wakeDownMs = g_navWakeDownMs;
  g_navWakeDownMs = 0;

  const int dx = endX - (int)g_navWakeDownX;
  const int dy = endY - (int)g_navWakeDownY;
  const uint32_t holdMs = (wakeDownMs > 0 && nowMs >= wakeDownMs) ? (nowMs - wakeDownMs) : 0;
  if (nav_bar_wake_swipe_qualifies(dx, dy, holdMs)) {
    nav_bar_wake(nowMs);
    return true;
  }
  return false;
}

static bool nav_overlay_handle_tap(uint16_t x, uint16_t y, int dx, int dy) {
  if (abs(dx) > NAV_TAP_SLOP || abs(dy) > NAV_TAP_SLOP) return false;
  // APP_SWITCHER / STATUS_PANEL taps/releases are owned by early-return blocks in the main loop.
  if (g_navOverlay == NavOverlay::APP_SWITCHER) return false;
  if (g_navOverlay == NavOverlay::STATUS_PANEL) return false;
  return false;
}

static bool nav_handle_gesture_release(int endX, int endY, uint32_t nowMs) {
  const bool downOnHomePill = nav_bar_home_pill_hit((int16_t)g_navGestureDownX, (int16_t)g_navGestureDownY);
  const bool downOnHomeTap = nav_bar_home_tap_hit((int16_t)g_navGestureDownX, (int16_t)g_navGestureDownY);
  if (nav_bar_ui_blocks_gesture_at((int16_t)g_navGestureDownX, (int16_t)g_navGestureDownY)) {
    g_navGestureTracking = false;
    g_navSpacebarNavSession = false;
    return false;
  }
  // Home-line taps must still work while the keyboard nav bar is asleep.
  if (nav_bar_keyboard_active() && g_navOverlay == NavOverlay::NONE && !nav_bar_awake_now(nowMs)
      && !downOnHomeTap) {
    g_navGestureTracking = false;
    return false;
  }
  if (!nav_bar_visible() && g_navOverlay == NavOverlay::NONE && !g_navGestureTracking)
    return false;

  // Prefer the highest point reached during the drag (lift often snaps back to the bezel).
  int useEndY = endY;
  if (g_navGesturePeakMinY != 0xFFFF && (int)g_navGesturePeakMinY < useEndY)
    useEndY = (int)g_navGesturePeakMinY;

  const int dx = endX - (int)g_navGestureDownX;
  const int dy = useEndY - (int)g_navGestureDownY;
  const uint32_t holdMs = (g_navGestureDownMs > 0 && nowMs >= g_navGestureDownMs)
                            ? (nowMs - g_navGestureDownMs)
                            : 0;

  if (g_navOverlay != NavOverlay::NONE) {
    // APP_SWITCHER and STATUS_PANEL releases are fully handled by early-return blocks in the main loop.
    if (g_navOverlay == NavOverlay::APP_SWITCHER || g_navOverlay == NavOverlay::STATUS_PANEL)
      return false;
    if (nav_bar_zone_contains(g_navGestureDownX, g_navGestureDownY)) {
      if (dy > NAV_SWIPE_MIN_DY && dy > abs(dx)) {
        nav_overlay_close();
        return true;
      }
      if (abs(dx) < NAV_TAP_SLOP && abs(dy) < NAV_TAP_SLOP) {
        nav_overlay_close();
        return true;
      }
    }
    return nav_overlay_handle_tap((uint16_t)endX, (uint16_t)endY, dx, dy);
  }

  if (!g_navGestureTracking) return false;
  // Home taps are valid even if finger drifts slightly outside the thin bottom strip.
  if (!g_navSpacebarNavSession
      && !downOnHomeTap
      && !nav_bar_gesture_zone_contains(g_navGestureDownX, g_navGestureDownY, nowMs))
    return false;
  if (!nav_bar_visible()) {
    g_navGestureTracking = false;
    return false;
  }

  const bool spacebarNav = g_navSpacebarNavSession;
  g_navGestureTracking = false;
  g_navSpacebarNavSession = false;
  g_navHomeLineDown = false;

  nav_bar_touch_activity(nowMs);

  const int adx = abs(dx);
  const int ady = abs(dy);

  // 1) Upward swipe first (must not be stolen by Home tap).
  //    short → Status panel; long or hold → App switcher.
  if (dy < -NAV_SWIPE_MIN_DY && (-dy) > adx) {
    const int up = -dy;
    const bool longSwipe = (up >= NAV_LONG_SWIPE_DY) || (holdMs >= NAV_HOLD_MS);
    if (longSwipe) {
      if (!g_navSwitcherDisabled)
        nav_open_app_switcher(false, 0, 0);
      else
        nav_open_status_panel();
    } else {
      nav_open_status_panel();
    }
    g_touchIgnoreUntil = millis() + 180;
    return true;
  }

  // 2) Short tap on the white home indicator → Main Menu.
  //    Keep tap slop tighter than swipe min so the two cannot overlap.
  const int tapSlop = downOnHomeTap ? (NAV_TAP_SLOP + 8)
                                     : (nav_bar_keyboard_active() ? (NAV_TAP_SLOP + 14) : (NAV_TAP_SLOP + 8));
  if (adx <= tapSlop && ady <= tapSlop) {
    if (spacebarNav || !downOnHomeTap) return false;
    nav_bar_go_home();
    return true;
  }

  // 3) Small non-swipe drift on the indicator still counts as Home.
  if (!spacebarNav && downOnHomeTap && ady < NAV_SWIPE_MIN_DY && adx < NAV_SWIPE_MIN_DY) {
    nav_bar_go_home();
    return true;
  }

  (void)downOnHomePill;
  return false;
}

