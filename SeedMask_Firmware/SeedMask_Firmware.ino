static void lcdBacklightApply() {
#if defined(ARDUINO_ARCH_ESP32)
  if (!g_lcdBacklightPwmOk) return;
  uint32_t duty = (uint32_t)g_lcdBrightnessPct * 255 / 100;
  if (duty > 255) duty = 255;
  ledcWrite(GFX_BL, duty);
#endif
}

static void lcdBacklightSuspendForSleep() {
#if defined(ARDUINO_ARCH_ESP32)
  if (g_lcdBacklightPwmOk) {
    ledcWrite(GFX_BL, 0);
  } else {
    pinMode(GFX_BL, OUTPUT);
    digitalWrite(GFX_BL, LOW);
  }
#endif
  g_lcdBacklightSuspended = true;
}

static void lcdBacklightResumeIfSuspended() {
  if (!g_lcdBacklightSuspended) return;
  g_lcdBacklightSuspended = false;
  lcdBacklightApply();
}

static void lcdBacklightSetPercent(uint8_t pct) {
  if (pct < 5) pct = 5;
  if (pct > 100) pct = 100;
  g_lcdBrightnessPct = pct;
  lcdBacklightApply();
  Preferences p;
  p.begin("seedmask", false);
  p.putUChar("lcd_bl", g_lcdBrightnessPct);
  p.end();
}

static void lcdBacklightInit() {
#if defined(ARDUINO_ARCH_ESP32)
  // Core 3+: ledcAttach(pin, freq_hz, resolution_bits); camera still uses its own LEDC for XCLK.
  g_lcdBacklightPwmOk = ledcAttach(GFX_BL, 5000, 8);
  if (!g_lcdBacklightPwmOk) {
    pinMode(GFX_BL, OUTPUT);
    digitalWrite(GFX_BL, HIGH);
    g_lcdBrightnessPct = 100;
    return;
  }
  {
    Preferences p;
    p.begin("seedmask", true);
    g_lcdBrightnessPct = p.getUChar("lcd_bl", 100);
    p.end();
  }
  if (g_lcdBrightnessPct < 5 || g_lcdBrightnessPct > 100) g_lcdBrightnessPct = 100;
  g_lcdBacklightSuspended = false;
  lcdBacklightApply();
#else
  pinMode(GFX_BL, OUTPUT);
  digitalWrite(GFX_BL, HIGH);
  g_lcdBacklightPwmOk = false;
  g_lcdBacklightSuspended = false;
#endif
}

static uint8_t brightnessPctFromBarX(int px) {
  const int innerL = BR_BRIGHTNESS_BAR_X + 2;
  const int innerR = BR_BRIGHTNESS_BAR_X + BR_BRIGHTNESS_BAR_W - 3;
  if (px <= innerL) return 5;
  if (px >= innerR) return 100;
  int span = innerR - innerL;
  if (span <= 0) return 5;
  int pct = 5 + (int)((int64_t)(px - innerL) * 95 / span);
  if (pct < 5) pct = 5;
  if (pct > 100) pct = 100;
  return (uint8_t)pct;
}

static uint8_t nav_sp_brightness_pct_from_x(int px) {
  const int barX = g_navSpBrightnessBarHit.x;
  const int barW = g_navSpBrightnessBarHit.w;
  const int innerL = barX + 2;
  const int innerR = barX + barW - 3;
  if (px <= innerL) return 5;
  if (px >= innerR) return 100;
  int span = innerR - innerL;
  if (span <= 0) return 5;
  int pct = 5 + (int)((int64_t)(px - innerL) * 95 / span);
  if (pct < 5) pct = 5;
  if (pct > 100) pct = 100;
  return (uint8_t)pct;
}

static void bip39_get_word(uint16_t idx, char* out, size_t outLen) {
  if (!out || outLen == 0) return;
  out[0] = 0;
  if (idx >= BIP39_WORD_COUNT) return;
  const void* p = (const void*)pgm_read_ptr(&BIP39_WORDS[idx]);
  strncpy_P(out, (PGM_P)p, outLen - 1);
  out[outLen - 1] = 0;
}

static int16_t bip39_find_index(const char* w) {
  if (!w || !w[0]) return -1;
  char tmp[16];
  for (uint16_t i = 0; i < BIP39_WORD_COUNT; i++) {
    bip39_get_word(i, tmp, sizeof(tmp));
    if (strcmp(tmp, w) == 0) return (int16_t)i;
  }
  return -1;
}

/** Case-insensitive BIP39 lookup (English list is lowercase). SeedQR / manual entry may differ in case from stored snapshot. */
static int16_t bip39_find_index_ci(const char* w) {
  if (!w || !w[0]) return -1;
  char buf[16];
  strncpy(buf, w, 15);
  buf[15] = 0;
  for (int i = 0; buf[i]; i++) buf[i] = (char)tolower((unsigned char)buf[i]);
  return bip39_find_index(buf);
}

static bool g_sdMounted = false;
