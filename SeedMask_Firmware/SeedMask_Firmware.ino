static char g_editBuf[EDIT_BUF_MAX] = { 0 };
static uint16_t g_editCursor = 0;                 // cursor index in g_editBuf (uint16_t so tap-to-position works for long text)
static uint16_t g_editMaxLen = EDIT_BUF_MAX - 1;  // reduced to TITLE_MAX_LEN when editing title
static bool g_editingTitle = false;               // when true, g_editBuf holds title; DONE saves to item and exits
static uint8_t g_titleViewOffset = 0;             // horizontal scroll offset (chars) when editing title
static bool g_titleDragging = false;
static int16_t g_titleDragLastX = 0;

static void drawTopBarEditableTitle() {
  gfx->fillRect(0, 0, LCD_W, 44, UI_TOP);
  gfx->fillRect(0, 44, LCD_W, 2, UI_ACCENT);
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  int x = 10;
  gfx->fillRoundRect(x, 12, 20, 20, 4, UI_BORDER);
  gfx->fillRect(x + 5, 16, 10, 2, UI_TEXT);
  gfx->fillRect(x + 5, 21, 10, 2, UI_TEXT);
  gfx->fillRect(x + 5, 26, 10, 2, UI_TEXT);
  const int titleX = 38;
  const int titleY = 14;
  const int titleCharW = 12;
  const int maxChars = (LCD_W - titleX - 6) / titleCharW;
  size_t len = strlen(g_editBuf);
  if (g_editCursor > len) g_editCursor = (uint16_t)len;
  if (g_editCursor > g_editMaxLen) g_editCursor = g_editMaxLen;
  if (g_titleViewOffset > (uint8_t)len) g_titleViewOffset = (uint8_t)len;
  if (g_editCursor < g_titleViewOffset) g_titleViewOffset = (uint8_t)g_editCursor;
  else if ((int)g_editCursor > (int)g_titleViewOffset + maxChars) g_titleViewOffset = (uint8_t)max(0, (int)g_editCursor - maxChars);

  gfx->setCursor(titleX, titleY);
  for (int i = 0; i < maxChars && (size_t)(g_titleViewOffset + i) < len; i++) {
    gfx->print(g_editBuf[g_titleViewOffset + i]);
  }
  bool cursorOn = cursorShouldBeSolidNow() || (((millis() / 700) & 1) == 0);
  if (cursorOn) {
    int cursorX = titleX + ((int)g_editCursor - (int)g_titleViewOffset) * titleCharW;
    gfx->drawLine(cursorX, 12, cursorX, 30, UI_ACCENT);
  }
}

