    }
    int nw = snprintf(
      combined, sizeof(combined),
      "{\"format\":\"seedmask_connect\",\"coin\":\"bitcoin\",\"policy\":\"multisig\","
      "\"xfp\":\"%s\",\"account\":%lu,"
      "\"bip48_2\":{\"deriv\":\"%s\",\"name\":\"p2wsh\",\"xpub\":\"%s\"},"
      "\"bip48_1\":{\"deriv\":\"%s\",\"name\":\"p2sh-p2wsh\",\"xpub\":\"%s\"},"
      "\"bip45\":{\"deriv\":\"%s\",\"name\":\"p2sh\",\"xpub\":\"%s\"}}",
