        g_tempSeedImportMode = TempSeedImportMode::NONE;
        g_cryptoTempSeedBackupRestoreFlow = false;
        show(UIScreen::CRYPTO_TEMP_SEED);
      } else if (g_restoreSeedEntryMode) {
        g_restoreSeedEntryMode = false;
        setMsg("");
        show(UIScreen::RESTORE_CODE);
      } else if (g_restoreCodeEntryMode) {
        g_restoreCodeEntryMode = false;
        restorePayload_clear();
        g_restoreFull[0] = 0;
        setMsg("");
        show(UIScreen::RESTORE_CODE);
      } else {
        show(UIScreen::HOME);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::RESTORE_PASSWORD:
      clearPassword(g_password1);
      if (g_cryptoTempSeedBackupRestoreFlow
          || g_tempSeedImportMode == TempSeedImportMode::BACKUP_CODE) {
        g_tempSeedImportMode = TempSeedImportMode::NONE;
        g_cryptoTempSeedBackupRestoreFlow = false;
        show(UIScreen::CRYPTO_TEMP_SEED);
      } else if (g_restoreFull[0] && strncmp(g_restoreFull, "/sdcard/", 8) == 0) {
        show(UIScreen::RESTORE_SD);
      } else {
        setMsg("");
        show(UIScreen::RESTORE_CODE);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
