static void nav_sp_map_icon_pt(float sx, float sy, int ox, int oy, int sz, int& dx, int& dy) {
  dx = ox + (int)(sx / 24.f * (float)sz + 0.5f);
  dy = oy + (int)(sy / 24.f * (float)sz + 0.5f);
}

static void nav_sp_stroke_line(float x0f, float y0f, float x1f, float y1f,
                               int ox, int oy, int sz, uint16_t col, int halfW) {
  int x0, y0, x1, y1;
  nav_sp_map_icon_pt(x0f, y0f, ox, oy, sz, x0, y0);
  nav_sp_map_icon_pt(x1f, y1f, ox, oy, sz, x1, y1);
  const int dx = x1 - x0, dy = y1 - y0;
  const float lenf = sqrtf((float)(dx * dx + dy * dy));
  if (lenf < 0.5f) return;
  for (int w = -halfW; w <= halfW; w++) {
    const int oxw = (int)(((-dy) * (float)w) / lenf + ((w >= 0) ? 0.5f : -0.5f));
    const int oyw = (int)(((dx) * (float)w) / lenf + ((w >= 0) ? 0.5f : -0.5f));
    gfx->drawLine(x0 + oxw, y0 + oyw, x1 + oxw, y1 + oyw, col);
  }
}

static void nav_sp_draw_crisp_ring(int cx, int cy, int radius, uint16_t ringCol, uint16_t holeCol, int ringPx) {
  if (ringPx < 1) ringPx = 1;
  gfx->fillCircle(cx, cy, radius, ringCol);
  const int holeR = radius - ringPx;
  if (holeR > 0)
    gfx->fillCircle(cx, cy, holeR, holeCol);
}

static void nav_sp_draw_usb_cable_icon(int ox, int oy, int sz, uint16_t col) {
  int x0, y0, x1, y1;
  nav_sp_map_icon_pt(9.5f, 3.5f, ox, oy, sz, x0, y0);
  nav_sp_map_icon_pt(14.5f, 7.5f, ox, oy, sz, x1, y1);
  const int plugW = max(3, x1 - x0);
  const int plugH = max(3, y1 - y0);
  gfx->fillRect(x0, y0, plugW, plugH, col);
  nav_sp_map_icon_pt(10.f, 2.5f, ox, oy, sz, x0, y0);
  nav_sp_map_icon_pt(11.f, 3.5f, ox, oy, sz, x1, y1);
  gfx->fillRect(x0, y0, max(2, x1 - x0), max(2, y1 - y0), col);
  nav_sp_map_icon_pt(13.f, 2.5f, ox, oy, sz, x0, y0);
  nav_sp_map_icon_pt(14.f, 3.5f, ox, oy, sz, x1, y1);
  gfx->fillRect(x0, y0, max(2, x1 - x0), max(2, y1 - y0), col);
  nav_sp_map_icon_pt(8.f, 7.5f, ox, oy, sz, x0, y0);
  nav_sp_map_icon_pt(16.f, 20.5f, ox, oy, sz, x1, y1);
  const int bw = max(4, x1 - x0);
  const int bh = max(6, y1 - y0);
  gfx->fillRoundRect(x0, y0, bw, bh, max(3, bw / 4), col);
}

static void nav_sp_draw_dongle_icon(int ox, int oy, int sz, uint16_t col) {
  int x0, y0, x1, y1;
  nav_sp_map_icon_pt(9.f, 3.f, ox, oy, sz, x0, y0);
  nav_sp_map_icon_pt(15.f, 8.f, ox, oy, sz, x1, y1);
  gfx->fillRect(x0, y0, max(3, x1 - x0), max(3, y1 - y0), col);
  nav_sp_map_icon_pt(7.5f, 7.f, ox, oy, sz, x0, y0);
  nav_sp_map_icon_pt(16.5f, 16.5f, ox, oy, sz, x1, y1);
  const int bw = max(5, x1 - x0);
  const int bh = max(6, y1 - y0);
  gfx->fillRoundRect(x0, y0, bw, bh, max(3, bw / 5), col);
  nav_sp_map_icon_pt(10.f, 4.f, ox, oy, sz, x0, y0);
  nav_sp_map_icon_pt(14.f, 7.f, ox, oy, sz, x1, y1);
  const uint16_t slotCol = blendRGB565(col, RGB565_BLACK, 0.40f);
  gfx->fillRect(x0 + 1, y0 + 1, max(2, x1 - x0 - 2), max(2, y1 - y0 - 2), slotCol);
}

static void nav_sp_draw_icon_at_center(int cx, int cy, int sz, uint16_t col,
                                       void (*drawFn)(int, int, int, uint16_t)) {
  drawFn(cx - sz / 2, cy - sz / 2, sz, col);
}

static void nav_sp_draw_switcher_icon(int cx, int cy, int sz, uint16_t col) {
  const int cardW = sz * 11 / 24;
  const int cardH = sz * 14 / 24;
  const int rad = max(2, cardW / 5);
  gfx->fillRoundRect(cx - cardW / 2 - 4, cy - cardH / 2 + 3, cardW, cardH, rad,
                     blendRGB565(col, RGB565_BLACK, 0.45f));
  gfx->fillRoundRect(cx - cardW / 2, cy - cardH / 2 - 3, cardW, cardH, rad, col);
  gfx->drawRoundRect(cx - cardW / 2, cy - cardH / 2 - 3, cardW, cardH, rad, UI_BORDER);
}

static void nav_sp_draw_airgap_icon(int cx, int cy, int sz, uint16_t col) {
  const int r = sz * 9 / 24;
  gfx->drawCircle(cx, cy, r, col);
  gfx->drawCircle(cx, cy, max(1, r - 1), col);
  gfx->drawLine(cx - r + 2, cy + r - 2, cx + r - 2, cy - r + 2, col);
  gfx->drawLine(cx - r + 3, cy + r - 2, cx + r - 1, cy - r + 2, col);
}

static void nav_sp_draw_sending_icon(int cx, int cy, int sz, uint16_t col) {
  const int ox = cx - sz / 2;
  const int oy = cy - sz / 2;
  const int hw = max(1, sz / 18);
  nav_sp_stroke_line(12.202f, 5.917f, 12.202f, 14.417f, ox, oy, sz, col, hw);
  nav_sp_stroke_line(15.546f, 8.267f, 12.202f, 5.f, ox, oy, sz, col, hw);
  nav_sp_stroke_line(12.202f, 5.f, 8.858f, 8.267f, ox, oy, sz, col, hw);
  nav_sp_stroke_line(5.f, 15.747f, 5.f, 18.f, ox, oy, sz, col, hw);
  nav_sp_stroke_line(5.f, 18.f, 19.f, 18.f, ox, oy, sz, col, hw);
  nav_sp_stroke_line(19.f, 18.f, 19.f, 15.747f, ox, oy, sz, col, hw);
  nav_sp_stroke_line(5.f, 15.747f, 19.f, 15.747f, ox, oy, sz, col, hw);
}

static void nav_sp_draw_hid_icon(int cx, int cy, int sz, uint16_t col) {
  const int kw = max(10, sz * 16 / 24);
  const int kh = max(7, sz * 10 / 24);
  const int kx = cx - kw / 2;
  const int ky = cy - kh / 2 - 1;
  gfx->drawRoundRect(kx, ky, kw, kh, 2, col);
  const int keyW = max(2, kw / 7);
  const int keyH = max(2, kh / 4);
  const int gap = max(1, keyW / 3);
  const int rowY0 = ky + 2;
  for (int row = 0; row < 2; row++) {
    const int y = rowY0 + row * (keyH + gap);
    const int cols = (row == 0) ? 3 : 2;
    const int rowW = cols * keyW + (cols - 1) * gap;
    int x = cx - rowW / 2;
    for (int c = 0; c < cols; c++) {
      gfx->fillRect(x, y, keyW, keyH, col);
      x += keyW + gap;
    }
  }
  const int spaceW = max(4, kw * 10 / 16);
  gfx->fillRect(cx - spaceW / 2, ky + kh - keyH - 2, spaceW, keyH, col);
}

static void nav_sp_draw_send_disabled_icon(int cx, int cy, int sz, uint16_t col) {
  const int r = sz * 9 / 24;
  gfx->drawCircle(cx, cy, r, col);
  gfx->drawLine(cx - r + 2, cy + r - 2, cx + r - 2, cy - r + 2, col);
  gfx->drawLine(cx - r + 3, cy + r - 2, cx + r - 1, cy - r + 2, col);
}

static void nav_sp_draw_icon_circle(int cx, int cy, int radius, bool active,
                                    void (*drawIcon)(int, int, int, uint16_t),
                                    bool lightenGlyph) {
  const uint16_t panelBg = NAV_SP_PANEL_COLOR;
  const uint16_t dimRing = blendRGB565(panelBg, RGB565_BLACK, 0.22f);
  const uint16_t dimGlyph = blendRGB565(panelBg, RGB565_BLACK, 0.45f);
  if (active)
    nav_sp_draw_crisp_ring(cx, cy, radius, RGB565_WHITE, panelBg, 2);
  else
    nav_sp_draw_crisp_ring(cx, cy, radius, dimRing, panelBg, 1);
  const uint16_t glyph = (active && lightenGlyph) ? RGB565_WHITE : dimGlyph;
  const int isz = radius * 2 - 22;
  drawIcon(cx, cy, isz, glyph);
}

static void nav_sp_icon_hit_from_center(int cx, int cy, int radius, Rect& outHit) {
  outHit = { (int16_t)(cx - radius), (int16_t)(cy - radius),
             (int16_t)(radius * 2), (int16_t)(radius * 2 + NAV_SP_ICON_LABEL_H) };
}

static bool nav_sp_hit_icon(const Rect& r, int16_t px, int16_t py) {
  return hitPad(r, px, py, NAV_SP_ICON_HIT_PAD);
}

static void nav_sp_show_send_flash(uint8_t kind, uint32_t nowMs) {
  g_navSpSendFlashKind = kind;
  g_navSpSendFlashStartMs = nowMs;
  nav_sp_redraw_only();
}

static void nav_sp_apply_send_disabled_effects() {
  // Sending → Disabled must not change Device HID enable.
}

static void nav_sp_cycle_sending(uint32_t nowMs) {
#if SEEDMASK_NOTE_SEND_UI
  // Advance from the *current* send mode — do not reset on Status panel open.
  if (g_pwSendVia == PW_SEND_VIA_DONGLE) {
#if SEEDMASK_USB_HID_KEYBOARD
    if (g_airgappedMode) {
      requestPwSendViaWithHidGate(PW_SEND_VIA_DISABLED, true, nowMs);
      return;
    }
    requestPwSendViaWithHidGate(PW_SEND_VIA_USB, true, nowMs);
#else
    requestPwSendViaWithHidGate(PW_SEND_VIA_DISABLED, true, nowMs);
#endif
  } else if (g_pwSendVia == PW_SEND_VIA_USB) {
    requestPwSendViaWithHidGate(PW_SEND_VIA_DISABLED, true, nowMs);
  } else {
    requestPwSendViaWithHidGate(PW_SEND_VIA_DONGLE, true, nowMs);
  }
#else
  (void)nowMs;
  setMsgTr("Sending is disabled", "Slanje nije dostupno");
#endif
}

static void nav_sp_tick(uint32_t nowMs) {
  if (g_navSpSendFlashStartMs == 0) return;
  if ((uint32_t)(nowMs - g_navSpSendFlashStartMs) >= NAV_SP_SEND_FLASH_MS) {
    g_navSpSendFlashStartMs = 0;
    g_navSpSendFlashKind = 0;
    if (g_navOverlay == NavOverlay::STATUS_PANEL)
      nav_sp_redraw_only();
  }
}

static void nav_sp_redraw_only() {
  if (g_navOverlay != NavOverlay::STATUS_PANEL) return;
  drawNavStatusPanel();
  if (gfx) gfx->flush();
}

static void nav_status_panel_handle_touch(bool physPressed, bool wasPressed, int x, int y, uint32_t nowMs) {
  if (physPressed)
    nav_bar_touch_activity(nowMs);

  if (physPressed && !wasPressed) {
    g_navSpTouchDownX = (int16_t)x;
    g_navSpTouchDownY = (int16_t)y;
    if (hit(g_navSpBrightnessBarHit, (int16_t)x, (int16_t)y)) {
      g_navSpBrightnessDragging = true;
      uint8_t p = nav_sp_brightness_pct_from_x(x);
      if (p != g_lcdBrightnessPct)
        lcdBacklightSetPercent(p);
      nav_sp_redraw_only();
    }
  }

  if (physPressed && wasPressed && g_navSpBrightnessDragging) {
    uint8_t p = nav_sp_brightness_pct_from_x(x);
    if (p != g_lcdBrightnessPct) {
      lcdBacklightSetPercent(p);
      nav_sp_redraw_only();
    }
  }

  if (!physPressed && wasPressed) {
    const bool wasBrightnessDrag = g_navSpBrightnessDragging;
    g_navSpBrightnessDragging = false;
    const int ccDx = x - (int)g_navSpTouchDownX;
    const int ccDy = y - (int)g_navSpTouchDownY;
    const int panelY = LCD_H - NAV_SP_PANEL_H;

#if SEEDMASK_NOTE_SEND_UI
    if (hidEnablePromptActive()) {
      if (abs(ccDx) <= NAV_TAP_SLOP && abs(ccDy) <= NAV_TAP_SLOP)
        handleHidEnablePromptTap((uint16_t)x, (uint16_t)y);
      return;
    }
#endif

    if (nav_bar_bottom_zone_contains((uint16_t)g_navSpTouchDownX, (uint16_t)g_navSpTouchDownY)
        && nav_bar_bottom_zone_contains((uint16_t)x, (uint16_t)y)) {
      if (ccDy > NAV_SWIPE_MIN_DY && ccDy > abs(ccDx)) {
#if SEEDMASK_NOTE_SEND_UI
        hidEnablePromptClear();
#endif
        nav_overlay_close();
        return;
      }
      if (abs(ccDx) < NAV_TAP_SLOP && abs(ccDy) < NAV_TAP_SLOP) {
#if SEEDMASK_NOTE_SEND_UI
        hidEnablePromptClear();
#endif
        nav_overlay_close();
        return;
      }
    }
    if ((int)g_navSpTouchDownY < panelY && (int)y < panelY
        && !nav_bar_bottom_zone_contains((uint16_t)x, (uint16_t)y)
        && abs(ccDx) < NAV_TAP_SLOP && abs(ccDy) < NAV_TAP_SLOP) {
#if SEEDMASK_NOTE_SEND_UI
      hidEnablePromptClear();
#endif
      nav_overlay_close();
      return;
    }

    if (wasBrightnessDrag) return;
    // Same stable rule as before: small tap slop + down and up both on the icon.
    if (abs(ccDx) > NAV_TAP_SLOP || abs(ccDy) > NAV_TAP_SLOP) return;

    if (nav_sp_hit_icon(g_navSpIconSwitcherHit, g_navSpTouchDownX, g_navSpTouchDownY)
        && nav_sp_hit_icon(g_navSpIconSwitcherHit, (int16_t)x, (int16_t)y)) {
      nav_switcher_set_disabled(!g_navSwitcherDisabled);
      nav_sp_redraw_only();
      return;
    }

    if (nav_sp_hit_icon(g_navSpIconAirgapHit, g_navSpTouchDownX, g_navSpTouchDownY)
        && nav_sp_hit_icon(g_navSpIconAirgapHit, (int16_t)x, (int16_t)y)) {
      nav_sp_set_airgapped(!g_airgappedMode);
      nav_sp_redraw_only();
      return;
    }

    if (nav_sp_hit_icon(g_navSpIconSendingHit, g_navSpTouchDownX, g_navSpTouchDownY)
        && nav_sp_hit_icon(g_navSpIconSendingHit, (int16_t)x, (int16_t)y)) {
      nav_sp_cycle_sending(nowMs);
      return;
    }

    if (nav_sp_hit_icon(g_navSpIconHidHit, g_navSpTouchDownX, g_navSpTouchDownY)
        && nav_sp_hit_icon(g_navSpIconHidHit, (int16_t)x, (int16_t)y)) {
#if SEEDMASK_USB_HID_KEYBOARD
      if (!g_hidHostEnabled) {
        if (g_airgappedMode) {
          setMsgTr("Turn off Airgap first", "Prvo iskljuci Airgap");
          draw();
          return;
        }
        g_hidHostEnabled = true;
      } else {
        g_hidHostEnabled = false;
      }
      persistHidHostEnabled();
      setMsg("");
      nav_sp_redraw_only();
#else
      setMsgTr("HID not available", "HID nije dostupan");
      draw();
#endif
      return;
    }
  }
}

static void nav_open_status_panel() {
  g_navSpBrightnessDragging = false;
  g_navSpTouchDownX = 0;
  g_navSpTouchDownY = 0;
  g_navOverlay = NavOverlay::STATUS_PANEL;
  nav_bar_touch_activity(millis());
  draw();
}

static void nav_open_app_switcher(bool fingerStillDown, uint16_t anchorX, uint16_t anchorY) {
  if (g_navSwitcherDisabled) return;
  nav_recent_capture_snapshot();
  nav_recent_bump_current();
  g_navOverlay = NavOverlay::APP_SWITCHER;
  g_navSwitcherCardHitValid = false;
  g_navSwitcherScrollPx = (int16_t)(nav_switcher_find_focus_index() * nav_switcher_pitch());
  nav_switcher_clamp_scroll();
  nav_switcher_reset_touch();
  nav_bar_touch_activity(millis());
  if (fingerStillDown)
    nav_switcher_reanchor_touch((int)anchorX, (int)anchorY);
  draw();
}

static void drawNavBarIndicator() {
  const int ix = (LCD_W - NAV_BAR_INDICATOR_W) / 2;
  const int iy = nav_bar_indicator_y();
  const uint16_t pill = blendRGB565(RGB565_WHITE, UI_TEXT, 0.55f);
  gfx->fillRoundRect(ix, iy, NAV_BAR_INDICATOR_W, NAV_BAR_INDICATOR_H, NAV_BAR_INDICATOR_H / 2, pill);
  gfx->drawRoundRect(ix, iy, NAV_BAR_INDICATOR_W, NAV_BAR_INDICATOR_H, NAV_BAR_INDICATOR_H / 2,
                     blendRGB565(pill, RGB565_WHITE, 0.35f));
}

static void drawNavStatusPanel() {
  const int panelH = NAV_SP_PANEL_H;
  const int panelY = LCD_H - panelH;
  gfx->fillRect(0, panelY, LCD_W, panelH, NAV_SP_PANEL_COLOR);
  gfx->drawLine(0, panelY, LCD_W, panelY, blendRGB565(NAV_SP_PANEL_COLOR, RGB565_BLACK, 0.08f));
  const int hx = (LCD_W - 36) / 2;
  gfx->fillRoundRect(hx, panelY + 8, 36, 4, 2, NAV_SP_INK_DIM);

  gfx->setTextColor(NAV_SP_INK_COLOR);
  gfx->setTextSize(2);
  gfx->setCursor(24, panelY + 28);
  gfx->print("Status panel");

  const int iconRadius = NAV_SP_ICON_SIZE / 2;
  const int iconGap = NAV_SP_ICON_GAP;
  const int iconsTotalW = NAV_SP_ICON_SIZE * 4 + iconGap * 3;
  const int iconsX0 = (LCD_W - iconsTotalW) / 2;
  const int iconCy = panelY + NAV_SP_ICONS_Y + iconRadius;
  const int cx0 = iconsX0 + iconRadius;
  const int cx1 = cx0 + NAV_SP_ICON_SIZE + iconGap;
  const int cx2 = cx1 + NAV_SP_ICON_SIZE + iconGap;
  const int cx3 = cx2 + NAV_SP_ICON_SIZE + iconGap;

  nav_sp_icon_hit_from_center(cx0, iconCy, iconRadius, g_navSpIconSwitcherHit);
  nav_sp_icon_hit_from_center(cx1, iconCy, iconRadius, g_navSpIconAirgapHit);
  nav_sp_icon_hit_from_center(cx2, iconCy, iconRadius, g_navSpIconSendingHit);
  nav_sp_icon_hit_from_center(cx3, iconCy, iconRadius, g_navSpIconHidHit);

  const bool sendingActive =
#if SEEDMASK_NOTE_SEND_UI
    (g_pwSendVia != PW_SEND_VIA_DISABLED);
#else
    false;
#endif
  nav_sp_draw_icon_circle(cx0, iconCy, iconRadius, !g_navSwitcherDisabled, nav_sp_draw_switcher_icon, true);
  nav_sp_draw_icon_circle(cx1, iconCy, iconRadius, g_airgappedMode, nav_sp_draw_airgap_icon, false);
  nav_sp_draw_icon_circle(cx2, iconCy, iconRadius, sendingActive, nav_sp_draw_sending_icon, false);
#if SEEDMASK_USB_HID_KEYBOARD
  nav_sp_draw_icon_circle(cx3, iconCy, iconRadius, g_hidHostEnabled, nav_sp_draw_hid_icon, false);
#else
  nav_sp_draw_icon_circle(cx3, iconCy, iconRadius, false, nav_sp_draw_hid_icon, false);
#endif

  gfx->setTextSize(1);
  gfx->setTextColor(NAV_SP_INK_DIM);
  {
    const char* lab0a = tr("App", "App");
    const char* lab0b = tr("Switcher", "Prebacivac");
    const char* lab1 = tr("Airgapped", "Airgapped");
    const char* lab2 = tr("Sending", "Slanje");
    const char* lab3 = tr("HID", "HID");
    const int labelY0 = iconCy + iconRadius + 4;
    const int labelY1 = labelY0 + 10;
    const int lw0a = (int)strlen(lab0a) * 6;
    const int lw0b = (int)strlen(lab0b) * 6;
    const int lw1 = (int)strlen(lab1) * 6;
    const int lw2 = (int)strlen(lab2) * 6;
    const int lw3 = (int)strlen(lab3) * 6;
    gfx->setCursor((int16_t)(iconsX0 + (NAV_SP_ICON_SIZE - lw0a) / 2), (int16_t)labelY0);
    gfx->print(lab0a);
    gfx->setCursor((int16_t)(iconsX0 + (NAV_SP_ICON_SIZE - lw0b) / 2), (int16_t)labelY1);
    gfx->print(lab0b);
    gfx->setCursor((int16_t)(iconsX0 + NAV_SP_ICON_SIZE + iconGap + (NAV_SP_ICON_SIZE - lw1) / 2),
                   (int16_t)labelY0);
    gfx->print(lab1);
    gfx->setCursor((int16_t)(iconsX0 + 2 * (NAV_SP_ICON_SIZE + iconGap) + (NAV_SP_ICON_SIZE - lw2) / 2),
                   (int16_t)labelY0);
    gfx->print(lab2);
    gfx->setCursor((int16_t)(iconsX0 + 3 * (NAV_SP_ICON_SIZE + iconGap) + (NAV_SP_ICON_SIZE - lw3) / 2),
                   (int16_t)labelY0);
    gfx->print(lab3);
  }

  gfx->setTextColor(NAV_SP_INK_COLOR);
  gfx->setCursor(NAV_SP_PAD_X, panelY + NAV_SP_BRIGHTNESS_Y);
  gfx->print(tr("Brightness", "Osvetljenost"));
  char pctBuf[12];
  snprintf(pctBuf, sizeof(pctBuf), "%u%%", (unsigned)g_lcdBrightnessPct);
  const int pctW = (int)strlen(pctBuf) * 6;
  gfx->setCursor((int16_t)(LCD_W - NAV_SP_PAD_X - pctW), panelY + NAV_SP_BRIGHTNESS_Y);
  gfx->print(pctBuf);

  const int barY = panelY + NAV_SP_BRIGHTNESS_Y + 18;
  const int barX = NAV_SP_PAD_X;
  const int barW = LCD_W - 2 * NAV_SP_PAD_X;
  const int barH = NAV_SP_BRIGHTNESS_BAR_H;
  g_navSpBrightnessBarHit = { (int16_t)barX, (int16_t)barY, (int16_t)barW, (int16_t)barH };
  gfx->drawRoundRect(barX, barY, barW, barH, 8, blendRGB565(NAV_SP_PANEL_COLOR, RGB565_BLACK, 0.18f));
  {
    int innerW = barW - 4;
    int fillw = innerW * (int)g_lcdBrightnessPct / 100;
    if (fillw < 1 && g_lcdBrightnessPct > 0) fillw = 1;
    if (fillw > innerW) fillw = innerW;
    gfx->fillRoundRect(barX + 2, barY + 2, fillw, barH - 4, 6, UI_ACCENT);
  }

  if (g_navSpSendFlashStartMs != 0 && g_navSpSendFlashKind != 0) {
    // Cover the mid-panel so the flash icon + label read cleanly above Brightness.
    const int flashBandTop = panelY + NAV_SP_ICONS_Y + NAV_SP_ICON_SIZE + NAV_SP_ICON_LABEL_H - 4;
    const int flashBandBot = panelY + NAV_SP_BRIGHTNESS_Y - 6;
    if (flashBandBot > flashBandTop)
      gfx->fillRect(0, flashBandTop, LCD_W, flashBandBot - flashBandTop, NAV_SP_PANEL_COLOR);

    const int flashSz = NAV_SP_SEND_FLASH_ICON_SZ;
    const int flashCx = LCD_W / 2;
    const int flashCy = panelY + NAV_SP_SEND_FLASH_Y + flashSz / 2;
    const uint16_t col = NAV_SP_INK_COLOR;
    const char* lab = nullptr;
    if (g_navSpSendFlashKind == 1) {
      nav_sp_draw_icon_at_center(flashCx, flashCy, flashSz, col, nav_sp_draw_dongle_icon);
      lab = tr("Dongle", "Dongle");
    } else if (g_navSpSendFlashKind == 2) {
      nav_sp_draw_icon_at_center(flashCx, flashCy, flashSz, col, nav_sp_draw_usb_cable_icon);
      lab = tr("USB cable", "USB kabl");
    } else if (g_navSpSendFlashKind == 3) {
      nav_sp_draw_send_disabled_icon(flashCx, flashCy, flashSz, col);
      lab = tr("Disabled", "Iskljuceno");
    }
    if (lab) {
      gfx->setTextSize(1);
      gfx->setTextColor(NAV_SP_INK_COLOR);
      const int lw = (int)strlen(lab) * 6;
      int labelY = flashCy + flashSz / 2 + NAV_SP_SEND_FLASH_LABEL_GAP;
      if (g_navSpSendFlashKind == 1)
        labelY -= NAV_SP_SEND_FLASH_LABEL_DONGLE_UP;
      else if (g_navSpSendFlashKind == 2)
        labelY -= NAV_SP_SEND_FLASH_LABEL_USB_UP;
      else if (g_navSpSendFlashKind == 3)
        labelY -= NAV_SP_SEND_FLASH_LABEL_DISABLED_UP;
      // Keep label above the Brightness row.
      const int labelMaxY = panelY + NAV_SP_BRIGHTNESS_Y - 12;
      if (labelY > labelMaxY) labelY = labelMaxY;
      gfx->setCursor((int16_t)(flashCx - lw / 2), (int16_t)labelY);
      gfx->print(lab);
    }
  }

#if SEEDMASK_NOTE_SEND_UI
  drawHidEnablePromptOverlay();
#endif
  drawNavBarIndicator();
}

static void drawNavAppSwitcher() {
  gfx->fillScreen(blendRGB565(RGB565_BLACK, RGB565_WHITE, 0.06f));
  g_navSwitcherCardHitValid = false;
  nav_switcher_clamp_scroll();

  if (g_navRecentCount == 0) {
    gfx->setTextColor(blendRGB565(UI_TEXT, RGB565_BLACK, 0.35f));
    gfx->setTextSize(2);
    gfx->setCursor(36, LCD_H / 2 - 12);
    gfx->print("No recent apps");
    g_navSwitcherCloseAllHit = { 0, 0, 0, 0 };
    drawNavBarIndicator();
    return;
  }

  const char* closeLab = "Close all";
  gfx->setTextSize(2);
  gfx->setTextColor(RGB565_WHITE);
  const int cltw = (int)strlen(closeLab) * 12;
  const int clx = (LCD_W - cltw) / 2;
  const int cly = 10;
  gfx->setCursor(clx, cly);
  gfx->print(closeLab);
  g_navSwitcherCloseAllHit = { (int16_t)(clx - 16), (int16_t)(cly - 4),
                               (int16_t)(cltw + 32), (int16_t)24 };

  const int cardW = NAV_SWITCH_CARD_W;
  const int cardH = NAV_SWITCH_CARD_H;
  const int cardY = NAV_SWITCH_CARD_Y;
  const int pitch = nav_switcher_pitch();
  const int centerX = LCD_W / 2;
  const int scroll = (int)g_navSwitcherScrollPx;
  const int focusIdx = nav_switcher_focus_index();
  int focusCardX = centerX - cardW / 2;
  int focusSw = cardW;
  int focusDrawY = cardY;

  // Side cards first, then centered card on top (phone-style z-order).
  for (uint8_t i = 0; i < g_navRecentCount; i++) {
    if ((int)i == focusIdx) continue;
    int cardX, drawY, sx, sy, sw, sh;
    nav_switcher_card_layout(i, focusIdx, cardW, cardH, cardY, pitch, centerX, scroll,
                             cardX, drawY, sx, sy, sw, sh);
    if (cardX + sw < -32 || cardX > LCD_W + 32) continue;
    nav_draw_switcher_card(cardX, drawY, cardW, cardH, i,
                           nav_recent_is_current(g_navRecent[i].screen),
                           nav_switcher_card_scale_for_index((int)i, focusIdx));
  }
  if (focusIdx >= 0 && (uint8_t)focusIdx < g_navRecentCount) {
    int cardX, drawY, sx, sy, sw, sh;
    nav_switcher_card_layout((uint8_t)focusIdx, focusIdx, cardW, cardH, cardY, pitch, centerX, scroll,
                             cardX, drawY, sx, sy, sw, sh);
    focusCardX = cardX;
    focusSw = sw;
    focusDrawY = drawY;
    nav_draw_switcher_card(cardX, drawY, cardW, cardH, (uint8_t)focusIdx,
                           nav_recent_is_current(g_navRecent[focusIdx].screen), 1.0f);
    g_navSwitcherCardIndex = (uint8_t)focusIdx;
  }

  g_navSwitcherCardHit = { (int16_t)focusCardX, (int16_t)focusDrawY,
                           (int16_t)focusSw, (int16_t)(cardH + 8) };
  g_navSwitcherCardHitValid = true;

  const char* lab = nav_recent_label(g_navRecent[(uint8_t)focusIdx].screen);
  gfx->setTextSize(2);
  gfx->setTextColor(RGB565_WHITE);
  int sl = (int)strlen(lab);
  if (sl > 18) sl = 18;
  int ltw = sl * 12;
  gfx->setCursor((int16_t)(focusCardX + (cardW - ltw) / 2), (int16_t)(cardY + cardH + 8));
  for (int i = 0; i < sl; i++) gfx->print(lab[i]);

