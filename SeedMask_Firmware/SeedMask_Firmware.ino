static void handleCryptoMultisigPolicyTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    show(UIScreen::CRYPTO_MULTISIG_SETTINGS);
    return;
  }
  if (hit(BTN_MULTISIG_POLICY_ASK, x, y)) {
    kaspa_multisig_policy_mode_save((uint8_t)KaspaMultisigPolicyMode::ASK_TO_IMPORT);
    setMsg("Policy: ask to import");
    draw();
    return;
  }
  if (hit(BTN_MULTISIG_POLICY_REQUIRE, x, y)) {
    kaspa_multisig_policy_mode_save((uint8_t)KaspaMultisigPolicyMode::REQUIRE_EXISTING);
    setMsg("Policy required");
    draw();
    return;
  }
  if (hit(BTN_MULTISIG_POLICY_SKIP, x, y)) {
    kaspa_multisig_policy_mode_save((uint8_t)KaspaMultisigPolicyMode::SKIP_VERIFICATION);
    setMsg("Policy verification skipped");
    draw();
    return;
  }
}

