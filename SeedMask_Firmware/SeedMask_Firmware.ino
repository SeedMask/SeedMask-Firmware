static bool nvs_save_vault(const uint8_t* vault, size_t len) {
  // Never persist vault seed blob while in duress/decoy session (would overwrite real wallet).
  if (g_duressSession) {
    Serial.println("nvs_save_vault: skipped (duress session)");
    return false;
  }
  // NVS is internal flash — no SD card dependency
  nvs_handle_t handle;
  esp_err_t err = nvs_open("vault", NVS_READWRITE, &handle);
  if (err != ESP_OK) {
    Serial.println("nvs_save: open failed");
    return false;
  }
  err = nvs_set_blob(handle, "vault_blob", vault, len);
  if (err != ESP_OK) {
    nvs_close(handle);
    Serial.println("nvs_save: set_blob failed");
    return false;
  }
  err = nvs_commit(handle);
  nvs_close(handle);
  Serial.println(err == ESP_OK ? "nvs_save: OK" : "nvs_save: commit failed");
  return err == ESP_OK;
}

static bool nvs_clear_vault() {
  nvs_handle_t handle;
  esp_err_t err = nvs_open("vault", NVS_READWRITE, &handle);
  if (err != ESP_OK) return false;
  err = nvs_erase_key(handle, "vault_blob");
  if (err != ESP_OK && err != ESP_ERR_NVS_NOT_FOUND) {
    nvs_close(handle);
    return false;
  }
  err = nvs_commit(handle);
  nvs_close(handle);
  return err == ESP_OK || err == ESP_ERR_NVS_NOT_FOUND;
}

// Probe vault presence without allocating (boot must not depend on PSRAM malloc).
static bool nvs_vault_blob_size(size_t* outLen) {
  if (outLen) *outLen = 0;
  nvs_handle_t handle;
  esp_err_t err = nvs_open("vault", NVS_READONLY, &handle);
  if (err != ESP_OK) return false;
  size_t sz = 0;
  err = nvs_get_blob(handle, "vault_blob", NULL, &sz);
  nvs_close(handle);
  if (err != ESP_OK || sz == 0) return false;
  if (outLen) *outLen = sz;
  return true;
}

#if defined(ARDUINO_ARCH_ESP32)
static uint8_t* vault_blob_alloc(size_t n) {
  if (n == 0) return nullptr;
  uint8_t* p = (uint8_t*)heap_caps_malloc(n, MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  if (!p) p = (uint8_t*)heap_caps_malloc(n, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
  if (!p) p = (uint8_t*)malloc(n);
  return p;
}
#else
static uint8_t* vault_blob_alloc(size_t n) {
  return n ? (uint8_t*)malloc(n) : nullptr;
}
#endif

static bool nvs_load_vault(uint8_t** out, size_t& len) {
  // NVS is internal flash — no SD card dependency
  *out = nullptr;
  len = 0;
  nvs_handle_t handle;
  esp_err_t err = nvs_open("vault", NVS_READONLY, &handle);
  if (err != ESP_OK) return false;
  size_t required_size;
  err = nvs_get_blob(handle, "vault_blob", NULL, &required_size);
  if (err != ESP_OK) {
    nvs_close(handle);
    return false;
  }
  uint8_t* buf = vault_blob_alloc(required_size);
  if (!buf) {
    nvs_close(handle);
    return false;
  }
  err = nvs_get_blob(handle, "vault_blob", buf, &required_size);
  nvs_close(handle);
  if (err != ESP_OK) {
    secure_memzero(buf, required_size);
    free(buf);
    return false;
  }
  *out = buf;
  len = required_size;
  return true;
}

// Passwords+notes blob (stateful only): encrypted with master password, key "vault_pw"
