static bool autoShutdownSecondsValid(uint32_t s) {
  if (s == 0) return true;
  static const uint32_t kM[] = { 60, 120, 300, 600, 900, 1800, 3600 };
  for (size_t i = 0; i < sizeof(kM) / sizeof(kM[0]); i++) {
    if (s == kM[i]) return true;
  }
  static const uint32_t kH[] = { 3600, 10800, 21600, 43200 };
  for (size_t i = 0; i < sizeof(kH) / sizeof(kH[0]); i++) {
    if (s == kH[i]) return true;
  }
  return false;
}

static void autoShutdownPersist() {
#if defined(ARDUINO_ARCH_ESP32)
  Preferences p;
  p.begin("seedmask", false);
  p.putUInt("auto_sd", g_autoShutdownIdleSeconds);
  p.end();
#endif
}

static void formatAutoShutdownSummary(char* buf, size_t cap) {
  if (!buf || cap == 0) return;
  uint32_t s = g_autoShutdownIdleSeconds;
  if (s == 0) {
    strncpy(buf, tr("Never", "Nikad"), cap);
    buf[cap - 1] = 0;
    return;
  }
  if (s % 3600u == 0u) {
    snprintf(buf, cap, "%lu h", (unsigned long)(s / 3600u));
    return;
  }
  snprintf(buf, cap, "%lu min", (unsigned long)(s / 60u));
}

