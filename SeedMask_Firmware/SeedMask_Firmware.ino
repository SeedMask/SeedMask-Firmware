  ui_flush();
}

/** When duress unlock is No-Crypto: burger menu omits Seed settings + Security; Device/SET TIME move up. */
static bool burgerMenuHideSeedAndSecurity() {
  if (!g_duressSession) return false;
  if (g_duressSessionType == DuressBehavior::EMPTY_VAULT) return true;
  if (g_duressSessionType == DuressBehavior::DECOY_VAULT && !g_hasVault) return true;
  return false;
}

/** Empty + decoy duress: hide Security row (decoy still shows Seed settings when vault active). */
static bool burgerMenuHideSecurity() {
  if (!g_duressSession) return false;
  return g_duressSessionType == DuressBehavior::EMPTY_VAULT
         || g_duressSessionType == DuressBehavior::DECOY_VAULT;
}

/** Decoy vault: Seed settings shows View Seed only (no backup code / QR backup). */
static bool seedSettingsHideBackupViews() {
  return g_duressSession && g_duressSessionType == DuressBehavior::DECOY_VAULT;
}

static bool session_has_backup_code() {
  if (seedSettingsHideBackupViews()) return false;
  return g_portableBackupReady && g_viewBackupCode[0];
}

static void portable_backup_clear(void) {
  g_portableBackupReady = false;
  memset(g_viewBackupCode, 0, sizeof(g_viewBackupCode));
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.remove("pbc_on");
  prefs.remove("pbc_code");
  prefs.end();
}

/** Mark a user-facing portable SPB1 backup (create or restore). Ignores SPF1 / oversized vault lines. */
static void portable_backup_set_from_code(const char* code) {
  if (!code || strncmp(code, "SPB1-", 5) != 0) return;
  const size_t n = strlen(code);
  if (n < 8 || n >= sizeof(g_viewBackupCode)) return;
  strncpy(g_viewBackupCode, code, sizeof(g_viewBackupCode) - 1);
  g_viewBackupCode[sizeof(g_viewBackupCode) - 1] = 0;
  g_portableBackupReady = true;
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar("pbc_on", 1);
  prefs.putString("pbc_code", g_viewBackupCode);
  prefs.end();
}

/** Restore portable backup UI state after unlock (same SPB1 the user created/restored). */
static void portable_backup_load_from_nvs(void) {
  Preferences prefs;
  prefs.begin("seedmask", true);
  const bool on = prefs.getUChar("pbc_on", 0) != 0;
  String s = on ? prefs.getString("pbc_code", "") : String();
  prefs.end();
  g_viewBackupCode[0] = 0;
  g_portableBackupReady = false;
  if (!on || s.length() == 0 || !s.startsWith("SPB1-") || (size_t)s.length() >= sizeof(g_viewBackupCode))
    return;
  strncpy(g_viewBackupCode, s.c_str(), sizeof(g_viewBackupCode) - 1);
  g_viewBackupCode[sizeof(g_viewBackupCode) - 1] = 0;
  g_portableBackupReady = true;
}

