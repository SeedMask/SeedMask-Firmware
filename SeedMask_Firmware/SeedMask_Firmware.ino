  if (hit(BTN_CRYPTO_TOOLS_SIGN_ROW, x, y)) {
    tools_begin_sign_scan();
    return;
  }
}

static void tools_build_verify_ms_candidate_list(void) {
  g_toolsVerifyMsCandCount = 0;
  if (!g_multisigWalletPayloads) return;
  uint32_t curXfp = MULTISIG_CTX_TAG_UNKNOWN;
  if (!current_master_xfp_u32(&curXfp)) return;
  for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
    if (g_toolsVerifyMsCandCount >= MULTISIG_MAX_STORED_WALLETS) break;
    if (g_multisigWalletContextTag[i] == curXfp) {
      g_toolsVerifyMsCands[g_toolsVerifyMsCandCount++] = i;
      continue;
    }
    if (g_multisigWalletContextTag[i] == MULTISIG_CTX_TAG_UNKNOWN
        && multisig_payload_matches_current_device(g_multisigWalletPayloads[i])) {
      g_toolsVerifyMsCands[g_toolsVerifyMsCandCount++] = i;
    }
  }
}

