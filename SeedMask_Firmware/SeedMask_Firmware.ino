    case UIScreen::SET_TIME:
    case UIScreen::SECURITY_PIN_SETUP:
    case UIScreen::SECURITY_LOCK_PW_CONFIRM_VAULT:
    case UIScreen::SECURITY_LOCK_PW_SETUP:
    case UIScreen::SECURITY_DURESS_PW_SETUP:
    case UIScreen::SECURITY_DURESS_PIN_SETUP:
    case UIScreen::LOCKED:
    case UIScreen::UNLOCK_PASSWORD:
    case UIScreen::CREATE_PASSWORD:
    case UIScreen::CREATE_PASSWORD2:
    case UIScreen::BACKUP_PASSWORD1:
    case UIScreen::BACKUP_PASSWORD2:
    case UIScreen::RESTORE_PASSWORD:
      return true;
    default:
      return false;
  }
}

static bool nav_bar_awake_now(uint32_t nowMs) {
  return g_navBarAwake && nowMs < g_navBarAwakeUntilMs;
}

static bool nav_bar_interactive() {
  if (!nav_bar_visible()) return false;
  if (g_navOverlay != NavOverlay::NONE) return true;
  if (!nav_bar_keyboard_active()) return true;
  return nav_bar_awake_now(millis());
}

static bool nav_bar_bottom_zone_contains(uint16_t x, uint16_t y) {
  if (!nav_bar_visible()) return false;
  return (int)y >= nav_bar_zone_top() && (int)y < nav_bar_zone_bottom() && x < LCD_W;
}

static void nav_bar_wake(uint32_t nowMs) {
  g_navBarAwake = true;
  g_navBarAwakeUntilMs = nowMs + NAV_BAR_WAKE_TIMEOUT_MS;
  draw();
}

static void nav_bar_touch_activity(uint32_t nowMs) {
  if (nav_bar_keyboard_active() && g_navBarAwake)
    g_navBarAwakeUntilMs = nowMs + NAV_BAR_WAKE_TIMEOUT_MS;
}

static void nav_bar_sleep_if_expired(uint32_t nowMs) {
  if (!g_navBarAwake || nowMs < g_navBarAwakeUntilMs) return;
  g_navBarAwake = false;
  if (g_navOverlay == NavOverlay::NONE)
    draw();
}

static bool nav_bar_zone_contains(uint16_t x, uint16_t y) {
  if (!nav_bar_interactive()) return false;
  return nav_bar_bottom_zone_contains(x, y);
}

/** Credential detail view (keyboard hidden) with send-field picker open. */
static bool pwEditorCredentialSendPickerUiActive() {
  return g_editMode == EditMode::EDIT_PW_VALUE && !g_pwEditKeyboardVisible && g_pwEditorSendPickerActive;
}

/** Nav gestures (tap home / CC / switcher) allowed — keyboard requires wake first. */
static bool nav_bar_gestures_allowed(uint32_t nowMs) {
  if (!nav_bar_visible()) return false;
  if (g_navOverlay != NavOverlay::NONE) return true;
  if (pwEditorCredentialSendPickerUiActive()) return false;
  if (!nav_bar_keyboard_active()) return true;
  return nav_bar_awake_now(nowMs);
}

static bool nav_bar_wake_allowed(uint32_t nowMs) {
  return nav_bar_visible() && nav_bar_keyboard_active() && !nav_bar_awake_now(nowMs)
         && g_navOverlay == NavOverlay::NONE;
}

/** Asleep + keyboard: swipe up from home pill only (spacebar uses space-track + g_navSleepWakeOnSpace). */
static bool nav_bar_wake_touch_down_contains(uint16_t x, uint16_t y, uint32_t nowMs) {
  if (!nav_bar_wake_allowed(nowMs)) return false;
  if (!nav_bar_bottom_zone_contains(x, y)) return false;
  kb_layout_init(getKbY0());
  // Spacebar rect overlaps the home pill; pill must still wake. Only exclude OK.
  if (hitOkKeyResolved((int16_t)x, (int16_t)y)) return false;
  const int ix = (LCD_W - NAV_BAR_INDICATOR_W) / 2;
  const int iy = nav_bar_indicator_y();
  // Match home pill: no upward extension into keyboard/buttons.
  const Rect pill = { (int16_t)(ix - 14), (int16_t)iy,
                      (int16_t)(NAV_BAR_INDICATOR_W + 28), (int16_t)(NAV_BAR_INDICATOR_H + 12) };
  return hit(pill, (int16_t)x, (int16_t)y);
}

/** Awake + keyboard: nav uses bottom strip; asleep: no nav capture here (wake only). */
static bool nav_bar_gesture_zone_contains(uint16_t x, uint16_t y, uint32_t nowMs) {
  if (!nav_bar_visible()) return false;
  if (!nav_bar_keyboard_active()) return nav_bar_bottom_zone_contains(x, y);
  if (!nav_bar_gestures_allowed(nowMs)) return false;
  return nav_bar_bottom_zone_contains(x, y);
}

/** Nav bar hit test while app switcher is open (indicator is always drawn at the bottom). */
static bool nav_switcher_bar_zone_contains(uint16_t x, uint16_t y) {
  if (g_navOverlay != NavOverlay::APP_SWITCHER)
    return nav_bar_zone_contains(x, y);
  const int top = nav_bar_zone_top();
  const int bottom = nav_bar_zone_bottom();
  return (int)y >= top && (int)y < bottom && x < LCD_W;
}

