  {
    char showPath[64];
    const char* cwd = g_msSdCwd;
    if (strlen(cwd) > 28) snprintf(showPath, sizeof(showPath), "...%s", cwd + strlen(cwd) - 24);
    else snprintf(showPath, sizeof(showPath), "%s", cwd);
    gfx->print(showPath);
  }
  int startIdx = g_msSdScrollOffset;
  int endIdx = min(startIdx + SD_FILES_PER_PAGE, g_msSdCount);
