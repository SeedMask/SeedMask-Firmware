      break;
    case UIScreen::CREATE_CONFIRM:
      show(UIScreen::CREATE_VERIFY_CHOICE);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CREATE_LOCK_TYPE:
      if (g_onboardLockAfterCreate) {
        show(UIScreen::CREATE_VERIFY_CHOICE);
      } else if (g_onboardLockFlow) {
        // Restore path: lock setup is mandatory — swipe must not leave this screen.
      } else {
        show(g_loggedIn ? UIScreen::MENU : UIScreen::HOME);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CREATE_BACKUP_OPT:
      show(UIScreen::CREATE_LOCK_TYPE);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CREATE_PASSWORD:
      if (g_createVaultPasswordThenAdd) {
        UIScreen ret = g_vaultPwThenAddReturn;
        g_createVaultPasswordThenAdd = false;
        g_creatingMasterPassword = false;
        show(ret);
      } else if (g_creatingMasterPassword) {
        g_creatingMasterPassword = false;
        show(UIScreen::PASSWORDS);
      } else if (g_createBackupFromSeedSettings) {
        g_createBackupFromSeedSettings = false;
        show(UIScreen::SEED_SETTINGS);
      } else {
        show(UIScreen::CREATE_BACKUP_OPT);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CREATE_PASSWORD2:
      show(UIScreen::CREATE_PASSWORD);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::CREATE_SHOW_CODE:
      show(UIScreen::PASSWORDS);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::BACKUP_CHOOSE_WORDS:
      if (g_tempSeedImportMode == TempSeedImportMode::MANUAL_WORDS) {
        g_tempSeedImportMode = TempSeedImportMode::NONE;
        show(UIScreen::CRYPTO_TEMP_SEED);
      } else {
        // Create → Create backup code: back to Create pick (not the post-seed "Backup code?" prompt)
        show(UIScreen::CREATE_PICK);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::BACKUP_FROM_SEED:
      // Mid-entry: swipe-right steps to the previous word (same as Del on empty).
      if (seedEntryPreviousWord()) {
        draw();
        g_touchIgnoreUntil = millis() + 220;
        break;
      }
      if (g_restoreSeedFlowActive) {
        g_restoreSeedEntryMode = true;
        show(UIScreen::RESTORE_CODE);
      } else {
        show(UIScreen::BACKUP_CHOOSE_WORDS);
      }
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::BACKUP_REVIEW_WORDS:
      // Land on last word for editing (all words were committed before review).
      (void)seedEntryPreviousWord();
      show(UIScreen::BACKUP_FROM_SEED);
      g_touchIgnoreUntil = millis() + 220;
      break;
    case UIScreen::BACKUP_PASSWORD1:
      show(UIScreen::BACKUP_REVIEW_WORDS);
      g_touchIgnoreUntil = millis() + 220;
      break;
