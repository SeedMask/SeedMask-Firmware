  if (g_screen == UIScreen::ADDRESS_QR) return g_addrQrFromMultisigReceive ? (uint8_t)1 : (uint8_t)0;
  return g_addrExplorerMultisig ? (uint8_t)1 : (uint8_t)0;
}
static bool addr_status_is_used(uint32_t idx) {
  const uint8_t ms = addr_status_ms_ctx_now();
  for (size_t i = 0; i < g_addrStatusMarkedCount; i++) {
    if (g_addrStatusMarkedIdx[i] == idx && g_addrStatusMarkedAccount[i] == g_addrAccount
        && g_addrStatusMarkedType[i] == (uint8_t)g_addrType && g_addrStatusMarkedChain[i] == g_addrChain
        && g_addrStatusMarkedMs[i] == ms) {
      return true;
    }
  }
  return false;
}

static const uint32_t kAddrStatusPrefsMagic = 0x31555341u;  // '1USA' when interpreted as ASCII LE
static const uint32_t kAddrStatusPrefsVer = 1u;
struct AddrStatusPrefsRec {
  uint32_t idx;
  uint32_t account;
  uint8_t type;
  uint8_t chain;
  uint8_t ms;
} __attribute__((packed));

static void addr_status_pref_key(char key[16]) {
  char xfp[9] = { 0 };
  if (current_master_xfp(xfp)) {
    snprintf(key, 16, "asu_%s", xfp);
  } else {
    strncpy(key, "addr_used", 16);
    key[15] = 0;
  }
}

/** Serialize used-address marks (same layout as NVS prefs blob). Returns false if `cap` too small. */
static bool addr_status_write_blob(uint8_t* dst, size_t cap, size_t* written) {
  if (!dst || !written) return false;
  const size_t headBytes = sizeof(uint32_t) * 3u;
  const size_t recBytes = sizeof(AddrStatusPrefsRec);
  const size_t need = headBytes + g_addrStatusMarkedCount * recBytes;
  if (cap < need) return false;
  uint32_t* h = (uint32_t*)dst;
  h[0] = kAddrStatusPrefsMagic;
  h[1] = kAddrStatusPrefsVer;
  h[2] = (uint32_t)g_addrStatusMarkedCount;
  AddrStatusPrefsRec* recs = (AddrStatusPrefsRec*)(dst + headBytes);
  for (size_t i = 0; i < g_addrStatusMarkedCount; i++) {
    recs[i].idx = g_addrStatusMarkedIdx[i];
    recs[i].account = g_addrStatusMarkedAccount[i];
    recs[i].type = g_addrStatusMarkedType[i];
    recs[i].chain = g_addrStatusMarkedChain[i];
    recs[i].ms = g_addrStatusMarkedMs[i];
  }
  *written = need;
  return true;
}

static void addr_status_save_to_prefs(void) {
  if (g_tempSeedActive) return;
  const size_t headBytes = sizeof(uint32_t) * 3u;
  const size_t recBytes = sizeof(AddrStatusPrefsRec);
  const size_t maxBlob = headBytes + ADDR_STATUS_MARK_CAP * recBytes;
  uint8_t* blob = (uint8_t*)malloc(maxBlob);
  if (!blob) return;
  size_t total = 0;
  if (!addr_status_write_blob(blob, maxBlob, &total)) {
    free(blob);
    return;
  }
  char pk[16];
  addr_status_pref_key(pk);
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putBytes(pk, blob, total);
  prefs.end();
  free(blob);
}

/** Load blob into RAM; if `persistToPrefs`, also write NVS (skipped for temp seed). */
static bool addr_status_apply_blob(const uint8_t* blob, size_t blobLen, bool persistToPrefs) {
  const size_t headBytes = sizeof(uint32_t) * 3u;
  const size_t recBytes = sizeof(AddrStatusPrefsRec);
  if (!blob || blobLen < headBytes) return false;
  const uint32_t* h = (const uint32_t*)blob;
  if (h[0] != kAddrStatusPrefsMagic || h[1] != kAddrStatusPrefsVer) return false;
  const uint32_t n = h[2];
  if (n > ADDR_STATUS_MARK_CAP || headBytes + (size_t)n * recBytes > blobLen) return false;
  const AddrStatusPrefsRec* recs = (const AddrStatusPrefsRec*)(blob + headBytes);
  for (uint32_t i = 0; i < n; i++) {
    g_addrStatusMarkedIdx[i] = recs[i].idx;
    g_addrStatusMarkedAccount[i] = recs[i].account;
    g_addrStatusMarkedType[i] = recs[i].type;
    g_addrStatusMarkedChain[i] = recs[i].chain;
    g_addrStatusMarkedMs[i] = recs[i].ms;
  }
  g_addrStatusMarkedCount = (size_t)n;
  if (persistToPrefs && !g_tempSeedActive) addr_status_save_to_prefs();
  return true;
}

static void addr_status_load_from_prefs(void) {
  g_addrStatusMarkedCount = 0;
  if (g_tempSeedActive) return;
  char pk[16];
  addr_status_pref_key(pk);
  Preferences prefs;
  prefs.begin("seedmask", true);
  const size_t blobLen = prefs.getBytesLength(pk);
  prefs.end();
  if (blobLen < sizeof(uint32_t) * 3u) return;
  uint8_t* blob = (uint8_t*)malloc(blobLen);
  if (!blob) return;
  prefs.begin("seedmask", true);
  const size_t got = prefs.getBytes(pk, blob, blobLen);
  prefs.end();
  if (got < sizeof(uint32_t) * 3u) {
    free(blob);
    return;
  }
  (void)addr_status_apply_blob(blob, got, false);
  free(blob);
}

/** SPE1 / SD: decode a base64 slice (not necessarily null-terminated) into used-address blob and apply. */
static void addr_status_try_import_u_b64_slice(const char* b64Start, size_t b64Len, bool persistPrefs) {
  if (!b64Start || b64Len == 0) return;
  char* z = (char*)malloc(b64Len + 1u);
  if (!z) return;
  memcpy(z, b64Start, b64Len);
  z[b64Len] = 0;
  const size_t decCap = (b64Len * 3u) / 4u + 32u;
  uint8_t* dec = (uint8_t*)ps_malloc(decCap);
  if (!dec) {
    free(z);
    return;
  }
  size_t dl = base64_decode(z, dec, decCap);
  free(z);
  if (dl == 0) {
    free(dec);
    return;
  }
  (void)addr_status_apply_blob(dec, dl, persistPrefs);
  secure_memzero(dec, decCap);
  free(dec);
}

/** After used-address list mutates and prefs are saved: SPE1/SPE1-M must rebuild; PW_*.bin should mirror (same pattern as pw/note edits); SPF1 screen cache must drop. */
static void addr_status_sync_external_backups_after_mark_change(void) {
  if (g_tempSeedActive || !g_loggedIn || !g_masterPw[0]) return;
  g_vaultQrDirty = true;
  if (g_pwScreenSpf1BackupCode) {
    free(g_pwScreenSpf1BackupCode);
    g_pwScreenSpf1BackupCode = nullptr;
  }
  if (sd_ready()) (void)pw_vault_save_to_sd(g_masterPw);
}

static void addr_status_set_used(uint32_t idx, bool used) {
  const uint8_t ms = addr_status_ms_ctx_now();
  for (size_t i = 0; i < g_addrStatusMarkedCount; i++) {
    if (g_addrStatusMarkedIdx[i] == idx && g_addrStatusMarkedAccount[i] == g_addrAccount
        && g_addrStatusMarkedType[i] == (uint8_t)g_addrType && g_addrStatusMarkedChain[i] == g_addrChain
        && g_addrStatusMarkedMs[i] == ms) {
      if (!used) {
        g_addrStatusMarkedCount--;
        if (i < g_addrStatusMarkedCount) {
          g_addrStatusMarkedIdx[i] = g_addrStatusMarkedIdx[g_addrStatusMarkedCount];
          g_addrStatusMarkedAccount[i] = g_addrStatusMarkedAccount[g_addrStatusMarkedCount];
          g_addrStatusMarkedType[i] = g_addrStatusMarkedType[g_addrStatusMarkedCount];
          g_addrStatusMarkedChain[i] = g_addrStatusMarkedChain[g_addrStatusMarkedCount];
          g_addrStatusMarkedMs[i] = g_addrStatusMarkedMs[g_addrStatusMarkedCount];
        }
        addr_status_save_to_prefs();
        addr_status_sync_external_backups_after_mark_change();
      }
      return;
    }
  }
  if (!used || g_addrStatusMarkedCount >= ADDR_STATUS_MARK_CAP) return;
  g_addrStatusMarkedIdx[g_addrStatusMarkedCount] = idx;
  g_addrStatusMarkedAccount[g_addrStatusMarkedCount] = g_addrAccount;
  g_addrStatusMarkedType[g_addrStatusMarkedCount] = (uint8_t)g_addrType;
  g_addrStatusMarkedChain[g_addrStatusMarkedCount] = g_addrChain;
  g_addrStatusMarkedMs[g_addrStatusMarkedCount] = ms;
  g_addrStatusMarkedCount++;
  addr_status_save_to_prefs();
  addr_status_sync_external_backups_after_mark_change();
}
static size_t addr_status_collect_used(uint32_t* out, size_t outCap) {
  if (!out || outCap == 0) return 0;
  const uint8_t ms = addr_status_ms_ctx_now();
  size_t n = 0;
  for (size_t i = 0; i < g_addrStatusMarkedCount && n < outCap; i++) {
    if (g_addrStatusMarkedAccount[i] == g_addrAccount && g_addrStatusMarkedType[i] == (uint8_t)g_addrType
        && g_addrStatusMarkedChain[i] == g_addrChain && g_addrStatusMarkedMs[i] == ms) {
      out[n++] = g_addrStatusMarkedIdx[i];
    }
  }
  for (size_t i = 0; i < n; i++) {
    for (size_t j = i + 1; j < n; j++) {
      if (out[j] < out[i]) {
        uint32_t t = out[i];
        out[i] = out[j];
        out[j] = t;
      }
    }
  }
  return n;
}
