static void drawKeyboard() {
  // Keyboard panel background (explicit container behind all keys).
  int kbY0 = getKbY0();
  const uint16_t panelBg = (uint16_t)0x4228;  // slightly brighter dark gray
  // Shrink keyboard background upper side by 5px (move panel top down).
  const int topInset = 3;
  const int bottomExtend = 4;  // a bit below lower keys
  const int panelY = min(kbY0 + topInset, LCD_H - 1);
  int panelH = (LCD_H - panelY) + bottomExtend;
  if (panelY + panelH > LCD_H) panelH = LCD_H - panelY;
  gfx->fillRect(0, panelY, LCD_W, panelH, panelBg);
  gfx->drawRect(0, panelY, LCD_W, panelH, UI_BORDER);
  drawKeyboardControls();

  for (int i = 0; i < ROW1_N; i++) {
    char c = activeCharRow(1, i);
    char lab[4] = { 0 };
    lab[0] = c;
    lab[1] = 0;
    if (g_kbMode == KBMode::LETTERS && g_shift && lab[0] >= 'a' && lab[0] <= 'z') lab[0] = (char)(lab[0] - 'a' + 'A');
    drawKeyRect(keyRectRow1[i], lab);
  }
  for (int i = 0; i < ROW2_N; i++) {
    char c = activeCharRow(2, i);
    char lab[4] = { 0 };
    lab[0] = c;
    lab[1] = 0;
    if (g_kbMode == KBMode::LETTERS && g_shift && lab[0] >= 'a' && lab[0] <= 'z') lab[0] = (char)(lab[0] - 'a' + 'A');
    drawKeyRect(keyRectRow2[i], lab);
  }
  for (int i = 0; i < ROW3_N; i++) {
    char c = activeCharRow(3, i);
    char lab[8] = { 0 };
    if (i == 0) {
      if (g_kbMode == KBMode::NUMBERS)
        drawKeyRect(keyRectRow3[i], "0");
      else if (g_kbMode == KBMode::SYMBOLS)
        drawKeyRectSmall(keyRectRow3[i], g_shift ? "2/2" : "1/2");
      else
        drawKeyRectSmall(keyRectRow3[i], "Shift");
      continue;
    }
    if (c == '\b') {
      drawKeyRectSmall(keyRectRow3[i], "Del");
      continue;
    }
    if (c) {
      lab[0] = c;
      lab[1] = 0;
    }
    if (g_kbMode == KBMode::LETTERS && g_shift && lab[0] >= 'a' && lab[0] <= 'z') lab[0] = (char)(lab[0] - 'a' + 'A');
    drawKeyRect(keyRectRow3[i], lab);
  }
  if (g_kbMode == KBMode::NUMBERS)
    drawKeyRect(keyRectRow4[0], "123");
  else
    drawKeyRect(keyRectRow4[0], "SYM");
  // When the trackpad gesture starts, the overlay will normally redraw the spacebar.
  // But since we delay showing the overlay (to prevent flashing), keep the spacebar key visible.
  if (!g_spaceTrackActive || !g_spaceTrackOverlayShown)
    drawKeyRect(keyRectRow4[1], "");
  gfx->fillRoundRect(keyRectRow4[2].x, keyRectRow4[2].y, keyRectRow4[2].w, keyRectRow4[2].h, 10, RGB565_BLUE);
  gfx->drawRoundRect(keyRectRow4[2].x, keyRectRow4[2].y, keyRectRow4[2].w, keyRectRow4[2].h, 10, RGB565_WHITE);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(2);
  gfx->setCursor(keyRectRow4[2].x + (keyRectRow4[2].w - 24) / 2, keyRectRow4[2].y + (keyRectRow4[2].h / 2 - 10));
  gfx->print("OK");
  if (g_spaceTrackActive && g_spaceTrackOverlayShown)
    drawCursorTrackpadOverlay();
}

// Letter rows (1–3): touch targets larger than drawn keys (SYM / space / OK keep their own helpers).
static bool hitKeyRows123(const Rect& r, int16_t px, int16_t py) {
  const int expandH = 5;
  const int expandV = 6;
  int16_t x0 = r.x - expandH;
  if (x0 < 0) x0 = 0;
  int16_t x1 = r.x + r.w + expandH;
  if (x1 > LCD_W) x1 = LCD_W;
  int16_t y0 = r.y - expandV;
  if (y0 < 0) y0 = 0;
  int16_t y1 = r.y + r.h + expandV;
  if (y1 > LCD_H) y1 = LCD_H;
  return (px >= x0 && px < x1 && py >= y0 && py < y1);
}

/** Row 1 (Q–P / 1–0): narrower keys than rows 2–3 — slightly larger inflate to match hit comfort. */
static bool hitKeyRow1(const Rect& r, int16_t px, int16_t py) {
  const int expandH = 7;
  const int expandV = 6;
  int16_t x0 = r.x - expandH;
  if (x0 < 0) x0 = 0;
  int16_t x1 = r.x + r.w + expandH;
  if (x1 > LCD_W) x1 = LCD_W;
  int16_t y0 = r.y - expandV;
  if (y0 < 0) y0 = 0;
  int16_t y1 = r.y + r.h + expandV;
  if (y1 > LCD_H) y1 = LCD_H;
  return (px >= x0 && px < x1 && py >= y0 && py < y1);
}

static bool tapInKeyboardArea(int16_t x, int16_t y) {
  for (int i = 0; i < ROW4_N; i++) {
    if (i == 0) {
      if (hitSymKey(x, y)) return true;
    } else if (i == 1) {
      if (hitSpacebar(x, y)) return true;
    } else if (i == 2) {
      if (hitOkKey(x, y)) return true;
    } else if (hit(keyRectRow4[i], x, y)) return true;
  }
  for (int i = 0; i < ROW1_N; i++)
    if (hitKeyRow1(keyRectRow1[i], x, y)) return true;
  for (int i = 0; i < ROW2_N; i++)
    if (hitKeyRows123(keyRectRow2[i], x, y)) return true;
  for (int i = 0; i < ROW3_N; i++)
    if (hitKeyRows123(keyRectRow3[i], x, y)) return true;
  return false;
}

// SYM/123 key: expanded hit area so the whole key (horizontal and vertical) registers
static bool hitSymKey(int16_t px, int16_t py) {
  const Rect& r = keyRectRow4[0];
  const int expandH = 6;
  const int expandV = 8;
  int16_t x0 = r.x - expandH;
  if (x0 < 0) x0 = 0;
  int16_t x1 = r.x + r.w + expandH;
  if (x1 > LCD_W) x1 = LCD_W;
  int16_t y0 = r.y - expandV;
  if (y0 < 0) y0 = 0;
  int16_t y1 = r.y + r.h + expandV;
  if (y1 > LCD_H) y1 = LCD_H;
  return (px >= x0 && px < x1 && py >= y0 && py < y1);
}

// Spacebar: forgiving hit area across full width and full height (especially lower edge)
static bool hitSpacebar(int16_t px, int16_t py) {
  const Rect& r = keyRectRow4[1];
  const int expandH = 6;
  const int expandV = 8;  // extra below so bottom of key registers
  int16_t x0 = r.x - expandH;
  if (x0 < 0) x0 = 0;
  int16_t x1 = r.x + r.w + expandH;
  if (x1 > LCD_W) x1 = LCD_W;
  int16_t y0 = r.y - expandV;
  if (y0 < 0) y0 = 0;
  int16_t y1 = r.y + r.h + expandV;
  if (y1 > LCD_H) y1 = LCD_H;
  return (px >= x0 && px < x1 && py >= y0 && py < y1);
}

// OK key: expanded hit area so the whole button (and edges) registers, like SYM/spacebar
static bool hitOkKey(int16_t px, int16_t py) {
  const Rect& r = keyRectRow4[2];
  const int expandH = 6;
  const int expandV = 8;
  int16_t x0 = r.x - expandH;
  if (x0 < 0) x0 = 0;
  int16_t x1 = r.x + r.w + expandH;
  if (x1 > LCD_W) x1 = LCD_W;
  int16_t y0 = r.y - expandV;
  if (y0 < 0) y0 = 0;
  int16_t y1 = r.y + r.h + expandV;
  if (y1 > LCD_H) y1 = LCD_H;
  return (px >= x0 && px < x1 && py >= y0 && py < y1);
}

// Un-inflated OK rect — use where only the drawn key matters (e.g. flash target).
static bool hitOkKeyStrict(int16_t px, int16_t py) {
  return hit(keyRectRow4[2], px, py);
}

// Row 4 resolves like keyboardHit: SYM and space expanded rects are checked before OK, so the
// gap/overlap between keys does not mis-fire OK. Use for unlock submit + passwordInputTap so
// taps on OK's forgiving edges (same as typing) validate on first press.
static bool hitOkKeyResolved(int16_t px, int16_t py) {
  if (hitSymKey(px, py)) return false;
  if (hitSpacebar(px, py)) return false;
  return hitOkKey(px, py);
}

// Bottom list buttons may sit near the home pill — pad sideways/up, but never into the pill band.
static bool hitBottomListAction(const Rect& r, uint16_t x, uint16_t y) {
  const int padH = 12;
  const int padTop = 4;
  int padBottom = 16;
  if (nav_bar_visible()) {
    const int pillTop = nav_bar_indicator_y();
    const int maxBottom = pillTop - (int)r.y - (int)r.h;
    if (padBottom > maxBottom) padBottom = maxBottom;
    if (padBottom < 0) padBottom = 0;
  }
  return hit({ (int16_t)(r.x - padH), (int16_t)(r.y - padTop),
               (int16_t)(r.w + 2 * padH), (int16_t)(r.h + padTop + padBottom) },
             x, y);
}

/** Hit target for the visible white home indicator only (centered — not blank left/right). */
static bool nav_bar_home_pill_hit(int16_t x, int16_t y) {
  if (!nav_bar_visible()) return false;
  const int ix = (LCD_W - NAV_BAR_INDICATOR_W) / 2;
  const int padX = 18;  // slight horizontal forgiveness; do not grow vertically into buttons
  if ((int)x < ix - padX || (int)x >= ix + NAV_BAR_INDICATOR_W + padX) return false;
  // CRITICAL: do not extend upward. Bottom actions (Import backup, ADD, Back, …) sit
  // immediately above the pill; any upward pad steals those taps (touch Y is also noisy).
  const int iy = nav_bar_indicator_y();
  return (int)y >= iy && (int)y < LCD_H;
}

/** Tap→Home target: the white nav indicator only (blank left/right sides do not go Home). */
static bool nav_bar_home_tap_hit(int16_t x, int16_t y) {
  return nav_bar_home_pill_hit(x, y);
}

/** Keyboard / ADD etc. vs nav. Bottom CTAs that sit near the pill must win; then pill column wins over ADD/BACKUP. */
static bool nav_bar_ui_blocks_gesture_at(int16_t x, int16_t y) {
  if (g_editMode == EditMode::NONE) {
    // BIP85 index / Set time / New account: Del · 0 · OK|SET row must not become Home.
    if (g_screen == UIScreen::CRYPTO_BIP85_INDEX
        || g_screen == UIScreen::SET_TIME
        || g_screen == UIScreen::CRYPTO_NEW_ACCOUNT) {
      for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
        if (hit(settimeNumpadKeyRect(3, c), x, y)) return true;
      }
    }
    if (g_screen == UIScreen::CRYPTO_TEMP_SEED_CONFIRM) {
      if (hit(BTN_TEMP_CONFIRM_SET, x, y) || hit(BTN_TEMP_CONFIRM_BACK, x, y)) return true;
    }
    if (g_screen == UIScreen::CRYPTO_BIP85_SHOW) {
      if (hit(BTN_BIP85_SET_TEMP, x, y) || hit(BTN_BIP85_SHOW_QR, x, y)) return true;
    }
    if (g_screen == UIScreen::PASSWORDS && !g_pwListEditMode) {
      if (hit(BTN_LIST_ADD, (int16_t)x, (int16_t)y)) return true;
      if (g_masterPw[0] && hit(BTN_LIST_BACKUP, (int16_t)x, (int16_t)y)) return true;
    }
    if (g_screen == UIScreen::NOTES && !g_noteListEditMode) {
      if (hit(BTN_LIST_ADD, (int16_t)x, (int16_t)y)) return true;
    }
    if (g_screen == UIScreen::TFA_LIST) {
      if (hit(BTN_TFA_ADD, (int16_t)x, (int16_t)y)) return true;
    }
  }
  // Pill column: do not treat as "UI blocks" so Home stays tappable on the indicator.
  if (nav_bar_home_pill_hit(x, y)) return false;
  if (nav_bar_keyboard_active()) {
    kb_layout_init(getKbY0());
    if (hitOkKeyResolved(x, y) || hitSymKey(x, y) || hitSpacebar(x, y))
      return true;
  }
  return false;
}

static void nav_cancel_pending_gesture() {
  g_navGestureTracking = false;
  g_navSpacebarNavSession = false;
  g_navWakeTracking = false;
}

static char keyboardHit(int16_t x, int16_t y) {
  if (g_sdSavePathPickOpen) return 0;
  for (int i = 0; i < ROW4_N; i++) {
    bool hitRow4 =
      (i == 0) ? hitSymKey(x, y) : (i == 1) ? hitSpacebar(x, y)
                                 : (i == 2) ? hitOkKey(x, y)
                                            : hit(keyRectRow4[i], x, y);
    if (hitRow4) {
      if (i == 0) {
        flashKeyRectTranslucent(keyRectRow4[i]);
        if (g_kbMode != KBMode::NUMBERS) {
          g_kbMode = (g_kbMode == KBMode::SYMBOLS) ? KBMode::LETTERS : KBMode::SYMBOLS;
          drawKeyboard();
          ui_flush();
        }
        return 0;
      }
      if (i == 1) {
        flashKeyRectTranslucent(keyRectRow4[i]);
        // Editor / TFA: space is inserted on release (space-track or nav wake), not on touch-down.
        if ((g_editMode != EditMode::NONE || g_screen == UIScreen::TFA_ADD) && !g_sdSavePathPickOpen)
          return 0;
        return ' ';
      }
      if (i == 2) {
        flashKeyRectTranslucent(keyRectRow4[i]);
        drawKeyboard();  // restore OK to normal so it doesn't stay lit
        ui_flush();
        return 0;
      }
      return 0;
    }
  }
  for (int i = 0; i < ROW1_N; i++) {
    if (hitKeyRow1(keyRectRow1[i], x, y)) {
      flashKeyRectTranslucent(keyRectRow1[i]);
      return activeCharRow(1, i);
    }
  }
  for (int i = 0; i < ROW2_N; i++) {
    if (hitKeyRows123(keyRectRow2[i], x, y)) {
      flashKeyRectTranslucent(keyRectRow2[i]);
      return activeCharRow(2, i);
    }
  }
  for (int i = 0; i < ROW3_N; i++) {
    if (hitKeyRows123(keyRectRow3[i], x, y)) {
      if (i == 0) {
        flashKeyRectTranslucent(keyRectRow3[i]);
        if (g_kbMode == KBMode::NUMBERS) {
          drawKeyboard();
          ui_flush();
          return '0';
        }
        // SYM: only 2 states (1/2 <-> 2/2). LETTERS: one-shot then caps lock then off
        if (g_kbMode == KBMode::SYMBOLS)
          g_shift = g_shift ? 0 : 1;
        else if (g_shift == 0) g_shift = 1;
        else if (g_shift == 1) g_shift = 2;
        else g_shift = 0;
        drawKeyboard();
        ui_flush();
        return 0;
      }
      flashKeyRectTranslucent(keyRectRow3[i]);
      return activeCharRow(3, i);
    }
  }
  return 0;
}

