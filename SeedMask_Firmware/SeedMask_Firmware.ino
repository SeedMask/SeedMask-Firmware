static bool secp_pubkey_compressed(const uint8_t priv[32], uint8_t out33[33]) {
  mbedtls_ecp_group grp;
  mbedtls_ecp_point Q;
  mbedtls_mpi d;
  size_t olen = 0;
  mbedtls_ecp_group_init(&grp);
  mbedtls_ecp_point_init(&Q);
  mbedtls_mpi_init(&d);
  bool ok = false;
  if (mbedtls_ecp_group_load(&grp, MBEDTLS_ECP_DP_SECP256K1) != 0) {
    addr_set_err("secp load");
    goto done;
  }
  if (mbedtls_mpi_read_binary(&d, priv, 32) != 0) {
    addr_set_err("priv parse");
    goto done;
  }
  if (mbedtls_ecp_mul(&grp, &Q, &d, &grp.G, mbedtls_rng_cb, nullptr) != 0) {
    addr_set_err("secp mul");
    goto done;
  }
  if (mbedtls_ecp_point_write_binary(&grp, &Q, MBEDTLS_ECP_PF_COMPRESSED, &olen, out33, 33) != 0) {
    addr_set_err("pub serialize");
    goto done;
  }
  if (olen != 33) {
    addr_set_err("pub len");
    goto done;
  }
  ok = true;
done:
  mbedtls_ecp_point_free(&Q);
  mbedtls_ecp_group_free(&grp);
  mbedtls_mpi_free(&d);
  return ok;
}

static bool bip32_master_from_seed(const uint8_t seed[64], Bip32Node* out) {
  static const uint8_t key[] = "Bitcoin seed";
  uint8_t I[64];
  if (!out) return false;
  if (!hmac_sha512(key, sizeof(key) - 1, seed, 64, I)) return false;
  memcpy(out->k, I, 32);
  memcpy(out->c, I + 32, 32);
  secure_memzero(I, sizeof(I));
  return true;
}

static bool bip32_ckd_priv(Bip32Node* n, uint32_t idx, bool hardened) {
  if (!n) return false;
  uint8_t data[1 + 33 + 4];
  size_t dlen = 0;
  if (hardened) {
    data[0] = 0;
    memcpy(data + 1, n->k, 32);
    dlen = 33;
    idx |= 0x80000000UL;
  } else {
    uint8_t pub[33];
    if (!secp_pubkey_compressed(n->k, pub)) return false;
    memcpy(data, pub, 33);
    dlen = 33;
    secure_memzero(pub, sizeof(pub));
  }
  ser32be(idx, data + dlen);
  dlen += 4;
  uint8_t I[64];
  if (!hmac_sha512(n->c, 32, data, dlen, I)) return false;

  mbedtls_ecp_group grp;
  mbedtls_ecp_group_init(&grp);
  mbedtls_mpi il, k, sum;
  mbedtls_mpi_init(&il);
  mbedtls_mpi_init(&k);
  mbedtls_mpi_init(&sum);
  bool ok = false;
  if (mbedtls_ecp_group_load(&grp, MBEDTLS_ECP_DP_SECP256K1) != 0) goto done;
  if (mbedtls_mpi_read_binary(&il, I, 32) != 0) goto done;
  if (mbedtls_mpi_cmp_mpi(&il, &grp.N) >= 0) goto done;
  if (mbedtls_mpi_read_binary(&k, n->k, 32) != 0) goto done;
  if (mbedtls_mpi_add_mpi(&sum, &il, &k) != 0) goto done;
  if (mbedtls_mpi_mod_mpi(&sum, &sum, &grp.N) != 0) goto done;
  if (mbedtls_mpi_cmp_int(&sum, 0) == 0) goto done;
  if (mbedtls_mpi_write_binary(&sum, n->k, 32) != 0) goto done;
  memcpy(n->c, I + 32, 32);
  ok = true;
done:
  secure_memzero(data, sizeof(data));
  secure_memzero(I, sizeof(I));
  mbedtls_mpi_free(&sum);
  mbedtls_mpi_free(&k);
  mbedtls_mpi_free(&il);
  mbedtls_ecp_group_free(&grp);
  return ok;
}

// Non-hardened public child (BIP32): for multisig cosigner xpub → receive/change leaf pubkeys.
static bool bip32_ckd_pub(const uint8_t Kpar33[33], const uint8_t cpar[32], uint32_t i, uint8_t Ki33[33], uint8_t ci[32]) {
  if (!Kpar33 || !cpar || !Ki33 || !ci) return false;
  if (Kpar33[0] != 0x02 && Kpar33[0] != 0x03) return false;
  if (i & 0x80000000u) return false;
  uint8_t data[37];
  memcpy(data, Kpar33, 33);
  ser32be(i, data + 33);
  uint8_t I[64];
  if (!hmac_sha512(cpar, 32, data, sizeof(data), I)) return false;
  mbedtls_ecp_group grp;
  mbedtls_mpi il, one;
  mbedtls_ecp_point IlG, KparPt, KiPt;
  mbedtls_ecp_group_init(&grp);
  mbedtls_mpi_init(&il);
  mbedtls_mpi_init(&one);
  mbedtls_ecp_point_init(&IlG);
  mbedtls_ecp_point_init(&KparPt);
  mbedtls_ecp_point_init(&KiPt);
  bool ok = false;
  size_t olen = 0;
  if (mbedtls_ecp_group_load(&grp, MBEDTLS_ECP_DP_SECP256K1) != 0) goto done_pub;
  if (mbedtls_mpi_read_binary(&il, I, 32) != 0) goto done_pub;
  if (mbedtls_mpi_cmp_mpi(&il, &grp.N) >= 0) goto done_pub;
  if (mbedtls_mpi_lset(&one, 1) != 0) goto done_pub;
  if (mbedtls_ecp_mul(&grp, &IlG, &il, &grp.G, mbedtls_rng_cb, nullptr) != 0) goto done_pub;
  if (mbedtls_ecp_point_read_binary(&grp, &KparPt, Kpar33, 33) != 0) goto done_pub;
  // R = 1*IlG + 1*KparPt (ESP-IDF mbedTLS may not expose mbedtls_ecp_add).
  if (mbedtls_ecp_muladd(&grp, &KiPt, &one, &IlG, &one, &KparPt) != 0) goto done_pub;
  if (mbedtls_ecp_check_pubkey(&grp, &KiPt) != 0) goto done_pub;
  if (mbedtls_ecp_point_write_binary(&grp, &KiPt, MBEDTLS_ECP_PF_COMPRESSED, &olen, Ki33, 33) != 0) goto done_pub;
  if (olen != 33) goto done_pub;
  memcpy(ci, I + 32, 32);
  ok = true;
done_pub:
  mbedtls_ecp_point_free(&KiPt);
  mbedtls_ecp_point_free(&KparPt);
  mbedtls_ecp_point_free(&IlG);
  mbedtls_mpi_free(&one);
  mbedtls_mpi_free(&il);
  mbedtls_ecp_group_free(&grp);
  secure_memzero(data, sizeof(data));
  secure_memzero(I, sizeof(I));
  return ok;
}

