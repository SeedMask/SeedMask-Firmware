static bool ensure_bip39_derived_seed_cached(void) {
  if (g_bip39DerivedSeedCacheValid) return true;
  char mnemonic[256];
  const char(*seedWords)[16] = g_seed;
  uint8_t seedWc = g_wc;
  if (g_tempSeedActive) {
    seedWords = g_tempSeedWords;
    seedWc = g_tempSeedWordCount;
  }
  if (!build_mnemonic_string(seedWords, seedWc, mnemonic, sizeof(mnemonic))) {
    addr_set_err("mnemonic");
    return false;
  }
  uint8_t salt[8 + BIP39_PASSPHRASE_MAX_BYTES];
  memcpy(salt, "mnemonic", 8);
  size_t passLen = g_bip39HasPassphrase ? strnlen(g_bip39Passphrase, sizeof(g_bip39Passphrase) - 1) : 0;
  if (passLen) memcpy(salt + 8, g_bip39Passphrase, passLen);
  if (!pbkdf2_sha512((const uint8_t*)mnemonic, strlen(mnemonic), salt, 8 + passLen, 2048, g_bip39DerivedSeedCache,
                     sizeof(g_bip39DerivedSeedCache))) {
    addr_set_err("pbkdf2");
    secure_memzero(mnemonic, sizeof(mnemonic));
    secure_memzero(salt, sizeof(salt));
    return false;
  }
  secure_memzero(mnemonic, sizeof(mnemonic));
  secure_memzero(salt, sizeof(salt));
  g_bip39DerivedSeedCacheValid = true;
  return true;
}

// BIP39 mnemonic from fixed entropy (same bit packing as generate_mnemonic_words).
static bool entropy_to_bip39_words(const uint8_t* entropy, size_t entBytes, uint8_t wc, char outWords[][16]) {
  if (!entropy || !outWords) return false;
  if (wc != 12 && wc != 24) return false;
  if ((wc == 12 && entBytes != 16) || (wc == 24 && entBytes != 32)) return false;
  uint8_t hash[32];
  mbedtls_sha256(entropy, entBytes, hash, 0);
  uint8_t csBits = (wc == 24) ? 8 : 4;
  uint16_t idx[24] = { 0 };
  uint32_t bitpos = 0;
  auto getBit = [&](uint32_t b) -> uint8_t {
    if (b < entBytes * 8) {
      uint32_t bi = b / 8, bj = 7 - (b % 8);
      return (entropy[bi] >> bj) & 1;
    }
    uint32_t cb = b - entBytes * 8;
    uint32_t bj = 7 - cb;
    return (hash[0] >> bj) & 1;
  };
  uint32_t totalBits = (uint32_t)(entBytes * 8 + csBits);
  for (int w = 0; w < wc; w++) {
    uint16_t v = 0;
    for (int b = 0; b < 11; b++) v = (uint16_t)((v << 1) | getBit(bitpos++));
    idx[w] = v;
    if (bitpos > totalBits) break;
  }
  for (int i = 0; i < wc; i++) {
    char tmp[16];
    bip39_get_word(idx[i], tmp, sizeof(tmp));
    strncpy(outWords[i], tmp, 15);
    outWords[i][15] = 0;
  }
  secure_memzero(hash, sizeof(hash));
  return true;
}

// Dice rolls → BIP39 entropy (standard approach used by hardware wallets):
// SHA256 of the ASCII digit string ("135266…"); use first 16 bytes (12 words)
// or full 32 bytes (24 words). Fair d6 ≈ 2.585 bits/roll → min 50 / 99 rolls.
static constexpr uint16_t kDiceRollsCap = 160;
/** True when current create-seed mnemonic came from dice rolls (not hardware RNG). */
static bool g_seedFromDice = false;
/** Dice faces 1..6 only; capacity covers 24-word minimum (99) with headroom. */
static uint8_t g_diceRolls[kDiceRollsCap];
static uint16_t g_diceRollCount = 0;

static uint16_t seedmask_dice_min_rolls(uint8_t wc) {
  return (wc == 24) ? 99u : 50u;
}

static bool seedmask_dice_rolls_to_mnemonic(const uint8_t* rolls, size_t n, uint8_t wc, char outWords[][16]) {
  if (!rolls || !outWords || !(wc == 12 || wc == 24)) return false;
  if (n < seedmask_dice_min_rolls(wc) || n > kDiceRollsCap) return false;
  char ascii[kDiceRollsCap + 1];
  for (size_t i = 0; i < n; i++) {
    if (rolls[i] < 1 || rolls[i] > 6) return false;
    ascii[i] = (char)('0' + rolls[i]);
  }
  ascii[n] = 0;

  uint8_t hash[32];
  mbedtls_sha256((const uint8_t*)ascii, n, hash, 0);
  secure_memzero(ascii, sizeof(ascii));

  const size_t entBytes = (wc == 24) ? 32u : 16u;
  const bool ok = entropy_to_bip39_words(hash, entBytes, wc, outWords);
  secure_memzero(hash, sizeof(hash));
  return ok;
}

static void dice_rolls_reset() {
  memset(g_diceRolls, 0, sizeof(g_diceRolls));
  g_diceRollCount = 0;
}

/*
 * SeedMask BIP-0085 (deterministic entropy from BIP32) — original implementation.
 *
 * Spec only: https://github.com/bitcoin/bips/blob/master/bip-0085.mediawiki
 *   HMAC-SHA512(key="bip-entropy-from-k", msg=k) after hardened path derivation.
 * BIP39 application: m/83696968'/39'/{language}'/{num_words}'/{index}'
 *   language 0' = English; truncate HMAC to 128/256 bits for 12/24 words.
 *
 * No vendor firmware source (Coldcard, Passport, etc.) was used for this module.
 */

static bool bip85_hmac_entropy_from_priv(const uint8_t kPriv[32], uint8_t hmacOut[64]) {
  if (!kPriv || !hmacOut) return false;
  static const char kBip85HmacKey[] = "bip-entropy-from-k";
  return hmac_sha512((const uint8_t*)kBip85HmacKey, sizeof(kBip85HmacKey) - 1,
                     kPriv, 32, hmacOut);
}

/** Hardened CKD of path indices (already without 0x80000000 — hardened flag applied here). */
static bool bip85_derive_path_hardened(Bip32Node* n, const uint32_t* indices, size_t nIdx) {
  if (!n || (!indices && nIdx)) return false;
  for (size_t i = 0; i < nIdx; i++) {
    if (!bip32_ckd_priv(n, indices[i], true)) return false;
  }
  return true;
}

/**
 * BIP-85 entropy from an arbitrary BIP32 master node (mutates a working copy only).
 * pathIndices: hardened child numbers for the BIP-85 path after the master.
 */
static bool bip85_entropy_from_master_node(const Bip32Node* master,
                                          const uint32_t* pathIndices, size_t pathLen,
                                          uint8_t hmacOut[64]) {
  if (!master || !hmacOut) return false;
  Bip32Node n;
  memcpy(&n, master, sizeof(n));
  if (!bip85_derive_path_hardened(&n, pathIndices, pathLen)) {
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint8_t kPriv[32];
  memcpy(kPriv, n.k, 32);
  secure_memzero(&n, sizeof(n));
  const bool ok = bip85_hmac_entropy_from_priv(kPriv, hmacOut);
  secure_memzero(kPriv, sizeof(kPriv));
  return ok;
}

static bool bip32_node_from_xprv58(const char* xprv, Bip32Node* out) {
  if (!xprv || !out) return false;
  uint8_t raw[78];
  if (!base58check_decode_payload(xprv, raw, 78)) return false;
  /* Mainnet xprv version 0x0488ADE4 */
  if (!(raw[0] == 0x04 && raw[1] == 0x88 && raw[2] == 0xAD && raw[3] == 0xE4)) {
    secure_memzero(raw, sizeof(raw));
    return false;
  }
  if (raw[45] != 0x00) {
    secure_memzero(raw, sizeof(raw));
    return false;
  }
  memcpy(out->c, raw + 13, 32);
  memcpy(out->k, raw + 46, 32);
  secure_memzero(raw, sizeof(raw));
  return true;
}

/** Active-wallet BIP-85 BIP39 path → full 64-byte HMAC digest. */
static bool bip85_derive_hmac(uint32_t index, uint8_t wc, uint8_t hmacOut[64], char* errMsg, size_t errMsgLen) {
  auto fail = [&](const char* m) {
    if (errMsg && errMsgLen) snprintf(errMsg, errMsgLen, "%s", m);
    return false;
  };
  if (wc != 12 && wc != 24) return fail("word count");
  if (index > 999999u) return fail("index 0-999999");
  /* Follow the currently active seed (master or temporary). */
  if (!ensure_bip39_derived_seed_cached()) return fail("wallet seed");
  Bip32Node master;
  memset(&master, 0, sizeof(master));
  if (!bip32_master_from_seed(g_bip39DerivedSeedCache, &master)) return fail("bip32 master");
  /* m/83696968'/39'/0'/{12|24}'/{index}'  (BIP-85 § BIP39 application) */
  const uint32_t path[5] = {
    83696968u,
    39u,
    0u,
    (wc == 12) ? 12u : 24u,
    index
  };
  if (!bip85_entropy_from_master_node(&master, path, 5, hmacOut)) {
    secure_memzero(&master, sizeof(master));
    return fail("bip85 derive");
  }
  secure_memzero(&master, sizeof(master));
  return true;
}

/** BIP-85 → BIP39 English mnemonic (12 or 24 words). */
static bool bip85_derive_mnemonic(uint32_t index, uint8_t wc, char words[][16], char* errMsg, size_t errMsgLen) {
  auto fail = [&](const char* m) {
    if (errMsg && errMsgLen) snprintf(errMsg, errMsgLen, "%s", m);
    return false;
  };
  uint8_t hmacOut[64];
  if (!bip85_derive_hmac(index, wc, hmacOut, errMsg, errMsgLen)) return false;
  const size_t entBytes = (wc == 12) ? 16u : 32u;
  if (!entropy_to_bip39_words(hmacOut, entBytes, wc, words)) {
    secure_memzero(hmacOut, sizeof(hmacOut));
    return fail("entropy to words");
  }
  secure_memzero(hmacOut, sizeof(hmacOut));
  return true;
}

/** BIP-85 published test vectors (BIP39 English 12 & 24 @ index 0). */
static bool seedmask_bip85_selftest(char* err, size_t errLen) {
  auto fail = [&](const char* m) {
    if (err && errLen) snprintf(err, errLen, "%s", m);
    return false;
  };
  static const char kXprv[] =
    "xprv9s21ZrQH143K2LBWUUQRFXhucrQqBpKdRRxNVq2zBqsx8HVqFk2uYo8kmbaLLHRdqtQpUm98uKfu3vca1LqdGhUtyoFnCNkfmXRyPXLjbKb";
  Bip32Node master;
  if (!bip32_node_from_xprv58(kXprv, &master)) return fail("xprv");

  uint8_t hmac[64];
  const uint32_t path12[5] = { 83696968u, 39u, 0u, 12u, 0u };
  if (!bip85_entropy_from_master_node(&master, path12, 5, hmac)) {
    secure_memzero(&master, sizeof(master));
    return fail("path12");
  }
  static const uint8_t kEnt12[16] = {
    0x62, 0x50, 0xb6, 0x8d, 0xaf, 0x74, 0x6d, 0x12, 0xa2, 0x4d, 0x58, 0xb4, 0x78, 0x7a, 0x71, 0x4b
  };
  if (memcmp(hmac, kEnt12, 16) != 0) {
    secure_memzero(hmac, sizeof(hmac));
    secure_memzero(&master, sizeof(master));
    return fail("ent12");
  }
  char words12[24][16];
  memset(words12, 0, sizeof(words12));
  if (!entropy_to_bip39_words(hmac, 16, 12, words12)) {
    secure_memzero(hmac, sizeof(hmac));
    secure_memzero(&master, sizeof(master));
    return fail("mnem12 build");
  }
  secure_memzero(hmac, sizeof(hmac));
  static const char* kMnem12[12] = {
    "girl", "mad", "pet", "galaxy", "egg", "matter",
    "matrix", "prison", "refuse", "sense", "ordinary", "nose"
  };
  for (int i = 0; i < 12; i++) {
    if (strcmp(words12[i], kMnem12[i]) != 0) {
      secure_memzero(words12, sizeof(words12));
      secure_memzero(&master, sizeof(master));
      return fail("mnem12");
    }
  }
  secure_memzero(words12, sizeof(words12));

  if (!bip32_node_from_xprv58(kXprv, &master)) return fail("xprv2");
  const uint32_t path24[5] = { 83696968u, 39u, 0u, 24u, 0u };
  if (!bip85_entropy_from_master_node(&master, path24, 5, hmac)) {
    secure_memzero(&master, sizeof(master));
    return fail("path24");
  }
  secure_memzero(&master, sizeof(master));
  static const uint8_t kEnt24[32] = {
    0xae, 0x13, 0x1e, 0x23, 0x12, 0xcd, 0xc6, 0x13, 0x31, 0x54, 0x2e, 0xfe, 0x0d, 0x10, 0x77, 0xba,
    0xc5, 0xea, 0x80, 0x3a, 0xdf, 0x24, 0xb3, 0x13, 0xa4, 0xf0, 0xe4, 0x8e, 0x9c, 0x51, 0xf3, 0x7f
  };
  if (memcmp(hmac, kEnt24, 32) != 0) {
    secure_memzero(hmac, sizeof(hmac));
    return fail("ent24");
  }
  char words24[24][16];
  memset(words24, 0, sizeof(words24));
  if (!entropy_to_bip39_words(hmac, 32, 24, words24)) {
    secure_memzero(hmac, sizeof(hmac));
    return fail("mnem24 build");
  }
  secure_memzero(hmac, sizeof(hmac));
  static const char* kMnem24[24] = {
    "puppy", "ocean", "match", "cereal", "symbol", "another", "shed", "magic",
    "wrap", "hammer", "bulb", "intact", "gadget", "divorce", "twin", "tonight",
    "reason", "outdoor", "destroy", "simple", "truth", "cigar", "social", "volcano"
  };
  for (int i = 0; i < 24; i++) {
    if (strcmp(words24[i], kMnem24[i]) != 0) {
      secure_memzero(words24, sizeof(words24));
      return fail("mnem24");
    }
  }
  secure_memzero(words24, sizeof(words24));
  if (err && errLen) err[0] = 0;
  return true;
}

// m / purpose' / coin' / account' / chain — shared by all receive/change addresses on a page.
static bool derive_btc_node_to_chain(AddrType t, uint32_t account, uint32_t chain, Bip32Node* outNode) {
  if (!outNode) {
    addr_set_err("bad node");
    return false;
  }
  if (chain > 1) {
    addr_set_err("bad chain");
    return false;
  }
  if (!ensure_bip39_derived_seed_cached()) return false;
  uint8_t seed[64];
  memcpy(seed, g_bip39DerivedSeedCache, 64);
  if (!bip32_master_from_seed(seed, outNode)) {
    addr_set_err("master");
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  uint32_t purpose = (t == AddrType::P2PKH) ? 44 : (t == AddrType::P2SH_P2WPKH ? 49 : (t == AddrType::P2TR ? 86 : 84));
  if (!bip32_ckd_priv(outNode, purpose, true)) {
    addr_set_err("ckd purpose");
    return false;
  }
  if (!bip32_ckd_priv(outNode, 0, true)) {
    addr_set_err("ckd coin");
    return false;
  }
  if (!bip32_ckd_priv(outNode, account, true)) {
    addr_set_err("ckd account");
    return false;
  }
  if (!bip32_ckd_priv(outNode, chain, false)) {
    addr_set_err("ckd chain");
    return false;
  }
  return true;
}

static bool derive_kaspa_node_to_chain_for_purpose(uint32_t purpose, uint32_t account, uint32_t chain, Bip32Node* outNode) {
  if (!outNode) {
    addr_set_err("bad node");
    return false;
  }
  if (purpose != 44 && purpose != 45) {
    addr_set_err("bad purpose");
    return false;
  }
  if (chain > 1) {
    addr_set_err("bad chain");
    return false;
  }
  if (!ensure_bip39_derived_seed_cached()) return false;
  uint8_t seed[64];
  memcpy(seed, g_bip39DerivedSeedCache, 64);
  if (!bip32_master_from_seed(seed, outNode)) {
    addr_set_err("master");
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  if (!bip32_ckd_priv(outNode, purpose, true)) {
    addr_set_err("ckd purpose");
    return false;
  }
  if (!bip32_ckd_priv(outNode, KASPA_BIP44_COIN_TYPE, true)) {
    addr_set_err("ckd coin");
    return false;
  }
  if (!bip32_ckd_priv(outNode, account, true)) {
    addr_set_err("ckd account");
    return false;
  }
  if (!bip32_ckd_priv(outNode, chain, false)) {
    addr_set_err("ckd chain");
    return false;
  }
  return true;
}

static bool derive_kaspa_node_to_chain(uint32_t account, uint32_t chain, Bip32Node* outNode) {
  return derive_kaspa_node_to_chain_for_purpose(44, account, chain, outNode);
}

static bool derive_kaspa_node_for_index(uint32_t account, uint32_t chain, uint32_t index, Bip32Node* outNode) {
  if (!outNode || index > BTC_ADDR_MAX_INDEX) {
    addr_set_err("bad index");
    return false;
  }
  if (!derive_kaspa_node_to_chain(account, chain, outNode)) return false;
  if (!bip32_ckd_priv(outNode, index, false)) {
    addr_set_err("ckd index");
    secure_memzero(outNode, sizeof(Bip32Node));
    return false;
  }
  return true;
}

static bool derive_kaspa_multisig_node_for_index(uint32_t account, uint32_t chain, uint32_t index, Bip32Node* outNode) {
  if (!outNode || index > BTC_ADDR_MAX_INDEX) {
    addr_set_err("bad index");
    return false;
  }
  if (!derive_kaspa_node_to_chain_for_purpose(45, account, chain, outNode)) return false;
  if (!bip32_ckd_priv(outNode, index, false)) {
    addr_set_err("ckd index");
    secure_memzero(outNode, sizeof(Bip32Node));
    return false;
  }
  return true;
}

static bool kaspa_encode_address_from_leaf_node(Bip32Node* n, char* out, size_t outLen) {
  uint8_t pub[33];
  if (!secp_pubkey_compressed(n->k, pub)) {
    if (!g_addrLastErr[0]) addr_set_err("pubkey");
    return false;
  }
  bool ok = kaspa_encode_address_from_compressed_pubkey(pub, out, outLen);
  if (!ok && !g_addrLastErr[0]) addr_set_err("kaspa bech32");
  secure_memzero(pub, sizeof(pub));
  return ok;
}

static bool kaspa_address_for_index(uint32_t account, uint32_t chain, uint32_t index, char* out, size_t outLen) {
  addr_set_err("");
  Bip32Node n;
  memset(&n, 0, sizeof(n));
  if (!derive_kaspa_node_for_index(account, chain, index, &n)) {
    secure_memzero(&n, sizeof(n));
    return false;
  }
  bool ok = kaspa_encode_address_from_leaf_node(&n, out, outLen);
  secure_memzero(&n, sizeof(n));
  return ok;
}

extern "C" bool seedmask_wallet_derive_kaspa_priv(uint32_t account, uint32_t chain, uint32_t index, uint8_t priv32[32]) {
  if (!priv32 || chain > 1 || index > BTC_ADDR_MAX_INDEX) return false;
  if (!ensure_bip39_derived_seed_cached()) return false;
  Bip32Node n;
  memset(&n, 0, sizeof(n));
  if (!derive_kaspa_node_for_index(account, chain, index, &n)) {
    secure_memzero(&n, sizeof(n));
    return false;
  }
  memcpy(priv32, n.k, 32);
  secure_memzero(&n, sizeof(n));
  return true;
}

extern "C" bool seedmask_wallet_derive_kaspa_multisig_priv(uint32_t account, uint32_t chain, uint32_t index,
                                                           uint8_t priv32[32]) {
  if (!priv32 || chain > 1 || index > BTC_ADDR_MAX_INDEX) return false;
