static bool multisig_policy_text_looks_valid(const char* s) {
  if (!s || !s[0]) return false;
  // Passport/Sparrow multisig exports can arrive as different UR registry types.
  if (strncasecmp(s, "ur:", 3) == 0) return true;
  return strstr(s, "sortedmulti(") || strstr(s, "wsh(") || strstr(s, "sh(wsh(")
         || strstr(s, "\"descriptor\"") || strstr(s, "\"policy\"")
         || strstr(s, "\"cosigners\"") || strstr(s, "\"multisig_cosigners\"")
         || strstr(s, "xpub") || strstr(s, "Ypub") || strstr(s, "Zpub") || strstr(s, "kpub")
         || strstr(s, "kaspa-p2sh") || strstr(s, "ur:crypto-account/") || strstr(s, "UR:CRYPTO-ACCOUNT/");
}

static bool multisig_payload_is_kaspa_policy(const char* payload) {
  if (!payload) return false;
  return strstr(payload, "kpub") || strstr(payload, "\"coin\":\"kaspa\"") || strstr(payload, "\"coin\": \"kaspa\"")
         || strstr(payload, "kaspa-p2sh") || strstr(payload, "Kaspa");
}

static bool extract_json_string_field(const char* src, const char* key, char* out, size_t cap) {
  if (!src || !key || !out || cap == 0) return false;
  char pat[64];
  snprintf(pat, sizeof(pat), "\"%s\"", key);
  const char* p = strstr(src, pat);
  if (!p) return false;
  p = strchr(p + strlen(pat), ':');
  if (!p) return false;
  while (*p == ':' || *p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
  if (*p != '"') return false;
  p++;
  size_t n = 0;
  while (*p && *p != '"' && n + 1 < cap) out[n++] = *p++;
  out[n] = 0;
  return n > 0;
}

static void trim_ascii_in_place(char* s) {
  if (!s || !s[0]) return;
  size_t n = strlen(s);
  while (n > 0 && (unsigned char)s[n - 1] <= 0x20) s[--n] = 0;
  size_t i = 0;
  while (s[i] && (unsigned char)s[i] <= 0x20) i++;
  if (i > 0) memmove(s, s + i, strlen(s + i) + 1);
}

static bool starts_with_ci(const char* s, const char* pfx) {
  if (!s || !pfx) return false;
  while (*pfx) {
    if (!*s) return false;
    char a = (char)tolower((unsigned char)*s++);
    char b = (char)tolower((unsigned char)*pfx++);
    if (a != b) return false;
  }
  return true;
}

static bool looks_like_fp8(const char* s) {
  if (!s) return false;
  for (int i = 0; i < 8; i++) {
    char c = s[i];
    if (!c) return false;
    bool hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    if (!hex) return false;
  }
  return true;
}

static bool extract_json_string_field_in(const char* obj_start, const char* obj_end, const char* key, char* out,
                                         size_t cap) {
  if (!obj_start || !obj_end || obj_end <= obj_start || !key || !out || cap == 0) return false;
  char pat[64];
  snprintf(pat, sizeof(pat), "\"%s\"", key);
  const char* p = obj_start;
  while (p < obj_end && (p = (const char*)memchr(p, '"', (size_t)(obj_end - p))) != nullptr) {
    if ((size_t)(obj_end - p) >= strlen(pat) && strncmp(p, pat, strlen(pat)) == 0) {
      p += strlen(pat);
      while (p < obj_end && (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')) p++;
      if (p >= obj_end || *p != ':') return false;
      p++;
      while (p < obj_end && (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')) p++;
      if (p >= obj_end || *p != '"') return false;
      p++;
      size_t n = 0;
      while (p < obj_end && *p != '"' && n + 1 < cap) out[n++] = *p++;
      out[n] = 0;
      return n > 0;
    }
    p++;
  }
  return false;
}

static void multisig_normalize_fp8(char* fp, size_t cap) {
  if (!fp || cap < 9) return;
  trim_ascii_in_place(fp);
  if (!looks_like_fp8(fp)) {
    fp[0] = 0;
    return;
  }
  for (int i = 0; i < 8; i++) fp[i] = (char)toupper((unsigned char)fp[i]);
  fp[8] = 0;
}

/** Parse SeedMask / coordinator Kaspa policy JSON: cosigners[{fingerprint, derivation, kpub}]. */
static void multisig_parse_cosigners_from_json(const char* src) {
  if (!src) return;
  static const char* array_keys[] = { "cosigners", "multisig_cosigners" };
  const char* arr = nullptr;
  for (size_t ki = 0; ki < sizeof(array_keys) / sizeof(array_keys[0]); ki++) {
    char pat[40];
    snprintf(pat, sizeof(pat), "\"%s\"", array_keys[ki]);
    const char* p = strstr(src, pat);
    if (!p) continue;
    arr = strchr(p + strlen(pat), '[');
    if (arr) break;
  }
  if (!arr) return;

  const char* p = arr + 1;
  while (g_multisigReviewCosigners < MULTISIG_MAX_COSIGNERS) {
    p = strchr(p, '{');
    if (!p) break;
    const char* obj_end = nullptr;
    int depth = 0;
    for (const char* q = p; *q; q++) {
      if (*q == '{') depth++;
      else if (*q == '}') {
        depth--;
        if (depth == 0) {
          obj_end = q + 1;
          break;
        }
      }
    }
    if (!obj_end) break;

    uint8_t i = g_multisigReviewCosigners;
    char fp[16] = { 0 };
    char deriv[MULTISIG_REVIEW_DERIV_BYTES] = { 0 };
    char xpub[MULTISIG_REVIEW_XPUB_BYTES] = { 0 };
    if (extract_json_string_field_in(p, obj_end, "fingerprint", fp, sizeof(fp))) {
      multisig_normalize_fp8(fp, sizeof(fp));
      if (fp[0]) snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%s", fp);
      else snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%s", "?");
    } else {
      snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%s", "?");
    }
    if (extract_json_string_field_in(p, obj_end, "derivation", deriv, sizeof(deriv))) {
      trim_ascii_in_place(deriv);
      snprintf(g_multisigReviewDerivs[i], sizeof(g_multisigReviewDerivs[i]), "%s", deriv);
    } else if (g_multisigReviewDeriv[0]) {
      snprintf(g_multisigReviewDerivs[i], sizeof(g_multisigReviewDerivs[i]), "%s", g_multisigReviewDeriv);
    } else {
      snprintf(g_multisigReviewDerivs[i], sizeof(g_multisigReviewDerivs[i]), "%s", "Unknown");
    }
    if (extract_json_string_field_in(p, obj_end, "kpub", xpub, sizeof(xpub))
        || extract_json_string_field_in(p, obj_end, "xpub", xpub, sizeof(xpub))) {
      trim_ascii_in_place(xpub);
      snprintf(g_multisigReviewXpub[i], sizeof(g_multisigReviewXpub[i]), "%s", xpub);
      g_multisigReviewCosigners++;
    }
    p = obj_end;
    if (*p == ']') break;
  }
}

static bool multisig_fp8_hex_eq_ci(const char* a, const char* b) {
  if (!a || !b) return false;
  if (!looks_like_fp8(a) || !looks_like_fp8(b)) return false;
  for (int i = 0; i < 8; i++) {
    char ca = (char)tolower((unsigned char)a[i]);
    char cb = (char)tolower((unsigned char)b[i]);
    if (ca != cb) return false;
  }
  return true;
}

static bool multisig_parse_deriv_to_type_account(const char* inDeriv, AddrType* outType, uint32_t* outAccount) {
  if (!inDeriv || !outType || !outAccount) return false;
  char d[64];
  size_t n = 0;
  for (size_t i = 0; inDeriv[i] && n + 1 < sizeof(d); i++) {
    char c = inDeriv[i];
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') continue;
    if (c == 'h' || c == 'H') c = '\'';
    d[n++] = c;
  }
  d[n] = 0;
  unsigned coin = 0, acct = 0, script = 0;
  if (sscanf(d, "m/48'/%u'/%u'/%u'", &coin, &acct, &script) == 3) {
    if (script == 2u) *outType = AddrType::P2WPKH;
    else if (script == 1u) *outType = AddrType::P2SH_P2WPKH;
    else return false;
    *outAccount = (uint32_t)acct;
    return true;
  }
  if (sscanf(d, "m/45'/111111'/%u'", &acct) == 1 || sscanf(d, "45'/111111'/%u'", &acct) == 1
      || sscanf(d, "m/45'/%u", &acct) == 1) {
    *outType = AddrType::P2PKH;
    *outAccount = (uint32_t)acct;
    return true;
  }
  return false;
}

// Sparrow / coordinators may export xpub (0x0488…) while we serialize Zpub/Ypub for the same key.
// Compare decoded chain code + pubkey (BIP32 bytes 13–44 and 45–77), not the Base58 string alone.
static bool multisig_imported_xpub_key_matches_derived(const char* imported, AddrType t, uint32_t account) {
  if (!imported || !imported[0]) return false;
  uint8_t dec[78];
  if (!base58check_decode_payload(imported, dec, 78)) return false;
  uint8_t ichain[32];
  uint8_t ipub[33];
  memcpy(ichain, dec + 13, 32);
  memcpy(ipub, dec + 45, 33);
  secure_memzero(dec, sizeof(dec));
  Bip32Node n;
  uint8_t parentFp[4];
  if (!btc_multisig_derive_cosigner_node(t, account, &n, parentFp)) return false;
  (void)parentFp;
  uint8_t lpub[33];
  if (!secp_pubkey_compressed(n.k, lpub)) {
    secure_memzero(&n, sizeof(n));
    return false;
  }
  bool ok = memcmp(ichain, n.c, 32) == 0 && memcmp(ipub, lpub, 33) == 0;
  secure_memzero(&n, sizeof(n));
  return ok;
}

static bool multisig_xpub_matches_local_cosigner(uint8_t i) {
  if (i >= g_multisigReviewCosigners) return false;
  if (!g_multisigReviewXpub[i][0]) return false;
  AddrType pref = AddrType::P2WPKH;
  uint32_t account = 0;
  if (!multisig_parse_deriv_to_type_account(g_multisigReviewDerivs[i], &pref, &account)) return false;
  AddrType tries[3] = { pref, AddrType::P2WPKH, AddrType::P2SH_P2WPKH };
  if (pref == AddrType::P2PKH) {
    tries[0] = AddrType::P2PKH;
    tries[1] = AddrType::P2WPKH;
    tries[2] = AddrType::P2SH_P2WPKH;
  } else {
    tries[2] = AddrType::P2PKH;
  }
  char local[160];
  for (uint8_t t = 0; t < 3; t++) {
    memset(local, 0, sizeof(local));
    if (!btc_multisig_xpub(tries[t], account, local, sizeof(local))) continue;
    if (strcmp(local, g_multisigReviewXpub[i]) == 0) return true;
    if (multisig_imported_xpub_key_matches_derived(g_multisigReviewXpub[i], tries[t], account)) return true;
  }
  return false;
}

static bool multisig_kpub_matches_local_cosigner(uint8_t i) {
  if (i >= g_multisigReviewCosigners) return false;
  if (!g_multisigReviewXpub[i][0]) return false;
  uint32_t account = g_addrAccount;
  AddrType parsedType = AddrType::P2PKH;
  uint32_t parsedAccount = 0;
  if (multisig_parse_deriv_to_type_account(g_multisigReviewDerivs[i], &parsedType, &parsedAccount)
      && parsedType == AddrType::P2PKH) {
    account = parsedAccount;
  }
  char local[120];
  if (!kaspa_multisig_account_kpub(account, local, sizeof(local))) return false;
  bool ok = (strcmp(local, g_multisigReviewXpub[i]) == 0);
  secure_memzero(local, sizeof(local));
  return ok;
}

static bool multisig_review_is_kaspa_policy(void) {
  if (strstr(g_multisigReviewAddrType, "kaspa") || strstr(g_multisigReviewPolicy, "kaspa")) return true;
  for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
    if (strncmp(g_multisigReviewXpub[i], "kpub", 4) == 0) return true;
  }
  return false;
}

// Multisig policy must list this device as a cosigner. If a row has this device's master
// fingerprint (8 hex), we also require the xpub on that row to match what we derive — same idea
// as Passport: fingerprint picks the leg; the key material must match (not fingerprint alone).
static bool multisig_import_policy_matches_device_fingerprint_ex(bool quiet) {
  if (multisig_review_is_kaspa_policy()) {
    for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
      if (multisig_kpub_matches_local_cosigner(i)) return true;
    }
    if (!quiet) setMsg("No matching kpub for this device");
    return false;
  }
  char dev[9] = { 0 };
  if (!current_master_xfp(dev)) {
    if (!quiet) setMsg("Fingerprint unavailable (unlock vault)");
    return false;
  }
  if (g_multisigReviewCosigners == 0) {
    if (!quiet) setMsg("No cosigners in policy");
    secure_memzero(dev, sizeof(dev));
    return false;
  }
  bool anyValidFp = false;
  for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
    const char* fp = g_multisigReviewFp[i];
    if (!looks_like_fp8(fp)) continue;
    anyValidFp = true;
    if (!multisig_fp8_hex_eq_ci(fp, dev)) continue;
    if (!g_multisigReviewXpub[i][0]) {
      if (!quiet) setMsg("Missing xpub for your cosigner; cannot verify");
      secure_memzero(dev, sizeof(dev));
      return false;
    }
    if (!multisig_xpub_matches_local_cosigner(i)) {
      if (!quiet) setMsg("Cosigner xpub does not match this device");
      secure_memzero(dev, sizeof(dev));
      return false;
    }
    secure_memzero(dev, sizeof(dev));
    return true;
  }
  for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
    if (multisig_xpub_matches_local_cosigner(i)) {
      secure_memzero(dev, sizeof(dev));
      return true;
    }
  }
  secure_memzero(dev, sizeof(dev));
  if (!quiet) {
    if (!anyValidFp)
      setMsg("No matching cosigner for this device");
    else
      setMsg("This wallet is not for this device");
  }
  return false;
}
static bool multisig_import_policy_matches_device_fingerprint() {
  return multisig_import_policy_matches_device_fingerprint_ex(false);
}

static const char* multisig_find_extpub_token(const char* s);

static bool parse_passport_multisig_text(const char* payload) {
  if (!payload || !payload[0]) return false;
  bool any = false;
  char work[MULTISIG_WALLET_PAYLOAD_BYTES];
  snprintf(work, sizeof(work), "%s", payload);
  char pendingFp[12] = { 0 };

  for (char* line = strtok(work, "\n"); line; line = strtok(nullptr, "\n")) {
    char l[256];
    snprintf(l, sizeof(l), "%s", line);
    trim_ascii_in_place(l);
    if (!l[0] || l[0] == '#') continue;

    if (starts_with_ci(l, "name:")) {
      snprintf(g_multisigReviewName, sizeof(g_multisigReviewName), "%s", l + 5);
      trim_ascii_in_place(g_multisigReviewName);
      any = true;
      continue;
    }
    if (starts_with_ci(l, "policy:")) {
      snprintf(g_multisigReviewPolicy, sizeof(g_multisigReviewPolicy), "%s", l + 7);
      trim_ascii_in_place(g_multisigReviewPolicy);
      // Normalize "2 of 3" => "2of3".
      char norm[sizeof(g_multisigReviewPolicy)] = { 0 };
      size_t ni = 0;
      for (size_t i = 0; g_multisigReviewPolicy[i] && ni + 1 < sizeof(norm); i++) {
        char c = g_multisigReviewPolicy[i];
        if (c != ' ' && c != '\t') norm[ni++] = c;
      }
      norm[ni] = 0;
      snprintf(g_multisigReviewPolicy, sizeof(g_multisigReviewPolicy), "%s", norm);
      any = true;
      continue;
    }
    if (starts_with_ci(l, "format:")) {
      snprintf(g_multisigReviewAddrType, sizeof(g_multisigReviewAddrType), "%s", l + 7);
      trim_ascii_in_place(g_multisigReviewAddrType);
      any = true;
      continue;
    }
    if (starts_with_ci(l, "derivation:")) {
      snprintf(g_multisigReviewDeriv, sizeof(g_multisigReviewDeriv), "%s", l + 11);
      trim_ascii_in_place(g_multisigReviewDeriv);
      any = true;
      continue;
    }
    if (starts_with_ci(l, "xfp:")) {
      char t[32];
      snprintf(t, sizeof(t), "%s", l + 4);
      trim_ascii_in_place(t);
      if (looks_like_fp8(t)) snprintf(pendingFp, sizeof(pendingFp), "%.8s", t);
      continue;
    }

    const char* xp = multisig_find_extpub_token(l);
    if (xp && g_multisigReviewCosigners < MULTISIG_MAX_COSIGNERS) {
      uint8_t i = g_multisigReviewCosigners;
      // Fingerprint: either pending xfp or "FP: xxxxxxxx" prefix.
      const char* colon = strchr(l, ':');
      if (colon && looks_like_fp8(l)) {
        snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%.8s", l);
      } else if (pendingFp[0]) {
        snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%s", pendingFp);
      } else {
        snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%s", "?");
      }
      pendingFp[0] = 0;
      snprintf(g_multisigReviewDerivs[i], sizeof(g_multisigReviewDerivs[i]), "%s",
               g_multisigReviewDeriv[0] ? g_multisigReviewDeriv : "Unknown");
      size_t xn = 0;
      while (xp[xn] && xp[xn] != ' ' && xp[xn] != '\t' && xp[xn] != '\r' && xp[xn] != '"' && xp[xn] != ','
             && xn + 1 < sizeof(g_multisigReviewXpub[i])) xn++;
      memcpy(g_multisigReviewXpub[i], xp, xn);
      g_multisigReviewXpub[i][xn] = 0;
      g_multisigReviewCosigners++;
      any = true;
      continue;
    }
  }
  return any;
}

static void multisig_review_reset() {
  memset(g_multisigReviewName, 0, sizeof(g_multisigReviewName));
  memset(g_multisigReviewPolicy, 0, sizeof(g_multisigReviewPolicy));
  memset(g_multisigReviewAddrType, 0, sizeof(g_multisigReviewAddrType));
  memset(g_multisigReviewDeriv, 0, sizeof(g_multisigReviewDeriv));
  memset(g_multisigReviewFp, 0, (size_t)MULTISIG_MAX_COSIGNERS * MULTISIG_REVIEW_FP_BYTES);
  memset(g_multisigReviewDerivs, 0, (size_t)MULTISIG_MAX_COSIGNERS * MULTISIG_REVIEW_DERIV_BYTES);
  memset(g_multisigReviewXpub, 0, (size_t)MULTISIG_MAX_COSIGNERS * MULTISIG_REVIEW_XPUB_BYTES);
  g_multisigReviewCosigners = 0;
  g_multisigReviewCosignerIdx = 0;
  g_multisigReviewScrollY = 0;
  g_multisigReviewDragging = false;
  g_multisigReviewDragLastY = 0;
}

static void multisig_infer_addr_type_from_policy(const char* p, char* out, size_t outCap) {
  if (!out || outCap == 0) return;
  out[0] = 0;
  if (!p) return;
  if (strstr(p, "sh(wsh(")) snprintf(out, outCap, "P2SH-P2WSH");
  else if (strstr(p, "wsh(")) snprintf(out, outCap, "P2WSH");
  else if (strstr(p, "sh(")) snprintf(out, outCap, "P2SH");
  else snprintf(out, outCap, "Unknown");
}

static bool multisig_streq_ci(const char* a, const char* b) {
  if (!a || !b) return false;
  for (; *a && *b; a++, b++) {
    if (tolower((unsigned char)*a) != tolower((unsigned char)*b)) return false;
  }
  return *a == *b;
}

static const char* multisig_find_extpub_token(const char* s) {
  if (!s) return nullptr;
  const char* best = nullptr;
  const char* prefixes[] = { "xpub", "ypub", "zpub", "Ypub", "Zpub", "kpub" };
  for (size_t pi = 0; pi < sizeof(prefixes) / sizeof(prefixes[0]); pi++) {
    const char* p = s;
    while ((p = strstr(p, prefixes[pi])) != nullptr) {
      // Avoid matching JSON field names like "kpub": before the actual key value.
      if (isalnum((unsigned char)p[4])) {
        if (!best || p < best) best = p;
        break;
      }
      p += 4;
    }
  }
  return best;
}

static bool multisig_addr_type_is_usable(const char* t) {
  if (!t || !t[0]) return false;
  return !multisig_streq_ci(t, "Unknown");
}

static void multisig_parse_cosigners_from_text(const char* src) {
  if (!src) return;
  const char* p = src;
  while (*p && g_multisigReviewCosigners < MULTISIG_MAX_COSIGNERS) {
    const char* lb = strchr(p, '[');
    if (!lb) break;
    const char* rb = strchr(lb + 1, ']');
    if (!rb) break;
    const char* xp = multisig_find_extpub_token(rb + 1);
    if (!xp || xp - rb > 180) {
      p = rb + 1;
      continue;
    }
    uint8_t i = g_multisigReviewCosigners;
    // [fpr/path]
    char inside[80] = { 0 };
    size_t ilen = (size_t)(rb - (lb + 1));
    if (ilen >= sizeof(inside)) ilen = sizeof(inside) - 1;
    memcpy(inside, lb + 1, ilen);
    inside[ilen] = 0;
    char* slash = strchr(inside, '/');
    if (slash) {
      char saved = *slash;
      *slash = 0;
      // [xfp/path] — first segment must be 8 hex chars. Otherwise treat full bracket as path only
      // (e.g. [48'/0'/2'/2'] must become m/48'/0'/2'/2', not m/0'/2'/2').
      if (looks_like_fp8(inside)) {
        snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%s", inside);
        *slash = saved;
        snprintf(g_multisigReviewDerivs[i], sizeof(g_multisigReviewDerivs[i]), "m/%s", slash + 1);
      } else {
        *slash = saved;
        snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%s", "?");
        snprintf(g_multisigReviewDerivs[i], sizeof(g_multisigReviewDerivs[i]), "m/%s", inside);
      }
    } else {
      snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%s", inside);
      snprintf(g_multisigReviewDerivs[i], sizeof(g_multisigReviewDerivs[i]), "%s", "m/?");
    }
    size_t xn = 0;
    while (xp[xn] && xp[xn] != ',' && xp[xn] != ')' && xp[xn] != '"' && !isspace((unsigned char)xp[xn])
           && xn + 1 < sizeof(g_multisigReviewXpub[i])) xn++;
    memcpy(g_multisigReviewXpub[i], xp, xn);
    g_multisigReviewXpub[i][xn] = 0;
    g_multisigReviewCosigners++;
    p = rb + 1;
  }
  // Fallback for JSON payloads that list xpub fields without [fpr/path] descriptors.
  p = src;
  while (*p && g_multisigReviewCosigners < MULTISIG_MAX_COSIGNERS) {
    const char* xp = multisig_find_extpub_token(p);
    if (!xp) break;
    bool dup = false;
    for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
      if (strncmp(g_multisigReviewXpub[i], xp, 8) == 0) {
        dup = true;
        break;
      }
    }
    if (!dup) {
      uint8_t i = g_multisigReviewCosigners;
      snprintf(g_multisigReviewFp[i], sizeof(g_multisigReviewFp[i]), "%s", "?");
      snprintf(g_multisigReviewDerivs[i], sizeof(g_multisigReviewDerivs[i]), "%s", "Unknown");
      size_t xn = 0;
      while (xp[xn] && xp[xn] != ',' && xp[xn] != ')' && xp[xn] != '"' && !isspace((unsigned char)xp[xn])
             && xn + 1 < sizeof(g_multisigReviewXpub[i])) xn++;
      memcpy(g_multisigReviewXpub[i], xp, xn);
      g_multisigReviewXpub[i][xn] = 0;
      g_multisigReviewCosigners++;
    }
    p = xp + 4;
  }
}

static bool multisig_fill_review_from_payload(const char* payload) {
  if (!multisig_policy_text_looks_valid(payload)) return false;
  multisig_review_reset();
  // Coordinator JSON lists fingerprint + derivation on separate lines from kpub; parse that first.
  if (strstr(payload, "\"cosigners\"") != nullptr || strstr(payload, "\"multisig_cosigners\"") != nullptr) {
    multisig_parse_cosigners_from_json(payload);
  }
  bool parsed = g_multisigReviewCosigners > 0;
  if (!parsed) parsed = parse_passport_multisig_text(payload);
  if (!g_multisigReviewName[0] && !extract_json_string_field(payload, "name", g_multisigReviewName, sizeof(g_multisigReviewName))) {
    snprintf(g_multisigReviewName, sizeof(g_multisigReviewName), "Imported multisig");
  }
  if (!g_multisigReviewPolicy[0]) {
    if (!extract_json_string_field(payload, "policy", g_multisigReviewPolicy, sizeof(g_multisigReviewPolicy))
        && !extract_json_string_field(payload, "descriptor", g_multisigReviewPolicy, sizeof(g_multisigReviewPolicy))) {
      snprintf(g_multisigReviewPolicy, sizeof(g_multisigReviewPolicy), "Unknown");
    }
  }
  // JSON often splits human "policy" from miniscript "descriptor"; infer type from descriptor / format / full blob.
  if (!g_multisigReviewAddrType[0]) {
    (void)extract_json_string_field(payload, "format", g_multisigReviewAddrType, sizeof(g_multisigReviewAddrType));
  }
  if (!multisig_addr_type_is_usable(g_multisigReviewAddrType)) {
    multisig_infer_addr_type_from_policy(g_multisigReviewPolicy, g_multisigReviewAddrType, sizeof(g_multisigReviewAddrType));
  }
  {
    char descBuf[512] = { 0 };
    if (extract_json_string_field(payload, "descriptor", descBuf, sizeof(descBuf))) {
      if (!multisig_addr_type_is_usable(g_multisigReviewAddrType))
        multisig_infer_addr_type_from_policy(descBuf, g_multisigReviewAddrType, sizeof(g_multisigReviewAddrType));
    }
  }
  if (!multisig_addr_type_is_usable(g_multisigReviewAddrType))
    multisig_infer_addr_type_from_policy(payload, g_multisigReviewAddrType, sizeof(g_multisigReviewAddrType));
  if (!g_multisigReviewDeriv[0]) {
    (void)extract_json_string_field(payload, "derivation", g_multisigReviewDeriv, sizeof(g_multisigReviewDeriv));
  }
  if (!g_multisigReviewDeriv[0]) snprintf(g_multisigReviewDeriv, sizeof(g_multisigReviewDeriv), "Unknown");
  if (g_multisigReviewDeriv[0] && strcmp(g_multisigReviewDeriv, "Unknown") != 0) {
    for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
      if (!g_multisigReviewDerivs[i][0] || strcmp(g_multisigReviewDerivs[i], "Unknown") == 0
          || strcmp(g_multisigReviewDerivs[i], "m/?") == 0) {
        snprintf(g_multisigReviewDerivs[i], sizeof(g_multisigReviewDerivs[i]), "%s", g_multisigReviewDeriv);
      }
    }
  }
  if (g_multisigReviewCosigners == 0) multisig_parse_cosigners_from_text(payload);
  if (!parsed && g_multisigReviewCosigners == 0) return false;
  return true;
}

struct MultisigReviewSnap {
  char name[64];
  char policy[320];
  char addrType[40];
  char deriv[64];
  uint8_t cos;
  char fp[MULTISIG_MAX_COSIGNERS][MULTISIG_REVIEW_FP_BYTES];
  char derivs[MULTISIG_MAX_COSIGNERS][MULTISIG_REVIEW_DERIV_BYTES];
  char xpub[MULTISIG_MAX_COSIGNERS][MULTISIG_REVIEW_XPUB_BYTES];
};

static void multisig_review_snapshot(MultisigReviewSnap* s) {
  if (!s) return;
  memcpy(s->name, g_multisigReviewName, sizeof(s->name));
  memcpy(s->policy, g_multisigReviewPolicy, sizeof(s->policy));
  memcpy(s->addrType, g_multisigReviewAddrType, sizeof(s->addrType));
  memcpy(s->deriv, g_multisigReviewDeriv, sizeof(s->deriv));
  s->cos = g_multisigReviewCosigners;
  for (uint8_t i = 0; i < MULTISIG_MAX_COSIGNERS; i++) {
    memcpy(s->fp[i], g_multisigReviewFp[i], sizeof(s->fp[i]));
    memcpy(s->derivs[i], g_multisigReviewDerivs[i], sizeof(s->derivs[i]));
    memcpy(s->xpub[i], g_multisigReviewXpub[i], sizeof(s->xpub[i]));
  }
}

static void multisig_review_restore(const MultisigReviewSnap* s) {
  if (!s) return;
  memcpy(g_multisigReviewName, s->name, sizeof(g_multisigReviewName));
  memcpy(g_multisigReviewPolicy, s->policy, sizeof(g_multisigReviewPolicy));
  memcpy(g_multisigReviewAddrType, s->addrType, sizeof(g_multisigReviewAddrType));
  memcpy(g_multisigReviewDeriv, s->deriv, sizeof(g_multisigReviewDeriv));
  g_multisigReviewCosigners = s->cos;
  for (uint8_t i = 0; i < MULTISIG_MAX_COSIGNERS; i++) {
    memcpy(g_multisigReviewFp[i], s->fp[i], sizeof(g_multisigReviewFp[i]));
    memcpy(g_multisigReviewDerivs[i], s->derivs[i], sizeof(g_multisigReviewDerivs[i]));
    memcpy(g_multisigReviewXpub[i], s->xpub[i], sizeof(g_multisigReviewXpub[i]));
  }
}

static int multisig_cmp_pubkey33(const void* a, const void* b) {
  return memcmp(a, b, 33);
}

static bool multisig_parse_m_threshold(const char* pol, uint8_t* m) {
  if (!pol || !m) return false;
  char norm[384];
  size_t ni = 0;
  for (size_t i = 0; pol[i] && ni + 1 < sizeof(norm); i++) {
    char c = pol[i];
    if (c != ' ' && c != '\t' && c != '\r' && c != '\n') norm[ni++] = c;
  }
  norm[ni] = 0;
  unsigned M = 0, N = 0;
  if (sscanf(norm, "%uof%u", &M, &N) == 2 && M >= 1 && M <= 15 && N >= M && N <= 15) {
    *m = (uint8_t)M;
    return true;
  }
  const char* sm = strstr(norm, "sortedmulti(");
  if (sm) {
    sm += 12;
    char* end = nullptr;
    unsigned long v = strtoul(sm, &end, 10);
    if (end != sm && v >= 1 && v <= 15) {
      *m = (uint8_t)v;
      return true;
    }
  }
  return false;
}

static bool multisig_xpub_leaf_pubkey(const char* xpub58, uint32_t chain, uint32_t index, uint8_t out33[33]) {
  if (!xpub58 || !xpub58[0] || !out33) return false;
  uint8_t dec[78];
  if (!base58check_decode_payload(xpub58, dec, 78)) return false;
  if (dec[45] != 0x02 && dec[45] != 0x03) {
    secure_memzero(dec, sizeof(dec));
    return false;
  }
  uint8_t K[33], c[32];
  memcpy(K, dec + 45, 33);
  memcpy(c, dec + 13, 32);
  secure_memzero(dec, sizeof(dec));
  uint8_t K1[33], c1[32];
  if (!bip32_ckd_pub(K, c, chain, K1, c1)) {
    secure_memzero(K, sizeof(K));
    secure_memzero(c, sizeof(c));
    return false;
  }
  bool ok = bip32_ckd_pub(K1, c1, index, out33, c);
  secure_memzero(K, sizeof(K));
  secure_memzero(c, sizeof(c));
  secure_memzero(K1, sizeof(K1));
  secure_memzero(c1, sizeof(c1));
  return ok;
}

// First receive (chain/index) deposit address for imported multisig (sortedmulti P2WSH or P2SH-P2WSH).
// bech32HrpOpt: NULL or "" => mainnet "bc"; use "tb" for testnet native segwit. Affects bech32 P2WSH and P2SH version byte.
static bool multisig_wallet_deposit_address(const char* payload, uint32_t chain, uint32_t index, char* out, size_t outLen,
                                            const char* bech32HrpOpt) {
  if (!payload || !out || outLen < 16) return false;
  out[0] = 0;
  const char* segwitHrp = (bech32HrpOpt && bech32HrpOpt[0]) ? bech32HrpOpt : "bc";
  const bool wantTestnet = (segwitHrp[0] == 't' && segwitHrp[1] == 'b' && segwitHrp[2] == 0);
  MultisigReviewSnap snap;
  multisig_review_snapshot(&snap);
  if (!multisig_fill_review_from_payload(payload)) {
    multisig_review_restore(&snap);
    addr_set_err("policy parse");
    return false;
  }
  uint8_t mThresh = 0;
  if (!multisig_parse_m_threshold(g_multisigReviewPolicy, &mThresh)
      && !multisig_parse_m_threshold(payload, &mThresh)) {
    multisig_review_restore(&snap);
    addr_set_err("quorum");
    return false;
  }
  uint8_t nPub = g_multisigReviewCosigners;
  if (nPub < 2 || mThresh > nPub) {
    multisig_review_restore(&snap);
    addr_set_err("cosigners");
    return false;
  }
  if (multisig_review_is_kaspa_policy()) {
    uint8_t pubs[MULTISIG_MAX_COSIGNERS][33];
    for (uint8_t i = 0; i < nPub; i++) {
      if (!multisig_xpub_leaf_pubkey(g_multisigReviewXpub[i], chain, index, pubs[i])) {
        multisig_review_restore(&snap);
        addr_set_err("kpub derive");
        return false;
      }
    }
    qsort(pubs, nPub, 33, multisig_cmp_pubkey33);

    uint8_t redeem[384];
    size_t rl = 0;
    redeem[rl++] = (uint8_t)(0x50u + mThresh);
    for (uint8_t i = 0; i < nPub; i++) {
      redeem[rl++] = 32;
      memcpy(redeem + rl, pubs[i] + 1, 32);
      rl += 32;
    }
    redeem[rl++] = (uint8_t)(0x50u + nPub);
    redeem[rl++] = 0xae;
    if (rl > sizeof(redeem)) {
      multisig_review_restore(&snap);
      addr_set_err("script");
      return false;
    }
    uint8_t scriptHash[32];
    kaspa_blake2b_256(redeem, rl, scriptHash);
    bool ok = kaspa_encode_p2sh_address_mainnet(scriptHash, out, outLen);
    secure_memzero(redeem, sizeof(redeem));
    secure_memzero(scriptHash, sizeof(scriptHash));
    secure_memzero(pubs, sizeof(pubs));
    multisig_review_restore(&snap);
    if (!ok) addr_set_err("kaspa p2sh");
    return ok;
  }
  const char* pol = g_multisigReviewPolicy;
  const char* atp = g_multisigReviewAddrType;
  bool pol_sh_wsh = strstr(pol, "sh(wsh(") != NULL;
  bool pol_wsh = strstr(pol, "wsh(") != NULL;
  bool lbl_sh_p2wsh = multisig_streq_ci(atp, "P2SH-P2WSH");
  bool lbl_p2wsh = multisig_streq_ci(atp, "P2WSH");
  bool nestedShWsh = pol_sh_wsh || lbl_sh_p2wsh;
  bool nativeWsh = !nestedShWsh && (pol_wsh || lbl_p2wsh);
  if (!nativeWsh && !nestedShWsh) {
    multisig_review_restore(&snap);
    addr_set_err("need P2WSH ms");
    return false;
  }

  uint8_t pubs[MULTISIG_MAX_COSIGNERS][33];
  for (uint8_t i = 0; i < nPub; i++) {
    if (!multisig_xpub_leaf_pubkey(g_multisigReviewXpub[i], chain, index, pubs[i])) {
      multisig_review_restore(&snap);
      addr_set_err("xpub derive");
      return false;
    }
  }
  qsort(pubs, nPub, 33, multisig_cmp_pubkey33);

  uint8_t script[384];
  size_t sl = 0;
  script[sl++] = (uint8_t)(0x50u + mThresh);
  for (uint8_t i = 0; i < nPub; i++) {
    script[sl++] = 33;
    memcpy(script + sl, pubs[i], 33);
    sl += 33;
  }
  script[sl++] = (uint8_t)(0x50u + nPub);
  script[sl++] = 0xae;
  if (sl > sizeof(script)) {
    multisig_review_restore(&snap);
    addr_set_err("script");
    return false;
  }

  uint8_t wprog[32];
  sha256_once(script, sl, wprog);
  bool ok = false;
  if (nativeWsh) {
    ok = bech32_encode_segwit(segwitHrp, 0, wprog, 32, out, outLen);
  } else {
    uint8_t nested[34];
    nested[0] = 0x00;
    nested[1] = 0x20;
    memcpy(nested + 2, wprog, 32);
    uint8_t h160[20];
    if (!hash160(nested, sizeof(nested), h160)) {
      multisig_review_restore(&snap);
      addr_set_err("hash160");
      return false;
    }
    uint8_t payload21[21];
    payload21[0] = wantTestnet ? (uint8_t)0xC4 : (uint8_t)0x05;
    memcpy(payload21 + 1, h160, 20);
    ok = base58check_encode(payload21, sizeof(payload21), out, outLen);
    secure_memzero(h160, sizeof(h160));
    secure_memzero(payload21, sizeof(payload21));
  }
  secure_memzero(script, sizeof(script));
  secure_memzero(wprog, sizeof(wprog));
  secure_memzero(pubs, sizeof(pubs));
  multisig_review_restore(&snap);
  if (!ok) addr_set_err("address enc");
  return ok;
}

static bool multisig_payload_matches_current_device(const char* payload) {
  if (!multisig_fill_review_from_payload(payload)) return false;
  return multisig_import_policy_matches_device_fingerprint_ex(true);
}

static bool kaspa_has_imported_multisig_policy_for_current_account(void) {
  uint32_t cur = MULTISIG_CTX_TAG_UNKNOWN;
  if (!current_master_xfp_u32(&cur)) return false;
  for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
    if (g_multisigWalletContextTag[i] != cur) continue;
    if (!multisig_payload_is_kaspa_policy(g_multisigWalletPayloads[i])) continue;
    uint32_t acct = g_multisigWalletBtcAccount[i];
    if (acct != MULTISIG_ACCOUNT_LEGACY_ANY && acct != g_addrAccount) continue;
    if (multisig_payload_matches_current_device(g_multisigWalletPayloads[i])) return true;
  }
  return false;
}

/** Name of first imported Kaspa multisig policy matching this account/device (empty if none). */
static bool kaspa_imported_multisig_policy_name(char* out, size_t outCap) {
  if (!out || outCap == 0) return false;
  out[0] = 0;
  uint32_t cur = MULTISIG_CTX_TAG_UNKNOWN;
  if (!current_master_xfp_u32(&cur) || !g_multisigWalletNames) return false;
  for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
    if (g_multisigWalletContextTag[i] != cur) continue;
    if (!multisig_payload_is_kaspa_policy(g_multisigWalletPayloads[i])) continue;
    uint32_t acct = g_multisigWalletBtcAccount[i];
    if (acct != MULTISIG_ACCOUNT_LEGACY_ANY && acct != g_addrAccount) continue;
    if (!multisig_payload_matches_current_device(g_multisigWalletPayloads[i])) continue;
    if (!g_multisigWalletNames[i][0]) continue;
    strncpy(out, g_multisigWalletNames[i], outCap - 1);
    out[outCap - 1] = 0;
    return true;
  }
  return false;
}

/** Name of first imported Bitcoin multisig policy matching this account/device. */
static bool btc_imported_multisig_policy_name(char* out, size_t outCap) {
  if (!out || outCap == 0) return false;
  out[0] = 0;
  uint32_t cur = MULTISIG_CTX_TAG_UNKNOWN;
  if (!current_master_xfp_u32(&cur) || !g_multisigWalletNames) return false;
  for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
    if (g_multisigWalletContextTag[i] != cur) continue;
    if (multisig_payload_is_kaspa_policy(g_multisigWalletPayloads[i])) continue;
    uint32_t acct = g_multisigWalletBtcAccount[i];
    if (acct != MULTISIG_ACCOUNT_LEGACY_ANY && acct != g_addrAccount) continue;
    if (!multisig_payload_matches_current_device(g_multisigWalletPayloads[i])) continue;
    if (!g_multisigWalletNames[i][0]) continue;
    strncpy(out, g_multisigWalletNames[i], outCap - 1);
    out[outCap - 1] = 0;
    return true;
  }
  return false;
}

/**
 * Compact multisig banner for Review transaction (Kaspa + Bitcoin).
 * Returns Y just below the badge (includes gap).
 * cosignerStatus: 1 = yes, 2 = no, 0 = unknown.
 */
static int16_t review_draw_multisig_badge(int16_t x, int16_t y, int16_t w, uint16_t accent,
                                          uint8_t m, uint8_t n, int8_t cosignerStatus,
                                          const char* policyName) {
  const bool hasPol = (policyName && policyName[0]);
  const int16_t h = hasPol ? 58 : 44;
  const uint16_t bg = blendRGB565(RGB565_BLACK, accent, 0.14f);
  const uint16_t border = blendRGB565(accent, RGB565_BLACK, 0.40f);
  if (g_cryptoTxReviewScrollLite) {
    gfx->fillRect(x, y, w, h, bg);
    gfx->drawRect(x, y, w, h, border);
  } else {
    gfx->fillRoundRect(x, y, w, h, 10, bg);
    gfx->drawRoundRect(x, y, w, h, 10, border);
  }

  char title[20];
  if (m > 0 && n > 0)
    snprintf(title, sizeof(title), "%u-of-%u", (unsigned)m, (unsigned)n);
  else
    snprintf(title, sizeof(title), "MSIG");

  // Top line: "2-of-3 MULTISIG" centered as a group
  const int gap = 8;
  const int titleW = (int)strlen(title) * 12;       // size 2
  const int msW = (int)strlen("MULTISIG") * 6;      // size 1
  const int topW = titleW + gap + msW;
  const int16_t topX = (int16_t)(x + (w - topW) / 2);
  gfx->setTextSize(2);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setCursor(topX, (int16_t)(y + 7));
  gfx->print(title);
  gfx->setTextSize(1);
  gfx->setTextColor(blendRGB565(accent, RGB565_WHITE, 0.25f));
  gfx->setCursor((int16_t)(topX + titleW + gap), (int16_t)(y + 11));
  gfx->print("MULTISIG");

  const char* cosLine = "Cosigner unchecked";
  uint16_t cosCol = RGB565_LIGHTGREY;
  if (cosignerStatus == 1) {
    cosLine = "You are a cosigner";
    cosCol = RGB565_GREEN;
  } else if (cosignerStatus == 2) {
    cosLine = "Not a cosigner";
    cosCol = RGB565_RED;
  }
  const int cosW = (int)strlen(cosLine) * 6;
  gfx->setTextSize(1);
  gfx->setTextColor(cosCol);
  gfx->setCursor((int16_t)(x + (w - cosW) / 2), (int16_t)(y + 28));
  gfx->print(cosLine);

  if (hasPol) {
    char pl[40];
    snprintf(pl, sizeof(pl), "Policy: %s", policyName);
    if (strlen(pl) > 36) {
      pl[33] = '.';
      pl[34] = '.';
      pl[35] = '.';
      pl[36] = 0;
    }
    const int polW = (int)strlen(pl) * 6;
    gfx->setTextColor(blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.35f));
    gfx->setCursor((int16_t)(x + (w - polW) / 2), (int16_t)(y + 42));
    gfx->print(pl);
  }
  return (int16_t)(y + h + 10);
}


/** Resolve legacy wallets missing msig_*_ctx (runs once after login; list rebuild is then O(n) uint32 compares). */
static void multisig_resolve_unknown_wallet_tags(void) {
  if (g_multisigWalletCount == 0) return;
  uint32_t cur = MULTISIG_CTX_TAG_UNKNOWN;
  if (!current_master_xfp_u32(&cur)) return;
  bool changed = false;
  for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
    if (g_multisigWalletContextTag[i] != MULTISIG_CTX_TAG_UNKNOWN) continue;
    if (multisig_payload_matches_current_device(g_multisigWalletPayloads[i])) {
      g_multisigWalletContextTag[i] = cur;
      changed = true;
    } else {
      g_multisigWalletContextTag[i] = MULTISIG_CTX_TAG_NOMATCH;
      changed = true;
    }
  }
  if (changed) multisig_save_all_prefs();
}
static void multisig_rebuild_visible_wallets() {
  if (!g_multisigVisibleListDirty) return;
  g_multisigVisibleListDirty = false;
  g_multisigVisibleCount = 0;
  uint32_t cur = MULTISIG_CTX_TAG_UNKNOWN;
  if (!current_master_xfp_u32(&cur)) return;
  for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
    if (g_multisigWalletContextTag[i] != cur) continue;
    if (multisig_payload_is_kaspa_policy(g_multisigWalletPayloads[i]) != crypto_home_asset_is_kaspa()) continue;
    uint32_t wac = g_multisigWalletBtcAccount[i];
    if (wac != MULTISIG_ACCOUNT_LEGACY_ANY && wac != g_addrAccount) continue;
    if (g_multisigVisibleCount < MULTISIG_MAX_STORED_WALLETS)
      g_multisigVisibleIdx[g_multisigVisibleCount++] = i;
  }
}

// Same logical text; ignore CR so CRLF vs LF exports still match. Base58/xpub case preserved.
static bool multisig_payload_equal_ignore_cr(const char* a, const char* b) {
  if (!a || !b) return false;
  for (;;) {
    while (*a == '\r') a++;
    while (*b == '\r') b++;
    if (*a != *b) return false;
    if (*a == 0) return true;
    a++;
    b++;
  }
}

static int multisig_payload_find_duplicate_stored_idx(const char* payload) {
  if (!payload || !payload[0] || !g_multisigWalletPayloads) return -1;
  for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
    if (multisig_payload_equal_ignore_cr(payload, g_multisigWalletPayloads[i])) return (int)i;
  }
  return -1;
}

