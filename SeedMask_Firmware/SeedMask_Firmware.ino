static void duress_cred_kind_set(DuressCredKind kind) {
  if (g_duressCredKind == kind) return;
  duress_all_types_clear_nvs();
  g_duressCredKind = kind;
  duress_cred_kind_save_prefs();
}

static bool duress_cred_kind_usable() {
  return g_duressCredKind != DuressCredKind::NONE;
}

static bool duress_type_cred_matches(const char* cred, bool isPin, DuressBehavior b) {
  if (!duress_cred_kind_usable()) return false;
  if (isPin && g_duressCredKind != DuressCredKind::PIN) return false;
  if (!isPin && g_duressCredKind != DuressCredKind::PASSWORD) return false;
  DuressTypeSlot* slot = duress_slot_for(b);
  if (!slot || !slot->active) return false;
  char buf[80];
  bool ok = isPin ? duress_type_pin_verify(slot, cred, buf, sizeof(buf))
                  : duress_type_pw_verify(slot, cred, buf, sizeof(buf));
  secure_memzero(buf, sizeof(buf));
  return ok;
}

/** Remove duress data that cannot be used with the current screen lock (PIN vs password). */
static void duress_clear_incompatible_with_screen_lock() {
  if (g_screenLockUsesPin && g_duressCredKind == DuressCredKind::PASSWORD)
    duress_credentials_clear_all();
  else if (!g_screenLockUsesPin && g_duressCredKind == DuressCredKind::PIN)
    duress_credentials_clear_all();
}

