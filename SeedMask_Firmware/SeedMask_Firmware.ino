static void handleCryptoToolsSignReviewTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    g_toolsSignAddress[0] = 0;
    g_toolsSignPathFromQr = false;
    g_toolsSignAddrType = AddrType::P2WPKH;
