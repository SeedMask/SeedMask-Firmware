// Draw at most LIST_DISPLAY_MAX_CHARS chars then "..." for list display.
static void printTruncated(const char* s) {
  int n = 0;
  while (n < LIST_DISPLAY_MAX_CHARS && s[n]) {
    gfx->print(s[n]);
    n++;
  }
  if (s[n]) gfx->print("...");
}

// Draw exactly LIST_DISPLAY_MAX_CHARS character positions (from string or space) so all list rows same width.
static void printTruncatedFixedWidth(const char* s) {
  size_t len = s ? strlen(s) : 0;
  bool taintedTail = false;
  for (int n = 0; n < LIST_DISPLAY_MAX_CHARS; n++) {
    char ch = ' ';
    if (!taintedTail && (size_t)n < len) {
      ch = s[n];
      // If preview hits any control/non-printable byte, treat that and all following
      // bytes as invalid tail and render spaces only.
      if ((unsigned char)ch < 32 || (unsigned char)ch > 126) {
        taintedTail = true;
        ch = ' ';
      }
    }
    gfx->print(ch);
  }
}

static void drawNotes() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Notes", true);

  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);

  // Align scroll to grid row start (2 columns).
  const int itemsPerPage = NOTE_GRID_VISIBLE_ROWS * NOTE_GRID_COLS;  // 6
  g_noteListScroll = gridAlignStart(g_noteListScroll, NOTE_GRID_COLS);
  if (g_noteListScroll > 0 && g_noteCount <= (uint8_t)itemsPerPage) g_noteListScroll = 0;
  if (g_noteCount > (uint8_t)itemsPerPage) {
    int maxStart = gridMaxStartIndex((int)g_noteCount, NOTE_GRID_COLS, NOTE_GRID_VISIBLE_ROWS);
    if ((int)g_noteListScroll > maxStart) g_noteListScroll = (uint8_t)maxStart;
  }

  for (int slot = 0; slot < itemsPerPage; slot++) {
    uint8_t i = (uint8_t)((int)g_noteListScroll + slot);
    if (i >= g_noteCount) break;
    Rect tile, cap;
    noteTileRectsForSlot(slot, tile, cap);

    // Tile background
    gfx->fillRoundRect(tile.x, tile.y, tile.w, tile.h, 10, UI_CARD);
    gfx->drawRoundRect(tile.x, tile.y, tile.w, tile.h, 10, UI_BORDER);

    // Body preview inside tile (multi-line-ish; simple character wrap by fixed columns)
    gfx->setTextColor(UI_TEXT);
    gfx->setTextSize(1);
    gfx->setCursor(tile.x + NOTE_TILE_PAD, tile.y + NOTE_TILE_PAD);
    const int approxCharW = 6;  // size=1 font
    const int approxCharH = 8;
    int charsPerLine = (tile.w - NOTE_TILE_PAD * 2) / approxCharW;
    if (charsPerLine < 8) charsPerLine = 8;
    int maxLines = (tile.h - NOTE_TILE_PAD * 2) / approxCharH;
    if (maxLines < 1) maxLines = 1;
    const char* p = g_noteItems[i].body;
    int line = 0, col = 0;
    while (*p && line < maxLines) {
      char c = *p++;
      if (c == '\n') {
        line++;
        col = 0;
        gfx->setCursor(tile.x + NOTE_TILE_PAD, tile.y + NOTE_TILE_PAD + line * approxCharH);
        continue;
      }
      gfx->print(c);
      col++;
      if (col >= charsPerLine) {
        line++;
        col = 0;
        if (line < maxLines) gfx->setCursor(tile.x + NOTE_TILE_PAD, tile.y + NOTE_TILE_PAD + line * approxCharH);
      }
    }

    // Caption under tile: title (clickable too) — centered under the tile
    gfx->setTextColor(RGB565_WHITE);
    gfx->setTextSize(2);  // bigger captions in Notes grid
    {
      const int charW = 12;  // textSize=2 approximate char width
      int maxCharsPerLine = cap.w / charW;
      if (maxCharsPerLine < 1) maxCharsPerLine = 1;

      // Two-line title: line1 wraps, line2 ends with " ..." if it overflows.
      char l1[32] = { 0 };
      char l2[32] = { 0 };
      if (maxCharsPerLine > (int)sizeof(l1) - 1) maxCharsPerLine = (int)sizeof(l1) - 1;

      const char* s = g_noteItems[i].title;
      int p = 0;
      int n1 = 0;
      while (n1 < maxCharsPerLine && s[p]) { l1[n1++] = s[p++]; }
      l1[n1] = 0;

      int n2 = 0;
      while (n2 < maxCharsPerLine && s[p]) { l2[n2++] = s[p++]; }

      // If there's still more after line2, replace end of line2 with " ..."
      if (s[p]) {
        if (maxCharsPerLine >= 4) {
          n2 = maxCharsPerLine - 4;
          if (n2 < 0) n2 = 0;
          l2[n2++] = ' ';
          l2[n2++] = '.';
          l2[n2++] = '.';
          l2[n2++] = '.';
        } else {
          // Tiny tiles: just end with dots
          n2 = maxCharsPerLine;
          for (int k = 0; k < n2; k++) l2[k] = '.';
        }
      }
      l2[n2] = 0;

      // Center each line within the caption width
      int l1w = n1 * charW;
      int cx1 = cap.x + (cap.w - l1w) / 2;
      if (cx1 < cap.x) cx1 = cap.x;
      gfx->setCursor(cx1, cap.y);
      gfx->print(l1);

      if (l2[0]) {
        int l2w = n2 * charW;
        int cx2 = cap.x + (cap.w - l2w) / 2;
        if (cx2 < cap.x) cx2 = cap.x;
        gfx->setCursor(cx2, (int16_t)(cap.y + 16));
        gfx->print(l2);
      }
    }

    // Edit mode checkbox overlay (top-right of tile)
    if (g_noteListEditMode) {
      const int cbW = 18, cbH = 18;
      int cbX = tile.x + tile.w - cbW - 6;
      int cbY = tile.y + 6;
      gfx->drawRect(cbX, cbY, cbW, cbH, UI_ACCENT);
      if (g_noteSelected[i]) gfx->fillRect(cbX + 2, cbY + 2, cbW - 4, cbH - 4, UI_ACCENT);
    }
    // Flash on touch/hold: same as keyboard key flash (light grey, rounded)
    if (g_listFlashActive && g_listFlashVisible && g_screen == UIScreen::NOTES && g_listFlashIndex == i && !g_showNoteSendPopup) {
      gfx->fillRoundRect(tile.x, tile.y, tile.w, tile.h, 10, RGB565_KEYFLASH);
      gfx->drawRoundRect(tile.x, tile.y, tile.w, tile.h, 10, UI_BORDER);
    }
  }

#if SEEDMASK_NOTE_SEND_UI
  // Long-press Send: "Send" on same line as EDIT, centered; active card gets a light, smooth blue pulse
  if (g_showNoteSendPopup && g_noteSendPopupIndex < g_noteCount) {
    int slot = (int)g_noteSendPopupIndex - (int)g_noteListScroll;
    if (slot >= 0 && slot < NOTE_GRID_VISIBLE_ROWS * NOTE_GRID_COLS) {
      Rect tile, cap;
      noteTileRectsForSlot(slot, tile, cap);

      // Blue border on active card: gentle, harmonic pulse (slow breath-like cycle)
      const uint16_t blueDim = (uint16_t)0x3186;     // base blue
      const uint16_t blueBright = (uint16_t)0x7D5F;  // brighter blue
      const uint32_t pulsePeriodMs = 2600;           // ~2.6s per full cycle for a calm, harmonic feel
      uint32_t tMs = millis();
      float phase = (float)(tMs % pulsePeriodMs) / (float)pulsePeriodMs;  // 0..1
      float pulse = 0.5f + 0.5f * sinf(phase * 2.0f * 3.1415926f);        // smooth 0..1
      // Blend between dim and bright blue
      int r1 = (blueDim >> 11) & 0x1F, g1 = (blueDim >> 5) & 0x3F, b1 = blueDim & 0x1F;
      int r2 = (blueBright >> 11) & 0x1F, g2 = (blueBright >> 5) & 0x3F, b2 = blueBright & 0x1F;
      int r = (int)(r1 + (r2 - r1) * pulse);
      int g = (int)(g1 + (g2 - g1) * pulse);
      int b = (int)(b1 + (b2 - b1) * pulse);
      if (r > 31) r = 31;
      if (r < 0) r = 0;
      if (g > 63) g = 63;
      if (g < 0) g = 0;
      if (b > 31) b = 31;
      if (b < 0) b = 0;
      uint16_t borderColor = (uint16_t)((r << 11) | (g << 5) | b);

      // Pulse as a filled rounded "ring" (same shape as card, no stroke corners): outer then inner cutout
      const int ringOut = 2;
      gfx->fillRoundRect(tile.x - ringOut, tile.y - ringOut, tile.w + 2 * ringOut, tile.h + 2 * ringOut, 10 + ringOut, borderColor);
      gfx->fillRoundRect(tile.x + ringOut, tile.y + ringOut, tile.w - 2 * ringOut, tile.h - 2 * ringOut, 10 - ringOut, UI_CARD);
      gfx->drawRoundRect(tile.x, tile.y, tile.w, tile.h, 10, UI_BORDER);
      // Redraw note card content (ring covered it)
      gfx->setTextColor(UI_TEXT);
      gfx->setTextSize(1);
      gfx->setCursor(tile.x + NOTE_TILE_PAD, tile.y + NOTE_TILE_PAD);
      const int approxCharW = 6, approxCharH = 8;
      int charsPerLine = (tile.w - NOTE_TILE_PAD * 2) / approxCharW;
      if (charsPerLine < 8) charsPerLine = 8;
      int maxLines = (tile.h - NOTE_TILE_PAD * 2) / approxCharH;
      if (maxLines < 1) maxLines = 1;
      const char* p = g_noteItems[g_noteSendPopupIndex].body;
      int line = 0, col = 0;
      while (*p && line < maxLines) {
        char c = *p++;
        if (c == '\n') {
          line++;
          col = 0;
          gfx->setCursor(tile.x + NOTE_TILE_PAD, tile.y + NOTE_TILE_PAD + line * approxCharH);
          continue;
        }
        gfx->print(c);
        col++;
        if (col >= charsPerLine) {
          line++;
          col = 0;
          if (line < maxLines) gfx->setCursor(tile.x + NOTE_TILE_PAD, tile.y + NOTE_TILE_PAD + line * approxCharH);
        }
      }
      gfx->setTextColor(RGB565_WHITE);
      gfx->setTextSize(2);
      {
        const int charW = 12;
        int maxCharsPerLine = cap.w / charW;
