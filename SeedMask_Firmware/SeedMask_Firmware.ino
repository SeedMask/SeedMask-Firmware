/** Unhyphenated Base32 body after SPB1 (v2). 12-word even; 24-word last box is 5 chars. */
#ifndef BACKUP_SPB1_PAYLOAD_12
#define BACKUP_SPB1_PAYLOAD_12 44
#define BACKUP_SPB1_PAYLOAD_24 69
#endif

static void backup_spb1_compact_chars(const char* code, char* out, size_t outLen) {
  if (!out || outLen == 0) return;
  out[0] = 0;
  if (!code) return;
  size_t o = 0;
  for (size_t i = 0; code[i] && o + 1 < outLen; i++) {
    char c = code[i];
    if (c == '-' || c == ' ' || c == '\n' || c == '\r' || c == '\t') continue;
    if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
    out[o++] = c;
  }
  out[o] = 0;
}

static bool backup_spb1_compact_ok(const char* compact) {
  if (!compact) return false;
  size_t n = strlen(compact);
  return n >= 8 && n < BACKUP_SPB1_COMPACT_MAX && strncmp(compact, "SPB1", 4) == 0;
}

// Parse serialized notes (title\tbody\n per line) into g_noteItems and g_noteCount.
static void notes_deserialize_plain(const char* str, size_t len) {
  g_noteCount = 0;
  if (!g_noteItems || !str || len == 0) return;
  const char* p = str;
  const char* end = str + len;
  while (p < end && g_noteCount < MAX_NOTE_ITEMS) {
    const char* lineStart = p;
    while (p < end && *p != '\n' && *p != '\r') p++;
    if (p > lineStart) {
      const char* tab = (const char*)memchr(lineStart, '\t', p - lineStart);
      if (tab && tab > lineStart) {
        size_t titleLen = (size_t)(tab - lineStart);
        if (titleLen >= sizeof(g_noteItems[0].title)) titleLen = sizeof(g_noteItems[0].title) - 1;
        memcpy(g_noteItems[g_noteCount].title, lineStart, titleLen);
        g_noteItems[g_noteCount].title[titleLen] = 0;
        size_t bodyLen = (size_t)(p - (tab + 1));
        if (bodyLen >= sizeof(g_noteItems[0].body)) bodyLen = sizeof(g_noteItems[0].body) - 1;
        memcpy(g_noteItems[g_noteCount].body, tab + 1, bodyLen);
        g_noteItems[g_noteCount].body[bodyLen] = 0;
        g_noteCount++;
      }
    }
    while (p < end && (*p == '\n' || *p == '\r')) p++;
  }
}

static String totp_serialize_plain() {
  String s;
  for (uint8_t i = 0; i < g_totpCount; i++) {
    s += g_totpItems[i].label;
    s += "\t";
    s += g_totpItems[i].secret;
    s += "\n";
  }
  return s;
}
static void totp_deserialize_plain(const char* str, size_t len) {
  g_totpCount = 0;
  if (!str || len == 0) return;
  const char* p = str;
  const char* end = str + len;
  while (p < end && g_totpCount < MAX_TOTP_ITEMS) {
    const char* lineStart = p;
    while (p < end && *p != '\n' && *p != '\r') p++;
    if (p > lineStart) {
      const char* tab = (const char*)memchr(lineStart, '\t', p - lineStart);
      if (tab && tab > lineStart) {
        size_t labelLen = (size_t)(tab - lineStart);
        if (labelLen >= sizeof(g_totpItems[0].label)) labelLen = sizeof(g_totpItems[0].label) - 1;
        memcpy(g_totpItems[g_totpCount].label, lineStart, labelLen);
        g_totpItems[g_totpCount].label[labelLen] = 0;
        size_t secretLen = (size_t)(p - (tab + 1));
        if (secretLen >= sizeof(g_totpItems[0].secret)) secretLen = sizeof(g_totpItems[0].secret) - 1;
        memcpy(g_totpItems[g_totpCount].secret, tab + 1, secretLen);
        g_totpItems[g_totpCount].secret[secretLen] = 0;
        g_totpCount++;
      }
    }
    while (p < end && (*p == '\n' || *p == '\r')) p++;
  }
}

// =======================
// Packed seed: 11-bit indices => bytes
// 12 words => 17 bytes, 24 words => 33 bytes
// =======================
static size_t packed_len_for_words(uint8_t wc) {
  return (wc == 24) ? 33 : 17;
}

static bool pack_seed_indices(const uint16_t* idx, uint8_t wc, uint8_t* out, size_t outLen) {
  size_t need = packed_len_for_words(wc);
  if (outLen < need) return false;
  memset(out, 0, need);

  uint32_t bitpos = 0;
  for (int i = 0; i < wc; i++) {
    uint16_t v = idx[i] & 0x07FF;
    for (int b = 10; b >= 0; b--) {
      uint8_t bit = (v >> b) & 1;
      uint32_t byteIndex = bitpos / 8;
      uint8_t bitInByte = 7 - (bitpos % 8);
      out[byteIndex] |= (bit << bitInByte);
      bitpos++;
    }
  }
  return true;
}

static bool unpack_seed_indices(const uint8_t* in, uint8_t wc, uint16_t* idxOut) {
  uint32_t bitpos = 0;
  for (int i = 0; i < wc; i++) {
    uint16_t v = 0;
    for (int b = 10; b >= 0; b--) {
      uint32_t byteIndex = bitpos / 8;
      uint8_t bitInByte = 7 - (bitpos % 8);
      uint8_t bit = (in[byteIndex] >> bitInByte) & 1;
      v |= (bit << b);
      bitpos++;
    }
    idxOut[i] = v;
  }
  return true;
}

