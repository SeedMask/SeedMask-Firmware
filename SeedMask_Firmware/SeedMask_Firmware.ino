// Base64 encode (standard alphabet); out must have at least ((len+2)/3)*4+1 bytes
static void base64_encode(const uint8_t* in, size_t len, char* out) {
  static const char enc[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  size_t i = 0, j = 0;
  for (; i + 2 < len; i += 3, j += 4) {
    out[j + 0] = enc[(in[i] >> 2) & 63];
    out[j + 1] = enc[((in[i] & 3) << 4) | (in[i + 1] >> 4)];
    out[j + 2] = enc[((in[i + 1] & 15) << 2) | (in[i + 2] >> 6)];
    out[j + 3] = enc[in[i + 2] & 63];
  }
  if (i < len) {
    out[j++] = enc[(in[i] >> 2) & 63];
    if (i + 1 < len) {
      out[j++] = enc[((in[i] & 3) << 4) | (in[i + 1] >> 4)];
      out[j++] = enc[((in[i + 1] & 15) << 2)];
      out[j++] = '=';
    } else {
      out[j++] = enc[(in[i] & 3) << 4];
      out[j++] = '=';
      out[j++] = '=';
    }
  }
  out[j] = 0;
}

// Base64 decode; returns decoded length or 0 on error. out must be at least (strlen(in)*3)/4 bytes.
static size_t base64_decode(const char* in, uint8_t* out, size_t out_max) {
  size_t n = 0;
  while (in[n]) n++;
  size_t out_len = 0;
  int buf = 0, bits = 0;
  for (size_t i = 0; i < n && in[i] != '='; i++) {
    int v = -1;
    if (in[i] >= 'A' && in[i] <= 'Z') v = in[i] - 'A';
    else if (in[i] >= 'a' && in[i] <= 'z') v = in[i] - 'a' + 26;
    else if (in[i] >= '0' && in[i] <= '9') v = in[i] - '0' + 52;
    else if (in[i] == '+') v = 62;
    else if (in[i] == '/') v = 63;
    if (v < 0) continue;
    buf = (buf << 6) | v;
    bits += 6;
    if (bits >= 8) {
      if (out_len >= out_max) return 0;
      out[out_len++] = (uint8_t)((buf >> (bits - 8)) & 0xFF);
      bits -= 8;
    }
  }
  if (bits >= 8 && out_len < out_max) {
    out[out_len++] = (uint8_t)((buf >> (bits - 8)) & 0xFF);
  }
  return out_len;
}

// -------- Simple LZ77 compression for vault QR (smaller QR = easier to scan) --------
#define LZ_WINDOW 512
#define LZ_MIN_MATCH 3
#define LZ_MAX_MATCH 32

// Returns compressed size (0 = failed or no savings). out_max must be at least inLen + 16.
static size_t vault_compress(const uint8_t* in, size_t inLen, uint8_t* out, size_t out_max) {
  if (inLen == 0 || out_max < inLen + 16) return 0;
  size_t o = 0;
  size_t i = 0;
  while (i < inLen) {
    int best_len = 0, best_off = 0;
    size_t start = (i >= (size_t)LZ_WINDOW) ? i - LZ_WINDOW : 0;
    for (size_t k = start; k < i; k++) {
      int len = 0;
      while (len < LZ_MAX_MATCH && i + len < inLen && in[k + len] == in[i + len]) len++;
      if (len >= LZ_MIN_MATCH && len > best_len) {
        best_len = len;
        best_off = (int)(i - k);
      }
    }
    if (best_len >= LZ_MIN_MATCH) {
      if (o + 4 > out_max) return 0;
      out[o++] = 1;
      out[o++] = (uint8_t)(best_off & 0xFF);
      out[o++] = (uint8_t)((best_off >> 8) & 0xFF);
      out[o++] = (uint8_t)best_len;
      i += best_len;
    } else {
      size_t lit_start = i;
      while (i < inLen) {
        best_len = 0;
        start = (i >= (size_t)LZ_WINDOW) ? i - LZ_WINDOW : 0;
        for (size_t k = start; k < i; k++) {
          int len = 0;
          while (len < LZ_MAX_MATCH && i + len < inLen && in[k + len] == in[i + len]) len++;
          if (len >= LZ_MIN_MATCH && len > best_len) { best_len = len; }
        }
        if (best_len >= LZ_MIN_MATCH) break;
        i++;
      }
      size_t lit_len = i - lit_start;
      if (lit_len > 0) {
        if (o + 2 + lit_len > out_max) return 0;
        out[o++] = 0;
        out[o++] = (uint8_t)(lit_len & 0xFF);
        memcpy(out + o, in + lit_start, lit_len);
        o += lit_len;
      }
    }
  }
  if (o + 2 > out_max) return 0;
  out[o++] = 0;
  out[o++] = 0;                // end marker
  return (o < inLen) ? o : 0;  // only return size if we actually saved space
}

// Returns decompressed size (0 = failed). out_max must be large enough for expanded data.
static size_t vault_decompress(const uint8_t* in, size_t inLen, uint8_t* out, size_t out_max) {
  size_t o = 0, i = 0;
  while (i + 1 < inLen) {
    uint8_t tag = in[i++];
    if (tag == 0) {
      uint8_t L = in[i++];
      if (L == 0) break;
      if (i + L > inLen || o + L > out_max) return 0;
      memcpy(out + o, in + i, L);
      o += L;
      i += L;
    } else {
      if (i + 3 > inLen) return 0;
      int off = (int)in[i] | ((int)in[i + 1] << 8);
      int len = (int)in[i + 2];
      i += 3;
      if (off <= 0 || (size_t)off > o || len < LZ_MIN_MATCH || len > LZ_MAX_MATCH || o + len > out_max) return 0;
      for (int j = 0; j < len; j++) out[o + j] = out[o - off + j];
      o += len;
    }
  }
  return o;
}

// Encrypted vault QR: same password-based encryption. Plaintext may be compressed (flag byte 1) to shrink QR.
// Format SPE1|<base64(salt(4)+len(4)+ct)> where ct = iv(12)+encrypted+tag(16), encrypted = AES(flag byte + data).
// Plaintext may end with "\n---U---\n" + base64(used-address blob) when space allows (fallback: QR without ---U---).
static bool spe1_finalize_qr_from_plain(const uint8_t* plain, size_t plainLen) {
  const size_t toEncryptCap = plainLen + 2u;
  uint8_t* toEncrypt = (uint8_t*)ps_malloc(toEncryptCap);
  if (!toEncrypt) {
    g_vaultQrPayload[0] = 0;
    return false;
  }
  size_t toEncryptLen = 0;
  uint8_t* cbuf = (uint8_t*)ps_malloc(plainLen + 64);
  if (cbuf) {
    size_t clen = vault_compress(plain, plainLen, cbuf, plainLen + 64);
    if (clen > 0 && clen < plainLen) {
      toEncrypt[0] = 1;
      memcpy(toEncrypt + 1, cbuf, clen);
      toEncryptLen = 1 + clen;
    } else {
      toEncrypt[0] = 0;
      memcpy(toEncrypt + 1, plain, plainLen);
      toEncryptLen = 1 + plainLen;
    }
    secure_memzero(cbuf, plainLen + 64);
    free(cbuf);
  } else {
    toEncrypt[0] = 0;
    memcpy(toEncrypt + 1, plain, plainLen);
    toEncryptLen = 1 + plainLen;
  }

  uint8_t salt[4];
  esp_fill_random(salt, 4);
  size_t ct_len = 12 + 16 + toEncryptLen;
  uint8_t* ct = (uint8_t*)ps_malloc(ct_len);
  if (!ct) {
    secure_memzero(toEncrypt, toEncryptCap);
    free(toEncrypt);
    g_vaultQrPayload[0] = 0;
    return false;
  }
  const size_t ct_alloc = ct_len;
  if (!aes_gcm_encrypt(g_masterPw, salt, toEncrypt, toEncryptLen, ct, &ct_len)) {
    secure_memzero(toEncrypt, toEncryptCap);
    free(toEncrypt);
    secure_memzero(ct, ct_alloc);
    free(ct);
    g_vaultQrPayload[0] = 0;
    return false;
  }
  size_t blob_len = 8 + ct_len;
  uint8_t* blob = (uint8_t*)ps_malloc(blob_len);
  if (!blob) {
    secure_memzero(toEncrypt, toEncryptCap);
    free(toEncrypt);
    secure_memzero(ct, ct_alloc);
    free(ct);
    g_vaultQrPayload[0] = 0;
    return false;
  }
  memcpy(blob, salt, 4);
  uint32_t len32 = (uint32_t)ct_len;
  memcpy(blob + 4, &len32, 4);
  memcpy(blob + 8, ct, ct_len);
  secure_memzero(ct, ct_alloc);
  free(ct);

  size_t b64_len = ((blob_len + 2) / 3) * 4;
  if (b64_len > VAULT_QR_B64_MAX_BYTES || b64_len + 6 > VAULT_QR_PAYLOAD_MAX_BYTES) {
    secure_memzero(toEncrypt, toEncryptCap);
    free(toEncrypt);
    secure_memzero(blob, blob_len);
    free(blob);
    g_vaultQrPayload[0] = 0;
    return false;
  }
  strcpy(g_vaultQrPayload, "SPE1|");
  base64_encode(blob, blob_len, g_vaultQrPayload + 5);
  secure_memzero(blob, blob_len);
  free(blob);
  secure_memzero(toEncrypt, toEncryptCap);
  free(toEncrypt);

  Serial.printf("rebuildVaultQR: plain=%u, encrypted=%u, blob=%u, b64=%u, total=%u chars\n",
                (unsigned)plainLen, (unsigned)toEncryptLen, (unsigned)blob_len,
                (unsigned)strlen(g_vaultQrPayload + 5), (unsigned)strlen(g_vaultQrPayload));

  const char* b64 = g_vaultQrPayload + 5;
  size_t b64_strlen = strlen(b64);
  if (b64_strlen <= VAULT_QR_CHUNK_CHARS) {
    g_vaultQrPartCount = 1;
    g_vaultQrPartIndex = 0;
    Serial.printf("rebuildVaultQR: single QR, %u b64 chars, payload=%u total\n",
                  (unsigned)b64_strlen, (unsigned)strlen(g_vaultQrPayload));
    return true;
  }
  g_vaultQrPartCount = (uint8_t)((b64_strlen + VAULT_QR_CHUNK_CHARS - 1) / VAULT_QR_CHUNK_CHARS);
  if (g_vaultQrPartCount > VAULT_QR_MAX_PARTS) g_vaultQrPartCount = VAULT_QR_MAX_PARTS;
  Serial.printf("rebuildVaultQR: %u parts, %u b64 chars, ~%u per part\n",
                (unsigned)g_vaultQrPartCount, (unsigned)b64_strlen,
                (unsigned)((b64_strlen + g_vaultQrPartCount - 1) / g_vaultQrPartCount));
  g_vaultQrPartIndex = 0;
  size_t evenChunk = (b64_strlen + g_vaultQrPartCount - 1) / g_vaultQrPartCount;
  for (uint8_t k = 0; k < g_vaultQrPartCount; k++) {
    size_t off = (size_t)k * evenChunk;
    size_t len = (off + evenChunk <= b64_strlen) ? evenChunk : (b64_strlen - off);
    snprintf(g_vaultQrPayloadParts[k], sizeof(g_vaultQrPayloadParts[k]), "SPE1-M%u/%u|", (unsigned)(k + 1), (unsigned)g_vaultQrPartCount);
    size_t prefixLen = strlen(g_vaultQrPayloadParts[k]);
    if (prefixLen + len < sizeof(g_vaultQrPayloadParts[k])) {
      memcpy(g_vaultQrPayloadParts[k] + prefixLen, b64 + off, len);
      g_vaultQrPayloadParts[k][prefixLen + len] = 0;
    }
  }
  return true;
}

static void rebuildVaultQrPayload() {
  if (!g_masterPw[0]) {
    g_vaultQrPayload[0] = 0;
    return;
  }
  if (!g_vaultQrDirty && g_vaultQrPayload[0]) return;

  String s;
  s.reserve(8192);
  s += "SP2|";
  s += g_backupCode;
  s += "|";
  s += vault_export_passwords_plaintext();
  s += "\n---N---\n";
  for (uint8_t i = 0; i < g_noteCount; i++) {
    s += g_noteItems[i].title;
    s += "\t";
    s += g_noteItems[i].body;
    s += "\n";
  }
  s += "\n---T---\n";
  s += totp_serialize_plain();

  if (addr_status_marked_count() > 0 && !g_tempSeedActive) {
    const size_t abCap = 6200u;  // >= 12 + 512*11 (matches ADDR_STATUS_MARK_CAP)
    uint8_t* ab = (uint8_t*)ps_malloc(abCap);
    if (ab) {
      size_t aw = 0;
      if (addr_status_write_blob(ab, abCap, &aw)) {
        const size_t b64cap = ((aw + 2u) / 3u) * 4u + 2u;
        char* b64 = (char*)ps_malloc(b64cap);
        if (b64) {
          base64_encode(ab, aw, b64);
          String su = s;
          su += "\n---U---\n";
          su += b64;
          free(b64);
          free(ab);
          if (spe1_finalize_qr_from_plain((const uint8_t*)su.c_str(), su.length())) {
            g_vaultQrDirty = false;
            return;
          }
        } else {
          free(ab);
        }
      } else {
        free(ab);
      }
    }
  }
  if (!spe1_finalize_qr_from_plain((const uint8_t*)s.c_str(), s.length())) {
    g_vaultQrPayload[0] = 0;
    return;
  }
  g_vaultQrDirty = false;
}

// Backup code file on microSD (will be set dynamically)
// =======================
static char BC_FILE[192] = "/sdcard/seedmask/backup_v1.bin";
/** Basename of BC_FILE (e.g. Backup_A1B2C3D4.bin). */
static const char* backup_code_sd_basename(void) {
  const char* slash = strrchr(BC_FILE, '/');
  return (slash && slash[1]) ? (slash + 1) : BC_FILE;
}
/** Full path of last Backup / encrypted backup-code file opened from SD (for PW_<xfp>.bin fallback). */
static char g_lastSdBackupCodePath[192] = { 0 };

// Layout: /sdcard/seedmask/BACKUP <XFP>/Backup_<XFP>.bin and PW_<XFP>.bin (XFP = 8 hex BIP32 master fingerprint).
static bool seedmask_fill_sd_paths_for_xfp(const char xfp[9]) {
  if (!xfp || !xfp[0]) return false;
  char folder[64];
  snprintf(folder, sizeof(folder), "%s/BACKUP %s", PW_DIR, xfp);
  snprintf(PW_FILE, sizeof(PW_FILE), "%s/PW_%s.bin", folder, xfp);
  snprintf(BC_FILE, sizeof(BC_FILE), "%s/Backup_%s.bin", folder, xfp);
  return true;
}

static bool seedmask_prepare_sd_backup_paths_for_words(const char seedWords[][16], uint8_t wc) {
  char xfp[9] = { 0 };
  if (!bip39_mnemonic_words_fingerprint(seedWords, wc, xfp) || !xfp[0]) return false;
  if (!seedmask_ensure_dir_multisig_style(PW_DIR)) return false;
  char folder[64];
  snprintf(folder, sizeof(folder), "%s/BACKUP %s", PW_DIR, xfp);
  if (!seedmask_ensure_dir_multisig_style(folder)) return false;
  return seedmask_fill_sd_paths_for_xfp(xfp);
}

static bool seedmask_prepare_sd_backup_paths_for_current_vault() {
  char xfp[9] = { 0 };
  if (!bip39_mnemonic_words_fingerprint((const char(*)[16])g_seed, g_wc, xfp) || !xfp[0]) {
    if (!current_master_xfp(xfp) || !xfp[0]) return false;
  }
  if (!seedmask_ensure_dir_multisig_style(PW_DIR)) return false;
  char folder[64];
  snprintf(folder, sizeof(folder), "%s/BACKUP %s", PW_DIR, xfp);
  if (!seedmask_ensure_dir_multisig_style(folder)) return false;
  return seedmask_fill_sd_paths_for_xfp(xfp);
}

/** Try canonical PW_<xfp>.bin (XFP from seed), then same folder as g_lastSdBackupCodePath if that fails. */
static bool try_pw_vault_load_from_sd_with_fallbacks(const char* masterPw) {
  if (!seedmask_prepare_sd_backup_paths_for_current_vault()) {
    setMsg("Could not set vault path");
    return false;
  }
  if (pw_vault_load_from_sd(masterPw)) return true;

  char xfp[9] = { 0 };
  if (!bip39_mnemonic_words_fingerprint((const char(*)[16])g_seed, g_wc, xfp) || !xfp[0]) {
    if (!current_master_xfp(xfp) || !xfp[0]) return false;
  }
  if (g_lastSdBackupCodePath[0] && strncmp(g_lastSdBackupCodePath, "/sdcard/", 8) == 0) {
    char dir[192];
    strncpy(dir, g_lastSdBackupCodePath, sizeof(dir) - 1);
    dir[sizeof(dir) - 1] = 0;
    char* slash = strrchr(dir, '/');
    if (slash && slash > dir) {
      *slash = 0;
      char alt[192];
      snprintf(alt, sizeof(alt), "%s/PW_%s.bin", dir, xfp);
      strncpy(PW_FILE, alt, sizeof(PW_FILE) - 1);
      PW_FILE[sizeof(PW_FILE) - 1] = 0;
      if (pw_vault_load_from_sd(masterPw)) return true;
      // Renamed vault: other SPV1/SPV2 .bin in that folder (skip the backup file)
      DIR* d = opendir(dir);
      if (d) {
        struct dirent* ent;
        while ((ent = readdir(d)) != NULL) {
          if (ent->d_name[0] == '.') continue;
          size_t nl = strlen(ent->d_name);
          if (nl < 5 || strncasecmp(ent->d_name + nl - 4, ".bin", 4) != 0) continue;
          char full[192];
          snprintf(full, sizeof(full), "%s/%s", dir, ent->d_name);
          if (strcmp(full, g_lastSdBackupCodePath) == 0) continue;
          struct stat st;
          if (stat(full, &st) != 0 || !S_ISREG(st.st_mode)) continue;
          if (!sd_bin_file_header_is_pw_vault(full)) continue;
          strncpy(PW_FILE, full, sizeof(PW_FILE) - 1);
          PW_FILE[sizeof(PW_FILE) - 1] = 0;
          if (pw_vault_load_from_sd(masterPw)) {
            closedir(d);
            return true;
          }
        }
        closedir(d);
      }
    }
  }
  return false;
}

/** After vault load from SD: show modal on MENU (filename + explanation); not a timed toast. */
static void menu_show_vault_restore_success_panel(void) {
  const char* slash = strrchr(PW_FILE, '/');
  const char* base = slash ? slash + 1 : PW_FILE;
  strncpy(g_menuVaultRestoredFile, base, sizeof(g_menuVaultRestoredFile) - 1);
  g_menuVaultRestoredFile[sizeof(g_menuVaultRestoredFile) - 1] = 0;
  g_menuVaultRestoredPanel = true;
  setMsg("");
  g_menuToastHideAtMs = 0;
}

static void set_msg_vault_restored_ok(void) {
  menu_show_vault_restore_success_panel();
}

// AES-GCM encrypt/decrypt helper
static bool aes_gcm_encrypt(const char* masterPw, const uint8_t salt[4], const uint8_t* plaintext, size_t plaintext_len, uint8_t* ciphertext, size_t* ciphertext_len) {
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("aes_gcm_encrypt: Starting encryption...");
  Serial.print("aes_gcm_encrypt: plaintext_len = ");
  Serial.println(plaintext_len);
  Serial.print("aes_gcm_encrypt: ciphertext_len (input) = ");
  Serial.println(*ciphertext_len);
#endif

  uint8_t key[32];
  if (!pbkdf2_sha256((const uint8_t*)masterPw, strlen(masterPw), salt, 4, PBKDF2_ITERATIONS, key, sizeof(key))) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("aes_gcm_encrypt: PBKDF2 failed");
#endif
    secure_memzero(key, sizeof(key));
    return false;
  }
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("aes_gcm_encrypt: PBKDF2 key derivation successful");
#endif

  mbedtls_gcm_context gcm;
  mbedtls_gcm_init(&gcm);

  uint8_t iv[12];              // 96-bit IV for GCM
  memcpy(iv, salt, 4);         // Use salt as first 4 bytes of IV
  esp_fill_random(iv + 4, 8);  // Random remaining 8 bytes

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("aes_gcm_encrypt: IV: ");
  for (int i = 0; i < 12; i++) {
    Serial.print(iv[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
#endif

  int ret = mbedtls_gcm_setkey(&gcm, MBEDTLS_CIPHER_ID_AES, key, 256);
  if (ret != 0) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("aes_gcm_encrypt: GCM setkey failed, error: ");
    Serial.println(ret);
#endif
    mbedtls_gcm_free(&gcm);
    secure_memzero(key, sizeof(key));
    secure_memzero(iv, sizeof(iv));
    return false;
  }
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("aes_gcm_encrypt: GCM setkey successful");
#endif

  // ciphertext format: iv(12) + tag(16) + encrypted_data
  if (*ciphertext_len < 12 + 16 + plaintext_len) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("aes_gcm_encrypt: Output buffer too small");
#endif
    mbedtls_gcm_free(&gcm);
    secure_memzero(key, sizeof(key));
    secure_memzero(iv, sizeof(iv));
    return false;
  }

  memcpy(ciphertext, iv, 12);

  uint8_t tag[16];
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("aes_gcm_encrypt: Starting GCM encrypt and tag...");
#endif
  ret = mbedtls_gcm_crypt_and_tag(&gcm, MBEDTLS_GCM_ENCRYPT, plaintext_len, iv, 12, NULL, 0, plaintext, ciphertext + 12, 16, tag);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("aes_gcm_encrypt: GCM encrypt result: ");
  Serial.println(ret);
#endif

  if (ret == 0) {
    memcpy(ciphertext + 12 + plaintext_len, tag, 16);
    *ciphertext_len = 12 + 16 + plaintext_len;
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("aes_gcm_encrypt: Final ciphertext_len = ");
    Serial.println(*ciphertext_len);
#endif
  }

  mbedtls_gcm_free(&gcm);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("aes_gcm_encrypt: Encryption ");
  Serial.println(ret == 0 ? "SUCCESS" : "FAILED");
#endif
  secure_memzero(key, sizeof(key));
  secure_memzero(iv, sizeof(iv));
  secure_memzero(tag, sizeof(tag));
  return ret == 0;
}

// Encrypt with pre-derived key (no PBKDF2). Used when session key cache is valid.
// ciphertext layout: iv(12) + encrypted_data + tag(16); *ciphertext_len = 12 + plaintext_len + 16.
static bool aes_gcm_encrypt_with_key(const uint8_t key[32], const uint8_t* plaintext, size_t plaintext_len, uint8_t* ciphertext, size_t* ciphertext_len) {
  if (*ciphertext_len < 12 + 16 + plaintext_len) return false;
  uint8_t iv[12];
  esp_fill_random(iv, 12);
  mbedtls_gcm_context gcm;
  mbedtls_gcm_init(&gcm);
  int ret = mbedtls_gcm_setkey(&gcm, MBEDTLS_CIPHER_ID_AES, key, 256);
  if (ret != 0) {
    mbedtls_gcm_free(&gcm);
    secure_memzero(iv, sizeof(iv));
    return false;
  }
  memcpy(ciphertext, iv, 12);
  uint8_t tag[16];
  ret = mbedtls_gcm_crypt_and_tag(&gcm, MBEDTLS_GCM_ENCRYPT, plaintext_len, iv, 12, NULL, 0, plaintext, ciphertext + 12, 16, tag);
  if (ret == 0) {
    memcpy(ciphertext + 12 + plaintext_len, tag, 16);
    *ciphertext_len = 12 + 16 + plaintext_len;
  }
  mbedtls_gcm_free(&gcm);
  secure_memzero(iv, sizeof(iv));
  secure_memzero(tag, sizeof(tag));
  return ret == 0;
}

// AES-GCM decrypt with raw 256-bit key (same layout as aes_gcm_encrypt_with_key: iv(12) || ct || tag(16)).
static bool aes_gcm_decrypt_with_key(const uint8_t key[32], const uint8_t* ciphertext, size_t ciphertext_len,
                                     uint8_t* plaintext, size_t* plaintext_len) {
  if (ciphertext_len < 12 + 16 || !plaintext || !plaintext_len) return false;
  uint8_t iv[12];
  memcpy(iv, ciphertext, 12);
  size_t encLen = ciphertext_len - 12 - 16;
  if (*plaintext_len < encLen) return false;
  uint8_t tag[16];
  memcpy(tag, ciphertext + ciphertext_len - 16, 16);
  const uint8_t* enc = ciphertext + 12;
  mbedtls_gcm_context gcm;
  mbedtls_gcm_init(&gcm);
  int ret = mbedtls_gcm_setkey(&gcm, MBEDTLS_CIPHER_ID_AES, key, 256);
  if (ret != 0) {
    mbedtls_gcm_free(&gcm);
    secure_memzero(iv, sizeof(iv));
    secure_memzero(tag, sizeof(tag));
    return false;
  }
  ret = mbedtls_gcm_auth_decrypt(&gcm, encLen, iv, 12, NULL, 0, tag, 16, enc, plaintext);
  mbedtls_gcm_free(&gcm);
  secure_memzero(iv, sizeof(iv));
  secure_memzero(tag, sizeof(tag));
  if (ret == 0) *plaintext_len = encLen;
  else if (plaintext && encLen) secure_memzero(plaintext, encLen);
  return ret == 0;
}

static bool aes_gcm_decrypt(const char* masterPw, const uint8_t salt[4], const uint8_t* ciphertext, size_t ciphertext_len, uint8_t* plaintext, size_t* plaintext_len) {
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("aes_gcm_decrypt: Starting decryption...");
  Serial.print("aes_gcm_decrypt: ciphertext_len = ");
  Serial.println(ciphertext_len);
  Serial.print("aes_gcm_decrypt: plaintext_len (input) = ");
  Serial.println(*plaintext_len);
#endif

  if (ciphertext_len < 12 + 16) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("aes_gcm_decrypt: Ciphertext too short - need at least IV + tag");
#endif
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("aes_gcm_decrypt: Extracting IV from first 12 bytes: ");
#endif
  uint8_t iv[12];
  memcpy(iv, ciphertext, 12);
#if SEEDMASK_CRYPTO_DEBUG
  for (int i = 0; i < 12; i++) {
    Serial.print(iv[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  // IMPORTANT: Use the salt from the file header for PBKDF2, not the IV
  Serial.print("aes_gcm_decrypt: Using salt for PBKDF2: ");
  for (int i = 0; i < 4; i++) {
    Serial.print(salt[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
#endif

  uint8_t key[32];
  if (!pbkdf2_sha256((const uint8_t*)masterPw, strlen(masterPw), salt, 4, PBKDF2_ITERATIONS, key, sizeof(key))) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("aes_gcm_decrypt: PBKDF2 failed");
#endif
    secure_memzero(key, sizeof(key));
    return false;
  }
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("aes_gcm_decrypt: PBKDF2 key derivation successful");
#endif

  mbedtls_gcm_context gcm;
  mbedtls_gcm_init(&gcm);

  int ret = mbedtls_gcm_setkey(&gcm, MBEDTLS_CIPHER_ID_AES, key, 256);
  if (ret != 0) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("aes_gcm_decrypt: GCM setkey failed, error: ");
    Serial.println(ret);
#endif
    mbedtls_gcm_free(&gcm);
    secure_memzero(key, sizeof(key));
    secure_memzero(iv, sizeof(iv));
    return false;
  }
#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("aes_gcm_decrypt: GCM setkey successful");
#endif

  // Extract tag from end of ciphertext
  uint8_t tag[16];
  memcpy(tag, ciphertext + ciphertext_len - 16, 16);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("aes_gcm_decrypt: Extracted tag: ");
  for (int i = 0; i < 16; i++) {
    Serial.print(tag[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
#endif

  // Extract encrypted data (everything between IV and tag)
  size_t encrypted_data_len = ciphertext_len - 12 - 16;
  const uint8_t* encrypted_data = ciphertext + 12;

#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("aes_gcm_decrypt: Encrypted data length: ");
  Serial.println(encrypted_data_len);
  Serial.print("aes_gcm_decrypt: Expected plaintext length: ");
  Serial.println(*plaintext_len);
#endif

  if (*plaintext_len < encrypted_data_len) {
#if SEEDMASK_CRYPTO_DEBUG
    Serial.println("aes_gcm_decrypt: Plaintext buffer too small");
#endif
    mbedtls_gcm_free(&gcm);
    secure_memzero(key, sizeof(key));
    secure_memzero(iv, sizeof(iv));
    secure_memzero(tag, sizeof(tag));
    return false;
  }

#if SEEDMASK_CRYPTO_DEBUG
  Serial.println("aes_gcm_decrypt: Starting GCM authenticated decrypt...");
#endif
  ret = mbedtls_gcm_auth_decrypt(&gcm, encrypted_data_len, iv, 12, NULL, 0, tag, 16, encrypted_data, plaintext);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("aes_gcm_decrypt: GCM decrypt result: ");
  Serial.println(ret);
#endif

  if (ret == 0) {
    *plaintext_len = encrypted_data_len;
#if SEEDMASK_CRYPTO_DEBUG
    Serial.print("aes_gcm_decrypt: Final plaintext_len = ");
    Serial.println(*plaintext_len);
#endif
  } else {
    if (plaintext && encrypted_data_len) secure_memzero(plaintext, encrypted_data_len);
  }

  mbedtls_gcm_free(&gcm);
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("aes_gcm_decrypt: Decryption ");
  Serial.println(ret == 0 ? "SUCCESS" : "FAILED");
#endif
  secure_memzero(key, sizeof(key));
  secure_memzero(iv, sizeof(iv));
  secure_memzero(tag, sizeof(tag));
  return ret == 0;
}

// ---- Screen lock: optional PIN (6 digits) or separate lock password unwraps g_masterPw at LOCKED; vault blob unchanged. ----
static void screen_lock_load_prefs() {
  memset(g_pinSalt, 0, sizeof(g_pinSalt));
  g_pinWrapBlobLen = 0;
  memset(g_pinWrapBlobStore, 0, sizeof(g_pinWrapBlobStore));
  g_screenLockUsesPin = false;
  g_screenLockSeparatePw = false;
  Preferences prefs;
  prefs.begin("seedmask", true);
  uint8_t slMode = prefs.getUChar("sl_pin", 0);
  if (slMode != 1 && slMode != 2) {
    prefs.end();
    return;
  }
  if (prefs.getBytesLength("sl_salt") != 16) {
    prefs.end();
    return;
  }
  prefs.getBytes("sl_salt", g_pinSalt, 16);
  size_t wlen = prefs.getBytesLength("sl_wrap");
  if (wlen == 0 || wlen > sizeof(g_pinWrapBlobStore)) {
    prefs.end();
    return;
  }
  prefs.getBytes("sl_wrap", g_pinWrapBlobStore, wlen);
  g_pinWrapBlobLen = wlen;
  if (slMode == 1) g_screenLockUsesPin = true;
  else g_screenLockSeparatePw = true;
  prefs.end();
}

static void screen_lock_clear_pin_mode() {
  g_screenLockUsesPin = false;
  g_screenLockSeparatePw = false;
  g_pinWrapBlobLen = 0;
  secure_memzero(g_pinWrapBlobStore, sizeof(g_pinWrapBlobStore));
  secure_memzero(g_pinSalt, sizeof(g_pinSalt));
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar("sl_pin", 0);
  prefs.remove("sl_wrap");
  prefs.remove("sl_salt");
  prefs.end();
}

/** NVS: restore/create reached lock setup but PIN/password wrap not saved yet. */
static void screen_lock_set_setup_required(bool required) {
  Preferences prefs;
  prefs.begin("seedmask", false);
  if (required) prefs.putUChar("sl_req", 1);
  else prefs.remove("sl_req");
  prefs.end();
}

static bool screen_lock_setup_required(void) {
  Preferences prefs;
  prefs.begin("seedmask", true);
  const uint8_t v = prefs.getUChar("sl_req", 0);
  prefs.end();
  return v != 0;
}

/** Boot: incomplete onboard lock must not leave a vault unlockable with backup/vault password. */
static void discard_incomplete_onboard_lock_vault(void) {
  nvs_clear_vault();
  nvs_clear_vault_pw();
  screen_lock_set_setup_required(false);
  g_hasVault = false;
}

static bool screen_lock_pin_unwrap(const char* pin6, char* outMaster, size_t cap) {
  if (strlen(pin6) != 6 || !g_screenLockUsesPin || g_pinWrapBlobLen < 28) return false;
  for (int i = 0; i < 6; i++) {
    if (pin6[i] < '0' || pin6[i] > '9') return false;
  }
  uint8_t key[32];
  if (!pbkdf2_sha256((const uint8_t*)pin6, 6, g_pinSalt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t ptlen = cap;
  bool ok = aes_gcm_decrypt_with_key(key, g_pinWrapBlobStore, g_pinWrapBlobLen, (uint8_t*)outMaster, &ptlen);
  secure_memzero(key, sizeof(key));
  if (!ok || ptlen == 0 || ptlen >= cap) {
    if (outMaster) secure_memzero(outMaster, cap);
    return false;
  }
  // Wrap uses aes_gcm_encrypt_with_key(..., strlen(master)+1, ...) so decrypted length includes the
  // terminating NUL. strnlen(outMaster, *) counts characters before the first NUL — it is ptlen-1 for a
  // normal string, so comparing strnlen to ptlen always failed and rejected every correct PIN.
  if (outMaster[ptlen - 1] != '\0') {
    secure_memzero(outMaster, cap);
    return false;
  }
  if (ptlen < cap) outMaster[ptlen] = '\0';
  return true;
}

static bool screen_lock_pin_wrap_and_save(const char* pin6) {
  if (strlen(pin6) != 6 || !g_masterPw[0]) return false;
  for (int i = 0; i < 6; i++) {
    if (pin6[i] < '0' || pin6[i] > '9') return false;
  }
  bool needSalt = true;
  for (size_t i = 0; i < sizeof(g_pinSalt); i++) {
    if (g_pinSalt[i] != 0) {
      needSalt = false;
      break;
    }
  }
  if (needSalt) esp_fill_random(g_pinSalt, 16);
  uint8_t key[32];
  if (!pbkdf2_sha256((const uint8_t*)pin6, 6, g_pinSalt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t plen = strlen(g_masterPw) + 1;
  size_t ctlen = sizeof(g_pinWrapBlobStore);
  if (!aes_gcm_encrypt_with_key(key, (const uint8_t*)g_masterPw, plen, g_pinWrapBlobStore, &ctlen)) {
    secure_memzero(key, sizeof(key));
    return false;
  }
  secure_memzero(key, sizeof(key));
  g_pinWrapBlobLen = ctlen;
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar("sl_pin", 1);
  prefs.putBytes("sl_salt", g_pinSalt, 16);
  prefs.putBytes("sl_wrap", g_pinWrapBlobStore, g_pinWrapBlobLen);
  prefs.end();
  g_screenLockUsesPin = true;
  g_screenLockSeparatePw = false;
  screen_lock_set_setup_required(false);
  return true;
}

static bool screen_lock_separate_pw_unwrap(const char* lockPw, char* outMaster, size_t cap) {
  if (!lockPw || !lockPw[0] || !g_screenLockSeparatePw || g_pinWrapBlobLen < 28) return false;
  uint8_t key[32];
  size_t lpLen = strlen(lockPw);
  if (!pbkdf2_sha256((const uint8_t*)lockPw, lpLen, g_pinSalt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t ptlen = cap;
  bool ok = aes_gcm_decrypt_with_key(key, g_pinWrapBlobStore, g_pinWrapBlobLen, (uint8_t*)outMaster, &ptlen);
  secure_memzero(key, sizeof(key));
  if (!ok || ptlen == 0 || ptlen >= cap) {
    if (outMaster) secure_memzero(outMaster, cap);
    return false;
  }
  if (outMaster[ptlen - 1] != '\0') {
    secure_memzero(outMaster, cap);
    return false;
  }
  if (ptlen < cap) outMaster[ptlen] = '\0';
  return true;
}

static bool screen_lock_separate_pw_wrap_and_save(const char* lockPw) {
  if (!lockPw || strlen(lockPw) < SCREEN_LOCK_SEP_PW_MIN_LEN || !g_masterPw[0]) return false;
  esp_fill_random(g_pinSalt, 16);
  uint8_t key[32];
  size_t lpLen = strlen(lockPw);
  if (!pbkdf2_sha256((const uint8_t*)lockPw, lpLen, g_pinSalt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t plen = strlen(g_masterPw) + 1;
  size_t ctlen = sizeof(g_pinWrapBlobStore);
  if (!aes_gcm_encrypt_with_key(key, (const uint8_t*)g_masterPw, plen, g_pinWrapBlobStore, &ctlen)) {
    secure_memzero(key, sizeof(key));
    return false;
  }
  secure_memzero(key, sizeof(key));
  g_pinWrapBlobLen = ctlen;
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar("sl_pin", 2);
  prefs.putBytes("sl_salt", g_pinSalt, 16);
  prefs.putBytes("sl_wrap", g_pinWrapBlobStore, g_pinWrapBlobLen);
  prefs.end();
  g_screenLockUsesPin = false;
  g_screenLockSeparatePw = true;
  screen_lock_set_setup_required(false);
  return true;
}

static void onboard_lock_clear_cred() {
  secure_memzero(g_onboardLockCred, sizeof(g_onboardLockCred));
  g_onboardLockIsPin = false;
}

static bool onboard_rewrap_lock_for_master() {
  if (!g_masterPw[0] || !g_onboardLockCred[0]) return false;
  if (g_onboardLockIsPin) return screen_lock_pin_wrap_and_save(g_onboardLockCred);
  return screen_lock_separate_pw_wrap_and_save(g_onboardLockCred);
}

/** Internal vault master (random) + NVS store in stateful mode; used by CREATE and seed-only RESTORE. */
static bool onboard_ensure_vault_from_words(const char seedWords[][16], uint8_t wc, bool allowReuseExisting) {
  if (allowReuseExisting && g_hasVault && g_masterPw[0] && g_loggedIn) return true;
  if (!(wc == 12 || wc == 24) || !seedWords) {
    setMsg("Seed not ready");
    return false;
  }
  // Copy first: restore passes g_seed, and session_login_from_seed memset's g_seed before copy.
  char wordsCopy[24][16];
  memset(wordsCopy, 0, sizeof(wordsCopy));
  for (uint8_t i = 0; i < wc; i++) {
    strncpy(wordsCopy[i], seedWords[i], 15);
    wordsCopy[i][15] = 0;
  }

  char randPw[33];
  uint8_t raw[32];
  esp_fill_random(raw, sizeof(raw));
  static const char alphabet[] =
    "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@$%*?";
  const size_t alen = sizeof(alphabet) - 1;
  for (int i = 0; i < 32; i++) randPw[i] = alphabet[raw[i] % alen];
  randPw[32] = 0;
  secure_memzero(raw, sizeof(raw));

  // Static: avoid ~512B + crypto stack on the already-deep lock-setup call chain.
  static char s_onboardTempCode[BACKUP_CODE_MAX_BYTES];
  const bool storeNvs = !g_stateless;
  bool ok = make_backup_code_from_seed(
    (const char(*)[16])wordsCopy, wc, randPw, s_onboardTempCode, sizeof(s_onboardTempCode), storeNvs);
  secure_memzero(s_onboardTempCode, sizeof(s_onboardTempCode));
  if (!ok) {
    secure_memzero(randPw, sizeof(randPw));
    secure_memzero(wordsCopy, sizeof(wordsCopy));
    if (!g_msg[0] || strcmp(g_msg, "Saving...") == 0) setMsg("Vault save failed");
    return false;
  }
  strncpy(g_masterPw, randPw, sizeof(g_masterPw) - 1);
  g_masterPw[sizeof(g_masterPw) - 1] = 0;
  secure_memzero(randPw, sizeof(randPw));
  session_login_from_seed((const char(*)[16])wordsCopy, wc, "");
  secure_memzero(wordsCopy, sizeof(wordsCopy));
  return true;
}

static bool onboard_ensure_create_vault_from_seedgen() {
  return onboard_ensure_vault_from_words((const char(*)[16])g_seedGen, g_wc, true);
}

/** Seed-only restore (typed words / SeedQR): always create vault for the active session seed. */
static bool onboard_ensure_restore_vault_from_session_seed() {
  return onboard_ensure_vault_from_words((const char(*)[16])g_seed, g_wc, false);
}

static void show_onboard_lock_setup(bool afterCreateSeed) {
  g_onboardLockFlow = true;
  g_onboardLockAfterCreate = afterCreateSeed;
  onboard_lock_clear_cred();
  g_pinSetupPhase = 0;
  g_pinSetupIsChanging = false;
  g_pinFirstEntry[0] = 0;
  g_secLockPwSetupPhase = 0;
  g_secLockPwReauthPending = false;
  g_secLockPwSetupMoreOpen = false;
  g_screenLockPwFirst[0] = 0;
  clearPassword(g_password1);
  clearPassword(g_password2);
  setMsg("");
  // Until PIN/password wrap is saved, reboot must not unlock with backup/vault password.
  screen_lock_set_setup_required(true);
  show(UIScreen::CREATE_LOCK_TYPE);
}

/** True while onboarding requires PIN/password lock before main UI (restore, or create mid-lock). */
static bool onboard_lock_setup_incomplete(void) {
  return g_onboardLockFlow && !g_screenLockUsesPin && !g_screenLockSeparatePw;
}

static bool g_restorePwNvsPending = false;

static void show_menu_or_onboard_lock_after_restore() {
  // Restore replaces wallet secrets. Drop any previous screen lock so reboot cannot
  // unlock with only the backup/vault password (or a stale wrap from another wallet).
  screen_lock_clear_pin_mode();
  // Drop prior flash vault immediately. Seed-only restores (typed / SeedQR) have no
  // master yet — vault is written when lock is set. Backup-code restores keep g_masterPw
  // in RAM and re-persist in onboard_finish / ensure_stateful_restore_seed_persisted.
  nvs_clear_vault();
  nvs_clear_vault_pw();
  g_hasVault = false;
  show_onboard_lock_setup(false);
}

static void onboard_finish_lock_setup_success() {
  clearPassword(g_password1);
  clearPassword(g_password2);
  g_pinSetupPhase = 0;
  g_pinSetupIsChanging = false;
  g_pinFirstEntry[0] = 0;
  g_secLockPwSetupPhase = 0;
  g_secLockPwReauthPending = false;
  g_secLockPwSetupMoreOpen = false;
  g_screenLockPwFirst[0] = 0;
  setMsg("");
  if (g_onboardLockAfterCreate) {
    show(UIScreen::CREATE_BACKUP_OPT);
  } else {
    // Persist restored seed (and optional PW vault) only after screen lock exists.
    if (!g_stateless && g_masterPw[0] && g_loggedIn) {
      if (!g_hasVault)
        (void)ensure_stateful_restore_seed_persisted();
      if (g_restorePwNvsPending) {
        save_passwords_notes_to_nvs();
        g_restorePwNvsPending = false;
      }
    }
    screen_lock_set_setup_required(false);
    onboard_lock_clear_cred();
    g_onboardLockFlow = false;
    show(UIScreen::MENU);
  }
}

