// Bitcoin mainnet (coin 0) path shown in export UI; matches btc_account_xpub / btc_multisig_xpub.
static void format_xpub_deriv_path(char* buf, size_t bufLen, AddrType t, bool multisigExport, uint32_t account) {
  if (multisigExport) {
    switch (t) {
      case AddrType::P2WPKH:
        snprintf(buf, bufLen, "m/48'/0'/%lu'/2'", (unsigned long)account);
        break;
      case AddrType::P2SH_P2WPKH:
        snprintf(buf, bufLen, "m/48'/0'/%lu'/1'", (unsigned long)account);
        break;
      case AddrType::P2PKH:
        snprintf(buf, bufLen, "m/45'/%lu", (unsigned long)account);
        break;
      default:
        snprintf(buf, bufLen, "—");
        break;
    }
  } else {
    uint32_t purpose = (t == AddrType::P2PKH) ? 44u : (t == AddrType::P2SH_P2WPKH ? 49u : (t == AddrType::P2TR ? 86u : 84u));
    snprintf(buf, bufLen, "m/%lu'/0'/%lu'", (unsigned long)purpose, (unsigned long)account);
  }
}

// BIP44 coin type in path display / derivation (0' mainnet, 1' testnet). Keep in sync with derive_btc_node_to_chain.
static uint32_t btc_address_path_coin_hardened(void) {
  // When testnet is enabled app-wide, return 1u here and use 1 in bip32_ckd_priv(..., coin, true) after purpose.
  return 0u;
}

// Full receive/change leaf path; matches derive_btc_node_for_index() (coin step currently mainnet-only).
static void format_btc_leaf_deriv_path(char* buf, size_t bufLen, AddrType t, uint32_t account, uint32_t chain,
                                       uint32_t index) {
  uint32_t purpose =
    (t == AddrType::P2PKH) ? 44u : (t == AddrType::P2SH_P2WPKH ? 49u : (t == AddrType::P2TR ? 86u : 84u));
  uint32_t coin = btc_address_path_coin_hardened();
  snprintf(buf, bufLen, "m/%lu'/%lu'/%lu'/%lu/%lu", (unsigned long)purpose, (unsigned long)coin,
           (unsigned long)account, (unsigned long)chain, (unsigned long)index);
}

