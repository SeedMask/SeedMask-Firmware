/** Magnifier overlay for Receive/Change QR search icon only (Addresses list uses envelope alone). */
static void drawAddrQrMagnifierOverlay(const Rect& r) {
  const int bx = (int)r.x + ((int)r.w - ADDR_ICON_ENVELOPE_W) / 2;
  const int by = (int)r.y + ((int)r.h - ADDR_ICON_ENVELOPE_H) / 2;
  const int mx = bx + ADDR_ICON_ENVELOPE_W - ADDR_QR_MAGNIFIER_W + 5;
  const int my = by + ADDR_ICON_ENVELOPE_H - ADDR_QR_MAGNIFIER_H + 3;
  gfx->startWrite();
  for (int row = 0; row < ADDR_QR_MAGNIFIER_H; row++) {
    for (int col = 0; col < ADDR_QR_MAGNIFIER_W; col++) {
      uint16_t c = pgm_read_word(&ADDR_QR_MAGNIFIER_RGB565[(uint32_t)row * (uint32_t)ADDR_QR_MAGNIFIER_W + (uint32_t)col]);
      if (c == ADDR_QR_MAGNIFIER_CHROMA_KEY) continue;
      gfx->writePixel((int16_t)(mx + col), (int16_t)(my + row), c);
    }
  }
  gfx->endWrite();
}

