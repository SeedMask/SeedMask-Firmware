static void drawCryptoTxSdBrowse() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Load transaction", true);
  gfx->setTextColor(RGB565_LIGHTGREY);
  gfx->setTextSize(1);
  gfx->setCursor(10, 48);
