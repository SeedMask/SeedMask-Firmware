    memset(g_tmpUser, 0, sizeof(g_tmpUser));
    memset(g_tmpWebsite, 0, sizeof(g_tmpWebsite));
    memset(g_tmpPwNotes, 0, sizeof(g_tmpPwNotes));
    exitEditor();
    show(UIScreen::PASSWORDS);
    draw();
    return;
  }
  setMsg("");
  if (g_viewPwIndex < pwSvc_getCount()) {
    strncpy(g_tmpPwValue, pwSvc_getValueCStr(g_viewPwIndex), sizeof(g_tmpPwValue) - 1);
