/** Address index (size 2) + derivation path (size 1), right-aligned just left of the envelope hit rect. */
static void drawAddressQrMetaBesideEnvelope(int16_t sx, int16_t sy, int16_t sh) {
  char pathLine[56];
  char titleLine[28];
  if (g_addrQrFromMultisigReceive) {
    snprintf(titleLine, sizeof(titleLine), "Address #%lu", (unsigned long)g_addrQrIndex);
    snprintf(pathLine, sizeof(pathLine), "Multisig %s #%lu", g_addrChain == 0 ? "receive" : "change",
             (unsigned long)g_addrQrIndex);
  } else {
    format_btc_leaf_deriv_path(pathLine, sizeof(pathLine), g_addrType, g_addrAccount, g_addrChain, g_addrQrIndex);
    snprintf(titleLine, sizeof(titleLine), "Address #%lu", (unsigned long)g_addrQrIndex);
  }
  const uint8_t titleSz = 2;
  const int titleCharW = 6 * (int)titleSz;
  const int titleLineH = 18;
  const uint8_t pathSz = 1;
  const int pathCharW = 6 * (int)pathSz;
  const int pathLineSkip = 10;
  const int gapToEnv = 4;
  const int leftMin = 8;
  const int metaRight = (int)sx - gapToEnv;
  int maxPathChars = (metaRight - leftMin) / pathCharW;
  if (maxPathChars < 12) maxPathChars = 12;

  const size_t plen = strlen(pathLine);
  int pathLineCount = (int)((plen + (size_t)maxPathChars - 1) / (size_t)maxPathChars);
  if (pathLineCount < 1) pathLineCount = 1;
  const int totalH = titleLineH + pathLineCount * pathLineSkip;
  int y0 = (int)sy + ((int)sh - totalH) / 2;
  if (y0 < (int)sy) y0 = (int)sy;

  gfx->setTextSize(titleSz);
  gfx->setTextColor(RGB565_WHITE);
  {
    const int tw = (int)strlen(titleLine) * titleCharW;
    int tx = metaRight - tw;
    if (tx < leftMin) tx = leftMin;
    gfx->setCursor((int16_t)tx, (int16_t)y0);
    gfx->print(titleLine);
  }
  gfx->setTextSize(pathSz);
  gfx->setTextColor(RGB565_BITCOIN_ORANGE);
  int py = y0 + titleLineH;
  for (size_t off = 0; off < plen; off += (size_t)maxPathChars) {
    size_t chunk = plen - off;
    if (chunk > (size_t)maxPathChars) chunk = (size_t)maxPathChars;
    char buf[56];
    memcpy(buf, pathLine + off, chunk);
    buf[chunk] = 0;
    const int pw = (int)chunk * pathCharW;
    int px = metaRight - pw;
    if (px < leftMin) px = leftMin;
    gfx->setCursor((int16_t)px, (int16_t)py);
    gfx->print(buf);
    py += pathLineSkip;
  }
  gfx->setTextSize(1);
}

