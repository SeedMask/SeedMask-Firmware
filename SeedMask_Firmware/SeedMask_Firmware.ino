extern "C" bool seedmask_wallet_kaspa_build_utxo_script(uint32_t account, uint32_t chain, uint32_t index,
                                                        uint8_t script34[34]) {
  if (!script34 || chain > 1 || index > BTC_ADDR_MAX_INDEX) return false;
  uint8_t priv[32];
  if (!seedmask_wallet_derive_kaspa_priv(account, chain, index, priv)) return false;
  uint8_t pub[33];
  if (!secp_pubkey_compressed(priv, pub)) {
    secure_memzero(priv, sizeof(priv));
    return false;
  }
  script34[0] = 0x20;
  memcpy(script34 + 1, pub + 1, 32);
  script34[33] = 0xac;
  secure_memzero(priv, sizeof(priv));
  secure_memzero(pub, sizeof(pub));
  return true;
}

extern "C" bool seedmask_wallet_kaspa_address_for_index(uint32_t account, uint32_t chain, uint32_t index, char* out,
                                                        size_t out_len) {
  return kaspa_address_for_index(account, chain, index, out, out_len);
}

// BIP32 node at m/purpose'/111111'; parent_fp is HASH160(pub)[:4] embedded in account-level kpub.
static bool kaspa_derive_coin_type_node_for_purpose(uint32_t purpose, Bip32Node* outN, uint32_t* parent_fp) {
  if (!outN || !parent_fp) return false;
  addr_set_err("");
  if (!ensure_bip39_derived_seed_cached()) return false;
  uint8_t seed[64];
  memcpy(seed, g_bip39DerivedSeedCache, 64);
  memset(outN, 0, sizeof(*outN));
  if (!bip32_master_from_seed(seed, outN)) {
    addr_set_err("master");
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  if (!bip32_ckd_priv(outN, purpose, true)) {
    addr_set_err("ckd purpose");
    secure_memzero(outN, sizeof(*outN));
    return false;
  }
  if (!bip32_ckd_priv(outN, KASPA_BIP44_COIN_TYPE, true)) {
    addr_set_err("ckd coin");
    secure_memzero(outN, sizeof(*outN));
    return false;
  }
  uint8_t parent_pub[33];
  if (!secp_pubkey_compressed(outN->k, parent_pub)) {
    addr_set_err("parent pub");
    secure_memzero(outN, sizeof(*outN));
    return false;
  }
  uint8_t h160p[20];
  if (!hash160(parent_pub, sizeof(parent_pub), h160p)) {
    addr_set_err("hash160");
    secure_memzero(parent_pub, sizeof(parent_pub));
    secure_memzero(outN, sizeof(*outN));
    return false;
  }
  *parent_fp = ((uint32_t)h160p[0] << 24) | ((uint32_t)h160p[1] << 16) | ((uint32_t)h160p[2] << 8) | (uint32_t)h160p[3];
  secure_memzero(parent_pub, sizeof(parent_pub));
  secure_memzero(h160p, sizeof(h160p));
  return true;
}

static bool kaspa_derive_coin_type_node(Bip32Node* outN, uint32_t* parent_fp) {
  return kaspa_derive_coin_type_node_for_purpose(44, outN, parent_fp);
}

static bool kaspa_account_kpub_for_purpose(uint32_t purpose, uint32_t account, char* out, size_t outLen) {
  if (!out || outLen < 80) {
    addr_set_err("buf");
    return false;
  }
  addr_set_err("");
  Bip32Node n;
  uint32_t parent_fp = 0;
  if (!kaspa_derive_coin_type_node_for_purpose(purpose, &n, &parent_fp)) {
    return false;
  }
  if (!bip32_ckd_priv(&n, account, true)) {
    addr_set_err("ckd account");
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint8_t ver[4] = { 0x03, 0x8f, 0x33, 0x2e }; /* kpub mainnet */
  uint8_t pub[33];
  if (!secp_pubkey_compressed(n.k, pub)) {
    addr_set_err("pubkey");
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint8_t serial[78];
  memcpy(serial, ver, 4);
  serial[4] = 3;
  serial[5] = (uint8_t)((parent_fp >> 24) & 0xff);
  serial[6] = (uint8_t)((parent_fp >> 16) & 0xff);
  serial[7] = (uint8_t)((parent_fp >> 8) & 0xff);
  serial[8] = (uint8_t)(parent_fp & 0xff);
  uint32_t child_num = 0x80000000u + account;
  serial[9] = (uint8_t)((child_num >> 24) & 0xff);
  serial[10] = (uint8_t)((child_num >> 16) & 0xff);
  serial[11] = (uint8_t)((child_num >> 8) & 0xff);
  serial[12] = (uint8_t)(child_num & 0xff);
  memcpy(serial + 13, n.c, 32);
  memcpy(serial + 45, pub, 33);
  bool ok = base58check_encode(serial, sizeof(serial), out, outLen);
  if (!ok) addr_set_err("base58 kpub");
  secure_memzero(pub, sizeof(pub));
  secure_memzero(serial, sizeof(serial));
  secure_memzero(&n, sizeof(n));
  return ok;
}

static bool kaspa_account_kpub(uint32_t account, char* out, size_t outLen) {
  return kaspa_account_kpub_for_purpose(44, account, out, outLen);
}

static bool kaspa_multisig_account_kpub(uint32_t account, char* out, size_t outLen) {
  return kaspa_account_kpub_for_purpose(45, account, out, outLen);
}

static bool kaspa_imported_kpub_matches_purpose(uint32_t purpose, uint32_t account, const char* imported58) {
  if (!imported58 || !imported58[0]) return false;
  char local[120];
  if (kaspa_account_kpub_for_purpose(purpose, account, local, sizeof(local)) && strcmp(local, imported58) == 0) {
    secure_memzero(local, sizeof(local));
    return true;
  }
  secure_memzero(local, sizeof(local));
  uint8_t dec[78];
  if (!base58check_decode_payload(imported58, dec, 78)) return false;
  uint8_t ichain[32];
  uint8_t ipub[33];
  memcpy(ichain, dec + 13, 32);
  memcpy(ipub, dec + 45, 33);
  secure_memzero(dec, sizeof(dec));
  Bip32Node n;
  uint32_t parent_fp = 0;
  if (!kaspa_derive_coin_type_node_for_purpose(purpose, &n, &parent_fp)) {
    secure_memzero(ichain, sizeof(ichain));
    secure_memzero(ipub, sizeof(ipub));
    return false;
  }
  (void)parent_fp;
  if (!bip32_ckd_priv(&n, account, true)) {
    secure_memzero(&n, sizeof(n));
    secure_memzero(ichain, sizeof(ichain));
    secure_memzero(ipub, sizeof(ipub));
    return false;
  }
  uint8_t lpub[33];
  if (!secp_pubkey_compressed(n.k, lpub)) {
    secure_memzero(&n, sizeof(n));
    secure_memzero(ichain, sizeof(ichain));
    secure_memzero(ipub, sizeof(ipub));
    return false;
  }
  bool ok = memcmp(ichain, n.c, 32) == 0 && memcmp(ipub, lpub, 33) == 0;
  secure_memzero(&n, sizeof(n));
  secure_memzero(ichain, sizeof(ichain));
  secure_memzero(ipub, sizeof(ipub));
  secure_memzero(lpub, sizeof(lpub));
  return ok;
}

extern "C" bool seedmask_wallet_kaspa_imported_kpub_matches(uint32_t account, const char* imported58) {
  return kaspa_imported_kpub_matches_purpose(44, account, imported58)
         || kaspa_imported_kpub_matches_purpose(45, account, imported58);
}

static bool derive_btc_node_for_index(AddrType t, uint32_t account, uint32_t chain, uint32_t index, Bip32Node* outNode) {
  if (!outNode || index > BTC_ADDR_MAX_INDEX) {
    addr_set_err("bad index");
    return false;
  }
  if (!derive_btc_node_to_chain(t, account, chain, outNode)) return false;
  if (!bip32_ckd_priv(outNode, index, false)) {
    addr_set_err("ckd index");
    secure_memzero(outNode, sizeof(Bip32Node));
    return false;
  }
  return true;
}

static bool derive_btc_node_for_mnemonic(const char* mnemonic, AddrType t, uint32_t account, uint32_t chain, uint32_t index, Bip32Node* outNode) {
  if (!mnemonic || !outNode || index > BTC_ADDR_MAX_INDEX) return false;
  if (chain > 1) return false;
  uint8_t salt[8 + BIP39_PASSPHRASE_MAX_BYTES];
  memcpy(salt, "mnemonic", 8);
  size_t passLen = g_bip39HasPassphrase
                     ? strnlen(g_bip39Passphrase, sizeof(g_bip39Passphrase) - 1)
                     : 0;
  if (passLen) memcpy(salt + 8, g_bip39Passphrase, passLen);
  uint8_t seed[64];
  if (!pbkdf2_sha512((const uint8_t*)mnemonic, strlen(mnemonic), salt, 8 + passLen, 2048, seed, sizeof(seed))) {
    secure_memzero(salt, sizeof(salt));
    return false;
  }
  secure_memzero(salt, sizeof(salt));
  if (!bip32_master_from_seed(seed, outNode)) {
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  uint32_t purpose = (t == AddrType::P2PKH) ? 44 : (t == AddrType::P2SH_P2WPKH ? 49 : (t == AddrType::P2TR ? 86 : 84));
  if (!bip32_ckd_priv(outNode, purpose, true)) return false;
  if (!bip32_ckd_priv(outNode, 0, true)) return false;
  if (!bip32_ckd_priv(outNode, account, true)) return false;
  if (!bip32_ckd_priv(outNode, chain, false)) return false;
  if (!bip32_ckd_priv(outNode, index, false)) return false;
  return true;
}

// Taproot key-only spend (BIP86): tweak = int(hash("TapTweak", internal_xonly)) mod n,
// output_point = internal_point + tweak*G, address program = xonly(output_point).
static void tap_tagged_hash_taptweak_32(const uint8_t xonly32[32], uint8_t out32[32]) {
  uint8_t tagHash[32];
  sha256_once((const uint8_t*)"TapTweak", strlen("TapTweak"), tagHash);
  // taggedHash(tag, msg) = SHA256(SHA256(tag) || SHA256(tag) || msg)
  uint8_t buf[64 + 32];
  memcpy(buf, tagHash, 32);
  memcpy(buf + 32, tagHash, 32);
  memcpy(buf + 64, xonly32, 32);
  sha256_once(buf, sizeof(buf), out32);
}

static bool taproot_output_xonly_from_internal_pubkey(const uint8_t internalPub33[33], uint8_t outXonly32[32]) {
  if (!internalPub33 || !outXonly32) return false;
  if (internalPub33[0] != 0x02 && internalPub33[0] != 0x03) {
    addr_set_err("tap internal pub");
    return false;
  }

  uint8_t xonly32[32];
  memcpy(xonly32, internalPub33 + 1, 32);
  uint8_t tweakHash[32];
  tap_tagged_hash_taptweak_32(xonly32, tweakHash);

  // BIP341 lift_x(x): always the even-Y point (0x02 || x), never the raw 0x03 pubkey.
  // Tweaking the odd-Y point produces wrong bc1p addresses (~half of BIP86 indices).
  uint8_t liftXPub33[33];
  liftXPub33[0] = 0x02;
  memcpy(liftXPub33 + 1, xonly32, 32);

  mbedtls_ecp_group grp;
  mbedtls_ecp_point P, Q;
  mbedtls_mpi tweak;
  mbedtls_mpi one;
  size_t olen = 0;
  uint8_t out33[33];

  mbedtls_ecp_group_init(&grp);
  mbedtls_ecp_point_init(&P);
  mbedtls_ecp_point_init(&Q);
  mbedtls_mpi_init(&tweak);
  mbedtls_mpi_init(&one);

  bool ok = false;
  if (mbedtls_ecp_group_load(&grp, MBEDTLS_ECP_DP_SECP256K1) != 0) goto done;
  if (mbedtls_ecp_point_read_binary(&grp, &P, liftXPub33, 33) != 0) goto done;
  if (mbedtls_mpi_read_binary(&tweak, tweakHash, 32) != 0) goto done;
  if (mbedtls_mpi_mod_mpi(&tweak, &tweak, &grp.N) != 0) goto done;
  {
    uint8_t oneBytes[32] = { 0 };
    oneBytes[31] = 1;
    if (mbedtls_mpi_read_binary(&one, oneBytes, 32) != 0) goto done;
  }
  // Q = 1*P + tweak*G (compute in one shot; avoids needing mbedtls_ecp_add on this mbedtls version).
  if (mbedtls_ecp_muladd(&grp, &Q, &one, &P, &tweak, &grp.G) != 0) goto done;
  if (mbedtls_ecp_point_write_binary(&grp, &Q, MBEDTLS_ECP_PF_COMPRESSED, &olen, out33, sizeof(out33)) != 0) goto done;
  if (olen != 33) goto done;

  memcpy(outXonly32, out33 + 1, 32);
  ok = true;

done:
  secure_memzero(xonly32, sizeof(xonly32));
  secure_memzero(tweakHash, sizeof(tweakHash));
  secure_memzero(liftXPub33, sizeof(liftXPub33));
  mbedtls_mpi_free(&tweak);
  mbedtls_mpi_free(&one);
  mbedtls_ecp_point_free(&P);
  mbedtls_ecp_point_free(&Q);
  mbedtls_ecp_group_free(&grp);
  return ok;
}

// Leaf xpub → address string (shared by single-index derive and batched page fill).
static bool btc_encode_address_from_leaf_node(AddrType t, Bip32Node* n, char* out, size_t outLen) {
  uint8_t pub[33];
  if (!secp_pubkey_compressed(n->k, pub)) {
    if (!g_addrLastErr[0]) addr_set_err("pubkey");
    return false;
  }

  bool ok = false;
  if (t == AddrType::P2TR) {
    uint8_t outXonly[32];
    if (!taproot_output_xonly_from_internal_pubkey(pub, outXonly)) {
      addr_set_err("taptweak");
      goto done;
    }
    ok = bech32_encode_segwit("bc", 1, outXonly, sizeof(outXonly), out, outLen);
    if (!ok) addr_set_err("bech32m");
    secure_memzero(outXonly, sizeof(outXonly));
  } else {
    uint8_t h160[20];
    if (!hash160(pub, sizeof(pub), h160)) {
      addr_set_err("hash160");
      goto done;
    }
    if (t == AddrType::P2PKH) {
      uint8_t payload[21];
      payload[0] = 0x00;
      memcpy(payload + 1, h160, 20);
      ok = base58check_encode(payload, sizeof(payload), out, outLen);
      if (!ok) addr_set_err("base58");
      secure_memzero(payload, sizeof(payload));
    } else if (t == AddrType::P2SH_P2WPKH) {
      uint8_t redeem[22];
      redeem[0] = 0x00;
      redeem[1] = 0x14;
      memcpy(redeem + 2, h160, 20);
      uint8_t rh160[20];
      if (!hash160(redeem, sizeof(redeem), rh160)) {
        addr_set_err("redeem hash160");
        secure_memzero(redeem, sizeof(redeem));
        goto done;
      }
      uint8_t payload[21];
      payload[0] = 0x05;
      memcpy(payload + 1, rh160, 20);
      ok = base58check_encode(payload, sizeof(payload), out, outLen);
      if (!ok) addr_set_err("base58");
      secure_memzero(redeem, sizeof(redeem));
      secure_memzero(rh160, sizeof(rh160));
      secure_memzero(payload, sizeof(payload));
    } else if (t == AddrType::P2WPKH) {
      ok = bech32_encode_segwit("bc", 0, h160, sizeof(h160), out, outLen);
      if (!ok) addr_set_err("bech32");
    } else {
      addr_set_err("bad addr type");
    }
    secure_memzero(h160, sizeof(h160));
  }
done:
  secure_memzero(pub, sizeof(pub));
  return ok;
}

static bool btc_address_for_index(AddrType t, uint32_t account, uint32_t chain, uint32_t index, char* out, size_t outLen) {
  addr_set_err("");
  Bip32Node n;
  memset(&n, 0, sizeof(n));
  if (!derive_btc_node_for_index(t, account, chain, index, &n)) {
    secure_memzero(&n, sizeof(n));
    return false;
  }
  bool ok = btc_encode_address_from_leaf_node(t, &n, out, outLen);
  secure_memzero(&n, sizeof(n));
  return ok;
}

static bool btc_address_for_mnemonic(const char* mnemonic, AddrType t, uint32_t account, uint32_t chain, uint32_t index, char* out, size_t outLen) {
  Bip32Node n;
  memset(&n, 0, sizeof(n));
  if (!derive_btc_node_for_mnemonic(mnemonic, t, account, chain, index, &n)) {
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint8_t pub[33];
  if (!secp_pubkey_compressed(n.k, pub)) {
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint8_t h160[20];
  secure_memzero(h160, sizeof(h160));
  bool ok = false;
  if (t == AddrType::P2TR) {
    uint8_t outXonly[32];
    if (!taproot_output_xonly_from_internal_pubkey(pub, outXonly)) {
      addr_set_err("taptweak");
      goto done_mn;
    }
    ok = bech32_encode_segwit("bc", 1, outXonly, sizeof(outXonly), out, outLen);
    if (!ok) addr_set_err("bech32m");
    secure_memzero(outXonly, sizeof(outXonly));
  } else {
    if (!hash160(pub, sizeof(pub), h160)) {
      addr_set_err("hash160");
      goto done_mn;
    }
    if (t == AddrType::P2PKH) {
      uint8_t payload[21];
      payload[0] = 0x00;
      memcpy(payload + 1, h160, 20);
      ok = base58check_encode(payload, sizeof(payload), out, outLen);
      secure_memzero(payload, sizeof(payload));
    } else if (t == AddrType::P2SH_P2WPKH) {
      uint8_t redeem[22];
      redeem[0] = 0x00;
      redeem[1] = 0x14;
      memcpy(redeem + 2, h160, 20);
      uint8_t rh160[20];
      if (!hash160(redeem, sizeof(redeem), rh160)) {
        addr_set_err("redeem hash160");
        secure_memzero(redeem, sizeof(redeem));
        goto done_mn;
      }
      uint8_t payload[21];
      payload[0] = 0x05;
      memcpy(payload + 1, rh160, 20);
      ok = base58check_encode(payload, sizeof(payload), out, outLen);
      secure_memzero(redeem, sizeof(redeem));
      secure_memzero(rh160, sizeof(rh160));
      secure_memzero(payload, sizeof(payload));
    } else if (t == AddrType::P2WPKH) {
      ok = bech32_encode_segwit("bc", 0, h160, sizeof(h160), out, outLen);
      if (!ok) addr_set_err("bech32");
    } else {
      addr_set_err("bad addr type");
    }
  }
done_mn:
  secure_memzero(h160, sizeof(h160));
  secure_memzero(pub, sizeof(pub));
  secure_memzero(&n, sizeof(n));
  return ok;
}

static void hex4_to_upper(const uint8_t in[4], char out[9]) {
  static const char* H = "0123456789ABCDEF";
  for (uint8_t i = 0; i < 4; i++) {
    out[i * 2 + 0] = H[(in[i] >> 4) & 0x0F];
    out[i * 2 + 1] = H[in[i] & 0x0F];
  }
  out[8] = 0;
}

static bool kaspa_kpub_qr_scan_payload(uint32_t purpose, uint32_t account, const char* kpub, char* out, size_t outLen) {
  if (!out || outLen < 160 || !kpub || !kpub[0]) {
    addr_set_err("buf");
    return false;
  }
  char masterXfp[9] = { 0 };
  (void)current_master_xfp(masterXfp);
  char deriv[40];
  snprintf(deriv, sizeof(deriv), "m/%lu'/111111'/%lu'", (unsigned long)purpose, (unsigned long)account);
  int nw = snprintf(out, outLen, "SM|%s|%s|%s", masterXfp[0] ? masterXfp : "?", deriv, kpub);
  if (nw <= 0 || (size_t)nw >= outLen) {
    addr_set_err("export qr");
    return false;
  }
  return true;
}

// BIP32 account-level extended public key (xpub/ypub/zpub) for Sparrow / Passport-style import.
// Path: m / purpose' / coin' / account'  (coin = 0 mainnet)
static bool btc_account_xpub(AddrType t, uint32_t account, char* out, size_t outLen) {
  if (!out || outLen < 80) {
    addr_set_err("buf");
    return false;
  }
  addr_set_err("");
  if (!ensure_bip39_derived_seed_cached()) return false;
  uint8_t seed[64];
  memcpy(seed, g_bip39DerivedSeedCache, 64);
  Bip32Node n;
  memset(&n, 0, sizeof(n));
  if (!bip32_master_from_seed(seed, &n)) {
    addr_set_err("master");
    secure_memzero(seed, sizeof(seed));
    return false;
  }
  secure_memzero(seed, sizeof(seed));
  uint32_t purpose = (t == AddrType::P2PKH) ? 44 : (t == AddrType::P2SH_P2WPKH ? 49 : (t == AddrType::P2TR ? 86 : 84));
  if (!bip32_ckd_priv(&n, purpose, true)) {
    addr_set_err("ckd purpose");
    secure_memzero(&n, sizeof(n));
    return false;
  }
  if (!bip32_ckd_priv(&n, 0, true)) {
    addr_set_err("ckd coin");
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint8_t parent_pub[33];
  if (!secp_pubkey_compressed(n.k, parent_pub)) {
    addr_set_err("parent pub");
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint8_t h160p[20];
  if (!hash160(parent_pub, sizeof(parent_pub), h160p)) {
    addr_set_err("hash160");
    secure_memzero(parent_pub, sizeof(parent_pub));
    secure_memzero(&n, sizeof(n));
    return false;
  }
  uint32_t parent_fp = ((uint32_t)h160p[0] << 24) | ((uint32_t)h160p[1] << 16) | ((uint32_t)h160p[2] << 8) | (uint32_t)h160p[3];
  secure_memzero(parent_pub, sizeof(parent_pub));
  secure_memzero(h160p, sizeof(h160p));
  if (!bip32_ckd_priv(&n, account, true)) {
    addr_set_err("ckd account");
    secure_memzero(&n, sizeof(n));
    return false;
  }

  uint8_t ver[4];
  if (t == AddrType::P2PKH || t == AddrType::P2TR) {
    ver[0] = 0x04;
    ver[1] = 0x88;
    ver[2] = 0xb2;
    ver[3] = 0x1e;
  }  // xpub for taproot (BIP86) too
  else if (t == AddrType::P2SH_P2WPKH) {
    ver[0] = 0x04;
    ver[1] = 0x9d;
    ver[2] = 0x7c;
    ver[3] = 0xb2;
  } else {
    ver[0] = 0x04;
    ver[1] = 0xb2;
    ver[2] = 0x47;
    ver[3] = 0x46;
  }  // zpub

  uint8_t pub[33];
  if (!secp_pubkey_compressed(n.k, pub)) {
    addr_set_err("pubkey");
    secure_memzero(&n, sizeof(n));
    return false;
  }

  uint8_t serial[78];
  memcpy(serial, ver, 4);
  serial[4] = 3;
  serial[5] = (uint8_t)((parent_fp >> 24) & 0xff);
  serial[6] = (uint8_t)((parent_fp >> 16) & 0xff);
  serial[7] = (uint8_t)((parent_fp >> 8) & 0xff);
  serial[8] = (uint8_t)(parent_fp & 0xff);
  uint32_t child_num = 0x80000000u + account;
  serial[9] = (uint8_t)((child_num >> 24) & 0xff);
  serial[10] = (uint8_t)((child_num >> 16) & 0xff);
  serial[11] = (uint8_t)((child_num >> 8) & 0xff);
  serial[12] = (uint8_t)(child_num & 0xff);
  memcpy(serial + 13, n.c, 32);
  memcpy(serial + 45, pub, 33);
  secure_memzero(&n, sizeof(n));
  secure_memzero(pub, sizeof(pub));

  bool ok = base58check_encode(serial, sizeof(serial), out, outLen);
  secure_memzero(serial, sizeof(serial));
  if (!ok) addr_set_err("base58 xpub");
  return ok;
}

static void format_xpub_deriv_path(char* buf, size_t bufLen, AddrType t, bool multisigExport, uint32_t account);
