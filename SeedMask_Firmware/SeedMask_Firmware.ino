/** Finder pass only: memcpy + quirc_end + quirc_count — no ECC decode (cheap vs full ladder). */
static int vault_quirc_finder_count_only(const uint8_t* frame, size_t imgSize) {
  if (!frame || !g_q || imgSize == 0) return 0;
  uint8_t* image = quirc_begin(g_q, nullptr, nullptr);
  memcpy(image, frame, imgSize);
  quirc_end(g_q);
  return quirc_count(g_q);
}

static int kaspa_feed_ur_scan_part(const char* ur, char* err, size_t errLen);
static bool kaspa_pskt_qr_payload_looks_valid(const char* p, size_t len);

/** Copy decoded Quirc payload into outText / last-payload cache. */
static bool quirc_payload_capture(char* outText, size_t outLen) {
  if (g_qr_data.payload_len <= 0) return false;
  size_t n = min(outLen - 1, (size_t)g_qr_data.payload_len);
  s_qr_last_payload_len = min((size_t)QR_SCAN_LAST_PAYLOAD_BYTES, (size_t)g_qr_data.payload_len);
  memcpy(s_qr_last_payload, g_qr_data.payload, s_qr_last_payload_len);
  memcpy(outText, g_qr_data.payload, n);
  outText[n] = 0;
  return true;
}

static bool try_decode_frame_variant(const uint8_t* frame, size_t imgSize, char* outText, size_t outLen, const char* tag, int* outCount = nullptr) {
  if (!frame || !g_q) return false;
  uint8_t* image = quirc_begin(g_q, nullptr, nullptr);
  memcpy(image, frame, imgSize);
  quirc_end(g_q);

  int count = quirc_count(g_q);
  if (outCount) *outCount = count;
  if (count > s_qr_last_count) s_qr_last_count = count;

  const bool kaspaFeedAll = (g_qrScanTarget == QrScanTarget::CRYPTO_KASPA_PSKT);
  bool kaspaFedUr = false;

  for (int i = 0; i < count; i++) {
    quirc_extract(g_q, i, &g_qr_code);
    quirc_decode_error_t decErr = quirc_decode(&g_qr_code, &g_qr_data);
    if (decErr != QUIRC_SUCCESS) {
      quirc_flip(&g_qr_code);
      decErr = quirc_decode(&g_qr_code, &g_qr_data);
    }
    if (decErr != QUIRC_SUCCESS) continue;

    g_qr_decode_fail_streak = 0;
#if SEEDMASK_DEBUG_QUIRC
    Serial.print("quirc: decoded OK (");
    Serial.print(tag ? tag : "variant");
    Serial.print(" ");
    Serial.print(i);
    Serial.print("), payload_len=");
    Serial.println(g_qr_data.payload_len);
#endif

    if (kaspaFeedAll) {
      const char* payload = (const char*)g_qr_data.payload;
      const size_t plen = (size_t)g_qr_data.payload_len;
      if (scan_payload_looks_like_ur(payload)) {
        char urErr[128] = { 0 };
        const int urState = kaspa_feed_ur_scan_part(payload, urErr, sizeof(urErr));
        kaspaFedUr = true;
        (void)quirc_payload_capture(outText, outLen);
        if (urState == 2) {
          g_kaspaPsktScanLen = strlen(g_kaspaPsktScanBuf);
          size_t n = g_kaspaPsktScanLen;
          if (n >= outLen) n = outLen - 1;
          memcpy(outText, g_kaspaPsktScanBuf, n);
          outText[n] = 0;
          return true;
        }
        if (urState == -1) setMsg(urErr[0] ? urErr : "PSKT UR error");
        continue;
      }
      if (kaspa_pskt_qr_payload_looks_valid(payload, plen)) {
        return quirc_payload_capture(outText, outLen);
      }
      continue;
    }

    return quirc_payload_capture(outText, outLen);
  }

  if (kaspaFeedAll && kaspaFedUr) {
    outText[0] = 0;
    return true;
  }
  return false;
}

// Mean-threshold binarization is cheaper than Otsu and can help very blurry dense QRs.
static uint8_t mean_binarize(uint8_t* img, size_t len, int bias = 0) {
  if (!img || len == 0) return 127;
  size_t step = (len > 350000) ? 4 : ((len > 180000) ? 2 : 1);
  uint64_t sum = 0;
  size_t n = 0;
  for (size_t i = 0; i < len; i += step) {
    sum += img[i];
    n++;
  }
  int t = (n > 0) ? (int)(sum / n) + bias : 127;
  if (t < 0) t = 0;
  if (t > 255) t = 255;
  uint8_t th = (uint8_t)t;
  for (size_t i = 0; i < len; i++) img[i] = (img[i] >= th) ? 255 : 0;
  return th;
}

