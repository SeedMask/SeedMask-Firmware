static void pin_entry_draw_dots(int dotCy, const char* pinBuf) {
  const size_t filled = strnlen(pinBuf, 6);
  const int d = PIN_ENTRY_DOT_R * 2;
  const int totalW = 6 * d + 5 * PIN_ENTRY_DOT_GAP;
  const int x0 = (LCD_W - totalW) / 2 + PIN_ENTRY_DOT_R;
  for (int i = 0; i < 6; i++) {
    const int cx = x0 + i * (d + PIN_ENTRY_DOT_GAP);
    if ((size_t)i < filled)
      gfx->fillCircle(cx, dotCy, PIN_ENTRY_DOT_R, RGB565_WHITE);
    else {
      gfx->drawCircle(cx, dotCy, PIN_ENTRY_DOT_R, UI_BORDER);
      gfx->drawCircle(cx, dotCy, PIN_ENTRY_DOT_R - 1, UI_BORDER);
    }
  }
}

static void pin_entry_draw_numpad(int y0, int keyH, bool okButton) {
  for (int r = 0; r < SETTIME_NUMPAD_ROWS; r++) {
    for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
      const int x = c * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
      const int y = y0 + r * (keyH + SETTIME_NUMPAD_GAP);
      const Rect rect = { (int16_t)x, (int16_t)y, (int16_t)SETTIME_KEY_W, (int16_t)keyH };
      if (r == 3 && c == 0) {
        drawBtn(rect, "Del", RGB565_DARKGREY, 2);
      } else if (r == 3 && c == 2) {
        drawBtn(rect, okButton ? "OK" : "SET", RGB565_BLUE, 2);
      } else if (r == 3 && c == 1) {
        drawKeyRect(rect, "0");
      } else {
        char lab[4] = { (char)('1' + r * 3 + c), 0 };
        drawKeyRect(rect, lab);
      }
    }
  }
}

/** -1 = none; 0–8 = digits 1–9; 9 = 0; 10 = Del; 11 = OK/SET cell */
static int pin_entry_numpad_hit(uint16_t x, uint16_t y, int y0, int keyH) {
  for (int r = 0; r < SETTIME_NUMPAD_ROWS; r++) {
    for (int c = 0; c < SETTIME_NUMPAD_COLS; c++) {
      const int rx = c * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
      const int ry = y0 + r * (keyH + SETTIME_NUMPAD_GAP);
      const Rect rect = { (int16_t)rx, (int16_t)ry, (int16_t)SETTIME_KEY_W, (int16_t)keyH };
      if (!hit(rect, (int16_t)x, (int16_t)y)) continue;
      if (r == 3 && c == 0) return 10;
      if (r == 3 && c == 2) return 11;
      if (r == 3 && c == 1) return 9;
      return r * 3 + c;
    }
  }
  // Forgiving OK target (corners / calibration): only if no other key matched.
  {
    const int okX = 2 * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP);
    const int okY = y0 + 3 * (keyH + SETTIME_NUMPAD_GAP);
    const Rect okR = { (int16_t)okX, (int16_t)okY, (int16_t)SETTIME_KEY_W, (int16_t)keyH };
    if (hitPad(okR, (int16_t)x, (int16_t)y, 14)) return 11;
  }
  return -1;
}

static void pin_entry_numpad_rect_for_index(int nh, int y0, int keyH, Rect* out) {
  int r, c;
  if (nh == 10) {
    r = 3;
    c = 0;
  } else if (nh == 9) {
    r = 3;
    c = 1;
  } else if (nh == 11) {
    r = 3;
    c = 2;
  } else {
    r = nh / 3;
    c = nh % 3;
  }
  out->x = (int16_t)(c * (SETTIME_KEY_W + SETTIME_NUMPAD_GAP));
  out->y = (int16_t)(y0 + r * (keyH + SETTIME_NUMPAD_GAP));
  out->w = (int16_t)SETTIME_KEY_W;
  out->h = (int16_t)keyH;
}

