    drawBtn(BTN_CRYPTO_SCAN_BACK, "Done", RGB565_DARKGREY, 2);
    ui_flush();
    return;
  }
  gfx->setCursor(10, 52);
  if (g_toolsVerifyFound) {
    gfx->setTextColor(RGB565_GREEN);
    gfx->print("Verified");
    {
      const int ckx = 10 + 8 * 6 + 4;
      const int cky = 58;
      for (int t = 0; t < 2; t++) {
        gfx->drawLine(ckx + t, cky + 4, ckx + 4 + t, cky + 8, RGB565_GREEN);
        gfx->drawLine(ckx + 4 + t, cky + 8, ckx + 14 + t, cky - 2, RGB565_GREEN);
      }
    }
    gfx->setTextColor(RGB565_WHITE);
    if (g_toolsVerifyIsMultisig && g_multisigWalletNames) {
      gfx->setTextColor(RGB565_LIGHTGREY);
      gfx->setCursor(10, 64);
      gfx->print("Multisig");
      const char* wn = g_multisigWalletNames[g_toolsVerifyMsMatchStoredIdx];
      if (wn && wn[0]) {
        gfx->setTextColor(RGB565_WHITE);
        drawWrappedLabelText(wn, 10, 78, 28, 12, 118);
      }
      drawWrappedLabelText(g_toolsVerifyWant, 10, 120, 26, 12, 380);
    } else {
      drawWrappedLabelText(g_toolsVerifyWant, 10, 76, 26, 12, 380);
    }
  } else {
    gfx->setTextColor(RGB565_YELLOW);
    if (!g_toolsVerifyWant[0]) {
      gfx->print("No Bitcoin address found in QR.");
    } else {
      gfx->print("No match in first 500 indices (singlesig or multisig).");
    }
    gfx->setTextColor(RGB565_CYAN);
    gfx->setCursor(10, 118);
    gfx->print("Scanned:");
    gfx->setTextColor(RGB565_WHITE);
    {
      const char* p = g_toolsQrPayload;
      size_t len = strlen(p);
      int row = 132;
      size_t off = 0;
      while (off < len && row < 360) {
        char line[44];
        size_t chunk = len - off;
        if (chunk > 40) chunk = 40;
        memcpy(line, p + off, chunk);
        line[chunk] = 0;
        gfx->setCursor(10, row);
        gfx->print(line);
        off += chunk;
        row += 12;
      }
    }
  }
  drawBtn(BTN_CRYPTO_SCAN_BACK, "Done", RGB565_DARKGREY, 2);
  ui_flush();
}

