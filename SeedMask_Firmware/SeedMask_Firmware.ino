// Static buffers for restore/unlock paths to avoid stack overflow in loopTask (8KB default)
static char s_restore_loadedCode[256];
static char s_restore_out[24][16];
static char s_restore_backupCode[BACKUP_CODE_MAX_BYTES];
static char s_restore_original_bc_file[64];

/** Temporary seed → typed backup code or encrypted/plain QR (+password): mnemonic only; never replace main vault. */
static bool restore_password_apply_temp_seed_if_requested(const char (*words)[16], uint8_t wc) {
  if (g_tempSeedImportMode != TempSeedImportMode::BACKUP_CODE) return false;
  if (!temp_seed_set_from_words(words, wc, (uint8_t)TempSeedActiveSource::BACKUP_CODE)) {
    g_tempSeedImportMode = TempSeedImportMode::NONE;
    g_cryptoTempSeedBackupRestoreFlow = false;
    if (g_msg[0] == 0) setMsg("Could not set temporary seed");
    draw();
    return true;
  }
  g_tempSeedImportMode = TempSeedImportMode::NONE;
  g_cryptoTempSeedBackupRestoreFlow = false;
  setMsg("Temporary seed active");
  show(UIScreen::CRYPTO_TEMP_SEED);
  return true;
}

static void handleRestorePasswordTap(uint16_t x, uint16_t y) {

  // Keyboard first: if tap is on a key, handle it and never treat as BACK/OK
  char c = keyboardHit(x, y);
  if (c) {
    if (g_kbMode == KBMode::LETTERS && g_shift && c >= 'a' && c <= 'z') {
      c = (char)(c - 'a' + 'A');
      if (g_shift == 1) g_shift = 0;
    }
    if (c == '\b') backspaceStr(g_password1, sizeof(g_password1));
    else appendChar(g_password1, sizeof(g_password1), c);
    draw();
    return;
  }
  if (g_password1[0] && hit(BTN_PW_SHOWHIDE, x, y)) {
    g_pwMasked = !g_pwMasked;
    draw();
    return;
  }
  // OK (keyboard OK key) — handle before "tap in keyboard" so OK is still processed
  if (hitOkKey(x, y)) {
    // SD decrypt sets this while PBKDF2/AES run; ignore duplicate OK (would fall through to manual restore).
    if (strstr(g_msg, "Validating")) {
      return;
    }

    // ---------- QR: encrypted full vault (SPE1|base64) — decrypt then parse as SP2 ----------
    if (strstr(g_msg, "QR OK") && strlen(g_password1) >= 4 && strncmp(g_restoreFull, "SPE1|", 5) == 0) {
      if (!g_restoreSpe1_decBuf || !g_restoreSpe1_plainBuf || !g_restoreSpe1_decompBuf) {
        setMsg("Memory low");
        draw();
        return;
      }
      const char* b64 = g_restoreFull + 5;
      // Multi-part vault QR: decoded blob can be several KB (was 1024 → truncated / failed restore).
      uint8_t* decBuf = g_restoreSpe1_decBuf;
      size_t blob_len = base64_decode(b64, decBuf, RESTORE_SPE1_DEC_BYTES);
      if (blob_len < 8 + 28) {  // need at least salt(4)+len(4)+iv(12)+tag(16)
        setMsg("Invalid encrypted QR");
        draw();
        return;
      }
      uint8_t* salt = decBuf;
      uint32_t ct_len;
      memcpy(&ct_len, decBuf + 4, 4);
      if (ct_len > RESTORE_SPE1_DEC_BYTES - 8 || ct_len < 28) {
        setMsg("Invalid encrypted QR");
        draw();
        return;
      }
      if (blob_len != 8 + ct_len) {
        setMsg("Corrupted or incomplete QR");
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      uint8_t* ct = decBuf + 8;
      uint8_t* plainBuf = g_restoreSpe1_plainBuf;
      size_t plainLen = RESTORE_SPE1_PLAIN_BYTES;
      if (!aes_gcm_decrypt(g_password1, salt, ct, ct_len, plainBuf, &plainLen)) {
        setMsg("Wrong password or corrupted QR");
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      if (plainLen < 2) {
        setMsg("Invalid QR content");
        draw();
        return;
      }
      // Decompressed vault text (passwords+notes+2FA) can be much larger than compressed ciphertext.
      uint8_t* decompBuf = g_restoreSpe1_decompBuf;
      const uint8_t* toParse;
      size_t parseLen;
      if (plainBuf[0] == 1) {
        size_t dlen = vault_decompress(plainBuf + 1, plainLen - 1, decompBuf, RESTORE_SPE1_DECOMP_BYTES);
        if (dlen == 0) {
          setMsg("Invalid QR content");
          draw();
          return;
        }
        decompBuf[dlen] = 0;
        toParse = decompBuf;
        parseLen = dlen;
      } else {
        plainBuf[plainLen] = 0;
        toParse = plainBuf + 1;
        parseLen = plainLen - 1;
      }
      if (parseLen < 7 || strncmp((char*)toParse, "SP2|", 4) != 0) {
        setMsg("Invalid QR content");
        draw();
        return;
      }
      const char* p = (const char*)toParse + 4;
      const char* q = strchr(p, '|');
      if (!q || (size_t)(q - p) >= BACKUP_CODE_MAX_BYTES) {
        setMsg("Invalid QR format");
        draw();
        return;
      }
      size_t bcLen = (size_t)(q - p);
      if (bcLen >= sizeof(s_restore_backupCode)) bcLen = sizeof(s_restore_backupCode) - 1;
      memcpy(s_restore_backupCode, p, bcLen);
      s_restore_backupCode[bcLen] = 0;
      // restore_seed_from_backup_code expects "SPB1-..." ; if vault stored raw base32, prepend prefix
      if (strncmp(s_restore_backupCode, "SPB1-", 5) != 0 && strncmp(s_restore_backupCode, "spb1-", 5) != 0) {
        char tmp[BACKUP_CODE_MAX_BYTES];
        strncpy(tmp, s_restore_backupCode, sizeof(tmp) - 6);
        tmp[sizeof(tmp) - 6] = 0;
        snprintf(s_restore_backupCode, sizeof(s_restore_backupCode), "SPB1-%s", tmp);
      }
      const char* pwPart = q + 1;
      size_t pwPartLen = ((const uint8_t*)toParse + parseLen) - (const uint8_t*)pwPart;

      Serial.print("SPE1 restore: parseLen=");
      Serial.print(parseLen);
      Serial.print(", pwPartLen=");
      Serial.println(pwPartLen);

      uint8_t wc = 12;
      bool ok = restore_seed_from_backup_code(s_restore_backupCode, g_password1, s_restore_out, wc, true);
      if (!ok) {
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      if (restore_password_apply_temp_seed_if_requested((const char(*)[16])s_restore_out, wc)) return;
      pwSvc_clearAll();
      strncpy(g_backupCode, s_restore_backupCode, sizeof(g_backupCode) - 1);
      g_backupCode[sizeof(g_backupCode) - 1] = 0;
      strncpy(g_masterPw, g_password1, sizeof(g_masterPw) - 1);
      g_masterPw[sizeof(g_masterPw) - 1] = 0;
      session_login_from_seed((const char(*)[16])s_restore_out, wc, g_backupCode);
      portable_backup_set_from_code(g_backupCode);
      // Keep vault QR stable after restore: reuse exactly scanned SPE1 payload.
      // This avoids random re-encryption (new salt) when simply viewing QR backup.
      size_t restoredLen = strlen(g_restoreFull);
      if (restoredLen < VAULT_QR_PAYLOAD_MAX_BYTES) {
        memcpy(g_vaultQrPayload, g_restoreFull, restoredLen + 1);
        g_vaultQrPartCount = 1;
        g_vaultQrPartIndex = 0;
        g_vaultQrDirty = false;
      } else {
        // Fallback: payload too large for single buffer; force rebuild on demand.
        g_vaultQrPayload[0] = 0;
        g_vaultQrDirty = true;
      }

      const char* notesSep = strstr(pwPart, "\n---N---\n");
      const char* totpSep = strstr(pwPart, "\n---T---\n");
      if (notesSep && (size_t)(notesSep - pwPart) <= pwPartLen) {
        size_t pwLen = (size_t)(notesSep - pwPart);
        vault_import_passwords_plaintext(pwPart, pwLen);
        const char* afterN = notesSep + 9;
        if (totpSep && totpSep >= afterN) {
          notes_deserialize_plain(afterN, (size_t)(totpSep - afterN));
          const char* totpBody = totpSep + 9;
          const char* uSep = strstr(totpBody, "\n---U---\n");
          size_t totpBodyLen;
          if (uSep && (size_t)(uSep - pwPart) <= pwPartLen) {
            totpBodyLen = (size_t)(uSep - totpBody);
          } else {
            totpBodyLen = pwPartLen - (size_t)(totpSep - pwPart) - 9u;
          }
          totp_deserialize_plain(totpBody, totpBodyLen);
          if (uSep && (size_t)(uSep - pwPart) <= pwPartLen) {
            const char* b64u = uSep + 9;
            size_t b64uLen = (size_t)((pwPart + pwPartLen) - b64u);
            addr_status_try_import_u_b64_slice(b64u, b64uLen, true);
          }
        } else {
          notes_deserialize_plain(afterN, pwPartLen - pwLen - 9);
        }
      } else {
        vault_import_passwords_plaintext(pwPart, pwPartLen);
      }
      Serial.print("SPE1 restore: pwCount=");
      Serial.print(pwSvc_getCount());
      Serial.print(", g_noteCount=");
      Serial.print(g_noteCount);
      Serial.print(", g_totpCount=");
      Serial.println(g_totpCount);

      if (pwSvc_getCount() > 0 || g_noteCount > 0) {
        char buf[64];
        snprintf(buf, sizeof(buf), "Restored: %d password(s), %d note(s)", (int)pwSvc_getCount(), (int)g_noteCount);
        setMenuToast(buf);
      }
      show_menu_or_onboard_lock_after_restore();
      return;
    }

    // ---------- QR: plaintext full vault (SP2|backupCode|passwords) — legacy/unencrypted ----------
    if (strstr(g_msg, "QR OK") && strlen(g_password1) >= 4 && strncmp(g_restoreFull, "SP2|", 4) == 0) {
      const char* p = g_restoreFull + 4;
      const char* q = strchr(p, '|');
      if (!q || (size_t)(q - p) >= BACKUP_CODE_MAX_BYTES) {
        setMsg("Invalid QR format");
        draw();
        return;
      }
      size_t bcLen = (size_t)(q - p);
      if (bcLen >= sizeof(s_restore_backupCode)) bcLen = sizeof(s_restore_backupCode) - 1;
      memcpy(s_restore_backupCode, p, bcLen);
      s_restore_backupCode[bcLen] = 0;
      const char* pwPart = q + 1;
      size_t pwPartLen = strlen(pwPart);

      uint8_t wc = 12;
      bool ok = restore_seed_from_backup_code(s_restore_backupCode, g_password1, s_restore_out, wc, true);
      if (!ok) {
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      if (restore_password_apply_temp_seed_if_requested((const char(*)[16])s_restore_out, wc)) return;
      pwSvc_clearAll();  // New seed: clear any stale passwords from previous session
      strncpy(g_backupCode, s_restore_backupCode, sizeof(g_backupCode) - 1);
      g_backupCode[sizeof(g_backupCode) - 1] = 0;
      strncpy(g_masterPw, g_password1, sizeof(g_masterPw) - 1);
      g_masterPw[sizeof(g_masterPw) - 1] = 0;
      session_login_from_seed((const char(*)[16])s_restore_out, wc, g_backupCode);
      portable_backup_set_from_code(g_backupCode);
      const char* notesSep = strstr(pwPart, "\n---N---\n");
      const char* totpSep = strstr(pwPart, "\n---T---\n");
      if (notesSep) {
        size_t pwLen = (size_t)(notesSep - pwPart);
        vault_import_passwords_plaintext(pwPart, pwLen);
        const char* afterN = notesSep + 9;
        if (totpSep && totpSep >= afterN) {
          notes_deserialize_plain(afterN, (size_t)(totpSep - afterN));
          const char* totpBody = totpSep + 9;
          const char* uSep = strstr(totpBody, "\n---U---\n");
          size_t totpBodyLen;
          if (uSep && (size_t)(uSep - pwPart) <= pwPartLen) {
            totpBodyLen = (size_t)(uSep - totpBody);
          } else {
            totpBodyLen = pwPartLen - (size_t)(totpSep - pwPart) - 9u;
          }
          totp_deserialize_plain(totpBody, totpBodyLen);
          if (uSep && (size_t)(uSep - pwPart) <= pwPartLen) {
            const char* b64u = uSep + 9;
            size_t b64uLen = (size_t)((pwPart + pwPartLen) - b64u);
            addr_status_try_import_u_b64_slice(b64u, b64uLen, true);
          }
        } else {
          notes_deserialize_plain(afterN, pwPartLen - (notesSep - pwPart) - 9);
        }
      } else {
        vault_import_passwords_plaintext(pwPart, pwPartLen);
      }
      show_menu_or_onboard_lock_after_restore();
      return;
    }

    // ---------- QR: backup code only (SPB1-) — restore seed only, do NOT load vault from SD ----------
    if (strstr(g_msg, "QR OK") && strncmp(g_restoreFull, "SPB1-", 5) == 0) {
      if (strlen(g_password1) < BACKUP_PASSWORD_MIN_LEN) {
        setMsg("Use at least 12 characters.");
        draw();
        return;
      }
      uint8_t wc = 12;
      bool ok = restore_seed_from_backup_code(g_restoreFull, g_password1, s_restore_out, wc, true);
      if (!ok) {
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      if (restore_password_apply_temp_seed_if_requested((const char(*)[16])s_restore_out, wc)) return;
      pwSvc_clearAll();  // New seed: only what's in the QR (no SD vault load)
      strncpy(g_backupCode, g_restoreFull, sizeof(g_backupCode) - 1);
      g_backupCode[sizeof(g_backupCode) - 1] = 0;
      strncpy(g_masterPw, g_password1, sizeof(g_masterPw) - 1);
      g_masterPw[sizeof(g_masterPw) - 1] = 0;
      session_login_from_seed((const char(*)[16])s_restore_out, wc, g_backupCode);
      portable_backup_set_from_code(g_backupCode);
      show_menu_or_onboard_lock_after_restore();
      return;
    }

    // ---------- SD: decrypt backup code (.bin or legacy path); then choose vault vs seed-only ----------
    if (strstr(g_msg, "Enter password to decrypt backup code")) {

      if (strlen(g_password1) < BACKUP_PASSWORD_MIN_LEN) {
        setMsg("Use at least 12 characters.");
        draw();
        return;
      }

      setMsg("Validating... please wait");
      draw();

      Serial.println("handleRestorePasswordTap: restore backup code from SD");

      const char* sdBackupPath = (g_restoreFull[0] && strncmp(g_restoreFull, "/sdcard/", 8) == 0) ? g_restoreFull : nullptr;
      bool loaded = backup_code_load_from_sd(g_password1, s_restore_loadedCode, sizeof(s_restore_loadedCode), sdBackupPath);

      // Same .bin may be a PW vault (SPV1/2): header probe can miss edge cases; try vault if backup format fails.
      if (!loaded && sdBackupPath && sd_bin_file_header_is_pw_vault(sdBackupPath)) {
        strncpy(PW_FILE, sdBackupPath, sizeof(PW_FILE) - 1);
        PW_FILE[sizeof(PW_FILE) - 1] = 0;
        if (pw_vault_load_from_sd(g_password1)) {
          strncpy(g_masterPw, g_password1, sizeof(g_masterPw) - 1);
          g_masterPw[sizeof(g_masterPw) - 1] = 0;
          save_passwords_notes_to_nvs();
          set_msg_vault_restored_ok();
          show(UIScreen::MENU);
          return;
        }
        if (g_msg[0]) {
          show(UIScreen::ERROR_SCREEN);
          return;
        }
      }

      if (!loaded) {
        setMsg("Failed to decrypt backup code");
        draw();
        return;
      }

      uint8_t wc = 12;
      // Decode-only first: do not touch NVS until seed/fingerprint gate passes.
      bool ok = restore_seed_from_backup_code(s_restore_loadedCode, g_password1, s_restore_out, wc, false);
      if (!ok) {
        setMsg("Failed to restore seed");
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      if (!seed_and_fingerprint_match_active_session((const char(*)[16])s_restore_out, wc)) {
        clearPassword(g_password1);
        setMsg("Backup seed/fingerprint mismatch");
        // Make mismatch impossible to miss before returning to MicroSD.
        gfx->fillScreen(RGB565_BLACK);
        gfx->setTextColor(RGB565_RED);
        gfx->setTextSize(3);
        const char* l1 = "MISMATCH";
        const char* l2 = "Wrong seed/fp";
        int16_t x1 = (LCD_W - (int16_t)(strlen(l1) * 18)) / 2;
        if (x1 < 4) x1 = 4;
        int16_t x2 = (LCD_W - (int16_t)(strlen(l2) * 18)) / 2;
        if (x2 < 4) x2 = 4;
        gfx->setCursor(x1, 200);
        gfx->print(l1);
        gfx->setCursor(x2, 240);
        gfx->print(l2);
        ui_flush();
        delay(1800);
        show(UIScreen::SD_BROWSER);
        return;
      }

      pwSvc_clearAll();
      strncpy(g_backupCode, s_restore_loadedCode, sizeof(g_backupCode) - 1);
      g_backupCode[sizeof(g_backupCode) - 1] = 0;
      strncpy(g_masterPw, g_password1, sizeof(g_masterPw) - 1);
      g_masterPw[sizeof(g_masterPw) - 1] = 0;
      session_login_from_seed((const char(*)[16])s_restore_out, wc, g_backupCode);
      portable_backup_set_from_code(g_backupCode);

      clearPassword(g_password1);
      setMsg("");
      if (g_restoreFull[0] && strncmp(g_restoreFull, "/sdcard/", 8) == 0) {
        strncpy(g_lastSdBackupCodePath, g_restoreFull, sizeof(g_lastSdBackupCodePath) - 1);
        g_lastSdBackupCodePath[sizeof(g_lastSdBackupCodePath) - 1] = 0;
      } else {
        g_lastSdBackupCodePath[0] = 0;
      }
      show(UIScreen::RESTORE_VAULT_CHOICE);
      return;
    }

    // ---------- SD: decrypt password vault (pw_v1.bin from SD browser) ----------
    if (strstr(g_msg, "Enter password to decrypt backup") && !strstr(g_msg, "backup code")) {

      if (strlen(g_password1) < 4) {
        setMsg("Password too short.");
        draw();
        return;
      }

      setMsg("Validating... please wait");
      draw();

      Serial.println("handleRestorePasswordTap: Attempting to restore password vault from SD");
      Serial.print("handleRestorePasswordTap: Using password: ");
      Serial.println(g_password1);
      Serial.print("handleRestorePasswordTap: File path: ");
      Serial.println(PW_FILE);

      if (pw_vault_load_from_sd(g_password1)) {
        Serial.println("handleRestorePasswordTap: Successfully loaded password vault from SD");
        strncpy(g_masterPw, g_password1, sizeof(g_masterPw) - 1);
        g_masterPw[sizeof(g_masterPw) - 1] = 0;

        save_passwords_notes_to_nvs();  // persist so 2FA/pw/notes survive unplug
        set_msg_vault_restored_ok();
        show(UIScreen::MENU);
      } else {
        Serial.println("handleRestorePasswordTap: Failed to load password vault from SD");
        Serial.print("handleRestorePasswordTap: Current seed words: ");
        for (int i = 0; i < g_wc; i++) {
          Serial.print(g_seed[i]);
          if (i < g_wc - 1) Serial.print(" ");
        }
        Serial.println();
        // Keep g_msg set by pw_vault_load_from_sd (e.g. "Wrong vault password", "Vault from different seed") and show it
        show(UIScreen::ERROR_SCREEN);
        draw();
      }
      return;
    }

    // ---------- Manual restore path ----------
    restorePayload_buildFull();
    const char* codeLine = (g_restoreLineActive && g_restoreLineActive[0]) ? g_restoreLineActive : g_restoreFull;

    if (strlen(g_password1) < 4) {
      setMsg("Password too short.");
      draw();
      return;
    }
    if (codeLine && strncmp(codeLine, "SPB1-", 5) == 0 && strlen(g_password1) < BACKUP_PASSWORD_MIN_LEN) {
      setMsg("Use at least 12 characters.");
      draw();
      return;
    }

    g_busy = true;
    g_spin = 0;
    setMsg("Restoring...");
    draw();

    uint8_t wc = 12;
    bool ok = restore_seed_from_backup_code(codeLine, g_password1, s_restore_out, wc, true);

    g_busy = false;

    if (!ok) {
      show(UIScreen::ERROR_SCREEN);
      return;
    }
    if (restore_password_apply_temp_seed_if_requested((const char(*)[16])s_restore_out, wc)) return;

    pwSvc_clearAll();  // New seed: clear any stale passwords from previous session
    const bool isSpf1 = (codeLine[0] && strncmp(codeLine, "SPF1-", 5) == 0);
    if (isSpf1) {
      (void)refresh_g_backup_code_from_nvs_vault_blob();
    } else {
      strncpy(g_backupCode, codeLine, sizeof(g_backupCode) - 1);
      g_backupCode[sizeof(g_backupCode) - 1] = 0;
    }

    strncpy(g_masterPw, g_password1, sizeof(g_masterPw) - 1);
    g_masterPw[sizeof(g_masterPw) - 1] = 0;

    session_login_from_seed((const char(*)[16])s_restore_out, wc, g_backupCode);
    if (!isSpf1) portable_backup_set_from_code(g_backupCode);
    if (isSpf1) {
      load_passwords_notes_from_nvs(g_masterPw);
    }

    // SPB1 typed: seed only in NVS until user adds data. SPF1: vault_pw restored above.
    show_menu_or_onboard_lock_after_restore();
    return;
  }

  // Tap was not OK; don't treat SYM/Shift/space as BACK
  if (tapInKeyboardArea(x, y))
    return;

  // ✅ keyboard typing MUST be outside the OK block
  passwordInputTap(x, y, g_password1, sizeof(g_password1));
}

static void session_enter_duress_empty() {
  duress_decoy_vault_key_clear();
  g_duressSession = true;
  memset(g_masterPw, 0, sizeof(g_masterPw));
  memset(s_vault_blob_key, 0, sizeof(s_vault_blob_key));
  memset(s_vault_seed_key, 0, sizeof(s_vault_seed_key));
  memset(s_vault_nvs_key, 0, sizeof(s_vault_nvs_key));
  s_vault_blob_key_valid = false;
  s_vault_seed_key_valid = false;
  s_vault_nvs_key_valid = false;
  memset(g_seed, 0, sizeof(g_seed));
  memset(g_masterSeedSnapshot, 0, sizeof(g_masterSeedSnapshot));
  g_masterSeedSnapshotWc = 0;
  g_wc = 0;
  memset(g_masterWordIndices, 0, sizeof(g_masterWordIndices));
  g_masterWordIndicesWc = 0;
  secure_memzero(g_masterBip39SeedBytes, sizeof(g_masterBip39SeedBytes));
  g_masterBip39SeedBytesValid = false;
  memset(g_backupCode, 0, sizeof(g_backupCode));
  portable_backup_clear();
  pwSvc_clearAll();
  g_noteCount = 0;
  if (g_noteItems) memset(g_noteItems, 0, NOTE_ITEMS_TOTAL_BYTES);
  memset(g_totpItems, 0, sizeof(g_totpItems));
  g_totpCount = 0;
  vault_set_unlocked(true);
  g_loggedIn = true;
  nav_recent_clear();
  g_hasVault = false;
  g_vaultQrDirty = true;
  g_addrXfpValid = false;
  g_addrXfpComputeRequested = false;
  invalidate_address_explorer_cache();
  invalidate_bip39_seed_cache();
  g_masterVaultSnapshotValid = false;
  g_masterAccountsSnapshotValid = false;
  bip39_passphrase_zero_crypto_state();
  passphrase_vault_forget_snapshot();
  g_lastUserActivityMs = millis();
}

/** Decoy duress: BIP-85 child wallet; passwords/notes restored from dr_decoyvaultpw on unlock. */
static void session_enter_duress_decoy(const char seedWords[][16], uint8_t wc) {
  memset(g_masterPw, 0, sizeof(g_masterPw));
  memset(s_vault_blob_key, 0, sizeof(s_vault_blob_key));
  memset(s_vault_seed_key, 0, sizeof(s_vault_seed_key));
  memset(s_vault_nvs_key, 0, sizeof(s_vault_nvs_key));
  s_vault_blob_key_valid = false;
  s_vault_seed_key_valid = false;
  s_vault_nvs_key_valid = false;
  pwSvc_clearAll();
  g_noteCount = 0;
  if (g_noteItems) memset(g_noteItems, 0, NOTE_ITEMS_TOTAL_BYTES);
  memset(g_totpItems, 0, sizeof(g_totpItems));
  g_totpCount = 0;
  session_login_from_seed(seedWords, wc, "");
  g_duressSession = true;
  g_hasVault = true;
  g_vaultQrDirty = true;
  g_lastUserActivityMs = millis();
}

static bool duress_handle_unlock_tap(const char* cred, bool credIsPin) {
  DuressBehavior matched = DuressBehavior::NONE;
  if (!duress_try_match_unlock_type(cred, credIsPin, &matched)) return false;
  lockout_clear_fail_count();
  char credCopy[128];
  memset(credCopy, 0, sizeof(credCopy));
  strncpy(credCopy, cred, sizeof(credCopy) - 1);
  session_finish_duress_unlock(credCopy, credIsPin, matched);
  secure_memzero(credCopy, sizeof(credCopy));
  setMsg("");
  if (matched == DuressBehavior::GAMES) show(UIScreen::DURESS_GAMES);
  else show(UIScreen::MENU);
  return true;
}

static void session_finish_duress_unlock(const char* cred, bool credIsPin, DuressBehavior type) {
  g_duressSessionType = type;
  if (type == DuressBehavior::DECOY_VAULT) {
    char words[24][16];
    uint8_t wc = 0;
    if (duress_decoy_try_open_words_with_slot(&g_duressSlotDecoy, cred, credIsPin, words, &wc)) {
      if (duress_decoy_vault_key_set_from_cred(&g_duressSlotDecoy, cred, credIsPin)) {
        session_enter_duress_decoy((const char(*)[16])words, wc);
        duress_decoy_vault_pw_load_nvs();
      } else {
        session_enter_duress_decoy((const char(*)[16])words, wc);
      }
      secure_memzero(words, sizeof(words));
      return;
    }
  }
  session_enter_duress_empty();
}

/** After silent wipe: correct PIN/screen password or vault password → HOME (seed already gone from flash). */
static bool lockout_silent_armed_unlock_ok_go_home() {
  if (!g_lockoutSilentWipeArmed) return false;
  char mpwUnwrap[128];

  if (s_lockoutSvSlMode == 1) {
    if (s_lockoutSvPinWrapLen < 28) return false;
    if (strlen(g_password1) != 6) return false;
    memcpy(g_pinSalt, s_lockoutSvSalt, 16);
    g_pinWrapBlobLen = s_lockoutSvPinWrapLen;
    memcpy(g_pinWrapBlobStore, s_lockoutSvPinWrap, g_pinWrapBlobLen);
    g_screenLockUsesPin = true;
    g_screenLockSeparatePw = false;
    if (!screen_lock_pin_unwrap(g_password1, mpwUnwrap, sizeof(mpwUnwrap))) {
      secure_memzero(mpwUnwrap, sizeof(mpwUnwrap));
      return false;
    }
    secure_memzero(mpwUnwrap, sizeof(mpwUnwrap));
    lockout_disarm_hollow_lock();
    clearPassword(g_password1);
    setMsg("");
    show(UIScreen::HOME);
    return true;
  }
  if (s_lockoutSvSlMode == 2) {
    if (s_lockoutSvPinWrapLen < 28) return false;
    memcpy(g_pinSalt, s_lockoutSvSalt, 16);
    g_pinWrapBlobLen = s_lockoutSvPinWrapLen;
    memcpy(g_pinWrapBlobStore, s_lockoutSvPinWrap, g_pinWrapBlobLen);
    g_screenLockUsesPin = false;
    g_screenLockSeparatePw = true;
    if (!screen_lock_separate_pw_unwrap(g_password1, mpwUnwrap, sizeof(mpwUnwrap))) {
      secure_memzero(mpwUnwrap, sizeof(mpwUnwrap));
      return false;
    }
    secure_memzero(mpwUnwrap, sizeof(mpwUnwrap));
    lockout_disarm_hollow_lock();
    clearPassword(g_password1);
    setMsg("");
    show(UIScreen::HOME);
    return true;
  }

  if (!lockout_hollow_constant_unwrap(g_password1))
    return false;

  lockout_disarm_hollow_lock();
  clearPassword(g_password1);
  setMsg("");
  show(UIScreen::HOME);
  return true;
}

static void handleLockedScreenSubmit() {
  if (strlen(g_password1) == 0) {
    setMsg("");
    g_lockedNeedsRedraw = true;
    draw();
    return;
  }
  static bool s_lockedSubmitBusy = false;
  if (s_lockedSubmitBusy) return;
  s_lockedSubmitBusy = true;
  struct LockedSubmitGuard {
    bool& busy;
    explicit LockedSubmitGuard(bool& b)
      : busy(b) {}
    ~LockedSubmitGuard() {
      busy = false;
    }
  } submitGuard(s_lockedSubmitBusy);

  Serial.println("handleUnlockPasswordTap: OK / submit, validating password");
  setMsgTr("Validating... please wait", "Provera, sacekajte...");
  g_lockedNeedsRedraw = true;
  draw();
  yield();
  delay(20);

  if (g_lockoutSilentNoVerify) {
    clearPassword(g_password1);
    setMsgTr("Wallet was wiped", "Novcanik je obrisan");
    show(UIScreen::LOCKED);
    return;
  }

  if (g_lockoutSilentWipeArmed) {
    if (lockout_silent_armed_unlock_ok_go_home()) return;
    clearPassword(g_password1);
    const bool pinLike = (s_lockoutSvSlMode == 1);
    setMsgTr(pinLike ? "Wrong PIN" : "Wrong password",
             pinLike ? "Pogresan PIN" : "Pogresna lozinka");
    show(UIScreen::LOCKED);
    return;
  }

  uint8_t* vb = nullptr;
  size_t vl = 0;
  if (!nvs_load_vault(&vb, vl)) {
    Serial.println("handleUnlockPasswordTap: No vault found in NVS");
    setMsgTr("Nothing saved - create or restore first", "Nema sacuvanog - napravite ili vratite");
    show(UIScreen::HOME);
    return;
  }

  Serial.print("handleUnlockPasswordTap: Loaded vault from NVS, size=");
  Serial.print(vl);
  Serial.println(" bytes");

  const char* pwForVault = g_password1;
  char mpwUnwrap[128];
  if (g_screenLockUsesPin) {
    if (strlen(g_password1) != 6) {
      secure_memzero(vb, vl);
      free(vb);
      setMsgTr("Enter 6-digit PIN", "Unesite PIN od 6 cifara");
      g_lockedNeedsRedraw = true;
      draw();
      return;
    }
    if (screen_lock_pin_unwrap(g_password1, mpwUnwrap, sizeof(mpwUnwrap))) {
      lockout_clear_fail_count();
      strncpy(g_masterPw, mpwUnwrap, sizeof(g_masterPw) - 1);
      g_masterPw[sizeof(g_masterPw) - 1] = 0;
      secure_memzero(mpwUnwrap, sizeof(mpwUnwrap));
      clearPassword(g_password1);
      pwForVault = g_masterPw;
    } else {
      secure_memzero(mpwUnwrap, sizeof(mpwUnwrap));
      if (duress_handle_unlock_tap(g_password1, true)) {
        secure_memzero(vb, vl);
        free(vb);
        clearPassword(g_password1);
        return;
      }
      secure_memzero(vb, vl);
      free(vb);
      clearPassword(g_password1);
      if (lockout_register_failure()) return;
      setMsgTr("Wrong PIN", "Pogresan PIN");
      show(UIScreen::LOCKED);
      return;
    }
  } else if (g_screenLockSeparatePw) {
    if (screen_lock_separate_pw_unwrap(g_password1, mpwUnwrap, sizeof(mpwUnwrap))) {
      lockout_clear_fail_count();
      strncpy(g_masterPw, mpwUnwrap, sizeof(g_masterPw) - 1);
      g_masterPw[sizeof(g_masterPw) - 1] = 0;
      secure_memzero(mpwUnwrap, sizeof(mpwUnwrap));
      clearPassword(g_password1);
      pwForVault = g_masterPw;
    } else {
      secure_memzero(mpwUnwrap, sizeof(mpwUnwrap));
      if (duress_handle_unlock_tap(g_password1, false)) {
        secure_memzero(vb, vl);
        free(vb);
        clearPassword(g_password1);
        return;
      }
      secure_memzero(vb, vl);
      free(vb);
      clearPassword(g_password1);
      if (lockout_register_failure()) return;
      setMsgTr("Wrong password", "Pogresna lozinka");
      show(UIScreen::LOCKED);
      return;
    }
  }

  uint8_t wc = 12;
  Serial.println("handleUnlockPasswordTap: Calling restore_seed_from_vault_blob");
  bool ok = restore_seed_from_vault_blob(vb, vl, pwForVault, s_restore_out, wc);
  Serial.print("handleUnlockPasswordTap: restore_seed_from_vault_blob returned ");
  Serial.println(ok ? "SUCCESS" : "FAILED");

  if (ok) {
    lockout_clear_fail_count();
    duress_decoy_vault_key_clear();
    g_duressSession = false;
    g_duressSessionType = DuressBehavior::NONE;
    // Internal vault encoding for SPE1/helpers — not a user portable "backup code".
    vault_blob_to_code_string(vb, vl, g_backupCode, sizeof(g_backupCode));
    if (!g_screenLockUsesPin && !g_screenLockSeparatePw) {
      lockout_refresh_vpw_hollow_verifier(g_password1);
      strncpy(g_masterPw, g_password1, sizeof(g_masterPw) - 1);
      g_masterPw[sizeof(g_masterPw) - 1] = 0;
    }
    portable_backup_load_from_nvs();
    session_login_from_seed((const char(*)[16])s_restore_out, wc, "");
    load_passwords_notes_from_nvs(g_masterPw);
    clearPassword(g_password1);
    setMsg("");
    show(UIScreen::MENU);
  } else {
    Serial.println("handleUnlockPasswordTap: Wrong password, return to LOCKED");
    if (!g_screenLockUsesPin && strlen(g_password1) > 0
        && duress_handle_unlock_tap(g_password1, false)) {
      secure_memzero(vb, vl);
      free(vb);
      memset(g_masterPw, 0, sizeof(g_masterPw));
      clearPassword(g_password1);
      return;
    }
    secure_memzero(vb, vl);
    free(vb);
    memset(g_masterPw, 0, sizeof(g_masterPw));
    clearPassword(g_password1);
    if (lockout_register_failure()) return;
    setMsgTr(g_screenLockUsesPin ? "Wrong PIN" : "Wrong password",
             g_screenLockUsesPin ? "Pogresan PIN" : "Pogresna lozinka");
    show(UIScreen::LOCKED);
    return;
  }

  secure_memzero(vb, vl);
  free(vb);
}

static void handleUnlockPasswordTap(uint16_t x, uint16_t y) {
  if (g_screenLockUsesPin) {
    const int nh = pin_entry_numpad_hit(x, y, PIN_ENTRY_NUMPAD_Y0, PIN_ENTRY_KEY_H);
    if (nh < 0) return;
    pin_entry_numpad_rect_for_index(nh, PIN_ENTRY_NUMPAD_Y0, PIN_ENTRY_KEY_H, &g_pinNumpadFlashRect);
    g_pinNumpadFlashUntilMs = millis() + 160;
    if (nh == 11) {
      handleLockedScreenSubmit();
      return;
    }
    if (nh == 10) {
      backspaceStr(g_password1, sizeof(g_password1));
      setMsg("");
      g_lockedNeedsRedraw = true;
      draw();
      return;
    }
    if (nh >= 0 && nh <= 8 && strlen(g_password1) < 6) {
      appendChar(g_password1, sizeof(g_password1), (char)('1' + nh));
      setMsg("");
      g_lockedNeedsRedraw = true;
      draw();
      return;
    }
    if (nh == 9 && strlen(g_password1) < 6) {
      appendChar(g_password1, sizeof(g_password1), '0');
      setMsg("");
      g_lockedNeedsRedraw = true;
      draw();
    }
    return;
  }

  if (g_password1[0] && (hit(BTN_LOCKED_SHOWHIDE, x, y) || hit(BTN_PW_SHOWHIDE, x, y))) {
    g_pwMasked = !g_pwMasked;
    g_lockedNeedsRedraw = true;
    draw();
    return;
  }

  if (hitOkKeyResolved((int16_t)x, (int16_t)y)) {
    flashKeyRectTranslucent(keyRectRow4[2]);
    handleLockedScreenSubmit();
    return;
  }

  passwordInputTap(x, y, g_password1, sizeof(g_password1));
}

static void handleConfirmMasterShowTap(uint16_t x, uint16_t y) {
  if (hit(BTN_BACK_PW, x, y)) {
    flashKeyRect(BTN_BACK_PW);
    clearPassword(g_password1);
    show(UIScreen::PASSWORDS);
    return;
  }
  if (g_password1[0] && hit(BTN_PW_SHOWHIDE, x, y)) {
    g_pwMasked = !g_pwMasked;
    draw();
    return;
  }
  if (hitOkKey(x, y)) {
    flashKeyRectTranslucent(keyRectRow4[2]);
    if (strlen(g_password1) < 1) {
      draw();
      return;
    }
    if (strcmp(g_password1, g_masterPw) == 0) {
      clearPassword(g_password1);
      g_pwListMasked = false;
      show(UIScreen::PASSWORDS);
    } else {
      setMsg("Wrong password");
      clearPassword(g_password1);
      show(UIScreen::ERROR_SCREEN);
    }
    return;
  }
  passwordInputTap(x, y, g_password1, sizeof(g_password1));
}

