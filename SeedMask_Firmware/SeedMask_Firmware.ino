      }
      show(UIScreen::CRYPTO_XPUB_EXPORT);
      return;
    }
    if (!btc_load_singlesig_xpub_export(g_cryptoExportType, g_addrAccount)) {
      setMsg(g_addrLastErr[0] ? g_addrLastErr : "xpub failed");
      show(UIScreen::ERROR_SCREEN);
      return;
    }
    show(UIScreen::CRYPTO_XPUB_EXPORT);
    return;
  }
  if (hit(BTN_CRYPTO_XPUB_MODE_MULTI, x, y)) {
    // Multisig: default immediately to Native SegWit multisig xpub.
    g_cryptoExportType = AddrType::P2WPKH;
    g_cryptoXpubBackToMultisigStub = true;
    g_cryptoXpubBackToMode = false;
    secure_memzero(g_cryptoXpubBuf, sizeof(g_cryptoXpubBuf));
    setMsg("");
    if (crypto_home_asset_is_kaspa()) {
      if (!kaspa_multisig_account_kpub(g_addrAccount, g_cryptoXpubBuf, sizeof(g_cryptoXpubBuf))) {
        setMsg(g_addrLastErr[0] ? g_addrLastErr : "multisig kpub failed");
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      if (!kaspa_kpub_qr_scan_payload(45, g_addrAccount, g_cryptoXpubBuf, g_cryptoXpubQrPayload, sizeof(g_cryptoXpubQrPayload))) {
        setMsg(g_addrLastErr[0] ? g_addrLastErr : "kpub QR failed");
        show(UIScreen::ERROR_SCREEN);
        return;
      }
      show(UIScreen::CRYPTO_XPUB_EXPORT);
      return;
    }
    if (!btc_multisig_xpub(g_cryptoExportType, g_addrAccount, g_cryptoXpubBuf, sizeof(g_cryptoXpubBuf))) {
      setMsg(g_addrLastErr[0] ? g_addrLastErr : "multisig xpub failed");
      show(UIScreen::ERROR_SCREEN);
      return;
    }
    if (!btc_multisig_qr_scan_payload(g_cryptoExportType, g_addrAccount, g_cryptoXpubBuf, g_cryptoXpubQrPayload,
                                      sizeof(g_cryptoXpubQrPayload))) {
      setMsg(g_addrLastErr[0] ? g_addrLastErr : "xpub QR failed");
      show(UIScreen::ERROR_SCREEN);
      return;
    }
    show(UIScreen::CRYPTO_XPUB_EXPORT);
    return;
  }
}

static void handleCryptoPassphraseTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    const bool fromSettings = g_cryptoPassphraseFromSettings;
    g_cryptoPassphraseFromSettings = false;
    show(fromSettings ? UIScreen::CRYPTO_SETTINGS : UIScreen::CRYPTO_HOME);
    return;
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 16 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 16 + infoHalf);
    const int16_t padHit = 4;
    const Rect rPassphraseInfo = {
      (int16_t)(infoCx - infoHalf - padHit), (int16_t)(infoCy - infoHalf - padHit),
      (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHit), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHit)
    };
    if (hit(rPassphraseInfo, x, y)) {
      g_passphraseInfoReturnScreen = UIScreen::CRYPTO_PASSPHRASE;
      flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
      delay(85);
      show(UIScreen::CRYPTO_PASSPHRASE_INFO);
      return;
    }
  }
  if (!g_bip39HasPassphrase) {
    if (hit(TXT_CRYPTO_PASSPHRASE_ENTER_HIT, x, y)) {
      // Flash the CTA button.
      drawBtn(TXT_CRYPTO_PASSPHRASE_ENTER_HIT, "SET PASSPHRASE", UI_ACCENT, 2);
      ui_flush();
      delay(60);

      memset(g_bip39PassphraseInput, 0, sizeof(g_bip39PassphraseInput));
      g_bip39PassphraseInput[0] = 0;
      secure_memzero(g_bip39PassphraseInput, sizeof(g_bip39PassphraseInput));
      setMsg("");
      show(UIScreen::CRYPTO_PASSPHRASE_INPUT);
      return;
    }
  } else {
    if (hit(BTN_CRYPTO_PASSPHRASE_MAIN, x, y)) {
      // Clear immediately (no confirmation requested in UX spec).
      crypto_clear_bip39_passphrase();
      crypto_accounts_load_all();
      invalidate_address_explorer_cache();
      g_addrXfpValid = false;
      secure_memzero(g_cryptoXpubBuf, sizeof(g_cryptoXpubBuf));
      setMsg("");
      drawCryptoPassphrase();
      return;
    }
  }
}

static void handleCryptoPassphraseInputTap(uint16_t x, uint16_t y) {
  if (hit(BTN_TOP_BURGER, x, y)) {
    secure_memzero(g_bip39PassphraseInput, sizeof(g_bip39PassphraseInput));
    g_bip39PassphraseInput[0] = 0;
    setMsg("");
    show(UIScreen::CRYPTO_PASSPHRASE);
    return;
  }
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 16 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 16 + infoHalf);
    const int16_t padHit = 4;
    const Rect rPassphraseInfo = {
      (int16_t)(infoCx - infoHalf - padHit), (int16_t)(infoCy - infoHalf - padHit),
      (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W + 2 * padHit), (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_H + 2 * padHit)
    };
    if (hit(rPassphraseInfo, x, y)) {
      g_passphraseInfoReturnScreen = UIScreen::CRYPTO_PASSPHRASE_INPUT;
      flashKeyCircleTranslucent(infoCx, infoCy, (int16_t)(WIPE_INFO_ICON_LARGE_RGB565_W / 2));
      delay(85);
      show(UIScreen::CRYPTO_PASSPHRASE_INFO);
      return;
    }
  }

  if (hitOkKey((int16_t)x, (int16_t)y)) {
    // OK = commit typed passphrase (empty => clear).
    bool wasActivePassphrase = g_bip39HasPassphrase;
    uint32_t applyStartMs = millis();
    if (!g_bip39PassphraseInput[0]) {
      crypto_clear_bip39_passphrase();
    } else {
      crypto_set_bip39_passphrase(g_bip39PassphraseInput);
    }
    crypto_accounts_load_all();
    invalidate_address_explorer_cache();
    g_addrXfpValid = false;
    secure_memzero(g_cryptoXpubBuf, sizeof(g_cryptoXpubBuf));
    setMsg("Applying passphrase...");
    draw();
    // Eagerly derive wallet context now (Passport-like), not lazily on next crypto action.
    char warmXfp[9] = { 0 };
    (void)current_master_xfp(warmXfp);
    char warmXpub[120] = { 0 };
    (void)btc_account_xpub(AddrType::P2WPKH, g_addrAccount, warmXpub, sizeof(warmXpub));
    secure_memzero(warmXpub, sizeof(warmXpub));
    // Keep a short minimum dwell so users can perceive apply state.
    uint32_t elapsed = (uint32_t)(millis() - applyStartMs);
    const uint32_t minApplyMs = 1100;
    if (elapsed < minApplyMs) delay((uint32_t)(minApplyMs - elapsed));
    g_passphraseActiveFlashPending = (!wasActivePassphrase && g_bip39HasPassphrase) ? 1 : 0;
    secure_memzero(g_bip39PassphraseInput, sizeof(g_bip39PassphraseInput));
    g_bip39PassphraseInput[0] = 0;
    setMsg("");
    show(UIScreen::CRYPTO_PASSPHRASE);
    return;
  }

  passwordInputTap(x, y, g_bip39PassphraseInput, sizeof(g_bip39PassphraseInput));
}

