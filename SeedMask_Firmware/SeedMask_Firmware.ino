// Notes grid (Samsung-style): body preview inside a tile, title caption underneath.
// Uses g_noteListScroll as the first visible note index (aligned to 2-column rows).
static const int NOTE_GRID_COLS = 2;
static const int NOTE_GRID_VISIBLE_ROWS = 3;  // 3 rows * 2 cols = 6 notes per page (matches LIST_MAX_VISIBLE)
static const int NOTE_TILE_GAP = 16;          // more vertical space between rows
static const int NOTE_TILE_PAD = 8;
static const int NOTE_TILE_H = 84;
static const int NOTE_TITLE_H = 40;  // two-line caption under tile (bigger font)
static const int NOTE_GRID_TOP = LIST_AREA_TOP;
static const int NOTE_GRID_ROW_STRIDE = NOTE_TILE_H + NOTE_TITLE_H + NOTE_TILE_GAP;

static void noteTileRectsForSlot(int slot, Rect& outTile, Rect& outCaption) {
  // slot: 0..(NOTE_GRID_VISIBLE_ROWS*NOTE_GRID_COLS - 1)
  const int contentX = 10;
  const int contentW = 268;
  const int tileW = (contentW - NOTE_TILE_GAP) / NOTE_GRID_COLS;
  int row = slot / NOTE_GRID_COLS;
  int col = slot % NOTE_GRID_COLS;
  int x = contentX + col * (tileW + NOTE_TILE_GAP);
  int y = NOTE_GRID_TOP + row * NOTE_GRID_ROW_STRIDE;
  outTile = Rect{ (int16_t)x, (int16_t)y, (int16_t)tileW, (int16_t)NOTE_TILE_H };
  // Title caption sits under the tile; a slightly larger gap reads better.
  outCaption = Rect{ (int16_t)x, (int16_t)(y + NOTE_TILE_H + 6), (int16_t)tileW, (int16_t)NOTE_TITLE_H };
}

static bool noteIndexFromTap(int16_t x, int16_t y, uint8_t& outIndex) {
  // Map tap to the note index for the current visible page.
  // Clickable area is tile + caption below it.
  for (int slot = 0; slot < NOTE_GRID_VISIBLE_ROWS * NOTE_GRID_COLS; slot++) {
    uint8_t idx = (uint8_t)((int)g_noteListScroll + slot);
    if (idx >= g_noteCount) break;
    Rect tile, cap;
    noteTileRectsForSlot(slot, tile, cap);
    Rect hitR = Rect{ tile.x, tile.y, tile.w, (int16_t)(NOTE_TILE_H + NOTE_TITLE_H + 4) };
    if (hit(hitR, x, y)) {
      outIndex = idx;
      return true;
    }
  }
  return false;
}

static bool noteTitleCaptionHitForIndex(uint8_t noteIndex, int16_t x, int16_t y) {
  if (noteIndex < g_noteListScroll) return false;
  int slot = (int)noteIndex - (int)g_noteListScroll;
  if (slot < 0 || slot >= NOTE_GRID_VISIBLE_ROWS * NOTE_GRID_COLS) return false;
  Rect tile, cap;
  noteTileRectsForSlot(slot, tile, cap);
  // Expanded touch area for title hold (long-press -> full title popup).
  Rect capHit = cap;
  capHit.x = (int16_t)(capHit.x - 6);
  capHit.w = (int16_t)(capHit.w + 12);
  capHit.y = (int16_t)(capHit.y - 10);
  capHit.h = (int16_t)(capHit.h + 20);
  return hit(capHit, x, y);
}

static bool noteSendButtonHitForIndex(uint8_t noteIndex, int16_t x, int16_t y) {
  // When Send popup is shown, "Send" is on same line as EDIT, centered in the top bar
  (void)noteIndex;
  const int sendW = 100;
  const int sendH = 32;
  const int sendX = (LCD_W - sendW) / 2;
  const int sendY = BTN_LIST_EDIT.y;
  return (x >= sendX && x < sendX + sendW && y >= sendY && y < sendY + sendH);
}

// Passwords grid: 2 cols, cards ~3x shorter than Notes
static void pwTileRectsForSlot(int slot, Rect& outTile, Rect& outCaption) {
  const int contentX = 10;
  const int contentW = 268;
  const int tileW = (contentW - PW_TILE_GAP) / PW_GRID_COLS;
  int row = slot / PW_GRID_COLS;
  int col = slot % PW_GRID_COLS;
  int x = contentX + col * (tileW + PW_TILE_GAP);
  int y = PW_GRID_TOP + row * PW_GRID_ROW_STRIDE;
  outTile = Rect{ (int16_t)x, (int16_t)y, (int16_t)tileW, (int16_t)PW_TILE_H };
  outCaption = Rect{ (int16_t)x, (int16_t)(y + PW_TILE_H + PW_TILE_TO_CAPTION_GAP), (int16_t)tileW, (int16_t)PW_TITLE_H };
}
static void pwDetailedRowRectForSlot(int slot, Rect& outRow) {
  const int x = 10;
  const int y = LIST_AREA_TOP + slot * PW_DETAIL_ROW_STRIDE;
  outRow = Rect{ (int16_t)x, (int16_t)y, 276, (int16_t)PW_DETAIL_ROW_H };
}
static bool pwIndexFromTap(int16_t x, int16_t y, uint8_t& outIndex) {
  if (g_pwListDetailedView) {
    for (int slot = 0; slot < PW_DETAIL_VISIBLE_ROWS; slot++) {
      uint8_t idx = (uint8_t)((int)g_pwListScroll + slot);
      if (idx >= pwSvc_getCount()) break;
      Rect row;
      pwDetailedRowRectForSlot(slot, row);
      if (hit(row, x, y)) {
        outIndex = idx;
        return true;
      }
    }
    return false;
  }
  for (int slot = 0; slot < PW_GRID_ITEMS_PER_PAGE; slot++) {
    uint8_t idx = (uint8_t)((int)g_pwListScroll + slot);
    if (idx >= pwSvc_getCount()) break;
    Rect tile, cap;
    pwTileRectsForSlot(slot, tile, cap);
    Rect hitR = Rect{ tile.x, tile.y, tile.w, (int16_t)(PW_TILE_H + PW_TILE_TO_CAPTION_GAP + PW_TITLE_H + 4) };
    if (hit(hitR, x, y)) {
      outIndex = idx;
      return true;
    }
  }
  return false;
}

#if SEEDMASK_NOTE_SEND_UI
/** Animated “Send” on the EDIT row (Passwords long-press + Notes long-press). */
static void drawListAnimatedSendButton(int16_t sendRowY, uint32_t shownAtMs) {
  const int sendBtnW = 100;
  const int sendBtnH = 32;
  const int sendBtnX = (LCD_W - sendBtnW) / 2;
  const int sendBtnY = sendRowY;
  const int sendBtnR = 10;

  const uint16_t blueDim = (uint16_t)0x3186;
  const uint16_t blueBright = (uint16_t)0x7D5F;
  uint32_t tMs = millis();

  const int sendTopLen = sendBtnW - 2 * sendBtnR;
  const int sendRightLen = sendBtnH - 2 * sendBtnR;
  const int sendArcLen = (int)(3.14159265f * (float)sendBtnR / 2.0f);
  const int sendPerim = 2 * sendTopLen + 2 * sendRightLen + 4 * sendArcLen;
  const int sendSegLen = sendPerim * 99 / 100;
  uint32_t sendPhase = (millis() / 30) % (uint32_t)sendPerim;
  const int sendBorderThick = 2;

  int rd = (blueDim >> 11) & 0x1F, gd = (blueDim >> 5) & 0x3F, bd = blueDim & 0x1F;
  int rb = (blueBright >> 11) & 0x1F, gb = (blueBright >> 5) & 0x3F, bBright = blueBright & 0x1F;
  float drift = 0.5f + 0.5f * sinf((float)tMs / 820.0f);
  float breath = 0.5f + 0.5f * sinf((float)tMs / 400.0f);
  float wavePulse = 0.78f + 0.22f * sinf((float)tMs / 240.0f);
  float baseBlend = 0.42f + 0.25f * drift + 0.33f * breath;
  int br = (int)(rd + (rb - rd) * baseBlend);
  int bg = (int)(gd + (gb - gd) * baseBlend);
  int bb_ = (int)(bd + (bBright - bd) * baseBlend);
  if (br > 31) br = 31;
  if (br < 0) br = 0;
  if (bg > 63) bg = 63;
  if (bg < 0) bg = 0;
  if (bb_ > 31) bb_ = 31;
  if (bb_ < 0) bb_ = 0;
  uint16_t baseColor = (uint16_t)((br << 11) | (bg << 5) | bb_);

  for (int i = 0; i < sendBorderThick; ++i) {
    int ix = sendBtnX + i, iy = sendBtnY + i, iw = sendBtnW - 2 * i, ih = sendBtnH - 2 * i, ir = sendBtnR - i;
    if (iw <= 0 || ih <= 0) break;
    if (ir < 0) ir = 0;
    gfx->drawRoundRect(ix, iy, iw, ih, ir, baseColor);
  }

  const int waveThick = 2;
  float waveLevel = (0.48f + 0.18f * drift + 0.26f * breath) * wavePulse;
  for (int i = 0; i < sendSegLen; i += 2) {
    int d = (int)sendPhase + i;
    d = d % sendPerim;
    if (d < 0) d += sendPerim;
    float f = waveLevel;
    int r = (int)(rd + (rb - rd) * f);
    int g = (int)(gd + (gb - gd) * f);
    int b = (int)(bd + (bBright - bd) * f);
    if (r > 31) r = 31;
    if (r < 0) r = 0;
    if (g > 63) g = 63;
    if (g < 0) g = 0;
    if (b > 31) b = 31;
    if (b < 0) b = 0;
    uint16_t waveColor = (uint16_t)((r << 11) | (g << 5) | b);
    int px, py;
    if (d < sendTopLen) {
      px = sendBtnX + sendBtnR + d;
      py = sendBtnY;
    } else if (d < sendTopLen + sendArcLen) {
      float frac = (float)(d - sendTopLen) / (float)sendArcLen;
      float angle = -1.5707963f + frac * 1.5707963f;
      int cx = sendBtnX + sendBtnW - sendBtnR, cy = sendBtnY + sendBtnR;
      px = cx + (int)(sendBtnR * cosf(angle));
      py = cy + (int)(sendBtnR * sinf(angle));
    } else if (d < sendTopLen + sendArcLen + sendRightLen) {
      px = sendBtnX + sendBtnW - 1;
      py = sendBtnY + sendBtnR + (d - sendTopLen - sendArcLen);
    } else if (d < sendTopLen + sendArcLen + sendRightLen + sendArcLen) {
      float frac = (float)(d - sendTopLen - sendArcLen - sendRightLen) / (float)sendArcLen;
      float angle = frac * 1.5707963f;
      int cx = sendBtnX + sendBtnW - sendBtnR, cy = sendBtnY + sendBtnH - sendBtnR;
      px = cx + (int)(sendBtnR * cosf(angle));
      py = cy + (int)(sendBtnR * sinf(angle));
    } else if (d < 2 * sendTopLen + 2 * sendArcLen + sendRightLen) {
      int dx = d - (sendTopLen + sendArcLen + sendRightLen + sendArcLen);
      px = sendBtnX + sendBtnW - sendBtnR - dx;
      py = sendBtnY + sendBtnH - 1;
    } else if (d < 2 * sendTopLen + 3 * sendArcLen + sendRightLen) {
      float frac = (float)(d - (2 * sendTopLen + sendRightLen + 2 * sendArcLen)) / (float)sendArcLen;
      float angle = 1.5707963f + frac * 1.5707963f;
      int cx = sendBtnX + sendBtnR, cy = sendBtnY + sendBtnH - sendBtnR;
      px = cx + (int)(sendBtnR * cosf(angle));
      py = cy + (int)(sendBtnR * sinf(angle));
    } else if (d < 2 * sendTopLen + 3 * sendArcLen + 2 * sendRightLen) {
      int dy = d - (2 * sendTopLen + 3 * sendArcLen + sendRightLen);
      px = sendBtnX;
      py = sendBtnY + sendBtnH - sendBtnR - dy;
    } else {
      float frac = (float)(d - (2 * sendTopLen + 3 * sendArcLen + 2 * sendRightLen)) / (float)sendArcLen;
      float angle = 3.14159265f + frac * 1.5707963f;
      int cx = sendBtnX + sendBtnR, cy = sendBtnY + sendBtnR;
      px = cx + (int)(sendBtnR * cosf(angle));
      py = cy + (int)(sendBtnR * sinf(angle));
    }
    if (px < sendBtnX) px = sendBtnX;
    if (py < sendBtnY) py = sendBtnY;
    if (px + waveThick > sendBtnX + sendBtnW) px = sendBtnX + sendBtnW - waveThick;
    if (py + waveThick > sendBtnY + sendBtnH) py = sendBtnY + sendBtnH - waveThick;
    gfx->fillRect(px, py, waveThick, waveThick, waveColor);
  }

  uint32_t elapsed = millis() - shownAtMs;
  const uint32_t animDur = 200;
  float t = (elapsed >= animDur) ? 1.0f : (float)elapsed / (float)animDur;
  t = t * t;
  const int sendTextW = 48;
  int sendX = (LCD_W - sendTextW) / 2 + (int)((1.0f - t) * 16);
  int sendY = sendRowY + 8;
  uint16_t c1 = 0x3186, c2 = 0xFFFF;
  int rr1 = (c1 >> 11) & 0x1F, gg1 = (c1 >> 5) & 0x3F, bb1 = c1 & 0x1F;
  int rr2 = (c2 >> 11) & 0x1F, gg2 = (c2 >> 5) & 0x3F, bb2 = c2 & 0x1F;
  int rr = (int)(rr1 + (rr2 - rr1) * t);
  int gg = (int)(gg1 + (gg2 - gg1) * t);
  int bb = (int)(bb1 + (bb2 - bb1) * t);
  if (rr > 31) rr = 31;
  if (rr < 0) rr = 0;
  if (gg > 63) gg = 63;
  if (gg < 0) gg = 0;
  if (bb > 31) bb = 31;
  if (bb < 0) bb = 0;
  uint16_t sendColor = (uint16_t)((rr << 11) | (gg << 5) | bb);
  gfx->setTextColor(sendColor);
  gfx->setTextSize(2);
  gfx->setCursor(sendX, sendY);
  gfx->print("Send");
}
#endif  // SEEDMASK_NOTE_SEND_UI

