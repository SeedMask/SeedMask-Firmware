static void multisig_on_seed_context_changed(void) {
  for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
    if (g_multisigWalletContextTag[i] == MULTISIG_CTX_TAG_NOMATCH)
      g_multisigWalletContextTag[i] = MULTISIG_CTX_TAG_UNKNOWN;
  }
  multisig_invalidate_visible_list();
}
static void multisig_clamp_settings_scroll() {
  multisig_rebuild_visible_wallets();
  if (g_multisigVisibleCount == 0) {
    g_multisigSelectedIdx = 0;
  } else {
    bool selOk = false;
    for (uint8_t v = 0; v < g_multisigVisibleCount; v++) {
      if (g_multisigVisibleIdx[v] == g_multisigSelectedIdx) {
        selOk = true;
        break;
      }
    }
    if (!selOk) g_multisigSelectedIdx = g_multisigVisibleIdx[0];
  }
  if (g_multisigVisibleCount <= MULTISIG_SETTINGS_VISIBLE_ROWS) {
    g_multisigSettingsScroll = 0;
    return;
  }
  uint8_t maxScroll = (uint8_t)(g_multisigVisibleCount - MULTISIG_SETTINGS_VISIBLE_ROWS);
  if (g_multisigSettingsScroll > maxScroll) g_multisigSettingsScroll = maxScroll;
}
static void multisig_save_all_prefs() {
  prefs.begin("seedmask", false);
  prefs.putUChar("msig_cnt", g_multisigWalletCount);
  for (uint8_t i = 0; i < g_multisigWalletCount; i++) {
    char knm[16], kpl[16], kctx[20], kac[20];
    snprintf(knm, sizeof(knm), "msig_%u_nm", (unsigned)i);
    snprintf(kpl, sizeof(kpl), "msig_%u_pl", (unsigned)i);
    snprintf(kctx, sizeof(kctx), "msig_%u_ctx", (unsigned)i);
    snprintf(kac, sizeof(kac), "msig_%u_ac", (unsigned)i);
    prefs.putString(knm, g_multisigWalletNames[i]);
    prefs.putString(kpl, g_multisigWalletPayloads[i]);
    prefs.putULong(kctx, g_multisigWalletContextTag[i]);
    prefs.putULong(kac, (unsigned long)g_multisigWalletBtcAccount[i]);
  }
  for (uint8_t i = g_multisigWalletCount; i < MULTISIG_MAX_STORED_WALLETS; i++) {
    char knm[16], kpl[16], kctx[20], kac[20];
    snprintf(knm, sizeof(knm), "msig_%u_nm", (unsigned)i);
    snprintf(kpl, sizeof(kpl), "msig_%u_pl", (unsigned)i);
    snprintf(kctx, sizeof(kctx), "msig_%u_ctx", (unsigned)i);
    snprintf(kac, sizeof(kac), "msig_%u_ac", (unsigned)i);
    prefs.remove(knm);
    prefs.remove(kpl);
    prefs.remove(kctx);
    prefs.remove(kac);
  }
  prefs.end();
}

