static void drawAddressStatusUsed() {
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Used addresses", true);
  uint32_t used[ADDR_STATUS_MARK_CAP];
  size_t n = addr_status_collect_used(used, ADDR_STATUS_MARK_CAP);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(2);
  gfx->setCursor(14, 56);
  char bufN[20];
  format_u32_with_commas(bufN, sizeof(bufN), (uint32_t)n);
  gfx->print(bufN);
  gfx->print(" marked Used");
  if (n == 0) {
    gfx->setTextColor(RGB565_WHITE);
    gfx->setTextSize(2);
    gfx->setCursor(14, 120);
    gfx->print("No address is marked");
    gfx->setCursor(14, 146);
    gfx->print("as \"Used\" yet.");
    ui_flush();
    return;
  }
  size_t start = (size_t)g_addrStatusUsedPage * (size_t)ADDR_PAGE_ROWS;
  if (start >= n) {
    g_addrStatusUsedPage = 0;
    start = 0;
  }
  size_t shown = n - start;
  if (shown > (size_t)ADDR_PAGE_ROWS) shown = (size_t)ADDR_PAGE_ROWS;
  for (uint8_t r = 0; r < (uint8_t)shown; r++) {
    size_t at = start + r;
    Rect rr = addrRowRect(r);
    uint32_t idx = used[at];
    gfx->fillRoundRect(rr.x, rr.y, rr.w, rr.h, 8, UI_CARD);
    gfx->drawRoundRect(rr.x, rr.y, rr.w, rr.h, 8, UI_BORDER);
    gfx->setTextColor(RGB565_CYAN);
    gfx->setTextSize(1);
    gfx->setCursor(rr.x + 6, rr.y + 8);
    gfx->printf("#%u", (unsigned)idx);
    char a[80];
    bool ok = btc_address_for_index(g_addrType, g_addrAccount, g_addrChain, idx, a, sizeof(a));
    const int addrCol = rr.x + 52;
    gfx->setTextColor(RGB565_WHITE);
    if (ok) {
      const size_t len = strlen(a);
      const size_t MAX_PER_LINE = 40;
      gfx->setCursor(addrCol, rr.y + 4);
      size_t n1 = (len <= MAX_PER_LINE) ? len : MAX_PER_LINE;
      for (size_t i = 0; i < n1; i++) gfx->print(a[i]);
      if (len > n1) {
        gfx->setCursor(addrCol, rr.y + 22);
        for (size_t i = n1; i < len; i++) gfx->print(a[i]);
      }
    } else {
      gfx->setCursor(addrCol, rr.y + 8);
      gfx->print("Derivation failed");
    }
    gfx->setTextColor(RGB565_RED);
    gfx->setTextSize(2);
    gfx->setCursor(addrCol + 88, rr.y + 31);
    gfx->print("Used");
    gfx->setTextSize(1);
  }
  uint32_t maxPage = (n == 0) ? 0u : (uint32_t)((n - 1u) / (size_t)ADDR_PAGE_ROWS);
  if (g_addrStatusUsedPage > 0) {
    drawBtn(BTN_ADDR_PREV, "PREV", RGB565_DARKGREY, 2);
  }
  if (g_addrStatusUsedPage < maxPage) {
    drawBtn(BTN_ADDR_NEXT, "NEXT", RGB565_DARKGREY, 2);
  }
  ui_flush();
}

static uint32_t btc_address_path_coin_hardened(void);
static void format_btc_leaf_deriv_path(char* buf, size_t bufLen, AddrType t, uint32_t account, uint32_t chain,
                                       uint32_t index);
static const char* btc_account_name_for(uint32_t acct);

static const char* addr_type_bip_script_sentence(AddrType t) {
  switch (t) {
    case AddrType::P2PKH: return "BIP44 P2PKH (classic 1...).";
    case AddrType::P2SH_P2WPKH: return "BIP49 nested SegWit (3...).";
    case AddrType::P2WPKH: return "BIP84 native SegWit (bc1q...).";
    case AddrType::P2TR: return "BIP86 Taproot key-path (bc1p...).";
    default: return "Bitcoin single-sig.";
  }
}

// Receive/change list or QR: live path + per-level meaning (globals g_addr*, g_addrQr*).
static void drawAddressExplorerLeafPathHelp(bool fromQrScreen) {
  const uint32_t chain = g_addrChain;
  uint32_t idx;
  if (fromQrScreen) {
    idx = g_addrQrIndex;
  } else {
    idx = (g_addrGotoHighlightIdx != kAddrHighlightNone) ? g_addrGotoHighlightIdx
                                                         : (g_addrPage * (uint32_t)ADDR_PAGE_ROWS);
  }
  const bool multisig = fromQrScreen ? g_addrQrFromMultisigReceive : g_addrExplorerMultisig;

  int16_t y = 56;
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(2);
  gfx->setCursor(14, y);
  gfx->print("Derivation path");
  y += 22;

  const uint16_t kPathHelpOrange = RGB565_BITCOIN_ORANGE;
  const int kLineChars = 21;
  const int kLineSkip = 18;
  const uint8_t kTxt = 2;
  const int kX = 14;

  if (multisig) {
    char ms[168];
    snprintf(ms, sizeof(ms),
             "Multisig deposit address. %s chain, index %lu. The coordinator builds the script; exported descriptors use wallet-specific paths.",
             chain == 0 ? "Receive" : "Change", (unsigned long)idx);
    y = drawWrappedLabelTextWords(ms, kX, y, kLineChars, kLineSkip, LCD_H - 8, kTxt, RGB565_WHITE);
    return;
  }

  char path[56];
  format_btc_leaf_deriv_path(path, sizeof(path), g_addrType, g_addrAccount, chain, idx);
  y = drawWrappedLabelTextWords(path, kX, y, kLineChars, kLineSkip, LCD_H - 8, kTxt, kPathHelpOrange);
  y += 8;

  uint32_t purpose =
    (g_addrType == AddrType::P2PKH) ? 44u
                                    : (g_addrType == AddrType::P2SH_P2WPKH ? 49u
                                                                           : (g_addrType == AddrType::P2TR ? 86u : 84u));
  uint32_t coin = btc_address_path_coin_hardened();
  char val[20];
  char desc[160];

  y = drawAddrHelpValueThenWhiteDesc("m", "Root of the key tree from your seed (BIP32).", y, kX, kLineSkip,
                                     LCD_H - 8, kTxt, kPathHelpOrange);

  snprintf(val, sizeof(val), "%lu'", (unsigned long)purpose);
  snprintf(desc, sizeof(desc), "Purpose: %s", addr_type_bip_script_sentence(g_addrType));
  y = drawAddrHelpValueThenWhiteDesc(val, desc, y, kX, kLineSkip, LCD_H - 8, kTxt, kPathHelpOrange);

  snprintf(val, sizeof(val), "%lu'", (unsigned long)coin);
  if (coin == 0u) {
    snprintf(desc, sizeof(desc), "Coin: Bitcoin mainnet (BIP44 type %lu').", (unsigned long)coin);
  } else {
    snprintf(desc, sizeof(desc), "Coin: Bitcoin testnet (BIP44 type %lu').", (unsigned long)coin);
  }
  y = drawAddrHelpValueThenWhiteDesc(val, desc, y, kX, kLineSkip, LCD_H - 8, kTxt, kPathHelpOrange);

  snprintf(val, sizeof(val), "%lu'", (unsigned long)g_addrAccount);
  snprintf(desc, sizeof(desc), "Account: separate account/sub-account. Current: \"%s\".",
           btc_account_name_for(g_addrAccount));
  y = drawAddrHelpValueThenWhiteDesc(val, desc, y, kX, kLineSkip, LCD_H - 8, kTxt, kPathHelpOrange);

  snprintf(val, sizeof(val), "%lu", (unsigned long)chain);
  if (chain == 0u) {
    strncpy(desc, "Chain: receive. Addresses you share.", sizeof(desc));
  } else {
    strncpy(desc, "Chain: change. Used when you spend.", sizeof(desc));
  }
  desc[sizeof(desc) - 1] = 0;
  y = drawAddrHelpValueThenWhiteDesc(val, desc, y, kX, kLineSkip, LCD_H - 8, kTxt, kPathHelpOrange);

  snprintf(val, sizeof(val), "%lu", (unsigned long)idx);
  snprintf(desc, sizeof(desc), "Index: which address number in this chain.");
  (void)drawAddrHelpValueThenWhiteDesc(val, desc, y, kX, kLineSkip, LCD_H - 8, kTxt, kPathHelpOrange);
}

