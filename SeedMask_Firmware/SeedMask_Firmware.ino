}

static void lockout_save_max_attempts(uint8_t v) {
  if (v != 5 && v != 10 && v != 15) return;
  g_lockoutMaxAttempts = v;
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar("lock_max_att", v);
  prefs.end();
}

/** Show-attempts banner vs silent wipe are mutually exclusive (at most one true). */
static void lockout_save_show_attempts(bool show) {
  if (show && g_lockoutWipeSilently)
    lockout_save_wipe_silent(false);
  g_lockoutShowAttempts = show;
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar("lock_show_att", show ? 1u : 0u);
  prefs.remove("lock_show_attempts");
  prefs.end();
}

static void lockout_save_wipe_silent(bool on) {
  if (on && g_lockoutShowAttempts)
    lockout_save_show_attempts(false);
  g_lockoutWipeSilently = on;
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putUChar("lock_wipe_sl", on ? 1u : 0u);
  prefs.end();
}

static void drawLockoutShowToggle(const Rect& r, bool on) {
  if (r.w <= 0 || r.h <= 0) return;
  const int rad = r.h / 2;
  const uint16_t trackCol = on ? RGB565_YELLOW : RGB565_DARKGREY;
  gfx->fillRoundRect(r.x, r.y, r.w, r.h, rad, trackCol);
  gfx->drawRoundRect(r.x, r.y, r.w, r.h, rad, UI_BORDER);
  const int knobR = max(2, rad - 3);
  const int knobTravel = r.w - 2 * rad;
  const float t = on ? 1.f : 0.f;
  const int knobCx = r.x + rad + (int)((float)knobTravel * t + 0.5f);
  const int knobCy = r.y + rad;
  gfx->fillCircle(knobCx, knobCy, knobR, RGB565_WHITE);
  gfx->drawCircle(knobCx, knobCy, knobR, UI_BORDER);
}

static void lockout_clear_vpw_prewrap_ram() {
  secure_memzero(s_hollowVpwWrap, sizeof(s_hollowVpwWrap));
  s_hollowVpwWrapLen = 0;
  secure_memzero(s_hollowVpwSalt, sizeof(s_hollowVpwSalt));
  s_hollowVpwValid = false;
}

static void lockout_clear_silent_wipe_snapshot() {
  secure_memzero(s_lockoutSvPinWrap, sizeof(s_lockoutSvPinWrap));
  s_lockoutSvPinWrapLen = 0;
  secure_memzero(s_lockoutSvSalt, sizeof(s_lockoutSvSalt));
  s_lockoutSvSlMode = 0;
  g_lockoutSilentWipeArmed = false;
  g_lockoutSilentNoVerify = false;
}

static bool session_should_show_lock_screen() {
  return (g_hasVault && !g_stateless) || g_lockoutSilentWipeArmed || g_lockoutSilentNoVerify;
}

static void lockout_nvs_remove_hollow_keys(Preferences& prefs) {
  prefs.remove("hl_arm");
  prefs.remove("hl_mode");
  prefs.remove("hl_salt");
  prefs.remove("hl_wrap");
  prefs.remove("vpw_h_salt");
  prefs.remove("vpw_h_wrap");
}

/** Owner opened empty Home: drop fake lock from RAM and flash. PIN/password check is gone. */
static void lockout_disarm_hollow_lock() {
  lockout_clear_silent_wipe_snapshot();
  lockout_clear_vpw_prewrap_ram();
  screen_lock_clear_pin_mode();
  Preferences prefs;
  prefs.begin("seedmask", false);
  lockout_nvs_remove_hollow_keys(prefs);
  prefs.end();
}

static void lockout_preload_vpw_hollow_from_nvs() {
  Preferences prefs;
  prefs.begin("seedmask", true);
  const size_t slen = prefs.getBytesLength("vpw_h_salt");
  const size_t wlen = prefs.getBytesLength("vpw_h_wrap");
  if (slen != 16 || wlen < 28 || wlen > sizeof(s_hollowVpwWrap)) {
    prefs.end();
    return;
  }
  prefs.getBytes("vpw_h_salt", s_hollowVpwSalt, 16);
  prefs.getBytes("vpw_h_wrap", s_hollowVpwWrap, wlen);
  prefs.end();
  s_hollowVpwWrapLen = wlen;
  s_hollowVpwValid = true;
}

/** After reboot: restore fake lock from NVS (seed is not stored). */
static void lockout_load_hollow_armed_from_nvs() {
  Preferences prefs;
  prefs.begin("seedmask", true);
  const uint8_t armed = prefs.getUChar("hl_arm", 0);
  if (armed == 0) {
    prefs.end();
    return;
  }
  const uint8_t mode = prefs.getUChar("hl_mode", 0);
  const size_t slen = prefs.getBytesLength("hl_salt");
  const size_t wlen = prefs.getBytesLength("hl_wrap");
  if (slen != 16 || wlen < 28 || wlen > sizeof(s_lockoutSvPinWrap)) {
    prefs.end();
    g_lockoutSilentWipeArmed = false;
    g_lockoutSilentNoVerify = true;
    return;
  }
  prefs.getBytes("hl_salt", s_lockoutSvSalt, 16);
  prefs.getBytes("hl_wrap", s_lockoutSvPinWrap, wlen);
  prefs.end();
  s_lockoutSvPinWrapLen = wlen;
  s_lockoutSvSlMode = (mode == 1 || mode == 2) ? mode : 0;
  g_lockoutSilentWipeArmed = true;
  g_lockoutSilentNoVerify = false;
  if (s_lockoutSvSlMode == 1) {
    g_screenLockUsesPin = true;
    g_screenLockSeparatePw = false;
  } else if (s_lockoutSvSlMode == 2) {
    g_screenLockUsesPin = false;
    g_screenLockSeparatePw = true;
  } else {
    g_screenLockUsesPin = false;
    g_screenLockSeparatePw = false;
  }
  if (s_lockoutSvSlMode == 1 || s_lockoutSvSlMode == 2) {
    memcpy(g_pinSalt, s_lockoutSvSalt, 16);
    g_pinWrapBlobLen = s_lockoutSvPinWrapLen;
    memcpy(g_pinWrapBlobStore, s_lockoutSvPinWrap, s_lockoutSvPinWrapLen);
  }
}

static bool lockout_refresh_vpw_hollow_verifier(const char* vaultPw) {
  if (!vaultPw || !vaultPw[0]) return false;
  if (g_screenLockUsesPin || g_screenLockSeparatePw) return false;
  esp_fill_random(s_hollowVpwSalt, 16);
  uint8_t key[32];
  if (!pbkdf2_sha256((const uint8_t*)vaultPw, strlen(vaultPw), s_hollowVpwSalt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t plen = strlen(kHollowVpwWrapPayload) + 1;
  size_t ctlen = sizeof(s_hollowVpwWrap);
  if (!aes_gcm_encrypt_with_key(key, (const uint8_t*)kHollowVpwWrapPayload, plen, s_hollowVpwWrap, &ctlen)) {
    secure_memzero(key, sizeof(key));
    return false;
  }
  secure_memzero(key, sizeof(key));
  s_hollowVpwWrapLen = ctlen;
  s_hollowVpwValid = true;
  Preferences prefs;
  prefs.begin("seedmask", false);
  prefs.putBytes("vpw_h_salt", s_hollowVpwSalt, 16);
  prefs.putBytes("vpw_h_wrap", s_hollowVpwWrap, s_hollowVpwWrapLen);
  prefs.end();
  return true;
}

static bool lockout_hollow_constant_unwrap(const char* pw) {
  if (!pw || !pw[0] || s_lockoutSvPinWrapLen < 28) return false;
  uint8_t key[32];
  char out[48];
  if (!pbkdf2_sha256((const uint8_t*)pw, strlen(pw), s_lockoutSvSalt, 16, PIN_PBKDF_ITERATIONS, key, sizeof(key)))
    return false;
  size_t ptlen = sizeof(out);
  bool ok = aes_gcm_decrypt_with_key(key, s_lockoutSvPinWrap, s_lockoutSvPinWrapLen, (uint8_t*)out, &ptlen);
  secure_memzero(key, sizeof(key));
  if (!ok || ptlen == 0 || ptlen >= sizeof(out) || out[ptlen - 1] != '\0') {
    secure_memzero(out, sizeof(out));
    return false;
  }
  const size_t expect = strlen(kHollowVpwWrapPayload) + 1;
  const bool match = (ptlen == expect && memcmp(out, kHollowVpwWrapPayload, expect) == 0);
  secure_memzero(out, sizeof(out));
  return match;
}

/**
 * RAM kept across silent wipe for post-wipe unlock → HOME (never a seed copy):
 * - PIN / separate screen lock: sl_wrap + salt (unwraps master pw, discarded).
 * - Vault-password-only lock: wrap of a constant derived at last lock/unlock.
 */
static bool lockout_snapshot_secrets_for_silent_wipe() {
  lockout_clear_silent_wipe_snapshot();
  if (g_screenLockUsesPin)
    s_lockoutSvSlMode = 1;
  else if (g_screenLockSeparatePw)
    s_lockoutSvSlMode = 2;
  else
    s_lockoutSvSlMode = 0;

  if (s_lockoutSvSlMode == 1 || s_lockoutSvSlMode == 2) {
    memcpy(s_lockoutSvSalt, g_pinSalt, 16);
    if (g_pinWrapBlobLen < 28 || g_pinWrapBlobLen > sizeof(s_lockoutSvPinWrap)) return false;
    s_lockoutSvPinWrapLen = g_pinWrapBlobLen;
    memcpy(s_lockoutSvPinWrap, g_pinWrapBlobStore, g_pinWrapBlobLen);
    return true;
  }

  if (!s_hollowVpwValid) lockout_preload_vpw_hollow_from_nvs();
  if (!s_hollowVpwValid || s_hollowVpwWrapLen < 28 || s_hollowVpwWrapLen > sizeof(s_lockoutSvPinWrap))
    return false;
  memcpy(s_lockoutSvSalt, s_hollowVpwSalt, 16);
  s_lockoutSvPinWrapLen = s_hollowVpwWrapLen;
  memcpy(s_lockoutSvPinWrap, s_hollowVpwWrap, s_hollowVpwWrapLen);
  return true;
}

/** Returns true if device was wiped (caller must not continue normal error path). */
static bool lockout_register_failure() {
  if (g_lockoutSilentWipeArmed) return false;
  if (g_lockoutMaxAttempts < 1) return false;
  if (g_lockFailedAttempts < 255) g_lockFailedAttempts++;
  lockout_persist_fail_count();
  if (g_lockFailedAttempts < g_lockoutMaxAttempts) return false;

  const bool wantSilent = g_lockoutWipeSilently;
  bool snapshotOk = false;
  if (wantSilent) snapshotOk = lockout_snapshot_secrets_for_silent_wipe();

  const bool preserveSilent = g_lockoutWipeSilently;
  const uint8_t preserveMax = g_lockoutMaxAttempts;
  const bool preserveShow = g_lockoutShowAttempts;

  g_lockFailedAttempts = 0;

  if (!wantSilent) {
    lockout_clear_silent_wipe_snapshot();
    nvs_wipe(true);
    screen_lock_load_prefs();
    lockout_load_prefs();
    duress_load_all_prefs();
    g_hasVault = false;
    session_lock_to_home();
    return true;
  }

  // Wipe silently ON: never use session_lock_to_home() here (would jump HOME when vault is gone).
  // NVS only here (seed gone in ~1s). SPIFFS overwrite continues in the background so the
  // lock screen can show Wrong PIN and keep accepting tries.
  nvs_wipe_silent_seed();
  {
    Preferences prefs;
    prefs.begin("seedmask", false);
    prefs.putUChar("lock_wipe_sl", preserveSilent ? 1u : 0u);
    prefs.putUChar("lock_max_att", preserveMax);
    prefs.putUChar("lock_show_att", preserveShow ? 1u : 0u);
    prefs.putUChar("lock_fail_cnt", 0);
    if (snapshotOk && s_lockoutSvPinWrapLen >= 28 && s_lockoutSvPinWrapLen <= sizeof(s_lockoutSvPinWrap)) {
      prefs.putUChar("hl_arm", 1);
      prefs.putUChar("hl_mode", s_lockoutSvSlMode);
      prefs.putBytes("hl_salt", s_lockoutSvSalt, 16);
      prefs.putBytes("hl_wrap", s_lockoutSvPinWrap, s_lockoutSvPinWrapLen);
      if (s_lockoutSvSlMode == 1 || s_lockoutSvSlMode == 2) {
        prefs.putUChar("sl_pin", s_lockoutSvSlMode);
        prefs.putBytes("sl_salt", s_lockoutSvSalt, 16);
        prefs.putBytes("sl_wrap", s_lockoutSvPinWrap, s_lockoutSvPinWrapLen);
      }
    }
    prefs.end();
  }
  screen_lock_load_prefs();
  lockout_load_prefs();
  duress_load_all_prefs();
  g_hasVault = false;
  g_lockoutSilentWipeArmed = snapshotOk;
  g_lockoutSilentNoVerify = !snapshotOk;
  if (snapshotOk && (s_lockoutSvSlMode == 1 || s_lockoutSvSlMode == 2)) {
    memcpy(g_pinSalt, s_lockoutSvSalt, 16);
    g_pinWrapBlobLen = s_lockoutSvPinWrapLen;
    memcpy(g_pinWrapBlobStore, s_lockoutSvPinWrap, s_lockoutSvPinWrapLen);
    g_screenLockUsesPin = (s_lockoutSvSlMode == 1);
    g_screenLockSeparatePw = (s_lockoutSvSlMode == 2);
  }
  session_stay_on_locked_after_silent_wipe();
  nvs_wipe_start_spiffs_bg();
  return false;
}

// Stateful only: save passwords+notes to NVS (encrypted with master password). Uses session key cache to avoid PBKDF2 on every save.
static bool decoy_vault_persist_active() {
  return g_duressSession && g_duressSessionType == DuressBehavior::DECOY_VAULT && s_duressDecoyVaultKeyValid;
}

static bool session_can_persist_vault_data() {
  if (g_stateless || g_tempSeedActive || g_bip39HasPassphrase || !g_loggedIn) return false;
  if (decoy_vault_persist_active()) return true;
  return g_masterPw[0] != 0;
}

/** User never chose a vault/backup password (onboard used a device-internal key). */
static bool session_needs_user_vault_password_for_pm() {
  if (decoy_vault_persist_active()) return false;
  if (g_portableBackupReady) return false;
  if (pwSvc_getCount() > 0 || g_noteCount > 0 || g_totpCount > 0) return false;
  return true;
}

/** If ADD must collect a user password first, open that screen and return true. */
static bool pw_notes_tfa_prompt_vault_password_if_needed(UIScreen returnTo) {
  if (!session_needs_user_vault_password_for_pm()) return false;
  g_createVaultPasswordThenAdd = true;
  g_vaultPwThenAddReturn = returnTo;
  g_creatingMasterPassword = false;
  g_createBackupFromSeedSettings = false;
  clearPassword(g_password1);
  clearPassword(g_password2);
  g_pwMasked = true;
  setMsg("Min 12 chars, A-Z, digit, symbol.");
  show(UIScreen::CREATE_PASSWORD);
  return true;
}

static bool session_persist_vault_requires_sd() {
  return !decoy_vault_persist_active();
}

/** Real vault writes need a card. Sets Insert microSD to save and returns false when missing. */
static bool vault_require_sd_for_pm_save() {
  if (!session_persist_vault_requires_sd()) return true;
  if (sd_ready()) return true;
  setMsg("Insert microSD to save");
  return false;
}

/** Persist passwords/notes to NVS; SD first when required for the real vault. */
static bool vault_commit_passwords_notes_persist() {
  if (!session_can_persist_vault_data()) {
    setMsg("No password in session");
    return false;
  }
  if (session_persist_vault_requires_sd()) {
    if (!sd_ready()) {
      setMsg("Insert microSD to save");
      return false;
    }
    if (!pw_vault_save_to_sd(g_masterPw)) {
      if (g_sdSavePathPickOpen) return true;
      setMsg("SD save failed - retry");
      return false;
    }
  } else if (sd_ready() && g_masterPw[0]) {
    (void)pw_vault_save_to_sd(g_masterPw);
  }
  save_passwords_notes_to_nvs();
  return true;
}

static void import_passwords_notes_totp_from_plain(const char* p, size_t plainLen) {
  pwSvc_clearAll();
  g_noteCount = 0;
  g_totpCount = 0;
  if (g_noteItems) memset(g_noteItems, 0, NOTE_ITEMS_TOTAL_BYTES);
  memset(g_totpItems, 0, sizeof(g_totpItems));
  const char* sepN = "\n---N---\n";
  const char* sepT = "\n---T---\n";
  const char* q = strstr(p, sepN);
  if (q) {
    size_t pwLen = (size_t)(q - p);
    vault_import_passwords_plaintext(p, pwLen);
    const char* afterNotes = q + strlen(sepN);
    const char* tPart = strstr(afterNotes, sepT);
    if (tPart && tPart >= afterNotes) {
      notes_deserialize_plain(afterNotes, (size_t)(tPart - afterNotes));
      totp_deserialize_plain(tPart + strlen(sepT), plainLen - (size_t)(tPart - p) - strlen(sepT));
    } else {
      notes_deserialize_plain(afterNotes, plainLen - pwLen - strlen(sepN));
      const char* tInFull = strstr(p, sepT);
      if (tInFull) totp_deserialize_plain(tInFull + strlen(sepT), plainLen - (size_t)(tInFull - p) - strlen(sepT));
    }
  } else {
    vault_import_passwords_plaintext(p, plainLen);
    const char* tInFull = strstr(p, sepT);
    if (tInFull) totp_deserialize_plain(tInFull + strlen(sepT), plainLen - (size_t)(tInFull - p) - strlen(sepT));
  }
}

static void save_passwords_notes_to_nvs() {
  // Temporary wallet context is session-only: never write into master vault storage.
  if (g_tempSeedActive) return;
  // Passphrase crypto session uses empty RAM vault; do not overwrite persisted master vault.
  if (g_bip39HasPassphrase) return;
  if (g_stateless || !g_loggedIn) return;
  if (decoy_vault_persist_active()) {
    duress_decoy_vault_pw_save_nvs();
    return;
  }
  if (!g_masterPw[0]) return;
  String s;
  s.reserve(8000);  // allow long notes
  s += vault_export_passwords_plaintext();
  s += "\n---N---\n";
  for (uint8_t i = 0; i < g_noteCount; i++) {
    s += g_noteItems[i].title;
    s += "\t";
    s += g_noteItems[i].body;
    s += "\n";
  }
  s += "\n---T---\n";
  s += totp_serialize_plain();
  size_t plainLen = s.length();
  if (plainLen == 0) {
    nvs_clear_vault_pw();
    return;
  }
  const uint8_t* plain = (const uint8_t*)s.c_str();
  size_t ctAlloc = 12 + 16 + plainLen;
  size_t ctLen = ctAlloc;
  uint8_t* ct = (uint8_t*)ps_malloc(ctLen);
  if (!ct) return;
  bool enc_ok = false;
  if (s_vault_nvs_key_valid) {
    enc_ok = aes_gcm_encrypt_with_key(s_vault_nvs_key, plain, plainLen, ct, &ctLen);
  }
  if (!enc_ok) {
    if (!pbkdf2_sha256((const uint8_t*)g_masterPw, strlen(g_masterPw), VAULT_NVS_SALT, 4, PBKDF2_ITERATIONS, s_vault_nvs_key, 32)) {
      secure_memzero(ct, ctAlloc);
      free(ct);
      return;
    }
    s_vault_nvs_key_valid = true;
    ctLen = ctAlloc;
    enc_ok = aes_gcm_encrypt_with_key(s_vault_nvs_key, plain, plainLen, ct, &ctLen);
  }
  if (!enc_ok) {
    secure_memzero(ct, ctAlloc);
    free(ct);
    return;
  }
  size_t blobLen = 4 + ctLen;
  uint8_t* blob = (uint8_t*)ps_malloc(blobLen);
  if (!blob) {
    secure_memzero(ct, ctAlloc);
    free(ct);
    return;
  }
  memcpy(blob, VAULT_NVS_SALT, 4);
  memcpy(blob + 4, ct, ctLen);
  secure_memzero(ct, ctAlloc);
  free(ct);
  nvs_save_vault_pw(blob, blobLen);
  secure_memzero(blob, blobLen);
  free(blob);
}

// On unlock: load passwords+notes from NVS into PasswordService + g_noteItems (only when stateful had saved them)
static void load_passwords_notes_from_nvs(const char* masterPw) {
  uint8_t* blob = nullptr;
  size_t blen = 0;
  if (!nvs_load_vault_pw(&blob, blen) || blen < 4 + 12 + 16) {
    if (blob) {
      secure_memzero(blob, blen);
      free(blob);
    }
    return;
  }
  uint8_t salt[4];
  memcpy(salt, blob, 4);
  size_t ctLen = blen - 4;
  size_t plainCap = ctLen - 12 - 16;  // max decrypted size
  if (plainCap < 1) {
    secure_memzero(blob, blen);
    free(blob);
    return;
  }
  uint8_t* plain = (uint8_t*)ps_malloc(plainCap + 1);
  if (!plain) {
    secure_memzero(blob, blen);
    free(blob);
    return;
  }
  size_t plainLen = plainCap;
  if (!aes_gcm_decrypt(masterPw, salt, blob + 4, ctLen, plain, &plainLen)) {
    secure_memzero(plain, plainCap + 1);
    free(plain);
    secure_memzero(blob, blen);
    free(blob);
    return;
  }
  secure_memzero(blob, blen);
  free(blob);
  plain[plainLen] = 0;
  import_passwords_notes_totp_from_plain((const char*)plain, plainLen);
  secure_memzero(plain, plainCap + 1);
  free(plain);
}

// Derive and cache vault keys (blob + seed) so saves skip PBKDF2. Call after unlock when g_masterPw and g_seed are set.
static void warm_vault_key_cache(void) {
  if (!g_masterPw[0] || g_wc == 0) return;
  uint8_t seedPacked[33];
  uint16_t idx[24];
  for (int i = 0; i < g_wc; i++) {
    int16_t fi = bip39_find_index(g_seed[i]);
    if (fi < 0) return;
    idx[i] = (uint16_t)fi;
  }
  if (!pack_seed_indices(idx, g_wc, seedPacked, sizeof(seedPacked))) return;
  size_t seedPackedLen = packed_len_for_words(g_wc);
  uint8_t seed_hash[32];
  mbedtls_sha256_context sha_ctx;
  mbedtls_sha256_init(&sha_ctx);
  mbedtls_sha256_starts(&sha_ctx, 0);
  mbedtls_sha256_update(&sha_ctx, (const uint8_t*)g_masterPw, strlen(g_masterPw));
  mbedtls_sha256_update(&sha_ctx, seedPacked, seedPackedLen);
  mbedtls_sha256_finish(&sha_ctx, seed_hash);
  char seed_specific_pw[65];
  for (int i = 0; i < 32; i++) sprintf(seed_specific_pw + i * 2, "%02x", seed_hash[i]);
  seed_specific_pw[64] = 0;
  if (!pbkdf2_sha256((const uint8_t*)seed_specific_pw, 64, VAULT_BLOB_SALT, 4, PBKDF2_ITERATIONS, s_vault_blob_key, 32)) return;
  s_vault_blob_key_valid = true;
  if (!pbkdf2_sha256((const uint8_t*)g_masterPw, strlen(g_masterPw), VAULT_SEED_SALT, 4, PBKDF2_ITERATIONS, s_vault_seed_key, 32)) return;
  s_vault_seed_key_valid = true;
  if (!pbkdf2_sha256((const uint8_t*)g_masterPw, strlen(g_masterPw), VAULT_NVS_SALT, 4, PBKDF2_ITERATIONS, s_vault_nvs_key, 32)) return;
  s_vault_nvs_key_valid = true;
}

// ---- microSD vault/backup path disambiguation (e.g. renamed PW_*.bin beside canonical) ----
static const char SD_PREF_VAULT_PATH[] = "sd_vw";
static const char SD_PREF_BACKUP_PATH[] = "sd_bc";
static uint8_t g_sdSavePathPickStep = 0;  // 0=intro, 1=pick vault, 2=pick backup
static char g_sdSavePickFolder[192] = { 0 };
static char g_sdSavePickCanonVault[192] = { 0 };
static int g_sdSavePickVaultN = 0;
static char (*g_sdSavePickVaultPaths)[192] = nullptr;  // 8 paths — PSRAM
static int g_sdSavePickBkN = 0;
static char (*g_sdSavePickBkPaths)[192] = nullptr;     // 8 paths — PSRAM
static int g_sdSavePickScroll = 0;
static bool g_pwVaultSaveSkipSdAmbOnce = false;
static char g_sdSavePickCanonBackup[192] = { 0 };
static char g_sdSavePickSelVault[192] = { 0 };
// Step 1 (pick vault): global row index 0..(vault_rows-1), or -1 until user taps a row; Continue applies.
static int g_sdSavePickVaultRowSel = -1;
// True if canonical PW_<xfp>.bin exists on SD when the picker opens (vs. suggested path only).
static bool g_sdSavePickCanonVaultOnSd = false;

static void sd_prefs_clear_sd_blob_paths() {
  Preferences pr;
  pr.begin("seedmask", false);
  pr.remove(SD_PREF_VAULT_PATH);
  pr.remove(SD_PREF_BACKUP_PATH);
  pr.end();
}

static void sd_prefs_put_vault_path(const char* p) {
  Preferences pr;
  pr.begin("seedmask", false);
  if (p && p[0]) pr.putString(SD_PREF_VAULT_PATH, p);
  else pr.remove(SD_PREF_VAULT_PATH);
  pr.end();
}

static void sd_prefs_put_backup_path(const char* p) {
  Preferences pr;
  pr.begin("seedmask", false);
  if (p && p[0]) pr.putString(SD_PREF_BACKUP_PATH, p);
  else pr.remove(SD_PREF_BACKUP_PATH);
  pr.end();
}

static bool sd_prefs_get_vault_path(char* out, size_t cap) {
  if (!out || cap < 2) return false;
  out[0] = 0;
  Preferences pr;
  pr.begin("seedmask", true);
  String s = pr.getString(SD_PREF_VAULT_PATH, "");
  pr.end();
  if (!s.length()) return false;
  strncpy(out, s.c_str(), cap - 1);
  out[cap - 1] = 0;
  return out[0] != 0;
}

static bool sd_prefs_get_backup_path(char* out, size_t cap) {
  if (!out || cap < 2) return false;
  out[0] = 0;
  Preferences pr;
  pr.begin("seedmask", true);
  String s = pr.getString(SD_PREF_BACKUP_PATH, "");
  pr.end();
  if (!s.length()) return false;
  strncpy(out, s.c_str(), cap - 1);
  out[cap - 1] = 0;
  return out[0] != 0;
}

static bool pw_vault_probe_matching_wallet(const char* fullpath, const char* masterPw) {
  if (!g_loggedIn || g_wc == 0 || g_wc > 24 || !masterPw || strlen(masterPw) < 4) return false;
  FILE* f = fopen(fullpath, "rb");
  if (!f) return false;
  uint8_t hdr[4];
  if (fread(hdr, 1, 4, f) != 4) {
    fclose(f);
    return false;
  }
  bool spv2 = (memcmp(hdr, "SPV2", 4) == 0);
  if (!spv2 && memcmp(hdr, "SPV1", 4) != 0) {
    fclose(f);
    return false;
  }
  uint8_t seed_salt[4];
  if (fread(seed_salt, 1, 4, f) != 4) {
    fclose(f);
    return false;
  }
  uint8_t encrypted_seed_data[12 + (1 + 24 * 2) + 16];
  size_t encrypted_seed_len;
  if (spv2) {
    uint16_t n = 0;
    if (fread(&n, 1, 2, f) != 2 || (n != 53 && n != 77)) {
      fclose(f);
      return false;
    }
    encrypted_seed_len = fread(encrypted_seed_data, 1, n, f);
    if (encrypted_seed_len != n) {
      fclose(f);
      return false;
    }
  } else {
    encrypted_seed_len = fread(encrypted_seed_data, 1, 53, f);
    if (encrypted_seed_len != 53) {
      fclose(f);
      return false;
    }
  }
  uint8_t stored_seed_data[1 + 24 * 2];
  size_t decrypted_seed_len = sizeof(stored_seed_data);
  if (!aes_gcm_decrypt(masterPw, seed_salt, encrypted_seed_data, encrypted_seed_len, stored_seed_data, &decrypted_seed_len)) {
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    fclose(f);
    return false;
  }
  uint8_t stored_wc = stored_seed_data[0];
  if (stored_wc != 12 && stored_wc != 24) {
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    fclose(f);
    return false;
  }
  uint16_t stored_idx[24];
  for (int i = 0; i < (int)stored_wc; i++)
    stored_idx[i] = (uint16_t)((stored_seed_data[1 + i * 2] << 8) | stored_seed_data[1 + i * 2 + 1]);
  uint8_t stored_packed[33];
  if (!pack_seed_indices(stored_idx, stored_wc, stored_packed, sizeof(stored_packed))) {
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    fclose(f);
    return false;
  }
  size_t cmpLen = packed_len_for_words(stored_wc);
  uint16_t cur_idx[24];
  for (int i = 0; i < (int)g_wc; i++) {
    int16_t fi = bip39_find_index(g_seed[i]);
    if (fi < 0) {
      secure_memzero(stored_seed_data, sizeof(stored_seed_data));
      fclose(f);
      return false;
    }
    cur_idx[i] = (uint16_t)fi;
  }
  uint8_t cur_packed[33];
  if (!pack_seed_indices(cur_idx, g_wc, cur_packed, sizeof(cur_packed))) {
    secure_memzero(stored_seed_data, sizeof(stored_seed_data));
    fclose(f);
    return false;
  }
  bool ok = (stored_wc == g_wc && cmpLen <= 33 && memcmp(stored_packed, cur_packed, cmpLen) == 0);
  secure_memzero(stored_seed_data, sizeof(stored_seed_data));
  fclose(f);
  return ok;
}

static int sd_list_wallet_vault_bins(const char* folder, char out[][192], int maxOut, const char* masterPw) {
  if (!folder || !folder[0] || maxOut <= 0) return 0;
  int n = 0;
  DIR* d = opendir(folder);
  if (!d) return 0;
  struct dirent* ent;
  while ((ent = readdir(d)) != NULL && n < maxOut) {
    if (ent->d_name[0] == '.') continue;
    size_t nl = strlen(ent->d_name);
    if (nl < 5 || strncasecmp(ent->d_name + nl - 4, ".bin", 4) != 0) continue;
    char full[192];
    snprintf(full, sizeof(full), "%s/%s", folder, ent->d_name);
    struct stat st;
    if (stat(full, &st) != 0 || !S_ISREG(st.st_mode)) continue;
    if (!sd_bin_file_header_is_pw_vault(full)) continue;
    if (!pw_vault_probe_matching_wallet(full, masterPw)) continue;
    strncpy(out[n], full, sizeof(out[0]) - 1);
    out[n][sizeof(out[0]) - 1] = 0;
    n++;
  }
  closedir(d);
  return n;
}

static int sd_list_wallet_backup_bins(const char* folder, char out[][192], int maxOut, const char* masterPw,
                                      const char* skipPath1) {
  if (!folder || !folder[0] || maxOut <= 0 || !masterPw || strlen(masterPw) < 4) return 0;
  int n = 0;
  DIR* d = opendir(folder);
  if (!d) return 0;
  char codeTry[512];
  struct dirent* ent;
  while ((ent = readdir(d)) != NULL && n < maxOut) {
    if (ent->d_name[0] == '.') continue;
    size_t nl = strlen(ent->d_name);
    if (nl < 5 || strncasecmp(ent->d_name + nl - 4, ".bin", 4) != 0) continue;
    char full[192];
    snprintf(full, sizeof(full), "%s/%s", folder, ent->d_name);
    struct stat st;
    if (stat(full, &st) != 0 || !S_ISREG(st.st_mode)) continue;
    if (sd_bin_file_header_is_pw_vault(full)) continue;
    if (skipPath1 && skipPath1[0] && strcmp(full, skipPath1) == 0) continue;
    if (!backup_code_load_from_sd(masterPw, codeTry, sizeof(codeTry), full)) continue;
    secure_memzero(codeTry, sizeof(codeTry));
    strncpy(out[n], full, sizeof(out[0]) - 1);
    out[n][sizeof(out[0]) - 1] = 0;
    n++;
  }
  closedir(d);
  return n;
}

static void sd_open_vault_save_path_picker(const char* folder, const char* canonVault, int nVault, const char vaultPaths[][192]) {
  g_sdSavePathPickOpen = true;
  g_sdSavePathPickStep = 0;
  g_sdSavePickScroll = 0;
  strncpy(g_sdSavePickFolder, folder, sizeof(g_sdSavePickFolder) - 1);
  g_sdSavePickFolder[sizeof(g_sdSavePickFolder) - 1] = 0;
  strncpy(g_sdSavePickCanonVault, canonVault, sizeof(g_sdSavePickCanonVault) - 1);
  g_sdSavePickCanonVault[sizeof(g_sdSavePickCanonVault) - 1] = 0;
  g_sdSavePickVaultN = nVault;
  for (int i = 0; i < nVault && i < 8; i++) {
    if (!g_sdSavePickVaultPaths) break;
    strncpy(g_sdSavePickVaultPaths[i], vaultPaths[i], sizeof(g_sdSavePickVaultPaths[0]) - 1);
    g_sdSavePickVaultPaths[i][sizeof(g_sdSavePickVaultPaths[0]) - 1] = 0;
  }
  g_sdSavePickBkN = 0;
  strncpy(g_sdSavePickCanonBackup, BC_FILE, sizeof(g_sdSavePickCanonBackup) - 1);
  g_sdSavePickCanonBackup[sizeof(g_sdSavePickCanonBackup) - 1] = 0;
  struct stat stcv;
  g_sdSavePickCanonVaultOnSd = (stat(canonVault, &stcv) == 0 && S_ISREG(stcv.st_mode));
}

static bool pw_vault_save_to_sd(const char* masterPw) {
  Serial.println("pw_vault_save_to_sd: Starting save...");
  if (!masterPw || strlen(masterPw) < 4) return false;
  if (g_tempSeedActive || g_bip39HasPassphrase) return false;
  if (!sd_ready()) {
    Serial.println("pw_vault_save_to_sd: SD not ready");
    return false;
  }
  Serial.println("pw_vault_save_to_sd: SD ready, preparing to save...");

  if (!seedmask_prepare_sd_backup_paths_for_current_vault()) {
    Serial.println("pw_vault_save_to_sd: Failed to prepare BACKUP <fp> paths");
    return false;
  }

  bool bypassSdVaultAmbiguity = g_pwVaultSaveSkipSdAmbOnce;
  if (bypassSdVaultAmbiguity)
    g_pwVaultSaveSkipSdAmbOnce = false;

  {
    char prefVault[192];
    bool usedPrefVault = false;
    if (sd_prefs_get_vault_path(prefVault, sizeof(prefVault))) {
      struct stat st;
      if (stat(prefVault, &st) == 0 && S_ISREG(st.st_mode)) {
        strncpy(PW_FILE, prefVault, sizeof(PW_FILE) - 1);
        PW_FILE[sizeof(PW_FILE) - 1] = 0;
        usedPrefVault = true;
      }
    }
    if (!usedPrefVault && !bypassSdVaultAmbiguity) {
      char canonVault[192];
      strncpy(canonVault, PW_FILE, sizeof(canonVault) - 1);
      canonVault[sizeof(canonVault) - 1] = 0;
      char folder[192];
      strncpy(folder, canonVault, sizeof(folder) - 1);
      folder[sizeof(folder) - 1] = 0;
      char* slash = strrchr(folder, '/');
      if (slash && slash > folder) {
        *slash = 0;
        char cand[8][192];
        int n = sd_list_wallet_vault_bins(folder, cand, 8, masterPw);
        struct stat st;
        bool canonExists = (stat(canonVault, &st) == 0 && S_ISREG(st.st_mode));
        bool needPick = false;
        if (n >= 2)
          needPick = true;
        else if (n == 1) {
          if (strcasecmp(cand[0], canonVault) != 0)
            needPick = true;
          else if (!canonExists)
            needPick = true;
        }
        if (needPick) {
          sd_open_vault_save_path_picker(folder, canonVault, n, cand);
          setMsg("Choose SD save target");
          return false;
        }
      }
    }
  }

  // Build plaintext: passwords (title\tvalue\n) + separator + notes (title\tbody\n) — same as NVS
  String plain;
  plain.reserve(8000);  // allow long notes (12 * 512 + passwords)
  plain += vault_export_passwords_plaintext();
  plain += "\n---N---\n";
  for (uint8_t i = 0; i < g_noteCount; i++) {
    plain += g_noteItems[i].title;
    plain += "\t";
    plain += g_noteItems[i].body;
    plain += "\n";
  }
  plain += "\n---T---\n";
  plain += totp_serialize_plain();
  size_t plain_len = plain.length();
#if SEEDMASK_CRYPTO_DEBUG
  Serial.print("pw_vault_save_to_sd: Plain length (pw+notes+totp): ");
  Serial.println(plain_len);
#endif

  size_t encrypted_data_len = 12 + 16 + plain_len;  // iv(12) + tag(16) + data
  size_t total_len = 8 + encrypted_data_len;        // salt(4) + len(4) + encrypted_data
  uint8_t* ct = (uint8_t*)ps_malloc(total_len);
  if (!ct) {
    Serial.println("pw_vault_save_to_sd: Memory allocation failed");
    return false;
  }
  memcpy(ct, VAULT_BLOB_SALT, 4);
  uint32_t len = (uint32_t)encrypted_data_len;
  memcpy(ct + 4, &len, 4);

  size_t actual_encrypted_len = encrypted_data_len;
  bool blob_encrypt_ok = false;
  if (s_vault_blob_key_valid) {
    blob_encrypt_ok = aes_gcm_encrypt_with_key(s_vault_blob_key, (const uint8_t*)plain.c_str(), plain_len, ct + 8, &actual_encrypted_len);
  }
  if (!blob_encrypt_ok) {
    // Derive and cache blob key (or first save / cache invalid)
    uint8_t seedPacked[33];
    uint16_t idx[24];
    for (int i = 0; i < g_wc; i++) {
      int16_t fi = bip39_find_index(g_seed[i]);
      if (fi < 0) {
        Serial.println("pw_vault_save_to_sd: Seed contains invalid word");
        secure_memzero(ct, total_len);
        free(ct);
        return false;
      }
      idx[i] = (uint16_t)fi;
    }
    if (!pack_seed_indices(idx, g_wc, seedPacked, sizeof(seedPacked))) {
      Serial.println("pw_vault_save_to_sd: Failed to pack seed");
      secure_memzero(ct, total_len);
      free(ct);
      return false;
    }
    size_t seedPackedLen = packed_len_for_words(g_wc);
    uint8_t seed_hash[32];
    mbedtls_sha256_context sha_ctx;
    mbedtls_sha256_init(&sha_ctx);
    mbedtls_sha256_starts(&sha_ctx, 0);
    mbedtls_sha256_update(&sha_ctx, (const uint8_t*)masterPw, strlen(masterPw));
    mbedtls_sha256_update(&sha_ctx, seedPacked, seedPackedLen);
    mbedtls_sha256_finish(&sha_ctx, seed_hash);
    char seed_specific_pw[65];
    for (int i = 0; i < 32; i++) sprintf(seed_specific_pw + i * 2, "%02x", seed_hash[i]);
    seed_specific_pw[64] = 0;
    if (!pbkdf2_sha256((const uint8_t*)seed_specific_pw, 64, VAULT_BLOB_SALT, 4, PBKDF2_ITERATIONS, s_vault_blob_key, 32)) {
      secure_memzero(seed_specific_pw, sizeof(seed_specific_pw));
      secure_memzero(ct, total_len);
      free(ct);
      Serial.println("pw_vault_save_to_sd: PBKDF2 blob key failed");
      return false;
    }
    s_vault_blob_key_valid = true;
    actual_encrypted_len = encrypted_data_len;
    blob_encrypt_ok = aes_gcm_encrypt_with_key(s_vault_blob_key, (const uint8_t*)plain.c_str(), plain_len, ct + 8, &actual_encrypted_len);
    secure_memzero(seed_specific_pw, sizeof(seed_specific_pw));
  }
  if (!blob_encrypt_ok) {
    secure_memzero(ct, total_len);
    free(ct);
    Serial.println("pw_vault_save_to_sd: Encryption failed");
    return false;
  }

  // Remove old file
  Serial.print("pw_vault_save_to_sd: Removing file: ");
  Serial.println(PW_FILE);
  remove(PW_FILE);

  // Open new file for writing
  FILE* f = fopen(PW_FILE, "wb");
  if (!f) {
    Serial.print("pw_vault_save_to_sd: Failed to open file: ");
    Serial.println(PW_FILE);
    secure_memzero(ct, total_len);
    free(ct);
    setMsg("Open failed");
    return false;
  }
  Serial.print("pw_vault_save_to_sd: File opened successfully: ");
  Serial.println(PW_FILE);

  bool ok = true;
  Serial.println("pw_vault_save_to_sd: Writing header...");
  size_t header_written = fwrite("SPV2", 1, 4, f);
  if (header_written != 4) {
    Serial.println("pw_vault_save_to_sd: Failed to write header");
    ok = false;
  }

  // Encrypt seed data with vault password for security
  uint8_t plain_seed_data[1 + 24 * 2];  // wc(1) + indices(24*2)
  plain_seed_data[0] = g_wc;
  for (int i = 0; i < g_wc; i++) {
    uint16_t idx = bip39_find_index(g_seed[i]);
    plain_seed_data[1 + i * 2] = (idx >> 8) & 0xFF;
    plain_seed_data[1 + i * 2 + 1] = idx & 0xFF;
  }

  // Encrypt seed data with vault password (output: iv(12)+plaintext+tag(16); 24-word = 12+49+16 = 77)
  uint8_t encrypted_seed_data[12 + (1 + 24 * 2) + 16];
  size_t seed_encrypted_len = sizeof(encrypted_seed_data);
  if (s_vault_seed_key_valid) {
    if (!aes_gcm_encrypt_with_key(s_vault_seed_key, plain_seed_data, 1 + g_wc * 2, encrypted_seed_data, &seed_encrypted_len))
      ok = false;
  } else {
    if (!pbkdf2_sha256((const uint8_t*)masterPw, strlen(masterPw), VAULT_SEED_SALT, 4, PBKDF2_ITERATIONS, s_vault_seed_key, 32)) {
      Serial.println("pw_vault_save_to_sd: PBKDF2 seed key failed");
      ok = false;
    } else {
      s_vault_seed_key_valid = true;
      seed_encrypted_len = sizeof(encrypted_seed_data);
      if (!aes_gcm_encrypt_with_key(s_vault_seed_key, plain_seed_data, 1 + g_wc * 2, encrypted_seed_data, &seed_encrypted_len))
        ok = false;
    }
  }
  if (!ok) Serial.println("pw_vault_save_to_sd: Failed to encrypt seed data");

  // Write seed salt (fixed for session cache) + length(2) + encrypted seed data (SPV2 supports 12- and 24-word)
  size_t seed_written = fwrite(VAULT_SEED_SALT, 1, 4, f);
  uint16_t se_len = (uint16_t)seed_encrypted_len;
  seed_written += fwrite(&se_len, 1, 2, f);
  seed_written += fwrite(encrypted_seed_data, 1, seed_encrypted_len, f);
  if (seed_written != (4 + 2 + seed_encrypted_len)) {
    Serial.println("pw_vault_save_to_sd: Failed to write encrypted seed data");
    ok = false;
  }

  Serial.println("pw_vault_save_to_sd: Writing encrypted data...");
  size_t data_written = fwrite(ct, 1, 8 + actual_encrypted_len, f);
  size_t spua_written = 0;
  size_t addr_sd_w = 0;
  uint8_t* addr_sd_buf = nullptr;
  if (!g_tempSeedActive) {
    addr_sd_buf = (uint8_t*)ps_malloc(6200u);
    if (addr_sd_buf && addr_status_write_blob(addr_sd_buf, 6200u, &addr_sd_w)) {
      spua_written += fwrite("SPUA", 1, 4, f);
      uint32_t uw = (uint32_t)addr_sd_w;
      spua_written += fwrite(&uw, 4, 1, f);
      spua_written += fwrite(addr_sd_buf, 1, addr_sd_w, f);
    }
    if (addr_sd_buf) {
      secure_memzero(addr_sd_buf, 6200u);
      free(addr_sd_buf);
    }
  }
  size_t written = header_written + seed_written + data_written + spua_written;
  Serial.print("pw_vault_save_to_sd: Total written bytes: ");
  Serial.println(written);
  // Expected: header(4) + seed_salt(4) + encrypted_seed_data + encrypted_password_data(8 + actual_encrypted_len) + optional SPUA
  size_t expected_bytes = 4 + 4 + 2 + seed_encrypted_len + 8 + actual_encrypted_len + spua_written;
  if (written != expected_bytes) {
    Serial.print("pw_vault_save_to_sd: ERROR - Write failed! Expected ");
    Serial.print(expected_bytes);
    Serial.print(", got ");
    Serial.println(written);
    ok = false;
  }

  if (fflush(f) != 0) {
    Serial.println("pw_vault_save_to_sd: Failed to flush file");
    Serial.print("pw_vault_save_to_sd: Error: ");
    Serial.println(strerror(errno));
    ok = false;
  }

  int fclose_result = fclose(f);
  if (fclose_result != 0) {
    Serial.print("pw_vault_save_to_sd: Failed to close file, error: ");
    Serial.println(strerror(errno));
    ok = false;
  }

  secure_memzero(ct, total_len);
  free(ct);
  Serial.println("pw_vault_save_to_sd: File closed and memory freed");
  Serial.print("pw_vault_save_to_sd: Save ");
  Serial.println(ok ? "SUCCESSFUL" : "FAILED");

  if (ok) {
    // Extract just the filename from the full path
    const char* filename = strrchr(PW_FILE, '/');
    if (filename) {
      filename++;  // Skip the '/'
    } else {
      filename = PW_FILE;
    }

    // Show success message with filename
    char successMsg[128];
    snprintf(successMsg, sizeof(successMsg), "Passwords saved as: %s", filename);
    setMsg(successMsg);
    Serial.print("pw_vault_save_to_sd: Success message: ");
    Serial.println(successMsg);
  }

  return ok;
}

static const char* sd_pick_basename_cstr(const char* p) {
  if (!p || !p[0]) return "";
  const char* s = strrchr(p, '/');
  return s ? (s + 1) : p;
}

static int sd_pick_vault_rows() {
  return 1 + g_sdSavePickVaultN;
}
static int sd_pick_backup_rows() {
  return 1 + g_sdSavePickBkN;
}

static void sd_pick_sync_vault_row_sel_from_sel_vault_path() {
  g_sdSavePickVaultRowSel = -1;
  if (!g_sdSavePickSelVault[0]) return;
  if (strcasecmp(g_sdSavePickSelVault, g_sdSavePickCanonVault) == 0) {
    g_sdSavePickVaultRowSel = 0;
    return;
  }
  for (int i = 0; i < g_sdSavePickVaultN; i++) {
    if (strcasecmp(g_sdSavePickSelVault, g_sdSavePickVaultPaths[i]) == 0) {
      g_sdSavePickVaultRowSel = i + 1;
      return;
    }
  }
}

static void pw_edit_resume_after_sd_picker_success();

static void sd_pick_apply_prefs_and_retry_vault_save(const char* vaultPath, const char* backupPath) {
  sd_prefs_put_vault_path(vaultPath);
  sd_prefs_put_backup_path(backupPath);
  g_sdSavePathPickOpen = false;
  g_sdSavePathPickStep = 0;
  g_sdSavePickScroll = 0;
  setMsg("");
  g_pwVaultSaveSkipSdAmbOnce = true;
  if (pw_vault_save_to_sd(g_masterPw)) {
    save_passwords_notes_to_nvs();
    pw_edit_resume_after_sd_picker_success();
  } else if (!g_sdSavePathPickOpen) {
    setMsg("SD save failed - retry");
    draw();
  }
}

static void sd_pick_use_defaults_and_retry() {
  sd_prefs_clear_sd_blob_paths();
  g_pwVaultSaveSkipSdAmbOnce = true;
  g_sdSavePathPickOpen = false;
  g_sdSavePathPickStep = 0;
  g_sdSavePickScroll = 0;
  setMsg("");
  if (pw_vault_save_to_sd(g_masterPw)) {
    save_passwords_notes_to_nvs();
    pw_edit_resume_after_sd_picker_success();
  } else if (!g_sdSavePathPickOpen) {
    setMsg("SD save failed - retry");
    draw();
  }
}

static void drawSdSavePathPickerUi() {
  const int pad = 10;
  gfx->fillScreen(UI_BG);
