static void crypto_accounts_capture_active_addr() {
  if (crypto_home_asset_is_kaspa()) g_kaspaAddrAccount = g_addrAccount;
  else g_btcAddrAccount = g_addrAccount;
}
static void crypto_accounts_sync_runtime_addr() {
  if (crypto_home_asset_is_kaspa()) {
    if (!kaspa_accounts_contains(g_kaspaAddrAccount)) g_kaspaAddrAccount = 0;
    g_addrAccount = g_kaspaAddrAccount;
  } else {
    if (!btc_accounts_contains(g_btcAddrAccount)) g_btcAddrAccount = 0;
    g_addrAccount = g_btcAddrAccount;
  }
}
static void crypto_accounts_load_all() {
  btc_accounts_load_from_prefs();
  kaspa_accounts_load_from_prefs();
  crypto_accounts_sync_runtime_addr();
}
static void crypto_accounts_save_all_prefs() {
  crypto_accounts_capture_active_addr();
  btc_accounts_save_to_prefs();
  kaspa_accounts_save_to_prefs();
}
static uint8_t crypto_accounts_list_count() {
  return crypto_home_asset_is_kaspa() ? g_kaspaAccountListCount : g_btcAccountListCount;
}
static uint32_t crypto_accounts_list_at(uint8_t i) {
  return crypto_home_asset_is_kaspa() ? g_kaspaAccountList[i] : g_btcAccountList[i];
}
static bool crypto_accounts_contains(uint32_t a) {
  return crypto_home_asset_is_kaspa() ? kaspa_accounts_contains(a) : btc_accounts_contains(a);
}
static const char* crypto_account_name_for(uint32_t acct) {
  return crypto_home_asset_is_kaspa() ? kaspa_account_name_for(acct) : btc_account_name_for(acct);
}
static bool crypto_account_set_name(uint32_t acct, const char* name) {
  return crypto_home_asset_is_kaspa() ? kaspa_account_set_name(acct, name) : btc_account_set_name(acct, name);
}
static bool crypto_accounts_add(uint32_t acct, const char* name) {
  bool ok = crypto_home_asset_is_kaspa() ? kaspa_accounts_add(acct, name) : btc_accounts_add(acct, name);
  if (ok) crypto_accounts_sync_runtime_addr();
  return ok;
}
static bool crypto_accounts_remove(uint32_t acct) {
  bool ok = crypto_home_asset_is_kaspa() ? kaspa_accounts_remove(acct) : btc_accounts_remove(acct);
  if (ok) crypto_accounts_sync_runtime_addr();
  return ok;
}

// Carousel: slot 0 = Crypto settings, slots 1.. = active coin account list[slot-1].
static uint8_t crypto_carousel_count() {
  return (uint8_t)(1 + crypto_accounts_list_count());
}
static uint8_t crypto_carousel_slot() {
  if (g_screen == UIScreen::CRYPTO_SETTINGS) return 0;
  if (g_screen == UIScreen::CRYPTO_HOME || g_screen == UIScreen::CRYPTO_TOOLS_MENU) {
    uint8_t n = crypto_accounts_list_count();
    for (uint8_t i = 0; i < n; i++) {
      if (crypto_accounts_list_at(i) == g_addrAccount) return (uint8_t)(i + 1);
    }
    return 1;
  }
  return 0;
}
static void crypto_carousel_apply_slot(uint8_t s) {
  if (s == 0) {
    show(UIScreen::CRYPTO_SETTINGS);
    return;
  }
  g_addrAccount = crypto_accounts_list_at((uint8_t)(s - 1));
  crypto_accounts_save_all_prefs();
  invalidate_address_explorer_cache();
  multisig_invalidate_visible_list();
  multisig_clamp_settings_scroll();
  show(UIScreen::CRYPTO_HOME);
}
static void crypto_carousel_run_transition(bool swipeLeft, uint8_t targetSlot) {
  static uint16_t* s_fromFrame = nullptr;
  static uint16_t* s_toFrame = nullptr;
  const size_t pxCount = (size_t)LCD_W * (size_t)LCD_H;
  const size_t bytes = pxCount * sizeof(uint16_t);

  if (!s_fromFrame) s_fromFrame = (uint16_t*)ps_malloc(bytes);
  if (!s_toFrame) s_toFrame = (uint16_t*)ps_malloc(bytes);
  if (!s_fromFrame || !s_toFrame) {
    crypto_carousel_apply_slot(targetSlot);
    return;
  }

  draw();
  uint16_t* fb = gfx->getFramebuffer();
  if (!fb) {
    crypto_carousel_apply_slot(targetSlot);
    return;
  }
  memcpy(s_fromFrame, fb, bytes);

  crypto_carousel_apply_slot(targetSlot);  // show() draws target immediately
  fb = gfx->getFramebuffer();
  if (!fb) return;
  memcpy(s_toFrame, fb, bytes);

  const uint8_t frames = 4;
  const uint16_t frameDelayMs = 4;  // ~16ms total
  const int yContent0 = CRYPTO_CAROUSEL_CONTENT_Y0;
  for (uint8_t f = 0; f < frames; f++) {
    float t = (float)(f + 1) / (float)frames;
    float eased = t * t * (3.0f - 2.0f * t);  // smoothstep easing
    int off = (int)(eased * (float)LCD_W);
    if (off < 1) off = 1;
    if (off > LCD_W) off = LCD_W;

    int xOld = swipeLeft ? -off : off;
    int xNew = swipeLeft ? (LCD_W - off) : (off - LCD_W);

    for (int y = 0; y < LCD_H; y++) {
      uint16_t* dst = fb + (size_t)y * (size_t)LCD_W;
      const uint16_t* rowOld = s_fromFrame + (size_t)y * (size_t)LCD_W;
      const uint16_t* rowNew = s_toFrame + (size_t)y * (size_t)LCD_W;

      if (y < yContent0) {
        memcpy(dst, rowNew, (size_t)LCD_W * sizeof(uint16_t));
        continue;
      }

      memset(dst, 0, (size_t)LCD_W * sizeof(uint16_t));

      int d0 = max(0, xOld);
      int d1 = min(LCD_W, xOld + LCD_W);
      if (d1 > d0) {
        int s0 = d0 - xOld;
        memcpy(dst + d0, rowOld + s0, (size_t)(d1 - d0) * sizeof(uint16_t));
      }

      d0 = max(0, xNew);
      d1 = min(LCD_W, xNew + LCD_W);
      if (d1 > d0) {
        int s0 = d0 - xNew;
        memcpy(dst + d0, rowNew + s0, (size_t)(d1 - d0) * sizeof(uint16_t));
      }
    }
    ui_flush();
    delay(frameDelayMs);
  }
  draw();
}
static void crypto_carousel_go_to(uint8_t s) {
  uint8_t n = crypto_carousel_count();
  if (s >= n) return;
  uint8_t cur = crypto_carousel_slot();
  if (s == cur) return;
  bool onCarouselScreen = (g_screen == UIScreen::CRYPTO_HOME || g_screen == UIScreen::CRYPTO_SETTINGS || g_screen == UIScreen::CRYPTO_TOOLS_MENU);
  if (!onCarouselScreen) {
    crypto_carousel_apply_slot(s);
    return;
  }
  bool swipeLeft = true;
  // Adjacent hops (including wrap) should always animate in the exact navigation direction.
  if (s == (uint8_t)((cur + 1) % n)) {
    swipeLeft = true;
  } else if (s == (uint8_t)((cur + n - 1) % n)) {
    swipeLeft = false;
  } else {
    int diff = (int)s - (int)cur;
    swipeLeft = (diff > 0);
    if (abs(diff) > (int)(n / 2)) swipeLeft = !swipeLeft;  // non-adjacent dot jumps
  }
  crypto_carousel_run_transition(swipeLeft, s);
}
static bool tryHitUnifiedCryptoDots(uint16_t x, uint16_t y) {
  if (g_cryptoUnifiedDotCount == 0 || g_cryptoUnifiedDotHitR <= 0) return false;
  const int hitR = (int)g_cryptoUnifiedDotHitR + 10;
  for (uint8_t k = 0; k < g_cryptoUnifiedDotCount; k++) {
    int dx = (int)x - g_cryptoUnifiedDotCx[k];
    int dy = (int)y - g_cryptoUnifiedDotCy;
    if (dx * dx + dy * dy > hitR * hitR) continue;
    if (k != crypto_carousel_slot()) crypto_carousel_go_to(k);
    return true;
  }
  return false;
}

static Rect btcCryptoCardRect(uint8_t idx) {
  // Match main menu card geometry (same size/spacing style): 150x110 tiles in a 2-column grid.
  const int16_t x0 = 10, x1 = 165, y0 = 130, w = 150, h = 110, gap = 5;
  uint8_t row = (uint8_t)(idx >> 1), col = (uint8_t)(idx & 1u);
  return { col ? x1 : x0, (int16_t)(y0 + row * (h + gap)), w, h };
}

static int16_t cryptoAssetBadgeStackRight() {
  return (int16_t)(BTN_CRYPTO_BTC_BADGE.x + CRYPTO_ASSET_BADGE_BACK_DX + CRYPTO_ASSET_BADGE_BACK_DRAW + 12);
}

static bool cryptoHomeLogoDriftBand(int16_t px, int16_t py) {
  const int16_t cardTop = btcCryptoCardRect(0).y;
  return px >= (int16_t)(BTN_CRYPTO_BTC_BADGE.x - CRYPTO_ASSET_BADGE_HIT_PAD_L)
         && px < CRYPTO_ASSET_BADGE_DRIFT_CLAIM_RIGHT
         && py >= (int16_t)(BTN_CRYPTO_BTC_BADGE.y - CRYPTO_ASSET_BADGE_HIT_PAD_T)
         && py < cardTop;
}

static bool hitCryptoAssetBadge(int16_t px, int16_t py) {
  if (hit(CRYPTO_ASSET_BADGE_HIT, px, py)) return true;
  return cryptoHomeLogoDriftBand(px, py);
}

static bool cryptoHomeTopCardStealsLogoTap(uint8_t cardIdx, int16_t px, int16_t py) {
  if (cardIdx > 1u) return false;
  return cryptoHomeLogoDriftBand(px, py);
}

static void drawCryptoAssetLogo(int16_t x, int16_t y, const uint16_t* progBmp, int16_t w, int16_t h, bool dimmed) {
  if (w <= 0 || h <= 0 || w > 32 || h > 32) return;
  uint16_t ram[32 * 32];
  const uint32_t n = (uint32_t)w * (uint32_t)h;
  for (uint32_t i = 0; i < n; i++) {
    uint16_t c = pgm_read_word(&progBmp[i]);
    if (c == CRYPTO_ASSET_LOGO_CHROMA) {
      ram[i] = CRYPTO_ASSET_LOGO_CHROMA;
    } else if (dimmed) {
      ram[i] = blend565(RGB565_BLACK, c, CRYPTO_ASSET_BADGE_BACK_BRIGHT);
    } else {
      ram[i] = c;
    }
  }
  gfx->draw16bitRGBBitmapWithTranColor(x, y, ram, CRYPTO_ASSET_LOGO_CHROMA, w, h);
}

static void drawCryptoHomeAssetBadge() {
  const Rect& r = BTN_CRYPTO_BTC_BADGE;
  const int16_t backSz = CRYPTO_ASSET_BADGE_BACK_DRAW;
  const int16_t bx = (int16_t)(r.x + CRYPTO_ASSET_BADGE_BACK_DX);
  const int16_t by = (int16_t)(r.y + (r.h - backSz) / 2);
  const bool kaspaFront = crypto_home_asset_is_kaspa();
  if (kaspaFront) {
    drawCryptoAssetLogo(bx, by, BITCOIN_LOGO_MENU_BACK_RGB565, (int16_t)BITCOIN_LOGO_MENU_BACK_RGB565_W,
                        (int16_t)BITCOIN_LOGO_MENU_BACK_RGB565_H, true);
    drawCryptoAssetLogo((int16_t)r.x, (int16_t)r.y, KASPA_LOGO_RGB565, (int16_t)KASPA_LOGO_RGB565_W,
                        (int16_t)KASPA_LOGO_RGB565_H, false);
  } else {
    drawCryptoAssetLogo(bx, by, KASPA_LOGO_BACK_RGB565, (int16_t)KASPA_LOGO_BACK_RGB565_W,
                        (int16_t)KASPA_LOGO_BACK_RGB565_H, true);
    drawCryptoAssetLogo((int16_t)r.x, (int16_t)r.y, BITCOIN_LOGO_MENU_RGB565, (int16_t)BITCOIN_LOGO_MENU_RGB565_W,
                        (int16_t)BITCOIN_LOGO_MENU_RGB565_H, false);
  }
}

// Under the toggle: one row — Crypto settings (slot 0), then each account in order (slots 1.. = default, 1, 2…). One orange = active carousel screen.
static void drawDefaultModeDotsUnderToggle() {
  char lab[64];
  bool showLabel = true;
  // Crypto settings is carousel slot 0; never use g_addrAccount here — it still holds the
  // last Bitcoin account index, so showing btc_account_name_for(g_addrAccount) looked like
  // "the last account's name" on the wrong screen.
  if (g_tempSeedActive) {
    strncpy(lab, "Temporary seed", sizeof(lab) - 1);
    lab[sizeof(lab) - 1] = 0;
  } else if (g_screen == UIScreen::CRYPTO_SETTINGS) {
    strncpy(lab, "Crypto settings", sizeof(lab) - 1);
    lab[sizeof(lab) - 1] = 0;
  } else {
    strncpy(lab, crypto_account_name_for(g_addrAccount), sizeof(lab) - 1);
    lab[sizeof(lab) - 1] = 0;
  }
  const uint8_t labelTextSize = 2;  // slightly larger than default (1) under the toggle
  gfx->setTextSize(labelTextSize);
  gfx->setTextColor(RGB565_LIGHTGREY);
  const int cw = 6 * (int)labelTextSize;
  int tw = (int)strlen(lab) * cw;
  int tx = BTN_CRYPTO_TO_MENU_TOGGLE.x + (BTN_CRYPTO_TO_MENU_TOGGLE.w - tw) / 2;
  if (tx < 0) tx = 0;
  const int16_t labY = (int16_t)(BTN_CRYPTO_TO_MENU_TOGGLE.y + BTN_CRYPTO_TO_MENU_TOGGLE.h + 2);
  if (showLabel) {
    gfx->setCursor(tx, labY);
    gfx->print(lab);
  }
  const int16_t cxMid = BTN_CRYPTO_TO_MENU_TOGGLE.x + BTN_CRYPTO_TO_MENU_TOGGLE.w / 2;
  // One text line below baseline + tight gap to dot row (match old size-1 vertical rhythm).
  const int16_t cy = (int16_t)(labY + (8 * (int)labelTextSize) + 2);
  uint8_t nAcc = crypto_accounts_list_count();
  if (nAcc == 0) nAcc = 1;
  uint16_t total = (uint16_t)(1 + nAcc);
  if (total > MAX_UNIFIED_CRYPTO_DOTS) total = MAX_UNIFIED_CRYPTO_DOTS;
  int16_t dr = 4;
  int16_t ggap = 8;
  if (total > 8) {
    dr = 3;
    ggap = 5;
  }
  if (total > 14) {
    dr = 2;
    ggap = 4;
  }
  if (total > 20) {
    dr = 2;
    ggap = 3;
  }
  int32_t totalW = (int32_t)total * (2 * dr) + (int32_t)(total - 1) * ggap;
  int32_t xStart = (int32_t)cxMid - totalW / 2 + dr;
  g_cryptoUnifiedDotCy = cy;
  g_cryptoUnifiedDotHitR = dr;
  g_cryptoUnifiedDotCount = (uint8_t)total;
  const uint8_t slotNow = crypto_carousel_slot();
  for (uint16_t k = 0; k < total; k++) {
    int16_t cx = (int16_t)(xStart + (int32_t)k * (2 * dr + ggap));
    g_cryptoUnifiedDotCx[k] = cx;
    bool orange = (slotNow == k);
    uint16_t col = orange ? cryptoHomeAccentColor() : RGB565_WHITE;
    gfx->fillCircle(cx, cy, dr, col);
  }
}

