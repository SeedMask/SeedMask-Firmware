// Restoring screen: "Restoring. Please wait." + modern rotating-arc spinner (used on RESTORE screens when g_busy)
static void drawValidatingScreen() {
  gfx->fillScreen(RGB565_BLACK);
  gfx->setTextColor(UI_TEXT);
  gfx->setTextSize(2);
  const char* line1 = "Restoring.";
  const char* line2 = "Please wait.";
  int w1 = (int)strlen(line1) * 12;
  int w2 = (int)strlen(line2) * 12;
  gfx->setCursor((320 - w1) / 2, 160);
  gfx->print(line1);
  gfx->setCursor((320 - w2) / 2, 184);
  gfx->print(line2);
  // Modern spinner: thin circle + rotating accent arc (wedge)
  const int cx = 160, cy = 260, r = 32;
  gfx->drawCircle(cx, cy, r, UI_BORDER);
  gfx->drawCircle(cx, cy, r - 1, UI_BORDER);
  float angle_deg = fmodf((float)millis() * 0.2f, 360.0f);
  const float arc_deg = 85.0f;
  const float deg2rad = 0.0174532925f;
  float a0 = angle_deg * deg2rad;
  float a1 = (angle_deg + arc_deg) * deg2rad;
  int x0 = (int)(cx + r * cosf(a0));
  int y0 = (int)(cy - r * sinf(a0));
  int x1 = (int)(cx + r * cosf(a1));
  int y1 = (int)(cy - r * sinf(a1));
  gfx->fillTriangle(cx, cy, x0, y0, x1, y1, UI_ACCENT);
  ui_flush();
}

