            }
#endif
            int listBottom = (g_screen == UIScreen::PASSWORDS) ? (g_pwListDetailedView ? PW_DETAIL_BOTTOM : PW_GRID_BOTTOM) : LIST_AREA_BOTTOM;
            int listRight = 268;
            if (g_screen == UIScreen::PASSWORDS && g_pwListDetailedView) listRight = 286;
            bool inList = (sx >= 10 && sx <= (uint16_t)listRight && sy >= (uint16_t)LIST_AREA_TOP && sy <= (uint16_t)listBottom);
            bool editMode = (g_screen == UIScreen::PASSWORDS && g_pwListEditMode) || (g_screen == UIScreen::NOTES && g_noteListEditMode);
            if (inList && !editMode) {
              if (g_screen == UIScreen::PASSWORDS && g_showPwListViewPopup) {
                handlePwNotesTap(sx, sy);
                break;
              }
              // When "Enter password to show" popup is visible, handle tap immediately on touch down (same as LOCKED/keyboard screens)
              if (g_screen == UIScreen::PASSWORDS && g_showMasterPwShowPopup) {
                handlePwNotesTap(sx, sy);
                break;
              }
              // When Send popup is visible, tap on Send button (centered) must be handled immediately
              if (g_screen == UIScreen::PASSWORDS && g_showSendPopup && g_sendPopupPwIndex < pwSvc_getCount()) {
                if (pwSendButtonHit((int16_t)sx, (int16_t)sy)) {
                  handlePwNotesTap(sx, sy);
                  break;
                }
              }
#if SEEDMASK_NOTE_SEND_UI
              if (g_screen == UIScreen::NOTES && g_showNoteSendPopup && g_noteSendPopupIndex < g_noteCount) {
                if (noteSendButtonHitForIndex(g_noteSendPopupIndex, (int16_t)sx, (int16_t)sy)) {
                  handlePwNotesTap(sx, sy);
                  break;
                }
              }
#endif
              // If Send popup is up and user touches a different card, dismiss popup
              if (g_screen == UIScreen::PASSWORDS && g_showSendPopup && pwSvc_getCount() > 0) {
                uint8_t ri = 0xFF;
                if (pwIndexFromTap((int16_t)sx, (int16_t)sy, ri) && ri != g_sendPopupPwIndex) {
                  g_showSendPopup = false;
                  draw();
                }
              }
              if (g_screen == UIScreen::NOTES && g_showNoteSendPopup && g_noteCount > 0) {
                uint8_t ri = 0;
                if (!noteIndexFromTap((int16_t)sx, (int16_t)sy, ri) || ri != g_noteSendPopupIndex) {
                  g_showNoteSendPopup = false;
                  draw();
                }
              }

              // If user tapped in the blank list area (no tile/caption hit), do nothing.
              uint8_t riTap = 0xFF;
              if (g_screen == UIScreen::PASSWORDS) {
                if (!pwIndexFromTap((int16_t)sx, (int16_t)sy, riTap)) break;
              } else {  // NOTES (grid)
                if (!noteIndexFromTap((int16_t)sx, (int16_t)sy, riTap)) break;
              }

              g_listTouchPending = true;
              g_listTouchDownX = sx;
              g_listTouchDownY = sy;
              g_listTouchDownMs = now;
              g_listDidDrag = false;
              g_listLongPressTriggered = false;
              g_pwListLongPressStartMs = now;
              if (g_screen == UIScreen::PASSWORDS && pwSvc_getCount() > 0) {
                g_pwListLongPressRow = riTap;
                g_pwLongPressWasOnTitle = (!g_pwListDetailedView) && pwTitleCaptionHitForIndex(riTap, (int16_t)sx, (int16_t)sy);
                g_noteListLongPressRow = 0xFF;
                g_listFlashActive = !g_pwLongPressWasOnTitle;  // only flash when holding tile, not title
                g_listFlashScreen = UIScreen::PASSWORDS;
                g_listFlashIndex = riTap;
                g_listFlashStartMs = now;
                draw();
              } else if (g_screen == UIScreen::NOTES && g_noteCount > 0) {
                g_noteListLongPressRow = riTap;
                g_noteLongPressWasOnTitle = noteTitleCaptionHitForIndex(riTap, (int16_t)sx, (int16_t)sy);
                g_pwListLongPressRow = 0xFF;
                g_listFlashActive = !g_noteLongPressWasOnTitle;  // only flash when holding tile, not title
                g_listFlashScreen = UIScreen::NOTES;
                g_listFlashIndex = riTap;
                g_listFlashStartMs = now;
                draw();
              } else {
                g_pwListLongPressRow = 0xFF;
                g_noteListLongPressRow = 0xFF;
              }
            } else {
              handlePwNotesTap(sx, sy);
            }
            break;
          }
        case UIScreen::TFA_LIST:
          {
            if (hit(BTN_TFA_ADD, sx, sy)) {
              handleTfaListTap(sx, sy);
              break;
            }
            const int LIST_SCROLL_TOP_TFA = 56, LIST_SCROLL_BOTTOM_TFA = 419;
            if ((int)sy >= LIST_SCROLL_TOP_TFA && (int)sy <= LIST_SCROLL_BOTTOM_TFA) {
              g_listTouchPending = true;
              g_listTouchDownX = sx;
              g_listTouchDownY = sy;
              g_listTouchDownMs = now;
              break;
            }
            handleTfaListTap(sx, sy);
            break;
          }
        case UIScreen::TFA_SHOW_CODE: handleTfaShowCodeTap(sx, sy); break;
        case UIScreen::TFA_ADD: handleTfaAddTap(sx, sy); break;
        case UIScreen::SET_TIME: handleSetTimeTap(sx, sy); break;
        case UIScreen::SECURITY_MENU: handleSecurityMenuTap(sx, sy); break;
        case UIScreen::SECURITY_LOCK_ATTEMPTS: handleSecurityLockAttemptsTap(sx, sy); break;
        case UIScreen::SECURITY_LOCK_ATTEMPTS_INFO: handleSecurityLockAttemptsInfoTap(sx, sy); break;
#if SEEDMASK_NOTE_SEND_UI
        case UIScreen::SECURITY_SENDING: handleSecuritySendingTap(sx, sy); break;
        case UIScreen::SECURITY_SENDING_INFO: handleSecuritySendingInfoTap(sx, sy); break;
        case UIScreen::SECURITY_SENDING_HOW: handleSecuritySendingHowTap(sx, sy); break;
#endif
        case UIScreen::SECURITY_LOCK_TYPE: handleSecurityLockTypeTap(sx, sy); break;
        case UIScreen::SECURITY_LOCK_PW_CONFIRM_VAULT: handleSecurityLockPwConfirmVaultTap(sx, sy); break;
        case UIScreen::SECURITY_LOCK_PW_SETUP: handleSecurityLockPwSetupTap(sx, sy); break;
        case UIScreen::SECURITY_DURESS_PW_SETUP: handleSecurityDuressPwSetupTap(sx, sy); break;
        case UIScreen::SECURITY_PIN_SETUP: handleSecurityPinSetupTap(sx, sy); break;
        case UIScreen::SECURITY_DURESS_MENU: handleSecurityDuressMenuTap(sx, sy); break;
        case UIScreen::SECURITY_DURESS_LOCK_MENU: handleSecurityDuressLockMenuTap(sx, sy); break;
        case UIScreen::SECURITY_DURESS_PIN_SETUP: handleSecurityDuressPinSetupTap(sx, sy); break;
        case UIScreen::SECURITY_DURESS_TYPE_MENU: handleSecurityDuressTypeMenuTap(sx, sy); break;
        case UIScreen::SECURITY_DURESS_TYPE_INFO: handleSecurityDuressTypeInfoTap(sx, sy); break;
        case UIScreen::DURESS_GAMES: break;  // tap on release (see g_duressGamesListTouchPending)
        case UIScreen::DURESS_GAME_SNAKE: handleDuressSnakeTap(sx, sy); break;
        case UIScreen::DURESS_GAME_STACK: handleDuressStackTap(sx, sy); break;
        case UIScreen::DURESS_GAME_BREAKOUT: handleDuressBreakoutTap(sx, sy); break;
        case UIScreen::DURESS_GAME_SPACE: handleDuressSpaceTap(sx, sy); break;
        case UIScreen::SD_BROWSER: handleSdBrowserTap(sx, sy); break;
        case UIScreen::EDITOR: handleOrphanEditorScreenTap(sx, sy); break;

        case UIScreen::ERROR_SCREEN:
        default: show(UIScreen::HOME); break;
      }
    }
  }

  // Deferred ±1 address page prefetch: run after touch dispatch so taps are not blocked (heavy derivation).
  if (g_addrNeighborPrefetchPending && !g_busy && vault_is_unlocked() && g_loggedIn) {
    bool blinkBlocking = (g_screen == UIScreen::ADDRESS_EXPLORER && g_addrExplorerStep == AddrExplorerStep::LIST && g_addrGotoHighlightIdx != kAddrHighlightNone && !g_addrGotoHighlightSettled);
    if (!blinkBlocking) {
      uint32_t t = millis();
      if (g_addrNeighborPrefetchEarliestMs != 0 && t < g_addrNeighborPrefetchEarliestMs) {
        // Post-solid grace window so a tap right after flashing ends is not stuck behind prefetch.
      } else {
        g_addrNeighborPrefetchPending = false;
        g_addrNeighborPrefetchEarliestMs = 0;
        if (!g_addrExplorerMultisig) prefetch_address_explorer_neighbors(g_addrPage);
      }
    }
  }

  // Static welcome / unlock: skip unrelated idle timers (HOME / CREATE_PICK / LOCKED — no periodic draw() like CRYPTO_MULTISIG_IMPORT).
  if (g_screen != UIScreen::HOME && g_screen != UIScreen::CREATE_PICK && g_screen != UIScreen::LOCKED) {
    // Password/note editor + 2FA add/edit: redraw every 700ms so cursor blinks continuously
    {
      static uint32_t s_lastPwCursorBlinkMs = 0;
      bool onPwEditor = (g_editMode == EditMode::ADD_PW_VALUE || g_editMode == EditMode::EDIT_PW_VALUE);
      bool onPwMeta = isAddPwMetaMode(g_editMode);
      bool onNoteBody = (g_editMode == EditMode::ADD_NOTE_BODY || g_editMode == EditMode::EDIT_NOTE_BODY);
      bool onTfaAdd = (g_screen == UIScreen::TFA_ADD);
      if ((onPwEditor || onPwMeta || onNoteBody || onTfaAdd) && !g_sdSavePathPickOpen
          && (now - s_lastPwCursorBlinkMs >= 700)) {
        s_lastPwCursorBlinkMs = now;
        draw();
      }
    }

    // DICEWARE / RANDOM CHARS mode transition: redraw every ~40ms for smooth color + scale animation
    {
      static uint32_t s_lastPwModeAnimMs = 0;
      bool onPwValueScreen = (g_editMode == EditMode::ADD_PW_VALUE || g_editMode == EditMode::EDIT_PW_VALUE) && !g_editingTitle;
      if (onPwValueScreen && !g_sdSavePathPickOpen && g_pwModeTransitionStartMs != 0 && (now - g_pwModeTransitionStartMs) < 320 && (now - s_lastPwModeAnimMs >= 40)) {
        s_lastPwModeAnimMs = now;
        draw();
      }
    }

    // Send popup animation: keep redrawing ~every 70ms while popup is visible (Passwords or Notes) so pulse + wave stay smooth
    {
      static uint32_t s_lastSendAnimMs = 0;
      bool pwAnim = g_showSendPopup && g_screen == UIScreen::PASSWORDS;
      bool noteAnim = g_showNoteSendPopup && g_screen == UIScreen::NOTES;
      if ((pwAnim || noteAnim) && !g_sdSavePathPickOpen) {
        if (now - s_lastSendAnimMs >= 70) {
          s_lastSendAnimMs = now;
          draw();
        }
      }
    }

    // CREATE_CONFIRM: end wrong-tap red flash cleanly (single redraw when timer expires).
    if (g_screen == UIScreen::CREATE_CONFIRM && g_confirmFlashK >= 0
        && (int32_t)(now - g_confirmFlashUntil) >= 0) {
      g_confirmFlashK = -1;
      draw();
    }

    // Backup code digit popup appearing animation: redraw every ~40ms for scale-in
    {
      static uint32_t s_lastBcPopupAnimMs = 0;
      if (g_showBackupCodeDigitPopup && g_screen == UIScreen::RESTORE_CODE) {
        uint32_t elapsed = now - g_backupCodePopupShownAtMs;
        if (elapsed < 250 && (now - s_lastBcPopupAnimMs >= 40)) {
          s_lastBcPopupAnimMs = now;
          draw();
        }
      }
    }

    // Rename feedback: chasing-dots loading → animated success → main menu + name flash.
    // Must use millis() here, not loop-start `now`: touch handling sets g_deviceRenameFeedbackPhaseStartMs
    // mid-iteration after `now` was sampled, so (now - startMs) unsigned-underflows and skipped the spinner.
    {
      static uint32_t s_lastRenameFbSpinMs = 0;
      if (g_screen == UIScreen::DEVICE_RENAME_FEEDBACK) {
        uint32_t fb = millis();
        if (g_deviceRenameFeedbackPhase == DeviceRenameFeedbackPhase::LOADING) {
          if (fb - g_deviceRenameFeedbackPhaseStartMs >= DEVICE_RENAME_LOADING_MS) {
            g_deviceRenameFeedbackPhase = DeviceRenameFeedbackPhase::SUCCESS;
            g_deviceRenameFeedbackPhaseStartMs = fb;
            draw();
          } else if (fb - s_lastRenameFbSpinMs >= 22) {
            s_lastRenameFbSpinMs = fb;
            draw();
          }
        } else {
          if (fb - g_deviceRenameFeedbackPhaseStartMs >= DEVICE_RENAME_SUCCESS_HOLD_MS) {
            startDeviceNameSavedFlash();
            show(UIScreen::MENU);
          } else if (fb - s_lastRenameFbSpinMs >= 24) {
            s_lastRenameFbSpinMs = fb;
            draw();
          }
        }
      }
    }

    // Main menu: device name flash after rename completes.
    if (g_deviceNameFlashActive) {
      if (g_screen != UIScreen::MENU) {
        g_deviceNameFlashActive = false;
        g_deviceNameFlashOn = true;
        g_deviceNameFlashTogglesLeft = 0;
      } else if (now - g_deviceNameFlashLastMs >= DEVICE_NAME_FLASH_BLINK_MS) {
        g_deviceNameFlashLastMs = now;
        g_deviceNameFlashOn = !g_deviceNameFlashOn;
        if (g_deviceNameFlashTogglesLeft > 0)
          g_deviceNameFlashTogglesLeft--;
        if (g_deviceNameFlashTogglesLeft == 0) {
          g_deviceNameFlashActive = false;
          g_deviceNameFlashOn = true;
        }
        draw();
      }
    }

    // List count badge flash animation (fast 4x) after adding a new item.
    if (g_listCountFlashActive) {
      if (g_screen != g_listCountFlashScreen) {
        g_listCountFlashActive = false;  // user left the target screen
        g_listCountFlashOn = true;
        g_listCountFlashTogglesLeft = 0;
      } else if (now - g_listCountFlashLastMs >= LIST_COUNT_FLASH_BLINK_MS) {
        g_listCountFlashLastMs = now;
        g_listCountFlashOn = !g_listCountFlashOn;
        if (g_listCountFlashTogglesLeft > 0)
          g_listCountFlashTogglesLeft--;
        if (g_listCountFlashTogglesLeft == 0) {
          g_listCountFlashActive = false;
          g_listCountFlashOn = true;  // end in visible state
        }
        draw();
      }
    }

    if (g_screen == UIScreen::TFA_LIST && g_listFlashActive) {
      if (g_listFlashTogglesLeft > 0) {
        if (now - g_listFlashStartMs >= LIST_FLASH_BLINK_MS) {
          g_listFlashStartMs = now;
          g_listFlashVisible = !g_listFlashVisible;
          g_listFlashTogglesLeft--;
          if (g_listFlashTogglesLeft == 0) {
            g_listFlashActive = false;
            g_listFlashVisible = true;
          }
          draw();
        }
      } else if (now - g_listFlashStartMs > 500) {
        g_listFlashActive = false;
        g_listFlashVisible = true;
        draw();
      }
    }
  }  // idle animation timers (skipped on HOME / CREATE_PICK / LOCKED)

  // During slide release debounce, keep logical finger-down so thumb drag resumes if touch glitches back on.
  if ((g_screen == UIScreen::CRYPTO_PSBT_FEE || g_screen == UIScreen::CRYPTO_KASPA_FEE) && g_editMode == EditMode::NONE && g_psbtSignConfirmActive && g_psbtSlideDragging
      && g_psbtSlideDragReleaseStartMs != 0
      && (uint32_t)(now - g_psbtSlideDragReleaseStartMs) < PSBT_SLIDE_DRAG_RELEASE_DEBOUNCE_MS) {
    wasPressed = true;
  } else {
    wasPressed = pressed;
  }
  // Welcome / unlock / password chrome: slower idle loop cuts I2C vs QSPI contention (display “flicker” with no redraw).
  // When finger is down (`pressed`), stay on a short delay so keyboard / taps stay snappy.
  if ((g_screen == UIScreen::HOME || g_screen == UIScreen::CREATE_PICK)
      && g_editMode == EditMode::NONE && !g_busy) {
    delay(pressed ? 4 : 28);
  } else if ((g_screen == UIScreen::LOCKED || g_screen == UIScreen::UNLOCK_PASSWORD)
             && g_editMode == EditMode::NONE && !g_busy) {
    delay(pressed ? 2 : 20);
  } else if (((g_screen == UIScreen::CRYPTO_SCAN_PSBT || g_screen == UIScreen::CRYPTO_SCAN_KASPA_PSKT
               || g_screen == UIScreen::CRYPTO_SCAN_TOOLS || g_screen == UIScreen::RESTORE_SCAN_QR)
              && g_qrScanning && g_editMode == EditMode::NONE && !g_busy)) {
    yield();
  } else {
    delay(1);
  }
}