static bool pwEditHasUnsavedChanges() {
  if (g_editMode != EditMode::EDIT_PW_VALUE || g_viewPwIndex >= pwSvc_getCount()) return false;
  if (pwEditIsPasswordFocusField(g_pwEditFocusField))
    pwEditPersistPasswordFromEditor();
  else if (pwEditIsMetaFocusField(g_pwEditFocusField))
    pwEditPersistFocusedFieldFromEditor();
  if (strcmp(g_tmpPwValue, g_pwEditOrigValue) != 0) return true;
  if (strcmp(g_tmpTitle, g_pwEditOrigTitle) != 0) return true;
  if (strcmp(g_tmpUser, g_pwEditOrigUser) != 0) return true;
  if (strcmp(g_tmpWebsite, g_pwEditOrigWebsite) != 0) return true;
  if (strcmp(g_tmpPwNotes, g_pwEditOrigNotes) != 0) return true;
  return false;
}

static bool pwEditSaveInPlace() {
  if (g_editMode != EditMode::EDIT_PW_VALUE || g_viewPwIndex >= pwSvc_getCount()) return false;
  if (pwEditIsPasswordFocusField(g_pwEditFocusField))
    pwEditPersistPasswordFromEditor();
  else if (pwEditIsMetaFocusField(g_pwEditFocusField)) {
    pwEditPersistFocusedFieldFromEditor();
    edit_set(g_tmpPwValue);
    g_editViewOffset = 0;
    g_editViewOffsetPx = 0;
    g_pwEditKeyboardVisible = false;
    g_pwEditFocusField = 0;
  }
  if (!g_tmpPwValue[0]) {
    setMsg("Password empty");
    draw();
    return false;
  }
  if (!session_can_persist_vault_data()) {
    setMsg("No password in session");
    draw();
    return false;
  }
  if (!g_tmpTitle[0] && !g_tmpUser[0]) {
    setMsg("Need name or username");
    draw();
    return false;
  }

  pwSvc_setValue(g_viewPwIndex, g_tmpPwValue);
  char titleMeta[sizeof(PwItem::title)];
  composePasswordTitleMeta(g_tmpTitle, g_tmpUser, g_tmpWebsite, g_tmpPwNotes, titleMeta, sizeof(titleMeta));
  if (g_pwMetaComposeTruncated) {
    setMsg("Name & details too long");
    draw();
    return false;
  }
  pwSvc_setTitle(g_viewPwIndex, titleMeta);
  g_vaultQrDirty = true;
  if (!vault_commit_passwords_notes_persist()) {
    if (g_sdSavePathPickOpen) {
      draw();
      return true;
    }
    draw();
    return false;
  }
  g_pwEditExitPrompt = false;
  setMsg("");
  if (g_viewPwIndex < pwSvc_getCount()) {
    strncpy(g_tmpPwValue, pwSvc_getValueCStr(g_viewPwIndex), sizeof(g_tmpPwValue) - 1);
    g_tmpPwValue[sizeof(g_tmpPwValue) - 1] = 0;
    edit_set(g_tmpPwValue);
  }
  g_editViewOffset = 0;
  g_editViewOffsetPx = 0;
  g_pwEditKeyboardVisible = false;
  g_pwEditFocusField = 0;
  g_pwEditUnlocked = false;
  pwEditCaptureOriginalSnapshot();
  draw();
  return true;
}

static bool pwEditSaveAndExit() {
  if (g_editMode != EditMode::EDIT_PW_VALUE || g_viewPwIndex >= pwSvc_getCount()) return false;
  if (pwEditIsPasswordFocusField(g_pwEditFocusField))
    pwEditPersistPasswordFromEditor();
  else if (pwEditIsMetaFocusField(g_pwEditFocusField)) {
    pwEditPersistFocusedFieldFromEditor();
    edit_set(g_tmpPwValue);
    g_editViewOffset = 0;
    g_editViewOffsetPx = 0;
    g_pwEditKeyboardVisible = false;
    g_pwEditFocusField = 0;
  }
  if (!g_tmpPwValue[0]) {
    setMsg("Password empty");
    draw();
    return false;
  }
  if (!session_can_persist_vault_data()) {
    setMsg("No password in session");
    draw();
    return false;
  }
  if (!vault_require_sd_for_pm_save()) {
    draw();
    return false;
  }
  if (!g_tmpTitle[0] && !g_tmpUser[0]) {
    setMsg("Need name or username");
    draw();
    return false;
  }

  pwSvc_setValue(g_viewPwIndex, g_tmpPwValue);
  char titleMeta[sizeof(PwItem::title)];
  composePasswordTitleMeta(g_tmpTitle, g_tmpUser, g_tmpWebsite, g_tmpPwNotes, titleMeta, sizeof(titleMeta));
  if (g_pwMetaComposeTruncated) {
    setMsg("Name & details too long");
    draw();
    return false;
  }
  pwSvc_setTitle(g_viewPwIndex, titleMeta);
  g_vaultQrDirty = true;
  if (!vault_commit_passwords_notes_persist()) {
    if (g_sdSavePathPickOpen) return false;
    draw();
    return false;
  }
  g_pwEditExitPrompt = false;
  setMsg("");
  memset(g_tmpTitle, 0, sizeof(g_tmpTitle));
  memset(g_tmpUser, 0, sizeof(g_tmpUser));
  memset(g_tmpWebsite, 0, sizeof(g_tmpWebsite));
  memset(g_tmpPwNotes, 0, sizeof(g_tmpPwNotes));
  exitEditor();
  show(UIScreen::PASSWORDS);
  return true;
}

/** After SD path picker commits prefs and vault save succeeds; resume password editor exit / in-place UI. */
static void pw_edit_resume_after_sd_picker_success() {
  if (g_editMode != EditMode::EDIT_PW_VALUE || g_viewPwIndex >= pwSvc_getCount()) {
    draw();
