static bool sd_test_write() {
  Serial.println("sd_test_write: Testing SD card write capability...");

  // Try to create a test file
  const char* test_file = "/sdcard/test_write.txt";
  FILE* f = fopen(test_file, "w");
  if (!f) {
    Serial.print("sd_test_write: Failed to create test file: ");
    Serial.println(strerror(errno));
    return false;
  }

  const char* test_content = "SD card test write - SUCCESS";
  size_t written = fwrite(test_content, 1, strlen(test_content), f);
  fclose(f);

  if (written != strlen(test_content)) {
    Serial.println("sd_test_write: Failed to write test content");
    return false;
  }

  // Try to read it back
  f = fopen(test_file, "r");
  if (!f) {
    Serial.println("sd_test_write: Failed to open test file for reading");
    return false;
  }

  char buffer[100];
  size_t read = fread(buffer, 1, sizeof(buffer) - 1, f);
  fclose(f);
  buffer[read] = 0;

  if (strcmp(buffer, test_content) != 0) {
    Serial.println("sd_test_write: Read content doesn't match written content");
    return false;
  }

  // Clean up
  remove(test_file);

  Serial.println("sd_test_write: SD card write test PASSED");
  return true;
}

static bool sd_ensure_dir(const char* path) {
  if (!sd_ready()) return false;
  struct stat st;
  if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) return true;
  return mkdir(path, 0775) == 0;
}

// Same pattern as multisig export / import: mkdir(0777) then verify with stat (handles EEXIST on FAT).
static bool seedmask_ensure_dir_multisig_style(const char* path) {
  if (!sd_ready() || !path || !path[0]) return false;
  if (mkdir(path, 0777) != 0) {
    struct stat st;
    if (stat(path, &st) != 0 || !S_ISDIR(st.st_mode)) return false;
  }
  return true;
}

