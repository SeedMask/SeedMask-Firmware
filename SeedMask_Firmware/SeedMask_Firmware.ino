static void handleSeedSettingsTap(uint16_t x, uint16_t y) {
  if (burgerMenuHideSeedAndSecurity()) return;  // empty-vault duress only
  if (hit(BTN_TOP_BURGER, x, y)) {
    show(UIScreen::BURGER_MENU);
    return;
  }
  if (hit(RECT_TOP_TITLE, x, y)) {
    show(UIScreen::BURGER_MENU);
    return;
  }

  if (hit(BTN_SEED_SETTINGS_VIEWSEED, x, y)) {
    show(UIScreen::VIEW_SEED);
    return;
  }
  if (seedSettingsHideBackupViews()) return;
  if (!session_has_backup_code()) {
    if (hit(seedSettingsBtnRect(0), x, y)) {
      seed_settings_start_create_backup_code();
      return;
    }
    return;
  }
  if (hit(seedSettingsBtnRect(0), x, y)) {
    if (!g_viewBackupCode[0] || g_tempSeedActive) {
      setMsg("No backup code yet");
      draw();
      return;
    }
    show(UIScreen::VIEW_CODE);
    return;
  }
  if (hit(seedSettingsBtnRect(1), x, y)) {
    if (!session_has_backup_code()) {
      setMsg("No backup code yet");
      draw();
      return;
    }
    rebuildVaultQrPayload();
    if (!g_vaultQrPayload[0]) {
      setMsg("Could not build QR");
      draw();
      return;
    }
    g_viewQrBackupReturnScreen = UIScreen::SEED_SETTINGS;
    show(UIScreen::VIEW_QR_BACKUP);
    return;
  }
}

