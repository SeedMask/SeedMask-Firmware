static void drawAddressQr() {
  if (g_addrQrFullscreen && g_addrDetail[0]) {
    drawAddressQrFullscreen();
    return;
  }
  if (g_addrQrFullscreen && !g_addrDetail[0])
    g_addrQrFullscreen = false;

  gfx->fillScreen(RGB565_BLACK);
  drawTopBar(g_addrChain == 0 ? "Receive" : "Change", true);
  gfx->setTextSize(2);
  const bool qrUsed = addr_status_is_used(g_addrQrIndex);
  gfx->setTextColor(qrUsed ? RGB565_RED : RGB565_CYAN);
  gfx->setCursor(14, 56);
  const char* statusLab = qrUsed ? "Used" : "Unused";
  gfx->print(statusLab);
  g_addrQrUsedToggleHit = { 14, 52, (int16_t)((int)strlen(statusLab) * 12 + 8), 24 };
  gfx->setTextSize(1);
  if (!g_addrDetail[0]) {
    g_addrQrQrHit = { 0, 0, 0, 0 };
    g_addrQrSearchHit = { 248, 44, 54, 44 };
    drawAddressQrExplorerGlyph(g_addrQrSearchHit);
    gfx->setTextColor(RGB565_RED);
    gfx->setCursor(10, 120);
    gfx->print("No address");
    {
      const int16_t topBarBottom = 46;
      const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
      const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
      const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
      drawWipeInfoBitmapAt(infoCx, infoCy, true);
    }
    ui_flush();
    return;
  }
  const QrCode& qr = QrCode::encodeText(g_addrDetail, QrCode::Ecc::ECC_LOW);
  const int qBorder = 2;
  const int topBarH = 46;
  const int botPad = 8;
  const int addrLineChars = 21;
  const int addrLineSkip = 16;
  size_t alen = strlen(g_addrDetail);
  int nlines = (int)((alen + (size_t)addrLineChars - 1) / (size_t)addrLineChars);
  if (nlines < 1) nlines = 1;
  const int textH = nlines * addrLineSkip + 14;
  // Space below QR for wrapped address + margins (was fixed 130px and capped QR too small).
  const int addrQrBottomReserve = textH + 12 + botPad + 20;
  const int addrQrScaleCap = 10;
  int qy = 70;
  for (int iter = 0; iter < 4; iter++) {
    int qW = qrCodeDrawnSize(qr, qy, qBorder, addrQrBottomReserve, addrQrScaleCap);
    int blockH = qW + textH;
    int qy2 = topBarH + (LCD_H - topBarH - botPad - blockH) / 2;
    if (qy2 < 50) qy2 = 50;
    if (qy2 == qy) break;
    qy = qy2;
  }
  const int sw = ADDR_ICON_ENVELOPE_W + 10;
  const int sh = ADDR_ICON_ENVELOPE_H + 10;
  const int gapAboveQr = 28;
  const int minSy = 46;
  if (qy < minSy + gapAboveQr + sh) qy = minSy + gapAboveQr + sh;
  const int addrQrMetaEnvDrop = 20;
  int qW = qrCodeDrawnSize(qr, qy, qBorder, addrQrBottomReserve, addrQrScaleCap);
  int qx = (LCD_W - qW) / 2;
  int sy = qy - gapAboveQr - sh + addrQrMetaEnvDrop;
  if (sy < minSy) sy = minSy;
  if (qy < sy + sh + gapAboveQr) qy = sy + sh + gapAboveQr;
  qW = qrCodeDrawnSize(qr, qy, qBorder, addrQrBottomReserve, addrQrScaleCap);
  qx = (LCD_W - qW) / 2;
  sy = qy - gapAboveQr - sh + addrQrMetaEnvDrop;
  if (sy < minSy) sy = minSy;
  int sx = qx + qW - sw;
  if (sx < 8) sx = 8;
  if (sx + sw > LCD_W) sx = LCD_W - sw;
  g_addrQrQrHit = { (int16_t)qx, (int16_t)qy, (int16_t)qW, (int16_t)qW };
  g_addrQrSearchHit = { (int16_t)sx, (int16_t)sy, (int16_t)sw, (int16_t)sh };
  drawAddressQrMetaBesideEnvelope((int16_t)sx, (int16_t)sy, (int16_t)sh);
  drawAddressQrExplorerGlyph(g_addrQrSearchHit);
  drawQRCodeAt(qr, qy, qBorder, addrQrBottomReserve, addrQrScaleCap);
  int qBottom = qy + qW;
  gfx->setTextColor(RGB565_WHITE);
  drawWrappedTextCentered(g_addrDetail, qBottom + 12, addrLineChars, addrLineSkip, LCD_H - 4, 2);
  {
    const int16_t topBarBottom = 46;
    const int16_t infoHalf = WIPE_INFO_ICON_LARGE_RGB565_W / 2;
    const int16_t infoCx = (int16_t)(LCD_W - 8 - infoHalf);
    const int16_t infoCy = (int16_t)(topBarBottom + 6 + infoHalf);
    drawWipeInfoBitmapAt(infoCx, infoCy, true);
  }
  if (g_addrQrConfirmMarkUnused) {
    const int16_t popupW = 260;
    const int16_t popupH = 138;
    const int16_t popupX = (LCD_W - popupW) / 2;
    const int16_t popupY = 132;
    gfx->fillRoundRect(popupX, popupY, popupW, popupH, 12, UI_CARD);
    gfx->drawRoundRect(popupX, popupY, popupW, popupH, 12, UI_ACCENT);
    gfx->setTextColor(RGB565_WHITE);
    gfx->setTextSize(2);
    gfx->setCursor(popupX + 12, popupY + 24);
    gfx->print("Mark this address");
    gfx->setCursor(popupX + 12, popupY + 44);
    gfx->print("as Unused?");
    const Rect rYes = { (int16_t)(popupX + 16), (int16_t)(popupY + 86), 112, 40 };
    const Rect rNo = { (int16_t)(popupX + 132), (int16_t)(popupY + 86), 112, 40 };
    drawBtn(rYes, "YES", RGB565_RED, 2);
    drawBtn(rNo, "NO", RGB565_DARKGREY, 2);
  }
  ui_flush();
}

static bool xpub_export_hit_qr(uint16_t px, uint16_t py) {
  if (!crypto_xpub_qr_source()[0]) return false;
  const QrCode& qr = QrCode::encodeText(crypto_xpub_qr_source(), QrCode::Ecc::ECC_LOW);
  const int qBorder = 2;
  const int qy = crypto_home_asset_is_kaspa() ? (int)KASPA_KPUB_EXPORT_QR_Y : (int)XPUB_EXPORT_QR_Y;
  int qW = qrCodeDrawnSize(qr, qy, qBorder, (int)XPUB_EXPORT_QR_BOTTOM_RESERVE, XPUB_EXPORT_QR_SCALE_CAP);
  int qx = (LCD_W - qW) / 2;
  int x = (int)px, y = (int)py;
  return x >= qx && x < qx + qW && y >= qy && y < qy + qW;
}

