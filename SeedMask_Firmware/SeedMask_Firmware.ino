    if (tx < BTN_XPUB_TYPE_TAPROOT.x + 2) tx = BTN_XPUB_TYPE_TAPROOT.x + 2;
    if (tx > BTN_XPUB_TYPE_TAPROOT.x + BTN_XPUB_TYPE_TAPROOT.w - 2) tx = BTN_XPUB_TYPE_TAPROOT.x + 2;
    gfx->setCursor(tx, BTN_XPUB_TYPE_TAPROOT.y + 10);
    gfx->print("Taproot");
  }

  {
    const char* st = xpub_export_script_type_label(g_cryptoExportType, g_cryptoXpubBackToMultisigStub);
