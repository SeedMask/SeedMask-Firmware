// Draw one mini QR finder pattern (9x9: outer ring, inner light, center dot). Origin at (fx,fy).
static void drawMiniQRFinder(int fx, int fy, uint16_t fillColor, uint16_t bgColor) {
  gfx->fillRect(fx, fy, 9, 9, fillColor);          // outer 9x9
  gfx->fillRect(fx + 1, fy + 1, 7, 7, bgColor);    // inner 7x7 light
  gfx->fillRect(fx + 3, fy + 3, 3, 3, fillColor);  // center 3x3 dot
}

static void drawBurgerMenuSeedQRIcon(int x, int y, int w, int h) {
  // QR icon only (no rect): three finders + small 4th square, larger so it reads clearly
  const int finderSize = 9;
  const int smallSize = 5;  // 4th block: small square (data corner)
  const int gap = 2;
  const int total = finderSize + gap + finderSize;
  int qx = x + (w - total) / 2;
  int qy = y + (h - total) / 2;

  drawMiniQRFinder(qx, qy, UI_ACCENT, RGB565_BLACK);
  drawMiniQRFinder(qx + finderSize + gap, qy, UI_ACCENT, RGB565_BLACK);
  drawMiniQRFinder(qx, qy + finderSize + gap, UI_ACCENT, RGB565_BLACK);
  gfx->fillRect(qx + finderSize + gap, qy + finderSize + gap, smallSize, smallSize, UI_ACCENT);
}

/** VIEW BACKUP CODE: same finder motif as View Seed / burger QR, scaled up for this screen. */
static void drawViewCodeQRIcon(int x, int y, int w, int h) {
  const int finderSize = 14;
  const int gap = 5;
  const int smallSize = 9;
  const int total = finderSize + gap + finderSize;
  const int qx = x + (w - total) / 2;
  const int qy = y + (h - total) / 2;
  auto finder = [&](int fx, int fy) {
    gfx->fillRect(fx, fy, finderSize, finderSize, UI_ACCENT);
    gfx->fillRect(fx + 1, fy + 1, finderSize - 2, finderSize - 2, RGB565_BLACK);
    const int cd = finderSize / 3;
    const int off = (finderSize - cd) / 2;
    gfx->fillRect(fx + off, fy + off, cd, cd, UI_ACCENT);
  };
  finder(qx, qy);
  finder(qx + finderSize + gap, qy);
  finder(qx, qy + finderSize + gap);
  gfx->fillRect(qx + finderSize + gap, qy + finderSize + gap, smallSize, smallSize, UI_ACCENT);
}

