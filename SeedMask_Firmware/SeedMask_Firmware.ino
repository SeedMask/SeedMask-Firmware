// Review UI: same cosigner key as classic mainnet xpub (0x0488…) and as Zpub (BIP48 P2WSH multisig SLIP-132).
static bool multisig_review_xpub_zpub_display_strings(const char* imported58, char xpubStr[160], char zpubStr[160]) {
  if (!imported58 || !imported58[0] || !xpubStr || !zpubStr) return false;
  xpubStr[0] = 0;
  zpubStr[0] = 0;
  uint8_t raw[78];
  if (!base58check_decode_payload(imported58, raw, 78)) return false;
  static const uint8_t kVerXpub[4] = { 0x04, 0x88, 0xb2, 0x1e };
  static const uint8_t kVerZpub[4] = { 0x02, 0xaa, 0x7e, 0xd3 };
  uint8_t tmp[78];
  memcpy(tmp, raw, 78);
  memcpy(tmp, kVerXpub, 4);
  if (!base58check_encode(tmp, sizeof(tmp), xpubStr, 160)) {
    secure_memzero(raw, sizeof(raw));
    secure_memzero(tmp, sizeof(tmp));
    return false;
  }
  memcpy(tmp, raw, 78);
  memcpy(tmp, kVerZpub, 4);
  if (!base58check_encode(tmp, sizeof(tmp), zpubStr, 160)) {
    secure_memzero(raw, sizeof(raw));
    secure_memzero(tmp, sizeof(tmp));
    return false;
  }
  secure_memzero(raw, sizeof(raw));
  secure_memzero(tmp, sizeof(tmp));
  return true;
}

// How many distinct non-empty derivation strings appear among cosigners (for review summary).
static uint8_t multisig_review_distinct_derivation_path_count() {
  uint8_t nCos = g_multisigReviewCosigners;
  if (nCos == 0) return 0;
  const char* seen[MULTISIG_MAX_COSIGNERS];
  uint8_t nSeen = 0;
  for (uint8_t i = 0; i < nCos; i++) {
    const char* p = g_multisigReviewDerivs[i];
    if (!p || !p[0]) continue;
    bool dup = false;
    for (uint8_t j = 0; j < nSeen; j++) {
      if (strcmp(seen[j], p) == 0) {
        dup = true;
        break;
      }
    }
    if (!dup && nSeen < MULTISIG_MAX_COSIGNERS) seen[nSeen++] = p;
  }
  return nSeen;
}

static void drawCryptoMultisigImportReview() {
  // Full text at text size 2: wrap by character count (no ellipsis). ~12px/char -> 25 chars on 300px usable width.
  const int wrapChars = 25;
  const int lineH = 20;
  auto printWrapped = [&](int x, int* yp, const char* txt) {
    if (!txt) txt = "";
    size_t n = strlen(txt);
    size_t pos = 0;
    while (pos < n) {
      size_t take = n - pos;
      if (take > (size_t)wrapChars) take = (size_t)wrapChars;
      char buf[40];
      if (take >= sizeof(buf)) take = sizeof(buf) - 1;
      memcpy(buf, txt + pos, take);
      buf[take] = 0;
      gfx->setCursor(x, *yp);
      gfx->print(buf);
      *yp += lineH;
      pos += take;
    }
  };
  gfx->fillScreen(RGB565_BLACK);
  drawTopBar("Review multisig", true);
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(2);
  int y = 56 + g_multisigReviewScrollY;
  char line[280];
  const bool isKaspaPolicy = multisig_review_is_kaspa_policy();
  snprintf(line, sizeof(line), "Wallet: %s", g_multisigReviewName[0] ? g_multisigReviewName : "Unknown");
  printWrapped(10, &y, line);
  y += 4;
  snprintf(line, sizeof(line), "Policy: %s", g_multisigReviewPolicy[0] ? g_multisigReviewPolicy : "Unknown");
  printWrapped(10, &y, line);
  y += 4;
  snprintf(line, sizeof(line), "Address: %s", g_multisigReviewAddrType[0] ? g_multisigReviewAddrType : "Unknown");
  printWrapped(10, &y, line);
  y += 4;
  {
    uint8_t nVar = multisig_review_distinct_derivation_path_count();
    if (nVar > 1) {
      snprintf(line, sizeof(line), "Derivation: Varies (%u)", (unsigned)nVar);
    } else if (nVar == 1) {
      const char* one = nullptr;
      for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
        if (g_multisigReviewDerivs[i][0]) {
          one = g_multisigReviewDerivs[i];
          break;
        }
      }
      snprintf(line, sizeof(line), "Derivation: %s",
               one ? one : (g_multisigReviewDeriv[0] ? g_multisigReviewDeriv : "Unknown"));
    } else {
      snprintf(line, sizeof(line), "Derivation: %s", g_multisigReviewDeriv[0] ? g_multisigReviewDeriv : "Unknown");
    }
  }
  printWrapped(10, &y, line);
  y += 18;
  gfx->setTextColor(RGB565_CYAN);
  snprintf(line, sizeof(line), "Cosigners: %u", (unsigned)g_multisigReviewCosigners);
  printWrapped(10, &y, line);
  y += 8;
  gfx->setTextColor(RGB565_WHITE);
  if (g_multisigReviewCosigners > 0) {
    for (uint8_t i = 0; i < g_multisigReviewCosigners; i++) {
      snprintf(line, sizeof(line), "%u/%u", (unsigned)(i + 1), (unsigned)g_multisigReviewCosigners);
      printWrapped(10, &y, line);
      printWrapped(10, &y, "Fingerprint:");
      gfx->setTextColor(RGB565_CYAN);
      printWrapped(10, &y, g_multisigReviewFp[i][0] ? g_multisigReviewFp[i] : "?");
      gfx->setTextColor(RGB565_WHITE);
      printWrapped(10, &y, "Derivation:");
      gfx->setTextColor(RGB565_CYAN);
      printWrapped(10, &y, g_multisigReviewDerivs[i][0] ? g_multisigReviewDerivs[i] : "Unknown");
      gfx->setTextColor(RGB565_WHITE);
      y += 10;
      {
        char xs[160], zs[160];
        bool fmt = !isKaspaPolicy && g_multisigReviewXpub[i][0] && multisig_review_xpub_zpub_display_strings(g_multisigReviewXpub[i], xs, zs);
        printWrapped(10, &y, isKaspaPolicy ? "kPub:" : "xPub:");
        gfx->setTextColor(RGB565_CYAN);
        printWrapped(10, &y, fmt ? xs : (g_multisigReviewXpub[i][0] ? g_multisigReviewXpub[i] : "?"));
        gfx->setTextColor(RGB565_WHITE);
        if (!isKaspaPolicy) {
          printWrapped(10, &y, "zPub:");
          gfx->setTextColor(RGB565_CYAN);
          printWrapped(10, &y, fmt ? zs : "-");
          gfx->setTextColor(RGB565_WHITE);
        }
      }
      y += 14;
    }
  } else {
    printWrapped(10, &y, "No cosigners parsed");
    y += 8;
  }
  int contentBottom = y;
  const int extraBottomScroll = 176;  // let the last block be scrollable toward mid-screen
  const int minScroll = (408 - contentBottom) - extraBottomScroll;
  if (g_multisigReviewScrollY < minScroll) g_multisigReviewScrollY = minScroll;
  if (g_multisigReviewScrollY > 0) g_multisigReviewScrollY = 0;
  drawBtn(BTN_MULTISIG_REVIEW_CANCEL, "CANCEL", RGB565_DARKGREY, 2);
  drawBtn(BTN_MULTISIG_REVIEW_CONFIRM, "CONFIRM", UI_ACCENT, 2);
  draw_multisig_duplicate_notice_overlay();
  ui_flush();
}

