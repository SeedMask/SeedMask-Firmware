// Review screens: insert spaces every `group` chars (optional " (+n)" suffix preserved).
// Kaspa matches Coordinator: keep "kaspa:" intact, chunk only the body → "kaspa:qqh5 9z4t …".
static void psbt_review_format_dest_chunked(const char* src, char* out, size_t outCap, unsigned group) {
  if (!src || !out || outCap < 8) return;
  out[0] = 0;
  if (group < 1) group = 4;
  const char* suffix = strstr(src, " (+");
  size_t mainLen = suffix ? (size_t)(suffix - src) : strlen(src);
  size_t wi = 0;
  size_t bodyStart = 0;
  if (mainLen >= 6) {
    static const char kPref[] = "kaspa:";
    bool isKaspa = true;
    for (size_t i = 0; i < 6; i++) {
      char c = src[i];
      if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
      if (c != kPref[i]) {
        isKaspa = false;
        break;
      }
    }
    if (isKaspa) {
      for (size_t i = 0; i < 6 && wi + 1 < outCap; i++) out[wi++] = src[i];
      bodyStart = 6;
    }
  }
  unsigned cc = 0;
  for (size_t i = bodyStart; i < mainLen && wi + 3 < outCap; i++) {
    char c = src[i];
    if (c == ' ') continue;
    if (cc > 0 && (cc % group) == 0 && wi + 1 < outCap) out[wi++] = ' ';
    out[wi++] = c;
    cc++;
  }
  out[wi] = 0;
  if (suffix && wi < outCap - 1) {
    strncat(out, suffix, outCap - wi - 1);
  }
}

// Chunked address: spaces + odd-index tokens white; even-index tokens orange + bold (bc1q … 538e … m7fp …).
// Mutates chunkedMut (strtok). Returns Y below the destination block.
static int16_t psbt_review_draw_dest_orange_bold(char* chunkedMut, Arduino_Canvas* g, int16_t x0, int16_t y0,
                                                 int16_t lineH, uint16_t maxLinePx) {
  if (!chunkedMut || !g || !chunkedMut[0]) return (int16_t)(y0 + lineH);
  g->setTextSize(2);
  auto textW = [&](const char* s) -> uint16_t {
    int16_t x1 = 0, y1 = 0;
    uint16_t w = 0, h = 0;
    g->getTextBounds(s, 0, 0, &x1, &y1, &w, &h);
    return w;
  };

  char* saveptr = nullptr;
  char* tok = strtok_r(chunkedMut, " ", &saveptr);
  unsigned idx = 0;
  int16_t cx = x0;
  int16_t cy = y0;

  while (tok) {
    const bool orangeChunk = ((idx % 2u) == 0u);
    uint16_t spw = (cx > x0) ? textW(" ") : 0;
    uint16_t wTok = textW(tok);

    if (cx > x0 && (uint32_t)(cx - x0) + spw + wTok > maxLinePx) {
      cx = x0;
      cy = (int16_t)(cy + lineH);
      continue;
    }

    if (cx > x0) {
      g->setTextColor(RGB565_WHITE);
      g->setTextSize(2);
      g->setCursor(cx, cy);
      g->print(" ");
      cx = (int16_t)(cx + (int16_t)spw);
    }

    g->setTextSize(2);
    if (orangeChunk) {
      g->setTextColor(RGB565_BITCOIN_ORANGE);
      g->setCursor(cx, cy);
      g->print(tok);
      g->setCursor((int16_t)(cx + 1), cy);
      g->print(tok);
    } else {
      g->setTextColor(RGB565_WHITE);
      g->setCursor(cx, cy);
      g->print(tok);
    }
    cx = (int16_t)(cx + (int16_t)wTok);

    idx++;
    tok = strtok_r(nullptr, " ", &saveptr);
  }

  return (int16_t)(cy + lineH);
}

// White-screen fullscreen QR: 4-char groups, split evenly across 3 rows; every token 2-pass bold, odd chunks +1 pass.
static int16_t draw_address_qr_fullscreen_chunked_bold(char* chunkedMut, Arduino_Canvas* g, int16_t x0, int16_t y0,
                                                       uint16_t maxLinePx) {
  if (!chunkedMut || !g || !chunkedMut[0]) return y0;

  char work[160];
  strncpy(work, chunkedMut, sizeof(work) - 1);
  work[sizeof(work) - 1] = 0;

  char* tokPtrs[48];
  int nTok = 0;
  char* sp = nullptr;
  for (char* t = strtok_r(work, " ", &sp); t && nTok < 48; t = strtok_r(nullptr, " ", &sp))
    tokPtrs[nTok++] = t;
  if (nTok <= 0) return y0;

  const unsigned rem = (unsigned)nTok % 3u;
  const unsigned base = (unsigned)nTok / 3u;
  const unsigned c0 = base + (rem > 0 ? 1u : 0u);
  const unsigned c1 = base + (rem > 1u ? 1u : 0u);
  const unsigned c2 = (unsigned)nTok - c0 - c1;
  const unsigned rowCount[3] = { c0, c1, c2 };
  const unsigned rowStart[3] = { 0u, c0, c0 + c1 };

  auto measureRowWidth = [&](uint8_t ts, unsigned r) -> uint32_t {
    g->setTextSize(ts);
    const uint8_t letterGap = (ts >= 2) ? 3u : 2u;
    auto textW = [&](const char* s) -> uint16_t {
      int16_t x1 = 0, y1 = 0;
      uint16_t w = 0, h = 0;
      g->getTextBounds(s, 0, 0, &x1, &y1, &w, &h);
      return w;
    };
    auto tokenDrawWidth = [&](const char* tok, bool oddExtra) -> uint32_t {
      uint32_t w = 0;
      for (size_t i = 0; tok[i]; i++) {
        if (i > 0) w += letterGap;
        char one[2] = { tok[i], 0 };
        w += (uint32_t)textW(one) + (oddExtra ? 2u : 1u);
      }
      return w;
    };
    uint32_t wrow = 0;
    const unsigned st = rowStart[r];
    const unsigned cnt = rowCount[r];
    for (unsigned k = 0; k < cnt; k++) {
      const unsigned gidx = st + k;
      const char* tok = tokPtrs[gidx];
      const bool oddExtra = ((gidx % 2u) == 0u);
      if (k > 0) wrow += textW(" ");
      wrow += tokenDrawWidth(tok, oddExtra);
    }
    return wrow;
  };

  uint8_t textSz = 2;
  if (measureRowWidth(2, 0) > maxLinePx || measureRowWidth(2, 1) > maxLinePx || measureRowWidth(2, 2) > maxLinePx) {
    textSz = 1;
  }

  const int16_t rowPitch = (textSz >= 2) ? 28 : 22;
  const uint8_t letterGap = (textSz >= 2) ? 3u : 2u;

  g->setTextSize(textSz);
  auto textW = [&](const char* s) -> uint16_t {
    int16_t x1 = 0, y1 = 0;
    uint16_t w = 0, h = 0;
    g->getTextBounds(s, 0, 0, &x1, &y1, &w, &h);
    return w;
  };

  int16_t cy = y0;
  for (int r = 0; r < 3; r++) {
    if (rowCount[r] == 0) continue;
    int16_t cx = x0;
    const unsigned st = rowStart[r];
    const unsigned cnt = rowCount[r];
    for (unsigned k = 0; k < cnt; k++) {
      const unsigned gidx = st + k;
      const char* tok = tokPtrs[gidx];
      const bool oddExtraBold = ((gidx % 2u) == 0u);
      if (k > 0) {
        g->setTextColor(RGB565_BLACK);
        g->setTextSize(textSz);
        g->setCursor(cx, cy);
        g->print(" ");
        cx = (int16_t)(cx + (int16_t)textW(" "));
      }
      g->setTextColor(RGB565_BLACK);
      g->setTextSize(textSz);
      int16_t tx = cx;
      for (size_t i = 0; tok[i]; i++) {
        if (i > 0) tx = (int16_t)(tx + letterGap);
        char one[2] = { tok[i], 0 };
        g->setCursor(tx, cy);
        g->print(one);
        g->setCursor((int16_t)(tx + 1), cy);
        g->print(one);
        if (oddExtraBold) {
          g->setCursor((int16_t)(tx + 2), cy);
          g->print(one);
        }
        const uint16_t cw = textW(one);
        tx = (int16_t)(tx + (int16_t)(cw + (oddExtraBold ? 2 : 1)));
      }
      cx = tx;
    }
    cy = (int16_t)(cy + rowPitch);
  }

  return cy;
}

static int16_t psbt_slide_max_offset(void) {
  int32_t inner = (int32_t)PSBT_SLIDE_TRACK_W - 2 * (int32_t)PSBT_SLIDE_PAD - (int32_t)PSBT_SLIDE_THUMB_W;
  return inner > 0 ? (int16_t)inner : (int16_t)0;
}

/// Quantize thumb position from touch X. Pass stickyRef == current thumb offset during drag so a noisy sample
/// cannot snap one bin left while the finger is still sweeping right (optional; default -1 = off).
static int16_t psbt_slide_stable_offset_from_x(uint16_t sx, int16_t maxO, int16_t stickyRef = -1) {
  int16_t innerLeft = (int16_t)(PSBT_SLIDE_TRACK_X + PSBT_SLIDE_PAD);
  int32_t raw = (int32_t)(int16_t)sx - innerLeft - PSBT_SLIDE_THUMB_W / 2;
  if (raw < 0) raw = 0;
  if (raw > maxO) raw = maxO;
  const int32_t step = 4;
  int32_t q = ((raw + step / 2) / step) * step;
  if (q > maxO) q = maxO;
  if (stickyRef >= 0 && q < stickyRef && raw >= stickyRef - (step / 2)) q = stickyRef;
  return (int16_t)q;
}

/// Follow finger: fast steps when far, fine steps when aligned; suppress small backward noise while sweeping.
static int16_t psbt_slide_slew_toward(int16_t target, int16_t cur, int16_t maxO) {
  int32_t d = (int32_t)target - (int32_t)cur;
  const int32_t ignoreLeftNudge = 18;
  if (d < 0 && d > -ignoreLeftNudge) return (int16_t)cur;
  const int32_t noiseBand = 24;
  const int32_t limFastFwd = 62;
  const int32_t limFine = 10;
  const int32_t limFastBack = 32;
  int32_t lim = (d > noiseBand || d < -noiseBand) ? (d < 0 ? limFastBack : limFastFwd) : limFine;
  if (d > lim) d = lim;
  if (d < -lim) d = -lim;
  int32_t n = (int32_t)cur + d;
  if (n < 0) n = 0;
  if (n > maxO) n = maxO;
  return (int16_t)n;
}

static void psbt_slide_reset(void) {
  g_psbtSlideThumbOffset = 0;
  g_psbtSlideDragging = false;
  g_psbtSlideAwaitSwipe = false;
  g_psbtSlidePaintedOffset = -30000;
  g_psbtSlideDragPaintMs = 0;
  g_psbtSlideDragReleaseStartMs = 0;
  g_psbtSlideFilteredX = -1.f;
}

/** True if thumb is far enough right to count as completed (release or reach-end). */
static bool psbt_slide_past_commit_threshold(void) {
  int16_t maxO = psbt_slide_max_offset();
  if (maxO <= 0) return false;
  // ~50% of travel — digitizer + slew often leave the thumb short of the rail end on lift.
  int16_t thresh = (int16_t)(((int32_t)maxO * (int32_t)50) / (int32_t)100);
  return g_psbtSlideThumbOffset >= thresh;
}

/** Finger is over the right portion of the slide track (commit zone). */
static bool psbt_slide_finger_in_commit_zone(uint16_t sx) {
  const int16_t commitX =
    (int16_t)(PSBT_SLIDE_TRACK_X + ((int32_t)PSBT_SLIDE_TRACK_W * 62) / 100);
  return (int16_t)sx >= commitX;
}

/** Snap thumb to end and run Kaspa/Bitcoin sign. On failure, reset the slide (do not glue it). */
static bool psbt_slide_commit_sign(void) {
  if (!g_psbtSignConfirmActive) return false;
  if (g_screen != UIScreen::CRYPTO_KASPA_FEE && g_screen != UIScreen::CRYPTO_PSBT_FEE) return false;
  g_psbtSlideSuppressSwipeBackUntil = millis() + PSBT_SLIDE_POST_COMMIT_SWIPE_BLOCK_MS;
  g_psbtSlideCommitBlocksSwipeBack = true;
  g_cryptoAutoSignPending = false;
  g_psbtSlideDragging = false;
  g_psbtSlideAwaitSwipe = false;
  g_psbtSlideDragReleaseStartMs = 0;
  {
    int16_t maxO = psbt_slide_max_offset();
    if (maxO > 0) g_psbtSlideThumbOffset = maxO;
  }
  // Immediate Signing chrome + background crypto so the spinner keeps moving.
  if (g_screen == UIScreen::CRYPTO_KASPA_FEE) {
    (void)crypto_sign_start_background(true);
  } else {
    (void)crypto_sign_start_background(false);
  }
  return true;
}

/// Expanded hit area (thumb + padded track). Slide used to fail when touch-down lived only behind
/// `g_touchReleasedSinceTap` — that gate is intentionally bypassed for slide/cancel elsewhere.
/// Touch target for the draggable thumb (cyan pill), including slop — checked before full-track swipe arm.
static bool psbt_slide_thumb_contains(int16_t px, int16_t py) {
  const int16_t thumbX =
    (int16_t)(PSBT_SLIDE_TRACK_X + PSBT_SLIDE_PAD + g_psbtSlideThumbOffset);
  const int16_t thumbY =
    (int16_t)(PSBT_SLIDE_TRACK_Y + (PSBT_SLIDE_TRACK_H - PSBT_SLIDE_THUMB_H) / 2);
  const int16_t slop = 12;
  return px >= thumbX - slop && px < thumbX + PSBT_SLIDE_THUMB_W + slop && py >= thumbY - slop
         && py < thumbY + PSBT_SLIDE_THUMB_H + slop;
}

static bool psbt_slide_hit_grab_zone(int16_t px, int16_t py) {
  const int16_t slop = 14;
  const int16_t thumbX =
    (int16_t)(PSBT_SLIDE_TRACK_X + PSBT_SLIDE_PAD + g_psbtSlideThumbOffset);
  const int16_t thumbY =
    (int16_t)(PSBT_SLIDE_TRACK_Y + (PSBT_SLIDE_TRACK_H - PSBT_SLIDE_THUMB_H) / 2);
  if (px >= (int16_t)(PSBT_SLIDE_TRACK_X - 6) && px < (int16_t)(PSBT_SLIDE_TRACK_X + PSBT_SLIDE_TRACK_W + 6)
      && py >= (int16_t)(PSBT_SLIDE_TRACK_Y - slop) && py < (int16_t)(PSBT_SLIDE_TRACK_Y + PSBT_SLIDE_TRACK_H + slop)) {
    return true;
  }
  if (px >= thumbX - slop && px < thumbX + PSBT_SLIDE_THUMB_W + slop && py >= thumbY - slop
      && py < thumbY + PSBT_SLIDE_THUMB_H + slop) {
    return true;
  }
  return false;
}

/// Same horizontal/vertical padding as thumb slop — used so swipe-back does not fire when the slide
/// gesture started on/near the rail (strict inner rect missed left thumb slop and triggered swipe-back mid-slide).
static bool psbt_slide_touch_down_on_expanded_rail(int16_t downX, int16_t downY) {
  const int16_t slop = 14;
  const int16_t xl = (int16_t)(PSBT_SLIDE_TRACK_X - slop);
  const int16_t xr = (int16_t)(PSBT_SLIDE_TRACK_X + PSBT_SLIDE_TRACK_W + slop);
  const int16_t yt = (int16_t)(PSBT_SLIDE_TRACK_Y - slop);
  const int16_t yb = (int16_t)(PSBT_SLIDE_TRACK_Y + PSBT_SLIDE_TRACK_H + slop);
  return downX >= xl && downX < xr && downY >= yt && downY < yb;
}

/// Slide rail: same rounded-rectangle language as CANCEL (corner R); cyan thumb carries a flat ➡️-style glyph.
static void drawPsbtSlideToUnlockChrome(int16_t thumbX, int16_t thumbY) {
  const int16_t x0 = PSBT_SLIDE_TRACK_X;
  const int16_t y0 = PSBT_SLIDE_TRACK_Y;
  const int16_t tw = PSBT_SLIDE_TRACK_W;
  const int16_t th = PSBT_SLIDE_TRACK_H;
  const int16_t tr = PSBT_SLIDE_CORNER_R;

  const uint16_t trackTop =
    blendRGB565(blendRGB565(UI_BORDER, RGB565_CYAN, 0.07f), blendRGB565(UI_BG, RGB565_WHITE, 0.08f), 0.55f);
  const uint16_t trackBot = blendRGB565(blendRGB565(UI_BG, RGB565_BLACK, 0.72f), RGB565_BLACK, 0.35f);
  fillRoundRectGradientV({ x0, y0, tw, th }, tr, trackTop, trackBot);

  const uint16_t rimHi = blendRGB565(trackTop, RGB565_WHITE, 0.34f);
  const uint16_t rimLo = blendRGB565(trackBot, RGB565_BLACK, 0.42f);
  gfx->drawRoundRect(x0, y0, tw, th, tr, rimHi);
  gfx->drawRoundRect((int16_t)(x0 + 1), (int16_t)(y0 + 1), (int16_t)(tw - 2), (int16_t)(th - 2), (int16_t)(tr - 1), rimLo);

  gfx->setTextSize(1);
  const char* hint = "slide to sign";
  gfx->setTextColor(blendRGB565(RGB565_WHITE, trackBot, 0.36f));
  const int16_t hw = (int16_t)((int)strlen(hint) * 6);
  gfx->setCursor((int16_t)(x0 + (tw - hw) / 2), (int16_t)(y0 + th / 2 - 4));
  gfx->print(hint);

  const int16_t kr = PSBT_SLIDE_CORNER_R;
  const uint16_t thumbTop = blendRGB565(blendRGB565(UI_ACCENT, RGB565_WHITE, 0.42f), RGB565_CYAN, 0.18f);
  const uint16_t thumbBot = blendRGB565(UI_ACCENT, blendRGB565(UI_BG, RGB565_BLACK, 0.55f), 0.38f);
  fillRoundRectGradientV({ thumbX, thumbY, PSBT_SLIDE_THUMB_W, PSBT_SLIDE_THUMB_H }, kr, thumbTop, thumbBot);
  gfx->drawRoundRect(thumbX, thumbY, PSBT_SLIDE_THUMB_W, PSBT_SLIDE_THUMB_H, kr,
                     blendRGB565(UI_ACCENT, RGB565_BLACK, 0.45f));
  gfx->drawRoundRect((int16_t)(thumbX + 1), (int16_t)(thumbY + 1), (int16_t)(PSBT_SLIDE_THUMB_W - 2),
                     (int16_t)(PSBT_SLIDE_THUMB_H - 2), (int16_t)(kr - 1),
                     blendRGB565(RGB565_WHITE, thumbTop, 0.38f));
  // ➡️: flat emoji-like silhouette — horizontal stroke + head (same topology as Unicode U+27A1 / U+27A4)
  {
    const int16_t midY = (int16_t)(thumbY + PSBT_SLIDE_THUMB_H / 2);
    const int16_t shaftW = 22;
    const int16_t shaftH = 3;
    const int16_t headW = 11;
    const int16_t headHalfH = 6;
    const int16_t totalW = (int16_t)(shaftW + headW);
    const int16_t ax = (int16_t)(thumbX + (PSBT_SLIDE_THUMB_W - totalW) / 2);
    const uint16_t ink = blendRGB565(RGB565_WHITE, thumbTop, 0.06f);
    gfx->fillRect(ax, (int16_t)(midY - shaftH / 2), shaftW, shaftH, ink);
    const int16_t neck = (int16_t)(ax + shaftW);
    const int16_t tip = (int16_t)(neck + headW);
    gfx->fillTriangle(tip, midY, neck, (int16_t)(midY - headHalfH), neck, (int16_t)(midY + headHalfH), ink);
  }
}

/// Device visualizer — matches SeedMask Coordinator FlowDiagram (no fiat).
/** One shared short form for Flow + Summary (never re-truncate differently). */
static void psbt_viz_short_addr(const char* in, char* out, size_t outCap) {
  if (!out || outCap < 8) return;
  out[0] = 0;
  if (!in || !in[0] || in[0] == '-') return;
  size_t n = strlen(in);
  // Fit ~14 GLCD chars in the flow card: first6...last4
  if (n <= 14) {
    snprintf(out, outCap, "%s", in);
    return;
  }
  char head[8], tail[8];
  memcpy(head, in, 6);
  head[6] = 0;
  memcpy(tail, in + n - 4, 4);
  tail[4] = 0;
  snprintf(out, outCap, "%s...%s", head, tail);
}

/**
 * Coordinator FlowDiagram cubic: M x0,y0 C mx,y0  mx,y1  x1,y1
 * (both handles share mid-X → clear horizontal S-curves when gutters are wide enough).
 */
static void psbt_viz_draw_flow_curve(int16_t x0, int16_t y0, int16_t x1, int16_t y1, uint16_t col,
                                     int dashOffset, int16_t clipTop, int16_t clipBot) {
  const float mx = ((float)x0 + (float)x1) * 0.5f;
  const float c1x = mx, c1y = (float)y0;
  const float c2x = mx, c2y = (float)y1;
  const int steps = 40;
  const int dash = 8;
  const int gap = 10;
  const int period = dash + gap;
  int16_t px = x0, py = y0;
  float dist = 0.f;
  for (int i = 1; i <= steps; i++) {
    const float t = (float)i / (float)steps;
    const float u = 1.f - t;
    const float x = u * u * u * (float)x0 + 3.f * u * u * t * c1x + 3.f * u * t * t * c2x + t * t * t * (float)x1;
    const float y = u * u * u * (float)y0 + 3.f * u * u * t * c1y + 3.f * u * t * t * c2y + t * t * t * (float)y1;
    const int16_t nx = (int16_t)(x + 0.5f);
    const int16_t ny = (int16_t)(y + 0.5f);
    float seg = sqrtf((float)((nx - px) * (nx - px) + (ny - py) * (ny - py)));
    if (seg < 0.1f) seg = 0.1f;
    float mid = dist + seg * 0.5f;
    int phase = ((int)mid - dashOffset) % period;
    if (phase < 0) phase += period;
    const int16_t midY = (int16_t)((py + ny) / 2);
    const bool inClip = (midY >= clipTop && midY <= clipBot)
                        || (py >= clipTop && py <= clipBot)
                        || (ny >= clipTop && ny <= clipBot);
    if (inClip && phase < dash) {
      gfx->drawLine(px, py, nx, ny, col);
      if (abs(nx - px) >= abs(ny - py))
        gfx->drawLine(px, (int16_t)(py + 1), nx, (int16_t)(ny + 1), col);
      else
        gfx->drawLine((int16_t)(px + 1), py, (int16_t)(nx + 1), ny, col);
    }
    dist += seg;
    px = nx;
    py = ny;
  }
}

static int16_t psbt_viz_measure_node_h(const char* direction, const char* title, const char* addr,
                                       const char* amt, int16_t contentW) {
  int lines = 0;
  if (direction && direction[0]) lines++;
  if (title && title[0]) lines++;
  if (addr && addr[0]) lines++;
  if (amt && amt[0]) {
    int chars = (int)strlen(amt);
    int maxChars = contentW / 6;
    if (maxChars < 8) maxChars = 8;
    lines += (chars > maxChars) ? 2 : 1;
  }
  if (lines < 2) lines = 2;
  return (int16_t)(8 + lines * 11);
}

static void psbt_viz_draw_flow_node(int16_t x, int16_t y, int16_t w, int16_t h, const char* direction,
                                    const char* title, const char* addr, const char* amt, bool warn,
                                    uint16_t danger, int16_t clipTop, int16_t clipBot) {
  // Fully outside — skip
  if ((int16_t)(y + h) <= clipTop || y >= clipBot) return;
  const uint16_t card = RGB565(20, 20, 22);
  const uint16_t border = warn ? blendRGB565(danger, RGB565_WHITE, 0.15f)
                               : blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.78f);
  // Draw card clipped to panel so partial cards stay visible while scrolling
  int16_t dy0 = y;
  int16_t dy1 = (int16_t)(y + h);
  if (dy0 < clipTop) dy0 = clipTop;
  if (dy1 > clipBot) dy1 = clipBot;
  if (dy1 > dy0) {
    // Full round rect when fully inside; solid bar when clipped (avoids broken corners)
    if (y >= clipTop && (int16_t)(y + h) <= clipBot) {
      gfx->fillRoundRect(x, y, w, h, 8, card);
      gfx->drawRoundRect(x, y, w, h, 8, border);
    } else {
      gfx->fillRect(x, dy0, w, (int16_t)(dy1 - dy0), card);
      gfx->drawRect(x, dy0, w, (int16_t)(dy1 - dy0), border);
    }
  }

  const int16_t textX = (int16_t)(x + 6);
  const int16_t textW = (int16_t)(w - 12);
  gfx->setTextSize(1);
  int16_t ty = (int16_t)(y + 5);
  auto printLine = [&](const char* s, uint16_t col) {
    if (!s || !s[0]) return;
    const int16_t lineBot = (int16_t)(ty + 10);
    if (lineBot > clipTop && ty < clipBot) {
      gfx->setTextColor(col);
      gfx->setCursor(textX, ty);
      char buf[40];
      strncpy(buf, s, sizeof(buf) - 1);
      buf[sizeof(buf) - 1] = 0;
      int maxChars = textW / 6;
      if (maxChars < 4) maxChars = 4;
      if ((int)strlen(buf) > maxChars) buf[maxChars] = 0;
      gfx->print(buf);
    }
    ty = (int16_t)(ty + 11);
  };

  printLine(direction, blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.45f));
  printLine(title, RGB565_WHITE);
  printLine(addr, blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.38f));
  if (amt && amt[0]) {
    int maxChars = textW / 6;
    if ((int)strlen(amt) <= maxChars) {
      printLine(amt, RGB565_WHITE);
    } else {
      char a1[28], a2[28];
      int cut = maxChars;
      if (cut > (int)sizeof(a1) - 1) cut = (int)sizeof(a1) - 1;
      memcpy(a1, amt, (size_t)cut);
      a1[cut] = 0;
      strncpy(a2, amt + cut, sizeof(a2) - 1);
      a2[sizeof(a2) - 1] = 0;
      printLine(a1, RGB565_WHITE);
      printLine(a2, RGB565_WHITE);
    }
  }
}

static int16_t g_psbtVizPanelBot = 260;  // updated each visualize draw (scroll hit zone)

static void drawPsbtTxVisualizeOverlay(void) {
  if (!g_psbtVisualizeActive) return;
  const bool kaspa = (g_screen == UIScreen::CRYPTO_KASPA_FEE);
  if (kaspa) {
    if (!g_kaspaReviewSummaryValid) crypto_refresh_kaspa_review();
  } else {
    if (!g_cryptoReviewSummaryValid) crypto_refresh_psbt_review();
  }

  const uint16_t accent = kaspa ? RGB565_KASPA_TEAL : RGB565_BITCOIN_ORANGE;
  gfx->fillRect(0, 46, LCD_W, LCD_H - 46, RGB565(10, 10, 12));
  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(2);
  gfx->setCursor(10, 50);
  gfx->print("Visualize");
  drawBtn(BTN_PSBT_VIZ_CLOSE, "Done", blendRGB565(accent, RGB565_BLACK, 0.20f), 1);

  const bool ok = kaspa ? (g_kaspaReviewSummaryValid && g_kaspaReviewSummary.ok)
                        : (g_cryptoReviewSummaryValid && g_cryptoReviewSummary.ok);
  const bool hasChange = kaspa ? (ok && g_kaspaReviewSummary.change_sompi > 0)
                               : (ok && g_cryptoReviewSummary.change_sat > 0);
  const bool feeWarn = kaspa ? (ok && g_kaspaReviewSummary.big_fee_warn)
                             : (ok && g_cryptoReviewSummary.big_fee_warn);
  const uint64_t sendAmt = kaspa ? (ok ? g_kaspaReviewSummary.send_sompi : 0)
                                 : (ok ? g_cryptoReviewSummary.send_sat : 0);
  const uint64_t changeAmt = kaspa ? (ok ? g_kaspaReviewSummary.change_sompi : 0)
                                   : (ok ? g_cryptoReviewSummary.change_sat : 0);
  const uint64_t feeAmt = kaspa ? (ok ? g_kaspaReviewSummary.fee_sompi : 0)
                                : (ok ? g_cryptoReviewSummary.fee_sat : 0);
  const uint64_t inTotal = kaspa ? (ok ? g_kaspaReviewSummary.in_sompi : (sendAmt + changeAmt + feeAmt))
                                 : (sendAmt + changeAmt + feeAmt);

  char amtIn[36], amtSend[36], amtChg[36], amtFee[36];
  char addrSend[20], addrChg[20];
  if (ok) {
    if (kaspa) {
      kaspa_review_format_amount_line(inTotal, amtIn, sizeof(amtIn));
      kaspa_review_format_amount_line(sendAmt, amtSend, sizeof(amtSend));
      kaspa_review_format_amount_line(changeAmt, amtChg, sizeof(amtChg));
      kaspa_review_format_amount_line(feeAmt, amtFee, sizeof(amtFee));
    } else {
      psbt_review_format_amount_line(inTotal, amtIn, sizeof(amtIn));
      psbt_review_format_amount_line(sendAmt, amtSend, sizeof(amtSend));
      psbt_review_format_amount_line(changeAmt, amtChg, sizeof(amtChg));
      psbt_review_format_amount_line(feeAmt, amtFee, sizeof(amtFee));
    }
  } else {
    snprintf(amtIn, sizeof(amtIn), "-");
    snprintf(amtSend, sizeof(amtSend), "-");
    snprintf(amtChg, sizeof(amtChg), "-");
    snprintf(amtFee, sizeof(amtFee), "-");
  }
  const char* destFull = kaspa ? g_kaspaReviewDest : g_cryptoReviewDest;
  const char* chgFull = kaspa ? g_kaspaReviewSummary.change_addr : g_cryptoReviewChgAddr;
  psbt_viz_short_addr(destFull, addrSend, sizeof(addrSend));
  psbt_viz_short_addr(chgFull, addrChg, sizeof(addrChg));

  const uint8_t nVizIn = kaspa
                             ? (ok ? g_kaspaReviewSummary.num_viz_inputs : 0)
                             : (ok ? g_cryptoReviewSummary.num_viz_inputs : 0);
  uint8_t nShowIn = (nVizIn > 0) ? nVizIn : (uint8_t)1;
  if (!kaspa && nVizIn == 0 && ok) nShowIn = 1;
  if (kaspa && nVizIn == 0 && ok && g_kaspaReviewSummary.num_inputs > 0)
    nShowIn = g_kaspaReviewSummary.num_inputs;
  const uint8_t nShowCap =
      (nShowIn > SEEDMASK_PSBT_REVIEW_MAX_INPUTS) ? (uint8_t)SEEDMASK_PSBT_REVIEW_MAX_INPUTS : nShowIn;

  gfx->setTextSize(1);
  gfx->setTextColor(blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.45f));
  gfx->setCursor(12, 78);
  gfx->print("FLOW");
  if (g_psbtVizScrollMax > 0) {
    gfx->setCursor(200, 78);
    gfx->print("scroll");
  }

  // Taller FLOW when many UTXOs; leave room for SUMMARY (size-2 typography)
  const int16_t panelX = 4, panelY = 90, panelW = 312;
  int16_t panelH = 170;
  if (nShowCap >= 4) panelH = 200;
  if (nShowCap >= 6) panelH = 230;
  if (nShowCap >= 8) panelH = 250;
  if (panelH > 250) panelH = 250;
  g_psbtVizPanelBot = (int16_t)(panelY + panelH);

  const uint16_t danger = RGB565(235, 77, 71);
  const uint16_t panelBg = blendRGB565(RGB565(20, 20, 22), accent, 0.04f);
  const uint16_t panelBorder = blendRGB565(accent, RGB565(40, 40, 44), 0.35f);
  gfx->fillRoundRect(panelX, panelY, panelW, panelH, 12, panelBg);
  gfx->drawRoundRect(panelX, panelY, panelW, panelH, 12, panelBorder);

  const int16_t colInX = (int16_t)(panelX + 4);
  // Narrower side cards + compact hub → ~28px gutters so Coordinator S-curves are visible
  // (old 100/88/100 left only ~8px between columns → looked like a vertical line).
  // hubW must fit "Transaction" (11×6=66px) plus padding inside the pulse inset.
  const int16_t colInW = 86;
  const int16_t hubW = 78;
  const int16_t hubX = (int16_t)(panelX + (panelW - hubW) / 2);
  const int16_t colOutW = 86;
  const int16_t colOutX = (int16_t)(panelX + panelW - 4 - colOutW);
  const int16_t contentW = (int16_t)(colInW - 12);
  const int16_t gapY = 4;
  const int16_t clipTop = (int16_t)(panelY + 4);
  const int16_t clipBot = (int16_t)(panelY + panelH - 4);

  char feeTitle[16];
  snprintf(feeTitle, sizeof(feeTitle), "%s", feeWarn ? "High fee" : "Network fee");
  const int16_t sendH = psbt_viz_measure_node_h("Send to", "Recipient", addrSend[0] ? addrSend : nullptr, amtSend, contentW);
  const int16_t chgH = hasChange ? psbt_viz_measure_node_h("Send to", "Change", addrChg[0] ? addrChg : nullptr, amtChg, contentW) : 0;
  const int16_t feeH = psbt_viz_measure_node_h(nullptr, feeTitle, "Paid to miners", amtFee, contentW);

  int16_t inHArr[SEEDMASK_PSBT_REVIEW_MAX_INPUTS];
  char inTitle[SEEDMASK_PSBT_REVIEW_MAX_INPUTS][24];
  char inAmt[SEEDMASK_PSBT_REVIEW_MAX_INPUTS][36];
  memset(inHArr, 0, sizeof(inHArr));
  for (uint8_t i = 0; i < nShowCap; i++) {
    if (kaspa && ok && i < g_kaspaReviewSummary.num_viz_inputs) {
      snprintf(inTitle[i], sizeof(inTitle[i]), "%s #%lu",
               g_kaspaReviewSummary.viz_input_is_change[i] ? "Change" : "Receive",
               (unsigned long)g_kaspaReviewSummary.viz_input_index[i]);
      kaspa_review_format_amount_line(g_kaspaReviewSummary.viz_input_sompi[i], inAmt[i], sizeof(inAmt[i]));
    } else if (!kaspa && ok && i < g_cryptoReviewSummary.num_viz_inputs) {
      snprintf(inTitle[i], sizeof(inTitle[i]), "%s #%lu",
               g_cryptoReviewSummary.viz_input_is_change[i] ? "Change" : "Receive",
               (unsigned long)g_cryptoReviewSummary.viz_input_index[i]);
      psbt_review_format_amount_line(g_cryptoReviewSummary.viz_input_sat[i], inAmt[i], sizeof(inAmt[i]));
    } else {
      snprintf(inTitle[i], sizeof(inTitle[i]), "Input #%u", (unsigned)(i + 1));
      strncpy(inAmt[i], amtIn, sizeof(inAmt[i]) - 1);
      inAmt[i][sizeof(inAmt[i]) - 1] = 0;
    }
    inHArr[i] = psbt_viz_measure_node_h("Send from", inTitle[i], nullptr, inAmt[i], contentW);
  }

  int16_t inStackH = 0;
  for (uint8_t i = 0; i < nShowCap; i++) {
    inStackH = (int16_t)(inStackH + inHArr[i]);
    if (i + 1 < nShowCap) inStackH = (int16_t)(inStackH + gapY);
  }
  int nOut = hasChange ? 3 : 2;
  int16_t outStackH = (int16_t)(sendH + feeH + (hasChange ? chgH : 0) + (nOut - 1) * gapY);
  // Compact hub — same size always; all connectors meet at its mid-left / mid-right (Coordinator).
  const int16_t hubH = 52;
  int16_t contentH = inStackH;
  if (outStackH > contentH) contentH = outStackH;
  if (hubH > contentH) contentH = hubH;
  contentH = (int16_t)(contentH + 12);
  g_psbtVizScrollMax = (int16_t)(contentH - (panelH - 8));
  if (g_psbtVizScrollMax < 0) g_psbtVizScrollMax = 0;
  if (g_psbtVizScrollY > g_psbtVizScrollMax) g_psbtVizScrollY = g_psbtVizScrollMax;
  if (g_psbtVizScrollY < 0) g_psbtVizScrollY = 0;
  const int16_t sc = g_psbtVizScrollY;

  int16_t baseY = (int16_t)(panelY + 6);
  int16_t inTop = (int16_t)(baseY + (contentH - inStackH) / 2 - sc);
  int16_t outTop = (int16_t)(baseY + (contentH - outStackH) / 2 - sc);
  int16_t hubY = (int16_t)(baseY + (contentH - hubH) / 2 - sc);
  int16_t sendY = outTop;
  int16_t chgY = hasChange ? (int16_t)(sendY + sendH + gapY) : 0;
  int16_t feeY = hasChange ? (int16_t)(chgY + chgH + gapY) : (int16_t)(sendY + sendH + gapY);

  const uint32_t now = millis();
  const int dashOffset = (int)((now / 67u) % 18u);
  const float pulse = 0.5f + 0.5f * sinf((float)(now % 1600u) / 1600.f * 6.2831853f);
  const uint16_t lineCol = blendRGB565(accent, RGB565_BLACK, 0.40f);
  const uint16_t lineWarn = blendRGB565(danger, RGB565_BLACK, 0.25f);

  const int16_t hubLx = hubX;
  const int16_t hubRx = (int16_t)(hubX + hubW);
  const int16_t hubCy = (int16_t)(hubY + hubH / 2);
  const int16_t outLx = colOutX;
  const int16_t inCx = (int16_t)(colInX + colInW);

  // All inputs → hub mid-left; hub mid-right → all outputs (Coordinator pinch).
  {
    int16_t iy = inTop;
    for (uint8_t i = 0; i < nShowCap; i++) {
      const int16_t icy = (int16_t)(iy + inHArr[i] / 2);
      psbt_viz_draw_flow_curve(inCx, icy, hubLx, hubCy, lineCol, dashOffset + (int)i * 2, clipTop, clipBot);
      iy = (int16_t)(iy + inHArr[i] + gapY);
    }
    psbt_viz_draw_flow_curve(hubRx, hubCy, outLx, (int16_t)(sendY + sendH / 2), lineCol, dashOffset + 3, clipTop,
                             clipBot);
    if (hasChange)
      psbt_viz_draw_flow_curve(hubRx, hubCy, outLx, (int16_t)(chgY + chgH / 2), lineCol, dashOffset + 6, clipTop,
                               clipBot);
    psbt_viz_draw_flow_curve(hubRx, hubCy, outLx, (int16_t)(feeY + feeH / 2), feeWarn ? lineWarn : lineCol,
                             dashOffset + 9, clipTop, clipBot);
  }

  {
    int16_t iy = inTop;
    for (uint8_t i = 0; i < nShowCap; i++) {
      psbt_viz_draw_flow_node(colInX, iy, colInW, inHArr[i], "Send from", inTitle[i], nullptr, inAmt[i], false,
                              danger, clipTop, clipBot);
      iy = (int16_t)(iy + inHArr[i] + gapY);
    }
  }

  if ((int16_t)(hubY + hubH) > clipTop && hubY < clipBot) {
    const uint16_t hubBg = blendRGB565(RGB565(20, 20, 22), accent, 0.08f);
    const uint16_t hubBorder = blendRGB565(accent, RGB565(50, 50, 54), 0.40f);
    if (hubY >= clipTop && (int16_t)(hubY + hubH) <= clipBot) {
      gfx->fillRoundRect(hubX, hubY, hubW, hubH, 10, hubBg);
      gfx->drawRoundRect(hubX, hubY, hubW, hubH, 10, hubBorder);
    } else {
      int16_t hy0 = hubY < clipTop ? clipTop : hubY;
      int16_t hy1 = (int16_t)(hubY + hubH);
      if (hy1 > clipBot) hy1 = clipBot;
      if (hy1 > hy0) {
        gfx->fillRect(hubX, hy0, hubW, (int16_t)(hy1 - hy0), hubBg);
        gfx->drawRect(hubX, hy0, hubW, (int16_t)(hy1 - hy0), hubBorder);
      }
    }
    const int16_t inset = 4;
    const uint16_t pulseCol = blendRGB565(accent, RGB565_BLACK, 0.55f - 0.25f * pulse);
    if (hubY >= clipTop && (int16_t)(hubY + hubH) <= clipBot) {
      gfx->drawRoundRect((int16_t)(hubX + inset), (int16_t)(hubY + inset), (int16_t)(hubW - 2 * inset),
                         (int16_t)(hubH - 2 * inset), 8, pulseCol);
      gfx->setTextSize(1);
      gfx->setTextColor(RGB565_WHITE);
      const char* hub = "Transaction";
      const int tw = (int)strlen(hub) * 6;  // default Adafruit font: 6px/glyph
      int16_t tx = (int16_t)(hubX + (hubW - tw) / 2);
      if (tx < hubX + inset + 2) tx = (int16_t)(hubX + inset + 2);
      gfx->setCursor(tx, (int16_t)(hubY + hubH / 2 - 4));
      gfx->print(hub);
    }
  }

  psbt_viz_draw_flow_node(colOutX, sendY, colOutW, sendH, "Send to", "Recipient",
                          addrSend[0] ? addrSend : nullptr, amtSend, false, danger, clipTop, clipBot);
  if (hasChange)
    psbt_viz_draw_flow_node(colOutX, chgY, colOutW, chgH, "Send to", "Change",
                            addrChg[0] ? addrChg : nullptr, amtChg, false, danger, clipTop, clipBot);
  psbt_viz_draw_flow_node(colOutX, feeY, colOutW, feeH, nullptr, feeTitle, "Paid to miners", amtFee, feeWarn,
                          danger, clipTop, clipBot);

  if (g_psbtVizScrollMax > 0) {
    const int16_t trackX = (int16_t)(panelX + panelW - 5);
    const int16_t trackY = (int16_t)(panelY + 8);
    const int16_t trackH = (int16_t)(panelH - 16);
    gfx->fillRect(trackX, trackY, 2, trackH, blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.75f));
    int16_t thumbH = (int16_t)((int32_t)trackH * panelH / (panelH + g_psbtVizScrollMax));
    if (thumbH < 16) thumbH = 16;
    int16_t thumbY = trackY;
    if (g_psbtVizScrollMax > 0)
      thumbY = (int16_t)(trackY + (int32_t)(trackH - thumbH) * g_psbtVizScrollY / g_psbtVizScrollMax);
    gfx->fillRect(trackX, thumbY, 2, thumbH, accent);
  }

  // SUMMARY — larger amount + full Sent-to address (size-2)
  const int16_t sumY0 = (int16_t)(panelY + panelH + 8);
  gfx->setTextSize(1);
  gfx->setTextColor(blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.45f));
  gfx->setCursor(10, sumY0);
  gfx->print("SUMMARY");
  int16_t ay = (int16_t)(sumY0 + 14);
  if (ok) {
    gfx->setTextSize(2);
    gfx->setTextColor(RGB565_WHITE);
    gfx->setCursor(10, ay);
    gfx->print("Send ");
    {
      char amtOnly[40];
      strncpy(amtOnly, amtSend, sizeof(amtOnly) - 1);
      amtOnly[sizeof(amtOnly) - 1] = 0;
      char* sp = strstr(amtOnly, " BTC");
      if (sp) *sp = 0;
      sp = strstr(amtOnly, " sats");
      if (sp) *sp = 0;
      sp = strstr(amtOnly, " KAS");
      if (sp) *sp = 0;
      sp = strstr(amtOnly, " sompi");
      if (sp) *sp = 0;
      gfx->print(amtOnly);
    }
    ay = (int16_t)(ay + 20);
    gfx->setTextSize(1);
    gfx->setTextColor(blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.28f));
    gfx->setCursor(10, ay);
    gfx->print("Sent to");
    ay = (int16_t)(ay + 12);
    const char* fullTo =
        (destFull && destFull[0] && destFull[0] != '-' && strcmp(destFull, "(see outputs)") != 0)
            ? destFull
            : (addrSend[0] ? addrSend : "-");
    gfx->setTextSize(2);
    gfx->setTextColor(RGB565_WHITE);
    {
      size_t flen = strlen(fullTo);
      size_t pos = 0;
      const size_t wrap = 24;  // size-2 ≈ 12px → ~288px
      while (pos < flen && ay < (int16_t)(LCD_H - 28)) {
        size_t take = flen - pos;
        if (take > wrap) take = wrap;
        char line[28];
        memcpy(line, fullTo + pos, take);
        line[take] = 0;
        gfx->setCursor(10, ay);
        gfx->print(line);
        pos += take;
        ay = (int16_t)(ay + 18);
      }
    }
    gfx->setTextSize(1);
    gfx->setTextColor(blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.28f));
    if (ay < (int16_t)(LCD_H - 40)) {
      gfx->setCursor(10, ay);
      gfx->print("Network fee ");
      gfx->print(amtFee);
      ay = (int16_t)(ay + 12);
    }
    if (ay < (int16_t)(LCD_H - 28)) {
      gfx->setTextColor(blendRGB565(RGB565_WHITE, RGB565_BLACK, 0.40f));
      char bal1[56], bal2[72];
      snprintf(bal1, sizeof(bal1), "Coins in %s =", amtIn);
      if (hasChange)
        snprintf(bal2, sizeof(bal2), "recipient %s + fee %s + change %s", amtSend, amtFee, amtChg);
      else
        snprintf(bal2, sizeof(bal2), "recipient %s + fee %s", amtSend, amtFee);
      gfx->setCursor(10, ay);
      gfx->print(bal1);
      ay = (int16_t)(ay + 11);
      if (ay < (int16_t)(LCD_H - 16)) {
        gfx->setCursor(10, ay);
        if (strlen(bal2) > 50) {
          char a[52], b[52];
          memcpy(a, bal2, 48);
          a[48] = 0;
          strncpy(b, bal2 + 48, sizeof(b) - 1);
          b[sizeof(b) - 1] = 0;
          gfx->print(a);
          if ((int16_t)(ay + 11) < (int16_t)(LCD_H - 8)) {
            gfx->setCursor(10, (int16_t)(ay + 11));
            gfx->print(b);
          }
        } else {
          gfx->print(bal2);
        }
      }
    }
  } else {
    gfx->setTextSize(1);
    gfx->setTextColor(RGB565_WHITE);
    gfx->setCursor(10, ay);
    gfx->print("Review data unavailable");
  }
}

static void drawPsbtSignConfirmOverlay(void) {
  if (!g_psbtSignConfirmActive || !g_psbtSignConfirmBody[0]) return;
  const bool kaspaFee = (g_screen == UIScreen::CRYPTO_KASPA_FEE);
  const uint16_t accent = kaspaFee ? RGB565_KASPA_TEAL : RGB565_BITCOIN_ORANGE;
  // Full content area below top bar + accent (46px); match Review/Fee edge-to-edge panel (LCD_H).
  gfx->fillRect(0, 46, LCD_W, LCD_H - 46, RGB565(10, 10, 14));
  // Title lives in the top bar only ("Confirm signing") — no duplicate heading here.
  gfx->setTextSize(1);
  gfx->setTextColor(RGB565_WHITE);
  int16_t ly = 56;
  const char* sb = g_psbtSignConfirmBody;
  const int wrapChars = 38;
  size_t slen = strlen(sb);
  size_t pos = 0;
  // Leave room for Visualize + CANCEL on both BTC and Kaspa.
  const int16_t bodyMaxY = 248;
  while (pos < slen && ly < bodyMaxY) {
    size_t take = slen - pos;
    if (take > (size_t)wrapChars) take = (size_t)wrapChars;
    char chunk[44];
    if (take >= sizeof(chunk)) take = sizeof(chunk) - 1;
    memcpy(chunk, sb + pos, take);
    chunk[take] = 0;
    gfx->setCursor(10, ly);
    gfx->print(chunk);
    ly = (int16_t)(ly + 14);
    pos += take;
  }
  drawBtn(BTN_PSBT_SIGN_CONF_VISUALIZE, "Visualize",
          blendRGB565(accent, RGB565_BLACK, 0.15f), 1);
  drawBtn(BTN_PSBT_SIGN_CONF_CANCEL, "CANCEL", RGB565_RED, 2);
  // Sign errors land in g_msg — must be visible on this overlay (Fee screen is covered).
  if (g_msg[0]
      && strncmp(g_msg, "Signing ", 8) != 0
      && strncmp(g_msg, "slide", 5) != 0) {
    gfx->setTextSize(1);
    gfx->setTextColor(RGB565_YELLOW);
    const int wrapChars = 36;
    size_t mlen = strlen(g_msg);
    size_t mpos = 0;
    int16_t my = 248;
    while (mpos < mlen && my < 300) {
      size_t take = mlen - mpos;
      if (take > (size_t)wrapChars) take = (size_t)wrapChars;
      char chunk[40];
      if (take >= sizeof(chunk)) take = sizeof(chunk) - 1;
      memcpy(chunk, g_msg + mpos, take);
      chunk[take] = 0;
      gfx->setCursor(10, my);
      gfx->print(chunk);
      my = (int16_t)(my + 12);
      mpos += take;
    }
  }
  {
    const int16_t maxO = psbt_slide_max_offset();
    int16_t off = g_psbtSlideThumbOffset;
    if (off < 0) off = 0;
    if (off > maxO) off = maxO;
    const int16_t innerLeft = (int16_t)(PSBT_SLIDE_TRACK_X + PSBT_SLIDE_PAD);
    const int16_t thumbX = (int16_t)(innerLeft + off);
    const int16_t thumbY = (int16_t)(PSBT_SLIDE_TRACK_Y + (PSBT_SLIDE_TRACK_H - PSBT_SLIDE_THUMB_H) / 2);
    drawPsbtSlideToUnlockChrome(thumbX, thumbY);
  }
  if (g_psbtVisualizeActive) drawPsbtTxVisualizeOverlay();
}

