}

// Stock UI label for acct (same as btc_account_default_name); used to avoid "See account 2 / Account 2".
static bool multisig_btc_account_label_is_stock(uint32_t acct, const char* label) {
  if (!label) return false;
  if (acct == 0u) return strcasecmp(label, "Default") == 0;
  char expect[BTC_ACCOUNT_NAME_MAX];
  snprintf(expect, sizeof(expect), "Account %lu", (unsigned long)acct);
  expect[sizeof(expect) - 1] = 0;
  return strcasecmp(label, expect) == 0;
}

static void multisig_duplicate_notice_activate(uint8_t storedIdx) {
  g_multisigDuplicateNoticeActive = true;
  g_multisigDuplicateNoticeName[0] = 0;
  g_multisigDuplicateNoticeAccountLine[0] = 0;
  if (g_multisigWalletNames && storedIdx < g_multisigWalletCount && g_multisigWalletNames[storedIdx][0]) {
    strncpy(g_multisigDuplicateNoticeName, g_multisigWalletNames[storedIdx], sizeof(g_multisigDuplicateNoticeName) - 1);
    g_multisigDuplicateNoticeName[sizeof(g_multisigDuplicateNoticeName) - 1] = 0;
  } else {
    strncpy(g_multisigDuplicateNoticeName, "Imported multisig", sizeof(g_multisigDuplicateNoticeName) - 1);
    g_multisigDuplicateNoticeName[sizeof(g_multisigDuplicateNoticeName) - 1] = 0;
  }
  if (storedIdx < g_multisigWalletCount) {
    uint32_t wac = g_multisigWalletBtcAccount[storedIdx];
    if (wac == MULTISIG_ACCOUNT_LEGACY_ANY) {
      snprintf(g_multisigDuplicateNoticeAccountLine, sizeof(g_multisigDuplicateNoticeAccountLine),
               "All Bitcoin accounts (this seed)");
    } else if (wac == 0u) {
      const char* nm = btc_account_name_for(0);
      if (nm[0] && !multisig_btc_account_label_is_stock(0u, nm)) {
        snprintf(g_multisigDuplicateNoticeAccountLine, sizeof(g_multisigDuplicateNoticeAccountLine),
                 "See Default account / %s", nm);
      } else {
        snprintf(g_multisigDuplicateNoticeAccountLine, sizeof(g_multisigDuplicateNoticeAccountLine),
                 "See Default account");
      }
    } else {
      const char* nm = btc_account_name_for(wac);
      if (multisig_btc_account_label_is_stock(wac, nm)) {
        snprintf(g_multisigDuplicateNoticeAccountLine, sizeof(g_multisigDuplicateNoticeAccountLine),
                 "See account %lu", (unsigned long)wac);
      } else {
        snprintf(g_multisigDuplicateNoticeAccountLine, sizeof(g_multisigDuplicateNoticeAccountLine),
                 "See account %lu / %s", (unsigned long)wac, nm);
      }
    }
  }
}

