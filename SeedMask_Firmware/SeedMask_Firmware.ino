/** Type ASCII printable chars to the USB host. Avoids CDC/draw before keystrokes (ESP32-S3 CDC+HID stall). */
static size_t hidTypeAsciiString(const char* s) {
  if (!s || !s[0] || !hidHostTypingEnabled()) return 0;
  Serial.flush();
  delay(100);  // let TinyUSB finish any pending CDC before HID reports
  size_t n = 0;
  for (const char* p = s; *p; p++) {
    char c = *p;
    if (c >= 32 && c <= 126) {
      Keyboard.write((uint8_t)c);
      delay(35);
      yield();  // pump USB stack while typing (composite CDC+HID on ESP32-S3)
      n++;
    }
  }
  Keyboard.releaseAll();
  delay(20);
  return n;
}
#else
static bool hidHostTypingEnabled() { return false; }
#endif

