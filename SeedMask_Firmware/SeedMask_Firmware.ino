static bool hit(const Rect& r, int16_t px, int16_t py) {
  return (px >= r.x && px < (r.x + r.w) && py >= r.y && py < (r.y + r.h));
}

// Expand hit target (some touch panels report Y ~20–40px low vs drawn buttons at bottom).
static bool hitPad(const Rect& r, int16_t px, int16_t py, int16_t pad) {
  return (px >= r.x - pad && px < (r.x + r.w + pad) && py >= r.y - pad && py < (r.y + r.h + pad));
}

static bool hitTopTitleArea(int16_t x, int16_t y) {
  // More forgiving than RECT_TOP_TITLE: anywhere on top bar except burger.
  // Avoid compile-order dependency on BTN_TOP_BURGER by using its fixed bounds (0..50, 0..46).
  bool onTopBar = (y <= 46);
  bool onBurger = (x >= 0 && x < 50 && y >= 0 && y < 46);
  return onTopBar && !onBurger;
}

