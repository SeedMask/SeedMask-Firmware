static Rect diceFaceRect(uint8_t face /*1..6*/) {
  // 2 rows x 3 cols, faces 1..6
  const int idx = (int)face - 1;
  const int col = idx % 3;
  const int row = idx / 3;
  const int size = 72;
  const int gap = 12;
  const int gridW = 3 * size + 2 * gap;
  const int x0 = (320 - gridW) / 2;
  const int y0 = 210;
  return Rect{ (int16_t)(x0 + col * (size + gap)), (int16_t)(y0 + row * (size + gap)), (int16_t)size, (int16_t)size };
}

static void drawDicePips(const Rect& r, uint8_t face, uint16_t pipColor = RGB565_BLACK) {
  const int16_t cx = r.x + r.w / 2;
  const int16_t cy = r.y + r.h / 2;
  const int16_t dx = r.w / 4;
  const int16_t dy = r.h / 4;
  const int16_t rad = 4;
  auto pip = [&](int16_t x, int16_t y) { gfx->fillCircle(x, y, rad, pipColor); };
  // layout like a standard die
  const bool c = (face == 1 || face == 3 || face == 5);
  const bool tl = (face >= 4);
  const bool tr = (face >= 2);
  const bool bl = (face >= 2);
  const bool br = (face >= 4);
  const bool ml = (face == 6);
  const bool mr = (face == 6);
  if (c) pip(cx, cy);
  if (tl) pip(cx - dx, cy - dy);
  if (tr) pip(cx + dx, cy - dy);
  if (bl) pip(cx - dx, cy + dy);
  if (br) pip(cx + dx, cy + dy);
  if (ml) pip(cx - dx, cy);
  if (mr) pip(cx + dx, cy);
}

static void drawDiceFaceButton(uint8_t face, bool pressed = false) {
  Rect r = diceFaceRect(face);
  if (pressed) {
    gfx->fillRoundRect(r.x, r.y, r.w, r.h, 12, UI_ACCENT);
    gfx->drawRoundRect(r.x, r.y, r.w, r.h, 12, RGB565_WHITE);
    drawDicePips(r, face, RGB565_WHITE);
  } else {
    gfx->fillRoundRect(r.x, r.y, r.w, r.h, 12, RGB565_WHITE);
    gfx->drawRoundRect(r.x, r.y, r.w, r.h, 12, UI_ACCENT);
    drawDicePips(r, face, RGB565_BLACK);
  }
}

