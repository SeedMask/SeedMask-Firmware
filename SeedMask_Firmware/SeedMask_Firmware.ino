static void pwMetaSetCursorAtEnd(uint8_t focusField) {
  size_t len = strlen(g_editBuf);
  if (len > 65535u) len = 65535u;
  g_editCursor = (uint16_t)len;
  const int maxChars = (PW_EDIT_DETAIL_W - 16) / 12;  // matches metadata field rendering
  uint16_t start = (g_editCursor > (uint16_t)maxChars) ? (uint16_t)(g_editCursor - (uint16_t)maxChars) : 0;
  if (focusField == PW_FOCUS_NAME) {
    g_addPwCursorName = g_editCursor;
    g_addPwViewName = start;
  } else if (focusField == PW_FOCUS_USER) {
    g_addPwCursorUser = g_editCursor;
    g_addPwViewUser = start;
  } else if (focusField == PW_FOCUS_SITE) {
    g_addPwCursorSite = g_editCursor;
    g_addPwViewSite = start;
  } else if (focusField == PW_FOCUS_NOTES) {
    g_addPwCursorNotes = g_editCursor;
    g_addPwViewNotes = start;
  }
  g_editViewOffset = 0;
  g_editViewOffsetPx = 0;
}

static void pwValueSetCursorAtEnd() {
  size_t len = strlen(g_editBuf);
  if (len > 65535u) len = 65535u;
  g_editCursor = (uint16_t)len;
  const int boxW = 272;
  const int pwPadding = 12;
  const int pwCharW = 12;
  const int maxChars = (boxW - pwPadding * 2) / pwCharW;
  g_editViewOffset = (g_editCursor > (uint16_t)maxChars) ? (uint16_t)(g_editCursor - (uint16_t)maxChars) : 0;
  g_editViewOffsetPx = 0;
}

